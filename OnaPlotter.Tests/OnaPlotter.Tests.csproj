<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Opt in to the Microsoft Testing Platform dotnet-test experience.
         Required on .NET 10 SDK where the legacy VSTest dispatch was
         removed; without this, `dotnet test OnaPlotter.slnx` aborts with
         the "Testing with VSTest target is no longer supported" error.
         TUnit runs natively on MTP, so this just swaps the CI dispatcher;
         local `dotnet run` on the test project keeps working too. -->
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pin to the 1.37.x minor TUnit line. Earlier "Version=*" was
         a cheap way to always get the newest but means a bad-release
         breaks reproducible builds for everyone the moment it ships.
         Bump intentionally when we want a new feature. -->
    <PackageReference Include="TUnit" Version="1.37.*" />
    <!-- bUnit for Blazor component-level tests. Gives us DOM snapshot
         assertions, event dispatch, service mocks - catches regressions
         in Razor markup that neither the C# unit tests nor Playwright
         would surface cheaply. Same reasoning as TUnit: floor to the
         current minor rather than the whole 1.x major. -->
    <PackageReference Include="bunit" Version="1.40.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../OnaPlotter/OnaPlotter.csproj" />
  </ItemGroup>

</Project>
