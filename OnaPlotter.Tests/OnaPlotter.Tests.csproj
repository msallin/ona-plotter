<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" Version="*" />
    <!-- bUnit for Blazor component-level tests. Gives us DOM snapshot
         assertions, event dispatch, service mocks - catches regressions
         in Razor markup that neither the C# unit tests nor Playwright
         would surface cheaply. -->
    <PackageReference Include="bunit" Version="1.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../OnaPlotter/OnaPlotter.csproj" />
  </ItemGroup>

</Project>
