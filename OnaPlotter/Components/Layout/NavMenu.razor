@inject OnaPlotter.Services.IAppSettings Settings
@implements IDisposable

@* Sidebar nav. Icons are inline SVG from Lucide (lucide.dev, MIT)
   so they render offline (PWA / on-boat) and inherit theme colour
   via stroke="currentColor". The set is "glass cockpit" - gauge,
   chart, helm, anemometer, data-logger, archive, mixer-style
   controls - so the sidebar reads like a bridge console rather
   than a generic dashboard. Replaces a mix of Unicode glyphs that
   had inconsistent optical size (different x-heights / weights). *@
<div class="nav-scrollable">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All" title="Dashboard">
                <span class="nav-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m12 14 4-4" />
                        <path d="M3.34 19a10 10 0 1 1 17.32 0" />
                    </svg>
                </span>
                <span class="nav-label">Dashboard</span>
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="map" title="Chart">
                <span class="nav-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14.106 5.553a2 2 0 0 0 1.788 0l3.659-1.83A1 1 0 0 1 21 4.619v12.764a1 1 0 0 1-.553.894l-4.553 2.277a2 2 0 0 1-1.788 0l-4.212-2.106a2 2 0 0 0-1.788 0l-3.659 1.83A1 1 0 0 1 3 19.381V6.618a1 1 0 0 1 .553-.894l4.553-2.277a2 2 0 0 1 1.788 0z" />
                        <path d="M15 5.764v15" />
                        <path d="M9 3.236v15" />
                    </svg>
                </span>
                <span class="nav-label">Chart</span>
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="sailsteer" title="SailSteer">
                <span class="nav-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="8" />
                        <path d="M12 2v7.5" />
                        <path d="m19 5-5.23 5.23" />
                        <path d="M22 12h-7.5" />
                        <path d="m19 19-5.23-5.23" />
                        <path d="M12 14.5V22" />
                        <path d="M10.23 13.77 5 19" />
                        <path d="M9.5 12H2" />
                        <path d="M10.23 10.23 5 5" />
                        <circle cx="12" cy="12" r="2.5" />
                    </svg>
                </span>
                <span class="nav-label">SailSteer</span>
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="wind" title="Wind">
                <span class="nav-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12.8 19.6A2 2 0 1 0 14 16H2" />
                        <path d="M17.5 8a2.5 2.5 0 1 1 2 4H2" />
                        <path d="M9.8 4.4A2 2 0 1 1 11 8H2" />
                    </svg>
                </span>
                <span class="nav-label">Wind</span>
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="history" title="History">
                <span class="nav-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 6v6l2 1" />
                        <path d="M12.337 21.994a10 10 0 1 1 9.588-8.767" />
                        <path d="m14 18 4 4 4-4" />
                        <path d="M18 14v8" />
                    </svg>
                </span>
                <span class="nav-label">History</span>
            </NavLink>
        </div>
        <div class="nav-item px-3">
            @* Stats sits next to History because they share an input
               (the helm's chosen date window) and a data source (the
               History API). History answers "where", Stats answers
               "how much / how long". Lucide chart-no-axes-column reads
               as "totals" in the cockpit-icon set without competing
               visually with the helm-style History glyph above. *@
            <NavLink class="nav-link" href="stats" title="Stats">
                <span class="nav-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 3v16a2 2 0 0 0 2 2h16" />
                        <path d="M7 16h2" />
                        <path d="M7 11h6" />
                        <path d="M7 6h10" />
                    </svg>
                </span>
                <span class="nav-label">Stats</span>
            </NavLink>
        </div>
        <div class="nav-item px-3">
            @* Routes / waypoints / notes / regions all live under
               /resources on the server. Archive (a storage box) reads
               as "stored data" better than a folder for that mix. *@
            <NavLink class="nav-link" href="resources" title="Resources">
                <span class="nav-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect width="20" height="5" x="2" y="3" rx="1" />
                        <path d="M4 8v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8" />
                        <path d="M10 12h4" />
                    </svg>
                </span>
                <span class="nav-label">Resources</span>
            </NavLink>
        </div>
        <div class="nav-item px-3">
            @* Settings also surfaces the Data + Paths tools (techie
               features; they're not first-class nav items on their
               own). Sliders glyph fits the cockpit theme better than
               a cog and reads as "tunable controls". *@
            <NavLink class="nav-link" href="settings" title="Settings">
                <span class="nav-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M10 5H3" />
                        <path d="M12 19H3" />
                        <path d="M14 3v4" />
                        <path d="M16 17v4" />
                        <path d="M21 12h-9" />
                        <path d="M21 19h-5" />
                        <path d="M21 5h-7" />
                        <path d="M8 10v4" />
                        <path d="M8 12H3" />
                    </svg>
                </span>
                <span class="nav-label">Settings</span>
            </NavLink>
        </div>
    </nav>

    @* Sidebar collapse / expand toggle. Pinned to the bottom of the
       rail rather than living in the top bar - collapsing the menu
       is a menu-level action, and most desktop UIs (VSCode, Discord,
       Slack, Linear) put the chevron exactly here. The button reuses
       .nav-link styling so it inherits hover / active / icon-rail
       collapse rules without per-state CSS. Lucide chevrons-right
       (expand) / chevrons-left (collapse) match the rest of the rail. *@
    <div class="nav-collapse-row">
        <button class="nav-link nav-collapse-btn" type="button"
                @onclick="ToggleSidebar"
                title="@(Settings.SidebarCollapsed ? "Expand menu" : "Collapse menu")"
                aria-label="@(Settings.SidebarCollapsed ? "Expand menu" : "Collapse menu")"
                aria-pressed="@(Settings.SidebarCollapsed ? "true" : "false")">
            <span class="nav-icon" aria-hidden="true">
                @if (Settings.SidebarCollapsed)
                {
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m6 17 5-5-5-5" />
                        <path d="m13 17 5-5-5-5" />
                    </svg>
                }
                else
                {
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m11 17-5-5 5-5" />
                        <path d="m18 17-5-5 5-5" />
                    </svg>
                }
            </span>
            <span class="nav-label">Collapse</span>
        </button>
    </div>
</div>

@code {
    protected override void OnInitialized()
        => Settings.OnSettingsChanged += HandleSettingsChanged;

    public void Dispose()
        => Settings.OnSettingsChanged -= HandleSettingsChanged;

    private void HandleSettingsChanged() => InvokeAsync(StateHasChanged);

    private Task ToggleSidebar()
        => Settings.SetSidebarCollapsedAsync(!Settings.SidebarCollapsed);
}
