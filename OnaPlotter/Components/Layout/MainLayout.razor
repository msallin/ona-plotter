@inherits LayoutComponentBase
@using OnaPlotter.Models
@using OnaPlotter.Services
@using Microsoft.JSInterop
@inject SignalkClient SignalkClient
@inject AisStore AisStore
@inject IAppSettings Settings
@inject IToastService Toasts
@inject IAlarmManager Alarms
@inject OnaPlotter.Services.ServerNotifications.ServerNotificationStore ServerNotifications
@inject OnaPlotter.Services.Api.ICourseApi CourseApi
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject OnaPlotter.Services.UpdateChecker Updates
@inject OnaPlotter.Services.Api.IAuthApi AuthApi
@inject OnaPlotter.Services.Api.ISignalKBaseUrl SkBaseUrl
@inject ILogger<MainLayout> Logger
@implements IAsyncDisposable

<a href="#main-content" class="skip-link">Skip to content</a>
<div class="page theme-@Settings.Theme @(Settings.NightMode ? $"night-mode-global night-mode-{Settings.NightModePreset}" : "") @(Settings.SidebarCollapsed ? "sidebar-collapsed" : "")">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main id="main-content">
        <div class="top-row px-4">
            <span class="connection-status @ConnectionClass" title="@ConnectionTooltip">
                <span class="connection-dot @DotClass"></span>
                @* Phone-only: the dot already conveys the state (green
                   = live, amber = reconnecting, red = down). Hide the
                   text label there so the topbar fits at narrow widths;
                   tooltip still carries the verbose form. *@
                <span class="connection-status-text">@ConnectionLabel</span>
            </span>
            @* When offline, surface a Retry button right next to the
               chip. Cancels the current reconnect backoff so the next
               attempt is immediate - no waiting out the 30s cap.
               Hidden when connected. *@
            @if (!SignalkClient.IsConnected)
            {
                <button class="connection-retry" @onclick="ReconnectNow"
                        title="Try reconnecting now (bypasses the backoff delay)">
                    Retry
                </button>
            }

            @{
                var historyCount = Alarms.DismissedHistory.Count;
                var activeCount = Alarms.ActiveAlarms.Count;
            }
            @* Show the button whenever any of the three buckets is
               non-empty: active alarms (the blinking case), past
               dismissals, or current snoozes. On mobile the banner
               stack is suppressed and this button is the helm's only
               affordance for active alarms; the alarm-log-btn-active
               class drives a per-mobile blink animation so a stray
               eye sees the cue. *@
            @if (activeCount > 0 || historyCount > 0 || Alarms.SnoozedTargets.Count > 0)
            {
                @* Tooltip mentions active first when there is one,
                   then the historical context. Helm hovering on
                   desktop reads both the live and the recent state
                   from the same chip. *@
                <button class="alarm-log-btn @(activeCount > 0 ? "alarm-log-btn-active" : "")"
                        @onclick="ToggleAlarmLog"
                        title="@(activeCount > 0
                                  ? $"{activeCount} active alarm{(activeCount == 1 ? "" : "s")} - tap to view"
                                  : $"Alarm history ({historyCount} recent" +
                                    (Alarms.SnoozedTargets.Count > 0
                                      ? $", {Alarms.SnoozedTargets.Count} snoozed)" : ")"))">
                    @* Three forms:
                         - desktop: full text "Alarm History 12"
                         - phone:   icon (clipboard / note-block) +
                                    a small count badge in the corner
                       CSS picks one form per breakpoint. The icon was
                       added because the abbreviated "History 12" text
                       still wrapped + cluttered the phone topbar; an
                       icon reads at a glance, the badge keeps the
                       count visible without the text. When there's an
                       active alarm the desktop label switches to
                       "Active N" so the count badge isn't ambiguous
                       (which one is being shown -- active or
                       history?). *@
                    <span class="alarm-log-label-full">
                        @(activeCount > 0
                            ? $"Active {activeCount}"
                            : $"Alarm History {historyCount}")
                    </span>
                    <span class="alarm-log-icon" aria-hidden="true">@((MarkupString)OnaPlotter.Utilities.Icons.Small.History)</span>
                    @{
                        var badgeCount = activeCount > 0 ? activeCount : historyCount;
                    }
                    @if (badgeCount > 0)
                    {
                        <span class="alarm-log-badge">@badgeCount</span>
                    }
                </button>
            }

            @* Update-available chip. The UpdateChecker singleton polls
               js/version.g.js every 5 min and flips a latch when the
               server's hash differs from the bundle the helm is
               running. Reload uses NavigationManager.forceLoad so the
               browser re-fetches index.html + _framework/* with the
               cache-bypass headers the SK webapp host sets on those
               paths - helm gets the new bundle in one tap. Sticky
               latch: even if a later poll happens to match (rolling
               deploy / CDN race), the helm has already SEEN the
               prompt so we don't take it back. *@
            @if (Updates.IsUpdateAvailable)
            {
                <button class="update-available-chip"
                        @onclick="ReloadForUpdate"
                        title="A new OnaPlotter bundle is on the server. Tap to reload.">
                    <span aria-hidden="true">↻</span>
                    Update available
                </button>
            }

            @* Not-logged-in chip. Probed once at app start via
               IAuthApi.GetLoginStatusAsync, refreshed every 5 min,
               and re-probed immediately on tab visibility-change so
               a helm who signs in via the SK admin tab and returns
               sees the chip clear without waiting up to 5 min for
               the next poll. Visible only when the server has
               security ENABLED and status != "loggedIn"; a no-auth
               dev / homelab server hides the chip
               (authenticationRequired=false). Tap opens the SK
               admin UI on the SERVER ORIGIN (not the plugin mount)
               so installs hosted under /signalk-onaplotter/ get the
               right URL; on return the visibilitychange handler
               picks up the new cookie. *@
            @if (_loginStatus is { ShouldShowLoginWarning: true })
            {
                <a class="auth-warning-chip"
                   href="@(SkBaseUrl.BaseUrl + SkAdminLoginPath)"
                   target="_blank" rel="noopener noreferrer"
                   title="Not signed in to the SK server: saves and edits will fail. Tap to open the admin login; the chip clears when you switch back to this tab.">
                    <span aria-hidden="true">⚠</span>
                    Not logged in
                </a>
            }

            @* Place-search box. Only rendered on the Map page (off-
               map pages have no map to fly + no pin overlay to
               drop, so a search would do nothing visible). Sits
               BEFORE the right-side cluster's `ms-auto` button so
               the search input grows into the gap between the
               status chips on the left and the icon buttons on
               the right. Pick handler flies the map + drops the
               search-pin via the leaflet JS module. *@
            @if (IsMapRoute)
            {
                <SearchBox OnPicked="HandlePlacePicked" OnCleared="HandlePlaceCleared" />
            }

            @* Zoom in / out. Only rendered when the Map page is
               active; other pages have no map to zoom, so showing
               inert zoom buttons would be a lie. The right-side
               cluster carries `ms-auto` (on the SearchBox above
               when the map is shown, else on the first icon below)
               so the whole group right-aligns; subsequent buttons
               sit flush. *@
            @if (IsMapRoute)
            {
                <button class="btn btn-sm btn-outline-secondary topbar-icon-btn"
                        @onclick="ZoomInAsync"
                        title="Zoom in" aria-label="Zoom in">
                    @((MarkupString)OnaPlotter.Utilities.Icons.Small.Plus)
                </button>
                <button class="btn btn-sm btn-outline-secondary topbar-icon-btn"
                        @onclick="ZoomOutAsync"
                        title="Zoom out" aria-label="Zoom out">
                    @((MarkupString)OnaPlotter.Utilities.Icons.Small.Minus)
                </button>
            }

            @* Night / day toggle. Moon = currently in day, tap to go
               night. Sun = currently in night, tap to go day. Same
               icon-button shape + size as the fullscreen control
               right next to it so the topbar reads as a row of
               consistent glyph buttons. `ms-auto` only applies when
               the zoom cluster isn't rendered (non-map pages); on
               the map page the zoom-in button carries the auto-margin
               and Night sits flush with the rest. *@
            <button class="btn btn-sm btn-outline-secondary topbar-icon-btn @(IsMapRoute ? "" : "ms-auto")"
                    @onclick="CycleNightMode"
                    title="@(Settings.NightMode ? $"Night ({Settings.NightModePreset}) - tap to advance" : "Night mode")"
                    aria-label="@(Settings.NightMode ? "Advance night-mode preset" : "Switch to night mode")">
                @if (Settings.NightMode)
                {
                    @((MarkupString)OnaPlotter.Utilities.Icons.Small.Sun)
                }
                else
                {
                    @((MarkupString)OnaPlotter.Utilities.Icons.Small.Moon)
                }
            </button>

            @* Fullscreen button. Only rendered when the browser can
               actually fullscreen a non-video element - iPad Safari
               (tab mode) cannot, so we simply hide the button there;
               the user installs the app via Share -> Add to Home
               Screen to get a true fullscreen launcher. See wwwroot/js/platform/fullscreen.js
               ::isSupported(). Standalone PWAs also hide the button
               because they're already fullscreen at launch.
               NO Blazor @onclick - fullscreen.js wires a native
               click listener via attachTrigger() below. Requesting
               fullscreen on Safari / iOS must happen synchronously
               from a user gesture; a Blazor @onclick round-trips
               through the Blazor event dispatcher and often loses
               the user-gesture context, which makes
               requestFullscreen() silently reject. *@
            <button @ref="fsBtnRef"
                    class="btn btn-sm btn-outline-secondary topbar-icon-btn topbar-fullscreen-btn @(fullscreenSupported ? "" : "d-none")"
                    title="@(isFullscreen ? "Exit fullscreen" : "Enter fullscreen")"
                    aria-label="@(isFullscreen ? "Exit fullscreen" : "Enter fullscreen")">
                @if (isFullscreen)
                {
                    @((MarkupString)OnaPlotter.Utilities.Icons.Small.FullscreenExit)
                }
                else
                {
                    @((MarkupString)OnaPlotter.Utilities.Icons.Small.FullscreenEnter)
                }
            </button>
        </div>

        @{
            var activeAlarms = Alarms.ActiveAlarms;
            var snoozed = Alarms.SnoozedTargets;
        }
        @{ var hiddenAlarms = Alarms.HiddenAlarmsCount; }
        @if (activeAlarms.Count > 0)
        {
            @* role=alert + aria-live=assertive so screen readers
               announce every CPA / Shallow / Anchor alarm the moment
               it lands. Without this SR users get zero audio cue from
               the banner stack; the audible alarm speaker is the only
               signal and it's trivially silenced. aria-atomic means
               the whole banner is re-read on change, not just the diff
               (a changed TCPA on the same target reads as a fresh
               announcement). *@
            <div class="alarm-banner-stack" role="alert" aria-live="assertive" aria-atomic="true">
                @foreach (var a in activeAlarms)
                {
                    @* oncontextmenu:preventDefault silences the iOS /
                       right-click browser menu on the banner. Without it
                       long-press on an acknowledge triggers "Copy / Share"
                       instead of the hold-to-dismiss gesture, per field
                       report. *@
                    <div class="alarm-banner @(a.Severity == AlarmSeverity.Danger ? "alarm-danger" : "alarm-warn")"
                         @key="(a.Title, a.TargetKey)"
                         @oncontextmenu:preventDefault @oncontextmenu:stopPropagation
                         @oncontextmenu="NoOpContextMenu">
                        @if (a.Severity == AlarmSeverity.Danger)
                        {
                            @* Hold-to-dismiss on Danger alarms. A drag-
                               anchor alarm or a grounding warning shouldn't
                               clear from a pocket brush or an accidental
                               double-tap; the captain has to mean it.
                               Keyboard parity: Space-held on a focused
                               banner runs the same hold. Mirrors the
                               autopilot engage pattern. *@
                            <div class="alarm-body alarm-body-hold @(HoldingAlarmKey == AlarmKeyOf(a) ? "alarm-holding" : "")"
                                 role="button" tabindex="0"
                                 aria-label="@($"{a.Title} alarm - hold to dismiss")"
                                 @onpointerdown="() => StartAlarmHold(a)"
                                 @onpointerup="EndAlarmHold"
                                 @onpointerleave="EndAlarmHold"
                                 @onpointercancel="EndAlarmHold"
                                 @onkeydown="(e) => OnAlarmKeyDown(e, a)"
                                 @onkeyup="OnAlarmKeyUp"
                                 title="Hold (or hold Space) to dismiss">
                                <strong>@a.Title</strong> @a.Message
                                <span class="alarm-hold-hint">hold to dismiss</span>
                            </div>
                        }
                        else
                        {
                            <div class="alarm-body" @onclick="() => DismissOne(a)">
                                <strong>@a.Title</strong> @a.Message
                            </div>
                        }
                        @if (a.Title == "APPROACH")
                        {
                            @* One-tap "arrived, on to the next leg" for
                               multi-WP routes. Hits the SignalK /nextPoint
                               PUT which increments the server-side pointIndex;
                               the active-course delta flips to the new leg
                               and the banner auto-clears on the next tick. *@
                            <button class="alarm-action" @onclick="() => NextWaypoint(a)" @onclick:stopPropagation
                                    title="Advance the active route to the next waypoint">
                                Next WP
                            </button>
                        }
                        @if (a.TargetKey is not null && a.Snoozeable)
                        {
                            <button class="alarm-snooze" @onclick="() => SnoozeOne(a)" @onclick:stopPropagation
                                    title="Silence this target for @Alarms.SnoozeDurationMinutes minutes">
                                Snooze @Alarms.SnoozeDurationMinutes m
                            </button>
                        }
                    </div>
                }
                @if (hiddenAlarms > 0)
                {
                    @* Overflow hint: tells the helm that dismissing the top
                       alarm will reveal another one beneath. Clicking opens
                       the alarm log where the full list lives. Matches the
                       banner styling so it doesn't draw more attention than
                       the actual alarms above it. *@
                    <button class="alarm-overflow"
                            @onclick="ToggleAlarmLog"
                            title="Open alarm log to see all @(activeAlarms.Count + hiddenAlarms) active alarms">
                        +@hiddenAlarms more (tap to open log)
                    </button>
                }
            </div>
        }

        @* Rearm-chip was dropped on user request (visual noise; the
           cooldown is a dev concept, not a helmsman affordance). The
           snooze chips stay: they DO represent a user-made choice
           ("shut up about this target") and the tap-to-unsnooze
           affordance is genuine. *@
        @if (snoozed.Count > 0)
        {
            <div class="snooze-chips">
                @foreach (var s in snoozed)
                {
                    <button class="snooze-chip" @onclick="() => UnsnoozeOne(s.TargetKey)" @key="s.TargetKey"
                            title="Un-snooze @s.Label">
                        <span class="snooze-chip-label">Snoozed: @s.Label</span>
                        <span class="snooze-chip-time">@FormatRemaining(s.ExpiresAt)</span>
                        <span class="snooze-chip-close">x</span>
                    </button>
                }
            </div>
        }

        @if (alarmLogOpen)
        {
            @* Backdrop: tap anywhere outside the panel to dismiss. Invisible
               on desktop (just serves as an outside-click target), dimmed
               on phone under the bottom-sheet so the sheet reads as modal. *@
            <div class="alarm-log-backdrop" @onclick="ToggleAlarmLog"></div>
            <div class="alarm-log-panel @(alarmLogOpen ? "alarm-log-open" : "")"
                 role="dialog" aria-modal="true" aria-labelledby="alarm-log-title"
                 tabindex="-1"
                 @ref="_alarmLogPanelRef"
                 @onclick:stopPropagation
                 @onkeydown="OnAlarmLogKeyDown">
                @* Tappable on mobile: the grab-handle affordance
                   telegraphs "dismiss me", so it had better actually
                   dismiss. Real <button> so keyboard Space/Enter work
                   without a separate key handler. *@
                <button type="button" class="alarm-log-handle" aria-label="Close alarm log"
                        @onclick="ToggleAlarmLog"></button>
                <div class="alarm-log-header">
                    <strong id="alarm-log-title">Alarms</strong>
                    <button class="alarm-log-close" @onclick="ToggleAlarmLog" aria-label="Close">x</button>
                </div>
                @* Active alarms section. Shown above the dismissed history
                   on every layout - the helm asked for this both as the
                   single source of truth on mobile (where the banner stack
                   is suppressed) and as a one-place "what's currently
                   firing + what fired recently" view on desktop / tablet.
                   Each row uses the same severity-tinted styling family as
                   the banner; tap-target affordances are the SAME actions
                   the banner offered (Next WP for APPROACH, Snooze for
                   targeted alarms, Dismiss for everything). Danger alarms
                   keep the hold-to-dismiss safety so a stray tap on a
                   rolling cockpit can't silence a depth alarm. *@
                @{
                    var activeForOverlay = Alarms.ActiveAlarms;
                }
                @if (activeForOverlay.Count > 0)
                {
                    <div class="alarm-log-section alarm-log-active">
                        <div class="alarm-log-section-title">Active</div>
                        <ul class="alarm-log-list">
                            @foreach (var a in activeForOverlay)
                            {
                                <li class="alarm-log-item alarm-log-active-item @(a.Severity == AlarmSeverity.Danger ? "alarm-danger" : "alarm-warn")"
                                    @key="(a.Title, a.TargetKey)">
                                    <span class="alarm-log-title">@a.Title</span>
                                    <span class="alarm-log-msg">@a.Message</span>
                                    <div class="alarm-log-active-actions">
                                        @if (a.Title == "APPROACH")
                                        {
                                            <button class="alarm-action" @onclick="() => NextWaypoint(a)" @onclick:stopPropagation
                                                    title="Advance the active route to the next waypoint">
                                                Next WP
                                            </button>
                                        }
                                        @if (a.TargetKey is not null && a.Snoozeable)
                                        {
                                            <button class="alarm-snooze" @onclick="() => SnoozeOne(a)" @onclick:stopPropagation
                                                    title="Silence this target for @Alarms.SnoozeDurationMinutes minutes">
                                                Snooze @Alarms.SnoozeDurationMinutes m
                                            </button>
                                        }
                                        @if (a.Severity == AlarmSeverity.Danger)
                                        {
                                            @* Same hold-to-dismiss the banner enforces -
                                               a stray tap here on a rolling cockpit
                                               shouldn't silence a depth alarm. The
                                               existing StartAlarmHold / EndAlarmHold
                                               / OnAlarmKeyDown / OnAlarmKeyUp pipeline
                                               drives the visual fill on the banner side
                                               via the .alarm-holding class; we reuse it
                                               here so the gesture is identical. *@
                                            <button class="alarm-action alarm-action-danger @(HoldingAlarmKey == AlarmKeyOf(a) ? "alarm-holding" : "")"
                                                    @onpointerdown="() => StartAlarmHold(a)"
                                                    @onpointerup="EndAlarmHold"
                                                    @onpointerleave="EndAlarmHold"
                                                    @onpointercancel="EndAlarmHold"
                                                    @onkeydown="(e) => OnAlarmKeyDown(e, a)"
                                                    @onkeyup="OnAlarmKeyUp"
                                                    title="Hold to dismiss">
                                                Hold to dismiss
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="alarm-action" @onclick="() => DismissOne(a)" @onclick:stopPropagation
                                                    title="Dismiss this alarm">
                                                Dismiss
                                            </button>
                                        }
                                    </div>
                                </li>
                            }
                        </ul>
                    </div>
                }
                @if (Alarms.DismissedHistory.Count == 0 && activeForOverlay.Count == 0)
                {
                    <div class="alarm-log-empty">No active or recent alarms.</div>
                }
                else if (Alarms.DismissedHistory.Count == 0)
                {
                    <div class="alarm-log-empty alarm-log-empty-recent">No recent alarms.</div>
                }
                else if (Alarms.DismissedHistory.Count > 0)
                {
                    @* Coalesce consecutive entries that share the same
                       (Title, Reason, TargetKey) so a noisy sensor
                       (e.g. depth flapping on every tide tick) doesn't
                       drown the rest of the log. One row per run with
                       a count chip and the latest timestamp; expand-
                       on-tap is a
                       future affordance, the count alone is enough to
                       not lose information. *@
                    <div class="alarm-log-section alarm-log-recent">
                        @if (activeForOverlay.Count > 0)
                        {
                            <div class="alarm-log-section-title">Recent</div>
                        }
                        <ul class="alarm-log-list">
                            @foreach (var g in CoalesceDismissedHistory(Alarms.DismissedHistory))
                            {
                                <li class="alarm-log-item alarm-log-@g.Latest.Reason.ToString().ToLowerInvariant()"
                                    @key="(g.Latest.Alarm.Title, g.Latest.Alarm.TargetKey, g.Latest.Reason, g.Latest.At)">
                                    <span class="alarm-log-time">@g.Latest.At.ToLocalTime().ToString("HH:mm:ss")</span>
                                    <span class="alarm-log-title">@g.Latest.Alarm.Title</span>
                                    @if (g.Count > 1)
                                    {
                                        <span class="alarm-log-count" title="@($"{g.Count} consecutive occurrences")">x@(g.Count)</span>
                                    }
                                    <span class="alarm-log-reason">@FormatReason(g.Latest.Reason)</span>
                                    <span class="alarm-log-msg">@g.Latest.Alarm.Message</span>
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>
        }

        <article class="content px-4">
            @Body
        </article>

        @* Global confirmation modal. Hosted here so every page / panel
           shares one styled dialog through IConfirmationService. *@
        <ConfirmationDialog />

        @* === Toast notifications ===
           role=status + aria-live=polite so transient status ("Saved",
           "Reconnecting...") reaches screen-reader users. Errors get a
           per-item aria-live=assertive so a failure isn't queued
           behind a trailing success toast. *@
        @if (Toasts.Active.Count > 0)
        {
            <div class="toast-stack" role="status" aria-live="polite">
                @foreach (var t in Toasts.Active)
                {
                    <div class="toast-item toast-@(t.Level.ToString().ToLowerInvariant())"
                         @key="t.Id"
                         role="status"
                         aria-live="@(t.Level == ToastLevel.Error ? "assertive" : "polite")"
                         @onclick="() => Toasts.Dismiss(t.Id)">
                        <span class="toast-message">@t.Message</span>
                        @if (t.ActionLabel is not null && t.Action is not null)
                        {
                            <button class="toast-action" @onclick="() => RunToastAction(t)"
                                    @onclick:stopPropagation>
                                @t.ActionLabel
                            </button>
                        }
                    </div>
                }
            </div>
        }
    </main>
</div>

@code {
    private IJSObjectReference? audioModule;
    private IJSObjectReference? fsModule;
    // Tab-visibility hook for re-probing /skServer/loginStatus the
    // moment the helm switches back from the SK admin tab. Without
    // this the not-logged-in chip lingers up to 5 min after a fresh
    // login. See wwwroot/js/visibility.js for the listener side.
    private IJSObjectReference? visibilityModule;
    // Leaflet module handle used by the topbar zoom buttons. Imported
    // lazily on first click so non-map pages don't pay the cost, and
    // shared via ES-module caching with Map.razor's own import (same
    // URL = same module instance = same `map` variable).
    private IJSObjectReference? leafletModule;
    // Applies the night-mode CSS classes to <html> so body + every
    // descendant inherits the redefined design tokens. A .page-
    // scoped class fails to recolour body because body sits above
    // .page in the DOM and reads var(--sk-bg) at its own scope.
    private IJSObjectReference? themeModule;
    private DotNetObjectReference<MainLayout>? fsSelfRef;
    // Element reference for the fullscreen button. fullscreen.js wires
    // a native click listener to this ref instead of going through
    // Blazor's @onclick, because Safari / iOS require
    // requestFullscreen() to run inside a synchronous user-gesture
    // context and Blazor's event dispatcher breaks that chain.
    private ElementReference fsBtnRef;
    private bool isFullscreen;
    // Whether the browser can fullscreen the document root. iPad
    // Safari (tab mode) returns false; fullscreen.js::isSupported()
    // owns the detection and this mirrors it so Razor can hide the
    // button. Defaults to false until JS answers; hiding is the safer
    // default (a missing button beats a broken one).
    private bool fullscreenSupported;
    private System.Threading.Timer? staleCheckTimer;
    private System.Threading.Timer? snoozeCountdownTimer;
    private System.Threading.Timer? firstRunOfflineTimer;
    private volatile bool wasDisconnected;
    private volatile bool wasStale;
    private bool alarmLogOpen;
    private bool firstRunOfflineToastShown;
    /// <summary>Cached login-status snapshot. Probed once at app
    /// start via IAuthApi.GetLoginStatusAsync and refreshed every
    /// 5 minutes thereafter - short enough that the helm sees the
    /// chip clear within a few minutes after they sign in via the
    /// SK admin tab, long enough that the probe doesn't add
    /// measurable network noise. Null means "haven't probed yet"
    /// or "endpoint absent / failed"; the chip stays hidden in
    /// either case.</summary>
    private LoginStatus? _loginStatus;
    private System.Threading.Timer? authPollTimer;
    /// <summary>Coalesces overlapping probes. At the warning-shown
    /// 2s cadence, a network stall can leave a previous probe in
    /// flight when the next tick fires (AuthApi caps each probe at
    /// 8s). Interlocked guard skips the duplicate - queuing them
    /// up would build a backlog of stale 401 round-trips with no
    /// UX benefit.</summary>
    private int _authProbeInFlight;
    /// <summary>Login-state polling cadence. Fast 2s while the
    /// not-logged-in chip is up so the helm signing in via the SK
    /// admin tab sees the chip clear within a tick or two; slow
    /// 1-min cadence once logged in (or on a no-security server)
    /// just to catch a session expiry without a manual reload.
    /// Cadence is re-evaluated after every probe.</summary>
    private static readonly TimeSpan AuthPollIntervalWarningShown =
        TimeSpan.FromSeconds(2);
    private static readonly TimeSpan AuthPollIntervalWarningHidden =
        TimeSpan.FromMinutes(1);
    /// <summary>Browser origin used to build the
    /// <c>/skServer/login</c> link in the not-logged-in chip.
    /// Captured once at OnInitialized; the chip's href is built
    /// against this so a same-origin SK install (the common case)
    /// gets a relative-ish link the helm can open in a new tab.</summary>
    private string _baseUri = "";
    private const string SkAdminLoginPath = "/admin/#/login";

    private string ConnectionClass => SignalkClient.IsConnected
        ? (SignalkClient.IsDataStale ? "stale" : "")
        : "disconnected";

    private string DotClass => SignalkClient.IsConnected
        ? (SignalkClient.IsDataStale ? "stale" : "connected")
        : "disconnected";

    private string ConnectionLabel => SignalkClient.IsConnected
        ? (SignalkClient.IsDataStale ? "Stale" : "Live")
        : "Offline";

    private string ConnectionTooltip => SignalkClient.IsConnected
        ? (SignalkClient.IsDataStale ? "Connected but no data received for 5+ seconds" : "Receiving data")
        : "WebSocket connection lost";

    protected override void OnInitialized()
    {
        SignalkClient.OnConnectionChanged += HandleConnectionChanged;
        SignalkClient.OnDataChanged += HandleDataChanged;
        // Wake the alarm pipeline whenever a server notification
        // mutates - including local synthetics produced by
        // MobService. Subscribing directly to the store keeps the
        // dependency direction honest (the alarm pipeline depends
        // on the store, not the WS client) and avoids back-door
        // OnDataChanged fires from non-WS sources.
        ServerNotifications.OnPathChanged += HandleNotificationPathChanged;
        Toasts.OnChanged += HandleToastsChanged;
        Settings.OnSettingsChanged += HandleSettingsChanged;
        Alarms.OnAlarmChanged += HandleAlarmChanged;
        Alarms.OnAlarmsChanged += HandleAlarmsChanged;
        // UpdateChecker fires when the server's bundle hash diverges
        // from ours. The chip in the topbar above gates on
        // Updates.IsUpdateAvailable - this re-render unhides it.
        Updates.OnChanged += HandleUpdatesChanged;
        // Re-render when the route changes so the topbar zoom
        // buttons appear/disappear based on IsMapRoute.
        Nav.LocationChanged += HandleLocationChanged;
        // Seed the cached IsMapRoute from the initial URL; the
        // LocationChanged event only fires on subsequent changes.
        RefreshIsMapRoute();

        // Periodically check for stale data (every 2 seconds).
        staleCheckTimer = new System.Threading.Timer(_ => _ = CheckStaleAsync(), null, 2000, 2000);

        // Capture the SK admin link target once. NavigationManager.BaseUri
        // is the page origin (e.g. https://openplotter.local/) - the SK
        // admin lives at /admin/#/login on the same origin in the typical
        // signalk-server install.
        _baseUri = Nav.BaseUri.TrimEnd('/');

        // Probe login status. One-shot at app start, then on a
        // dynamic cadence that the probe itself re-tunes:
        //   - 2 s while the not-logged-in chip is up (the helm is
        //     most likely about to sign in via the SK admin tab; we
        //     want the chip to clear within a couple of seconds);
        //   - 1 min once logged in or on a no-security server (cheap
        //     keep-alive so a session expiry surfaces quickly).
        // The probe degrades to null (chip hidden) on 404 / transport
        // failure - third-party SK servers without /skServer/loginStatus
        // see no chip rather than a "broken auth" warning.
        _ = RefreshLoginStatusAsync();
        authPollTimer = new System.Threading.Timer(
            _ => _ = RefreshLoginStatusAsync(), null,
            AuthPollIntervalWarningHidden, AuthPollIntervalWarningHidden);
        // Snoozed-chip countdown refresh: updates the "7m" label each
        // minute. Separate from the stale check to keep the two concerns
        // independent.
        snoozeCountdownTimer = new System.Threading.Timer(
            _ => _ = RefreshSnoozeCountdownAsync(), null, 60_000, 60_000);
    }

    /// <summary>UpdateChecker fires this when the server's bundle
    /// hash diverges. Re-render so the new chip is visible. Sticky:
    /// once shown, even a later poll that matches stays the chip
    /// up because the helm has already SEEN the prompt.</summary>
    private void HandleUpdatesChanged() => InvokeAsync(StateHasChanged);

    /// <summary>Force-reload the page so the browser fetches the
    /// fresh index.html + WASM bundle. NavigationManager.NavigateTo
    /// with forceLoad=true triggers a full document load; combined
    /// with the SK webapp host's cache headers on those paths, the
    /// helm gets the new bundle in one tap.</summary>
    private void ReloadForUpdate() => Nav.NavigateTo(Nav.Uri, forceLoad: true);

    private async void HandleSettingsChanged()
    {
        try
        {
            // Live-apply the wake-lock toggle so a user flipping
            // "Keep screen awake" in Settings sees the lock engage /
            // release immediately, without a page reload.
            if (wakeLockModule is not null)
            {
                try { await wakeLockModule.InvokeVoidAsync("setWakeLock", Settings.KeepScreenAwake); }
                catch (JSDisconnectedException) { }
            }
            // Re-apply the theme + night-mode classes to <html> on
            // every settings change so preset swaps + auto-night flips
            // + theme picks propagate globally. Both helpers are
            // idempotent - safe to call with identical args.
            if (themeModule is not null)
            {
                try
                {
                    await themeModule.InvokeVoidAsync("setTheme",
                        Settings.Theme);
                    await themeModule.InvokeVoidAsync("setNightMode",
                        Settings.NightMode, Settings.NightModePreset);
                }
                catch (JSDisconnectedException) { }
            }
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException) { }
    }

    private async void HandleToastsChanged()
    {
        try { await InvokeAsync(StateHasChanged); }
        catch (ObjectDisposedException) { }
    }

    private async void HandleAlarmsChanged()
    {
        // Any alarm-state change (stack, snooze list, history) redraws
        // the UI. Audio is handled by HandleAlarmChanged which only fires
        // when the TOP alarm transitions.
        try { await InvokeAsync(StateHasChanged); }
        catch (ObjectDisposedException) { }
    }

    private async void HandleAlarmChanged(AlarmInfo? active)
    {
        // `active` is a snapshot captured at the moment the event fired, so
        // the audio decision is based on the transition that actually
        // happened - not on whatever the top alarm happens to be after
        // the InvokeAsync await resolves.
        try
        {
            await InvokeAsync(async () =>
            {
                if (active is null)
                {
                    await StopAlarmAsync();
                }
                else if (audioModule is not null)
                {
                    // Re-arm on every top transition (including severity
                    // escalation within the same target) so the Danger
                    // cadence supersedes the Warn cadence audibly.
                    int cadence = active.Severity == AlarmSeverity.Danger ? 1000 : 3000;
                    try { await audioModule.InvokeVoidAsync("startAlarm", cadence); }
                    catch (JSDisconnectedException) { }
                }
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException) { }
    }

    /// <summary>Advance the night-mode state through the preset
    /// cycle: off -> dusk -> soft -> amber -> red -> off. Mirrors
    /// the Map page's More-menu Night button so a helm picking the
    /// topbar shortcut sees the same behaviour. Dusk is the
    /// non-red-shifted intermediate; soft / amber / red are the
    /// progressively-redder presets. Records the env.sun cluster at
    /// toggle time so auto-night suppresses until the next day/night
    /// transition (matches the Map button's override logic).</summary>
    private async Task CycleNightMode()
    {
        await Settings.MarkManualNightToggleAsync(SunClusterFromState(SignalkClient.Data.SunState));
        if (!Settings.NightMode)
        {
            await Settings.SetNightModeAsync(true);
            await Settings.SetNightModePresetAsync("dusk");
        }
        else
        {
            string? next = Settings.NightModePreset switch
            {
                "dusk" => "soft",
                "soft" => "amber",
                "amber" => "red",
                _ => null,
            };
            if (next is null)
            {
                await Settings.SetNightModeAsync(false);
            }
            else
            {
                await Settings.SetNightModePresetAsync(next);
            }
        }
        StateHasChanged();
    }

    /// <summary>Same env.sun cluster mapping as Map.SunClusterFromState
    /// - duplicated rather than shared because IThemeSettings
    /// shouldn't have to know about NavigationData and a tiny
    /// helper isn't worth a dedicated utility class.</summary>
    private static string? SunClusterFromState(string? sunState) => sunState switch
    {
        "day" or "dawn" => "day",
        "dusk" or "night" => "night",
        _ => null,
    };

// ToggleFullscreen() was here; the button now dispatches through
    // a native click listener wired from fullscreen.js::attachTrigger
    // (synchronous with the user gesture, which Safari requires).
    // Removing the C# method prevents a second caller from re-
    // introducing the gesture-chain bug by routing through Blazor
    // dispatch.

    /// <summary>Fires every time the tab becomes visible, wired from
    /// wwwroot/js/visibility.js. We use it to re-probe
    /// /skServer/loginStatus immediately so the helm who fixed the
    /// underlying auth problem in the SK admin tab sees the chip
    /// clear on return - the 5-min poll alone makes the chip feel
    /// stuck. Fire-and-forget: the probe handles its own errors.</summary>
    [JSInvokable]
    public void OnTabVisible()
    {
        _ = RefreshLoginStatusAsync();
    }

    [JSInvokable]
    public async Task OnFullscreenChanged(bool fs)
    {
        isFullscreen = fs;
        // Auto-flip the sidebar to match the fullscreen state. Helms
        // who entered fullscreen historically expected the rail to
        // collapse to icons-only ("more chart for the same screen");
        // historically that was wired via a CSS-only `:fullscreen
        // .sidebar` rule, but that rule overrode the user's chevron-
        // toggle in the rail (the sidebar couldn't be re-expanded
        // while fullscreen was on). Now we mirror the state into
        // Settings.SidebarCollapsed so the manual toggle stays
        // authoritative - enter fullscreen collapses, exit expands,
        // and a tap on the rail chevron after either direction wins.
        // Skip the write if the setting already matches to avoid
        // firing OnSettingsChanged on every fullscreenchange.
        if (Settings.SidebarCollapsed != fs)
        {
            await Settings.SetSidebarCollapsedAsync(fs);
        }
        await InvokeAsync(StateHasChanged);
    }

    // True when the current URL is the Map page. Drives visibility
    // of the topbar zoom buttons - there's no map to zoom anywhere
    // else. Cached + refreshed only when the location actually
    // changes (HandleLocationChanged) so the MainLayout render path
    // doesn't allocate a new Uri per call (this layout re-renders
    // multiple times a second during alarm chatter).
    private bool _isMapRoute;
    private bool IsMapRoute => _isMapRoute;

    private void RefreshIsMapRoute()
    {
        // EndsWith("/map") covers both bare "/map" and the SignalK-
        // webapp-mounted "/signalk-onaplotter/map" because TrimEnd
        // collapses any trailing slash. No separate Equals check
        // needed.
        var path = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/');
        _isMapRoute = path.EndsWith("/map", StringComparison.OrdinalIgnoreCase);
    }

    // Topbar zoom buttons. Share the same leafletInterop.js module
    // instance as Map.razor via ES module caching, so these drive the
    // exact same `map` object the Map page set up. No-op when the
    // module hasn't loaded yet / map not initialised (JS guards that).
    private async Task EnsureLeafletModuleAsync()
    {
        leafletModule ??= await JS.InvokeAsync<IJSObjectReference>(
            "import", "./js/leafletInterop.js");
    }

    private async Task ZoomInAsync()
    {
        try
        {
            await EnsureLeafletModuleAsync();
            await leafletModule!.InvokeVoidAsync("zoomIn", 1);
        }
        catch (JSDisconnectedException) { }
    }

    /// <summary>
    /// Topbar SearchBox -> picked PlaceResult. Flies the map and
    /// drops the search-pin via the leaflet JS module. The pin
    /// replaces any previous one (the JS side handles the swap).
    /// JSDisconnectedException swallowed because the helm could
    /// have navigated away mid-search; failing silently is the
    /// right move when the target map no longer exists.
    /// </summary>
    private async Task HandlePlacePicked(OnaPlotter.Services.Places.PlaceResult result)
    {
        try
        {
            await EnsureLeafletModuleAsync();
            // null zoom -> JS keeps current zoom but lifts to a
            // sensible minimum (12) so a world-zoom helm searching
            // a city doesn't end up looking at a continent.
            await leafletModule!.InvokeVoidAsync(
                "flyToSearchResult", result.Lat, result.Lon, null);
        }
        catch (JSDisconnectedException) { }
        catch (JSException ex)
        {
            // A non-disconnected JS error (Leaflet flyTo throwing on a
            // zero-size map; a stale shell deployment where the new
            // wasm calls flyToSearchResult against an old bundle that
            // doesn't export it). Log enough context that the support
            // grep loop can trace which pick failed - without this
            // the error relay catches "unhandled exception in
            // component" with no breadcrumb naming the place result.
            Logger.LogWarning(ex,
                "[place] flyTo failed for {Source} {Lat},{Lon}",
                result.Source, result.Lat, result.Lon);
        }
    }

    /// <summary>
    /// Topbar SearchBox -> helm cleared the input. Tear down the
    /// search-pin on the JS side so a stale ring doesn't linger on
    /// the chart after the dropdown is gone (helm reads "no active
    /// search" but the pin says otherwise).
    /// </summary>
    private async Task HandlePlaceCleared()
    {
        try
        {
            await EnsureLeafletModuleAsync();
            await leafletModule!.InvokeVoidAsync("clearSearchPin");
        }
        catch (JSDisconnectedException) { }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "[place] clearSearchPin failed");
        }
    }

    private async Task ZoomOutAsync()
    {
        try
        {
            await EnsureLeafletModuleAsync();
            await leafletModule!.InvokeVoidAsync("zoomOut", 1);
        }
        catch (JSDisconnectedException) { }
    }

    private void HandleLocationChanged(object? sender,
        Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        RefreshIsMapRoute();
        _ = InvokeAsync(StateHasChanged);
    }

    private void ReconnectNow()
    {
        // Signals the receive loop to bypass its current backoff delay.
        // The connection chip rerenders via HandleConnectionChanged once
        // the new ConnectAsync resolves (success) or fails (another loop
        // with a reset backoff).
        SignalkClient.ReconnectNow();
        Toasts.Show("Reconnecting...", ToastLevel.Info, durationSec: 3);
    }

    /// <summary>Reference to the alarm-log dialog root so we can
    /// focus it on open (entering the focus trap) and so the keydown
    /// handler can resolve focusable descendants for the Tab cycle.
    /// </summary>
    private ElementReference _alarmLogPanelRef;

    /// <summary>True when ToggleAlarmLog just opened the dialog;
    /// OnAfterRenderAsync uses this latch to push initial focus into
    /// the panel exactly once per open. Without the latch, every
    /// re-render while the panel is open would re-focus the dialog
    /// root and steal focus from whatever the helm tabbed onto.</summary>
    private bool _alarmLogJustOpened;

    private void ToggleAlarmLog()
    {
        alarmLogOpen = !alarmLogOpen;
        _alarmLogJustOpened = alarmLogOpen;
    }

    /// <summary>Keyboard handler for the alarm-log modal dialog.
    /// Escape closes. Tab / Shift-Tab cycles focus inside the panel
    /// via a JS focus-trap helper so an external keyboard on iPad
    /// can't tab into the chart underneath while the dialog is open
    /// (the aria-modal attribute alone doesn't enforce this -
    /// browsers don't trap focus, only assistive tech reads it).</summary>
    private async Task OnAlarmLogKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (!alarmLogOpen) return;
        if (e.Key == "Escape")
        {
            alarmLogOpen = false;
            return;
        }
        if (e.Key == "Tab")
        {
            try
            {
                await JS.InvokeVoidAsync("eval",
                    "(function(panel, back){" +
                    "if(!panel) return;" +
                    "var focusables = panel.querySelectorAll('button,[href],input,select,textarea,[tabindex]:not([tabindex=\"-1\"])');" +
                    "if(focusables.length===0){panel.focus();return;}" +
                    "var first = focusables[0], last = focusables[focusables.length-1];" +
                    "var active = document.activeElement;" +
                    "if(back && active === first){last.focus();}" +
                    "else if(!back && active === last){first.focus();}" +
                    "})(arguments[0], arguments[1]);",
                    _alarmLogPanelRef, e.ShiftKey);
            }
            catch (Microsoft.JSInterop.JSDisconnectedException) { }
            catch (Microsoft.JSInterop.JSException) { }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Push initial focus into the alarm-log panel when it opens so
        // an external keyboard's first Tab cycles within the dialog,
        // not into the chart underneath. The latch resets on close so
        // re-renders while the panel is open don't steal focus.
        if (_alarmLogJustOpened)
        {
            _alarmLogJustOpened = false;
            try { await _alarmLogPanelRef.FocusAsync(preventScroll: true); }
            catch (Microsoft.JSInterop.JSDisconnectedException) { }
            catch (Microsoft.JSInterop.JSException) { }
        }

        if (firstRender)
        {
            await Settings.InitializeAsync();
            // First-run-on-phone default: collapse the sidebar to the
            // icon rail so a 600px-wide screen isn't half-eaten by
            // labels the helm rarely needs. The check happens AFTER
            // Settings.InitializeAsync so any persisted user choice
            // wins; ApplyMobileFirstRunDefaultsAsync is a no-op once
            // the helm has toggled the chevron at least once.
            try
            {
                var viewport = await JS.InvokeAsync<IJSObjectReference>(
                    "import", "./js/platform/viewport.js");
                bool isMobile = await viewport.InvokeAsync<bool>("isMobile");
                await Settings.ApplyMobileFirstRunDefaultsAsync(isMobile);
                await viewport.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
            // Rehydrate snoozed targets from the KV store so a reload
            // doesn't forget that the ferry is silenced for another 4
            // minutes. Safe to call before anything is rendered; the
            // OnAlarmsChanged event fires if anything was loaded.
            await Alarms.InitializeAsync();
            StateHasChanged();
            audioModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/platform/audioAlert.js");
            fsModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/platform/fullscreen.js");
            // Theme module applies theme + night-mode classes to <html>
            // so body background + anything outside .page honours the
            // palette. Both writes go through the helper's whitelist so
            // a corrupt Settings store can't smuggle a class injection.
            themeModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/platform/themeApply.js");
            try
            {
                await themeModule.InvokeVoidAsync("setTheme", Settings.Theme);
                await themeModule.InvokeVoidAsync("setNightMode",
                    Settings.NightMode, Settings.NightModePreset);
            }
            catch (JSDisconnectedException) { }
            fsSelfRef = DotNetObjectReference.Create(this);
            await fsModule.InvokeVoidAsync("subscribe", fsSelfRef);

            // Hook tab-visibilitychange so the not-logged-in chip
            // re-probes the server the moment the helm returns from
            // signing in via the SK admin tab. The same fsSelfRef
            // doubles as the JSInvokable target - one DotNetObjectReference
            // serves both fullscreen-state and tab-visible callbacks.
            // Best-effort: a missing module file or a JSDisconnected at
            // boot leaves us on the 5-min poll fallback rather than
            // failing the whole layout init.
            try
            {
                visibilityModule = await JS.InvokeAsync<IJSObjectReference>(
                    "import", "./js/visibility.js");
                await visibilityModule.InvokeVoidAsync(
                    "attachVisibilityListener", fsSelfRef, nameof(OnTabVisible));
            }
            catch (JSDisconnectedException) { }
            catch (Exception ex)
            {
                Console.Error.WriteLine($"[auth] visibility hook failed: {ex.Message}");
            }
            // Wire a native click listener to the fullscreen button
            // (NOT via Blazor @onclick). Safari / iOS reject
            // requestFullscreen() if the call isn't synchronous with
            // a user gesture, and Blazor's event dispatcher crosses
            // enough async boundaries to break the gesture chain.
            // Resolve fullscreen support BEFORE attaching the trigger
            // so an unsupported browser (iPad Safari tab mode) hides
            // the button entirely; no point wiring a listener to an
            // element about to unmount via the d-none class swap.
            fullscreenSupported = await fsModule.InvokeAsync<bool>("isSupported");
            if (fullscreenSupported)
            {
                await fsModule.InvokeVoidAsync("attachTrigger", fsBtnRef);
            }
            isFullscreen = await fsModule.InvokeAsync<bool>("getState");
            StateHasChanged();

            // Wake lock is now managed from here rather than from the
            // Map page, so switching Chart -> Wind / History / Settings
            // mid-watch doesn't drop the screen lock. Lives in its own
            // tiny module (wakeLock.js) so importing doesn't drag the
            // whole Leaflet bundle in.
            wakeLockModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/platform/wakeLock.js");
            if (Settings.KeepScreenAwake)
            {
                try { await wakeLockModule.InvokeVoidAsync("setWakeLock", true); }
                catch (JSDisconnectedException) { }
            }

            // First-run offline guidance. If we never connect within 5s of
            // the app loading, surface a toast pointing at the SignalK
            // config. Silenced on subsequent reconnect failures so it
            // doesn't spam the user with repeat-info on every flaky wifi
            // moment. One shot per session.
            firstRunOfflineTimer = new System.Threading.Timer(
                _ => _ = InvokeAsync(MaybeShowFirstRunOfflineToast),
                null, 5_000, Timeout.Infinite);
        }
    }

    // Keep the wake-lock module reference alive for the app's lifetime.
    private IJSObjectReference? wakeLockModule;

    private void MaybeShowFirstRunOfflineToast()
    {
        if (firstRunOfflineToastShown) return;
        if (SignalkClient.IsConnected) return;
        firstRunOfflineToastShown = true;
        Toasts.Warning("SignalK server unreachable. Check the server URL in wwwroot/appsettings.json, or run OnaPlotter as a SignalK webapp.");
    }

    private async void HandleConnectionChanged()
    {
        try
        {
            await InvokeAsync(async () =>
            {
                StateHasChanged();
                await UpdateConnectionAlarmAsync();
            });
        }
        catch (ObjectDisposedException) { }
    }

    private void HandleDataChanged()
    {
        try
        {
            // Clear the stale flag as soon as data flows again. The audio
            // stops via HandleAlarmChanged when AlarmManager resolves.
            if (wasStale)
            {
                wasStale = false;
                _ = InvokeAsync(StateHasChanged);
            }

            Alarms.Evaluate(SignalkClient.Data, AisStore.GetVessels(), Settings);
            MaybeAutoAdvanceWaypoint();
        }
        catch (ObjectDisposedException) { }
    }

    /// <summary>Re-evaluate alarms whenever a server notification mutates
    /// the active set. Reuses HandleDataChanged's evaluate path so the
    /// notification-driven re-evaluation behaves identically to the
    /// WS-frame-driven one (no separate code path for ServerNotifications-
    /// only changes). Path argument is unused - the rule pipeline reads
    /// the entire store on every Evaluate.</summary>
    private void HandleNotificationPathChanged(string _) => HandleDataChanged();

    // --- Auto-advance -------------------------------------------------
    //
    // The SignalK course-provider plugin publishes
    // perpendicularPassed / arrivalCircleEntered as booleans on every
    // active leg. When either flips to true we POST to
    // navigation/course/activeRoute/nextPoint so the boat flows through
    // the route without requiring a tap per waypoint - matches the
    // default behaviour of commercial chartplotters.
    //
    // Edge-triggered (_prevPerp / _prevArr): we only fire on the
    // false -> true transition. If the server re-publishes true for
    // the same leg without going false in between, the cooldown
    // window (_lastAutoAdvanceUtc) prevents a double-advance that
    // would skip a waypoint. 8 s is generous for the round-trip of
    // advance -> new-leg delta -> reset; tighter values get racy
    // on slow links.
    private bool _prevPerp;
    private bool _prevArr;
    private DateTime _lastAutoAdvanceUtc = DateTime.MinValue;
    private const int AutoAdvanceCooldownSec = 8;

    private void MaybeAutoAdvanceWaypoint()
    {
        // Diagnostic toast on every firing decision path. When a user
        // reports "auto-advance didn't work", we need to know which of
        // four possible skip reasons hit: setting off, no active
        // course, flag never went true, or cooldown window. Toasts are
        // Debug-level so they appear in console logs without spamming
        // the visible stack on every tick.
        if (!Settings.AutoAdvanceWaypoints)
        {
            _prevPerp = false; _prevArr = false;
            return;
        }
        var data = SignalkClient.Data;
        if (!data.HasActiveCourse)
        {
            _prevPerp = false; _prevArr = false;
            return;
        }

        bool perp = data.PerpendicularPassed == true;
        bool arr = data.ArrivalCircleEntered == true;

        bool perpEdge = perp && !_prevPerp;
        bool arrEdge = arr && !_prevArr;
        _prevPerp = perp;
        _prevArr = arr;

        if (!(perpEdge || arrEdge)) return;

        double sinceLastSec = (DateTime.UtcNow - _lastAutoAdvanceUtc).TotalSeconds;
        if (sinceLastSec < AutoAdvanceCooldownSec)
        {
            // Cooldown-skip happens on every delta tick during the
            // 8 s window after a fire; logging it on each call put
            // 8 string allocations + JS-interop console writes per
            // advance into the OnDataChanged hot path on Pi 4.
            return;
        }

        _lastAutoAdvanceUtc = DateTime.UtcNow;
        _ = AutoAdvanceAsync(perpEdge ? "perpendicular passed" : "arrival circle");
    }

    private async Task AutoAdvanceAsync(string reason)
    {
        // Multi-plotter idempotency: when more than one chartplotter
        // is wired to the same SK server (this app + Freeboard-SK,
        // or two ona-plotter tabs on a phone and the helm screen),
        // every client sees the same arrival edge and fires
        // concurrently. The relative "advance by 1" PUT
        // (/activeRoute/nextPoint with {value:1}) is NOT idempotent:
        // two racing PUTs both increment the server's pointIndex
        // and silently skip a waypoint. The absolute form
        // (PUT /activeRoute/pointIndex {value: N}) IS idempotent -
        // the second PUT lands on a value that's already set and is
        // a no-op.
        //
        // Last-leg exception: SetPointIndexAsync clamps out-of-range
        // values, so PUT pointIndex=total does NOT clear the active
        // course. Fall back to the relative call there - the race
        // is inert on the final leg (nothing to skip to), and the
        // relative call is what triggers the server's clear-on-arrive
        // so the "Arrived at final waypoint" toast still fires.
        var data = SignalkClient.Data;
        bool hadCourseBefore = data.HasActiveCourse;
        if (data.ActiveRoutePointIndex is not int currentIdx)
        {
            // No pointIndex means the SK server hasn't published v2
            // course state for this leg; we'd be guessing the target.
            // Fail loud rather than fall back to the relative call
            // and reintroduce the multi-plotter race.
            // Tell the helm what to do, not just that something failed.
            // pointIndex is missing when the server hasn't published v2
            // course state for the current leg; the manual relative
            // advance is the workaround. Surface it as a one-tap action
            // on the toast itself so the helm doesn't have to dig
            // through the alarm banner for the same call.
            Toasts.ShowAction(
                "Auto-advance unavailable (route position unknown).",
                "Next WP",
                async () =>
                {
                    try
                    {
                        var r = await CourseApi.AdvanceActiveRouteAsync();
                        if (!r.Success)
                            Toasts.Error($"Next waypoint failed: {r.Error ?? "server rejected"}");
                    }
                    catch (Exception ex) { Toasts.LogException(ex, "Next waypoint"); }
                },
                ToastLevel.Warning, durationSec: 8);
            return;
        }
        bool isLastLeg = data.ActiveRoutePointTotal is int total && currentIdx + 1 >= total;
        try
        {
            var r = isLastLeg
                ? await CourseApi.AdvanceActiveRouteAsync()
                : await CourseApi.SetPointIndexAsync(currentIdx + 1);
            if (!r.Success)
            {
                Toasts.Error($"Auto-advance failed: {r.Error ?? "server rejected"}");
                return;
            }
            Toasts.Info($"Next waypoint ({reason})");
            // Self-clear the latched APPROACH banner: the manual
            // "Next WP" tap on the alarm dismisses the alarm as part
            // of the same gesture (see NextWaypoint below); when the
            // system auto-advances on the helm's behalf the banner
            // should disappear too. Without this dismiss the helm
            // sees a stale APPROACH for the just-passed waypoint
            // until they exit the radius (and even then it stays
            // because the rule is AutoClear=false). The rule's
            // existing latch reset on coord change re-arms the
            // detector for the new waypoint; this dismiss is just
            // about clearing the on-screen banner.
            foreach (var alarm in Alarms.AllActiveAlarms)
            {
                if (string.Equals(alarm.Title, "APPROACH", StringComparison.Ordinal))
                {
                    await Alarms.DismissAsync(alarm);
                }
            }
            await Task.Delay(400);
            if (hadCourseBefore && !SignalkClient.Data.HasActiveCourse)
                Toasts.Success("Arrived at final waypoint");
        }
        catch (Exception ex) { Toasts.LogException(ex, "Auto-advance"); }
    }

    private async Task DismissOne(AlarmInfo alarm) => await Alarms.DismissAsync(alarm);
    private async Task SnoozeOne(AlarmInfo alarm) => await Alarms.SnoozeAsync(alarm);
    private async Task UnsnoozeOne(string targetKey) => await Alarms.UnsnoozeAsync(targetKey);

    // Advance the active route one leg and dismiss the APPROACH alarm
    // that prompted it. Both halves matter: if we don't dismiss, the
    // alarm sits on the stack until the boat physically leaves the
    // radius. Any failure toasts so a bad network blip is visible.
    //
    // End-of-route signal: some servers clear the active course on the
    // last leg's arrival, others hold the final waypoint and refuse
    // "nextPoint". We listen for either signal - SignalkClient fires
    // NavigationData.HasActiveCourse -> false on route clear - and
    // show an explicit "arrived at final WP" toast so the helm isn't
    // left wondering whether the tap worked.
    private async Task NextWaypoint(AlarmInfo alarm)
    {
        bool hadCourseBefore = SignalkClient.Data.HasActiveCourse;
        try
        {
            var r = await CourseApi.AdvanceActiveRouteAsync();
            if (!r.Success) { Toasts.Error($"Next waypoint failed: {r.Error ?? "server rejected"}"); return; }
            await Alarms.DismissAsync(alarm);

            // Brief settle window so the delta for the new leg (or the
            // course-cleared signal) reaches NavigationData, then check
            // whether we just consumed the last waypoint.
            await Task.Delay(400);
            if (hadCourseBefore && !SignalkClient.Data.HasActiveCourse)
                Toasts.Success("Arrived at final waypoint");
        }
        catch (Exception ex) { Toasts.LogException(ex, "Next waypoint"); }
    }

    // --- Hold-to-dismiss for Danger alarms ---
    // 600 ms matches the autopilot engage hold: long enough to defeat a
    // pocket brush, short enough that a deliberate press feels snappy.
    // The .alarm-holding class drives a fill animation during the wait;
    // both this value and the CSS animation duration must stay in sync.
    private const int AlarmHoldMs = 600;
    private string? HoldingAlarmKey;
    private CancellationTokenSource? _alarmHoldCts;

    private static string AlarmKeyOf(AlarmInfo a) => $"{a.Title}|{a.TargetKey}";

    // Empty handler just so the @oncontextmenu:preventDefault directive
    // has something to attach to. Blazor registers the preventDefault
    // only if the event has a listener, so without this the long-press
    // menu still pops. No business logic - the alarm banner should
    // react to tap / hold, not right-click.
    private void NoOpContextMenu(Microsoft.AspNetCore.Components.Web.MouseEventArgs _) { }

    private void StartAlarmHold(AlarmInfo a)
    {
        if (_alarmHoldCts is { } prev)
        {
            prev.Cancel();
            prev.Dispose();
        }
        _alarmHoldCts = new CancellationTokenSource();
        HoldingAlarmKey = AlarmKeyOf(a);
        // Explicit render so the .alarm-holding class is applied on THIS
        // frame. Blazor auto-renders after event handlers, but on some
        // touch devices the subsequent pointerup fires before the render
        // tick and the user sees no sweep animation.
        _ = InvokeAsync(StateHasChanged);
        _ = RunAlarmHoldAsync(a, _alarmHoldCts.Token);
    }

    private async Task RunAlarmHoldAsync(AlarmInfo a, CancellationToken ct)
    {
        try
        {
            await Task.Delay(AlarmHoldMs, ct);
            if (ct.IsCancellationRequested) return;
            HoldingAlarmKey = null;
            await Alarms.DismissAsync(a);
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) { /* released before the threshold */ }
    }

    private void EndAlarmHold()
    {
        if (_alarmHoldCts is { } cts)
        {
            cts.Cancel();
            cts.Dispose();
            _alarmHoldCts = null;
        }
        if (HoldingAlarmKey is not null)
        {
            HoldingAlarmKey = null;
            _ = InvokeAsync(StateHasChanged);
        }
    }

    // Keyboard parity for Danger-alarm dismissal. Space or Enter held
    // for the same duration as a mouse press-and-hold dismisses the
    // alarm; key-repeat is suppressed so the hold starts on the first
    // fire only. Keyup ends the hold (cancels if < 1 s).
    private void OnAlarmKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e, AlarmInfo a)
    {
        if (e.Repeat) return;
        if (e.Key == " " || e.Key == "Enter") StartAlarmHold(a);
    }

    private void OnAlarmKeyUp(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == " " || e.Key == "Enter") EndAlarmHold();
    }

    private async Task RunToastAction(Toast t)
    {
        Toasts.Dismiss(t.Id);
        if (t.Action is null) return;
        try { await t.Action(); }
        catch (Exception ex) { Toasts.LogException(ex, "Undo"); }
    }

    private async Task CheckStaleAsync()
    {
        bool isStale = SignalkClient.IsDataStale;
        if (isStale == wasStale) return;

        wasStale = isStale;
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException) { }
    }

    private async Task RefreshSnoozeCountdownAsync()
    {
        if (Alarms.SnoozedTargets.Count == 0) return;
        try { await InvokeAsync(StateHasChanged); }
        catch (ObjectDisposedException) { }
    }

    /// <summary>Probe the login-status endpoint and stash for the
    /// not-logged-in chip. Called once on init, on tab visibility
    /// changes, and on a dynamic timer cadence (2 s while the chip
    /// is up; 1 min otherwise - see <see cref="AuthPollIntervalWarningShown"/>).
    /// Failure / 404 (third-party SK server without
    /// /skServer/loginStatus) leaves the cached value null and the
    /// chip stays hidden - "we can't tell" is a more honest UX
    /// than a chip that lies.</summary>
    private async Task RefreshLoginStatusAsync()
    {
        // Skip if a previous probe is still running. Without this,
        // an 8 s network stall under the 2 s warning-shown cadence
        // would queue up to 4 concurrent probes against the same
        // endpoint - noise without signal.
        if (System.Threading.Interlocked.CompareExchange(
                ref _authProbeInFlight, 1, 0) != 0) return;
        try
        {
            var status = await AuthApi.GetLoginStatusAsync();
            // Only re-render when the warning state changed - avoids
            // a free StateHasChanged on every poll for the common
            // "still logged in" path. Toggle vs the current
            // _loginStatus's effective banner state.
            bool wasShowing = _loginStatus is { ShouldShowLoginWarning: true };
            bool nowShowing = status is { ShouldShowLoginWarning: true };
            _loginStatus = status;
            if (wasShowing != nowShowing)
            {
                await InvokeAsync(StateHasChanged);
            }
            // Re-tune the poll cadence to match the new state: fast
            // while the chip is up so the next sign-in is detected
            // promptly, slow otherwise. Safe to call on every probe
            // - Timer.Change is idempotent for a same-period reset.
            var nextInterval = nowShowing
                ? AuthPollIntervalWarningShown
                : AuthPollIntervalWarningHidden;
            try { authPollTimer?.Change(nextInterval, nextInterval); }
            catch (ObjectDisposedException) { }
        }
        catch (ObjectDisposedException) { }
        catch (Exception)
        {
            // Auth probe is best-effort; never let it crash the
            // page. Worst case is the chip stays at its previous
            // state until the next poll.
        }
        finally
        {
            System.Threading.Interlocked.Exchange(ref _authProbeInFlight, 0);
        }
    }

    private static string FormatRemaining(DateTime expiresAt)
    {
        var remaining = expiresAt - DateTime.UtcNow;
        if (remaining.TotalSeconds <= 0) return "0m";
        int minutes = (int)Math.Ceiling(remaining.TotalMinutes);
        return $"{minutes}m";
    }

    private static string FormatReason(DismissReason reason) => reason switch
    {
        DismissReason.UserDismissed => "dismissed",
        DismissReason.UserSnoozed => "snoozed",
        DismissReason.AutoCleared => "cleared",
        _ => reason.ToString(),
    };

    /// <summary>One coalesced row in the rendered alarm history. Holds
    /// the latest sample of a run of consecutive entries that share
    /// (Title, Reason, TargetKey) plus the run length so the UI can
    /// surface "x3" without losing the most-recent timestamp.</summary>
    private sealed record DismissedAlarmGroup(
        OnaPlotter.Models.DismissedAlarm Latest, int Count);

    /// <summary>Collapse runs of consecutive same-key dismissed
    /// alarms into a single row with a count chip. A noisy sensor
    /// (e.g. depth flapping on every tide tick) would otherwise push
    /// many identical entries to the top of the log and drown out
    /// other alarms; grouping keeps one row per run while preserving
    /// the run length. Only consecutive same-key entries collapse -
    /// a CPA alarm between two depth clears keeps both depth runs
    /// as distinct rows so the chronological context survives.</summary>
    private static IEnumerable<DismissedAlarmGroup> CoalesceDismissedHistory(
        IReadOnlyList<OnaPlotter.Models.DismissedAlarm> history)
    {
        if (history is null || history.Count == 0) yield break;
        var current = history[0];
        int count = 1;
        for (int i = 1; i < history.Count; i++)
        {
            var next = history[i];
            bool sameKey =
                string.Equals(next.Alarm.Title, current.Alarm.Title, StringComparison.Ordinal)
                && next.Reason == current.Reason
                && string.Equals(next.Alarm.TargetKey, current.Alarm.TargetKey, StringComparison.Ordinal);
            if (sameKey)
            {
                count++;
                continue;
            }
            yield return new DismissedAlarmGroup(current, count);
            current = next;
            count = 1;
        }
        yield return new DismissedAlarmGroup(current, count);
    }

    private async Task UpdateConnectionAlarmAsync()
    {
        if (audioModule is null) return;

        try
        {
            if (!SignalkClient.IsConnected)
            {
                if (!wasDisconnected)
                {
                    wasDisconnected = true;
                    await audioModule.InvokeVoidAsync("startAlarm", 3000);
                }
            }
            else
            {
                if (wasDisconnected)
                {
                    wasDisconnected = false;
                    await StopAlarmAsync();
                }
            }
        }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
    }

    private async Task StopAlarmAsync()
    {
        if (audioModule is null) return;
        try
        {
            await audioModule.InvokeVoidAsync("stopAlarm");
        }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
    }

    public async ValueTask DisposeAsync()
    {
        SignalkClient.OnConnectionChanged -= HandleConnectionChanged;
        SignalkClient.OnDataChanged -= HandleDataChanged;
        ServerNotifications.OnPathChanged -= HandleNotificationPathChanged;
        Toasts.OnChanged -= HandleToastsChanged;
        Settings.OnSettingsChanged -= HandleSettingsChanged;
        Alarms.OnAlarmChanged -= HandleAlarmChanged;
        Alarms.OnAlarmsChanged -= HandleAlarmsChanged;
        Updates.OnChanged -= HandleUpdatesChanged;
        Nav.LocationChanged -= HandleLocationChanged;
        if (staleCheckTimer is not null) await staleCheckTimer.DisposeAsync();
        if (snoozeCountdownTimer is not null) await snoozeCountdownTimer.DisposeAsync();
        if (firstRunOfflineTimer is not null) await firstRunOfflineTimer.DisposeAsync();
        if (authPollTimer is not null) await authPollTimer.DisposeAsync();
        if (audioModule is not null)
        {
            try
            {
                await audioModule.InvokeVoidAsync("stopAlarm");
                await audioModule.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
        }
        if (fsModule is not null)
        {
            try
            {
                await fsModule.InvokeVoidAsync("unsubscribe");
                await fsModule.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
        }
        if (leafletModule is not null)
        {
            try { await leafletModule.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        if (visibilityModule is not null)
        {
            // The document listener inside the module survives module
            // disposal (it's attached to `document`, not the module
            // object), but disposeAsync still releases the .NET-side
            // proxy so the GC can collect this layout. The _attached
            // guard inside visibility.js means a re-import on a
            // subsequent navigation is a no-op and we don't double-
            // fire OnTabVisible.
            try { await visibilityModule.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        if (themeModule is not null)
        {
            try { await themeModule.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        if (wakeLockModule is not null)
        {
            // Release the lock before dropping the module reference -
            // some browsers won't garbage-collect a held WakeLockSentinel
            // when the JS module reference goes away, leaving the screen
            // pinned awake until the tab is closed.
            try
            {
                await wakeLockModule.InvokeVoidAsync("setWakeLock", false);
                await wakeLockModule.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
        }
        fsSelfRef?.Dispose();
    }
}
