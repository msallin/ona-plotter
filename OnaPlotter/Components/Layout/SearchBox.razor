@* Topbar place-search: type a name, debounced query against the
   IPlaceSearchService, pick a result -> parent flies the map and
   drops a search-pin.

   Implementation note (helm reported "type-ahead unreliable, often
   no request fires even"):

   The input is INTENTIONALLY UNCONTROLLED on the Blazor side.
   No `value="@_query"`, no `@bind`. Blazor's renderer never writes
   the `value` attribute, so the helm's typing stays in the DOM
   exactly as typed - no controlled-input race, no clobbering of
   in-progress keystrokes by an in-handler StateHasChanged that
   pushes a stale `_query` back to the DOM.

   Trade-off: programmatic value updates (clear button, fill on
   pick) need a JS hop. That's what searchBoxJs.js provides.

   Stale-search guard: a monotonic request-id counter. Each
   keystroke bumps it; a returning search drops its result if a
   newer keystroke has bumped the counter in the meantime. *@

@using OnaPlotter.Services.Places
@using Microsoft.JSInterop
@inject IPlaceSearchService Search
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="topbar-search @(_open ? "topbar-search--open" : "")"
     @onfocusout="HandleFocusOut">
    <input @ref="_inputRef"
           type="search"
           class="topbar-search-input"
           placeholder="@Placeholder"
           @oninput="HandleInput"
           @onkeydown="OnKeyDown"
           @onfocusin="HandleFocusIn"
           autocomplete="off"
           spellcheck="false"
           aria-label="Search for a place" />
    @if (_loading)
    {
        <span class="topbar-search-spinner" role="status" aria-label="Searching"></span>
    }
    else if (_hasInput)
    {
        <button type="button" class="topbar-search-clear"
                @onclick="HandleClear"
                title="Clear search"
                aria-label="Clear search">&times;</button>
    }

    @if (_open)
    {
        <ul class="topbar-search-dropdown" role="listbox">
            @if (_results.Count == 0 && !_loading)
            {
                <li class="topbar-search-empty" role="status">
                    <div class="topbar-search-empty-title">No results</div>
                    <div class="topbar-search-empty-hint">Check your connection?</div>
                </li>
            }
            else
            {
                @for (int i = 0; i < _results.Count; i++)
                {
                    var idx = i;
                    var r = _results[idx];
                    bool isFirstOnlineAfterOwn =
                        idx > 0
                        && IsOwnSource(_results[idx - 1].Source)
                        && !IsOwnSource(r.Source);
                    if (isFirstOnlineAfterOwn)
                    {
                        <li class="topbar-search-separator" role="separator"
                            aria-hidden="true">Online</li>
                    }
                    var rowKey = $"{r.Source}-{r.Lat}-{r.Lon}-{idx}";
                    <li @key="rowKey"
                        role="option"
                        aria-selected="@(idx == _highlight)"
                        class="topbar-search-row topbar-search-row--@r.Source @(idx == _highlight ? "topbar-search-row--active" : "")"
                        @onmousedown:preventDefault
                        @onmousedown="() => HandlePick(r)"
                        @onmouseenter="() => _highlight = idx">
                        <div class="topbar-search-name">
                            @r.Name
                            @if (IsOwnSource(r.Source))
                            {
                                <span class="topbar-search-badge">@SourceBadge(r.Source)</span>
                            }
                        </div>
                        @if (!string.Equals(r.DisplayLabel, r.Name, StringComparison.Ordinal))
                        {
                            <div class="topbar-search-meta">@r.DisplayLabel</div>
                        }
                    </li>
                }
            }
        </ul>
    }
</div>

@code {
    /// <summary>Placeholder text shown when the input is empty.</summary>
    [Parameter] public string Placeholder { get; set; } = "Search places";

    /// <summary>Fired when the helm picks a result from the dropdown
    /// (mouse click or Enter on a highlighted row). Parent flies the
    /// map + drops a search-pin via the leaflet JS interop.</summary>
    [Parameter] public EventCallback<PlaceResult> OnPicked { get; set; }

    /// <summary>Fired when the helm clears the input (clear button
    /// or Escape on an empty query). Parent should tear down the
    /// search-pin on the JS side.</summary>
    [Parameter] public EventCallback OnCleared { get; set; }

    /// <summary>Optional debounce override (milliseconds). Default
    /// 200 ms balances "feels live" against "don't hammer the
    /// geocoder on every keystroke". Tests pass 0 for instant.</summary>
    [Parameter] public int DebounceMs { get; set; } = 200;

    /// <summary>Hard cap on the helm-typed query length. A pasted
    /// multi-KB string would URL-encode into an oversized GET that
    /// the upstream rejects with 414 anyway - truncating here keeps
    /// the cache key short and the dropdown fast on every keystroke.</summary>
    public const int MaxQueryLength = 200;

    private ElementReference _inputRef;
    private IJSObjectReference? _jsModule;

    private IReadOnlyList<PlaceResult> _results = [];
    private int _highlight = 0;
    private bool _loading = false;
    private bool _open = false;
    /// <summary>Tracked separately from the (uncontrolled) input
    /// value so the clear button only renders when there's actually
    /// something to clear. Updated on every keystroke from
    /// <c>e.Value</c>.</summary>
    private bool _hasInput = false;
    /// <summary>Monotonic counter incremented on every helm keystroke.
    /// A search Task captures this on entry; on completion it discards
    /// its result if a newer keystroke has bumped the counter (i.e.
    /// the helm has typed since this search was kicked off).</summary>
    private int _requestId;
    /// <summary>Set by HandlePick so the immediately-following blur
    /// doesn't close the dropdown after we've already navigated.</summary>
    private bool _suppressNextFocusOut;

    private async Task HandleInput(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? "";
        // Cap the helm-typed length defensively. A multi-KB paste
        // would URL-encode into an oversized GET; cap it before the
        // service ever sees it.
        var query = raw.Length > MaxQueryLength ? raw[..MaxQueryLength] : raw;
        _hasInput = !string.IsNullOrEmpty(query);

        // Bump the request id: any in-flight search becomes stale.
        var requestId = ++_requestId;

        if (string.IsNullOrWhiteSpace(query))
        {
            _results = [];
            _open = false;
            _loading = false;
            StateHasChanged();
            return;
        }

        // Debounce. If the helm types again within DebounceMs the
        // requestId check below catches it and we abandon.
        if (DebounceMs > 0)
        {
            await Task.Delay(DebounceMs);
            if (requestId != _requestId) return;
        }

        _loading = true;
        _open = true;
        // Render the spinner + open-dropdown state immediately. Without
        // an explicit StateHasChanged Blazor only renders when the
        // outer Task completes, which is AFTER SearchAsync returns -
        // so the helm never sees a spinner during the in-flight call.
        StateHasChanged();

        IReadOnlyList<PlaceResult> results;
        try
        {
            results = await Search.SearchAsync(query);
        }
        catch
        {
            // Belt + braces: the IPlaceSearchService contract is
            // "empty list on transient failure", so no implementation
            // SHOULD throw, but a regression in any decorator (own /
            // caching / fallback / photon / nominatim) would surface
            // as a dropdown that stops updating until the helm resets
            // the box. Catch everything, treat as empty.
            results = [];
        }

        // Stale check: if a newer keystroke has bumped the counter
        // while this search was in flight, the newer HandleInput
        // owns the next state update - bail without touching
        // _loading / _results so we don't fight it. The newer one
        // will set _loading=true (idempotent) and eventually commit
        // its own results.
        if (requestId != _requestId) return;

        _results = results;
        _highlight = 0;
        _loading = false;
        // Explicit render so the new results are committed to the
        // DOM at the EXACT moment we set the state. Belt-and-braces
        // against any future Blazor lifecycle change that defers
        // implicit post-handler renders.
        StateHasChanged();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (!_open || _results.Count == 0)
        {
            if (e.Key == "Escape" && _hasInput)
            {
                await HandleClear();
            }
            return;
        }

        switch (e.Key)
        {
            case "ArrowDown":
                _highlight = Math.Min(_highlight + 1, _results.Count - 1);
                break;
            case "ArrowUp":
                _highlight = Math.Max(_highlight - 1, 0);
                break;
            case "Enter":
                if (_highlight >= 0 && _highlight < _results.Count)
                {
                    await HandlePick(_results[_highlight]);
                }
                break;
            case "Escape":
                _open = false;
                break;
        }
    }

    private async Task HandlePick(PlaceResult result)
    {
        _suppressNextFocusOut = true;
        _open = false;
        _hasInput = true;
        _requestId++;  // stale any in-flight search
        // Push the picked name into the (uncontrolled) input via JS
        // so the helm sees the resolved place name. The dropdown is
        // closed and the map is about to fly; updating the input is
        // a UX cue confirming the pick.
        await SetInputValueAsync(result.Name);
        await OnPicked.InvokeAsync(result);
    }

    private void HandleFocusIn()
    {
        if (_results.Count > 0 && _hasInput)
        {
            _open = true;
        }
    }

    private void HandleFocusOut()
    {
        if (_suppressNextFocusOut)
        {
            _suppressNextFocusOut = false;
            return;
        }
        _open = false;
    }

    private async Task HandleClear()
    {
        _results = [];
        _open = false;
        _loading = false;
        _hasInput = false;
        _requestId++;
        await SetInputValueAsync("");
        if (OnCleared.HasDelegate) await OnCleared.InvokeAsync();
    }

    /// <summary>Lazy-load the JS module (cached on the field so each
    /// SetInputValueAsync call doesn't re-import). The catch is
    /// intentionally broad: bUnit's JS runtime, browser disconnects
    /// during navigation, missing module file - all share the same
    /// degrade path here (skip the programmatic input update; the
    /// helm just doesn't see the input visually clear or fill).
    /// Crucially, this MUST NOT propagate - the calling path is
    /// HandlePick / HandleClear, neither of which has anywhere
    /// useful to surface a JS-load failure.</summary>
    private async Task<IJSObjectReference?> GetJsModuleAsync()
    {
        if (_jsModule is not null) return _jsModule;
        try
        {
            _jsModule = await JS.InvokeAsync<IJSObjectReference>(
                "import", "./js/searchBoxJs.js");
            return _jsModule;
        }
        catch { return null; }
    }

    private async Task SetInputValueAsync(string value)
    {
        var mod = await GetJsModuleAsync();
        if (mod is null) return;
        try { await mod.InvokeVoidAsync("setValue", _inputRef, value); }
        catch { /* intentional swallow: see GetJsModuleAsync rationale */ }
    }

    public async ValueTask DisposeAsync()
    {
        if (_jsModule is null) return;
        try { await _jsModule.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }

    /// <summary>The own-data source tags. Used by the SearchBox to
    /// insert a "Online" separator between own-data and geocoded
    /// blocks.</summary>
    private static bool IsOwnSource(string source) =>
        source is "waypoint" or "note" or "region";

    /// <summary>Short label for the source-badge next to the row's
    /// Name. Distinguishes a saved waypoint from a same-named OSM
    /// hit at a glance.</summary>
    private static string SourceBadge(string source) => source switch
    {
        "waypoint" => "WPT",
        "note"     => "NOTE",
        "region"   => "RGN",
        _          => source.ToUpperInvariant(),
    };
}
