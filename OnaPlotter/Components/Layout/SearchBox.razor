@* Topbar place-search: type a name, debounced query against the
   IPlaceSearchService, pick a result -> parent flies the map and
   drops a search-pin.

   Implementation notes (helm reported "type-ahead unreliable, often
   no request fires even"):

   - Use @bind with @bind:event="oninput" + @bind:after instead of
     `value="@_query"` + manual @oninput. Blazor's @bind has anti-
     clobber logic that prevents the renderer from overwriting the
     helm's typed text mid-render -- the previous controlled-input
     pattern was racing keystrokes against the StateHasChanged()
     calls inside the handler, causing some keystrokes to never
     reach OnInput at all. With @bind, the input is the source of
     truth for the helm's typed value; we observe the change and
     debounce + search.

   - Track in-flight searches by a monotonic request ID instead of
     a chain of CancellationTokenSource. The previous design's
     cascading CTS cancellation was the right idea but invited
     OperationCanceledException leaks across the cache + geocoder
     decorators (each has its own CTS handling), some of which
     surfaced past the OnInput catch. The request-ID approach is
     dead-simple: when a search returns, drop the result if a newer
     search has been kicked off in the meantime.

   - No StateHasChanged() inside the handler. Blazor renders
     automatically after an async event handler completes; the
     extra render mid-handler is what raced the controlled-input
     pattern in the first place. We let Blazor handle the lifecycle.

   - Debounce trimmed from 300 ms to 200 ms. The helm's typing
     pattern reported requests "often not firing" -- if a
     character lands within 300 ms of the previous, the debounce
     resets. 200 ms is still well above keystroke jitter (~50 ms)
     but more forgiving for fast typing. *@

@using OnaPlotter.Services.Places
@inject IPlaceSearchService Search

<div class="topbar-search @(_open ? "topbar-search--open" : "")"
     @onfocusout="HandleFocusOut">
    <input type="search"
           class="topbar-search-input"
           placeholder="@Placeholder"
           @bind="_query"
           @bind:event="oninput"
           @bind:after="OnQueryChanged"
           @onkeydown="OnKeyDown"
           @onfocusin="HandleFocusIn"
           autocomplete="off"
           spellcheck="false"
           aria-label="Search for a place" />
    @if (_loading)
    {
        <span class="topbar-search-spinner" role="status" aria-label="Searching"></span>
    }
    else if (!string.IsNullOrEmpty(_query))
    {
        <button type="button" class="topbar-search-clear"
                @onclick="HandleClear"
                title="Clear search"
                aria-label="Clear search">&times;</button>
    }

    @if (_open)
    {
        <ul class="topbar-search-dropdown" role="listbox">
            @if (_results.Count == 0 && !_loading && !string.IsNullOrEmpty(_query))
            {
                @* Empty-state copy: "no results -- check connection?"
                   covers both real misses ("xyzqzy") and offline /
                   rate-limited failures (geocoder returned empty).
                   The component can't tell the two apart -- the
                   IPlaceSearchService contract is "empty list on any
                   transient failure" -- so the hint is a soft nudge
                   that lets the helm decide. *@
                <li class="topbar-search-empty" role="status">
                    <div class="topbar-search-empty-title">No results</div>
                    <div class="topbar-search-empty-hint">Check your connection?</div>
                </li>
            }
            else
            {
                @for (int i = 0; i < _results.Count; i++)
                {
                    var idx = i;
                    var r = _results[idx];
                    bool isFirstOnlineAfterOwn =
                        idx > 0
                        && IsOwnSource(_results[idx - 1].Source)
                        && !IsOwnSource(r.Source);
                    if (isFirstOnlineAfterOwn)
                    {
                        <li class="topbar-search-separator" role="separator"
                            aria-hidden="true">Online</li>
                    }
                    var rowKey = $"{r.Source}-{r.Lat}-{r.Lon}-{idx}";
                    <li @key="rowKey"
                        role="option"
                        aria-selected="@(idx == _highlight)"
                        class="topbar-search-row topbar-search-row--@r.Source @(idx == _highlight ? "topbar-search-row--active" : "")"
                        @onmousedown:preventDefault
                        @onmousedown="() => HandlePick(r)"
                        @onmouseenter="() => _highlight = idx">
                        <div class="topbar-search-name">
                            @r.Name
                            @if (IsOwnSource(r.Source))
                            {
                                <span class="topbar-search-badge">@SourceBadge(r.Source)</span>
                            }
                        </div>
                        @if (!string.Equals(r.DisplayLabel, r.Name, StringComparison.Ordinal))
                        {
                            <div class="topbar-search-meta">@r.DisplayLabel</div>
                        }
                    </li>
                }
            }
        </ul>
    }
</div>

@code {
    /// <summary>Placeholder text shown when the input is empty.</summary>
    [Parameter] public string Placeholder { get; set; } = "Search places";

    /// <summary>Fired when the helm picks a result from the dropdown
    /// (mouse click or Enter on a highlighted row). Parent flies the
    /// map + drops a search-pin via the leaflet JS interop.</summary>
    [Parameter] public EventCallback<PlaceResult> OnPicked { get; set; }

    /// <summary>Fired when the helm clears the input (clear button
    /// or Escape on an empty query). Parent should tear down the
    /// search-pin on the JS side so a stale ring doesn't linger on
    /// the chart after the dropdown is gone.</summary>
    [Parameter] public EventCallback OnCleared { get; set; }

    /// <summary>Optional debounce override (milliseconds). Default
    /// 200 ms balances "feels live" against "don't hammer the
    /// geocoder on every keystroke". Tests pass 0 for instant.</summary>
    [Parameter] public int DebounceMs { get; set; } = 200;

    /// <summary>Hard cap on the helm-typed query length. A pasted
    /// multi-KB string would URL-encode into an oversized GET that
    /// the upstream rejects with 414 anyway -- truncating here keeps
    /// the cache key short and the dropdown fast on every keystroke.</summary>
    public const int MaxQueryLength = 200;

    private string _query = "";
    private IReadOnlyList<PlaceResult> _results = [];
    private int _highlight = 0;
    private bool _loading = false;
    private bool _open = false;
    /// <summary>Monotonic counter incremented on every helm keystroke.
    /// A search Task captures this on entry; on completion it discards
    /// its result if a newer keystroke has bumped the counter (i.e.
    /// the helm has typed since this search was kicked off). Replaces
    /// the previous CancellationTokenSource chain which had subtle
    /// OperationCanceledException leaks across the cache + geocoder
    /// decorators.</summary>
    private int _requestId;
    /// <summary>Set by HandlePick so the immediately-following blur
    /// doesn't close the dropdown after we've already navigated.</summary>
    private bool _suppressNextFocusOut;

    private async Task OnQueryChanged()
    {
        // Bind ran first; _query already reflects the helm's input
        // (truncated below if the helm pasted something huge).
        if (_query.Length > MaxQueryLength)
        {
            _query = _query[..MaxQueryLength];
        }

        // Bump the request id so any in-flight search knows it's
        // stale by the time it returns.
        var requestId = ++_requestId;

        if (string.IsNullOrWhiteSpace(_query))
        {
            _results = [];
            _open = false;
            _loading = false;
            return;
        }

        // Debounce: only proceed if no newer keystroke has bumped the
        // counter during the wait. Catches both the normal cancel-on-
        // fresh-keystroke path and any stray timer cancellation.
        if (DebounceMs > 0)
        {
            try { await Task.Delay(DebounceMs); }
            catch (OperationCanceledException) { return; }
            if (requestId != _requestId) return;
        }

        _loading = true;
        _open = true;
        // Render the spinner / dropdown-open state. Safe: no
        // controlled-input clobber because @bind owns the input.

        IReadOnlyList<PlaceResult> results;
        try
        {
            results = await Search.SearchAsync(_query);
        }
        catch (OperationCanceledException)
        {
            // A decorator's internal cancellation surfaced -- treat
            // as empty (the contract says transient failures are
            // empty lists, so this is a defensive belt + braces).
            return;
        }

        // Stale check: a newer keystroke has bumped the counter
        // while this search was in flight; discard the result.
        if (requestId != _requestId) return;

        _results = results;
        _highlight = 0;
        _loading = false;
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (!_open || _results.Count == 0)
        {
            if (e.Key == "Escape" && !string.IsNullOrEmpty(_query))
            {
                await HandleClear();
            }
            return;
        }

        switch (e.Key)
        {
            case "ArrowDown":
                _highlight = Math.Min(_highlight + 1, _results.Count - 1);
                break;
            case "ArrowUp":
                _highlight = Math.Max(_highlight - 1, 0);
                break;
            case "Enter":
                if (_highlight >= 0 && _highlight < _results.Count)
                {
                    await HandlePick(_results[_highlight]);
                }
                break;
            case "Escape":
                _open = false;
                break;
        }
    }

    private async Task HandlePick(PlaceResult result)
    {
        _suppressNextFocusOut = true;
        _open = false;
        _query = result.Name;
        // Bump the id so any in-flight search for the partial query
        // doesn't overwrite the dropdown after we've already
        // navigated away.
        _requestId++;
        await OnPicked.InvokeAsync(result);
    }

    private void HandleFocusIn()
    {
        // Re-open the dropdown when refocusing the input WITH
        // existing results -- helm clicked away then back.
        if (_results.Count > 0 && !string.IsNullOrEmpty(_query))
        {
            _open = true;
        }
    }

    private void HandleFocusOut()
    {
        if (_suppressNextFocusOut)
        {
            _suppressNextFocusOut = false;
            return;
        }
        _open = false;
    }

    private async Task HandleClear()
    {
        _query = "";
        _results = [];
        _open = false;
        _loading = false;
        _requestId++;
        if (OnCleared.HasDelegate) await OnCleared.InvokeAsync();
    }

    /// <summary>The own-data source tags (set by OwnPlacesIndex on
    /// each PlaceResult). Used by the SearchBox to insert a "Online"
    /// separator between own-data and geocoded blocks.</summary>
    private static bool IsOwnSource(string source) =>
        source is "waypoint" or "note" or "region";

    /// <summary>Short label for the source-badge next to the row's
    /// Name. Distinguishes a saved waypoint from a same-named OSM
    /// hit at a glance.</summary>
    private static string SourceBadge(string source) => source switch
    {
        "waypoint" => "WPT",
        "note"     => "NOTE",
        "region"   => "RGN",
        _          => source.ToUpperInvariant(),
    };
}
