@using OnaPlotter.Services
@inject IConfirmationService Confirm
@implements IDisposable

@* Global confirmation modal. Hosted once from MainLayout so every
   call site (Map.razor, Settings, Resources, RoutesSection, ...) that
   does `await Confirmations.ConfirmAsync(...)` / `PromptAsync(...)` /
   `ChooseAsync(...)` is shown through this one dialog. Gated on
   Confirm.IsPending so the DOM footprint is zero when idle.

   Three modes:
     - ConfirmAsync: yes/no question; no input shown.
     - PromptAsync:  message + text input (editable, pre-filled with
                     the caller's initial value). Enter commits, Esc
                     cancels.
     - ChooseAsync:  message + one button per option + Cancel. Esc
                     cancels. No primary palette since none of the N
                     options is the default; helm picks deliberately.
   Enter-to-submit on the input lets the helm rename things without
   reaching for the OK button, same muscle memory as window.prompt. *@

@if (Confirm.IsPending)
{
    <div class="confirm-backdrop" @onclick="OnCancel"></div>
    <div class="confirm-dialog"
         role="alertdialog"
         aria-modal="true"
         aria-labelledby="confirm-msg"
         @onkeydown="OnKeyDown"
         tabindex="-1">
        <div class="confirm-msg" id="confirm-msg">@Confirm.Message</div>
        @if (Confirm.IsTextPrompt)
        {
            @* autofocus on the input (not on Cancel) so the user can
               start typing immediately -- matches window.prompt. *@
            <input type="text"
                   class="confirm-input"
                   @ref="_inputRef"
                   value="@Confirm.TextValue"
                   @oninput="OnInput"
                   @onkeydown="OnKeyDown"
                   autocomplete="off"
                   spellcheck="false"
                   aria-label="Prompt value" />
        }
        <div class="confirm-actions">
            <button type="button"
                    class="btn confirm-btn confirm-btn-cancel"
                    @onclick="OnCancel"
                    autofocus="@(!Confirm.IsTextPrompt && !Confirm.IsChoice)">
                @(string.IsNullOrEmpty(Confirm.CancelLabel) ? "Cancel" : Confirm.CancelLabel)
            </button>
            @if (Confirm.IsChoice)
            {
                @* One button per option. No primary palette: each
                   option is an equally valid pick, so making the
                   first one "primary" would steer the helm toward
                   whichever order the caller listed. Outline-style
                   keeps them visually equal. *@
                @foreach (var opt in Confirm.Options)
                {
                    <button type="button"
                            class="btn confirm-btn confirm-btn-primary"
                            @onclick="() => OnPick(opt)">
                        @opt
                    </button>
                }
            }
            else
            {
                <button type="button"
                        class="btn confirm-btn @(Confirm.Destructive ? "confirm-btn-danger" : "confirm-btn-primary")"
                        @onclick="OnOk">
                    @(!string.IsNullOrEmpty(Confirm.ConfirmLabel)
                        ? Confirm.ConfirmLabel
                        : Confirm.Destructive ? "Confirm" : "OK")
                </button>
            }
        </div>
    </div>
}

@code {
    // Input element ref so we can .FocusAsync() it after the dialog
    // renders. Blazor's `autofocus` attribute isn't reliable inside
    // a conditionally-rendered modal -- the attribute only has an
    // effect at document load, not on subsequent DOM insertions.
    private ElementReference _inputRef;
    private bool _needsFocus;

    protected override void OnInitialized() => Confirm.OnChanged += OnStateChanged;
    public void Dispose() => Confirm.OnChanged -= OnStateChanged;

    private void OnStateChanged()
    {
        // Schedule a focus pass for the next render cycle iff a text
        // prompt just opened. StateHasChanged is invoked after; the
        // actual focus happens in OnAfterRenderAsync.
        if (Confirm.IsPending && Confirm.IsTextPrompt) _needsFocus = true;
        InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_needsFocus && Confirm.IsPending && Confirm.IsTextPrompt)
        {
            _needsFocus = false;
            try { await _inputRef.FocusAsync(); }
            catch { /* pre-rendered or unmounted; harmless */ }
        }
    }

    private void OnInput(ChangeEventArgs e)
    {
        // Two-way binding via service state so the dialog component
        // stays stateless. Resolve(true) reads this on OK.
        Confirm.TextValue = e.Value?.ToString() ?? "";
    }

    private void OnOk() => Confirm.Resolve(true);
    private void OnCancel() => Confirm.Resolve(false);
    private void OnPick(string option) => Confirm.Pick(option);

    private void OnKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        // Esc cancels in every mode. Enter commits OK on confirm /
        // prompt; for chooser there's no "default" option to commit
        // (that's why the chooser exists), so Enter is a no-op there
        // -- the helm clicks / taps the button they want.
        if (e.Key == "Escape") OnCancel();
        else if (e.Key == "Enter" && !Confirm.IsChoice) OnOk();
    }
}
