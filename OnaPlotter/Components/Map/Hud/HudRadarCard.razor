@using OnaPlotter.Models

@* Radar control HUD card. Glanceable status + range stepper + power
   toggle for the helm; mirrors the autopilot card's hold-to-engage
   safety pattern (Transmit needs a 600 ms press to avoid radiating
   on an accidental tap). When more than one radar is detected a
   small picker swaps the controlled device.

   Hidden when no radars are present (no SignalK radar plugin) so a
   user who flipped the setting on without a real backend doesn't see
   a permanently-empty card. The Layers panel's RadarsSection uses
   the same callbacks (OnSetPower / OnSetRange) so both surfaces
   stay in lock-step. *@

@if (Radars.Count == 0) return;

@{
    // Resolve the displayed radar from the current selection. Re-runs
    // on every render so a server poll that drops the previously-
    // selected unit silently rolls forward to whatever's left instead
    // of leaving the card pointing at a stale id.
    var radar = ResolveSelected();
}

<div class="hud-panel hud-card radar-hud-panel @(IsTransmitting(radar) ? "ap-engaged" : "")">
    <div class="hud-card-title">
        <span class="hud-card-name">Radar</span>
        @if (radar.Status is string s)
        {
            <span class="radar-status-chip radar-status-@StatusClassSuffix(s)" title="@s">
                @s.ToUpperInvariant()
            </span>
        }
    </div>

    @if (Radars.Count > 1)
    {
        @* Picker only renders with multiple radars. A boat with one
           HALO + one Garmin xHD is the realistic case; a single
           radar shows just the name on the row above so the picker
           dropdown doesn't waste a row. *@
        <select class="map-btn radar-hud-picker"
                value="@radar.Id"
                @onchange="OnRadarPicked"
                aria-label="Active radar">
            @foreach (var r in Radars)
            {
                <option value="@r.Id">@DisplayName(r)</option>
            }
        </select>
    }
    else
    {
        <div class="radar-hud-name" title="@($"{radar.Brand} {radar.Model}".Trim())">
            @DisplayName(radar)
        </div>
    }

    @{
        var rangeOptions = GetRangeOptions(radar);
        int currentIdx = rangeOptions.FindIndex(v => v == (radar.Range ?? -1));
    }
    @* Disabled rules: "-" at the first valid value, "+" at the last.
       An off-list current range can't actually arise here because
       GetRangeOptions splices the radar's Range into the options
       array if it isn't already in validValues -- so currentIdx is
       always in [0, options.Count). The "currentIdx < 0" guard on
       "+" stays for defensive belt-and-braces but is unreachable. *@
    <div class="radar-hud-range-row">
        <button class="ap-btn radar-hud-range-step"
                disabled="@(currentIdx <= 0)"
                @onclick="() => StepRange(radar, rangeOptions, -1)"
                title="Range down">-</button>
        <div class="radar-hud-range-value" title="Range">
            @(radar.Range is int rm ? FormatRangeFor(radar, rm) : "--")
        </div>
        <button class="ap-btn radar-hud-range-step"
                disabled="@(currentIdx < 0 || currentIdx >= rangeOptions.Count - 1)"
                @onclick="() => StepRange(radar, rangeOptions, +1)"
                title="Range up">+</button>
    </div>

    @* Power toggle. One button per radar, label flips with state:
        * Transmitting -> "Standby" (instant tap)
        * Standby / off -> "Transmit" (also instant tap; helm asked
          for the hold-to-engage gate to come off because the radar
          power request goes through the SK plugin which has its
          own warmup state, so a stray tap doesn't put the array
          on the air immediately) *@
    <div class="ap-modes radar-hud-power">
        @if (IsTransmitting(radar))
        {
            <button class="ap-mode-btn radar-hud-power-btn active"
                    @onclick="() => OnSetPower.InvokeAsync((radar.Id, RadarPower.Standby))"
                    title="Standby">Standby</button>
        }
        else
        {
            <button class="ap-mode-btn radar-hud-power-btn"
                    @onclick="() => OnSetPower.InvokeAsync((radar.Id, RadarPower.Transmit))"
                    title="Transmit">Transmit</button>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<RadarInfo> Radars { get; set; } = [];

    [Parameter] public IReadOnlyDictionary<string, RadarCapabilities?> Capabilities { get; set; } =
        new Dictionary<string, RadarCapabilities?>();

    /// <summary>Fires when the helm taps Standby or Transmit. Map.razor
    /// handles by calling <c>RadarApi.SetControlAsync(radarId, "power", ...)</c>.
    /// Both buttons are now plain clicks -- the SK radar plugin owns
    /// the warmup state machine, so the previous 600 ms hold-to-engage
    /// gate on Transmit was redundant safety theatre.</summary>
    [Parameter] public EventCallback<(string radarId, RadarPower power)> OnSetPower { get; set; }

    /// <summary>Fires when the user steps range up or down. Map.razor
    /// handles by calling <c>RadarApi.SetControlAsync(radarId,
    /// "range", ControlValue.ForRange(metres))</c>.</summary>
    [Parameter] public EventCallback<(string radarId, int rangeMeters)> OnSetRange { get; set; }

    private string? _selectedRadarId;

    /// <summary>Picks the radar the card displays. Honours an explicit
    /// user selection when still valid; otherwise prefers the
    /// transmitting radar (the one with live data on the chart) and
    /// falls back to the first radar so a freshly-loaded card always
    /// has something useful to show even before the user picks.</summary>
    private RadarInfo ResolveSelected()
    {
        if (_selectedRadarId is string id)
        {
            var match = Radars.FirstOrDefault(r => r.Id == id);
            if (match is not null) return match;
        }
        return Radars.FirstOrDefault(r =>
                string.Equals(r.Status, "transmit", StringComparison.OrdinalIgnoreCase))
            ?? Radars[0];
    }

    private void OnRadarPicked(ChangeEventArgs e)
    {
        _selectedRadarId = e.Value?.ToString();
    }

    private async Task StepRange(RadarInfo radar, List<int> options, int direction)
    {
        if (options.Count == 0) return;
        // GetRangeOptions splices radar.Range into the list if it isn't
        // already in validValues, so an off-list current range is
        // impossible by construction -- FindIndex always returns >= 0
        // here. The "next < 0 || >= Count" guard below catches the
        // edge case where StepRange is called from the last (or first)
        // valid value with the matching button still enabled (race on
        // a re-render mid-tap), which is the only realistic way to
        // exit the valid range without first hitting a disabled button.
        int idx = options.FindIndex(v => v == (radar.Range ?? -1));
        if (idx < 0) return;                              // defensive: shouldn't happen
        int next = idx + direction;
        if (next < 0 || next >= options.Count) return;
        await OnSetRange.InvokeAsync((radar.Id, options[next]));
    }

    private static bool IsTransmitting(RadarInfo r) =>
        string.Equals(r.Status, "transmit", StringComparison.OrdinalIgnoreCase);

    private static string DisplayName(RadarInfo r) =>
        !string.IsNullOrWhiteSpace(r.Name) ? r.Name!
        : !string.IsNullOrWhiteSpace(r.Model) ? r.Model!
        : r.Id;

    // Whitelisted CSS class suffix for the status chip. Mirrors the
    // logic in RadarsSection so both surfaces use the same palette
    // and an unrecognised server string can't smuggle extra class
    // tokens in via the chip.
    private static string StatusClassSuffix(string status) =>
        status?.Trim().ToLowerInvariant() switch
        {
            "transmit" => "transmit",
            "standby" => "standby",
            "off" => "off",
            "preparing" => "preparing",
            _ => "unknown",
        };

    /// <summary>Range options for the stepper. Same pecking order as
    /// RadarsSection.GetRangeOptions: range control's validValues
    /// first (the actual PUT whitelist), supportedRanges next
    /// (looser superset), DefaultRangeLadder only while capabilities
    /// are still in flight. Always splices the radar's current range
    /// in if absent so the value stays selectable across step taps.</summary>
    private List<int> GetRangeOptions(RadarInfo r)
    {
        IReadOnlyList<int> ranges = DefaultRangeLadder;
        if (Capabilities.TryGetValue(r.Id, out var caps) && caps is not null)
        {
            if (caps.Controls.TryGetValue("range", out var rangeCtl)
                && rangeCtl.ValidValues is { Length: > 0 } valid)
            {
                ranges = valid;
            }
            else if (caps.SupportedRanges is { Length: > 0 } supported)
            {
                ranges = supported;
            }
        }
        var sorted = ranges.OrderBy(v => v).ToList();
        if (r.Range is int current && !sorted.Contains(current))
        {
            sorted.Add(current);
            sorted.Sort();
        }
        return sorted;
    }

    private string FormatRangeFor(RadarInfo r, int meters)
    {
        if (Capabilities.TryGetValue(r.Id, out var caps)
            && caps?.Controls.TryGetValue("range", out var rangeCtl) == true
            && rangeCtl.Descriptions is { } desc
            && desc.TryGetValue(
                meters.ToString(System.Globalization.CultureInfo.InvariantCulture),
                out var label)
            && !string.IsNullOrWhiteSpace(label))
        {
            return label;
        }
        return FormatRange(meters);
    }

    private static string FormatRange(int m) =>
        m < 1000 ? $"{m} m" : $"{(m / 1852.0):F1} nm";

    // Generic spread of metric ranges in metres. Used only as a
    // placeholder while /capabilities is in flight; once caps arrive
    // GetRangeOptions switches to the radar's own validValues.
    private static readonly int[] DefaultRangeLadder =
    [
        50, 100, 250, 500, 1000, 1500, 2000, 3000, 4000, 6000,
        8000, 12000, 16000, 24000, 36000, 48000, 74080,
    ];
}
