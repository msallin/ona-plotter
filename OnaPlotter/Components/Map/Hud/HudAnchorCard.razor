@using OnaPlotter.Utilities

@* Anchor-watch HUD card. Same extraction pattern as HudRouteCard:
   takes a record-struct snapshot so Blazor skips re-renders when the
   snapshot is equal to the previous render. The anchor data ticks at
   ~10 s cadence (SlowSelfPaths tier) so this card re-renders far less
   often than the primary HUD corners, which is exactly the point of
   splitting it out. *@

@if (Snapshot.Visible)
{
    @* Tap-to-adjust: when a server-driven anchor is armed (Manual=
       false) and the parent has wired OnAdjust, the whole card
       becomes a click target that re-opens the SetRadius panel.
       Manual flow keeps its existing inline chip row -- no point
       in routing through the parent panel for the JS-only anchor.
       The cursor + hover styles depend on canAdjust so the card
       reads as static when not tappable. *@
    var canAdjust = !Snapshot.Manual && OnAdjust.HasDelegate;
    <div class="hud-panel hud-card anchor-panel @(Snapshot.Dragging ? "anchor-alarm" : "") @(canAdjust ? "anchor-panel-tappable" : "")"
         @onclick="@(canAdjust ? OnAdjust : default)"
         role="@(canAdjust ? "button" : null)"
         title="@(canAdjust ? "Tap to adjust the alarm radius" : null)">
            <div class="hud-card-title">
                <span class="hud-card-name">Anchor Watch</span>
                @* Small compass needle pointing back at the anchor, north-up.
                   Only shown when the plugin publishes navigation.anchor.bearingTrue
                   (server-side anchor; the JS-only manual flow has no
                   bearing source). The helm uses it to sight the anchor
                   when it's out of sight at night ("which way is it from
                   here?"). Sits inline with the title so it doesn't add
                   another row when bearing data is absent. *@
                @if (NormaliseBearingDeg(Snapshot.BearingTrue) is int deg)
                {
                    @* SVG transform rotation is clockwise from up,
                       which matches a true-north bearing reading. *@
                    <span class="anchor-bearing" title="@($"Bearing back to anchor: {deg}° true")">
                        <svg width="20" height="20" viewBox="-12 -12 24 24" aria-hidden="true">
                            <circle cx="0" cy="0" r="10" fill="none"
                                    class="hud-dial-rim" stroke-width="1"/>
                            <g style="transform: rotate(@(deg)deg);">
                                <polygon points="0,-9 3,1 0,-2 -3,1" fill="#f59e0b"/>
                            </g>
                        </svg>
                        <span class="anchor-bearing-value">@deg<span class="hud-unit">°</span></span>
                    </span>
                }
                @if (Snapshot.Dragging)
                {
                    <span class="hud-card-progress hud-card-progress-alarm">Dragging</span>
                }
            </div>
            @if (Snapshot.DormantReason is not null)
            {
                <div class="rule-dormant-hint" role="status" aria-live="polite"
                     title="Configure in Settings to enable the tide-aware grounding alarm">
                    &#9888; @Snapshot.DormantReason
                </div>
            }
            <div class="anchor-info-row">
                @if (Snapshot.CurrentRadius is not null)
                {
                    var distClass = Snapshot.Dragging ? "depth-danger" : "depth-ok";
                    <div>
                        <div class="hud-label">Dist</div>
                        <div class="hud-value route-value @distClass">@Format.MetersDual(Snapshot.CurrentRadius)</div>
                    </div>
                }
                @if (Snapshot.PeakRadius is not null)
                {
                    @* Peak observed distance during this anchor watch.
                       Helm uses it to answer "how close did we get to
                       the alarm threshold?" without remembering the
                       highest live value they happened to glance at.
                       Only shown when the plugin pushes currentRadius
                       (manual anchors don't track peak). *@
                    <div>
                        <div class="hud-label">Peak</div>
                        <div class="hud-value route-value">@Format.MetersDual(Snapshot.PeakRadius)</div>
                    </div>
                }
                @if (Snapshot.MaxRadius is not null)
                {
                    <div>
                        <div class="hud-label">Radius</div>
                        <div class="hud-value route-value">@Format.MetersDual(Snapshot.MaxRadius)</div>
                    </div>
                }
                @if (Snapshot.Manual)
                {
                    <div>
                        <div class="hud-label">Radius</div>
                        <div class="hud-value route-value">@Snapshot.ManualRadiusMeters.ToString("F0")<span class="hud-unit">m</span></div>
                    </div>
                }
            </div>
            @if (Snapshot.Manual && OnSetRadius.HasDelegate)
            {
                <div class="anchor-radius-chips">
                    @foreach (var r in AnchorRadiusPresets)
                    {
                        <button class="map-btn @(Math.Abs(Snapshot.ManualRadiusMeters - r) < 0.5 ? "active" : "")"
                                @onclick="() => OnSetRadius.InvokeAsync(r)"
                                type="button">@r.ToString("F0")m</button>
                    }
                </div>
            }
        </div>
}

@code {
    [Parameter, EditorRequired] public AnchorHudSnapshot Snapshot { get; set; }
    [Parameter] public EventCallback<double> OnSetRadius { get; set; }

    /// <summary>Tap on the (server-armed) card opens the SetRadius
    /// panel for adjustment. The Anchor button on the bottom bar
    /// remains the dedicated raise gesture; this is the dedicated
    /// adjust gesture so the two operations don't share a button.
    /// Null / not-wired = card is non-interactive (manual flow,
    /// or older parents that haven't wired this up).</summary>
    [Parameter] public EventCallback OnAdjust { get; set; }

    private static readonly double[] AnchorRadiusPresets = [20, 30, 50, 75, 100, 150];

    /// <summary>Normalise a bearing in radians to whole degrees on
    /// [0, 360). Returns null when the input is null, NaN, or
    /// infinite -- a malformed delta would otherwise produce a
    /// non-finite degree value that the previous while-loop
    /// implementation looped on for millions of iterations per
    /// render. Single modulo idiom is bounded constant-time.</summary>
    private static int? NormaliseBearingDeg(double? bearingRad)
    {
        if (bearingRad is not double rad) return null;
        if (double.IsNaN(rad) || double.IsInfinity(rad)) return null;
        // Convert to degrees as a double first so the modulo math
        // happens before the int cast; with a valid (or even very
        // large) finite radian input the modulo always lands in
        // (-360, 360), which the int cast can represent exactly.
        double deg = rad * 180.0 / Math.PI;
        deg = ((deg % 360.0) + 360.0) % 360.0;
        return (int)Math.Round(deg) % 360;
    }

    /// <summary>
    /// Immutable snapshot of every field the anchor card reads. See
    /// HudRouteCard for the rendering-skip rationale.
    /// </summary>
    public readonly record struct AnchorHudSnapshot(
        bool Visible,
        bool Dragging,
        bool Manual,
        double ManualRadiusMeters,
        double? CurrentRadius,
        double? MaxRadius,
        string? DormantReason,
        double? PeakRadius = null,
        // True-north bearing back to the anchor (radians, 0..2pi).
        // Computed client-side via Utilities.GeoBearing in the parent
        // (MapHud.BuildAnchorSnapshot) from anchor + own-ship lat/lon
        // so it works on both the plugin and the JS-only manual flow.
        // Null when either endpoint is missing (no GPS, no anchor)
        // -- the card uses that as the hide signal.
        double? BearingTrue = null);
}
