@using OnaPlotter.Utilities
@using OnaPlotter.Models

@* Active-route HUD card. Extracted from MapHud so the heaviest subtree
   (~90 lines of conditional rows, 8+ formatted values) only re-renders
   when a route-related value actually changes -- not when the parent
   HUD re-renders because an unrelated field (wind, depth) ticked.

   Component takes a RouteHudSnapshot record struct. Blazor's parameter-
   change detection does member-wise equality on the record; if every
   field matches the previous render, the parameter setter treats it as
   "no change" and skips re-render. Same optimisation pattern applies
   to HudAnchorCard. *@

@* Previous layout was a 2-col grid (3-4 rows tall) plus a big Stop
   Navigation button at the bottom, which ate a surprising amount of
   vertical real estate on the landscape screens that are actually
   used at sea. Now:
     - Title row keeps route name + WP-progress chip.
     - Six metrics (DTW / BRG / VMG / TTG / ETA / XTE) live in a
       single horizontal flex row; flex-wrap handles narrow portrait
       iPads by breaking onto two rows before overflowing.
     - Stop Navigation moved to MapControls, next to Anchor (same
       safety-toggle grouping; route + anchor are already mutually
       exclusive). Removing the button from here saves a full row. *@
@if (Snapshot.Visible)
{
    @* `route-stopping` class drives a dim+pulse style during the
       window between the user tapping Stop Navigation and the SK
       delta confirming course-clear. Without this the helm sees the
       polyline dim on the chart but the HUD card stays bright with
       distance + ETA + waypoint count, and reads it as "Stop didn't
       work" -- could double-tap or mistake it for a navigational
       state mismatch. The dim resolves naturally when the delta
       lands and the whole card unmounts (Snapshot.Visible flips
       false). *@
    <div class="hud-panel hud-card route-panel @(Snapshot.Stopping ? "route-stopping" : "")">
            <div class="hud-card-title">
                @* Route name in the title row only in Big HUD. The
                   small HUD layout drops it so the metrics row gets
                   the horizontal real estate; the helm always knows
                   which route they activated, so the name is
                   redundant chrome at landscape-iPad scale. *@
                @if (BigHud)
                {
                    <span class="hud-card-name">@(Snapshot.Name ?? "Active Route")</span>
                }
                @if (Snapshot.PointIndex is int idx && Snapshot.PointTotal is int total)
                {
                    @* Prev / Next waypoint controls. Disabled at the
                       endpoints so a tap doesn't fire a no-op PUT.
                       Sit next to the WP-progress chip so they read
                       as "I'm at WP 3 of 7; tap > to go to 4". The
                       server owns pointIndex; OnPrevWaypoint /
                       OnNextWaypoint thread up to Map.razor which
                       calls CourseApi.SetPointIndexAsync /
                       AdvanceActiveRouteAsync. *@
                    <button class="route-wp-step-btn"
                            disabled="@(idx <= 0)"
                            title="Previous waypoint" aria-label="Previous waypoint"
                            @onclick="OnPrevWaypoint" @onclick:stopPropagation>
                        &lsaquo;
                    </button>
                    <span class="hud-card-progress">WP @(idx + 1) of @total</span>
                    <button class="route-wp-step-btn"
                            disabled="@(idx + 1 >= total)"
                            title="Next waypoint" aria-label="Next waypoint"
                            @onclick="OnNextWaypoint" @onclick:stopPropagation>
                        &rsaquo;
                    </button>
                }
            </div>
            @if (Snapshot.ArrivalRadiusMeters <= 0)
            {
                <div class="rule-dormant-hint" role="status" aria-live="polite"
                     title="Set a waypoint-arrival radius in Settings to enable the APPROACH alarm">
                    &#9888; APPROACH alarm off (radius 0 m)
                </div>
            }
            <div class="route-info-row">
                <div class="route-info-item">
                    <div class="hud-label">DTW</div>
                    <div class="hud-value route-value">@Format.Nm(Snapshot.Distance)<span class="hud-unit">nm</span></div>
                </div>
                <div class="route-info-item">
                    <div class="hud-label">BRG</div>
                    <div class="hud-value route-value">@Format.Degrees(Snapshot.Bearing)<span class="hud-unit">&deg;</span></div>
                </div>
                @if (Snapshot.Vmg is not null)
                {
                    <div class="route-info-item">
                        <div class="hud-label">VMG</div>
                        <div class="hud-value route-value">@Format.Speed(Snapshot.Vmg)<span class="hud-unit">kn</span></div>
                    </div>
                }
                @if (Snapshot.TimeToGo is not null)
                {
                    <div class="route-info-item">
                        <div class="hud-label">TTG</div>
                        <div class="hud-value route-value">@Format.TimeToGo(Snapshot.TimeToGo)</div>
                    </div>
                    <div class="route-info-item">
                        <div class="hud-label">ETA</div>
                        <div class="hud-value route-value">@Format.Eta(Snapshot.TimeToGo)</div>
                    </div>
                }
                @* XTE numeric field: only in Big HUD mode. The XTE
                   information competes with DTW / BRG / VMG for space
                   in the small landscape layout, and the helm reading
                   the smaller HUD typically wants the macro fields
                   (distance / bearing / TTG). Big HUD mode adds the
                   field back for cockpit-glance situational awareness. *@
                @if (Snapshot.Xte is not null && BigHud)
                {
                    <div class="route-info-item">
                        <div class="hud-label">XTE</div>
                        <div class="hud-value route-value @Format.XteClass(Snapshot.Xte)">@Format.Xte(Snapshot.Xte)</div>
                    </div>
                }
            </div>
            @* XTE deviation bar -- ILS-localiser-style read of the same
               cross-track-error number above. Centerline = on track.
               Marker position is clamped to +/-100 m so a one-shot
               GPS hiccup pinning out doesn't make the marker disappear
               off-screen. The number stays as confirmation. *@
            @if (Snapshot.Xte is double xteM)
            {
                double clamped = Math.Clamp(xteM, -100, 100);
                double pct = 50 + (clamped / 100) * 50;
                string posClass = Math.Abs(xteM) >= 50 ? "is-alarm"
                                : Math.Abs(xteM) >= 25 ? "is-warn" : "";
                string pctStr = pct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture);
                string side = xteM < 0 ? "left" : "right";
                string label = $"Off track {Math.Abs(xteM):F0} m {side}";
                <div class="xte-bar @posClass" title="@($"Cross-track error: {xteM:F1} m")"
                     role="img" aria-label="@label">
                    <div class="xte-bar-track"></div>
                    <div class="xte-bar-center"></div>
                    <div class="xte-bar-marker" style="left: @(pctStr)%"></div>
                </div>
            }
            @if (Snapshot.RouteDistanceRemaining is not null || Snapshot.RouteTimeToGo is not null)
            {
                <div class="route-total-row">
                    <span class="route-total-label">Route total</span>
                    @{
                        // "passed / total" reads as progress at a glance; the
                        // helm cares about "how far have I come" + "how far
                        // still to go". passed = total - remaining (clamped
                        // >= 0 against rounding noise near the destination).
                        bool hasTotal = Snapshot.RouteDistanceRemaining is not null
                            && Snapshot.RouteDistanceTotal is double t && t > 0;
                        double totalM = Snapshot.RouteDistanceTotal ?? 0;
                        double passedM = hasTotal
                            ? Math.Max(0, totalM - (Snapshot.RouteDistanceRemaining ?? 0))
                            : 0;
                    }
                    @if (hasTotal)
                    {
                        <span class="route-total-value">
                            @Format.Nm(passedM) / @Format.Nm(totalM)<span class="hud-unit">nm</span>
                        </span>
                    }
                    else if (Snapshot.RouteDistanceRemaining is not null)
                    {
                        <span class="route-total-value">@Format.Nm(Snapshot.RouteDistanceRemaining)<span class="hud-unit">nm</span></span>
                    }
                    @if (Snapshot.RouteTimeToGo is not null)
                    {
                        <span class="route-total-value">@Format.TimeToGo(Snapshot.RouteTimeToGo)</span>
                        <span class="route-total-value">ETA @Format.Eta(Snapshot.RouteTimeToGo)</span>
                    }
                </div>
            }
        </div>
}

@code {
    [Parameter, EditorRequired] public RouteHudSnapshot Snapshot { get; set; }

    /// <summary>Fires when the helm taps the &lt; button next to the
    /// WP-progress chip. Map.razor handles by computing
    /// `Snapshot.PointIndex - 1` and calling
    /// CourseApi.SetPointIndexAsync.</summary>
    [Parameter] public EventCallback OnPrevWaypoint { get; set; }

    /// <summary>Fires when the helm taps the &gt; button. Map.razor
    /// handles by calling CourseApi.AdvanceActiveRouteAsync (server
    /// increments its own pointIndex).</summary>
    [Parameter] public EventCallback OnNextWaypoint { get; set; }

    /// <summary>True when the helm has Big HUD mode enabled (Settings
    /// page -- "Big type"). Drives the small-vs-big-HUD layout
    /// trimming on the route card: the small layout drops fields the
    /// helm doesn't need at a glance (XTE numeric, route name in the
    /// title row) so the chart underneath isn't swallowed by the
    /// HUD on landscape iPad. Big HUD adds the trimmed fields back
    /// for cockpit-glance situational awareness.</summary>
    [Parameter] public bool BigHud { get; set; }

    /// <summary>
    /// Immutable snapshot of every field the route card reads. Record-
    /// struct semantics give member-wise equality for free, so Blazor's
    /// parameter-change detection treats two equal snapshots as "no
    /// change" and skips re-render -- the point of the split.
    /// </summary>
    public readonly record struct RouteHudSnapshot(
        bool Visible,
        string? Name,
        int? PointIndex,
        int? PointTotal,
        double ArrivalRadiusMeters,
        double? Distance,
        double? Bearing,
        double? Vmg,
        double? TimeToGo,
        double? Xte,
        double? RouteDistanceRemaining,
        double? RouteTimeToGo,
        // Visual-state flag: true while a Stop Navigation tap is
        // pending server confirmation. Drives the route-stopping CSS
        // class on the panel so the card reads as "stopping..." until
        // the SK delta clears the active course. Defaults to false so
        // existing tests / call sites that pre-date the stopping flag
        // keep working without an exhaustive ctor update.
        bool Stopping = false,
        // Total leg-by-leg distance of the active route, in metres.
        // Combined with RouteDistanceRemaining the card displays
        // "passed / total nm" rather than just remaining; gives the
        // helm a progress-vs-plan reading at a glance. Computed in
        // C# via RouteProgress.TotalDistanceMeters from the same
        // coordinate array the active polyline is drawn from. Null
        // when the route hasn't been fetched (boot race).
        double? RouteDistanceTotal = null);
}
