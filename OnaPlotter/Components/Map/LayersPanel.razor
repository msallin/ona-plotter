@using OnaPlotter.Models
@using OnaPlotter.Components.Map.Layers
@using Microsoft.AspNetCore.Components.Forms

@* Slide-in panel composed of independently-maintained sections. Each
   section is a self-contained component under Components/Map/Layers/,
   with its own expand/collapse state. *@

<div class="chart-panel" @onclick:stopPropagation>
    @{
        // Filter input threshold sums every list the filter now targets
        // (charts + routes + waypoints + notes + regions). Cutoff at
        // 6 is still enough to want a search box; below that, scrolling
        // the list is faster than typing.
        int filterableTotal = AvailableCharts.Count + AvailableRoutes.Count
            + LoadedWaypoints.Count + LoadedNotes.Count + LoadedRegions.Count;
    }
    @if (filterableTotal > 6)
    {
        <input type="text" class="layer-search"
               placeholder="Filter charts, routes, waypoints, notes, regions"
               aria-label="Filter layers"
               value="@LayerFilter" @oninput="OnFilterInput" />
    }

    <ChartsSection Charts="FilteredCharts"
                   Enabled="EnabledCharts"
                   QuickBarCharts="QuickBarCharts"
                   OnToggleQuickBar="OnToggleChartQuickBar"
                   OnReorder="OnReorderChart" />

    <RadarsSection Radars="AvailableRadars"
                   Enabled="EnabledRadars"
                   Capabilities="RadarCapabilities"
                   OnToggle="OnToggleRadar"
                   OnSetPower="OnSetRadarPower"
                   OnSetRange="OnSetRadarRange" />

    <RoutesSection Routes="FilteredRoutes"
                   Enabled="EnabledRoutes"
                   OnToggle="OnToggleRoute"
                   OnEdit="OnEditRoute"
                   OnNavigate="OnNavigateRoute"
                   OnDelete="OnDeleteRoute" />

    <WaypointsSection Waypoints="LoadedWaypoints"
                      LayerFilter="@LayerFilter"
                      OnNavigate="OnNavigateToWaypoint"
                      OnRename="OnRenameWaypoint"
                      OnDelete="OnDeleteWaypoint" />

    <NotesSection Notes="LoadedNotes"
                  Visible="NotesVisible"
                  LayerFilter="@LayerFilter"
                  OnFocus="OnFocusNote"
                  OnToggleVisible="OnToggleNotesVisible" />

    <RegionsSection Regions="LoadedRegions"
                    Visible="RegionsVisible"
                    LayerFilter="@LayerFilter"
                    OnFocus="OnFocusRegion"
                    OnEdit="OnEditRegion"
                    OnDelete="OnDeleteRegion"
                    OnToggleVisible="OnToggleRegionsVisible" />

    <BuddiesSection Buddies="Buddies"
                    Vessels="Vessels"
                    OnFocus="OnFocusVessel" />

    <VesselsSection Vessels="Vessels"
                    OnFocus="OnFocusVessel" />

    <TrackHistorySection Visible="ServerTrackVisible"
                         Duration="@ServerTrackDuration"
                         WithinBounds="ServerTrackWithinBounds"
                         OnToggle="OnToggleServerTrack"
                         OnDurationChanged="OnServerTrackDurationChanged"
                         OnWithinBoundsChanged="OnServerTrackWithinBoundsChanged" />

    @* Single "Misc" section bundles Weather + AtoNs. Was two adjacent
       single-checkbox sections; consolidating them removes a header
       row of dead chrome without losing either toggle. *@
    <MiscSection WeatherVisible="WeatherOverlayVisible"
                 WeatherOpacityPercent="WeatherOverlayOpacityPercent"
                 AtonsVisible="AtonsVisible"
                 OnToggleWeather="OnToggleWeatherOverlay"
                 OnWeatherOpacityPreview="OnWeatherOpacityPreview"
                 OnWeatherOpacityCommit="OnWeatherOpacityCommit"
                 OnToggleAtons="OnToggleAtonsVisible" />

    @* Import / Export GPX moved to the Settings page (Backup section).
       The map's Layers panel is for "what shows on the chart"; data
       in / data out is a tooling concern that fits better on Settings
       alongside polar import, build stamp, and the developer tools. *@
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<SignalkChart> AvailableCharts { get; set; } = [];
    [Parameter, EditorRequired] public IReadOnlyList<SignalkRoute> AvailableRoutes { get; set; } = [];
    [Parameter, EditorRequired] public IReadOnlyList<SignalkChart> FilteredCharts { get; set; } = [];
    [Parameter, EditorRequired] public IReadOnlyList<SignalkRoute> FilteredRoutes { get; set; } = [];
    [Parameter, EditorRequired] public IReadOnlyList<SignalkWaypoint> LoadedWaypoints { get; set; } = [];
    [Parameter] public IReadOnlyList<SignalkNote> LoadedNotes { get; set; } = [];
    [Parameter] public IReadOnlyList<SignalkRegion> LoadedRegions { get; set; } = [];
    [Parameter] public IReadOnlyList<VesselListEntry> Vessels { get; set; } = [];
    [Parameter] public IReadOnlyList<SignalkBuddy> Buddies { get; set; } = [];
    [Parameter, EditorRequired] public HashSet<string> EnabledCharts { get; set; } = [];
    [Parameter, EditorRequired] public HashSet<string> EnabledRoutes { get; set; } = [];
    [Parameter, EditorRequired] public HashSet<string> QuickBarCharts { get; set; } = [];
    [Parameter] public IReadOnlyList<RadarInfo> AvailableRadars { get; set; } = [];
    [Parameter] public IReadOnlySet<string> EnabledRadars { get; set; } = new HashSet<string>();
    [Parameter] public IReadOnlyDictionary<string, RadarCapabilities?> RadarCapabilities { get; set; } =
        new Dictionary<string, RadarCapabilities?>();
    [Parameter] public bool ServerTrackVisible { get; set; }
    [Parameter] public bool WeatherOverlayVisible { get; set; }
    [Parameter] public int WeatherOverlayOpacityPercent { get; set; } = 50;
    [Parameter] public bool NotesVisible { get; set; } = true;
    [Parameter] public bool RegionsVisible { get; set; } = true;
    [Parameter] public bool AtonsVisible { get; set; } = true;

    [Parameter] public string LayerFilter { get; set; } = "";
    [Parameter] public EventCallback<string> LayerFilterChanged { get; set; }

    [Parameter] public EventCallback<(SignalkChart chart, bool inQuickBar)> OnToggleChartQuickBar { get; set; }
    [Parameter] public EventCallback<(SignalkChart chart, int direction)> OnReorderChart { get; set; }
    [Parameter] public EventCallback<(RadarInfo radar, bool enabled)> OnToggleRadar { get; set; }
    [Parameter] public EventCallback<(RadarInfo radar, RadarPower power)> OnSetRadarPower { get; set; }
    [Parameter] public EventCallback<(RadarInfo radar, int rangeMeters)> OnSetRadarRange { get; set; }
    [Parameter] public EventCallback<(SignalkRoute route, bool enabled)> OnToggleRoute { get; set; }
    [Parameter] public EventCallback<SignalkRoute> OnEditRoute { get; set; }
    [Parameter] public EventCallback<SignalkRoute> OnNavigateRoute { get; set; }
    [Parameter] public EventCallback<SignalkRoute> OnDeleteRoute { get; set; }
    [Parameter] public EventCallback<SignalkWaypoint> OnNavigateToWaypoint { get; set; }
    [Parameter] public EventCallback<(SignalkWaypoint wp, string newName)> OnRenameWaypoint { get; set; }
    [Parameter] public EventCallback<SignalkWaypoint> OnDeleteWaypoint { get; set; }
    [Parameter] public EventCallback<SignalkNote> OnFocusNote { get; set; }
    [Parameter] public EventCallback<bool> OnToggleNotesVisible { get; set; }
    [Parameter] public EventCallback<SignalkRegion> OnFocusRegion { get; set; }
    [Parameter] public EventCallback<SignalkRegion> OnEditRegion { get; set; }
    [Parameter] public EventCallback<SignalkRegion> OnDeleteRegion { get; set; }
    [Parameter] public EventCallback<bool> OnToggleRegionsVisible { get; set; }
    [Parameter] public EventCallback<string> OnFocusVessel { get; set; }
    [Parameter] public string ServerTrackDuration { get; set; } = "1d";
    [Parameter] public bool ServerTrackWithinBounds { get; set; }
    [Parameter] public EventCallback<bool> OnToggleServerTrack { get; set; }
    [Parameter] public EventCallback<string> OnServerTrackDurationChanged { get; set; }
    [Parameter] public EventCallback<bool> OnServerTrackWithinBoundsChanged { get; set; }
    [Parameter] public EventCallback<bool> OnToggleWeatherOverlay { get; set; }
    [Parameter] public EventCallback<int> OnWeatherOpacityPreview { get; set; }
    [Parameter] public EventCallback<int> OnWeatherOpacityCommit { get; set; }
    [Parameter] public EventCallback<bool> OnToggleAtonsVisible { get; set; }

    private async Task OnFilterInput(ChangeEventArgs e)
    {
        LayerFilter = e.Value?.ToString() ?? "";
        await LayerFilterChanged.InvokeAsync(LayerFilter);
    }
}
