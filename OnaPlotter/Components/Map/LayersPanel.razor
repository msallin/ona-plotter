@using OnaPlotter.Models
@using OnaPlotter.Components.Map.Layers
@using Microsoft.AspNetCore.Components.Forms

@* Slide-in panel composed of independently-maintained sections. Each
   section is a self-contained component under Components/Map/Layers/,
   with its own expand/collapse state. *@

<div class="chart-panel" @onclick:stopPropagation>
    @* Top-level offline banner. When the SK websocket is down every
       section below shows its own "no data" empty state, which reads
       as five separate problems. One banner up top says it once and
       points the helm at the actual issue. *@
    @if (Offline)
    {
        <EmptyState Compact="true"
                    Title="Offline"
                    Message="Not connected to the SignalK server. Sections below show the last cached data; reconnect to refresh." />
    }
    @{
        // Filter input threshold sums every list the filter now targets
        // (charts + routes + waypoints + notes + regions). Cutoff at
        // 6 is still enough to want a search box; below that, scrolling
        // the list is faster than typing.
        // Counts the lists the filter actually targets: charts,
        // routes, waypoints (bbox-filtered), notes (bbox-filtered),
        // regions. The waypoints / notes counts use the filtered
        // collections so the filter input shows up only when there's
        // enough nearby content to warrant it; a chart full of
        // distant pins doesn't surface a search the helm doesn't
        // need.
        int filterableTotal = AvailableCharts.Count + AvailableRoutes.Count
            + FilteredWaypoints.Count + FilteredNotes.Count + LoadedRegions.Count;
    }
    @if (filterableTotal > 6)
    {
        <input type="text" class="layer-search"
               placeholder="Filter charts, routes, waypoints, notes, regions"
               aria-label="Filter layers"
               value="@LayerFilter" @oninput="OnFilterInput" />
    }

    <ChartsSection Charts="FilteredCharts"
                   Enabled="EnabledCharts"
                   QuickBarCharts="QuickBarCharts"
                   OnToggleQuickBar="OnToggleChartQuickBar"
                   OnReorder="OnReorderChart"
                   ContrastPercent="ChartContrastPercent"
                   SaturationPercent="ChartSaturationPercent"
                   BrightnessPercent="ChartBrightnessPercent"
                   OnContrastPreview="OnChartContrastPreview"
                   OnContrastCommit="OnChartContrastCommit"
                   OnSaturationPreview="OnChartSaturationPreview"
                   OnSaturationCommit="OnChartSaturationCommit"
                   OnBrightnessPreview="OnChartBrightnessPreview"
                   OnBrightnessCommit="OnChartBrightnessCommit"
                   OnFilterReset="OnChartFilterReset" />

    <RadarsSection Radars="AvailableRadars"
                   Enabled="EnabledRadars"
                   Capabilities="RadarCapabilities"
                   OnToggle="OnToggleRadar"
                   OnSetPower="OnSetRadarPower"
                   OnSetRange="OnSetRadarRange" />

    <RoutesSection Routes="FilteredRoutes"
                   Enabled="EnabledRoutes"
                   OnToggle="OnToggleRoute"
                   OnEdit="OnEditRoute"
                   OnNavigate="OnNavigateRoute"
                   OnDelete="OnDeleteRoute" />

    <WaypointsSection Waypoints="FilteredWaypoints"
                      LayerFilter="@LayerFilter"
                      OnFocus="OnFocusWaypoint"
                      OnNavigate="OnNavigateToWaypoint"
                      OnEdit="OnEditWaypoint"
                      OnDelete="OnDeleteWaypoint" />

    <NotesSection Notes="FilteredNotes"
                  LayerFilter="@LayerFilter"
                  OnFocus="OnFocusNote"
                  OnNavigate="OnNavigateToNote"
                  OnEdit="OnEditNote"
                  OnDelete="OnDeleteNote" />

    <RegionsSection Regions="LoadedRegions"
                    Visible="RegionsVisible"
                    LayerFilter="@LayerFilter"
                    OnFocus="OnFocusRegion"
                    OnEdit="OnEditRegion"
                    OnDelete="OnDeleteRegion"
                    OnToggleVisible="OnToggleRegionsVisible" />

    @* Single section for every "about my own boat" chart layer:
       ship-lines master, local trail, server-side ship track + its
       window / resolution / within-bounds controls. Consolidating
       the previous Server-history section here saves the helm a
       hunt across the panel for the right toggle. *@
    <OwnShipSection ShipLinesVisible="ShipLinesVisible"
                    OnToggleShipLines="OnToggleShipLines"
                    LaylinesVisible="LaylinesVisible"
                    OnToggleLaylines="OnToggleLaylines"
                    GuardZoneVisible="GuardZoneVisible"
                    OnToggleGuardZone="OnToggleGuardZoneVisible"
                    ServerTrackVisible="ServerTrackVisible"
                    ServerTrackDuration="@ServerTrackDuration"
                    ServerTrackResolution="@ServerTrackResolution"
                    ServerTrackWithinBounds="ServerTrackWithinBounds"
                    OnToggleServerTrack="OnToggleServerTrack"
                    OnServerTrackDurationChanged="OnServerTrackDurationChanged"
                    OnServerTrackResolutionChanged="OnServerTrackResolutionChanged"
                    OnToggleServerTrackWithinBounds="OnServerTrackWithinBoundsChanged" />

    <BuddiesSection Buddies="Buddies"
                    Vessels="Vessels"
                    OnFocus="OnFocusVessel" />

    <VesselsSection Vessels="Vessels"
                    OnFocus="OnFocusVessel" />

    @* HUD visibility toggles - mirrors the Settings page so the
       helm can declutter the chart without leaving the Map. *@
    <HudsSection ShowDefaultHud="ShowDefaultHud"
                 ShowAutopilotHud="ShowAutopilotHud"
                 ShowRadarHud="ShowRadarHud"
                 BigType="BigType"
                 ExpandAllHud="ExpandAllHud"
                 OnToggleDefaultHud="OnToggleShowDefaultHud"
                 OnToggleAutopilotHud="OnToggleShowAutopilotHud"
                 OnToggleRadarHud="OnToggleShowRadarHud"
                 OnToggleBigType="OnToggleBigType"
                 OnToggleExpandAllHud="OnToggleExpandAllHud" />

    @* OSM marine services overlay (Layers > Marine services). Off
       by default; helm opts in per-category. Cached responses keep
       markers visible offline. The master "Show" toggle on the
       header hides every marker without dropping the per-category
       picks. *@
    <MarineServicesSection OverlayVisible="MarinePoiOverlayVisible"
                           FuelEnabled="MarinePoiFuelEnabled"
                           MarinaEnabled="MarinePoiMarinaEnabled"
                           HarbourEnabled="MarinePoiHarbourEnabled"
                           MooringEnabled="MarinePoiMooringEnabled"
                           SlipwayEnabled="MarinePoiSlipwayEnabled"
                           PierEnabled="MarinePoiPierEnabled"
                           ChandleryEnabled="MarinePoiChandleryEnabled"
                           DrinkingWaterEnabled="MarinePoiDrinkingWaterEnabled"
                           PumpOutEnabled="MarinePoiPumpOutEnabled"
                           OnToggleOverlay="OnToggleMarinePoiOverlay"
                           OnToggleFuel="OnToggleMarinePoiFuel"
                           OnToggleMarina="OnToggleMarinePoiMarina"
                           OnToggleHarbour="OnToggleMarinePoiHarbour"
                           OnToggleMooring="OnToggleMarinePoiMooring"
                           OnToggleSlipway="OnToggleMarinePoiSlipway"
                           OnTogglePier="OnToggleMarinePoiPier"
                           OnToggleChandlery="OnToggleMarinePoiChandlery"
                           OnToggleDrinkingWater="OnToggleMarinePoiDrinkingWater"
                           OnTogglePumpOut="OnToggleMarinePoiPumpOut" />

    @* Single "Misc" section bundles Weather + AtoNs. Was two adjacent
       single-checkbox sections; consolidating them removes a header
       row of dead chrome without losing either toggle. Lives at the
       bottom of the panel so the chart-related sections (charts,
       routes, regions, services) cluster together at the top -
       helm-flagged: Misc was a grab-bag and reading it before Marine
       services felt out of order. *@
    <MiscSection WeatherVisible="WeatherOverlayVisible"
                 WeatherOpacityPercent="WeatherOverlayOpacityPercent"
                 AtonsVisible="AtonsVisible"
                 AisLabelsVisible="AisLabelsVisible"
                 OnToggleWeather="OnToggleWeatherOverlay"
                 OnWeatherOpacityPreview="OnWeatherOpacityPreview"
                 OnWeatherOpacityCommit="OnWeatherOpacityCommit"
                 OnToggleAtons="OnToggleAtonsVisible"
                 OnToggleAisLabels="OnToggleAisLabelsVisible" />

    @* Import / Export GPX moved to the Settings page (Backup section).
       The map's Layers panel is for "what shows on the chart"; data
       in / data out is a tooling concern that fits better on Settings
       alongside polar import, build stamp, and the developer tools. *@
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<SignalkChart> AvailableCharts { get; set; } = [];
    [Parameter, EditorRequired] public IReadOnlyList<SignalkRoute> AvailableRoutes { get; set; } = [];
    [Parameter, EditorRequired] public IReadOnlyList<SignalkChart> FilteredCharts { get; set; } = [];
    [Parameter, EditorRequired] public IReadOnlyList<SignalkRoute> FilteredRoutes { get; set; } = [];
    /// <summary>Waypoints inside the current viewport (parent applies
    /// the bbox filter using the same machinery as
    /// <see cref="FilteredCharts"/>). The Layers panel never sees the
    /// full <c>loadedWaypoints</c> list - helms field-tested that on
    /// long charter days the list balloons to dozens of pins, all
    /// from passages they're not currently on, and scrolling past
    /// them to find the relevant one wins nobody anything.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<SignalkWaypoint> FilteredWaypoints { get; set; } = [];
    /// <summary>Notes inside the current viewport. Same reasoning as
    /// <see cref="FilteredWaypoints"/>: replaces the previous "Show"
    /// global toggle, the bbox filter is the natural relevance cue.</summary>
    [Parameter] public IReadOnlyList<SignalkNote> FilteredNotes { get; set; } = [];
    [Parameter] public IReadOnlyList<SignalkRegion> LoadedRegions { get; set; } = [];
    [Parameter] public IReadOnlyList<VesselListEntry> Vessels { get; set; } = [];
    [Parameter] public IReadOnlyList<SignalkBuddy> Buddies { get; set; } = [];
    [Parameter, EditorRequired] public HashSet<string> EnabledCharts { get; set; } = [];
    [Parameter, EditorRequired] public HashSet<string> EnabledRoutes { get; set; } = [];
    [Parameter, EditorRequired] public HashSet<string> QuickBarCharts { get; set; } = [];
    [Parameter] public IReadOnlyList<RadarInfo> AvailableRadars { get; set; } = [];
    [Parameter] public IReadOnlySet<string> EnabledRadars { get; set; } = new HashSet<string>();
    [Parameter] public IReadOnlyDictionary<string, RadarCapabilities?> RadarCapabilities { get; set; } =
        new Dictionary<string, RadarCapabilities?>();
    [Parameter] public bool ShipLinesVisible { get; set; } = true;
    [Parameter] public EventCallback<bool> OnToggleShipLines { get; set; }
    [Parameter] public bool LaylinesVisible { get; set; }
    [Parameter] public EventCallback<bool> OnToggleLaylines { get; set; }
    [Parameter] public bool ServerTrackVisible { get; set; }
    [Parameter] public bool WeatherOverlayVisible { get; set; }
    [Parameter] public int WeatherOverlayOpacityPercent { get; set; } = 50;
    [Parameter] public bool RegionsVisible { get; set; } = true;
    [Parameter] public bool AtonsVisible { get; set; } = true;
    [Parameter] public bool AisLabelsVisible { get; set; } = true;
    [Parameter] public bool GuardZoneVisible { get; set; } = true;
    [Parameter] public bool ShowDefaultHud { get; set; } = true;
    [Parameter] public bool ShowAutopilotHud { get; set; }
    [Parameter] public bool ShowRadarHud { get; set; }
    [Parameter] public bool BigType { get; set; }
    [Parameter] public bool ExpandAllHud { get; set; }
    /// <summary>True when the SignalK websocket is not connected. The
    /// panel renders a top-level offline banner so the helm sees the
    /// actual cause once instead of N section-level "nothing here"
    /// confusions when the server is unreachable.</summary>
    [Parameter] public bool Offline { get; set; }

    [Parameter] public string LayerFilter { get; set; } = "";
    [Parameter] public EventCallback<string> LayerFilterChanged { get; set; }

    [Parameter] public EventCallback<(SignalkChart chart, bool inQuickBar)> OnToggleChartQuickBar { get; set; }
    [Parameter] public EventCallback<(SignalkChart chart, int direction)> OnReorderChart { get; set; }
    [Parameter] public EventCallback<(RadarInfo radar, bool enabled)> OnToggleRadar { get; set; }
    [Parameter] public EventCallback<(RadarInfo radar, RadarPower power)> OnSetRadarPower { get; set; }
    [Parameter] public EventCallback<(RadarInfo radar, int rangeMeters)> OnSetRadarRange { get; set; }
    [Parameter] public EventCallback<(SignalkRoute route, bool enabled)> OnToggleRoute { get; set; }
    [Parameter] public EventCallback<SignalkRoute> OnEditRoute { get; set; }
    [Parameter] public EventCallback<SignalkRoute> OnNavigateRoute { get; set; }
    [Parameter] public EventCallback<SignalkRoute> OnDeleteRoute { get; set; }
    [Parameter] public EventCallback<SignalkWaypoint> OnFocusWaypoint { get; set; }
    [Parameter] public EventCallback<SignalkWaypoint> OnNavigateToWaypoint { get; set; }
    /// <summary>Helm tapped Edit on a waypoint row. Parent opens
    /// the same dialog used for Create, pre-filled.</summary>
    [Parameter] public EventCallback<SignalkWaypoint> OnEditWaypoint { get; set; }
    [Parameter] public EventCallback<SignalkWaypoint> OnDeleteWaypoint { get; set; }
    [Parameter] public EventCallback<SignalkNote> OnFocusNote { get; set; }
    [Parameter] public EventCallback<SignalkNote> OnNavigateToNote { get; set; }
    /// <summary>Helm tapped Edit on a note row. Parent opens the
    /// same dialog used for Add Note, pre-filled.</summary>
    [Parameter] public EventCallback<SignalkNote> OnEditNote { get; set; }
    [Parameter] public EventCallback<SignalkNote> OnDeleteNote { get; set; }
    [Parameter] public EventCallback<SignalkRegion> OnFocusRegion { get; set; }
    [Parameter] public EventCallback<SignalkRegion> OnEditRegion { get; set; }
    [Parameter] public EventCallback<SignalkRegion> OnDeleteRegion { get; set; }
    [Parameter] public EventCallback<bool> OnToggleRegionsVisible { get; set; }
    [Parameter] public EventCallback<string> OnFocusVessel { get; set; }
    [Parameter] public string ServerTrackDuration { get; set; } = "1d";
    [Parameter] public string ServerTrackResolution { get; set; } = "1m";
    [Parameter] public bool ServerTrackWithinBounds { get; set; }
    [Parameter] public EventCallback<bool> OnToggleServerTrack { get; set; }
    [Parameter] public EventCallback<string> OnServerTrackDurationChanged { get; set; }
    [Parameter] public EventCallback<string> OnServerTrackResolutionChanged { get; set; }
    [Parameter] public EventCallback<bool> OnServerTrackWithinBoundsChanged { get; set; }
    [Parameter] public EventCallback<bool> OnToggleWeatherOverlay { get; set; }
    [Parameter] public EventCallback<int> OnWeatherOpacityPreview { get; set; }
    [Parameter] public EventCallback<int> OnWeatherOpacityCommit { get; set; }
    [Parameter] public EventCallback<bool> OnToggleAtonsVisible { get; set; }
    [Parameter] public EventCallback<bool> OnToggleAisLabelsVisible { get; set; }

    // Marine-services category flags + callbacks. Threaded through to
    // MarineServicesSection. Each callback tells Map.razor.cs to flip
    // the persisted setting; the controller picks it up via the
    // OnSettingsChanged fan-out and re-renders / refetches.
    // The master overlay flag rides at the top of the section as a
    // "Show" chip; flipping it off clears every marker without
    // touching individual category state.
    [Parameter] public bool MarinePoiOverlayVisible { get; set; } = true;
    [Parameter] public EventCallback<bool> OnToggleMarinePoiOverlay { get; set; }
    [Parameter] public bool MarinePoiFuelEnabled { get; set; }
    [Parameter] public bool MarinePoiMarinaEnabled { get; set; }
    [Parameter] public bool MarinePoiHarbourEnabled { get; set; }
    [Parameter] public bool MarinePoiMooringEnabled { get; set; }
    [Parameter] public bool MarinePoiSlipwayEnabled { get; set; }
    [Parameter] public bool MarinePoiPierEnabled { get; set; }
    [Parameter] public bool MarinePoiChandleryEnabled { get; set; }
    [Parameter] public bool MarinePoiDrinkingWaterEnabled { get; set; }
    [Parameter] public bool MarinePoiPumpOutEnabled { get; set; }
    [Parameter] public EventCallback<bool> OnToggleMarinePoiFuel { get; set; }
    [Parameter] public EventCallback<bool> OnToggleMarinePoiMarina { get; set; }
    [Parameter] public EventCallback<bool> OnToggleMarinePoiHarbour { get; set; }
    [Parameter] public EventCallback<bool> OnToggleMarinePoiMooring { get; set; }
    [Parameter] public EventCallback<bool> OnToggleMarinePoiSlipway { get; set; }
    [Parameter] public EventCallback<bool> OnToggleMarinePoiPier { get; set; }
    [Parameter] public EventCallback<bool> OnToggleMarinePoiChandlery { get; set; }
    [Parameter] public EventCallback<bool> OnToggleMarinePoiDrinkingWater { get; set; }
    [Parameter] public EventCallback<bool> OnToggleMarinePoiPumpOut { get; set; }

    [Parameter] public EventCallback<bool> OnToggleGuardZoneVisible { get; set; }
    [Parameter] public EventCallback<bool> OnToggleShowDefaultHud { get; set; }
    [Parameter] public EventCallback<bool> OnToggleShowAutopilotHud { get; set; }
    [Parameter] public EventCallback<bool> OnToggleShowRadarHud { get; set; }
    [Parameter] public EventCallback<bool> OnToggleBigType { get; set; }
    [Parameter] public EventCallback<bool> OnToggleExpandAllHud { get; set; }

    // ---- Chart-display CSS-filter sliders --------------------------
    // Forwarded to ChartsSection's "Display" group at the bottom of
    // the chart list. Same preview/commit pattern as the weather
    // opacity row: preview pushes to JS for live feedback, commit
    // persists to localStorage and broadcasts OnSettingsChanged.
    [Parameter] public int ChartContrastPercent { get; set; } = 100;
    [Parameter] public int ChartSaturationPercent { get; set; } = 100;
    [Parameter] public int ChartBrightnessPercent { get; set; } = 100;
    [Parameter] public EventCallback<int> OnChartContrastPreview { get; set; }
    [Parameter] public EventCallback<int> OnChartContrastCommit { get; set; }
    [Parameter] public EventCallback<int> OnChartSaturationPreview { get; set; }
    [Parameter] public EventCallback<int> OnChartSaturationCommit { get; set; }
    [Parameter] public EventCallback<int> OnChartBrightnessPreview { get; set; }
    [Parameter] public EventCallback<int> OnChartBrightnessCommit { get; set; }
    /// <summary>Reset every channel to identity (100). One callback so
    /// the parent can persist all three under a single
    /// OnSettingsChanged broadcast.</summary>
    [Parameter] public EventCallback OnChartFilterReset { get; set; }

    private async Task OnFilterInput(ChangeEventArgs e)
    {
        LayerFilter = e.Value?.ToString() ?? "";
        await LayerFilterChanged.InvokeAsync(LayerFilter);
    }
}
