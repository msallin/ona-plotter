@using OnaPlotter.Utilities

@* Bottom control bar. Left-most slot is the Legend key (low-frequency
   but highest discoverability need -- "what does that symbol mean"),
   then the four groups: view (follow/orientation/night), safety
   (anchor/MOB), navigation (fit/laylines/measure), create (add/route/
   race), and finally Layers on the far right. *@

<div class="map-controls">
    <button class="ctrl-btn @(LegendOpen ? "active" : "")" @onclick="OnToggleLegend"
            title="Map legend: what every symbol means">
        <span class="ctrl-ico">@((MarkupString)Icons.Legend)</span>
        <span class="ctrl-lbl">Legend</span>
    </button>

    <div class="ctrl-sep"></div>

    <button class="ctrl-btn @(Follow ? "active" : "")" @onclick="OnToggleFollow" title="Follow boat (F)">
        <span class="ctrl-ico">@((MarkupString)Icons.Follow)</span>
        <span class="ctrl-lbl">@(Follow ? "Follow" : "Free")</span>
    </button>
    <button class="ctrl-btn" @onclick="OnCycleOrientation" title="Map orientation (O)">
        <span class="ctrl-ico">@((MarkupString)Icons.Compass)</span>
        <span class="ctrl-lbl">@OrientationLabel</span>
    </button>
    <button class="ctrl-btn @(NightMode ? "active" : "")"
            @onclick="NightClicked"
            @onpointerdown="StartNightHold"
            @onpointerup="EndNightHold"
            @onpointerleave="EndNightHold"
            @onpointercancel="EndNightHold"
            title="Night mode (N) -- hold for Dark Ops (chrome-off)">
        <span class="ctrl-ico">@((MarkupString)Icons.Moon)</span>
        <span class="ctrl-lbl">Night</span>
    </button>

    <div class="ctrl-sep"></div>

    <button class="ctrl-btn @(AnchorActive ? "active" : "")" @onclick="OnToggleAnchor" title="Anchor watch (A)">
        <span class="ctrl-ico">@((MarkupString)Icons.Anchor)</span>
        <span class="ctrl-lbl">@(AnchorActive ? "Set" : "Anchor")</span>
    </button>
    <button class="ctrl-btn ctrl-btn-danger @(MobActive ? "active" : "")" @onclick="OnToggleMob" title="Man overboard (M)">
        <span class="ctrl-ico">@((MarkupString)Icons.Mob)</span>
        <span class="ctrl-lbl">MOB</span>
    </button>

    <div class="ctrl-sep"></div>

    <button class="ctrl-btn" @onclick="OnZoomToTrack" title="Fit track (T)">
        <span class="ctrl-ico">@((MarkupString)Icons.Fit)</span>
        <span class="ctrl-lbl">Fit</span>
    </button>
    <button class="ctrl-btn" @onclick="OnCentreOnBoat"
            title="Centre on boat (one-shot; doesn't engage Follow)">
        <span class="ctrl-ico">@((MarkupString)Icons.Centre)</span>
        <span class="ctrl-lbl">Centre</span>
    </button>
    <button class="ctrl-btn @(LaylinesVisible ? "active" : "")" @onclick="OnToggleLaylines" title="Laylines (L)">
        <span class="ctrl-ico">@((MarkupString)Icons.Laylines)</span>
        <span class="ctrl-lbl">Laylines</span>
    </button>
    <button class="ctrl-btn @(MeasureActive ? "active" : "")" @onclick="OnToggleMeasure"
            title="Measure (D) -- tap to drop ruler points">
        <span class="ctrl-ico">@((MarkupString)Icons.Measure)</span>
        <span class="ctrl-lbl">Measure</span>
    </button>

    <div class="ctrl-sep"></div>

    <button class="ctrl-btn @(FabMenuOpen ? "active" : "")" @onclick="OnToggleFab"
            title="Add waypoint / note / region at map centre">
        <span class="ctrl-ico">@((MarkupString)Icons.Plus)</span>
        <span class="ctrl-lbl">Add</span>
    </button>
    @if (!RouteEditMode)
    {
        <button class="ctrl-btn" @onclick="OnStartRouteEdit" title="Create a new route">
            <span class="ctrl-ico">@((MarkupString)Icons.Route)</span>
            <span class="ctrl-lbl">Route</span>
        </button>
    }
    @* Race timer is only relevant in Race mode. Keep it visible while
       actively counting down even if the user flips modes mid-sequence
       so the start doesn't vanish on them. *@
    @if (SailingMode == "race" || RaceTimerActive)
    {
        <button class="ctrl-btn @(RaceTimerActive ? "active" : "")" @onclick="OnToggleRaceTimer" title="Race timer (R)">
            <span class="ctrl-ico">@((MarkupString)Icons.Flag)</span>
            <span class="ctrl-lbl">@(RaceTimerActive ? RaceTimerLabel : "Race")</span>
        </button>
    }

    <div class="ctrl-sep"></div>

    <button class="ctrl-btn @(LayersPanelOpen ? "active" : "")" @onclick="OnToggleLayers"
            title="Layers panel">
        <span class="ctrl-ico">@((MarkupString)Icons.Layers)</span>
        <span class="ctrl-lbl">Layers</span>
    </button>
</div>

@code {
    [Parameter] public bool Follow { get; set; }
    [Parameter] public string OrientationLabel { get; set; } = "N\u2191";
    [Parameter] public bool NightMode { get; set; }
    [Parameter] public bool AnchorActive { get; set; }
    [Parameter] public bool MobActive { get; set; }
    [Parameter] public bool LaylinesVisible { get; set; }
    [Parameter] public bool MeasureActive { get; set; }
    [Parameter] public bool RouteEditMode { get; set; }
    [Parameter] public bool RaceTimerActive { get; set; }
    [Parameter] public string RaceTimerLabel { get; set; } = "";
    [Parameter] public bool LayersPanelOpen { get; set; }
    [Parameter] public bool LegendOpen { get; set; }
    [Parameter] public bool FabMenuOpen { get; set; }
    [Parameter] public string SailingMode { get; set; } = "cruise";

    [Parameter] public EventCallback OnToggleFollow { get; set; }
    [Parameter] public EventCallback OnCycleOrientation { get; set; }
    [Parameter] public EventCallback OnToggleNight { get; set; }
    [Parameter] public EventCallback OnToggleAnchor { get; set; }
    [Parameter] public EventCallback OnToggleMob { get; set; }
    [Parameter] public EventCallback OnZoomToTrack { get; set; }
    [Parameter] public EventCallback OnCentreOnBoat { get; set; }
    [Parameter] public EventCallback OnToggleLaylines { get; set; }
    [Parameter] public EventCallback OnToggleMeasure { get; set; }
    [Parameter] public EventCallback OnStartRouteEdit { get; set; }
    [Parameter] public EventCallback OnToggleRaceTimer { get; set; }
    [Parameter] public EventCallback OnToggleLayers { get; set; }
    [Parameter] public EventCallback OnToggleLegend { get; set; }
    [Parameter] public EventCallback OnToggleFab { get; set; }

    /// <summary>Fires on a long-press of the Night button. Parent uses
    /// this to toggle "Dark Ops" -- the chrome-off mode for long
    /// offshore watches where the helmsman wants nothing competing
    /// with the chart + alarms.</summary>
    [Parameter] public EventCallback OnToggleDarkOps { get; set; }

    // --- Night-button long-press detection ----------------------
    // 700 ms matches the long-press envelope used by the map context
    // menu (agents.md) -- keeping the tactile vocabulary consistent so
    // "long-press" means the same thing everywhere. Cancelling the
    // hold also suppresses the subsequent click so the user doesn't
    // get both a Dark Ops flip AND a Night toggle.
    private const int NightHoldMs = 700;
    private CancellationTokenSource? _nightHoldCts;
    private bool _nightHoldFired;

    private void StartNightHold()
    {
        _nightHoldCts?.Cancel();
        _nightHoldCts = new CancellationTokenSource();
        _nightHoldFired = false;
        _ = RunNightHoldAsync(_nightHoldCts.Token);
    }

    private async Task RunNightHoldAsync(CancellationToken ct)
    {
        try
        {
            await Task.Delay(NightHoldMs, ct);
            if (ct.IsCancellationRequested) return;
            _nightHoldFired = true;
            await OnToggleDarkOps.InvokeAsync();
        }
        catch (OperationCanceledException) { }
    }

    private void EndNightHold()
    {
        _nightHoldCts?.Cancel();
        _nightHoldCts = null;
    }

    // Click-AFTER-pointerup is the mouse / touch sequence we intercept.
    // When the hold already fired the dark-ops toggle, swallow the click
    // so Night doesn't also toggle on top. Otherwise propagate normally.
    private async Task NightClicked()
    {
        if (_nightHoldFired)
        {
            _nightHoldFired = false;
            return;
        }
        await OnToggleNight.InvokeAsync();
    }
}
