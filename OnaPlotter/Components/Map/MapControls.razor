@using OnaPlotter.Utilities
@implements IDisposable

@* Bottom control bar.

   Layout: More (overflow) is leftmost, then navigation grouping
   (Follow / Centre), safety (Anchor / MOB), view (Fit), create
   (Add / Measure / Race), and finally Layers. "Less-essential" toggles
   (Legend / Night / Orient) live inside the More menu; the More
   button shows a dot when any of its contents are active so an "on"
   state doesn't hide behind a closed menu. Laylines used to live
   here too; they moved to the Layers panel "Own ship" section under
   the master "Show ship lines" toggle so the helm has one knob for
   all own-ship informational chart lines. *@

<div class="map-controls">
    @* Overflow menu anchor. Shows a dot badge when any contained
       toggle is currently active so the helm can tell at a glance
       that Night or Harbor mode is on without opening the menu. *@
    <div class="ctrl-more-wrap">
        <button class="ctrl-btn @(MoreMenuOpen ? "active" : "") @(AnyMoreItemActive ? "ctrl-btn-dot" : "")"
                @onclick="ToggleMoreMenu"
                aria-haspopup="menu"
                aria-expanded="@(MoreMenuOpen ? "true" : "false")"
                title="@MoreButtonTitle">
            <span class="ctrl-ico">@((MarkupString)Icons.More)</span>
            <span class="ctrl-lbl">More</span>
        </button>
        @* Menu lives INSIDE the wrap so position: absolute anchors to the
           button above (not the viewport). A full-screen backdrop, rendered
           outside .map-controls below, handles outside-click dismissal. *@
        @if (MoreMenuOpen)
        {
            <div class="ctrl-more-menu" @onclick:stopPropagation>
                @* === Phone overflow items ===
                   On viewports <= 600 px the bar hides Centre / Orient / Add
                   to keep the row from wrapping; the same actions land here
                   instead. CSS-only visibility split: bigger viewports show
                   them in the bar and hide them here, phones do the reverse. *@
                <button class="ctrl-more-item ctrl-more-overflow"
                        @onclick="() => Select(OnCentreOnBoat)"
                        title="Centre on boat">
                    <span class="ctrl-more-ico">@((MarkupString)Icons.Centre)</span>
                    <span>Centre</span>
                </button>
                <button class="ctrl-more-item ctrl-more-overflow"
                        @onclick="() => Select(OnFabCreateWaypoint)"
                        title="Add waypoint at map centre">
                    <span class="ctrl-more-ico">@((MarkupString)Icons.Plus)</span>
                    <span>Add Waypoint</span>
                </button>
                <button class="ctrl-more-item ctrl-more-overflow"
                        @onclick="() => Select(OnFabCreateNote)"
                        title="Add note at map centre">
                    <span class="ctrl-more-ico">&#9783;</span>
                    <span>Add Note</span>
                </button>
                <button class="ctrl-more-item ctrl-more-overflow"
                        @onclick="() => Select(OnFabCreateRegion)"
                        title="Add region at map centre">
                    <span class="ctrl-more-ico">&#9711;</span>
                    <span>Add Region</span>
                </button>
                <button class="ctrl-more-item ctrl-more-overflow @(RouteEditMode ? "active" : "")"
                        @onclick="() => Select(OnStartRouteEdit)"
                        disabled="@RouteEditMode"
                        title="@(RouteEditMode ? "Already editing a route" : "Start a new route")">
                    <span class="ctrl-more-ico">@((MarkupString)Icons.Route)</span>
                    <span>Add Route</span>
                </button>
                <button class="ctrl-more-item ctrl-more-overflow"
                        @onclick="() => Select(OnZoomToTrack)"
                        title="Fit track">
                    <span class="ctrl-more-ico">@((MarkupString)Icons.Fit)</span>
                    <span>Fit Track</span>
                </button>
                <button class="ctrl-more-item ctrl-more-overflow @(AnchorActive ? "ctrl-more-active" : "")"
                        @onclick="() => Select(OnAnchorClicked)"
                        title="@(AnchorActive ? "Raise anchor" : "Drop anchor")">
                    <span class="ctrl-more-ico">@((MarkupString)Icons.Anchor)</span>
                    <span>@(AnchorActive ? "Raise Anchor" : "Drop Anchor")</span>
                </button>
                <button class="ctrl-more-item ctrl-more-overflow @(MobActive ? "ctrl-more-active" : "")"
                        @onclick="() => Select(OnMobClicked)"
                        title="@(MobActive ? "Clear MOB" : "Man overboard")">
                    <span class="ctrl-more-ico">@((MarkupString)Icons.Mob)</span>
                    <span>@(MobActive ? "Clear MOB" : "MOB")</span>
                </button>
                <div class="ctrl-more-sep ctrl-more-overflow"></div>

                <button class="ctrl-more-item @(LegendOpen ? "ctrl-more-active" : "")"
                        @onclick="() => Select(OnToggleLegend)">
                    <span class="ctrl-more-ico">@((MarkupString)Icons.Legend)</span>
                    <span>Legend</span>
                </button>
                <button class="ctrl-more-item @(NightMode ? "ctrl-more-active" : "")"
                        @onclick="NightClicked"
                        @onpointerdown="StartNightHold"
                        @onpointerup="EndNightHold"
                        @onpointerleave="EndNightHold"
                        @onpointercancel="EndNightHold"
                        title="Night mode (N) -- hold for Dark Ops">
                    <span class="ctrl-more-ico">@((MarkupString)Icons.Moon)</span>
                    @* "(hold)" inline so touch users (no title-attribute
                       hover) discover the long-press shortcut to Dark
                       Ops. Falls away once Night is on -- the helm has
                       already engaged the mode and doesn't need the
                       discovery hint. *@
                    <span>Night @(NightMode ? "(on)" : "(tap = soft, hold = Dark Ops)")</span>
                </button>
                @* Harbor mode: a single switch that bundles AIS / collision
                   suppressions for entering a busy port -- moored vessels
                   hidden, name labels off, COG vectors off, CPA arcs off,
                   CPA audio alarm muted, guard ring hidden. Resets to OFF
                   on every page reload (in-memory only) so a forgotten
                   Harbor mode never silently rides into open water. *@
                <button class="ctrl-more-item @(HarborMode ? "ctrl-more-active" : "")"
                        @onclick="() => Select(OnToggleHarborMode)"
                        title="Harbor mode -- hide moored vessels, names, COG, CPA, guard ring (resets on reload)">
                    <span class="ctrl-more-ico">@((MarkupString)Icons.Harbor)</span>
                    <span>Harbor@(HarborMode ? " (on)" : "")</span>
                </button>
                @* Orient lives in the More menu now (was in the bar). It's a
                   set-and-forget choice -- helms cycle North-up / Course-up /
                   Heading-up at most a few times per passage, so it doesn't
                   earn a permanent bar slot. *@
                <button class="ctrl-more-item"
                        @onclick="() => Select(OnCycleOrientation)"
                        title="Map orientation (O)">
                    <span class="ctrl-more-ico">@((MarkupString)Icons.Compass)</span>
                    <span>Orient (@OrientationLabel)@(ShowKeyboardHints ? " (O)" : "")</span>
                </button>
                @* Tips / Shortcuts: surfaces MapShortcutsOverlay for
                   touch users who can't tap "?" on a keyboard. The
                   overlay lists every shortcut (F = follow, A = anchor,
                   M = MOB, ...) plus pointer / touch tips. Gated on
                   the same callback the keyboard handler uses so a
                   helm with both inputs sees one entry point. *@
                <button class="ctrl-more-item"
                        @onclick="() => Select(OnShowShortcuts)"
                        title="Tips and keyboard shortcuts">
                    @* Help glyph (?-in-circle) NOT Legend so this row
                       doesn't share an icon with the Legend row above. *@
                    <span class="ctrl-more-ico">@((MarkupString)Icons.Help)</span>
                    <span>Tips / Shortcuts</span>
                </button>
            </div>
        }
    </div>

    <div class="ctrl-sep"></div>

    <button class="ctrl-btn @(Follow ? "active" : "")" @onclick="OnToggleFollow" title="Follow boat (F)">
        <span class="ctrl-ico">@((MarkupString)Icons.Follow)</span>
        <span class="ctrl-lbl">@(Follow ? "Follow" : "Free")</span>
    </button>
    <button class="ctrl-btn ctrl-btn-overflow" @onclick="OnCentreOnBoat"
            title="Centre on boat (one-shot; doesn't engage Follow)">
        <span class="ctrl-ico">@((MarkupString)Icons.Centre)</span>
        <span class="ctrl-lbl">Centre</span>
    </button>

    <div class="ctrl-sep"></div>

    @* Anchor: one-tap drop; two-tap raise (same confirm pattern as
       MOB clear and Stop Navigation so the three safety-critical
       red-path controls in the bar feel identical under stress). *@
    <button class="ctrl-btn ctrl-btn-overflow @(AnchorActive ? "active" : "") @(anchorClearConfirming ? "ctrl-btn-confirming" : "")"
            @onclick="OnAnchorClicked"
            title="@(anchorClearConfirming ? "Tap again to raise anchor" : AnchorActive ? "Raise anchor (A)" : "Drop anchor (A)")">
        <span class="ctrl-ico">@((MarkupString)Icons.Anchor)</span>
        @* "Anchored" reads as state ("an anchor IS down") rather than
           the previous "Set", which the helm field-tested as ambiguous
           ("set what?"). The button is a state indicator + toggle: when
           inactive it says "Anchor" (the noun, also the affordance),
           when active it says "Anchored" (the state). *@
        <span class="ctrl-lbl">@(anchorClearConfirming ? "Confirm?" : AnchorActive ? "Anchored" : "Anchor")</span>
    </button>
    @* Stop Navigation lives next to Anchor because the two are the
       "end the current safety state" grouping: a route and a manual
       anchor are already mutually exclusive in the code, so rendering
       their kill-switches together mirrors that pairing. The button
       only appears while a route is active -- no visual dead weight
       when there's nothing to stop. *@
    @if (RouteNavigating)
    {
        @* Two-step confirm: an accidental tap on the red button in a
           rolling cockpit would silently kill the active route. First
           tap flips the button into confirm state; second tap within
           ConfirmWindowMs actually stops. Matches the waypoint/note/
           region popup delete pattern already used elsewhere. The
           --confirm-window inline custom property drives the CSS
           countdown bar's animation-duration so the bar reaches zero
           exactly when the C# timer fires; one constant, one source. *@
        <button class="ctrl-btn ctrl-btn-danger @(stopConfirming ? "ctrl-btn-confirming" : "")"
                style="--confirm-window: @(ConfirmWindowMs)ms;"
                @onclick="OnStopClicked"
                title="@(stopConfirming ? "Tap again to confirm" : "Stop navigation -- clear the active route / destination")">
            <span class="ctrl-ico">@((MarkupString)Icons.X)</span>
            <span class="ctrl-lbl">@(stopConfirming ? "Confirm?" : "Stop")</span>
        </button>
    }
    @* MOB: one-tap DROP (no confirm -- every second matters in a real
       MOB event), two-tap CLEAR when already active. Matches the Stop
       button's confirm pattern so the two safety-critical red buttons
       feel the same under stress. *@
    <button class="ctrl-btn ctrl-btn-overflow ctrl-btn-danger @(MobActive ? "active" : "") @(mobClearConfirming ? "ctrl-btn-confirming" : "")"
            @onclick="OnMobClicked"
            title="@(mobClearConfirming ? "Tap again to clear MOB" : MobActive ? "Clear MOB (M)" : "Man overboard (M)")">
        <span class="ctrl-ico">@((MarkupString)Icons.Mob)</span>
        <span class="ctrl-lbl">@(mobClearConfirming ? "Confirm?" : "MOB")</span>
    </button>

    <div class="ctrl-sep"></div>

    <button class="ctrl-btn ctrl-btn-overflow" @onclick="OnZoomToTrack" title="Fit track (T)">
        <span class="ctrl-ico">@((MarkupString)Icons.Fit)</span>
        <span class="ctrl-lbl">Fit</span>
    </button>

    <div class="ctrl-sep"></div>

    @* Add button + its flyout menu. Menu lives inside the wrap so
       position: absolute anchors above the button, same pattern as More.
       Previously the menu rendered in Map.razor with a fixed left: 12px
       which put it under More on the left edge of the bar rather than
       above the Add button.

       Route lives inside this menu rather than as its own top-level
       button -- the bar was getting crowded and "add a new thing to
       the map" is the shared conceptual bucket. The route icon on the
       Add button gets an `.active` modifier during edit so the user
       sees the in-progress state without opening the menu. *@
    <div class="ctrl-more-wrap ctrl-btn-overflow">
        <button class="ctrl-btn @(FabMenuOpen || RouteEditMode ? "active" : "")" @onclick="OnToggleFab"
                title="@(RouteEditMode ? "Editing a route -- see the panel above" : "Add waypoint / note / region / route at map centre")">
            <span class="ctrl-ico">@((MarkupString)Icons.Plus)</span>
            <span class="ctrl-lbl">Add</span>
        </button>
        @if (FabMenuOpen)
        {
            <div class="ctrl-more-menu" @onclick:stopPropagation>
                <button class="ctrl-more-item" @onclick="() => SelectFab(OnFabCreateWaypoint)">
                    <span class="ctrl-more-ico">&#9675;</span>
                    <span>Waypoint</span>
                </button>
                <button class="ctrl-more-item" @onclick="() => SelectFab(OnFabCreateNote)">
                    <span class="ctrl-more-ico">&#9783;</span>
                    <span>Note</span>
                </button>
                <button class="ctrl-more-item" @onclick="() => SelectFab(OnFabCreateRegion)">
                    <span class="ctrl-more-ico">&#9711;</span>
                    <span>Region</span>
                </button>
                <button class="ctrl-more-item @(RouteEditMode ? "active" : "")"
                        @onclick="() => SelectFab(OnStartRouteEdit)"
                        disabled="@RouteEditMode"
                        title="@(RouteEditMode ? "Already editing a route" : "Start a new route -- tap the map to add waypoints")">
                    <span class="ctrl-more-ico">@((MarkupString)Icons.Route)</span>
                    <span>Route</span>
                </button>
                <small class="map-fab-hint">target: map centre</small>
            </div>
        }
    </div>
    @* Measure sits immediately right of Add: helm asked for it next to
       the create-bucket since both are "shape work I'm doing on the
       chart". Was previously between Follow and Centre, where it
       interrupted the navigation grouping. No `ctrl-btn-overflow` --
       Measure earns a permanent bar slot on every viewport (the More
       menu's phone-overflow Measure entry is gone too). *@
    <button class="ctrl-btn @(MeasureActive ? "active" : "")"
            @onclick="OnToggleMeasure"
            title="Measure distance + bearing (D)">
        <span class="ctrl-ico">@((MarkupString)Icons.Measure)</span>
        <span class="ctrl-lbl">Measure</span>
    </button>
    @if (SailingMode == "race" || RaceTimerActive)
    {
        <button class="ctrl-btn @(RaceTimerActive ? "active" : "")" @onclick="OnToggleRaceTimer" title="Race timer (R)">
            <span class="ctrl-ico">@((MarkupString)Icons.Flag)</span>
            <span class="ctrl-lbl">@(RaceTimerActive ? RaceTimerLabel : "Race")</span>
        </button>
    }

    <div class="ctrl-sep"></div>

    <button class="ctrl-btn @(LayersPanelOpen ? "active" : "")" @onclick="OnToggleLayers"
            title="Layers panel">
        <span class="ctrl-ico">@((MarkupString)Icons.Layers)</span>
        <span class="ctrl-lbl">Layers</span>
    </button>
</div>

@* Full-screen backdrop for outside-click dismissal. Lives outside
   .map-controls so it isn't clipped by the bar's overflow. *@
@if (MoreMenuOpen)
{
    <div class="ctrl-more-backdrop" @onclick="CloseMoreMenu"></div>
}

@code {
    [Parameter] public bool Follow { get; set; }
    [Parameter] public string OrientationLabel { get; set; } = "N\u2191";
    [Parameter] public bool NightMode { get; set; }
    [Parameter] public bool AnchorActive { get; set; }
    [Parameter] public bool MobActive { get; set; }

    /// <summary>True when a route / destination is currently active.
    /// Controls visibility of the Stop Navigation button; without it,
    /// the button appears permanently even when there's nothing to
    /// stop, which looks broken. Wired from
    /// <c>SignalkClient.Data.HasActiveCourse</c>.</summary>
    [Parameter] public bool RouteNavigating { get; set; }
    [Parameter] public bool HarborMode { get; set; }
    [Parameter] public bool MeasureActive { get; set; }
    [Parameter] public bool RouteEditMode { get; set; }
    [Parameter] public bool RaceTimerActive { get; set; }
    [Parameter] public string RaceTimerLabel { get; set; } = "";
    [Parameter] public bool LayersPanelOpen { get; set; }
    [Parameter] public bool LegendOpen { get; set; }
    [Parameter] public bool FabMenuOpen { get; set; }
    [Parameter] public string SailingMode { get; set; } = "cruise";

    [Parameter] public EventCallback OnToggleFollow { get; set; }
    [Parameter] public EventCallback OnCycleOrientation { get; set; }
    [Parameter] public EventCallback OnToggleNight { get; set; }
    [Parameter] public EventCallback OnToggleAnchor { get; set; }
    [Parameter] public EventCallback OnToggleMob { get; set; }
    [Parameter] public EventCallback OnStopNavigation { get; set; }
    [Parameter] public EventCallback OnZoomToTrack { get; set; }
    [Parameter] public EventCallback OnCentreOnBoat { get; set; }
    [Parameter] public EventCallback OnToggleHarborMode { get; set; }
    [Parameter] public EventCallback OnToggleMeasure { get; set; }
    [Parameter] public EventCallback OnStartRouteEdit { get; set; }
    [Parameter] public EventCallback OnToggleRaceTimer { get; set; }
    [Parameter] public EventCallback OnToggleLayers { get; set; }
    [Parameter] public EventCallback OnToggleLegend { get; set; }
    /// <summary>Open the keyboard-shortcuts overlay. Wired to a More-
    /// menu row so touch users (no keyboard "?" affordance) can
    /// surface the shortcuts list at all.</summary>
    [Parameter] public EventCallback OnShowShortcuts { get; set; }
    [Parameter] public EventCallback OnToggleFab { get; set; }
    [Parameter] public EventCallback OnFabCreateWaypoint { get; set; }
    [Parameter] public EventCallback OnFabCreateNote { get; set; }
    [Parameter] public EventCallback OnFabCreateRegion { get; set; }
    [Parameter] public EventCallback OnToggleDarkOps { get; set; }
    /// <summary>When true, render the inline "(L)" / "(D)" shortcut
    /// letters on button labels. Driven by IAppSettings.ShowKeyboardHints;
    /// default off since most users are on touch and don't see them.</summary>
    [Parameter] public bool ShowKeyboardHints { get; set; }

    // Two-step confirm for destructive actions in the control bar
    // (Stop-Navigation + MOB-clear + Anchor-raise). First tap arms;
    // second tap within ConfirmWindowMs invokes. A rolling cockpit or
    // pocket brush shouldn't silently kill navigation, clear a live
    // MOB mark, or raise the anchor watch.
    private bool stopConfirming;
    private bool mobClearConfirming;
    private bool anchorClearConfirming;
    private System.Threading.Timer? stopConfirmTimer;
    private System.Threading.Timer? mobConfirmTimer;
    private System.Threading.Timer? anchorConfirmTimer;
    /// <summary>Two-step confirm window for the destructive bar
    /// buttons (Stop-Navigation, MOB-clear, Anchor-raise). Drives
    /// the C# timer AND the CSS countdown bar via a custom property
    /// passed inline as --confirm-window so the visual countdown
    /// reaches zero at the exact moment the timer fires.</summary>
    private const int ConfirmWindowMs = 3000;

    private async Task OnStopClicked()
    {
        if (stopConfirming)
        {
            stopConfirming = false;
            stopConfirmTimer?.Dispose();
            stopConfirmTimer = null;
            await OnStopNavigation.InvokeAsync();
            return;
        }
        stopConfirming = true;
        stopConfirmTimer?.Dispose();
        stopConfirmTimer = new System.Threading.Timer(_ =>
        {
            stopConfirming = false;
            _ = InvokeAsync(StateHasChanged);
        }, null, ConfirmWindowMs, Timeout.Infinite);
    }

    private async Task OnAnchorClicked()
    {
        // Drop is unconfirmed (one tap); raise requires arm + confirm
        // because a glove-brush on the button while moored in heavy
        // weather would otherwise silently clear the drift alarm.
        if (!AnchorActive)
        {
            await OnToggleAnchor.InvokeAsync();
            return;
        }
        if (anchorClearConfirming)
        {
            anchorClearConfirming = false;
            anchorConfirmTimer?.Dispose();
            anchorConfirmTimer = null;
            await OnToggleAnchor.InvokeAsync();
            return;
        }
        anchorClearConfirming = true;
        anchorConfirmTimer?.Dispose();
        anchorConfirmTimer = new System.Threading.Timer(_ =>
        {
            anchorClearConfirming = false;
            _ = InvokeAsync(StateHasChanged);
        }, null, ConfirmWindowMs, Timeout.Infinite);
    }

    private async Task OnMobClicked()
    {
        // First-drop is unconfirmed: in a real MOB event every second
        // matters and forcing a second tap could cost a life. The
        // confirm kicks in only when we're CLEARING an already-active
        // MOB (the accidental-tap risk scenario).
        if (!MobActive)
        {
            await OnToggleMob.InvokeAsync();
            return;
        }
        if (mobClearConfirming)
        {
            mobClearConfirming = false;
            mobConfirmTimer?.Dispose();
            mobConfirmTimer = null;
            await OnToggleMob.InvokeAsync();
            return;
        }
        mobClearConfirming = true;
        mobConfirmTimer?.Dispose();
        mobConfirmTimer = new System.Threading.Timer(_ =>
        {
            mobClearConfirming = false;
            _ = InvokeAsync(StateHasChanged);
        }, null, ConfirmWindowMs, Timeout.Infinite);
    }

    // Dot indicator on the More button when any of its contents is on,
    // so Night / Harbor being active is visible without opening the
    // menu. Measure used to be in this list, but it now lives on the
    // bar (right of Add) on every viewport size; the bar button itself
    // shows the active state, so the More dot would be misleading.
    // Harbor mode IS in the list -- the helm needs to see at a glance
    // "alarms are suppressed" so a forgotten Harbor mode doesn't ride
    // into open water. Laylines moved to the Layers panel under the
    // master "Show ship lines" toggle so they're no longer here.
    private bool AnyMoreItemActive => NightMode || HarborMode;

    // Dynamic tooltip: when items are active it reads "More (on:
    // Night, Harbor)" so the dot badge's meaning is discoverable on
    // hover / keyboard focus without opening the menu.
    private string MoreButtonTitle
    {
        get
        {
            var on = new List<string>(2);
            if (NightMode) on.Add("Night");
            if (HarborMode) on.Add("Harbor");
            return on.Count == 0
                ? "More: Legend, Night, Harbor, Orient"
                : "More (on: " + string.Join(", ", on) + ")";
        }
    }

    // --- More overflow menu ---
    // MoreMenuOpen is now owned by the parent (Map.razor) so the three
    // bottom-bar flyouts (More / Add / Layers) can be mutually
    // exclusive -- opening one must close the others. The parent
    // routes the tap through OnToggleMore, which flips the flag and
    // closes the siblings.
    [Parameter] public bool MoreMenuOpen { get; set; }
    [Parameter] public EventCallback OnToggleMore { get; set; }

    private Task ToggleMoreMenu() => OnToggleMore.InvokeAsync();
    private Task CloseMoreMenu() => OnToggleMore.InvokeAsync();

    private async Task Select(EventCallback cb)
    {
        // Closing is still the parent's job; fire the toggle callback
        // so the parent flips MoreMenuOpen off before the action runs.
        if (MoreMenuOpen) await OnToggleMore.InvokeAsync();
        await cb.InvokeAsync();
    }

    /// <summary>
    /// Same Select() pattern but for local methods that aren't EventCallback
    /// parameters (Anchor / MOB live here because they own the two-step
    /// confirm state). Lets More-menu items reuse the close-then-invoke
    /// flow without duplicating the closing logic per call site.
    /// </summary>
    private async Task Select(Func<Task> action)
    {
        if (MoreMenuOpen) await OnToggleMore.InvokeAsync();
        await action();
    }

    // Close the Add flyout then invoke the picked action. The owner toggles
    // FabMenuOpen but we can't flip it here (it's a [Parameter]), so we rely
    // on the callback's own handler to set FabMenuOpen = false on Map.razor.
    private async Task SelectFab(EventCallback cb) => await cb.InvokeAsync();

    // --- Night-button long-press for Dark Ops -----------------------
    // 700 ms matches the long-press envelope used elsewhere. The hold
    // runs inside the More menu, because that's where Night now lives.
    // _nightHoldFired guards the click handler from toggling Night on
    // top of the dark-ops flip.
    private const int NightHoldMs = 700;
    private CancellationTokenSource? _nightHoldCts;
    private bool _nightHoldFired;

    private void StartNightHold()
    {
        // Dispose the prior CTS, don't just cancel-and-drop; matches the
        // fix for MainLayout's _alarmHoldCts so we don't leak a token
        // allocation on repeated presses.
        if (_nightHoldCts is { } prev)
        {
            prev.Cancel();
            prev.Dispose();
        }
        _nightHoldCts = new CancellationTokenSource();
        _nightHoldFired = false;
        _ = RunNightHoldAsync(_nightHoldCts.Token);
    }

    private async Task RunNightHoldAsync(CancellationToken ct)
    {
        try
        {
            await Task.Delay(NightHoldMs, ct);
            if (ct.IsCancellationRequested) return;
            _nightHoldFired = true;
            // MoreMenuOpen is parent-owned; writing it directly would
            // be overwritten on the next parent render and Blazor logs
            // a warning. Route through OnToggleMore instead so the
            // parent flips its own field. The hold only fires while
            // the menu is open, so toggling closes it.
            if (MoreMenuOpen) await OnToggleMore.InvokeAsync();
            await OnToggleDarkOps.InvokeAsync();
        }
        catch (OperationCanceledException) { }
    }

    private void EndNightHold()
    {
        if (_nightHoldCts is { } cts)
        {
            cts.Cancel();
            cts.Dispose();
            _nightHoldCts = null;
        }
    }

    private async Task NightClicked()
    {
        if (_nightHoldFired)
        {
            _nightHoldFired = false;
            return;
        }
        // Route close through the parent toggle so the [Parameter]
        // stays the source of truth. Mirrors Select(EventCallback).
        if (MoreMenuOpen) await OnToggleMore.InvokeAsync();
        await OnToggleNight.InvokeAsync();
    }

    /// <summary>Dispose the three confirm-window timers when the
    /// component unmounts. Without this, a navigation away during
    /// an active 3 s confirm window would leave the timer running
    /// and its callback would race InvokeAsync(StateHasChanged)
    /// against a disposed component.</summary>
    public void Dispose()
    {
        stopConfirmTimer?.Dispose();
        mobConfirmTimer?.Dispose();
        anchorConfirmTimer?.Dispose();
        _nightHoldCts?.Cancel();
        _nightHoldCts?.Dispose();
    }
}
