@* Modal card listing every keyboard shortcut wired in
   wwwroot/js/leafletInterop.js (letter set + arrow handler) and
   Map.razor's OnKeyShortcut switch. Dismissed by clicking outside or
   pressing Esc. Keep the rows in sync with both sources; the letter
   set in leafletInterop.js gates which keys ever reach .NET, so any
   row added here without a matching entry there is a lie. *@

<div class="shortcuts-overlay" @onclick="OnDismiss">
    <div class="shortcuts-card" @onclick:stopPropagation>
        <h5>Keyboard Shortcuts</h5>
        <div class="shortcuts-grid">
            <kbd>F</kbd><span>Toggle follow</span>
            <kbd>O</kbd><span>Cycle orientation</span>
            <kbd>N</kbd><span>Night mode</span>
            <kbd>A</kbd><span>Anchor watch</span>
            <kbd>M</kbd><span>Man overboard</span>
            <kbd>T</kbd><span>Fit track</span>
            <kbd>L</kbd><span>Show laylines</span>
            <kbd>D</kbd><span>Measure (distance / bearing)</span>
            <kbd>R</kbd><span>Race timer</span>
            <kbd>?</kbd><span>Show this card</span>
            <kbd>Esc</kbd><span>Dismiss / cancel current edit</span>
            @* Combo cells: wrap multi-key chords in .kbd-combo so the
               grid's 2-column layout still sees one entry per row. *@
            <span class="kbd-combo"><kbd>&larr;</kbd><kbd>&uarr;</kbd><kbd>&darr;</kbd><kbd>&rarr;</kbd></span>
            <span>Pan chart (1/5 viewport)</span>
            <span class="kbd-combo"><kbd>Shift</kbd>+<kbd>&larr;</kbd><kbd>&uarr;</kbd><kbd>&darr;</kbd><kbd>&rarr;</kbd></span>
            <span>Pan chart (full viewport)</span>
        </div>
        <div class="shortcuts-hint">
            Right-click or long-press the chart: context menu (Navigate, Measure to/from here, Add waypoint).<br />
            Hold the on-screen Danger banner (or hold <kbd>Space</kbd> / <kbd>Enter</kbd> on a focused banner) to dismiss the alarm.
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public EventCallback OnDismiss { get; set; }
}
