@using OnaPlotter.Models
@using OnaPlotter.Utilities
@using OnaPlotter.Services
@using OnaPlotter.Services.Api

@* All the floating HUD panels overlaid on the map:
   top-left (speed/course/position), top-right (wind), bottom-left (depth),
   bottom-right (heading compass), centered-top route panel, anchor watch,
   and autopilot control. All purely data-driven; state lives in the parent. *@

@* === Top-Left: Speed (primary), Course, Position ===
   Click to expand with VMG / XTE (when an active course exists) and a
   DMS-formatted position below the decimal one. The panel stays docked
   in its corner; only its height grows, which avoids shoving the map
   controls around. *@
<div class="hud hud-top-left">
    <div class="hud-panel @(IsExpanded("tl") ? "hud-panel-expanded" : "")"
         role="button" tabindex="0"
         aria-expanded="@(IsExpanded("tl") ? "true" : "false")"
         aria-label="Speed, course, position -- click for more detail"
         @onclick='() => ToggleExpanded("tl")' @onclick:stopPropagation
         @onkeydown='e => OnHudKeyDown(e, "tl")'
         title="Click for more detail">
        <div class="hud-label">SOG</div>
        <div class="hud-value hud-primary">@Format.Speed(Data.SpeedOverGround)<span class="hud-unit">kn</span></div>
        <div class="hud-label" style="margin-top:4px;">COG</div>
        <div class="hud-value">@Format.Degrees(Data.CourseOverGround)<span class="hud-unit">&deg;</span></div>
        @* Compact view stacks lat/lon on two lines so the HUD doesn't
           stretch across half the top edge. Expanded view keeps them
           on one line (the panel is already wider by that point, and
           the single-line form reads faster alongside the DMS row). *@
        @if (IsExpanded("tl"))
        {
            <div class="hud-position">@NauticalFormat.FormatPosition(Data.Latitude, Data.Longitude)</div>
        }
        else
        {
            <div class="hud-position hud-position-stacked">
                <div>@NauticalFormat.FormatLat(Data.Latitude)</div>
                <div>@NauticalFormat.FormatLon(Data.Longitude)</div>
            </div>
        }
        @if (IsExpanded("tl"))
        {
            <div class="hud-extra">
                @if (PositionDms is not null)
                {
                    <div class="hud-extra-row">
                        <span class="hud-extra-k">DMS</span>
                        <span class="hud-extra-v">@PositionDms</span>
                    </div>
                }
                @if (Data.CourseNextPointVmg is not null)
                {
                    <div class="hud-extra-row">
                        <span class="hud-extra-k">VMG</span>
                        <span class="hud-extra-v">@Format.Speed(Data.CourseNextPointVmg)<span class="hud-unit">kn</span></span>
                    </div>
                }
                @if (Data.CrossTrackError is not null)
                {
                    <div class="hud-extra-row">
                        <span class="hud-extra-k">XTE</span>
                        <span class="hud-extra-v @Format.XteClass(Data.CrossTrackError)">@Format.Xte(Data.CrossTrackError)</span>
                    </div>
                }
                @if (LeewayDeg is int lw)
                {
                    <div class="hud-extra-row" title="COG - HDG. Positive = boat drifting to starboard.">
                        <span class="hud-extra-k">Drift</span>
                        <span class="hud-extra-v">@(lw > 0 ? "+" : "")@lw&deg;</span>
                    </div>
                }
            </div>
        }
    </div>
</div>

@* === Top-Right: Wind (apparent + true when available) ===
   Expanded: port/starboard-labelled angles, TWD absolute from north,
   Beaufort labels for the speeds. *@
<div class="hud hud-top-right">
    <div class="hud-panel @(IsExpanded("tr") ? "hud-panel-expanded" : "")"
         style="text-align:center;"
         role="button" tabindex="0"
         aria-expanded="@(IsExpanded("tr") ? "true" : "false")"
         aria-label="Wind -- click for more detail"
         @onclick='() => ToggleExpanded("tr")' @onclick:stopPropagation
         @onkeydown='e => OnHudKeyDown(e, "tr")'
         title="Click for more detail">
        <div class="hud-label">AWA / AWS</div>
        @if (Data.WindSpeedApparent is not null)
        {
            <svg width="48" height="48" viewBox="-24 -24 48 48" class="wind-arrow"
                 style="transform: rotate(@WindAngleDegStr);" role="img" aria-label="Apparent wind">
                <circle cx="0" cy="0" r="22" fill="none" stroke="rgba(255,255,255,0.15)" stroke-width="1"/>
                <polygon points="0,-20 4,-8 0,-12 -4,-8" fill="#3b82f6" stroke="none"/>
            </svg>
            <div class="hud-value" style="font-size:1.1rem;">@Format.Speed(Data.WindSpeedApparent)<span class="hud-unit">kn</span></div>
        }
        else
        {
            <div style="color: rgba(255,255,255,0.25); font-size:0.8rem; padding: 4px 0;">--</div>
        }
        @if (Data.WindSpeedTrue is not null)
        {
            <div style="margin-top:4px; border-top:1px solid rgba(255,255,255,0.1); padding-top:4px;">
                <div class="hud-label">TWA / TWS</div>
                <svg width="36" height="36" viewBox="-18 -18 36 36" class="wind-arrow"
                     style="transform: rotate(@TrueWindAngleDegStr);" role="img" aria-label="True wind">
                    <circle cx="0" cy="0" r="16" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="1"/>
                    <polygon points="0,-14 3,-6 0,-9 -3,-6" fill="#22c55e" stroke="none"/>
                </svg>
                <div class="hud-value" style="font-size:1rem;">@Format.Speed(Data.WindSpeedTrue)<span class="hud-unit">kn</span></div>
            </div>
        }
        @if (IsExpanded("tr"))
        {
            <div class="hud-extra">
                @if (SignedAwa is string awa)
                {
                    <div class="hud-extra-row">
                        <span class="hud-extra-k">AWA</span>
                        <span class="hud-extra-v">@awa</span>
                    </div>
                }
                @if (SignedTwa is string twa)
                {
                    <div class="hud-extra-row">
                        <span class="hud-extra-k">TWA</span>
                        <span class="hud-extra-v">@twa</span>
                    </div>
                }
                @if (Data.WindDirectionTrue is not null)
                {
                    <div class="hud-extra-row" title="True wind direction (compass, from)">
                        <span class="hud-extra-k">TWD</span>
                        <span class="hud-extra-v">@Format.Degrees(Data.WindDirectionTrue)&deg;</span>
                    </div>
                }
                @if (BeaufortLabel(Data.WindSpeedTrue ?? Data.WindSpeedApparent) is string bf)
                {
                    <div class="hud-extra-row" title="Beaufort scale for true wind">
                        <span class="hud-extra-k">Bft</span>
                        <span class="hud-extra-v">@bf</span>
                    </div>
                }
            </div>
        }
    </div>
</div>

@* === Bottom-Left: Depth (+ tide when a plugin feeds it) === *@
@* Tide was a separate HUD card above depth; merging because they answer
   the same question from a sailor's point of view -- water under the
   boat NOW (depth) and where it's heading (tide). Depth alarm threshold
   still lives here; a tide row appears only when the plugin publishes. *@
<div class="hud hud-bottom-left">
    <div class="hud-panel @(IsExpanded("bl") ? "hud-panel-expanded" : "")"
         role="button" tabindex="0"
         aria-expanded="@(IsExpanded("bl") ? "true" : "false")"
         aria-label="Depth and tide -- click for more detail"
         @onclick='() => ToggleExpanded("bl")' @onclick:stopPropagation
         @onkeydown='e => OnHudKeyDown(e, "bl")'
         title="Click for more detail">
        <div class="hud-label">
            Depth
            @{
                var depthFreshness = Data.FreshnessOf(Data.DepthUpdatedUtc);
            }
            @if (depthFreshness == FieldFreshness.Stale)
            {
                <span class="hud-stale-badge" title="Depth not updated in &gt;10s">stale</span>
            }
            else if (depthFreshness == FieldFreshness.Dead)
            {
                <span class="hud-stale-badge hud-dead-badge" title="Depth sensor silent for &gt;30s -- do not rely on this reading">dead</span>
            }
        </div>
        <div class="hud-value @Format.DepthClass(Data.Depth) @(depthFreshness == FieldFreshness.Dead ? "hud-value-dead" : "")">@Format.Depth(Data.Depth)<span class="hud-unit">m</span>@if (IsBelowDepthThreshold)
            {
                @* Non-colour signal: below-threshold depth gets a warning
                   glyph that colour-blind sailors can read. Paired with the
                   traffic-light colouring so both channels carry the signal. *@
                <span class="depth-warn-glyph" aria-label="depth below alarm threshold">&#9888;</span>
            }@if (IsExpanded("bl") && FormatDepthTrend() is string trendLabel)
            {
                @* Trend arrow is only meaningful when the user has room
                   to parse it -- compact card stays to just "depth &
                   threshold" so the number stays big. Press / click the
                   card to expand and the trend arrow + m/min rate join
                   the depth reading in-line. *@
                <span class="depth-trend @DepthTrendClass()"
                      title="1-minute average change">@((MarkupString)trendLabel)</span>
            }</div>
        @if (DepthAlarmThreshold > 0)
        {
            <div class="hud-threshold @(IsBelowDepthThreshold ? "threshold-active" : "")"
                 title="Depth alarm threshold (from Settings)">
                alarm &lt;@DepthAlarmThreshold.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)m
            </div>
        }
        @if (HasTideData && NextExtreme is var (label, height, time))
        {
            <div class="depth-tide-row"
                 title="@(string.IsNullOrWhiteSpace(Data.TideStationName) ? "Tide" : $"Tide -- {Data.TideStationName}")">
                <span class="depth-tide-arrow"
                      aria-label="@TideDirectionLabel">@TideArrow</span>
                <span class="depth-tide-label">@label</span>
                <span class="depth-tide-time">@FormatInterval(time)</span>
                <span class="depth-tide-height">
                    @height.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)m
                </span>
            </div>
        }
        @if (IsExpanded("bl"))
        {
            <div class="hud-extra">
                @if (Data.TideHeightNow is double th)
                {
                    <div class="hud-extra-row">
                        <span class="hud-extra-k">Tide now</span>
                        <span class="hud-extra-v">@th.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)<span class="hud-unit">m</span></span>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(Data.TideStationName))
                {
                    <div class="hud-extra-row">
                        <span class="hud-extra-k">Station</span>
                        <span class="hud-extra-v">@Data.TideStationName</span>
                    </div>
                }
                @if (Data.CurrentDrift is double drift && Data.CurrentSet is double set)
                {
                    <div class="hud-extra-row" title="Tidal-current set (direction) and drift (speed)">
                        <span class="hud-extra-k">Current</span>
                        <span class="hud-extra-v">
                            @((drift * Format.MsToKnots).ToString("F1", System.Globalization.CultureInfo.InvariantCulture))<span class="hud-unit">kn</span>
                            &nbsp;@Format.Degrees(set)<span class="hud-unit">&deg;</span>
                        </span>
                    </div>
                }
                @if (HasTideData)
                {
                    <div class="hud-extra-row">
                        <span class="hud-extra-k">Phase</span>
                        <span class="hud-extra-v">@TideDirectionLabel</span>
                    </div>
                }
            </div>
        }
    </div>
</div>

@* === Race HUD (race mode + polar + wind; otherwise hidden) ===
   Compact performance card: current TWA, target boat speed from the
   polar, actual speed, optimal TWA for the current tack. Only shown
   in Race mode so cruisers don't get numbers they don't need, and
   only when the data behind each number is actually present (no
   polar -> card hidden; no wind -> hidden). *@
@if (ShowRacePanel)
{
    <div class="hud hud-race">
        <div class="hud-panel race-panel">
            <div class="hud-label">Race</div>
            @{
                int twaDeg = (int)Math.Round(Math.Abs(Data.WindAngleTrue!.Value * RadToDeg));
                double twsKn = Data.WindSpeedTrue!.Value * Format.MsToKnots;
                double? targetKn = Polar?.GetTargetSpeed(twaDeg, twsKn);
                double? actualKn = Data.SpeedOverGround.HasValue
                    ? Data.SpeedOverGround.Value * Format.MsToKnots : null;
                var opt = IsUpwind(twaDeg)
                    ? Polar?.GetOptimalUpwind(twsKn)
                    : Polar?.GetOptimalDownwind(twsKn);
                // Performance ratio used for the colour-coded class.
                double? perf = (targetKn is > 0 && actualKn is not null)
                    ? actualKn / targetKn.Value : null;
                string perfClass = perf switch
                {
                    null => "",
                    >= 0.95 => "depth-ok",
                    >= 0.80 => "depth-warn",
                    _       => "depth-danger",
                };
            }
            <div class="race-row">
                <span class="race-k">TWA</span>
                <span class="race-v">@twaDeg&deg;</span>
            </div>
            @if (targetKn is not null && actualKn is not null)
            {
                <div class="race-row">
                    <span class="race-k">Target</span>
                    <span class="race-v">@targetKn.Value.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)<span class="hud-unit">kn</span></span>
                </div>
                <div class="race-row @perfClass">
                    <span class="race-k">SOG</span>
                    <span class="race-v">@actualKn.Value.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)<span class="hud-unit">kn</span></span>
                    @if (perf is not null)
                    {
                        <span class="race-perf">@((perf.Value * 100).ToString("F0"))%</span>
                    }
                </div>
            }
            @if (opt is { } o)
            {
                <div class="race-opt" title="@($"VMG {o.VmgKn:F1}kn @ {o.BspKn:F1}kn BSP")">
                    <span class="race-k">Opt TWA</span>
                    <span class="race-v">@((int)Math.Round(o.TwaDeg))&deg;</span>
                    <span class="race-opt-delta @OptDeltaClass(twaDeg, (int)Math.Round(o.TwaDeg))">
                        @FormatOptDelta(twaDeg, (int)Math.Round(o.TwaDeg))
                    </span>
                </div>
            }
        </div>
    </div>
}

@* === Bottom-Right: Heading compass ===
   Expanded: COG next to HDG and their signed delta (boat's apparent
   leeway/drift angle), plus the autopilot target heading when the
   autopilot is engaged. *@
<div class="hud hud-bottom-right">
    <div class="hud-panel @(IsExpanded("br") ? "hud-panel-expanded" : "")"
         style="text-align:center;"
         role="button" tabindex="0"
         aria-expanded="@(IsExpanded("br") ? "true" : "false")"
         aria-label="Heading compass -- click for more detail"
         @onclick='() => ToggleExpanded("br")' @onclick:stopPropagation
         @onkeydown='e => OnHudKeyDown(e, "br")'
         title="Click for more detail">
        <div class="hud-label">HDG</div>
        <svg width="52" height="52" viewBox="-26 -26 52 52">
            <circle cx="0" cy="0" r="24" fill="none" stroke="rgba(255,255,255,0.15)" stroke-width="1"/>
            @SvgText(0, -18, "N", "rgba(255,255,255,0.5)", 7)
            @SvgText(18, 0, "E", "rgba(255,255,255,0.3)", 7)
            @SvgText(0, 19, "S", "rgba(255,255,255,0.3)", 7)
            @SvgText(-18, 0, "W", "rgba(255,255,255,0.3)", 7)
            @* Needle shape: wide arrowhead forward, short tail. Rotated as a
               whole so the pointer always tracks heading. *@
            <g class="compass-rose" style="transform: rotate(@HeadingDegStr);">
                <polygon points="0,-20 5,-6 0,-10 -5,-6" fill="#60a5fa" stroke="none"/>
                <polygon points="0,12 3,4 0,6 -3,4" fill="rgba(96,165,250,0.5)" stroke="none"/>
            </g>
            <circle cx="0" cy="0" r="2.5" fill="#60a5fa"/>
        </svg>
        @* Suffix T or M so the helm knows which reference the number
           is in. With 15° magnetic variation in some cruising grounds
           that's the difference between the rocks and the channel.
           Derived from PreferMagneticHeading so the label always
           matches the value actually being displayed. *@
        <div class="hud-value" style="font-size:1.1rem;">@Format.Degrees(Data.Heading)<span class="hud-unit">&deg;@(Data.Heading is null ? "" : (Data.PreferMagneticHeading ? "M" : "T"))</span></div>
        @if (IsExpanded("br"))
        {
            <div class="hud-extra">
                @if (Data.CourseOverGround is not null)
                {
                    <div class="hud-extra-row">
                        <span class="hud-extra-k">COG</span>
                        <span class="hud-extra-v">@Format.Degrees(Data.CourseOverGround)<span class="hud-unit">&deg;@(Data.PreferMagneticCourse ? "M" : "T")</span></span>
                    </div>
                }
                @if (LeewayDeg is int lw)
                {
                    <div class="hud-extra-row" title="Signed delta between COG and HDG; rough leeway indicator.">
                        <span class="hud-extra-k">Drift</span>
                        <span class="hud-extra-v">@(lw > 0 ? "+" : "")@lw&deg;</span>
                    </div>
                }
                @if (Data.AutopilotState is { } ap)
                {
                    <div class="hud-extra-row">
                        <span class="hud-extra-k">AP</span>
                        <span class="hud-extra-v">@ap.ToUpperInvariant()</span>
                    </div>
                    @* Target is mode-specific: wind mode tracks an AWA
                       target (-port / +stbd), other modes use a true
                       heading. Prefer the wind target whenever present
                       so a helm running in wind mode doesn't see a
                       stale heading target from a previous leg. *@
                    @if (string.Equals(ap, "wind", StringComparison.OrdinalIgnoreCase)
                         && Data.AutopilotTargetWindAngle is double twa)
                    {
                        <div class="hud-extra-row" title="Target apparent wind angle">
                            <span class="hud-extra-k">AP TWA</span>
                            <span class="hud-extra-v">@FormatTwa(twa)<span class="hud-unit">&deg;</span></span>
                        </div>
                    }
                    else if (Data.AutopilotTargetHeading is not null)
                    {
                        <div class="hud-extra-row">
                            <span class="hud-extra-k">AP tgt</span>
                            <span class="hud-extra-v">@Format.Degrees(Data.AutopilotTargetHeading)<span class="hud-unit">&deg;</span></span>
                        </div>
                    }
                    @* Heading error: signed delta between target heading
                       and current heading, shortest way round. Only shown
                       when both are available AND we're not in wind mode
                       (where the target is an AWA, not a compass course). *@
                    @if (HeadingErrorDeg is int err)
                    {
                        <div class="hud-extra-row" title="Target heading minus current heading (shortest way round)">
                            <span class="hud-extra-k">HDG err</span>
                            <span class="hud-extra-v">@(err > 0 ? "+" : "")@err<span class="hud-unit">&deg;</span></span>
                        </div>
                    }
                    @if (Data.RudderAngle is double rud)
                    {
                        <div class="hud-extra-row" title="Rudder angle, negative = port">
                            <span class="hud-extra-k">Rudder</span>
                            <span class="hud-extra-v">@FormatRudder(rud)<span class="hud-unit">&deg;</span></span>
                        </div>
                    }
                }
            </div>
        }
    </div>
</div>

@* Route and anchor cards are extracted as child components so only
   the section whose data actually changed re-renders. Both take a
   record-struct snapshot; Blazor skips the render when the snapshot
   is equal to the previous render. See HudRouteCard / HudAnchorCard
   for the rationale + field lists. *@
<OnaPlotter.Components.Map.Hud.HudRouteCard
    Snapshot="@BuildRouteSnapshot()" />

<OnaPlotter.Components.Map.Hud.HudAnchorCard
    Snapshot="@BuildAnchorSnapshot()"
    OnSetRadius="OnSetAnchorRadius" />

@* === Autopilot control === *@
@* Off by default (Settings.ShowAutopilotHud). The extended HDG HUD
   above already shows AP state / target / rudder; this panel adds
   tappable engage + heading-nudge controls that deserve an explicit
   opt-in per user feedback (accidental taps on a touch device). *@
@if (ShowAutopilotHud && Data.AutopilotState is not null)
{
    <div class="hud hud-autopilot">
        <div class="hud-panel autopilot-panel @(Data.AutopilotState != "standby" ? "ap-engaged" : "")">
            <div class="hud-label">Autopilot</div>
            <div class="ap-state">@(Data.AutopilotState?.ToUpperInvariant() ?? "--")</div>
            @if (Data.AutopilotTargetHeading is not null)
            {
                <div class="hud-value route-value" style="font-size:1.1rem;">
                    @Format.Degrees(Data.AutopilotTargetHeading)<span class="hud-unit">&deg;</span>
                </div>
            }
            <div class="ap-controls">
                <button class="ap-btn" @onclick='() => Autopilot.AdjustHeadingAsync(-10)'>-10</button>
                <button class="ap-btn" @onclick='() => Autopilot.AdjustHeadingAsync(-1)'>-1</button>
                <button class="ap-btn" @onclick='() => Autopilot.AdjustHeadingAsync(1)'>+1</button>
                <button class="ap-btn" @onclick='() => Autopilot.AdjustHeadingAsync(10)'>+10</button>
            </div>
            @* Engaging the autopilot into any non-standby mode is potentially
               dangerous on a charter boat where crew can knock a button in
               passing. Stby stays an instant tap (that's the "safety"
               direction). Auto / Wind / Route require a 600 ms hold; an
               accidental tap does nothing. *@
            <div class="ap-modes">
                <button class="ap-mode-btn @(Data.AutopilotState == "standby" ? "active" : "")"
                        @onclick='() => Autopilot.SetStateAsync("standby")'>Stby</button>
                <button class="ap-mode-btn ap-engage-btn @(Data.AutopilotState == "auto" ? "active" : "") @(holding == "auto" ? "holding" : "")"
                        @onpointerdown='@(() => ApHoldStart("auto"))'
                        @onpointerup="ApHoldEnd" @onpointerleave="ApHoldEnd"
                        @onpointercancel="ApHoldEnd" title="Hold to engage Auto">Auto</button>
                <button class="ap-mode-btn ap-engage-btn @(Data.AutopilotState == "wind" ? "active" : "") @(holding == "wind" ? "holding" : "")"
                        @onpointerdown='@(() => ApHoldStart("wind"))'
                        @onpointerup="ApHoldEnd" @onpointerleave="ApHoldEnd"
                        @onpointercancel="ApHoldEnd" title="Hold to engage Wind">Wind</button>
                <button class="ap-mode-btn ap-engage-btn @(Data.AutopilotState == "route" ? "active" : "") @(holding == "route" ? "holding" : "")"
                        @onpointerdown='@(() => ApHoldStart("route"))'
                        @onpointerup="ApHoldEnd" @onpointerleave="ApHoldEnd"
                        @onpointercancel="ApHoldEnd" title="Hold to engage Route">Route</button>
            </div>
        </div>
    </div>
}

@code {
    private const double RadToDeg = 180.0 / Math.PI;

    [Parameter, EditorRequired] public NavigationData Data { get; set; } = null!;
    [Parameter, EditorRequired] public IAutopilotApi Autopilot { get; set; } = null!;

    /// <summary>Current heading in radians; used to draw the compass needle.</summary>
    [Parameter] public double? LastHeadingRad { get; set; }

    /// <summary>Set when the anchor alarm is dragging outside its max radius.</summary>
    [Parameter] public bool AnchorDragging { get; set; }

    /// <summary>Depth alarm threshold in metres. Rendered as a small
    /// "alarm <3.0m" label under the depth value so the captain knows
    /// exactly what number will trigger the audible alarm. 0 to hide.</summary>
    [Parameter] public double DepthAlarmThreshold { get; set; }

    /// <summary>True when the user dropped a manual anchor via the Anchor
    /// button (as opposed to the plugin-driven server-side alarm).
    /// Enables the inline radius chips.</summary>
    [Parameter] public bool ManualAnchorActive { get; set; }

    /// <summary>Current manual-anchor radius (metres). Shown on the HUD
    /// card and highlighted in the chip row.</summary>
    [Parameter] public double ManualAnchorRadiusMeters { get; set; } = 30;

    /// <summary>User's configured waypoint arrival radius in metres;
    /// 0 means the APPROACH alarm is disabled. Drives the route-card
    /// dormancy hint so a silent rule doesn't surprise the helm.</summary>
    [Parameter] public double WaypointArrivalRadiusMeters { get; set; } = 50;


    /// <summary>Invoked when the user picks a new radius from the inline
    /// chips. The caller persists it to IAppSettings and re-draws the
    /// anchor circle via JS.</summary>
    [Parameter] public EventCallback<double> OnSetAnchorRadius { get; set; }

    /// <summary>Signed depth trend in metres per minute over the last
    /// minute. Positive = getting deeper; negative = shallower. Null
    /// hides the trend glyph (no recent depth samples / plugin absent).</summary>
    [Parameter] public double? DepthTrendMetersPerMinute { get; set; }

    /// <summary>"cruise" or "race". Gates the race HUD card.</summary>
    [Parameter] public string SailingMode { get; set; } = "cruise";

    /// <summary>When true, render the dedicated Autopilot control card
    /// (engage modes + +/- heading nudges). When false, the extended
    /// HDG HUD still surfaces AP state / target / rudder so the helm
    /// can monitor the pilot; only the tappable controls are hidden.
    /// Defaults to false because the engage buttons are easy to fat-
    /// finger on a touch device.</summary>
    [Parameter] public bool ShowAutopilotHud { get; set; } = false;

    /// <summary>Polar service for target-speed + optimal-TWA lookup.
    /// Optional -- the race card hides when null or no polar is loaded.</summary>
    [Parameter] public IPolarService? Polar { get; set; }

    private bool IsBelowDepthThreshold =>
        Data.Depth is double d && DepthAlarmThreshold > 0 && d < DepthAlarmThreshold;

    // --- Depth trend glyph -------------------------------------------
    // Arrows (not colour) carry the main signal so a colour-blind
    // helmsman reads "deeper" / "shallower" at a glance. A small
    // threshold suppresses noise: rates under 0.05 m/min are just
    // transducer jitter at anchor, not a real trend.
    private string? FormatDepthTrend()
    {
        if (DepthTrendMetersPerMinute is not double mpm) return null;
        if (double.IsNaN(mpm) || double.IsInfinity(mpm)) return null;
        if (Math.Abs(mpm) < 0.05) return null;
        string arrow = mpm < 0 ? "\u2193" : "\u2191";          // ↓ ↑
        string mag = $"{Math.Abs(mpm):F1}";
        return $"<span class=\"depth-trend-arrow\">{arrow}</span>&thinsp;{mag}<span class=\"hud-unit\">m/min</span>";
    }

    // Shallower at a fast rate is the alarm-adjacent case; highlight it
    // amber to draw the helm's eye. Getting deeper is just information.
    private string DepthTrendClass()
    {
        if (DepthTrendMetersPerMinute is not double mpm) return "";
        if (mpm <= -0.3) return "depth-trend-warn";
        return "";
    }

    // --- HUD click-to-expand ----------------------------------------
    // Track at most one expanded panel at a time ("tl" / "tr" / "bl" /
    // "br"); clicking the same corner toggles it closed. Keeps the
    // decision point in one place so future expanded panels inherit
    // the "only one open" behaviour without extra wiring.
    private string? expandedHud;

    /// <summary>When true, every corner renders in its expanded state
    /// regardless of click. Driven by <c>IAppSettings.ExpandAllHud</c>
    /// via Map.razor so a wide helm screen uses its horizontal space
    /// for extra rows instead of hiding them behind a tap.</summary>
    [Parameter] public bool ExpandAllHud { get; set; }

    // Single source of truth for "is this corner showing its extras".
    // Global toggle wins over per-corner click state; that way enabling
    // ExpandAllHud while a corner is already open doesn't behave
    // differently from enabling it when everything is collapsed.
    private bool IsExpanded(string corner) =>
        ExpandAllHud || expandedHud == corner;

    private void ToggleExpanded(string corner)
    {
        // No-op while ExpandAllHud is on -- per-corner clicks would be
        // invisible (always expanded), so swallowing the toggle keeps
        // aria-expanded honest and avoids a state the operator can't
        // perceive.
        if (ExpandAllHud) return;
        expandedHud = expandedHud == corner ? null : corner;
    }

    // Keyboard parity with the mouse click. Enter / Space match the
    // implicit button behaviour; Esc collapses without swallowing.
    private void OnHudKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e, string corner)
    {
        switch (e.Key)
        {
            case "Enter":
            case " ":
                ToggleExpanded(corner);
                break;
            case "Escape":
                if (expandedHud == corner) expandedHud = null;
                break;
        }
    }

    // --- Expanded-panel data helpers --------------------------------
    // Position in degrees-minutes-seconds. Complements the decimal
    // format shown in the compact view -- some captains prefer DMS.
    private string? PositionDms
    {
        get
        {
            if (Data.Latitude is not double lat || Data.Longitude is not double lon) return null;
            return $"{ToDms(lat, true)} / {ToDms(lon, false)}";
        }
    }

    private static string ToDms(double value, bool isLatitude)
    {
        double abs = Math.Abs(value);
        int deg = (int)abs;
        double rem = (abs - deg) * 60;
        int min = (int)rem;
        double sec = (rem - min) * 60;
        string hemisphere = isLatitude
            ? (value >= 0 ? "N" : "S")
            : (value >= 0 ? "E" : "W");
        return $"{deg}\u00B0{min:D2}\u2032{sec:F1}\u2033 {hemisphere}";
    }

    // Apparent wind angle shown as "35\u00B0 STBD" / "90\u00B0 PORT". SignalK
    // publishes the angle in radians relative to bow (positive starboard).
    private string? SignedAwa => FormatSignedAngle(Data.WindAngleApparent);
    private string? SignedTwa => FormatSignedAngle(Data.WindAngleTrue);

    private static string? FormatSignedAngle(double? rad)
    {
        if (rad is not double v) return null;
        double deg = v * RadToDeg;
        string side = deg >= 0 ? "STBD" : "PORT";
        return $"{(int)Math.Round(Math.Abs(deg))}\u00B0 {side}";
    }

    // Leeway proxy: signed difference between COG and HDG, in degrees.
    // Positive means the boat's ground track is starboard of its heading
    // (wind / current pushing it right). Not a true leeway angle because
    // tidal current + windage both contribute; useful as an indicator.
    private int? LeewayDeg
    {
        get
        {
            if (Data.CourseOverGround is not double cog || Data.Heading is not double hdg) return null;
            double delta = (cog - hdg) * RadToDeg;
            // Normalise to [-180, 180].
            while (delta > 180) delta -= 360;
            while (delta < -180) delta += 360;
            // 1-degree threshold avoids jitter showing as "leeway" when
            // the boat is tracking its heading within sensor noise.
            int rounded = (int)Math.Round(delta);
            return Math.Abs(rounded) >= 1 ? rounded : null;
        }
    }

    // Autopilot heading error: signed shortest-way-round delta between
    // target heading and current heading, degrees. Null when either
    // input is missing, when the AP is in wind mode (target is an AWA,
    // not a compass course), or when the magnitude is below 1 deg
    // (sensor / digitisation noise). Consumed by the extended HDG HUD.
    private int? HeadingErrorDeg
    {
        get
        {
            if (Data.AutopilotState is null) return null;
            if (string.Equals(Data.AutopilotState, "wind", StringComparison.OrdinalIgnoreCase)) return null;
            if (Data.AutopilotTargetHeading is not double tgt || Data.Heading is not double hdg) return null;
            double delta = (tgt - hdg) * RadToDeg;
            while (delta > 180) delta -= 360;
            while (delta < -180) delta += 360;
            int rounded = (int)Math.Round(delta);
            return Math.Abs(rounded) >= 1 ? rounded : null;
        }
    }

    // Rudder angle formatter: signed degrees with a single decimal so
    // half-degree AP commands are readable. SignalK publishes rudder
    // as radians; negative = port per the spec, which matches the
    // convention most helms use ("-5 is 5 to port"). We keep the sign.
    private static string FormatRudder(double rad)
    {
        double deg = rad * RadToDeg;
        return deg.ToString("+0.0;-0.0;0", System.Globalization.CultureInfo.InvariantCulture);
    }

    // Target-AWA formatter: signed degrees, no leading zero. Positive =
    // starboard tack target, negative = port, matching the wind-data
    // convention used throughout the app.
    private static string FormatTwa(double rad)
    {
        double deg = rad * RadToDeg;
        return deg.ToString("+0;-0;0", System.Globalization.CultureInfo.InvariantCulture);
    }

    // Beaufort scale lookup for wind speed in m/s. Returns "F<n> <label>"
    // so a sailor can correlate measured speed with qualitative forecast
    // language. Returns null below the first scale break (Calm, <0.3 m/s)
    // so the row hides rather than shows "F0 Calm" on every sheltered
    // marina.
    private static string? BeaufortLabel(double? speedMs)
    {
        if (speedMs is not double s || double.IsNaN(s)) return null;
        return s switch
        {
            < 0.3  => null,             // Calm -- hide the row
            < 1.5  => "F1 Light air",
            < 3.3  => "F2 Light breeze",
            < 5.5  => "F3 Gentle",
            < 7.9  => "F4 Moderate",
            < 10.7 => "F5 Fresh",
            < 13.8 => "F6 Strong",
            < 17.1 => "F7 Near gale",
            < 20.7 => "F8 Gale",
            < 24.4 => "F9 Strong gale",
            < 28.4 => "F10 Storm",
            < 32.6 => "F11 Violent storm",
            _      => "F12 Hurricane",
        };
    }

    // --- Race HUD gating ---------------------------------------------
    private bool ShowRacePanel =>
        SailingMode == "race"
        && Polar is { HasPolar: true }
        && Data.WindAngleTrue.HasValue
        && Data.WindSpeedTrue.HasValue
        && Data.SpeedOverGround.HasValue;

    // Upwind = TWA closer to 0 than to 180. Simpler test than a fixed
    // threshold because "upwind" shifts with your polar: a modern
    // fractional rig goes upwind to 30 deg, a classic full-keeler
    // only to 45. <90 is the safe line.
    private static bool IsUpwind(int twaDeg) => twaDeg <= 90;

    /// <summary>Difference between actual TWA and optimal TWA as a
    /// signed angle + "PT/STB" compass direction for the needed tack.
    /// Zero means we're at the peak; positive means the optimal is a
    /// higher angle (bear away); negative means lower (head up).</summary>
    private static string FormatOptDelta(int actualTwa, int optTwa)
    {
        int delta = optTwa - actualTwa;
        if (delta == 0) return "on";
        return delta > 0 ? $"+{delta}\u00B0" : $"{delta}\u00B0";
    }

    private static string OptDeltaClass(int actualTwa, int optTwa)
    {
        int absDelta = Math.Abs(optTwa - actualTwa);
        if (absDelta <= 2) return "race-opt-on";
        if (absDelta <= 6) return "race-opt-near";
        return "race-opt-far";
    }

    // --- Tide ---------------------------------------------------------
    // True when at least the current height is published; lets the HUD
    // hide entirely on servers without a tide plugin rather than
    // showing an empty card.
    private bool HasTideData =>
        Data.TideHeightNow is not null
        || Data.TideTimeHigh is not null
        || Data.TideTimeLow is not null;

    /// <summary>The next high or low water, whichever comes first.
    /// Returns null when the tide plugin isn't publishing extremes yet.</summary>
    private (string Label, double Height, DateTime Time)? NextExtreme
    {
        get
        {
            var now = DateTime.UtcNow;
            DateTime? hi = Data.TideTimeHigh > now ? Data.TideTimeHigh : null;
            DateTime? lo = Data.TideTimeLow > now ? Data.TideTimeLow : null;
            if (hi is null && lo is null) return null;
            if (hi is not null && (lo is null || hi < lo))
                return ("HW", Data.TideHeightHigh ?? double.NaN, hi.Value);
            return ("LW", Data.TideHeightLow ?? double.NaN, lo!.Value);
        }
    }

    /// <summary>Up arrow when the next extreme is HW (flood), down when
    /// LW (ebb). Shown next to the current height so the rise/fall
    /// direction reads at a glance without having to read the time.</summary>
    private string TideArrow => NextExtreme?.Label == "HW" ? "\u25B2" : "\u25BC";
    private string TideDirectionLabel => NextExtreme?.Label == "HW" ? "flooding" : "ebbing";

    private static string FormatInterval(DateTime futureUtc)
    {
        var span = futureUtc - DateTime.UtcNow;
        if (span.TotalSeconds <= 0) return "now";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes}m";
        int hours = (int)span.TotalHours;
        int minutes = (int)(span.TotalMinutes - hours * 60);
        return minutes == 0 ? $"{hours}h" : $"{hours}h{minutes:D2}";
    }

    private string WindAngleDegStr =>
        Data.WindAngleApparent is not null
            ? $"{(Data.WindAngleApparent.Value * RadToDeg):F0}deg"
            : "0deg";

    private string TrueWindAngleDegStr =>
        Data.WindAngleTrue is not null
            ? $"{(Data.WindAngleTrue.Value * RadToDeg):F0}deg"
            : "0deg";

    private double HeadingRad => LastHeadingRad ?? 0;
    private string HeadingDegStr => $"{(HeadingRad * RadToDeg):F0}deg";

    /// <summary>
    /// Explains why the ANCHOR TIDE alarm can't fire right now, or returns
    /// null when it's fully armed. The rule needs two things the user must
    /// configure -- boat draft and a tide feed -- plus an active anchor.
    /// Each missing piece is surfaced as a short actionable hint; if
    /// everything is there, no hint.
    /// </summary>
    private string? AnchorTideDormantReason()
    {
        if (Data.DraftFromSignalK is not > 0)
            return "No boat draft on SignalK (set design.draft.current in vessel.json)";
        if (!HasTideData) return "No tide data (install a SignalK tide plugin)";
        return null;
    }

    // Build child-card snapshots. Composing records here keeps the child
    // components pure -- they only read from Snapshot and can decide
    // "no change" with a single record-equality check, which is what
    // lets Blazor skip re-renders on ticks that don't touch route or
    // anchor fields.
    private OnaPlotter.Components.Map.Hud.HudRouteCard.RouteHudSnapshot BuildRouteSnapshot() =>
        new(
            Visible: Data.HasActiveCourse,
            Name: Data.ActiveRouteName,
            PointIndex: Data.ActiveRoutePointIndex,
            PointTotal: Data.ActiveRoutePointTotal,
            ArrivalRadiusMeters: WaypointArrivalRadiusMeters,
            Distance: Data.CourseNextPointDistance,
            Bearing: Data.CourseNextPointBearing,
            Vmg: Data.CourseNextPointVmg,
            TimeToGo: Data.CourseNextPointTimeToGo,
            Xte: Data.CrossTrackError,
            RouteDistanceRemaining: Data.ActiveRouteDistanceRemaining,
            RouteTimeToGo: Data.ActiveRouteTimeToGo);

    private OnaPlotter.Components.Map.Hud.HudAnchorCard.AnchorHudSnapshot BuildAnchorSnapshot() =>
        new(
            Visible: Data.AnchorActive || ManualAnchorActive,
            Dragging: AnchorDragging,
            Manual: ManualAnchorActive,
            ManualRadiusMeters: ManualAnchorRadiusMeters,
            CurrentRadius: Data.AnchorCurrentRadius,
            MaxRadius: Data.AnchorMaxRadius,
            DormantReason: AnchorTideDormantReason());

    private static MarkupString SvgText(double x, double y, string content, string fill, int fontSize)
    {
        return new MarkupString(
            $"<text x=\"{x}\" y=\"{y}\" fill=\"{fill}\" font-size=\"{fontSize}\" " +
            $"text-anchor=\"middle\" dominant-baseline=\"central\">{System.Net.WebUtility.HtmlEncode(content)}</text>");
    }

    // --- Autopilot hold-to-engage ---
    // 600 ms is long enough that an accidental brush does nothing, short
    // enough that an intentional press feels responsive. The CSS `.holding`
    // class draws a progress sweep during the wait.
    private const int ApHoldMs = 600;
    private string? holding;
    private CancellationTokenSource? _apHoldCts;

    private void ApHoldStart(string mode)
    {
        _apHoldCts?.Cancel();
        _apHoldCts = new CancellationTokenSource();
        holding = mode;
        _ = RunApHoldAsync(mode, _apHoldCts.Token);
    }

    private async Task RunApHoldAsync(string mode, CancellationToken ct)
    {
        try
        {
            await Task.Delay(ApHoldMs, ct);
            if (ct.IsCancellationRequested) return;
            holding = null;
            await Autopilot.SetStateAsync(mode);
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) { /* user released before the threshold */ }
    }

    private void ApHoldEnd()
    {
        _apHoldCts?.Cancel();
        _apHoldCts = null;
        if (holding is not null)
        {
            holding = null;
            _ = InvokeAsync(StateHasChanged);
        }
    }
}
