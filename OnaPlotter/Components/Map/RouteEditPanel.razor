@* Route-edit overlay: hint banner at the top, a numbered waypoint list
   anchored top-right, and the control bar above the bottom controls.
   Visible only while the parent is in edit mode.

   The list is a mirror of the JS routeEditCoords array; the parent
   polls getEditRouteCoords on a timer (same one that updates Stats)
   and re-renders this panel with the new Coords array. Per-row remove
   buttons round-trip through the parent back to JS so numbering stays
   consistent.

   The list header is a clickable toggle that collapses the panel to
   just the header chip. Helm-feedback: a long waypoint list at the
   top-right corner shares screen real estate with the HUD-tr stack
   (wind dial + speed + heading + ...). Collapsing reduces the route
   panel to the count chip so the HUDs underneath stay visible while
   the helm works on the map. Re-expand by tapping the header. *@

<div class="route-edit-hint">
    Tap map to add waypoints. Drag waypoints to reposition.
</div>

@if (Coords is { Length: > 0 })
{
    <div class="route-edit-list @(_collapsed ? "collapsed" : "")"
         aria-label="Route waypoints">
        <button type="button"
                class="route-edit-list-header"
                @onclick="ToggleCollapsed"
                aria-expanded="@(!_collapsed ? "true" : "false")"
                aria-controls="route-edit-list-items"
                title="@(_collapsed ? "Show waypoints" : "Hide waypoints")">
            <span class="route-edit-list-chevron">@(_collapsed ? "▸" : "▾")</span>
            <span>Waypoints</span>
            <span class="route-edit-list-count">@Coords.Length</span>
        </button>
        @if (!_collapsed)
        {
            @* @ref grabs the <ol> so OnAfterRenderAsync can scroll the
               newest entry into view after an Add. JS-side scrollIntoView
               on the LAST <li> isn't a thing in Blazor without ref, and
               scrollTop = scrollHeight is more direct anyway. *@
            <ol class="route-edit-list-items"
                id="route-edit-list-items"
                @ref="_itemsRef">
                @for (int i = 0; i < Coords.Length; i++)
                {
                    var idx = i;
                    var c = Coords[idx];
                    <li class="route-edit-wp-row">
                        <span class="route-edit-wp-badge">@(idx + 1)</span>
                        <span class="route-edit-wp-coord">@FormatCoord(c)</span>
                        <button class="route-edit-wp-remove"
                                title="Remove waypoint @(idx + 1)"
                                aria-label="Remove waypoint @(idx + 1)"
                                @onclick="() => OnRemoveWaypoint.InvokeAsync(idx)">
                            ×
                        </button>
                    </li>
                }
            </ol>
        }
    </div>
}

<div class="route-edit-bar">
    <input type="text" class="route-name-input" aria-label="Route name"
           value="@Name" @oninput="OnNameInput" />
    <span class="route-edit-stats">@Stats</span>
    @{
        bool enoughPoints = (Coords?.Length ?? 0) >= 2;
        bool canSave = enoughPoints && !Saving;
    }
    @* Reverse: flips waypoint order. Classic case: "I planned the
       outbound, now I want the return leg" - without this the helm
       would re-add waypoints in opposite order. *@
    <button class="map-btn" @onclick="OnReverse"
            disabled="@(!enoughPoints || Saving)"
            title="@(!enoughPoints ? "Need at least 2 waypoints" : "Reverse waypoint order")">Reverse</button>
    @* Save is the primary action in every flow. Was previously secondary
       to Save & Go, but the helm pointed out that:
         (a) editing an active route makes Save and Save & Go the
             *same* operation (the route is already active), and
         (b) on a fresh create the helm reads "Save" as the obvious
             commit verb anyway. Promoting Save to primary in both
             cases removes the "wait, which button do I want?" pause. *@
    <button class="map-btn active" @onclick="OnSave"
            disabled="@(!canSave)"
            title="@(Saving ? "Saving..." : !enoughPoints ? "Need at least 2 waypoints" : "Save route")">
        @(Saving ? "Saving..." : "Save")
    </button>
    @* Save as copy: only meaningful when editing an existing route
       (IsEditingExisting). Saves the current geometry as a NEW route
       instead of overwriting the original - useful when the helm
       wants a variant without losing the source. Hidden in fresh-
       create flows where it'd be redundant with Save. *@
    @if (IsEditingExisting)
    {
        <button class="map-btn" @onclick="OnSaveAsCopy"
                disabled="@(!canSave)"
                title="@(Saving ? "Saving..." : !enoughPoints ? "Need at least 2 waypoints" : "Save as a new route, leave the original unchanged")">
            Save copy
        </button>
    }
    @* Save & Go: only useful when the route is NOT already active -
       saves AND sets it as the active course in one tap. Hidden when
       the route is already active because Save and Save & Go would
       then perform identical operations and the duplicated button
       just adds confusion. The Saving gate stops a double-tap from
       posting two identical routes. *@
    @if (!IsEditingActiveRoute)
    {
        <button class="map-btn" @onclick="OnSaveAndGo"
                disabled="@(!canSave)"
                title="@(Saving ? "Saving..." : !enoughPoints ? "Need at least 2 waypoints" : "Save and start navigating")">
            @(Saving ? "Starting..." : "Save & Go")
        </button>
    }
    <button class="map-btn" @onclick="OnCancel" disabled="@Saving">Cancel</button>
</div>

@code {
    [Inject] private Microsoft.JSInterop.IJSRuntime JS { get; set; } = default!;

    /// <summary>Helm-toggled collapse state for the waypoint list.
    /// Defaults to expanded; toggling sticks for the lifetime of the
    /// edit session (the panel unmounts on Cancel / Save so a fresh
    /// edit starts expanded again). The helm collapses when a long
    /// list crowds the HUD-tr stack; re-expands to review or remove
    /// waypoints.</summary>
    private bool _collapsed;

    /// <summary>Ref to the &lt;ol&gt; so we can auto-scroll the latest
    /// waypoint into view when the parent appends a new entry. Without
    /// this the helm tapping the map to add waypoint #15 doesn't see
    /// it in the panel (the ol stays scrolled at the top) - they'd
    /// have to manually scroll every time the list overflows.</summary>
    private ElementReference _itemsRef;
    private int _lastSeenCount;

    [Parameter] public string Name { get; set; } = "";
    [Parameter] public EventCallback<string> NameChanged { get; set; }
    [Parameter] public string Stats { get; set; } = "";
    [Parameter] public double[][]? Coords { get; set; }
    /// <summary>True while a Save / Save & Go is in flight. Disables all
    /// action buttons so a double-tap can't post two identical routes.
    /// Flips back to false once the REST round-trip + side-effects
    /// complete (success or failure).</summary>
    [Parameter] public bool Saving { get; set; }
    /// <summary>True when the panel is editing an existing route
    /// (Layers-panel Edit), false on a fresh create. Drives whether
    /// the "Save copy" button is rendered - copying makes no sense
    /// in the fresh-create flow.</summary>
    [Parameter] public bool IsEditingExisting { get; set; }
    /// <summary>True when the existing route is the currently-active
    /// course. In that case Save & Go is hidden because saving
    /// already keeps the route active - the two operations would be
    /// identical. Also influences future deactivate / re-activate
    /// affordances if added.</summary>
    [Parameter] public bool IsEditingActiveRoute { get; set; }
    [Parameter] public EventCallback OnReverse { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnSaveAsCopy { get; set; }
    [Parameter] public EventCallback OnSaveAndGo { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback<int> OnRemoveWaypoint { get; set; }

    private async Task OnNameInput(ChangeEventArgs e)
    {
        // Don't mutate the [Parameter] directly - Blazor overwrites on
        // the next parent render, which fights the user's typing if the
        // parent state round-trip is slow. Just bubble the new value;
        // the parent owns the state.
        var newName = e.Value?.ToString() ?? "";
        await NameChanged.InvokeAsync(newName);
    }

    private void ToggleCollapsed() => _collapsed = !_collapsed;

    /// <summary>Scroll the &lt;ol&gt; to the bottom after an Add so the
    /// newest waypoint stays visible. Triggered when the parent
    /// re-renders with a higher Coords.Length than last seen; skipped
    /// when the list is collapsed (the ref isn't rendered) and on
    /// equal-or-smaller counts (e.g. a Remove shouldn't auto-jump).</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        int count = Coords?.Length ?? 0;
        if (!_collapsed && count > _lastSeenCount)
        {
            try
            {
                await JS.InvokeVoidAsync("scrollElementToBottom", _itemsRef);
            }
            catch (Microsoft.JSInterop.JSDisconnectedException) { }
            catch (Microsoft.JSInterop.JSException) { /* helper not loaded yet; harmless */ }
        }
        _lastSeenCount = count;
    }

    // "48.2144° N, 11.5753° E" style. Keeps the panel scannable at a
    // glance without needing the user to interpret signed degrees.
    private static string FormatCoord(double[] c)
    {
        if (c is null || c.Length < 2) return "";
        double lat = c[0], lon = c[1];
        string ns = lat >= 0 ? "N" : "S";
        string ew = lon >= 0 ? "E" : "W";
        return $"{System.Math.Abs(lat):F4}\u00B0 {ns}, {System.Math.Abs(lon):F4}\u00B0 {ew}";
    }
}
