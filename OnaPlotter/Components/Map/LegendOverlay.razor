@* Modal card listing every symbol the map can display. Opens via the
   Legend button in the bottom control bar. Same dismissal contract as
   MapShortcutsOverlay: backdrop click and the [Close] button both
   invoke OnDismiss.

   Descriptions skip symbol-shape words -- the swatch to the left already
   shows the colour and shape. Text carries the *meaning* (which kind of
   vessel, why it's there, when the alarm fires). "Cargo / tanker /
   passenger / tug" instead of "cargo with a solid-dot glyph". *@

<div class="shortcuts-overlay" @onclick="OnDismiss">
    <div class="shortcuts-card legend-card" @onclick:stopPropagation>
        <h5>Map Legend</h5>
        <ul class="legend-list">
            <li>
                <span class="legend-swatch legend-own"></span>
                <span class="legend-name">Own boat</span>
                <span class="legend-desc">Arrow points along COG.</span>
            </li>
            <li>
                <span class="legend-swatch legend-cog-vector"></span>
                <span class="legend-name">COG vector</span>
                <span class="legend-desc">Dashed line ahead of own-boat. Length = speed x look-ahead.</span>
            </li>
            <li>
                <span class="legend-swatch legend-ais-sail"></span>
                <span class="legend-name">AIS sail / pleasure</span>
                <span class="legend-desc">Yacht, dinghy, recreational.</span>
            </li>
            <li>
                <span class="legend-swatch legend-ais-fish"></span>
                <span class="legend-name">AIS fishing</span>
                <span class="legend-desc">Trawler, longliner, seiner.</span>
            </li>
            <li>
                <span class="legend-swatch legend-ais-commercial"></span>
                <span class="legend-name">AIS commercial</span>
                <span class="legend-desc">Cargo / tanker / passenger / tug.</span>
            </li>
            <li>
                <span class="legend-swatch legend-buddy"></span>
                <span class="legend-name">Buddy</span>
                <span class="legend-desc">Collision alarm suppressed.</span>
            </li>
            <li>
                <span class="legend-swatch legend-danger"></span>
                <span class="legend-name">CPA danger</span>
                <span class="legend-desc">On a collision track with own-boat.</span>
            </li>
            <li>
                <span class="legend-swatch legend-sart"></span>
                <span class="legend-name">SART / MOB / EPIRB</span>
                <span class="legend-desc">Life-safety, cannot be snoozed.</span>
            </li>
            <li>
                <span class="legend-swatch legend-radar"></span>
                <span class="legend-name">Radar ARPA</span>
                <span class="legend-desc">From Mayara / similar plugin.</span>
            </li>
            <li>
                <span class="legend-swatch legend-route"></span>
                <span class="legend-name">Route</span>
                <span class="legend-desc">Your planned track.</span>
            </li>
            <li>
                <span class="legend-swatch legend-waypoint"></span>
                <span class="legend-name">Waypoint</span>
                <span class="legend-desc">Tap in the Layers panel to navigate.</span>
            </li>
            <li>
                <span class="legend-swatch legend-note"></span>
                <span class="legend-name">Note</span>
                <span class="legend-desc">Title and body text on the chart.</span>
            </li>
            <li>
                <span class="legend-swatch legend-region"></span>
                <span class="legend-name">Region</span>
                <span class="legend-desc">Anchorage, no-go, area of interest.</span>
            </li>
            <li>
                <span class="legend-swatch legend-guard"></span>
                <span class="legend-name">Guard zone</span>
                <span class="legend-desc">
                    Amber circle centred on your vessel. Any AIS target projected to
                    enter it within the CPA lookahead window triggers the alarm.
                    Radius = Settings &rarr; Guard Zone (CPA). Set to 0 to hide.
                </span>
            </li>
            <li>
                <span class="legend-swatch legend-current"></span>
                <span class="legend-name">Tidal current</span>
                <span class="legend-desc">Violet arrow from own-boat; direction shows set, label shows drift in knots.</span>
            </li>
            <li>
                <span class="legend-swatch legend-course-leg"></span>
                <span class="legend-name">Course leg</span>
                <span class="legend-desc">White dashed line between previous and next waypoint of the active route.</span>
            </li>
            <li>
                <span class="legend-swatch legend-bearing"></span>
                <span class="legend-name">Bearing to waypoint</span>
                <span class="legend-desc">Cyan dashed line from own-boat to the active waypoint.</span>
            </li>
            <li>
                <span class="legend-swatch legend-xte"></span>
                <span class="legend-name">Cross-track error</span>
                <span class="legend-desc">Perpendicular tick at own-boat. Green under 50 m, amber to 200 m, red above.</span>
            </li>
            <li>
                <span class="legend-swatch legend-route-edit"></span>
                <span class="legend-name">Route (planning)</span>
                <span class="legend-desc">Violet dashed preview while a route is being built. Tap the line to insert a waypoint between two existing points.</span>
            </li>
            <li>
                <span class="legend-swatch legend-active-wp"></span>
                <span class="legend-name">Active waypoint</span>
                <span class="legend-desc">Pulsing violet dot on the next waypoint along the active route.</span>
            </li>
            <li>
                <span class="legend-swatch legend-anchor"></span>
                <span class="legend-name">Anchor watch</span>
                <span class="legend-desc">Alarm-radius circle around the drop point; trail shows drift history.</span>
            </li>
            <li>
                <span class="legend-swatch legend-mob"></span>
                <span class="legend-name">MOB marker</span>
                <span class="legend-desc">Red pin at the spot the MOB button was pressed, with distance + bearing to own-boat.</span>
            </li>
            <li>
                <span class="legend-swatch legend-measure"></span>
                <span class="legend-name">Measurement</span>
                <span class="legend-desc">Tap two points with the Measure tool to get distance + bearing.</span>
            </li>
        </ul>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public EventCallback OnDismiss { get; set; }
}
