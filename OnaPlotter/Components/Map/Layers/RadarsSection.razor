@using OnaPlotter.Models

@* Radar device list. One row per detected radar, with a toggle that
   enables / disables the spoke overlay for that unit. Status chip
   shows the radar's current operational state (standby / transmit)
   and range so the user can tell why the overlay is empty when it
   is. Collapsed by default. Row hidden entirely if the server has
   no radar provider plugin (Radars.Count == 0). *@

@if (Radars.Count == 0) return;

<SectionHeader Title="Radars" Count="@Radars.Count"
               Expanded="@expanded"
               OnToggle="() => expanded = !expanded" />

@if (expanded)
{
    <div class="chart-section-hint">
        Tick to overlay the spoke sweep on the chart. The radar must
        be transmitting to produce data; a standby radar shows an empty
        overlay.
    </div>
    @foreach (var r in Radars)
    {
        bool enabled = Enabled.Contains(r.Id);
        bool transmitting = string.Equals(r.Status, "transmit", StringComparison.OrdinalIgnoreCase);
        <label @key="r.Id" class="chart-item">
            <input type="checkbox" checked="@enabled"
                   @onchange="(e) => OnToggle.InvokeAsync((r, (bool)(e.Value ?? false)))" />
            <div class="chart-item-body">
                <div class="chart-name">
                    @DisplayName(r)
                    @if (r.Status is string s)
                    {
                        @* Class suffix is whitelisted to known spec values
                           so a hostile server can't smuggle additional
                           class tokens (e.g. "transmit hidden") that
                           visually neutralise the chip. The free-form
                           server string still shows in title + chip text. *@
                        <span class="radar-status-chip radar-status-@StatusClassSuffix(s)" title="@s">
                            @s.ToUpperInvariant()
                        </span>
                    }
                </div>
                @if (!string.IsNullOrEmpty(r.Brand) || !string.IsNullOrEmpty(r.Model))
                {
                    <div class="chart-desc">@(r.Brand ?? "") @(r.Model ?? "")</div>
                }
                @* Inline controls. Power toggle + range dropdown are
                   the spec's "used often" controls; gain / sea / rain
                   live in a future controls panel since they belong
                   on a graphical PPI window per the spec. *@
                <div class="radar-controls" @onclick:stopPropagation @onclick:preventDefault>
                    <button type="button"
                            class="map-btn radar-power-btn @(transmitting ? "ap-engaged" : "")"
                            title="@(transmitting ? "Stop transmitting" : "Start transmitting")"
                            @onclick="() => OnSetPower.InvokeAsync((r, transmitting ? RadarPower.Standby : RadarPower.Transmit))">
                        @(transmitting ? "Standby" : "Transmit")
                    </button>
                    @if (r.Range is int rangeM)
                    {
                        <span class="radar-range-label">Range</span>
                        <select class="map-btn radar-range-select"
                                value="@rangeM"
                                @onchange="(e) => OnRangeChange(r, e)">
                            @* Drives off the range control's validValues
                               (the radar's actual write whitelist) when
                               capabilities have arrived; supportedRanges
                               at the root is a SUPERSET that includes
                               read-only values the server still rejects
                               on PUT. Labels prefer the per-value
                               descriptions ("1/4 nm", "24 nm") over our
                               own metric/nm formatting. The select's
                               own value attribute drives the initial
                               selection; per-option `selected` would
                               double-bind and silently win the conflict
                               in unpredictable browser order. *@
                            @foreach (var v in GetRangeOptions(r))
                            {
                                <option value="@v">@FormatRangeFor(r, v)</option>
                            }
                        </select>
                    }
                </div>
            </div>
        </label>
    }
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<RadarInfo> Radars { get; set; } = [];
    [Parameter, EditorRequired] public IReadOnlySet<string> Enabled { get; set; } = new HashSet<string>();
    [Parameter] public IReadOnlyDictionary<string, RadarCapabilities?> Capabilities { get; set; } =
        new Dictionary<string, RadarCapabilities?>();
    [Parameter] public EventCallback<(RadarInfo radar, bool enabled)> OnToggle { get; set; }
    [Parameter] public EventCallback<(RadarInfo radar, RadarPower power)> OnSetPower { get; set; }
    [Parameter] public EventCallback<(RadarInfo radar, int rangeMeters)> OnSetRange { get; set; }

    /// <summary>Per-radar range-dropdown options. Pecking order:
    /// (1) the range control's <c>validValues</c> (the actual PUT
    ///     whitelist; on Navico HALO this excludes the metric-only
    ///     entries from <c>supportedRanges</c> that the server then
    ///     rejects with "value not legal");
    /// (2) <c>supportedRanges</c> at the capabilities root, when the
    ///     control schema doesn't ship a validValues list;
    /// (3) a generic ladder only while capabilities are still
    ///     in-flight.
    /// Always splices in the radar's current range if absent so the
    /// select reflects server state instead of resetting silently.</summary>
    private IEnumerable<int> GetRangeOptions(RadarInfo r)
    {
        IReadOnlyList<int> ranges = DefaultRangeLadder;
        if (Capabilities.TryGetValue(r.Id, out var caps) && caps is not null)
        {
            if (caps.Controls.TryGetValue("range", out var rangeCtl)
                && rangeCtl.ValidValues is { Length: > 0 } valid)
            {
                ranges = valid;
            }
            else if (caps.SupportedRanges is { Length: > 0 } supported)
            {
                ranges = supported;
            }
        }
        if (r.Range is int current && !ranges.Contains(current))
        {
            return ranges.Append(current).OrderBy(v => v);
        }
        return ranges.OrderBy(v => v);
    }

    /// <summary>Label for one range option. Prefers the radar's own
    /// per-value description ("1/4 nm", "1.5 nm", "24 nm") so the
    /// dropdown matches what the helm sees on a brand-native MFD;
    /// falls back to <see cref="FormatRange"/> when the description
    /// for that exact metres value is absent.</summary>
    private string FormatRangeFor(RadarInfo r, int meters)
    {
        if (Capabilities.TryGetValue(r.Id, out var caps)
            && caps?.Controls.TryGetValue("range", out var rangeCtl) == true
            && rangeCtl.Descriptions is { } desc
            && desc.TryGetValue(
                meters.ToString(System.Globalization.CultureInfo.InvariantCulture),
                out var label)
            && !string.IsNullOrWhiteSpace(label))
        {
            return label;
        }
        return FormatRange(meters);
    }

    private bool expanded = false;

    // Generic spread of metric ranges in metres. Used only as a
    // placeholder while /capabilities is in flight; once caps arrive
    // GetRangeOptions switches to the radar's own validValues. Kept
    // as a sane no-network fallback so an early click on the dropdown
    // before caps arrive still offers reasonable choices.
    private static readonly int[] DefaultRangeLadder =
    [
        50, 100, 250, 500, 1000, 1500, 2000, 3000, 4000, 6000,
        8000, 12000, 16000, 24000, 36000, 48000, 74080,
    ];

    private async Task OnRangeChange(RadarInfo r, ChangeEventArgs e)
    {
        if (e.Value is null) return;
        if (!int.TryParse(e.Value.ToString(),
            System.Globalization.NumberStyles.Integer,
            System.Globalization.CultureInfo.InvariantCulture,
            out int v)) return;
        await OnSetRange.InvokeAsync((r, v));
    }

    private static string DisplayName(RadarInfo r) =>
        !string.IsNullOrWhiteSpace(r.Name) ? r.Name!
        : !string.IsNullOrWhiteSpace(r.Model) ? r.Model!
        : r.Id;

    // Whitelisted CSS-class suffix for the status chip. Only the four
    // power states the spec defines map to a per-state colour; anything
    // else (server bug, mid-upgrade, unknown vendor extension) renders
    // with the neutral "unknown" style instead of letting the raw
    // string become a class-token-injection vector.
    private static string StatusClassSuffix(string status) =>
        status?.Trim().ToLowerInvariant() switch
        {
            "transmit" => "transmit",
            "standby" => "standby",
            "off" => "off",
            "preparing" => "preparing",
            _ => "unknown",
        };

    // Range comes in metres per spec. Small ranges read better in
    // metres (200m vs 0.1nm); switch over 1000 m to nm for typical
    // open-water scales.
    private static string FormatRange(int m) =>
        m < 1000 ? $"{m} m" : $"{(m / 1852.0):F1} nm";
}
