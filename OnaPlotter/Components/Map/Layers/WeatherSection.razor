@* Toggle for the weather tile overlay. Currently RainViewer
   precipitation radar; the label below reflects what's actually rendered
   so users don't expect a wind stream. OpenWeatherMap wind is on the
   wishlist (needs an API key -- see agents.md). *@

<SectionHeader Title="Weather Overlay"
               Expanded="@expanded"
               OnToggle="() => expanded = !expanded" />
@if (expanded)
{
    <label class="chart-item">
        <input type="checkbox" checked="@Visible"
               @onchange="(e) => OnToggle.InvokeAsync((bool)(e.Value ?? false))" />
        <div class="chart-item-body">
            <div class="chart-name">Rain radar</div>
            <div class="chart-desc">RainViewer nowcast (precipitation, not wind)</div>
        </div>
    </label>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> OnToggle { get; set; }

    private bool expanded = false;
}
