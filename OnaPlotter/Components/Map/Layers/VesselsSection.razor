@using OnaPlotter.Models

@* All tracked AIS vessels sorted by TCPA (threat first). Buddies get a
   star, and the row is tinted red/amber when the CPA is inside the
   danger/warning bands. A third descriptive line shows the COLREGS
   classification + give-way role. *@

@if (Vessels.Count == 0) return;

<SectionHeader Title="Vessels" Count="@Vessels.Count"
               Expanded="@expanded"
               OnToggle="ToggleExpanded" />
@if (expanded)
{
    @foreach (var vessel in Vessels)
    {
        <div class="chart-item vessel-row @VesselRowClass(vessel)"
             @onclick="() => OnFocus.InvokeAsync(vessel.Context)">
            <div class="chart-item-body">
                <div class="chart-name">@(vessel.IsBuddy ? "\u2605 " : "")@vessel.DisplayName</div>
                <div class="chart-desc">
                    @if (vessel.CpaNm is not null && vessel.TcpaMin is not null)
                    {
                        <span>CPA @vessel.CpaNm.Value.ToString("F2") nm · T-@vessel.TcpaMin.Value.ToString("F0")m</span>
                    }
                    else if (vessel.DistanceNm is not null)
                    {
                        <span>@vessel.DistanceNm.Value.ToString("F1") nm @vessel.BearingDeg?.ToString("F0")°</span>
                    }
                    @if (vessel.SogKn is not null)
                    {
                        <span> · @vessel.SogKn.Value.ToString("F1") kn</span>
                    }
                </div>
                @if (vessel.ColregsLabel is not null)
                {
                    <div class="chart-desc vessel-colregs">
                        <span>@vessel.ColregsLabel</span>
                        @if (vessel.ColregsRole is not null)
                        {
                            <span class="colregs-role @(vessel.ColregsRole == "Give way" ? "colregs-giveway" : "colregs-standon")">
                                · @vessel.ColregsRole
                            </span>
                        }
                    </div>
                }
            </div>
        </div>
    }
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<VesselListEntry> Vessels { get; set; } = [];
    [Parameter] public EventCallback<string> OnFocus { get; set; }

    // Collapsed by default so the panel opens compact. But if at least
    // one vessel is in the danger/warn CPA band, auto-expand -- that's
    // the case where the helm actually wants to see the list, and
    // keeping it collapsed hides the target they just opened the panel
    // to inspect. User-toggled state still persists in `_userToggled`
    // so we don't fight their choice after they collapse manually.
    private bool _userToggled;
    private bool expanded = false;

    protected override void OnParametersSet()
    {
        if (_userToggled) return;
        expanded = Vessels.Any(v => VesselRowClass(v) is "vessel-danger" or "vessel-warn");
    }

    private void ToggleExpanded()
    {
        expanded = !expanded;
        _userToggled = true;
    }

    private static string VesselRowClass(VesselListEntry v)
    {
        if (v.CpaNm is null || v.TcpaMin is null) return "";
        if (v.CpaNm < 0.5 && v.TcpaMin < 10) return "vessel-danger";
        if (v.CpaNm < 1.0 && v.TcpaMin < 20) return "vessel-warn";
        return "";
    }
}
