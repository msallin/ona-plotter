@using OnaPlotter.Models

@* Friends list from sbender9/signalk-buddylist-plugin. Shows every known
   buddy whether or not they're currently transmitting AIS - useful so the
   captain knows their friend hasn't been seen lately. *@

@if (Buddies.Count == 0) return;

<SectionHeader Title="Buddies" Count="@Buddies.Count"
               Expanded="@expanded"
               OnToggle="() => expanded = !expanded" />
@if (expanded)
{
    @foreach (var buddy in Buddies)
    {
        // Match on the canonical MMSI slot, not a substring search - a buddy
        // whose display name happens to contain the MMSI would otherwise
        // false-match a different vessel.
        var live = buddy.Mmsi is not null
            ? Vessels.FirstOrDefault(v => v.Mmsi == buddy.Mmsi)
            : null;
        <div class="chart-item vessel-row vessel-buddy"
             role="button"
             tabindex="0"
             aria-label="Focus on buddy @buddy.Name"
             @onclick="() => Focus(live?.Context)"
             @onkeydown="(e) => OnRowKey(e, live?.Context)">
            <div class="chart-item-body">
                <div class="chart-name">&#x2605; @buddy.Name</div>
                <div class="chart-desc">
                    @if (live?.DistanceNm is not null)
                    {
                        <span>@live.DistanceNm.Value.ToString("F1") nm</span>
                        if (live.SogKn is not null)
                        {
                            <span> · @live.SogKn.Value.ToString("F1") kn</span>
                        }
                    }
                    else
                    {
                        <span class="buddy-offline">Not in AIS range</span>
                    }
                </div>
            </div>
        </div>
    }
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<SignalkBuddy> Buddies { get; set; } = [];
    [Parameter, EditorRequired] public IReadOnlyList<VesselListEntry> Vessels { get; set; } = [];
    [Parameter] public EventCallback<string> OnFocus { get; set; }

    private bool expanded = false;

    // Null-safe focus: offline buddies have no live context.
    private Task Focus(string? context) =>
        context is null ? Task.CompletedTask : OnFocus.InvokeAsync(context);

    private async Task OnRowKey(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e, string? context)
    {
        if ((e.Key == "Enter" || e.Key == " ") && context is not null)
        {
            await OnFocus.InvokeAsync(context);
        }
    }
}
