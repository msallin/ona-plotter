@using OnaPlotter.Models

@* Chart overlays (tile layers). Single inline list: each chart row
   carries a quick-bar checkbox; charts that are currently rendering
   on the map get inline reorder arrows that edit their position in
   the draw stack. Previously this section had a separate "yellow
   box" ActiveStack above the list that duplicated the rendering
   charts -- it was confusing because ticking the checkbox added the
   chart to the quick bar but didn't make it render, so the yellow
   box stayed empty until a second tap on the map chip. Merging into
   one row per chart removes the two-tap surprise and keeps the
   reorder affordance next to the chart it moves. *@

@if (Charts.Count == 0) return;

<SectionHeader Title="Charts" Count="@Charts.Count"
               Expanded="@expanded"
               OnToggle="() => expanded = !expanded" />
@if (expanded)
{
    <div class="chart-section-hint">
        Tick to add to the on-map quick-switch bar. Tap the chip there to
        show / hide the chart. Rendering charts get up/down arrows to
        order the draw stack (top of the stack = in front).
    </div>
    @foreach (var chart in Charts)
    {
        bool inQuickBar = QuickBarCharts.Contains(chart.Identifier);
        bool rendering = Enabled.Contains(chart.Identifier);
        int stackIdx = rendering ? ActiveStack.FindIndex(c => c.Identifier == chart.Identifier) : -1;
        <label class="chart-item @(rendering ? "chart-item-rendering" : "")">
            <input type="checkbox" checked="@inQuickBar"
                   @onchange="(e) => OnToggleQuickBar.InvokeAsync((chart, (bool)(e.Value ?? false)))" />
            <div class="chart-item-body">
                <div class="chart-name">
                    @chart.Name
                    @if (rendering)
                    {
                        <span class="chart-rendering-dot" title="Currently visible on the map">&#x25CF;</span>
                    }
                </div>
                @if (chart.Description is not null)
                {
                    <div class="chart-desc">@chart.Description</div>
                }
                @if (chart.MinZoom is not null || chart.MaxZoom is not null)
                {
                    <div class="chart-desc">z@(chart.MinZoom ?? 1)-@(chart.MaxZoom ?? 18)</div>
                }
            </div>
            @if (rendering)
            {
                @* Reorder affordance shows only on rendering charts --
                   the buttons are meaningless for a chart that isn't
                   in the draw stack. Position-aware disabling prevents
                   the "nothing happened" tap at the ends of the list. *@
                <span class="chart-active-actions" @onclick:stopPropagation
                      @onclick:preventDefault>
                    <button class="chart-reorder-btn"
                            type="button"
                            disabled="@(stackIdx <= 0)"
                            title="Move up (towards front of draw stack)"
                            aria-label="Move @chart.Name up"
                            @onclick="() => OnReorder.InvokeAsync((chart, -1))">&#9650;</button>
                    <button class="chart-reorder-btn"
                            type="button"
                            disabled="@(stackIdx < 0 || stackIdx >= ActiveStack.Count - 1)"
                            title="Move down (towards back of draw stack)"
                            aria-label="Move @chart.Name down"
                            @onclick="() => OnReorder.InvokeAsync((chart, 1))">&#9660;</button>
                </span>
            }
        </label>
    }
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<SignalkChart> Charts { get; set; } = [];

    /// <summary>Charts currently rendered on the map. Drives the
    /// "rendering" dot and the inline reorder arrows.</summary>
    [Parameter, EditorRequired] public HashSet<string> Enabled { get; set; } = [];

    /// <summary>Charts the user has picked for the on-map quick-switch
    /// bar. The checkbox in this panel edits membership of this set;
    /// the list itself is persisted via IAppSettings.QuickBarChartIds.</summary>
    [Parameter, EditorRequired] public HashSet<string> QuickBarCharts { get; set; } = [];

    /// <summary>Fired when the user ticks or unticks a chart. Adds /
    /// removes from QuickBarChartIds; parent also pulls the chart out
    /// of EnabledChartIds on untick so a removed chart stops rendering.</summary>
    [Parameter] public EventCallback<(SignalkChart chart, bool inQuickBar)> OnToggleQuickBar { get; set; }

    /// <summary>Reorder callback. Second tuple value is direction:
    /// -1 = move up (toward top of stack), +1 = move down.</summary>
    [Parameter] public EventCallback<(SignalkChart chart, int direction)> OnReorder { get; set; }

    // Collapsed by default -- the Layers panel opens compact, the user
    // expands only the sections they need. See agents.md "UX principles".
    private bool expanded = false;

    // ActiveStack[0] = top of map (last drawn). Charts list is in draw
    // order (first added, rendered first / bottom); reverse so the arrow
    // buttons read "up = on top" which is more intuitive.
    private List<SignalkChart> ActiveStack =>
        Charts.Where(c => Enabled.Contains(c.Identifier)).Reverse().ToList();
}
