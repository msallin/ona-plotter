@using OnaPlotter.Models

@* Chart overlays (tile layers). Single inline list: each chart row
   carries a quick-bar checkbox; charts that are currently rendering
   on the map get inline reorder arrows that edit their position in
   the draw stack. Previously this section had a separate "yellow
   box" ActiveStack above the list that duplicated the rendering
   charts -- it was confusing because ticking the checkbox added the
   chart to the quick bar but didn't make it render, so the yellow
   box stayed empty until a second tap on the map chip. Merging into
   one row per chart removes the two-tap surprise and keeps the
   reorder affordance next to the chart it moves. *@

@if (Charts.Count == 0) return;

<SectionHeader Title="Charts" Count="@Charts.Count"
               Expanded="@expanded"
               OnToggle="() => expanded = !expanded" />
@if (expanded)
{
    <div class="chart-section-hint">
        Tick to add to the on-map quick-switch bar. Tap the chip there to
        show / hide the chart. Rendering charts get up/down arrows to
        order the draw stack (top of the stack = in front).
    </div>
    @* Row shape is the same for every chart -- reorder arrows always
       present so the affordance is stable and the row doesn't
       jump width when rendering flips. Disabled state on an arrow
       when the chart isn't in the draw stack (or is already at an
       end) carries the meaning "nothing to move right now". The
       amber row highlight on rendering charts was dropped because
       it competed with the quick-bar's own active chip and made
       the panel feel busy; the green dot next to the name is the
       subtler signal. *@
    @* up / down enablement is based on the visible LIST position
       (what the user sees), not the z-stack position. Users expect
       "up arrow = move visually up in the panel" which matches
       "earlier in the Charts iteration". Charts displays enabled +
       disabled together; only enabled charts can be reordered, so
       limit the checks to enabled neighbours. *@
    var enabledInOrder = Charts.Where(c => Enabled.Contains(c.Identifier)).ToList();
    @foreach (var chart in Charts)
    {
        bool inQuickBar = QuickBarCharts.Contains(chart.Identifier);
        bool rendering = Enabled.Contains(chart.Identifier);
        int listIdx = rendering ? enabledInOrder.FindIndex(c => c.Identifier == chart.Identifier) : -1;
        bool upEnabled = listIdx > 0;
        bool downEnabled = listIdx >= 0 && listIdx < enabledInOrder.Count - 1;
        <label @key="chart.Identifier" class="chart-item">
            <input type="checkbox" checked="@inQuickBar"
                   @onchange="(e) => OnToggleQuickBar.InvokeAsync((chart, (bool)(e.Value ?? false)))" />
            <div class="chart-item-body">
                <div class="chart-name">
                    @chart.Name
                    @if (rendering)
                    {
                        <span class="chart-rendering-dot" title="Currently visible on the map">&#x25CF;</span>
                    }
                </div>
                @if (chart.Description is not null)
                {
                    <div class="chart-desc">@chart.Description</div>
                }
                @if (chart.MinZoom is not null || chart.MaxZoom is not null)
                {
                    <div class="chart-desc">z@(chart.MinZoom ?? 1)-@(chart.MaxZoom ?? 18)</div>
                }
            </div>
            <span class="chart-active-actions" @onclick:stopPropagation
                  @onclick:preventDefault>
                <button class="chart-reorder-btn"
                        type="button"
                        disabled="@(!upEnabled)"
                        title="Move up in list"
                        aria-label="Move @chart.Name up"
                        @onclick="() => OnReorder.InvokeAsync((chart, -1))">&#9650;</button>
                <button class="chart-reorder-btn"
                        type="button"
                        disabled="@(!downEnabled)"
                        title="Move down in list"
                        aria-label="Move @chart.Name down"
                        @onclick="() => OnReorder.InvokeAsync((chart, 1))">&#9660;</button>
            </span>
        </label>
    }

    @* Display tweaks. Three CSS-filter sliders: contrast / saturation
       / brightness. Helms running raster Navionics PNGs find them
       washed out at noon and unreadable in glare; small contrast +
       saturation boosts make a real difference. Brightness range is
       tighter (50-150) -- past 150 the chart blooms out and contour
       lines fade. Reset button lands every channel back at the
       identity default. *@
    <div class="chart-filter-group" @onclick:stopPropagation>
        <div class="chart-filter-header">
            <span class="chart-filter-title">Display</span>
            @{
                bool atDefaults = _displayContrast == 100
                    && _displaySaturation == 100
                    && _displayBrightness == 100;
            }
            @* Always-visible affordance so the helm doesn't have to
               nudge a slider just to discover that Reset exists.
               Disabled (CSS-dimmed + no pointer-events) when every
               channel already sits at the identity 100, so the
               disabled state itself communicates "nothing to reset
               right now". *@
            <button class="chart-filter-reset"
                    type="button"
                    disabled="@atDefaults"
                    title="@(atDefaults ? "All channels at default" : "Reset to defaults")"
                    @onclick="HandleResetClicked">Reset</button>
        </div>
        <div class="chart-filter-row">
            <span class="chart-filter-label">Contrast</span>
            <input type="range" class="chart-filter-slider"
                   min="50" max="150" step="5"
                   value="@_displayContrast"
                   @oninput="HandleContrastInput"
                   @onchange="HandleContrastCommit"
                   aria-label="Chart contrast" />
            <span class="chart-filter-value">@_displayContrast%</span>
        </div>
        <div class="chart-filter-row">
            <span class="chart-filter-label">Saturation</span>
            <input type="range" class="chart-filter-slider"
                   min="50" max="150" step="5"
                   value="@_displaySaturation"
                   @oninput="HandleSaturationInput"
                   @onchange="HandleSaturationCommit"
                   aria-label="Chart saturation" />
            <span class="chart-filter-value">@_displaySaturation%</span>
        </div>
        <div class="chart-filter-row">
            <span class="chart-filter-label">Brightness</span>
            <input type="range" class="chart-filter-slider"
                   min="50" max="150" step="5"
                   value="@_displayBrightness"
                   @oninput="HandleBrightnessInput"
                   @onchange="HandleBrightnessCommit"
                   aria-label="Chart brightness" />
            <span class="chart-filter-value">@_displayBrightness%</span>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<SignalkChart> Charts { get; set; } = [];

    /// <summary>Charts currently rendered on the map. Drives the
    /// "rendering" dot and the inline reorder arrows.</summary>
    [Parameter, EditorRequired] public HashSet<string> Enabled { get; set; } = [];

    /// <summary>Charts the user has picked for the on-map quick-switch
    /// bar. The checkbox in this panel edits membership of this set;
    /// the list itself is persisted via IAppSettings.QuickBarChartIds.</summary>
    [Parameter, EditorRequired] public HashSet<string> QuickBarCharts { get; set; } = [];

    /// <summary>Fired when the user ticks or unticks a chart. Adds /
    /// removes from QuickBarChartIds; parent also pulls the chart out
    /// of EnabledChartIds on untick so a removed chart stops rendering.</summary>
    [Parameter] public EventCallback<(SignalkChart chart, bool inQuickBar)> OnToggleQuickBar { get; set; }

    /// <summary>Reorder callback. Second tuple value is direction:
    /// -1 = move up (toward top of stack), +1 = move down.</summary>
    [Parameter] public EventCallback<(SignalkChart chart, int direction)> OnReorder { get; set; }

    // ---- CSS-filter sliders (contrast / saturation / brightness) ----
    // Same preview/commit split as the weather-opacity row in MiscSection:
    // @oninput pushes the new value to the JS layer immediately so the
    // helm sees the chart change as they drag, @onchange fires once on
    // slider release to persist + broadcast OnSettingsChanged. Without
    // the split a 1-second drag would pile up ~10 localStorage writes
    // and as many StateHasChanged cascades.
    [Parameter] public int ContrastPercent { get; set; } = 100;
    [Parameter] public int SaturationPercent { get; set; } = 100;
    [Parameter] public int BrightnessPercent { get; set; } = 100;
    [Parameter] public EventCallback<int> OnContrastPreview { get; set; }
    [Parameter] public EventCallback<int> OnContrastCommit { get; set; }
    [Parameter] public EventCallback<int> OnSaturationPreview { get; set; }
    [Parameter] public EventCallback<int> OnSaturationCommit { get; set; }
    [Parameter] public EventCallback<int> OnBrightnessPreview { get; set; }
    [Parameter] public EventCallback<int> OnBrightnessCommit { get; set; }
    /// <summary>Reset every channel to identity (100). Wired to a
    /// single callback rather than three separate
    /// SetXxxPercentAsync(100) calls so the parent can persist all
    /// three under one OnSettingsChanged broadcast.</summary>
    [Parameter] public EventCallback OnFilterReset { get; set; }

    // Collapsed by default -- the Layers panel opens compact, the user
    // expands only the sections they need. See agents.md "UX principles".
    private bool expanded = false;

    // Enablement reads directly from the iteration order above; do not
    // re-introduce a separate "active stack" projection -- having both
    // the z-stack and the visible-list as separate state lets them drift
    // and breaks the reorder arrows.

    // ---- Slider local-display state -------------------------------------
    // Why this exists: the slider uses the @oninput / @onchange split so
    // the chart updates live during drag (preview) but only persists on
    // release (commit). The parameter (Settings.ChartContrastPercent)
    // doesn't change until commit, so if we bound `value="@ContrastPercent"`
    // every parent re-render during a drag would snap the slider knob
    // back to the committed value while the user is still pulling it.
    // The fix: keep a private _displayX field that the input binds to,
    // updated locally on each oninput. OnParametersSet syncs from the
    // parameter only when the parameter ACTUALLY changes (commit landed,
    // or external reset), never on a render-pass-through. Net effect:
    // the slider tracks the user's drag without parent feedback fighting
    // the input element.
    private int _displayContrast = 100;
    private int _displaySaturation = 100;
    private int _displayBrightness = 100;
    // Last parameter values we synced from. Comparing the incoming
    // parameter against these tells us whether the parent is delivering
    // a NEW committed value or just re-rendering with the same one.
    private int _lastContrastParam = 100;
    private int _lastSaturationParam = 100;
    private int _lastBrightnessParam = 100;

    protected override void OnParametersSet()
    {
        if (ContrastPercent != _lastContrastParam)
        {
            _displayContrast = ContrastPercent;
            _lastContrastParam = ContrastPercent;
        }
        if (SaturationPercent != _lastSaturationParam)
        {
            _displaySaturation = SaturationPercent;
            _lastSaturationParam = SaturationPercent;
        }
        if (BrightnessPercent != _lastBrightnessParam)
        {
            _displayBrightness = BrightnessPercent;
            _lastBrightnessParam = BrightnessPercent;
        }
    }

    private async Task HandleContrastInput(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out int pct)) return;
        _displayContrast = Math.Clamp(pct, 50, 200);
        await OnContrastPreview.InvokeAsync(_displayContrast);
    }
    private Task HandleContrastCommit(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out int pct)) return Task.CompletedTask;
        _displayContrast = Math.Clamp(pct, 50, 200);
        return OnContrastCommit.InvokeAsync(_displayContrast);
    }

    private async Task HandleSaturationInput(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out int pct)) return;
        _displaySaturation = Math.Clamp(pct, 50, 200);
        await OnSaturationPreview.InvokeAsync(_displaySaturation);
    }
    private Task HandleSaturationCommit(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out int pct)) return Task.CompletedTask;
        _displaySaturation = Math.Clamp(pct, 50, 200);
        return OnSaturationCommit.InvokeAsync(_displaySaturation);
    }

    private async Task HandleBrightnessInput(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out int pct)) return;
        _displayBrightness = Math.Clamp(pct, 50, 150);
        await OnBrightnessPreview.InvokeAsync(_displayBrightness);
    }
    private Task HandleBrightnessCommit(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out int pct)) return Task.CompletedTask;
        _displayBrightness = Math.Clamp(pct, 50, 150);
        return OnBrightnessCommit.InvokeAsync(_displayBrightness);
    }

    private Task HandleResetClicked()
    {
        // Local display goes back to 100 immediately so the sliders
        // visibly snap; the OnFilterReset callback then persists, and
        // OnParametersSet re-syncs (no-op since values match).
        _displayContrast = 100;
        _displaySaturation = 100;
        _displayBrightness = 100;
        return OnFilterReset.InvokeAsync();
    }
}
