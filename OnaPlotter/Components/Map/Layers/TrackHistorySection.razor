@* Toggle + duration + resolution + within-bounds picker for the
   server-side position history overlay. Resolution mirrors the
   History page's ladder (1s..4h) so the helm can coarsen sampling
   when a long window (7d / all) is too dense to render fluidly, or
   when the SK history endpoint times out on a fine-grained span. *@

<SectionHeader Title="History"
               Expanded="@expanded"
               OnToggle="() => expanded = !expanded" />
@if (expanded)
{
    <label class="chart-item">
        <input type="checkbox" checked="@Visible"
               @onchange="(e) => OnToggle.InvokeAsync((bool)(e.Value ?? false))" />
        <div class="chart-item-body">
            <div class="chart-name">Show server track</div>
            <div class="chart-desc">Position history from SignalK</div>
        </div>
    </label>

    @if (Visible)
    {
        @* Indented options sit under the visibility toggle so the
           helm reads "track on / track off, here's how" rather than
           "three choices, which one's the master?". *@
        <div class="track-history-controls">
            <label class="chart-item track-history-row">
                <span class="chart-item-label">Duration</span>
                <select class="form-select form-select-sm track-history-select"
                        value="@Duration"
                        @onchange="OnDurationChange"
                        aria-label="Server track duration">
                    <option value="1h">Last 1 hour</option>
                    <option value="6h">Last 6 hours</option>
                    <option value="1d">Last 24 hours</option>
                    <option value="3d">Last 3 days</option>
                    <option value="7d">Last 7 days</option>
                    <option value="all">All time</option>
                </select>
            </label>
            @* Resolution ladder mirrors the History page exactly so the
               helm muscle-memory carries across. The "tacks / cruise"
               annotations on the extremes hint at the right tool: 1 s
               for short-window detail, 4 h to make a season-spanning
               window actually loadable. *@
            <label class="chart-item track-history-row">
                <span class="chart-item-label">Resolution</span>
                <select class="form-select form-select-sm track-history-select"
                        value="@Resolution"
                        @onchange="OnResolutionChange"
                        aria-label="Server track sampling resolution">
                    <option value="1s">1 s (sub-second tacks)</option>
                    <option value="30s">30 s</option>
                    <option value="1m">1 m</option>
                    <option value="5m">5 m</option>
                    <option value="15m">15 m</option>
                    <option value="30m">30 m</option>
                    <option value="1h">1 h</option>
                    <option value="4h">4 h (season review)</option>
                </select>
            </label>
            <label class="chart-item">
                <input type="checkbox" checked="@WithinBounds"
                       @onchange="(e) => OnWithinBoundsChanged.InvokeAsync((bool)(e.Value ?? false))" />
                <div class="chart-item-body">
                    <div class="chart-name">Within current view</div>
                    <div class="chart-desc">Filter to the chart area on screen now (no re-fetch)</div>
                </div>
            </label>
        </div>
    }
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public string Duration { get; set; } = "1d";
    /// <summary>Sampling resolution from the SK history ladder
    /// (1s..4h). Default "1m" matches the prior hardcoded value.</summary>
    [Parameter] public string Resolution { get; set; } = "1m";
    [Parameter] public bool WithinBounds { get; set; }
    [Parameter] public EventCallback<bool> OnToggle { get; set; }
    [Parameter] public EventCallback<string> OnDurationChanged { get; set; }
    [Parameter] public EventCallback<string> OnResolutionChanged { get; set; }
    [Parameter] public EventCallback<bool> OnWithinBoundsChanged { get; set; }

    private bool expanded = false;

    private async Task OnDurationChange(ChangeEventArgs e)
    {
        var v = e.Value?.ToString() ?? "1d";
        await OnDurationChanged.InvokeAsync(v);
    }

    private async Task OnResolutionChange(ChangeEventArgs e)
    {
        var v = e.Value?.ToString() ?? "1m";
        await OnResolutionChanged.InvokeAsync(v);
    }
}
