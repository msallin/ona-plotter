@* Own-ship layer toggles. One section gathers every chart layer
   that is "about my own boat":
     * Show ship lines  - COG vector + tidal current arrow
     * Show laylines    - close-hauled tack projections (sailing only)
     * Show local trail - in-memory SOG-coloured rolling polyline
     * Guard zone ring  - amber CPA-radius circle around own boat
     * Ship track       - server-side history polyline + its window /
                            resolution / within-bounds controls

   Bearing line + XTE tick are intentionally NOT in this group -
   they're navigation guidance, only show when a route is active, and
   hiding them mid-leg would be a foot-gun. *@

<SectionHeader Title="Own ship"
               Expanded="@expanded"
               OnToggle="() => expanded = !expanded" />
@if (expanded)
{
    <label class="chart-item">
        <input type="checkbox" checked="@ShipLinesVisible"
               @onchange="(e) => OnToggleShipLines.InvokeAsync((bool)(e.Value ?? false))" />
        <div class="chart-item-body">
            <div class="chart-name">Show ship lines</div>
            <div class="chart-desc">COG vector + tidal current arrow</div>
        </div>
    </label>
    @* Laylines: own toggle (used to ride on Show ship lines).
       Helms who don't sail close-hauled (motoring / cruising) want
       to leave laylines off without losing the COG vector + current
       arrow; helms who race want them visible without the chart
       chrome the master toggle controls. Two knobs cover both. *@
    <label class="chart-item">
        <input type="checkbox" checked="@LaylinesVisible"
               @onchange="(e) => OnToggleLaylines.InvokeAsync((bool)(e.Value ?? false))" />
        <div class="chart-item-body">
            <div class="chart-name">Show laylines</div>
            <div class="chart-desc">Port + stbd close-hauled tacks (sailing)</div>
        </div>
    </label>
    @* Guard zone ring: amber CPA-radius circle drawn around own
       boat. Lives here (rather than Misc) because it's an own-ship
       indicator and the helm flips it to declutter the area
       around the boat. Independent of the alarm pipeline - the
       CPA-alarm thresholds in Settings still drive the alarm
       regardless. *@
    <label class="chart-item">
        <input type="checkbox" checked="@GuardZoneVisible"
               @onchange="(e) => OnToggleGuardZone.InvokeAsync((bool)(e.Value ?? false))" />
        <div class="chart-item-body">
            <div class="chart-name">Guard zone ring</div>
            <div class="chart-desc">Amber CPA-radius circle around own boat. Alarm fires regardless.</div>
        </div>
    </label>

    @* Ship track = server-side history polyline. Was a separate
       Layers-panel section ("Server history" / "History" before
       that); helm-feedback consolidated all own-ship chart toggles
       into Own ship so the helm has one section to scan. The
       duration / resolution / within-bounds sub-controls only
       render when the layer is on - "track on / track off, here's
       how" reads cleaner than three peer-level pickers. *@
    <label class="chart-item">
        <input type="checkbox" checked="@ServerTrackVisible"
               @onchange="(e) => OnToggleServerTrack.InvokeAsync((bool)(e.Value ?? false))" />
        <div class="chart-item-body">
            <div class="chart-name">Ship track</div>
            <div class="chart-desc">Position history from SignalK</div>
        </div>
    </label>

    @if (ServerTrackVisible)
    {
        <div class="track-history-controls">
            @* Within-current-view sits ABOVE the duration / resolution
               dropdowns: it changes WHAT subset of the fetched track
               you see (clipping is a viewport filter), while the
               dropdowns change WHAT the server fetches. The viewport
               filter is the most-toggled control of the three for
               helms zooming in/out, so it earns the top slot. *@
            <label class="chart-item">
                <input type="checkbox" checked="@ServerTrackWithinBounds"
                       @onchange="(e) => OnToggleServerTrackWithinBounds.InvokeAsync((bool)(e.Value ?? false))" />
                <div class="chart-item-body">
                    <div class="chart-name">Within current view</div>
                    <div class="chart-desc">Filter to the chart area on screen now</div>
                </div>
            </label>
            <label class="chart-item track-history-row">
                <span class="chart-item-label">Duration</span>
                <select class="form-select form-select-sm track-history-select"
                        value="@ServerTrackDuration"
                        @onchange="OnDurationChange"
                        aria-label="Ship track duration">
                    <option value="1h">Last 1 hour</option>
                    <option value="6h">Last 6 hours</option>
                    <option value="1d">Last 24 hours</option>
                    <option value="3d">Last 3 days</option>
                    <option value="7d">Last 7 days</option>
                    <option value="all">All time</option>
                </select>
            </label>
            @* Resolution ladder mirrors the History page exactly so the
               helm muscle-memory carries across. The "tacks / cruise"
               annotations on the extremes hint at the right tool: 1 s
               for short-window detail, 4 h to make a season-spanning
               window actually loadable. *@
            <label class="chart-item track-history-row">
                <span class="chart-item-label">Resolution</span>
                <select class="form-select form-select-sm track-history-select"
                        value="@ServerTrackResolution"
                        @onchange="OnResolutionChange"
                        aria-label="Ship track sampling resolution">
                    <option value="1s">1 s (sub-second tacks)</option>
                    <option value="30s">30 s</option>
                    <option value="1m">1 m</option>
                    <option value="5m">5 m</option>
                    <option value="15m">15 m</option>
                    <option value="30m">30 m</option>
                    <option value="1h">1 h</option>
                    <option value="4h">4 h (season review)</option>
                </select>
            </label>
        </div>
    }
}

@code {
    [Parameter] public bool ShipLinesVisible { get; set; } = true;
    [Parameter] public EventCallback<bool> OnToggleShipLines { get; set; }
    [Parameter] public bool LaylinesVisible { get; set; }
    [Parameter] public EventCallback<bool> OnToggleLaylines { get; set; }
    [Parameter] public bool GuardZoneVisible { get; set; } = true;
    [Parameter] public EventCallback<bool> OnToggleGuardZone { get; set; }

    [Parameter] public bool ServerTrackVisible { get; set; }
    [Parameter] public string ServerTrackDuration { get; set; } = "1d";
    /// <summary>Sampling resolution from the SK history ladder
    /// (1s..4h). Default "1m" matches the prior hardcoded value.</summary>
    [Parameter] public string ServerTrackResolution { get; set; } = "1m";
    [Parameter] public bool ServerTrackWithinBounds { get; set; }
    [Parameter] public EventCallback<bool> OnToggleServerTrack { get; set; }
    [Parameter] public EventCallback<string> OnServerTrackDurationChanged { get; set; }
    [Parameter] public EventCallback<string> OnServerTrackResolutionChanged { get; set; }
    [Parameter] public EventCallback<bool> OnToggleServerTrackWithinBounds { get; set; }

    /// <summary>Default collapsed to match every other Layers section.
    /// Helm-feedback: opening Layers and immediately seeing Own ship
    /// expanded broke the visual rhythm - helms expect "all closed,
    /// tap what you want". Sticks at user-collapsed across renders;
    /// no separate persistence (consistent with sibling sections).</summary>
    private bool expanded = false;

    private async Task OnDurationChange(ChangeEventArgs e)
    {
        var v = e.Value?.ToString() ?? "1d";
        await OnServerTrackDurationChanged.InvokeAsync(v);
    }

    private async Task OnResolutionChange(ChangeEventArgs e)
    {
        var v = e.Value?.ToString() ?? "1m";
        await OnServerTrackResolutionChanged.InvokeAsync(v);
    }
}
