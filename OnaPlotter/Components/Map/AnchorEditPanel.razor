@* Two-state anchor panel matching signalk-anchoralarm-plugin v2.0.0+
   workflow: helm drops the pin first (no radius), then backs down +
   sets the radius once the boat has settled. The plugin's Incomplete
   Anchor Alarm guards the gap if the helm forgets step 2 - that fires
   as a server-side notification surfaced via the existing alarm
   bridge, not as panel state.

   The panel renders one of two layouts driven by Mode, set by the
   parent off Data.AnchorActive + Data.AnchorMaxRadius:
     - Drop:       no anchor active -> show only the "Drop" button.
     - SetRadius:  position published, radius pending -> show chips +
                   Auto + Set, no Drop button.
   The third state ("anchor fully armed") closes the panel entirely;
   the regular HUD card takes over.

   SetRadius UX: pick-then-Set with on-map preview.
     - Tapping a chip (numeric OR Auto) is a panel-internal pick:
       fires OnPreviewRadius(N) so the parent can update the on-map
       alarm ring to match the picked value. NO PUT yet. The helm
       sees the ring resize as they hover the chips.
     - Auto-pick + boat drift: when AutoPreviewRadius changes (parent
       recomputes between data ticks), the panel re-emits
       OnPreviewRadius with the new value as long as Auto is still
       picked, so the on-map ring grows in 5 m steps as the boat
       drifts further - the "Auto means whatever Auto says right
       now" model.
     - Tapping Set commits via OnSetRadius(effective). Parent does
       PUT navigation.anchor.maxRadius and closes the panel.
     - Close button visibility is parent-driven via ShowCloseButton:
       hidden during the two-step Drop->SetRadius continuation
       (helm committed to setting a radius and shouldn't bail
       half-way), shown when the panel was opened standalone from
       the anchor-watch HUD card to adjust an already-armed radius
       (helm needs a way to back out of an accidental open).

   Drop mode always shows a Close button - helm tapped Anchor
   accidentally and needs a way out before the drop.

   AutoPreviewRadius parameter: the parent's continuously-recomputed
   "what would Auto commit right now?" value. Renders inline on the
   Auto chip ("Auto: 47 m") so the helm sees the number. Null = no
   preview available yet (no anchor pin or no GPS); the Auto chip
   then renders as plain "Auto" and Set is disabled until either
   AutoPreviewRadius lands or the helm picks a numeric chip. *@

<div class="route-edit-bar anchor-edit-bar" role="dialog" aria-label="@AriaLabel">
    <span class="route-edit-stats anchor-edit-stats">
        <span class="anchor-edit-title">@TitleLabel</span>
        @* While moving, the sub-line becomes the drag instruction so
           the helm knows the pin is now grabbable; otherwise it shows
           the parent's suggestion / Auto-formula breakdown. *@
        @if (MoveActive)
        {
            <span class="anchor-edit-sub anchor-edit-moving">Drag the pin on the chart, then Set</span>
        }
        else if (!string.IsNullOrEmpty(SuggestionLabel))
        {
            <span class="anchor-edit-sub">@SuggestionLabel</span>
        }
    </span>

    @if (Mode == AnchorPanelMode.SetRadius)
    {
        @* Pick-then-Set chips. Tapping a chip is panel-internal -
           updates the active highlight and fires OnPreviewRadius so
           the parent can resize the on-map alarm ring as a visual
           preview. The PUT only fires when the helm taps Set. *@
        <div class="anchor-edit-chips" role="radiogroup" aria-label="Swing radius">
            <button class="map-btn anchor-edit-auto @(IsAutoActive ? "active" : "")"
                    type="button" role="radio"
                    aria-checked="@(IsAutoActive ? "true" : "false")"
                    @onclick="OnPickAuto"
                    title="@AutoTooltip"
                    disabled="@Busy">
                @if (AutoPreviewRadius is int autoR)
                {
                    <span>Auto:&nbsp;@autoR<span class="hud-unit">m</span></span>
                }
                else
                {
                    <span>Auto</span>
                }
            </button>
            @foreach (var preset in RadiusPresets)
            {
                var p = preset;
                <button class="map-btn @(IsNumericActive(p) ? "active" : "")"
                        type="button" role="radio"
                        aria-checked="@(IsNumericActive(p) ? "true" : "false")"
                        @onclick="() => OnPickNumeric(p)"
                        title="@p m swing radius"
                        disabled="@Busy">@p<span class="hud-unit">m</span></button>
            }
        </div>

        @* Move toggles the on-map drag handle so the helm can nudge
           the pin onto the actual lie of the chain (the plugin
           captures GPS at drop time, which can be a boat-length off).
           Panel-internal signal only - the parent owns the JS drag
           mode and the position PUT, which fires together with the
           radius on Set. Rendered only when the parent says the
           on-map anchor is actually draggable (CanMove). *@
        @if (CanMove)
        {
            <button class="map-btn anchor-edit-move @(MoveActive ? "active" : "")"
                    type="button"
                    aria-pressed="@(MoveActive ? "true" : "false")"
                    @onclick="OnMoveClicked"
                    disabled="@Busy"
                    title="@(MoveActive ? "Stop moving the anchor (drag the pin, then Set)" : "Move the anchor pin by dragging it on the chart")">
                @(MoveActive ? "Moving" : "Move")
            </button>
        }

        @* Set commits the picked value via PUT maxRadius (and the
           dragged position when move mode is active). Disabled
           when nothing effective has been picked (Auto picked but
           AutoPreviewRadius hasn't landed yet) or while a previous
           PUT is still in flight. *@
        <button class="map-btn active anchor-edit-set"
                type="button"
                @onclick="OnSetClicked"
                disabled="@(Busy || EffectiveRadius is null)"
                title="@(EffectiveRadius is int er ? $"Set alarm radius to {er} m" : "Pick a chip first")">
            @(Busy ? "Setting..." : "Set")
        </button>
        @* Close: shown only when the panel was opened standalone
           (helm tapped "Adjust" on the anchor-watch HUD card) so
           there's a way out of an accidental open without committing
           a new radius. Hidden during the Drop->SetRadius two-step
           continuation: at that point the helm has already committed
           to setting one, and bailing here would leave the anchor
           dropped without a radius (the plugin's Incomplete Anchor
           Alarm guards that, but a Close affordance there reads as
           "this is a normal exit" which it isn't). *@
        @if (ShowCloseButton)
        {
            <button class="map-btn" type="button"
                    @onclick="OnCancelClicked" disabled="@Busy"
                    title="Close without changing the alarm radius">Close</button>
        }
    }
    else
    {
        @* Drop state. No chips - the radius decision is deferred
           until the boat has actually settled. *@
        <button class="map-btn active anchor-edit-drop"
                @onclick="OnDropClicked" disabled="@Busy"
                title="@(Busy ? "Dropping..." : "Mark the anchor at the current GPS position; set the radius after backing down")">
            @(Busy ? "Dropping..." : "Drop")
        </button>
        <button class="map-btn" @onclick="OnCancelClicked" disabled="@Busy">Close</button>
    }
</div>

@code {
    /// <summary>Drives the two layouts. The parent picks the mode at
    /// open time off the current anchor state - not authoritative
    /// here, since a server-side raise mid-Set could move the panel
    /// out from under the helm; the parent re-evaluates on every
    /// data tick and closes the panel when the right state lands.</summary>
    public enum AnchorPanelMode { Drop, SetRadius }

    [Parameter, EditorRequired] public AnchorPanelMode Mode { get; set; } = AnchorPanelMode.Drop;

    /// <summary>Heuristic-derived initial radius in metres (only used
    /// in <see cref="AnchorPanelMode.SetRadius"/>). Same heuristic
    /// the v1 panel used: <c>AnchorRadiusHeuristic.Suggest</c>.
    /// Sentinel <see cref="UnseededInitialRadius"/> means "no opinion"
    /// - panel skips the snap-to-preset step and the chip row opens
    /// without an active numeric chip (Auto becomes the default).</summary>
    [Parameter] public int InitialRadiusMeters { get; set; } = UnseededInitialRadius;

    /// <summary>Sentinel for "parent has no initial-radius opinion"
    /// (e.g. Drop mode or no depth). Distinct from any valid preset.
    /// Picked as int.MinValue so a corrupted setting that lands on
    /// 0 still re-seeds correctly (0 was the previous in-range
    /// sentinel, which silently behaved like "snap to lowest preset"
    /// because of the round-up rule - a footgun for whoever next
    /// adds Drop-mode chip preview).</summary>
    public const int UnseededInitialRadius = int.MinValue;

    /// <summary>Parent's continuously-recomputed "Auto would commit
    /// this many metres" value. Renders inline on the Auto chip
    /// ("Auto: 47 m"). Drives both the chip face AND the on-map
    /// preview when Auto is the active pick: the panel re-emits
    /// <see cref="OnPreviewRadius"/> in OnParametersSet whenever
    /// this value changes while Auto is picked, so the helm sees
    /// the ring grow in 5 m steps as the boat drifts. Null = no
    /// preview available (no GPS or no anchor pin); Set is disabled
    /// in that state when Auto is the pick.</summary>
    [Parameter] public int? AutoPreviewRadius { get; set; }

    /// <summary>Parent-supplied helm-readable breakdown of the
    /// <see cref="AutoPreviewRadius"/> components, e.g.
    /// "swing 38 m + tide drop 4 m + 5 m margin". Surfaced as the
    /// Auto chip's tooltip so a long-press / hover reads the same
    /// summands the eyebrow shows (via the parent's SuggestionLabel
    /// fallback). Null = no breakdown available; chip falls back to
    /// a generic explanation in <see cref="AutoTooltip"/>.</summary>
    [Parameter] public string? AutoBreakdown { get; set; }

    /// <summary>True while the parent's drop / set callback is in
    /// flight (REST round-trip). Disables every button so a double-
    /// tap can't fire two PUTs.</summary>
    [Parameter] public bool Busy { get; set; }

    /// <summary>Optional source label for the "(suggestion)" subline
    /// in SetRadius mode (e.g. "5x 6m depth"). Empty hides the line.
    /// In Drop mode this can carry a one-line reminder ("back down
    /// before setting the radius") or be left empty.</summary>
    [Parameter] public string SuggestionLabel { get; set; } = "";

    /// <summary>Drop button tapped (Drop mode). No radius arg - step
    /// 2 carries that. Parent calls
    /// <c>IAnchorAlarmApi.DropAsync</c>.</summary>
    [Parameter] public EventCallback OnDrop { get; set; }

    /// <summary>Helm changed the picked chip (numeric OR Auto), or
    /// the live <see cref="AutoPreviewRadius"/> changed while Auto
    /// is the pick. Carries the resulting effective radius. Parent
    /// updates the on-map alarm ring as a visual preview - NO PUT.
    /// Distinct from <see cref="OnSetRadius"/> so the wire round-trip
    /// only fires on the explicit Set tap; the helm can hover chips
    /// and see the ring change without spamming PUTs.</summary>
    [Parameter] public EventCallback<int> OnPreviewRadius { get; set; }

    /// <summary>Set button tapped - commit the picked value via
    /// PUT maxRadius. Carries the effective radius AND whether the
    /// helm picked Auto vs a numeric chip, so the parent can
    /// remember intent and pre-select Auto again on a future Adjust
    /// reopen (otherwise an Auto-committed value snaps to the
    /// closest numeric chip on reopen and the helm reads it as a
    /// different choice from the one they made). Parent calls
    /// <c>IAnchorAlarmApi.SetMaxRadiusAsync(commit.RadiusMeters)</c>,
    /// stashes <c>commit.FromAuto</c>, and closes the panel on
    /// success.</summary>
    [Parameter] public EventCallback<AnchorSetCommit> OnSetRadius { get; set; }

    /// <summary>Payload for the OnSetRadius callback. The boolean
    /// carries the helm's intent (Auto vs numeric chip) so the
    /// parent can pre-select Auto on a future Adjust reopen instead
    /// of snapping the saved value to the closest preset chip.</summary>
    public readonly record struct AnchorSetCommit(int RadiusMeters, bool FromAuto);

    /// <summary>When true, seed the panel with Auto pre-selected
    /// regardless of <see cref="InitialRadiusMeters"/>. Parent flips
    /// this on whenever the last committed radius came from the
    /// Auto chip; flipped off when the helm committed a numeric
    /// chip. Default false preserves the v1 snap-to-preset behaviour
    /// for callers that don't track Auto-intent (and for fresh
    /// arming where no prior intent exists).</summary>
    [Parameter] public bool InitialPickIsAuto { get; set; }

    /// <summary>Cancel: parent closes the panel. Wired for both the
    /// Drop-mode Close button and the SetRadius-mode Close button
    /// (the latter only renders when <see cref="ShowCloseButton"/>
    /// is true).</summary>
    [Parameter] public EventCallback OnCancel { get; set; }

    /// <summary>Whether to render a Close button in
    /// <see cref="AnchorPanelMode.SetRadius"/>. Drop mode always
    /// shows one (parameter unread). Parent passes <c>true</c> when
    /// the panel was opened standalone (e.g. anchor-watch HUD's
    /// "Adjust" tap) so the helm can back out of an accidental open;
    /// passes <c>false</c> during the Drop -> SetRadius continuation
    /// where the helm has already committed to setting a radius.</summary>
    [Parameter] public bool ShowCloseButton { get; set; }

    /// <summary>Whether the Move button is offered. Parent passes
    /// <c>true</c> only when the on-map anchor is actually drawn and
    /// draggable; a Move button with nothing to grab would be a dead
    /// affordance. False (default) hides the button entirely.</summary>
    [Parameter] public bool CanMove { get; set; }

    /// <summary>Whether move mode is currently active. Parent-owned
    /// truth (the parent drives the JS drag handle), reflected here as
    /// the button's pressed state and the drag-instruction sub-line.</summary>
    [Parameter] public bool MoveActive { get; set; }

    /// <summary>Helm tapped Move. Carries the requested new state
    /// (<c>!MoveActive</c>) so the parent enables / disables the JS
    /// drag handle and flips <see cref="MoveActive"/>. The position
    /// PUT itself rides along with the radius on Set.</summary>
    [Parameter] public EventCallback<bool> OnToggleMove { get; set; }

    /// <summary>Helm-tunable anchor-radius presets (metres). 150 m
    /// dropped from the v1 set on field-study feedback - 5:1 scope
    /// at 30 m of water is already 150 m and that's deeper than the
    /// helm's typical anchorage; the chip was almost never picked
    /// and was crowding the row visually.</summary>
    private static readonly int[] RadiusPresets = [20, 30, 50, 75, 100];

    /// <summary>Internal pick state. Null = Auto picked (default for
    /// freshly-dropped anchor); int = numeric chip picked. Seeded
    /// from <see cref="InitialRadiusMeters"/> on first parameter set
    /// AND whenever InitialRadiusMeters changes externally (server
    /// echoed back a new MaxRadius). Helm chip taps update this
    /// without going through the parent so the panel can preview
    /// the new ring without the PUT round-trip.</summary>
    private int? _pickedNumeric;

    /// <summary>Last-seen InitialRadiusMeters; lets us detect external
    /// changes (vs. our own re-renders after a tap). When the parent
    /// pushes a new InitialRadiusMeters we re-seed
    /// <see cref="_pickedNumeric"/>; when our re-render is just a
    /// consequence of our own state change, _lastSeenInitial matches
    /// and we leave the pick alone.</summary>
    private int _lastSeenInitial = UnseededInitialRadius;

    /// <summary>Last preview value we emitted to the parent. Lets us
    /// dedupe the OnParametersSet re-emit path (boat-drift Auto)
    /// against the click-handler emit so the parent doesn't get a
    /// double-fire for one chip tap. Null = nothing emitted yet
    /// since the last open.</summary>
    private int? _lastEmittedPreview;

    private string TitleLabel => Mode switch
    {
        AnchorPanelMode.Drop => "Drop anchor",
        AnchorPanelMode.SetRadius => "Set alarm radius",
        _ => "Anchor",
    };

    private string AriaLabel => TitleLabel;

    /// <summary>Tooltip for the Auto chip. Surfaces the previewed
    /// number AND the parent-supplied breakdown so the helm reads
    /// "Auto: 47 m = swing 38 m + tide drop 4 m + 5 m margin" on
    /// long-press / hover. Field-study: the chip's title text is the
    /// helm's first hover-or-long-press touchpoint when they ask
    /// "what is this?". Falls back to a numbers-free explanation
    /// when no breakdown / no preview lands yet.</summary>
    private string AutoTooltip => (AutoPreviewRadius, AutoBreakdown) switch
    {
        (int r, string b) when !string.IsNullOrEmpty(b) => $"Auto: {r} m = {b}",
        (int r, _)                                       => $"Auto: {r} m",
        (null, string b) when !string.IsNullOrEmpty(b)  => b,
        _ => "Auto = swing + tide drop + 5 m margin (waiting for anchor pin / GPS)",
    };

    /// <summary>The radius that will actually ship if the helm taps
    /// Set right now. Numeric pick wins over Auto; Auto means
    /// "whatever AutoPreviewRadius currently is". Null when Auto is
    /// picked but no preview has landed (Set is disabled until
    /// then).</summary>
    private int? EffectiveRadius => _pickedNumeric ?? AutoPreviewRadius;

    /// <summary>Auto chip is "active" when no numeric pick has been
    /// made. Auto is the default (UnseededInitialRadius seeds null);
    /// stays Auto until the helm taps a numeric chip OR the parent
    /// passes an InitialRadiusMeters that snaps to a numeric preset.</summary>
    private bool IsAutoActive => _pickedNumeric is null;

    /// <summary>Numeric chip is "active" when its preset value matches
    /// the panel's pick. Snap-to-preset (round UP) so a server-armed
    /// value of e.g. 47 m highlights the 50 m chip (closest helm-
    /// friendly approximation).</summary>
    private bool IsNumericActive(int preset) =>
        _pickedNumeric is int n && SnapToPreset(n) == preset;

    /// <summary>Re-seed the pick whenever the parent pushes a new
    /// InitialRadiusMeters (panel just opened, or server echoed
    /// back a new MaxRadius). Re-emit OnPreviewRadius if the
    /// effective value changed - this is both the initial-mount
    /// emit (panel opens, parent draws the on-map ring) and the
    /// live boat-drift tracking (as the parent's AutoRadiusPreview()
    /// grows in 5 m steps with Auto picked, the ring follows).
    /// Suppressed while Busy so an in-flight Set PUT doesn't race
    /// a preview-driven JS interop call.</summary>
    protected override async Task OnParametersSetAsync()
    {
        if (InitialRadiusMeters != _lastSeenInitial)
        {
            _lastSeenInitial = InitialRadiusMeters;
            // InitialPickIsAuto wins over the snap-to-preset path:
            // an Adjust reopen of an Auto-committed anchor must keep
            // Auto pre-selected, otherwise the panel's pick reads as
            // a different choice from the one the helm actually
            // made. Numeric-committed radius still snaps to its
            // closest preset chip so the chip face matches the
            // server value.
            _pickedNumeric = (InitialPickIsAuto || InitialRadiusMeters == UnseededInitialRadius)
                ? null
                : SnapToPreset(InitialRadiusMeters);
        }

        if (Mode != AnchorPanelMode.SetRadius)
        {
            // Drop mode: no preview to emit. Reset _lastEmittedPreview
            // so the next open of SetRadius starts fresh.
            _lastEmittedPreview = null;
            return;
        }

        if (Busy) return;       // see XML doc - avoid PUT-vs-preview race.

        if (EffectiveRadius is int e && e != _lastEmittedPreview)
        {
            _lastEmittedPreview = e;
            await OnPreviewRadius.InvokeAsync(e);
        }
    }

    /// <summary>Tap a numeric chip. Updates the panel's pick and
    /// emits OnPreviewRadius so the parent resizes the on-map ring.
    /// Does NOT commit (no PUT) - helm has to tap Set for that.</summary>
    private async Task OnPickNumeric(int radius)
    {
        if (Busy) return;
        _pickedNumeric = radius;
        _lastEmittedPreview = radius;
        await OnPreviewRadius.InvokeAsync(radius);
    }

    /// <summary>Tap Auto. Clears any numeric pick so the panel falls
    /// back to AutoPreviewRadius. Emits OnPreviewRadius if a live
    /// AutoPreviewRadius is available so the helm sees the on-map
    /// ring snap to the Auto value immediately.</summary>
    private async Task OnPickAuto()
    {
        if (Busy) return;
        _pickedNumeric = null;
        if (AutoPreviewRadius is int r)
        {
            _lastEmittedPreview = r;
            await OnPreviewRadius.InvokeAsync(r);
        }
        // No preview available yet (still loading) - chip is
        // visually picked but Set will stay disabled until
        // AutoPreviewRadius lands.
    }

    /// <summary>Tap Set. Commits the effective radius via PUT. The
    /// parent closes the panel on success. Skipped when nothing
    /// effective is picked (e.g., Auto active but
    /// AutoPreviewRadius is still null). The commit payload carries
    /// the Auto-vs-numeric source so the parent can stash intent for
    /// a future Adjust reopen.</summary>
    private async Task OnSetClicked()
    {
        if (Busy) return;
        if (EffectiveRadius is not int e) return;
        await OnSetRadius.InvokeAsync(new AnchorSetCommit(e, IsAutoActive));
    }

    private async Task OnDropClicked()
    {
        if (Busy) return;
        await OnDrop.InvokeAsync();
    }

    /// <summary>Toggle move mode. Emits the requested next state so
    /// the parent enables / disables the JS drag handle. Guarded on
    /// Busy so a move toggle can't race an in-flight Set PUT.</summary>
    private async Task OnMoveClicked()
    {
        if (Busy) return;
        await OnToggleMove.InvokeAsync(!MoveActive);
    }

    private async Task OnCancelClicked()
    {
        if (Busy) return;
        await OnCancel.InvokeAsync();
    }


    /// <summary>Smallest preset >= radius. Same round-up rationale as
    /// v1 - 5:1 scope is the cruising-rule-of-thumb minimum, rounding
    /// down would silently drop below that.</summary>
    private static int SnapToPreset(int radius)
    {
        for (int i = 0; i < RadiusPresets.Length; i++)
        {
            if (RadiusPresets[i] >= radius) return RadiusPresets[i];
        }
        return RadiusPresets[^1];
    }
}
