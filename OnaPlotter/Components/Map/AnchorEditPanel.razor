@* Two-state anchor panel matching signalk-anchoralarm-plugin v2.0.0+
   workflow: helm drops the pin first (no radius), then backs down +
   sets the radius once the boat has settled. The plugin's Incomplete
   Anchor Alarm guards the gap if the helm forgets step 2 -- that fires
   as a server-side notification surfaced via the existing alarm
   bridge, not as panel state.

   The panel renders one of two layouts driven by Mode, set by the
   parent off Data.AnchorActive + Data.AnchorMaxRadius:
     - Drop:       no anchor active -> show only the "Drop" button.
     - SetRadius:  position published, radius pending -> show chips +
                   Auto, no Drop button.
   The third state ("anchor fully armed") closes the panel entirely;
   the regular HUD card takes over.

   Cancel is symmetric: in Drop mode it just closes the panel without
   touching the server. In SetRadius mode it ALSO leaves the dropped
   pin in place -- the plugin keeps the position armed; the helm can
   re-open the panel any time to set the radius. *@

<div class="route-edit-bar anchor-edit-bar" role="dialog" aria-label="@AriaLabel">
    <span class="route-edit-stats anchor-edit-stats">
        <span class="anchor-edit-title">@TitleLabel</span>
        @if (!string.IsNullOrEmpty(SuggestionLabel))
        {
            <span class="anchor-edit-sub">@SuggestionLabel</span>
        }
    </span>

    @if (Mode == AnchorPanelMode.SetRadius)
    {
        @* Auto chip + numeric chips. Auto bypasses the helm's chip
           pick and asks the plugin to compute the radius from the
           current GPS distance to the drop point + its fudge factor.
           Numeric chips PUT navigation.anchor.maxRadius with the
           helm's exact value. *@
        <div class="anchor-edit-chips" role="radiogroup" aria-label="Swing radius">
            <button class="map-btn anchor-edit-auto"
                    type="button" role="radio"
                    aria-checked="@(_picked is null ? "true" : "false")"
                    @onclick="OnPickAuto"
                    title="Plugin computes the radius from current distance to the anchor"
                    disabled="@Busy">
                Auto
            </button>
            @foreach (var preset in RadiusPresets)
            {
                var p = preset;
                <button class="map-btn @(p == _picked ? "active" : "")"
                        type="button" role="radio"
                        aria-checked="@(p == _picked ? "true" : "false")"
                        @onclick="() => OnPickNumeric(p)"
                        title="@p m swing radius"
                        disabled="@Busy">@p<span class="hud-unit">m</span></button>
            }
        </div>

        <button class="map-btn active anchor-edit-set"
                @onclick="OnSetClicked" disabled="@Busy"
                title="@(Busy ? "Setting..." : "Arm the alarm at the chosen radius")">
            @(Busy ? "Setting..." : "Set")
        </button>
        <button class="map-btn" @onclick="OnCancelClicked" disabled="@Busy">Cancel</button>
    }
    else
    {
        @* Drop state. No chips -- the radius decision is deferred
           until the boat has actually settled. *@
        <button class="map-btn active anchor-edit-drop"
                @onclick="OnDropClicked" disabled="@Busy"
                title="@(Busy ? "Dropping..." : "Mark the anchor at the current GPS position; set the radius after backing down")">
            @(Busy ? "Dropping..." : "Drop")
        </button>
        <button class="map-btn" @onclick="OnCancelClicked" disabled="@Busy">Cancel</button>
    }
</div>

@code {
    /// <summary>Drives the two layouts. The parent picks the mode at
    /// open time off the current anchor state -- not authoritative
    /// here, since a server-side raise mid-Set could move the panel
    /// out from under the helm; the parent re-evaluates on every
    /// data tick and closes the panel when the right state lands.</summary>
    public enum AnchorPanelMode { Drop, SetRadius }

    [Parameter, EditorRequired] public AnchorPanelMode Mode { get; set; } = AnchorPanelMode.Drop;

    /// <summary>Heuristic-derived initial radius in metres (only used
    /// in <see cref="AnchorPanelMode.SetRadius"/>). Same heuristic
    /// the v1 panel used: <c>AnchorRadiusHeuristic.Suggest</c>.</summary>
    [Parameter] public int InitialRadiusMeters { get; set; } = 30;

    /// <summary>True while the parent's drop / set callback is in
    /// flight (REST round-trip). Disables every button so a double-
    /// tap can't fire two PUTs.</summary>
    [Parameter] public bool Busy { get; set; }

    /// <summary>Optional source label for the "(suggestion)" subline
    /// in SetRadius mode (e.g. "5x 6m depth"). Empty hides the line.
    /// In Drop mode this can carry a one-line reminder ("back down
    /// before setting the radius") or be left empty.</summary>
    [Parameter] public string SuggestionLabel { get; set; } = "";

    /// <summary>Drop button tapped (Drop mode). No radius arg -- step
    /// 2 carries that. Parent calls
    /// <c>IAnchorAlarmApi.DropAtCurrentPositionAsync</c>.</summary>
    [Parameter] public EventCallback OnDrop { get; set; }

    /// <summary>Helm picked a numeric chip + tapped Set. Parent calls
    /// <c>IAnchorAlarmApi.SetMaxRadiusAsync(radius)</c>.</summary>
    [Parameter] public EventCallback<int> OnSetRadius { get; set; }

    /// <summary>Helm tapped Auto + Set. Parent calls
    /// <c>IAnchorAlarmApi.AutoSetRadiusAsync()</c>.</summary>
    [Parameter] public EventCallback OnAutoSetRadius { get; set; }

    /// <summary>Cancel: parent closes the panel. In SetRadius mode
    /// this leaves the dropped pin in place server-side; the helm
    /// can re-open later to finish step 2.</summary>
    [Parameter] public EventCallback OnCancel { get; set; }

    /// <summary>Same chip set as the v1 panel + the manual-anchor HUD
    /// card so the helm's anchor-radius vocabulary stays consistent
    /// across surfaces.</summary>
    private static readonly int[] RadiusPresets = [20, 30, 50, 75, 100, 150];

    /// <summary>Currently-picked numeric chip; null = Auto chip is
    /// active. Distinct nullable so the renderer can highlight
    /// EITHER Auto OR a numeric, never both.</summary>
    private int? _picked;
    private int _seededFromInitial = int.MinValue;

    private string TitleLabel => Mode switch
    {
        AnchorPanelMode.Drop => "Drop anchor",
        AnchorPanelMode.SetRadius => "Set alarm radius",
        _ => "Anchor",
    };

    private string AriaLabel => TitleLabel;

    protected override void OnParametersSet()
    {
        // Snap onto the nearest preset (rounded UP, see SnapToPreset)
        // when the parent passes a fresh InitialRadiusMeters. Same
        // sentinel-based "only re-seed on change" guard as v1 so an
        // unrelated parent re-render doesn't clobber the helm's chip
        // pick mid-decision.
        if (InitialRadiusMeters != _seededFromInitial)
        {
            _seededFromInitial = InitialRadiusMeters;
            _picked = SnapToPreset(InitialRadiusMeters);
        }
    }

    private void OnPickNumeric(int radius) => _picked = radius;

    private void OnPickAuto() => _picked = null;

    private async Task OnDropClicked()
    {
        if (Busy) return;
        await OnDrop.InvokeAsync();
    }

    private async Task OnSetClicked()
    {
        if (Busy) return;
        if (_picked is int r)
        {
            await OnSetRadius.InvokeAsync(r);
        }
        else
        {
            await OnAutoSetRadius.InvokeAsync();
        }
    }

    private async Task OnCancelClicked()
    {
        if (Busy) return;
        await OnCancel.InvokeAsync();
    }

    /// <summary>Smallest preset >= radius. Same round-up rationale as
    /// v1 -- 5:1 scope is the cruising-rule-of-thumb minimum, rounding
    /// down would silently drop below that.</summary>
    private static int SnapToPreset(int radius)
    {
        for (int i = 0; i < RadiusPresets.Length; i++)
        {
            if (RadiusPresets[i] >= radius) return RadiusPresets[i];
        }
        return RadiusPresets[^1];
    }
}
