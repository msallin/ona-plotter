@* Two-state anchor panel matching signalk-anchoralarm-plugin v2.0.0+
   workflow: helm drops the pin first (no radius), then backs down +
   sets the radius once the boat has settled. The plugin's Incomplete
   Anchor Alarm guards the gap if the helm forgets step 2 -- that fires
   as a server-side notification surfaced via the existing alarm
   bridge, not as panel state.

   The panel renders one of two layouts driven by Mode, set by the
   parent off Data.AnchorActive + Data.AnchorMaxRadius:
     - Drop:       no anchor active -> show only the "Drop" button.
     - SetRadius:  position published, radius pending -> show chips +
                   Auto, no Drop button.
   The third state ("anchor fully armed") closes the panel entirely;
   the regular HUD card takes over.

   "Close" instead of "Cancel": field-study sailors uniformly read
   "Cancel" as "abort the anchor" -- but in SetRadius mode the
   dropped pin stays armed server-side. Naming the action "Close"
   matches what the button actually does ("dismiss this card") and
   removes the dangerous misread (silent armed state after what the
   helm thought was an abort).

   AutoPreviewRadius parameter: when the helm taps Auto, the parent
   asynchronously computes what the plugin WOULD set + feeds it
   back here. The chip then renders as "Auto: 47 m" instead of a
   black-box "Auto" chip -- field-study finding (both sailors
   wanted to see the number before committing). Null = no preview
   available yet (still loading, or no plugin). *@

<div class="route-edit-bar anchor-edit-bar" role="dialog" aria-label="@AriaLabel">
    <span class="route-edit-stats anchor-edit-stats">
        <span class="anchor-edit-title">@TitleLabel</span>
        @if (!string.IsNullOrEmpty(SuggestionLabel))
        {
            <span class="anchor-edit-sub">@SuggestionLabel</span>
        }
    </span>

    @if (Mode == AnchorPanelMode.SetRadius)
    {
        @* Auto chip + numeric chips. Auto bypasses the helm's chip
           pick and asks the plugin to compute the radius from the
           current GPS distance to the drop point + its fudge factor.
           Numeric chips PUT navigation.anchor.maxRadius with the
           helm's exact value. *@
        <div class="anchor-edit-chips" role="radiogroup" aria-label="Swing radius">
            <button class="map-btn anchor-edit-auto @(picked is null ? "active" : "")"
                    type="button" role="radio"
                    aria-checked="@(picked is null ? "true" : "false")"
                    @onclick="OnPickAuto"
                    title="@AutoTooltip"
                    disabled="@Busy">
                @* Auto-preview label: "Auto" alone when no preview,
                   "Auto: N m" when the parent computed one. Field-
                   study sailors needed to see the number before
                   committing -- a black-box "Auto" chip didn't
                   build trust. *@
                @if (AutoPreviewRadius is int autoR)
                {
                    <span>Auto:&nbsp;@autoR<span class="hud-unit">m</span></span>
                }
                else
                {
                    <span>Auto</span>
                }
            </button>
            @foreach (var preset in RadiusPresets)
            {
                var p = preset;
                <button class="map-btn @(p == picked ? "active" : "")"
                        type="button" role="radio"
                        aria-checked="@(p == picked ? "true" : "false")"
                        @onclick="() => OnPickNumeric(p)"
                        title="@p m swing radius"
                        disabled="@Busy">@p<span class="hud-unit">m</span></button>
            }
        </div>

        <button class="map-btn active anchor-edit-set"
                @onclick="OnSetClicked" disabled="@Busy"
                title="@(Busy ? "Setting..." : "Set the alarm radius to the chosen value")">
            @(Busy ? "Setting..." : "Set")
        </button>
        @* Raise button only renders when the helm is REVISITING the
           panel on an already-armed anchor (CanRaise=true). On the
           first arming (panel auto-flipped from Drop), the helm
           hasn't committed a radius yet -- nothing to raise -- so
           the button stays hidden. Two-tap arm-then-confirm pattern
           matches the previous Anchor-button raise gesture: first
           tap flips the label to "Tap again to raise" for 3 s; a
           second tap within the window fires OnRaise. *@
        @if (CanRaise)
        {
            <button class="map-btn anchor-edit-raise @(_raiseArmed ? "anchor-edit-raise-armed" : "")"
                    @onclick="OnRaiseClicked" disabled="@Busy"
                    title="@(_raiseArmed ? "Tap again within 3 s to confirm" : "Raise the anchor (two-tap to confirm)")">
                @(_raiseArmed ? "Tap to raise" : "Raise")
            </button>
        }
        <button class="map-btn" @onclick="OnCancelClicked" disabled="@Busy">Close</button>
    }
    else
    {
        @* Drop state. No chips -- the radius decision is deferred
           until the boat has actually settled. *@
        <button class="map-btn active anchor-edit-drop"
                @onclick="OnDropClicked" disabled="@Busy"
                title="@(Busy ? "Dropping..." : "Mark the anchor at the current GPS position; set the radius after backing down")">
            @(Busy ? "Dropping..." : "Drop")
        </button>
        <button class="map-btn" @onclick="OnCancelClicked" disabled="@Busy">Close</button>
    }
</div>

@code {
    /// <summary>Drives the two layouts. The parent picks the mode at
    /// open time off the current anchor state -- not authoritative
    /// here, since a server-side raise mid-Set could move the panel
    /// out from under the helm; the parent re-evaluates on every
    /// data tick and closes the panel when the right state lands.</summary>
    public enum AnchorPanelMode { Drop, SetRadius }

    [Parameter, EditorRequired] public AnchorPanelMode Mode { get; set; } = AnchorPanelMode.Drop;

    /// <summary>Heuristic-derived initial radius in metres (only used
    /// in <see cref="AnchorPanelMode.SetRadius"/>). Same heuristic
    /// the v1 panel used: <c>AnchorRadiusHeuristic.Suggest</c>.
    /// Sentinel <see cref="UnseededInitialRadius"/> means "no opinion"
    /// -- panel skips the snap-to-preset step and the chip row opens
    /// without an active numeric chip (Auto becomes the default).</summary>
    [Parameter] public int InitialRadiusMeters { get; set; } = UnseededInitialRadius;

    /// <summary>Sentinel for "parent has no initial-radius opinion"
    /// (e.g. Drop mode or no depth). Distinct from any valid preset.
    /// Picked as int.MinValue so a corrupted setting that lands on
    /// 0 still re-seeds correctly (0 was the previous in-range
    /// sentinel, which silently behaved like "snap to lowest preset"
    /// because of the round-up rule -- a footgun for whoever next
    /// adds Drop-mode chip preview).</summary>
    public const int UnseededInitialRadius = int.MinValue;

    /// <summary>Plugin-computed preview of what Auto would commit
    /// (metres). Null = no preview available (still loading, or no
    /// plugin). Renders inline on the Auto chip ("Auto: 47 m") so
    /// the helm sees the number before committing -- field-study
    /// finding from Margaret + Jordan: a black-box Auto didn't
    /// build trust.</summary>
    [Parameter] public int? AutoPreviewRadius { get; set; }

    /// <summary>True while the parent's drop / set callback is in
    /// flight (REST round-trip). Disables every button so a double-
    /// tap can't fire two PUTs.</summary>
    [Parameter] public bool Busy { get; set; }

    /// <summary>Optional source label for the "(suggestion)" subline
    /// in SetRadius mode (e.g. "5x 6m depth"). Empty hides the line.
    /// In Drop mode this can carry a one-line reminder ("back down
    /// before setting the radius") or be left empty.</summary>
    [Parameter] public string SuggestionLabel { get; set; } = "";

    /// <summary>Drop button tapped (Drop mode). No radius arg -- step
    /// 2 carries that. Parent calls
    /// <c>IAnchorAlarmApi.DropAtCurrentPositionAsync</c>.</summary>
    [Parameter] public EventCallback OnDrop { get; set; }

    /// <summary>Helm picked a numeric chip + tapped Set. Parent calls
    /// <c>IAnchorAlarmApi.SetMaxRadiusAsync(radius)</c>.</summary>
    [Parameter] public EventCallback<int> OnSetRadius { get; set; }

    /// <summary>Helm tapped Auto + Set. Parent calls
    /// <c>IAnchorAlarmApi.AutoSetRadiusAsync()</c>.</summary>
    [Parameter] public EventCallback OnAutoSetRadius { get; set; }

    /// <summary>Cancel: parent closes the panel. In SetRadius mode
    /// this leaves the dropped pin in place server-side; the helm
    /// can re-open later to finish step 2.</summary>
    [Parameter] public EventCallback OnCancel { get; set; }

    /// <summary>Helm requested raise from inside the panel (after
    /// the two-tap arm-then-confirm pattern resolved). Parent calls
    /// <c>IAnchorAlarmApi.RaiseAsync()</c>. Only fires when
    /// <see cref="CanRaise"/> is true (panel was opened on an
    /// already-armed anchor for adjustment).</summary>
    [Parameter] public EventCallback OnRaise { get; set; }

    /// <summary>True when the panel is being re-opened on an
    /// already-armed anchor (helm came back to adjust the radius,
    /// or to raise). Drives the Raise-button visibility. False on
    /// the first-arming flow (just dropped, no radius yet); the
    /// Raise button stays hidden because there's nothing to
    /// raise from. Default false so existing call sites that don't
    /// pass it stay in the conservative "no raise" state.</summary>
    [Parameter] public bool CanRaise { get; set; } = false;

    /// <summary>How long the Raise button stays armed after the
    /// first tap before reverting. Matches the existing Anchor-
    /// button arm-then-confirm gesture window. 3 s is field-tested
    /// long enough to confirm without being so long that an
    /// accidental first tap leaves the button armed indefinitely.</summary>
    private const int RaiseArmTimeoutSec = 3;

    /// <summary>Helm-tunable anchor-radius presets (metres). 150 m
    /// dropped from the v1 set on field-study feedback -- 5:1 scope
    /// at 30 m of water is already 150 m and that's deeper than the
    /// helm's typical anchorage; the chip was almost never picked
    /// and was crowding the row visually.</summary>
    private static readonly int[] RadiusPresets = [20, 30, 50, 75, 100];

    /// <summary>Currently-picked numeric chip; null = Auto chip is
    /// active. Distinct nullable so the renderer can highlight
    /// EITHER Auto OR a numeric, never both.</summary>
    private int? picked;
    /// <summary>Tracks the most recently seeded InitialRadiusMeters
    /// value so an unrelated parent re-render with the same value
    /// doesn't clobber the helm's chip pick. Plain bool + value
    /// instead of a sentinel-overload so int.MinValue stays safely
    /// usable as the "no opinion" parameter sentinel.</summary>
    private bool seeded;
    private int seededValue;

    private string TitleLabel => Mode switch
    {
        AnchorPanelMode.Drop => "Drop anchor",
        AnchorPanelMode.SetRadius => "Set alarm radius",
        _ => "Anchor",
    };

    private string AriaLabel => TitleLabel;

    /// <summary>Tooltip for the Auto chip. Surfaces the previewed
    /// number when present so the helm gets the same information
    /// in the long-press tooltip as on the chip face. Field-study:
    /// the chip's title text is the helm's first hover-or-long-
    /// press touchpoint when they ask "what is this?".</summary>
    private string AutoTooltip => AutoPreviewRadius is int r
        ? $"Plugin-computed radius: {r} m (current distance to anchor + safety margin)"
        : "Plugin computes the radius from current distance to the anchor";

    protected override void OnParametersSet()
    {
        // Snap onto the nearest preset (rounded UP, see SnapToPreset)
        // when the parent passes a fresh InitialRadiusMeters. The
        // "only re-seed on change" guard prevents an unrelated parent
        // re-render from clobbering the helm's chip pick mid-decision.
        // UnseededInitialRadius means "Drop mode / no opinion" --
        // skip the seed entirely so picked stays null and the Auto
        // chip is the implicit active.
        if (!seeded || InitialRadiusMeters != seededValue)
        {
            seeded = true;
            seededValue = InitialRadiusMeters;
            picked = InitialRadiusMeters == UnseededInitialRadius
                ? null
                : SnapToPreset(InitialRadiusMeters);
        }
    }

    private void OnPickNumeric(int radius) => picked = radius;

    private void OnPickAuto() => picked = null;

    private async Task OnDropClicked()
    {
        if (Busy) return;
        await OnDrop.InvokeAsync();
    }

    private async Task OnSetClicked()
    {
        if (Busy) return;
        if (picked is int r)
        {
            await OnSetRadius.InvokeAsync(r);
        }
        else
        {
            await OnAutoSetRadius.InvokeAsync();
        }
    }

    private async Task OnCancelClicked()
    {
        if (Busy) return;
        await OnCancel.InvokeAsync();
    }

    /// <summary>Arm-then-confirm Raise. First tap flips the button
    /// label + sets a timer to disarm; second tap within the
    /// <see cref="RaiseArmTimeoutSec"/> window fires OnRaise.
    /// Mirrors the existing Anchor-button raise gesture (two-tap
    /// confirm) so the helm's muscle memory carries over.
    /// <para>Timer reset on each first-tap so a held-finger
    /// doesn't pre-disarm; ResetRaiseAfter implements the
    /// auto-disarm via fire-and-forget Task.Delay (we don't keep
    /// a CTS because the click handler's gate makes a stale-tick
    /// no-op; the visual state just decays.</para></summary>
    private bool _raiseArmed;
    private DateTime _raiseArmedUtc;

    private async Task OnRaiseClicked()
    {
        if (Busy) return;
        if (_raiseArmed && (DateTime.UtcNow - _raiseArmedUtc).TotalSeconds <= RaiseArmTimeoutSec)
        {
            _raiseArmed = false;
            await OnRaise.InvokeAsync();
            return;
        }
        // First tap: arm.
        _raiseArmed = true;
        _raiseArmedUtc = DateTime.UtcNow;
        // Auto-disarm after the timeout so the button doesn't stay
        // armed indefinitely if the helm walks away.
        _ = Task.Delay(TimeSpan.FromSeconds(RaiseArmTimeoutSec))
            .ContinueWith(_ =>
            {
                _raiseArmed = false;
                InvokeAsync(StateHasChanged);
            }, TaskScheduler.Default);
    }

    /// <summary>Smallest preset >= radius. Same round-up rationale as
    /// v1 -- 5:1 scope is the cruising-rule-of-thumb minimum, rounding
    /// down would silently drop below that.</summary>
    private static int SnapToPreset(int radius)
    {
        for (int i = 0; i < RadiusPresets.Length; i++)
        {
            if (RadiusPresets[i] >= radius) return RadiusPresets[i];
        }
        return RadiusPresets[^1];
    }
}
