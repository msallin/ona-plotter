@* Instrument gauge page with circular SVG gauges for key navigation values. *@

@page "/gauges"
@using OnaPlotter.Services
@using OnaPlotter.Components.Gauges
@using static OnaPlotter.Components.Gauges.CircularGauge
@implements IDisposable
@inject SignalkClient SignalkClient

<PageTitle>Gauges</PageTitle>

<h2>Instruments</h2>

<div class="row g-4 justify-content-center">
    <div class="col-6 col-md-auto">
        <CircularGauge Label="Speed Over Ground"
                       Value="@SogKn" Min="0" Max="15" Unit="kn"
                       TickCount="5" ValueFormat="F1"
                       Zones="@sogZones" />
    </div>
    <div class="col-6 col-md-auto">
        <CircularGauge Label="Heading"
                       Value="@HeadingDeg" Min="0" Max="360" Unit="deg"
                       TickCount="8" ValueFormat="F0" TickFormat="F0"
                       Zones="@headingZones" />
    </div>
    <div class="col-6 col-md-auto">
        <CircularGauge Label="Depth"
                       Value="@Data.Depth" Min="0" Max="50" Unit="m"
                       TickCount="5" ValueFormat="F1"
                       Zones="@depthZones" />
    </div>
    <div class="col-6 col-md-auto">
        <CircularGauge Label="Wind Speed"
                       Value="@WindSpeedKn" Min="0" Max="40" Unit="kn"
                       TickCount="4" ValueFormat="F1"
                       Zones="@windSpeedZones" />
    </div>
    <div class="col-6 col-md-auto">
        <CircularGauge Label="Wind Angle"
                       Value="@WindAngleDeg" Min="-180" Max="180" Unit="deg"
                       TickCount="6" ValueFormat="F0" TickFormat="F0" />
    </div>
    <div class="col-6 col-md-auto">
        <CircularGauge Label="True Wind Speed"
                       Value="@TrueWindSpeedKn" Min="0" Max="40" Unit="kn"
                       TickCount="4" ValueFormat="F1"
                       Zones="@windSpeedZones" />
    </div>
    <div class="col-6 col-md-auto">
        <CircularGauge Label="True Wind Angle"
                       Value="@TrueWindAngleDeg" Min="-180" Max="180" Unit="deg"
                       TickCount="6" ValueFormat="F0" TickFormat="F0" />
    </div>
</div>

@code {
    private Models.NavigationData Data => SignalkClient.Data;

    private double? SogKn => Data.SpeedOverGround * Format.MsToKnots;
    private double? HeadingDeg => Data.Heading * Format.RadToDeg;
    private double? WindSpeedKn => Data.WindSpeedApparent * Format.MsToKnots;
    private double? WindAngleDeg => Data.WindAngleApparent * Format.RadToDeg;
    private double? TrueWindSpeedKn => Data.WindSpeedTrue * Format.MsToKnots;
    private double? TrueWindAngleDeg => Data.WindAngleTrue * Format.RadToDeg;

    // Colour zones reference the theme tokens (--sev-ok / --sev-warn /
    // --sev-danger) via CSS var() so night mode -- which red-shifts
    // the --sev-* palette -- affects the gauges too. Hard-coded hex
    // (#4ade80 etc.) would have kept bright green/yellow/red rings
    // regardless of the theme, defeating the dark-adaptation the
    // night preset exists to preserve.
    private static readonly List<GaugeZone> sogZones =
    [
        new(0, 8, "var(--sev-ok)"),
        new(8, 12, "var(--sev-warn)"),
        new(12, 15, "var(--sev-danger)")
    ];

    private static readonly List<GaugeZone> depthZones =
    [
        new(0, 3, "var(--sev-danger)"),
        new(3, 8, "var(--sev-warn)"),
        new(8, 50, "var(--sev-ok)")
    ];

    private static readonly List<GaugeZone> windSpeedZones =
    [
        new(0, 15, "var(--sev-ok)"),
        new(15, 25, "var(--sev-warn)"),
        new(25, 40, "var(--sev-danger)")
    ];

    // Heading: compass quadrant shading (muted, informational only).
    // Accent tokens rather than the severity triad -- these are just
    // cardinal-direction bands, not safety states.
    private static readonly List<GaugeZone> headingZones =
    [
        new(0, 90, "var(--sev-ok)"),
        new(90, 180, "var(--sk-accent)"),
        new(180, 270, "var(--sev-warn)"),
        new(270, 360, "var(--sk-purple)")
    ];

    protected override void OnInitialized()
    {
        SignalkClient.OnDataChanged += HandleDataChanged;
    }

    private async void HandleDataChanged()
    {
        // async void event handler: any uncaught exception tears down the
        // Blazor SynchronizationContext. Swallow the expected post-dispose
        // cases so a quick page switch while data is arriving doesn't crash.
        try { await InvokeAsync(StateHasChanged); }
        catch (ObjectDisposedException) { }
    }

    public void Dispose()
    {
        SignalkClient.OnDataChanged -= HandleDataChanged;
    }
}
