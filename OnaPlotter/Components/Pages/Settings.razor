@* Settings: configurable alarm thresholds and preferences. *@

@page "/settings"
@using OnaPlotter.Services
@inject IAppSettings AppSettings
@inject IPolarService Polar
@inject IToastService Toasts

<PageTitle>Settings</PageTitle>

<h2>Settings</h2>

<div class="row g-4" style="max-width: 600px;">

    <div class="col-12">
        <h5 class="text-muted" style="font-size:0.8rem; text-transform:uppercase; letter-spacing:0.1em;">Alarms</h5>
    </div>

    <div class="col-sm-6">
        <div class="card">
            <div class="card-body">
                <label class="form-label">Depth Alarm</label>
                <div class="input-group">
                    <input type="number" class="form-control" step="0.5" min="0" max="50"
                           value="@AppSettings.DepthAlarmThreshold"
                           @onchange="(e) => OnDepthChanged(e)" />
                    <span class="input-group-text">m</span>
                </div>
                <small class="text-muted">Alert when depth is below this value.</small>
            </div>
        </div>
    </div>

    <div class="col-sm-6">
        <div class="card">
            <div class="card-body">
                <label class="form-label">CPA Alarm</label>
                <div class="input-group">
                    <input type="number" class="form-control" step="0.1" min="0" max="5"
                           value="@AppSettings.CpaAlarmThreshold"
                           @onchange="(e) => OnCpaChanged(e)" />
                    <span class="input-group-text">nm</span>
                </div>
                <small class="text-muted">Alert when a vessel is closer than this.</small>
            </div>
        </div>
    </div>

    <div class="col-sm-6">
        <div class="card">
            <div class="card-body">
                <label class="form-label">Wind Shift Alarm</label>
                <div class="input-group">
                    <input type="number" class="form-control" step="5" min="5" max="90"
                           value="@AppSettings.WindShiftAlarmThreshold"
                           @onchange="(e) => OnWindShiftChanged(e)" />
                    <span class="input-group-text">deg / 5min</span>
                </div>
                <small class="text-muted">Alert when TWD shifts more than this in 5 minutes.</small>
            </div>
        </div>
    </div>

    <div class="col-12 mt-3">
        <h5 class="text-muted" style="font-size:0.8rem; text-transform:uppercase; letter-spacing:0.1em;">Performance</h5>
    </div>

    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <label class="form-label">Boat Polars</label>
                @if (Polar.HasPolar)
                {
                    <p class="text-muted" style="font-size:0.8rem;">
                        Polar loaded: @Polar.TwaValues.Length TWA rows, @Polar.TwsValues.Length TWS columns
                        (TWS @Polar.TwsValues[0]-@Polar.TwsValues[^1] kn)
                    </p>
                    <button class="btn btn-sm btn-outline-danger" @onclick="ClearPolar">Remove Polar</button>
                }
                else
                {
                    <p class="text-muted" style="font-size:0.8rem;">
                        Upload a CSV polar file. Format: first column = TWA (degrees), header row = TWS (knots), cells = target speed (knots).
                    </p>
                }
                <div class="mt-2">
                    <label class="btn btn-sm btn-outline-secondary" style="cursor:pointer;">
                        Upload Polar CSV
                        <InputFile OnChange="HandlePolarUpload" Accept=".csv,.txt,.pol" style="display:none;" />
                    </label>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 mt-3">
        <h5 class="text-muted" style="font-size:0.8rem; text-transform:uppercase; letter-spacing:0.1em;">Display</h5>
    </div>

    <div class="col-sm-6">
        <div class="card">
            <div class="card-body">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" checked="@AppSettings.NightMode"
                           @onchange="(e) => OnNightModeChanged(e)" />
                    <label class="form-check-label">Night Mode</label>
                </div>
                <small class="text-muted">Red-shifted display for night vision.</small>
            </div>
        </div>
    </div>
</div>

@code {
    private async Task OnDepthChanged(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out double val) && val >= 0)
            await AppSettings.SetDepthAlarmThresholdAsync(val);
    }

    private async Task OnCpaChanged(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out double val) && val >= 0)
            await AppSettings.SetCpaAlarmThresholdAsync(val);
    }

    private async Task OnWindShiftChanged(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out double val) && val >= 5)
            await AppSettings.SetWindShiftAlarmThresholdAsync(val);
    }

    private async Task OnNightModeChanged(ChangeEventArgs e)
    {
        bool val = (bool)(e.Value ?? false);
        await AppSettings.SetNightModeAsync(val);
    }

    private async Task HandlePolarUpload(InputFileChangeEventArgs e)
    {
        try
        {
            using var reader = new System.IO.StreamReader(e.File.OpenReadStream(maxAllowedSize: 1024 * 1024));
            string csv = await reader.ReadToEndAsync();
            await Polar.ImportAsync(csv);
            Toasts.Success($"Polar loaded: {Polar.TwaValues.Length} TWA rows");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Toasts.Error($"Polar import failed: {ex.Message}");
        }
    }

    private async Task ClearPolar()
    {
        await Polar.ClearAsync();
        Toasts.Success("Polar cleared");
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Polar.InitializeAsync();
    }
}
