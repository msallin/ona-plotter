@* Settings: configurable alarm thresholds and preferences. *@

@page "/settings"
@using OnaPlotter.Services
@using OnaPlotter.Services.Api
@using Microsoft.AspNetCore.Components.Forms
@inject IAppSettings AppSettings
@inject IPolarService Polar
@inject IToastService Toasts
@inject IConfirmationService Confirmations
@inject OnaPlotter.Services.SignalkClient SignalkClient
@inject IJSRuntime JS
@inject ClientErrorRelay ErrorRelay
@inject INotificationsApi NotificationsApi
@inject NavigationManager Nav
@inject IAlarmManager Alarms

<PageTitle>Settings</PageTitle>

@* Settings page wraps every section in .app-page so the content
   centres at the same 1400px max-width gutter the Resources page
   already uses. Helm reported the page looked "strange" on a wide
   helm screen because the form widgets stretched edge-to-edge
   while every other page centred. *@
<div class="app-page">

@* Settings header: title on the left, build-stamp chip on the right.
   The chip (git short-hash + UTC build time) is pinned here rather
   than in the topbar because it's only useful when the helm is
   actually trying to diagnose "is my cached bundle stale?" - hiding
   it inside the Settings page keeps it out of the operational UI
   while staying one tap away. Values come from the generated
   BuildInfo.g.cs (see StampBuildInfo target in OnaPlotter.csproj). *@
<div class="d-flex align-items-start justify-content-between">
    <h1 class="mb-0">Settings</h1>
    <span class="build-stamp" title="Build identifier; useful when checking whether the browser loaded the latest bundle">
        build <code>@OnaPlotter.BuildInfo.CommitHash</code>
        <span class="build-stamp-time">@OnaPlotter.BuildInfo.BuildUtc UTC</span>
    </span>
</div>

@* Quick-jump filter. Matches against every form-label on the page;
   first match gets a subtle highlight and scrolls into view. Page is
   ~600 lines and growing - Ctrl-F works but scrolls past group
   headings, and the helm screen doesn't always have a physical
   keyboard. Clearing the input removes the highlight. *@
@* max-width 1200 (was 600) so iPad landscape + desktop actually use
   the available width; .col-sm-6 / .col-md-6 on individual cards then
   puts two settings cards side-by-side at >= 720 px instead of forcing
   a single column on a 1400 px iMac. The search input stays narrow. *@
<div class="mb-3" style="max-width: 600px;">
    <input type="search" class="form-control" placeholder="Find a setting (e.g. depth, snooze, polar)..."
           aria-label="Find a setting"
           value="@settingsFilter"
           @oninput="(e) => OnSettingsFilterInput(e)" />
</div>

<div class="row g-4" style="max-width: 1200px;">

    <div class="col-12">
        <h5 class="page-section-header">Mode</h5>
    </div>
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <label class="form-label">Sailing Mode</label>
                <div class="btn-group w-100" role="group" aria-label="Sailing mode">
                    @foreach (var (val, label, tip) in SailingModes)
                    {
                        <input type="radio" class="btn-check" name="sailing-mode"
                               id="@($"mode-{val}")" autocomplete="off"
                               checked="@(AppSettings.SailingMode == val)"
                               @onchange="() => OnSailingModeChanged(val)" />
                        <label class="btn btn-outline-secondary btn-sm" for="@($"mode-{val}")"
                               title="@tip">@label</label>
                    }
                </div>
                <small class="text-muted d-block mt-1">
                    Cruise: navigation emphasis (depth, anchor, route). Race: performance emphasis
                    (laylines, optimal TWA, target speed). Individual toggles still work in either mode;
                    the mode just picks sensible defaults and surfaces mode-specific overlays.
                </small>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <label class="form-label">Own vessel type</label>
                <div class="btn-group w-100" role="group" aria-label="Own vessel type">
                    <input type="radio" class="btn-check" name="own-vessel-type"
                           id="vessel-power" autocomplete="off"
                           checked="@(AppSettings.OwnVesselType == "power")"
                           @onchange="@(() => OnOwnVesselTypeChanged("power"))" />
                    <label class="btn btn-outline-secondary btn-sm" for="vessel-power"
                           title="Power-driven vessel under way">Power</label>

                    <input type="radio" class="btn-check" name="own-vessel-type"
                           id="vessel-sail" autocomplete="off"
                           checked="@(AppSettings.OwnVesselType == "sail")"
                           @onchange="@(() => OnOwnVesselTypeChanged("sail"))" />
                    <label class="btn btn-outline-secondary btn-sm" for="vessel-sail"
                           title="Sailing vessel under way">Sail</label>
                </div>
                <small class="text-muted d-block mt-1">
                    Drives COLREGS Rule 18 priority on the AIS popup + CPA banner. Set to "sail" when
                    you're under sail (engine off); leave at "power" when motoring or motor-sailing.
                    A sail-vs-power encounter resolves as power-gives-way regardless of crossing
                    geometry; same-type encounters use the standard Rule 13-15 classifier.
                </small>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <label class="form-check form-switch" style="margin:0;">
                    <input class="form-check-input" type="checkbox" role="switch"
                           checked="@AppSettings.KeepScreenAwake"
                           @onchange="OnKeepScreenAwakeChanged" />
                    <span class="form-check-label">Keep screen awake</span>
                </label>
                <small class="text-muted d-block mt-1">
                    Holds a Screen Wake Lock across the whole app so the tablet
                    doesn't doze mid-watch. Covers Chart, SailSteer, Wind,
                    History - not just the Map page. Turn off if running on
                    battery without shore power. Quiet no-op on browsers without
                    Wake Lock support.
                </small>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <label class="form-check form-switch" style="margin:0;">
                    <input class="form-check-input" type="checkbox" role="switch"
                           checked="@AppSettings.ShowKeyboardHints"
                           @onchange="OnShowKeyboardHintsChanged" />
                    <span class="form-check-label">Show keyboard shortcut hints</span>
                </label>
                <small class="text-muted d-block mt-1">
                    Adds the "(L)" / "(D)" letters to map control labels and
                    enables the <kbd>?</kbd> key to open the shortcuts card.
                    Off by default: on a touch device the letters are just
                    clutter. Turn on if you run OnaPlotter on a desktop with
                    a keyboard.
                </small>
                @* Re-open the welcome card. The card is normally one-shot
                   per device; helms who want to re-read the onboarding
                   click here. The page navigates to map?welcome=1 (NO
                   leading slash - absolute /map jumps off-mount under
                   the SignalK plugin path, e.g. /signalk-onaplotter/.
                   Same convention Resources.razor uses for its View /
                   Edit links). The Map page picks up the welcome=1
                   query in OnInitializedAsync, surfaces the card
                   regardless of the dismissed flag, and strips the
                   query in ApplyMapDeepLinkAsync after consume so a
                   reload doesn't loop. *@
                <button type="button" class="btn btn-link p-0 mt-2"
                        style="font-size:0.85rem;"
                        @onclick="@(() => Nav.NavigateTo("map?welcome=1"))">
                    Show welcome card again on the Map page
                </button>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <label class="form-check form-switch" style="margin:0;">
                    <input class="form-check-input" type="checkbox" role="switch"
                           checked="@AppSettings.ShowAutopilotHud"
                           @onchange="OnShowAutopilotHudChanged" />
                    <span class="form-check-label">Show autopilot control HUD</span>
                </label>
                <small class="text-muted d-block mt-1">
                    Shows the dedicated Autopilot card on the map with
                    Stby / Auto / Wind / Route engage modes and
                    -10 / -1 / +1 / +10 heading nudges. Off by default
                    because the engage buttons are easy to tap by accident
                    on a touch device. The extended HDG HUD still shows
                    the pilot's state, target, rudder angle, and heading
                    error when this is off.
                </small>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <label class="form-check form-switch" style="margin:0;">
                    <input class="form-check-input" type="checkbox" role="switch"
                           checked="@AppSettings.ShowRadarHud"
                           @onchange="OnShowRadarHudChanged" />
                    <span class="form-check-label">Show radar control HUD</span>
                </label>
                <small class="text-muted d-block mt-1">
                    Shows the dedicated Radar card on the map: status,
                    range stepper, and Standby / Transmit toggle. Transmit
                    requires a 600 ms hold to avoid an accidental tap
                    radiating with crew on the bow. When more than one
                    radar is detected the card has a picker to switch
                    between them. Hidden automatically when the SignalK
                    server has no radar plugin (Mayara, navico-sk, etc.).
                </small>
            </div>
        </div>
    </div>

    @* Chart upscale (overzoom). Off by default; helms who want extra
       detail past a chart's native max zoom turn it on. Levels stepper
       sits beside the master flag so the helm sees both controls
       together; only the level value matters when the flag is on. *@
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <label class="form-check form-switch" style="margin:0;">
                    <input class="form-check-input" type="checkbox" role="switch"
                           checked="@AppSettings.ChartUpscaleEnabled"
                           @onchange="OnChartUpscaleEnabledChanged" />
                    <span class="form-check-label">Chart upscale (overzoom)</span>
                </label>
                <small class="text-muted d-block mt-1">
                    Lets the helm zoom past a chart's native maximum.
                    Tiles at the native cap get GPU-upscaled to fill
                    higher zoom levels - pixelated but readable for
                    close-quarters work (reefs, harbour entries, dock
                    approaches). Above the cap + level limit, chart
                    tiles go blank and the OpenStreetMap fallback
                    shows through, which is the honest signal that
                    you've zoomed past real data. Removable in one
                    click if it doesn't behave on your charts.
                </small>
                <div class="mt-2 d-flex align-items-center gap-2"
                     style="@(AppSettings.ChartUpscaleEnabled ? "" : "opacity:0.5;")">
                    <label class="form-label mb-0" for="chart-upscale-levels">Levels:</label>
                    <input id="chart-upscale-levels"
                           type="number" class="form-control form-control-sm"
                           style="width:5rem;"
                           min="@OnaPlotter.Utilities.ChartUpscale.MinLevels"
                           max="@OnaPlotter.Utilities.ChartUpscale.MaxLevels"
                           step="1"
                           disabled="@(!AppSettings.ChartUpscaleEnabled)"
                           value="@AppSettings.ChartUpscaleLevels"
                           @onchange="OnChartUpscaleLevelsChanged" />
                    <small class="text-muted">
                        @* Each level doubles the upscale. 2 = 4x
                           (default), past 3 the chart is visibly
                           pixelated; past 4 you're really just
                           bilinear-interpolating. Helms doing
                           harbour pilotage sometimes ask for 4-5
                           anyway. *@
                        @(AppSettings.ChartUpscaleLevels switch
                        {
                            0 => "0 = no upscale (decorator off)",
                            1 => "1 = 2x upscale",
                            2 => "2 = 4x upscale (recommended)",
                            3 => "3 = 8x upscale (visibly pixelated)",
                            4 => "4 = 16x upscale (mostly mush)",
                            5 => "5 = 32x upscale (pilotage drill-down)",
                            _ => ""
                        })
                    </small>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 mt-3">
        <h5 class="page-section-header">Navigation</h5>
    </div>

    @* Heading / COG path preference. Most servers publish one of
       {true, magnetic} cleanly; some publish both but want the HUD
       to read consistently against paper charts. This picker selects
       which path wins; the other stays as a fallback so the HUD
       never goes blank when the preferred source is missing. *@
    <div class="col-sm-6">
        <div class="card">
            <div class="card-body">
                <label class="form-label">Heading source</label>
                <div class="btn-group w-100" role="group" aria-label="Heading reference">
                    <input type="radio" class="btn-check" id="hdg-true" name="hdg-ref"
                           checked="@(!AppSettings.PreferMagneticHeading)"
                           @onchange="() => OnHeadingPrefChanged(false)" />
                    <label class="btn btn-outline-secondary btn-sm" for="hdg-true">True</label>
                    <input type="radio" class="btn-check" id="hdg-mag" name="hdg-ref"
                           checked="@AppSettings.PreferMagneticHeading"
                           @onchange="() => OnHeadingPrefChanged(true)" />
                    <label class="btn btn-outline-secondary btn-sm" for="hdg-mag">Magnetic</label>
                </div>
                <small class="text-muted d-block mt-1">
                    <code>navigation.headingTrue</code> vs
                    <code>navigation.headingMagnetic</code>. Falls back to the
                    other path when the preferred one isn't published.
                    <span class="d-block">
                        Live: True =
                        @(SignalkClient.Data.HeadingTrue is double ht
                            ? (ht * 180.0 / System.Math.PI).ToString("F0") + "\u00B0" : "-"),
                        Magnetic =
                        @(SignalkClient.Data.HeadingMagnetic is double hm
                            ? (hm * 180.0 / System.Math.PI).ToString("F0") + "\u00B0" : "-")
                    </span>
                </small>
            </div>
        </div>
    </div>

    <div class="col-sm-6">
        <div class="card">
            <div class="card-body">
                <label class="form-label">Course Over Ground source</label>
                <div class="btn-group w-100" role="group" aria-label="COG reference">
                    <input type="radio" class="btn-check" id="cog-true" name="cog-ref"
                           checked="@(!AppSettings.PreferMagneticCourse)"
                           @onchange="() => OnCogPrefChanged(false)" />
                    <label class="btn btn-outline-secondary btn-sm" for="cog-true">True</label>
                    <input type="radio" class="btn-check" id="cog-mag" name="cog-ref"
                           checked="@AppSettings.PreferMagneticCourse"
                           @onchange="() => OnCogPrefChanged(true)" />
                    <label class="btn btn-outline-secondary btn-sm" for="cog-mag">Magnetic</label>
                </div>
                <small class="text-muted d-block mt-1">
                    <code>navigation.courseOverGroundTrue</code> vs
                    <code>navigation.courseOverGroundMagnetic</code>.
                    Independent of Heading so a true-GPS + magnetic-compass
                    boat can show the HUD on a single reference.
                    <span class="d-block">
                        Live: True =
                        @(SignalkClient.Data.CourseOverGroundTrue is double ct
                            ? (ct * 180.0 / System.Math.PI).ToString("F0") + "\u00B0" : "-"),
                        Magnetic =
                        @(SignalkClient.Data.CourseOverGroundMagnetic is double cm
                            ? (cm * 180.0 / System.Math.PI).ToString("F0") + "\u00B0" : "-")
                    </span>
                </small>
            </div>
        </div>
    </div>

    <div class="col-sm-6">
        <div class="card">
            <div class="card-body">
                <label class="form-label" for="ship-orientation">Ship orientation source</label>
                <select class="form-select form-select-sm" id="ship-orientation"
                        value="@AppSettings.ShipOrientationSource"
                        @onchange="OnShipOrientationSourceChanged">
                    <option value="headingTrue">Heading (True)</option>
                    <option value="headingMagnetic">Heading (Magnetic)</option>
                    <option value="cogTrue">COG (True)</option>
                    <option value="cogMagnetic">COG (Magnetic)</option>
                </select>
                <small class="text-muted d-block mt-1">
                    Picks the field that drives the rotation of the boat icon
                    on the chart. Heading is the on-boat sensor; COG is the
                    ground track derived from GPS. Falls back through the
                    other three fields when the picked source isn't published.
                    Default <em>Heading (True)</em>.
                </small>
            </div>
        </div>
    </div>

    <div class="col-12">
        <h5 class="page-section-header">Alarms</h5>
    </div>

    <div class="col-sm-6">
        <div class="card">
            <div class="card-body">
                <label class="form-label">Depth Alarm</label>
                <div class="input-group">
                    <input type="number" class="form-control" step="0.5" min="0" max="50"
                           aria-label="Depth alarm threshold in meters"
                           value="@AppSettings.DepthAlarmThreshold"
                           @onchange="(e) => OnDepthChanged(e)" />
                    <span class="input-group-text">m</span>
                </div>
                <small class="text-muted">Alert when depth is below this value.</small>
            </div>
        </div>
    </div>

    <div class="col-sm-6">
        <div class="card">
            <div class="card-body">
                <label class="form-label">Guard Zone (CPA)</label>
                <div class="input-group">
                    <input type="number" class="form-control" step="0.1" min="0" max="5"
                           aria-label="CPA guard zone radius in nautical miles"
                           value="@AppSettings.CpaAlarmThreshold"
                           @onchange="(e) => OnCpaChanged(e)" />
                    <span class="input-group-text">nm</span>
                </div>
                <small class="text-muted">Alert when a vessel's projected closest approach is inside this radius.</small>
                @* Outer warning-band ring toggle. The CPA classifier
                   raises Warning when CPA is between the inner radius
                   and radius * factor (default factor 2). Drawing the
                   advisory ring at radius * factor lets the helm see
                   why amber chips appear in the band - helm-flagged
                   the chips as "outside my guard ring" before the
                   ring was drawn. The toggle is here so a helm
                   running a busy chart can opt out for a cleaner
                   single-ring look. *@
                <div class="form-check form-switch mt-2">
                    <input class="form-check-input" type="checkbox"
                           id="guard-zone-warning-ring-switch"
                           checked="@AppSettings.GuardZoneWarningRingVisible"
                           @onchange="(e) => OnGuardZoneWarningRingChanged(e)" />
                    <label class="form-check-label" for="guard-zone-warning-ring-switch">
                        Show outer warning ring
                    </label>
                </div>
                <small class="text-muted d-block">
                    Dashed ring at <code>radius × warning factor</code>
                    (default 2×). Targets between the two rings raise
                    an advisory CPA chip but no audible alarm; the
                    audible alarm fires only inside the inner ring.
                </small>
            </div>
        </div>
    </div>

    <div class="col-sm-6">
        <div class="card">
            <div class="card-body">
                @* Server-side approach alarms toggle (default ON).
                   When ON, the bridged SK course-provider plugin's
                   notifications drive APPROACH; the radius input
                   below is dimmed because the SK plugin's own
                   arrival circle wins. When OFF, the client-side
                   WaypointApproach rule fires on the helm-set
                   radius - helm-only fallback for SK installs
                   without a course-provider plugin. *@
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch"
                           id="server-approach-switch"
                           checked="@AppSettings.ServerSideApproachAlarms"
                           @onchange="OnServerSideApproachAlarmsChanged" />
                    <label class="form-check-label" for="server-approach-switch">
                        Use server-side approach alarms
                    </label>
                </div>
                <small class="text-muted d-block mb-3">
                    Default. The SK course-provider plugin's
                    <code>arrivalCircleEntered</code> /
                    <code>perpendicularPassed</code> /
                    <code>routeComplete</code> notifications drive
                    the APPROACH banner; the chartplotter agrees
                    with the autopilot's arrival logic. Turn off
                    for SK installs without a course-provider
                    plugin - the client-side rule below takes
                    over.
                </small>

                <label class="form-label">Waypoint Arrival Radius</label>
                <div class="input-group">
                    <input type="number" class="form-control" step="5" min="0" max="1000"
                           aria-label="Waypoint arrival radius in meters"
                           value="@AppSettings.WaypointArrivalRadiusMeters"
                           disabled="@AppSettings.ServerSideApproachAlarms"
                           @onchange="(e) => OnWaypointArrivalChanged(e)" />
                    <span class="input-group-text">m</span>
                </div>
                <small class="text-muted">
                    Client-side fallback radius. Only consulted when
                    "Use server-side approach alarms" is OFF. Set to
                    0 to disable the client rule entirely. Typical
                    inshore: 30-50 m.
                </small>
                <div class="form-check form-switch mt-2">
                    <input class="form-check-input" type="checkbox"
                           id="auto-advance-switch"
                           checked="@AppSettings.AutoAdvanceWaypoints"
                           @onchange="(e) => OnAutoAdvanceChanged(e)" />
                    <label class="form-check-label" for="auto-advance-switch">
                        Auto-advance to next waypoint
                    </label>
                </div>
                <small class="text-muted d-block">
                    Jump to the next leg automatically when the course-provider
                    plugin reports <code>perpendicularPassed</code> or
                    <code>arrivalCircleEntered</code>. Off means the helm has
                    to hit "Next WP" on the alarm banner.
                </small>
            </div>
        </div>
    </div>

    <div class="col-sm-6">
        <div class="card">
            <div class="card-body">
                <label class="form-label">Deadman Watch Timer</label>
                <div class="input-group">
                    <input type="number" class="form-control" step="1" min="0" max="120"
                           aria-label="Deadman watch timer in minutes, 0 disables"
                           value="@AppSettings.DeadmanTimeoutMinutes"
                           @onchange="(e) => OnDeadmanTimeoutChanged(e)" />
                    <span class="input-group-text">min</span>
                </div>
                <small class="text-muted">
                    Fires a DEADMAN alarm if the Map page sees no interaction for this
                    many minutes. Safety net for solo watches. Set to 0 to disable.
                    Any tap / key / pointer event resets the timer. Escalates to
                    Danger severity past 2x this window.
                </small>
                <label class="form-label mt-2">Night-mode deadman</label>
                <div class="input-group">
                    <input type="number" class="form-control" step="1" min="0" max="120"
                           aria-label="Night-mode deadman timer in minutes, 0 uses day value"
                           value="@AppSettings.DeadmanNightMinutes"
                           @onchange="(e) => OnDeadmanNightChanged(e)" />
                    <span class="input-group-text">min</span>
                </div>
                <small class="text-muted">
                    Used instead of the day value while Night Mode is on. Default 15 min
                    - a sleep-rotation guard for solo watches. 0 falls back to the day
                    value (no night override).
                </small>
            </div>
        </div>
    </div>

    <div class="col-sm-6">
        <div class="card">
            <div class="card-body">
                <label class="form-label">Guard Zone Lookahead</label>
                <div class="input-group">
                    <input type="number" class="form-control" step="1" min="1" max="60"
                           aria-label="Guard zone lookahead in minutes"
                           value="@AppSettings.GuardZoneLookaheadMinutes"
                           @onchange="(e) => OnLookaheadChanged(e)" />
                    <span class="input-group-text">min</span>
                </div>
                <small class="text-muted">Only vessels whose CPA occurs within this window raise the alarm.</small>
                <label class="form-label mt-2">Snooze duration</label>
                <div class="input-group">
                    <input type="number" class="form-control" step="1" min="1" max="120"
                           aria-label="Snooze duration in minutes"
                           value="@AppSettings.SnoozeDurationMinutes"
                           @onchange="(e) => OnSnoozeDurationChanged(e)" />
                    <span class="input-group-text">min</span>
                </div>
                <small class="text-muted">
                    How long the "Snooze" button silences a specific alarm target.
                    Short (5 min) for busy harbours; long (30-60 min) for a distant
                    freighter that will stay in range for hours.
                </small>
            </div>
        </div>
    </div>

    <div class="col-sm-6">
        <div class="card">
            <div class="card-body">
                <label class="form-label">Wind Shift Alarm</label>
                <div class="input-group">
                    <input type="number" class="form-control" step="5" min="5" max="90"
                           aria-label="Wind shift alarm threshold in degrees"
                           value="@AppSettings.WindShiftAlarmThreshold"
                           @onchange="(e) => OnWindShiftChanged(e)" />
                    <span class="input-group-text">deg</span>
                </div>
                <small class="text-muted">Alert when TWD shifts more than this angle over the lookback window.</small>
            </div>
        </div>
    </div>

    <div class="col-sm-6">
        <div class="card">
            <div class="card-body">
                <label class="form-label">Wind Shift Lookback</label>
                <div class="input-group">
                    <input type="number" class="form-control" step="1" min="1" max="30"
                           aria-label="Wind shift lookback window in minutes"
                           value="@AppSettings.WindShiftLookbackMinutes"
                           @onchange="(e) => OnWindShiftLookbackChanged(e)" />
                    <span class="input-group-text">min</span>
                </div>
                <small class="text-muted">Shorter = responsive (racing); longer = smoothed (cruising).</small>
            </div>
        </div>
    </div>

    <div class="col-sm-6">
        <div class="card">
            <div class="card-body">
                <label class="form-label">Wind Shift Min TWS</label>
                <div class="input-group">
                    <input type="number" class="form-control" step="0.5" min="0" max="20"
                           aria-label="Wind shift minimum true wind speed in knots"
                           value="@AppSettings.WindShiftMinTrueWindSpeed"
                           @onchange="(e) => OnWindShiftMinTwsChanged(e)" />
                    <span class="input-group-text">kn</span>
                </div>
                <small class="text-muted">Suppress the alarm below this TWS - in light air the derived TWD is dominated by sensor noise. 0 disables the gate.</small>
            </div>
        </div>
    </div>

    <div class="col-sm-6">
        <div class="card">
            <div class="card-body">
                <label class="form-label">Own COG vector length</label>
                <div class="input-group">
                    <input type="number" class="form-control" step="1" min="1" max="60"
                           aria-label="Own-vessel COG vector look-ahead in minutes"
                           value="@AppSettings.OwnCogVectorMinutes"
                           @onchange="(e) => OnOwnCogVectorChanged(e)" />
                    <span class="input-group-text">min</span>
                </div>
                <small class="text-muted">How far ahead the dashed predictor line + endpoint label project from your boat. 5 for harbour entry, 20-30 for passage planning.</small>
            </div>
        </div>
    </div>

    <div class="col-sm-6">
        <div class="card">
            <div class="card-body">
                <label class="form-label">AIS COG vector length</label>
                <div class="input-group">
                    <input type="number" class="form-control" step="1" min="1" max="60"
                           aria-label="AIS target COG vector look-ahead in minutes"
                           value="@AppSettings.AisCogVectorMinutes"
                           @onchange="(e) => OnAisCogVectorChanged(e)" />
                    <span class="input-group-text">min</span>
                </div>
                <small class="text-muted">How far ahead AIS-target predictors project. Shorten in busy harbours to declutter; lengthen offshore for collision-avoidance reach.</small>
            </div>
        </div>
    </div>

    <div class="col-sm-6">
        <div class="card">
            <div class="card-body">
                <label class="form-label">Radar range rings</label>
                <div class="form-check form-switch mb-2">
                    <input type="checkbox" class="form-check-input" role="switch"
                           id="radar-range-rings-enabled"
                           checked="@AppSettings.RadarRangeRingsEnabled"
                           @onchange="OnRadarRangeRingsEnabledChanged" />
                    <label class="form-check-label" for="radar-range-rings-enabled">
                        Show concentric rings on the chart while a radar overlay is active
                    </label>
                </div>
                <div class="input-group">
                    <span class="input-group-text">Rings</span>
                    <input type="number" class="form-control" step="1" min="1" max="8"
                           aria-label="Number of radar range rings"
                           value="@AppSettings.RadarRangeRingsCount"
                           disabled="@(!AppSettings.RadarRangeRingsEnabled)"
                           @onchange="(e) => OnRadarRangeRingsCountChanged(e)" />
                </div>
                <small class="text-muted">Each ring sits at an evenly-spaced fraction of the radar's current range. Default 4 = quarter / half / three-quarter / full. 1-8 supported.</small>
            </div>
        </div>
    </div>

    @* Boat Draft card removed - the same information is surfaced on
       the Paths page (`design.draft.current` / `.maximum` with live
       values) and is also called out in the Anchor Tide Alarm setup
       card below, so a third card here was redundant. *@

    <div class="col-sm-6">
        <div class="card">
            <div class="card-body">
                <label class="form-label">Anchor Tide Safety Margin</label>
                <div class="input-group">
                    <input type="number" class="form-control" step="0.1" min="0" max="5"
                           aria-label="Anchor tide safety margin in meters"
                           value="@AppSettings.AnchorTideSafetyMargin"
                           @onchange="(e) => OnAnchorTideMarginChanged(e)" />
                    <span class="input-group-text">m</span>
                </div>
                <small class="text-muted">Warn when predicted LW clearance is below this margin. Add more for soft mud / tender hulls.</small>
            </div>
        </div>
    </div>

    @* Checklist card: the tide-aware anchor alarm needs four separate
       prerequisites (draft, margin, live depth, tide plugin). Walking
       users through the chain in one place beats a dormancy hint that
       flags one missing piece at a time on the HUD. *@
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <label class="form-label">Anchor Tide Alarm setup</label>
                <ul class="list-unstyled mb-0 anchor-tide-check" style="font-size:0.85rem;">
                    <li>
                        @{
                            var skDraftOk = SignalkClient.Data.DraftFromSignalK is > 0;
                        }
                        <span class="@(skDraftOk ? "check-ok" : "check-bad")">
                            @(skDraftOk ? "\u2713" : "\u2717")
                        </span>
                        Boat draft from SignalK
                        @if (skDraftOk)
                        { <span>(@SignalkClient.Data.DraftFromSignalK!.Value.ToString("F1") m)</span> }
                        else
                        { <span class="text-muted">&mdash; needs <code>design.draft</code> on vessel.json</span> }
                    </li>
                    <li>
                        <span class="@(AppSettings.AnchorTideSafetyMargin > 0 ? "check-ok" : "check-bad")">
                            @(AppSettings.AnchorTideSafetyMargin > 0 ? "\u2713" : "\u2717")
                        </span>
                        Safety margin &gt; 0 (currently @AppSettings.AnchorTideSafetyMargin.ToString("F1") m)
                    </li>
                    <li>
                        <span class="@(SignalkClient.Data.Depth is not null ? "check-ok" : "check-bad")">
                            @(SignalkClient.Data.Depth is not null ? "\u2713" : "\u2717")
                        </span>
                        Live depth from SignalK
                        @if (SignalkClient.Data.Depth is not null) { <span>(@SignalkClient.Data.Depth.Value.ToString("F1") m)</span> }
                        else { <span class="text-muted">&mdash; needs a depth sounder feeding the bus</span> }
                    </li>
                    <li>
                        <span class="@(SignalkClient.Data.TideHeightNow is not null ? "check-ok" : "check-bad")">
                            @(SignalkClient.Data.TideHeightNow is not null ? "\u2713" : "\u2717")
                        </span>
                        Tide data
                        @if (SignalkClient.Data.TideHeightNow is not null)
                        { <span>(@SignalkClient.Data.TideStationName - @SignalkClient.Data.TideHeightNow.Value.ToString("F1") m now)</span> }
                        else { <span class="text-muted">&mdash; install a SignalK tide plugin (e.g. signalk-tides)</span> }
                    </li>
                </ul>
                <small class="text-muted" style="display:block; margin-top:6px;">
                    All four need to be green for the tide-aware anchor alarm to fire. The
                    plain manual anchor-drag alarm works without any of this &mdash; it only
                    needs a GPS fix.
                </small>
            </div>
        </div>
    </div>

    @* Per-rule kill-switch panel. The helm flips a toggle here to
       disable a single client-side alarm rule (or the master to
       disable them all in one tap). Disabled rules are skipped
       during evaluation AND any of their already-active banners
       are dropped at the next tick - see AlarmManager.Evaluate's
       disabled-rule sweep. Rule titles come from
       IAlarmManager.RegisteredRuleTitles so a new rule registered
       in DI shows up here automatically. *@
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <label class="form-label d-block mb-2">Enable client-side alarms</label>
                <small class="text-muted d-block mb-3">
                    Each switch turns one client-side alarm rule
                    on or off. Disabled rules don't fire and any
                    of their banners on screen disappear within a
                    second. Server-side notifications (SignalK
                    plugins like depth, anchor, MOB) are NOT
                    affected by these toggles - those still
                    surface via the SERVER pass-through bridge.
                </small>
                <div class="form-check form-switch mb-2">
                    <input class="form-check-input" type="checkbox" role="switch"
                           id="alarms-master-switch"
                           checked="@AllAlarmsEnabled"
                           @onchange="OnAllAlarmsToggleChanged" />
                    <label class="form-check-label fw-bold" for="alarms-master-switch">
                        @(AllAlarmsEnabled ? "All on" : "All off") (master)
                    </label>
                </div>
                <hr class="my-2" />
                @foreach (var title in Alarms.RegisteredRuleTitles)
                {
                    @* Skip rules with no title. Today this only filters
                       out the ServerNotificationsAlarmRule, which is a
                       multi-output bridge that emits each plugin's own
                       title (SHALLOW, MOB, etc.) per notification - the
                       rule itself has no static title to display, and
                       silencing the entire bridge with one toggle would
                       suppress every plugin's notification (MOB included)
                       which is a footgun the helm shouldn't reach with
                       a single tap. The description text above documents
                       this carve-out -- server-side notifications are
                       intentionally not affected by these toggles. *@
                    if (string.IsNullOrEmpty(title)) continue;
                    var t = title;
                    bool disabled = AppSettings.DisabledAlarmRules.Contains(t);
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch"
                               id="@($"alarm-rule-{t}")"
                               checked="@(!disabled)"
                               @onchange="(e) => OnRuleToggleChanged(t, e)" />
                        <label class="form-check-label" for="@($"alarm-rule-{t}")">
                            @t
                        </label>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-12 mt-3">
        <h5 class="page-section-header">Performance</h5>
    </div>

    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <label class="form-label">Boat Polars</label>
                @if (Polar.HasPolar)
                {
                    <p class="polar-status polar-status-ok">
                        <span class="polar-status-icon">&#10003;</span>
                        Loaded: @Polar.TwaValues.Length TWA rows &times; @Polar.TwsValues.Length TWS columns
                        (TWS @Polar.TwsValues[0]&ndash;@Polar.TwsValues[^1] kn)
                    </p>
                    @RenderPolarPlot()
                    <button class="btn btn-sm btn-outline-danger mt-2" @onclick="ClearPolar">Remove Polar</button>
                }
                else if (polarError is not null)
                {
                    <p class="polar-status polar-status-error">
                        <span class="polar-status-icon">&#9888;</span>
                        Import failed: @polarError
                    </p>
                    <p class="text-muted" style="font-size:0.8rem;">
                        Format: first column = TWA (degrees), header row = TWS (knots), cells = target speed (knots).
                        Separator is comma, semicolon, or tab. Decimals must use '.'.
                    </p>
                }
                else
                {
                    <p class="text-muted" style="font-size:0.8rem;">
                        Upload a CSV polar file. Format: first column = TWA (degrees), header row = TWS (knots), cells = target speed (knots).
                    </p>
                }
                @* The <details> `open` attribute is boolean-present: any
                   value (even "False") keeps it open. Render the attribute
                   conditionally so false actually collapses it. ontoggle
                   doesn't bubble but fires on the element itself, which
                   is enough for Blazor to catch. *@
                <details class="mt-2" style="font-size:0.78rem; color:var(--sk-text-muted, #94a3b8);"
                         open="@(polarHelpOpen ? "open" : null)"
                         @ontoggle="OnPolarHelpToggle">
                    <summary style="cursor:pointer; user-select:none;">What's a polar &mdash; and a sample</summary>
                    <div style="padding-top:6px; line-height:1.5;">
                        A polar is a table of your boat's target boat speed (BSP)
                        at each combination of true wind angle (TWA) and true
                        wind speed (TWS). Used by the race-mode optimal-TWA
                        overlay and the Dashboard performance %. Typical
                        sources: ORC / IRC certificate, builder-published polars,
                        Expedition / Adrena exports, or your own log-crunch.
                        <br />
                        <br />
                        Minimal 5 kn / 10 kn / 15 kn example (commas shown; tabs
                        and semicolons also work; decimals must use &quot;.&quot;):
                        <pre style="background:rgba(255,255,255,0.04); padding:6px 8px; border-radius:4px; margin-top:4px; font-size:0.75rem; overflow-x:auto;">TWA,5,10,15
32,3.2,5.4,6.2
45,4.1,6.3,7.0
60,4.6,6.8,7.4
90,4.4,6.5,7.2
120,3.8,5.9,6.7
150,3.1,5.0,5.9</pre>
                        First column 0-180 deg TWA, rising. Header row TWS in
                        knots, rising. Cells in knots. Rows for dead-upwind
                        (under 30) and dead-downwind (over 170) are optional
                        &mdash; the router interpolates.
                    </div>
                </details>
                <div class="mt-2">
                    <label class="btn btn-sm btn-outline-secondary" style="cursor:pointer;">
                        Upload Polar CSV
                        <InputFile OnChange="HandlePolarUpload" Accept=".csv,.txt,.pol" style="display:none;" />
                    </label>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 mt-3">
        <h5 class="page-section-header">Display</h5>
    </div>

    <div class="col-sm-6">
        <div class="card">
            <div class="card-body">
                <label class="form-label">Theme</label>
                <div class="btn-group w-100" role="group" aria-label="Theme">
                    @foreach (var (val, label) in new[] { ("system", "System"), ("light", "Light"), ("dark", "Dark"), ("high-contrast", "High contrast") })
                    {
                        <input type="radio" class="btn-check" id="@($"theme-{val}")" name="theme"
                               checked="@(AppSettings.Theme == val)"
                               @onchange="() => OnThemeChanged(val)" />
                        <label class="btn btn-outline-secondary btn-sm" for="@($"theme-{val}")">@label</label>
                    }
                </div>
                <small class="text-muted d-block mt-1">System follows your device's dark/light preference.</small>
            </div>
        </div>
    </div>

    <div class="col-sm-6">
        <div class="card">
            <div class="card-body">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" checked="@AppSettings.NightMode"
                           @onchange="(e) => OnNightModeChanged(e)" />
                    <label class="form-check-label">Night Mode</label>
                </div>
                <small class="text-muted">Red-shifted display for night vision. Overlays on any theme.</small>
                @if (AppSettings.NightMode)
                {
                    <div class="btn-group mt-2" role="group" aria-label="Night mode preset">
                        @foreach (var (val, label, tip) in NightPresets)
                        {
                            <input type="radio" class="btn-check" name="night-preset"
                                   id="@($"night-{val}")" autocomplete="off"
                                   checked="@(AppSettings.NightModePreset == val)"
                                   @onchange="() => OnNightPresetChanged(val)" />
                            <label class="btn btn-outline-secondary btn-sm" for="@($"night-{val}")"
                                   title="@tip">@label</label>
                        }
                    </div>
                    <small class="text-muted d-block mt-1">
                        Dusk: dim + desaturated, no red-shift - for the sun-just-set window.
                        Soft / Amber / Red: progressively-redder presets that preserve dark-adapted
                        vision.
                    </small>
                }
                <div class="form-check form-switch mt-2">
                    <input class="form-check-input" type="checkbox"
                           checked="@AppSettings.NightModeAuto"
                           @onchange="OnNightAutoChanged" />
                    <label class="form-check-label">Auto flip at dusk</label>
                </div>
                <small class="text-muted d-block mt-1">
                    Reads <code>environment.sun</code> (string: day / dawn / dusk / night).
                    Needs a solar-position plugin on the SignalK server (see the Paths page).
                    A manual Night tap suppresses the auto-flip until env.sun next crosses
                    a day / night transition, so the app doesn't fight your choice.
                </small>

                <div class="form-check form-switch mt-2">
                    <input class="form-check-input" type="checkbox"
                           checked="@AppSettings.TideVisible"
                           @onchange="OnTideVisibleChanged" />
                    <label class="form-check-label">Show tide</label>
                </div>
                <small class="text-muted d-block mt-1">
                    Tide row on the depth HUD card + the Tide section on the Dashboard.
                    Hide on non-tidal waters (lakes, inland canals) or when the SignalK
                    server has no tide plugin.
                </small>

                <div class="form-check form-switch mt-2">
                    <input class="form-check-input" type="checkbox"
                           checked="@AppSettings.BigType"
                           @onchange="OnBigTypeChanged" />
                    <label class="form-check-label">Big screen mode</label>
                </div>
                <small class="text-muted d-block mt-1">
                    Scales corner HUD numbers, AIS ship icons + labels, CPA chips, toast
                    + alarm banners up to read well from 1-2 m away. Designed for the
                    21&quot;+ helm screen the crew watches from a couch or nav station;
                    on a phone the standard size already fits the viewport.
                </small>

                <div class="form-check form-switch mt-2">
                    <input class="form-check-input" type="checkbox"
                           checked="@AppSettings.ExpandAllHud"
                           @onchange="OnExpandAllHudChanged" />
                    <label class="form-check-label">Expand all HUD panels</label>
                </div>
                <small class="text-muted d-block mt-1">
                    Keep every corner HUD in its expanded state (DMS / wind extras /
                    drift / leeway rows) instead of hiding them behind a tap. Best on
                    wide helm screens where the extra rows fit without covering chart.
                    Independent of Big screen mode; combine them for a maximum-
                    information read on a 21&quot;+ display.
                </small>
            </div>
        </div>
    </div>

    @* Backup / GPX import + export moved to /resources where the
       per-tab lists already live (focus-group field report 2026-04).
       Per-row Export already shipped on every Resources row with a
       format chooser; the page-level Import on /resources accepts
       any GPX or GeoJSON drop-in and routes each feature into its
       matching API (Routes / Waypoints / Notes / Regions). Keeping
       data-in / data-out in one place stops the helm hunting
       between Settings and Resources. *@

    @* === Advanced / developer tools ========================
       Data (raw delta stream) + Paths (which SK paths the plotter
       consumes) are techie features - useful when debugging why
       a gauge is empty or a plugin isn't wired right, but out of
       the helmsman's daily flow. Surfacing them here so the top
       nav stays focused on sailing workflows. The /raw and
       /paths routes themselves are unchanged. *@
    <div class="col-12 mt-3">
        <h5 class="page-section-header">Advanced</h5>
    </div>

    <div class="col-sm-6">
        <div class="card">
            <div class="card-body">
                <a href="raw" class="stretched-link text-decoration-none">
                    <strong class="d-block">Data stream</strong>
                </a>
                <small class="text-muted">
                    Live SignalK delta viewer. Shows every path the plotter
                    subscribes to as raw JSON, with a search box and path filter.
                    Useful for debugging "why is this reading missing?"
                </small>
            </div>
        </div>
    </div>

    <div class="col-sm-6">
        <div class="card">
            <div class="card-body">
                <a href="paths" class="stretched-link text-decoration-none">
                    <strong class="d-block">Paths</strong>
                </a>
                <small class="text-muted">
                    Reference: which SignalK path powers each HUD / chart /
                    alarm rule. Handy when a field reads "--" and you want to
                    know which server-side provider or plugin to install.
                </small>
            </div>
        </div>
    </div>

    @* Error-relay self-test. Sends a synthetic "client-error" POST
       through ClientErrorRelay to the SignalK plugin's /log endpoint
       and tells the user where to look for it (server log, tailed
       over SSH). Useful when diagnosing "is the hook even plumbed?"
       after deploying a new build to the Pi. *@
    <div class="col-sm-6">
        <div class="card">
            <div class="card-body">
                <strong class="d-block">Send test log entry</strong>
                <small class="text-muted d-block mb-2">
                    Posts a sample payload to the SignalK plugin's
                    <code>/log</code> endpoint so you can verify the
                    relay is wired. Grep <code>[onaplotter]</code> in the
                    SignalK server log (e.g. <code>journalctl -u signalk</code>)
                    or the Admin UI logs tab.
                </small>
                <button class="btn btn-sm btn-outline-secondary"
                        disabled="@testLogInFlight"
                        @onclick="SendTestLog">
                    @(testLogInFlight ? "Sending..." : "Send test log")
                </button>
            </div>
        </div>
    </div>

    @* Notification self-test. Raises a synthetic alarm via the SK v2
       Notifications API on a dedicated test path. The server emits
       a notifications delta, every connected plotter (including this
       one) sees it in their banner, and the Acknowledge button
       round-trips through the SK v2 ack flow. Useful for verifying
       the publish + cross-plotter sync after a deploy. *@
    <div class="col-sm-6">
        <div class="card">
            <div class="card-body">
                <strong class="d-block">Send test notification</strong>
                <small class="text-muted d-block mb-2">
                    Raises a synthetic <em>warn</em>-level alarm at
                    <code>notifications.onaplotter.test</code>. Watch the
                    banner appear here AND on every other plotter
                    connected to the same SignalK server; tap
                    Acknowledge on either side and the chip clears
                    everywhere. Re-press to re-raise; the path
                    auto-clears 60 s after the last raise (server-side
                    GC) if you forget.
                </small>
                <button class="btn btn-sm btn-outline-secondary"
                        disabled="@testNotificationInFlight"
                        @onclick="SendTestNotification">
                    @(testNotificationInFlight ? "Sending..." : "Send test notification")
                </button>
            </div>
        </div>
    </div>
</div>

</div> @* /.app-page *@

@code {
    private string settingsFilter = "";

    // Track the polar-help <details> open state ourselves so a parent
    // re-render (SignalkClient data change, polar upload complete, etc.)
    // doesn't collapse the block the user just opened. <details> with a
    // bound `open` attribute keeps the DOM in sync with Blazor.
    private bool polarHelpOpen = false;

    // In-flight guard for the "Send test log" button so a double-tap
    // during a slow network round-trip doesn't queue a second POST.
    private bool testLogInFlight;
    private bool testNotificationInFlight;

    private async Task SendTestLog()
    {
        if (testLogInFlight) return;
        testLogInFlight = true;
        try
        {
            // Synthetic payload: includes build info so the log line
            // identifies WHICH build sent it - useful when you've
            // rebuilt multiple times and want to confirm the latest
            // landed on the Pi. ReportAsync returns false if the JS
            // bootstrap isn't reachable, so the toast tells the truth
            // about whether anything actually went out (the previous
            // version always reported success).
            bool ok = await ErrorRelay.ReportAsync(
                $"test log from Settings @ build {OnaPlotter.BuildInfo.CommitHash} ({OnaPlotter.BuildInfo.BuildUtc} UTC)");
            if (ok) Toasts.Success("Test log sent. Check the SignalK server log for [onaplotter].");
            else    Toasts.Error("Test log relay unavailable - is the SignalK plugin loaded?");
        }
        finally
        {
            testLogInFlight = false;
        }
    }

    /// <summary>Raises a synthetic alarm at
    /// <c>notifications.onaplotter.test</c> via the SK v2 Notifications
    /// API. Verifies the publish + ack path end-to-end - the alarm
    /// appears on every connected plotter, and Acknowledge round-trips
    /// through the same v2 endpoint local rules use.</summary>
    private async Task SendTestNotification()
    {
        if (testNotificationInFlight) return;
        testNotificationInFlight = true;
        try
        {
            // Path scoped under "onaplotter" so it can never collide
            // with a real SK alarm path that some rule cares about.
            // Warn-level chosen over alarm/emergency so an accidental
            // tap on the helm doesn't pull crew attention as hard as
            // a real safety alarm would. visual+sound covers both
            // banner + audio paths so the helm verifies both.
            const string testPath = "notifications.onaplotter.test";
            var payload = new NotificationPayload(
                State: "warn",
                Method: ["visual", "sound"],
                Message: $"OnaPlotter test alarm @ build {OnaPlotter.BuildInfo.CommitHash}. Tap Acknowledge to confirm round-trip.");
            var result = await NotificationsApi.RaiseAsync(testPath, payload);
            if (result.Success)
            {
                Toasts.Success("Test notification sent. Watch the banner here + on other plotters; tap Acknowledge to round-trip.");
            }
            else
            {
                Toasts.Error($"Test notification failed: {result.Error ?? "unknown error"}");
            }
        }
        finally
        {
            testNotificationInFlight = false;
        }
    }

    private void OnPolarHelpToggle(EventArgs _)
    {
        polarHelpOpen = !polarHelpOpen;
    }

    private async Task OnSettingsFilterInput(ChangeEventArgs e)
    {
        settingsFilter = e.Value?.ToString() ?? "";
        // Delegate the DOM walk to JS: enumerates all .form-label
        // elements, finds the first whose text contains the query,
        // scrolls it into view, and applies a transient highlight.
        // Keeps the C# side stateless (no per-card hide logic) so the
        // page doesn't churn through a big re-render on every keystroke.
        try { await JS.InvokeVoidAsync("onaSettingsFilter", settingsFilter); }
        catch (JSDisconnectedException) { }
        catch (Microsoft.JSInterop.JSException) { }
    }

