    /// <summary>True when no rule is in <c>DisabledAlarmRules</c>;
    /// drives the master "All on" / "All off" switch label and
    /// checkbox state. Computed each render so a per-rule toggle
    /// keeps the master in sync without a manual sync step.</summary>
    private bool AllAlarmsEnabled => AppSettings.DisabledAlarmRules.Count == 0;

    private async Task OnAllAlarmsToggleChanged(ChangeEventArgs e)
    {
        bool on = e.Value is bool b && b;
        // ON = enable every rule (clear the disabled set);
        // OFF = disable every registered rule (add each title).
        if (on)
        {
            // Snapshot to avoid mutate-while-iterate when each
            // setter writes back to the persisted set.
            var titles = AppSettings.DisabledAlarmRules.ToArray();
            foreach (var t in titles)
                await AppSettings.SetAlarmRuleDisabledAsync(t, disabled: false);
        }
        else
        {
            foreach (var t in Alarms.RegisteredRuleTitles)
                await AppSettings.SetAlarmRuleDisabledAsync(t, disabled: true);
        }
    }

