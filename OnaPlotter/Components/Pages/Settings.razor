@* Settings: configurable alarm thresholds and preferences. *@

@page "/settings"
@using OnaPlotter.Services
@inject IAppSettings AppSettings
@inject IPolarService Polar
@inject IToastService Toasts

<PageTitle>Settings</PageTitle>

<h2>Settings</h2>

<div class="row g-4" style="max-width: 600px;">

    <div class="col-12">
        <h5 class="text-muted" style="font-size:0.8rem; text-transform:uppercase; letter-spacing:0.1em;">Mode</h5>
    </div>
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <label class="form-label">Sailing Mode</label>
                <div class="btn-group w-100" role="group" aria-label="Sailing mode">
                    @foreach (var (val, label, tip) in SailingModes)
                    {
                        <input type="radio" class="btn-check" name="sailing-mode"
                               id="@($"mode-{val}")" autocomplete="off"
                               checked="@(AppSettings.SailingMode == val)"
                               @onchange="() => OnSailingModeChanged(val)" />
                        <label class="btn btn-outline-secondary btn-sm" for="@($"mode-{val}")"
                               title="@tip">@label</label>
                    }
                </div>
                <small class="text-muted d-block mt-1">
                    Cruise: navigation emphasis (depth, anchor, route). Race: performance emphasis
                    (laylines, optimal TWA, target speed). Individual toggles still work in either mode;
                    the mode just picks sensible defaults and surfaces mode-specific overlays.
                </small>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <label class="form-check form-switch" style="margin:0;">
                    <input class="form-check-input" type="checkbox" role="switch"
                           checked="@AppSettings.KeepScreenAwake"
                           @onchange="OnKeepScreenAwakeChanged" />
                    <span class="form-check-label">Keep screen awake on Map page</span>
                </label>
                <small class="text-muted d-block mt-1">
                    Holds a Screen Wake Lock while the Map page is visible so the
                    tablet doesn't doze mid-watch. Turn off if running on battery
                    without shore power. Quiet no-op on browsers without Wake Lock
                    support.
                </small>
            </div>
        </div>
    </div>

    <div class="col-12">
        <h5 class="text-muted" style="font-size:0.8rem; text-transform:uppercase; letter-spacing:0.1em;">Alarms</h5>
    </div>

    <div class="col-sm-6">
        <div class="card">
            <div class="card-body">
                <label class="form-label">Depth Alarm</label>
                <div class="input-group">
                    <input type="number" class="form-control" step="0.5" min="0" max="50"
                           value="@AppSettings.DepthAlarmThreshold"
                           @onchange="(e) => OnDepthChanged(e)" />
                    <span class="input-group-text">m</span>
                </div>
                <small class="text-muted">Alert when depth is below this value.</small>
            </div>
        </div>
    </div>

    <div class="col-sm-6">
        <div class="card">
            <div class="card-body">
                <label class="form-label">Guard Zone (CPA)</label>
                <div class="input-group">
                    <input type="number" class="form-control" step="0.1" min="0" max="5"
                           value="@AppSettings.CpaAlarmThreshold"
                           @onchange="(e) => OnCpaChanged(e)" />
                    <span class="input-group-text">nm</span>
                </div>
                <small class="text-muted">Alert when a vessel's projected closest approach is inside this radius.</small>
            </div>
        </div>
    </div>

    <div class="col-sm-6">
        <div class="card">
            <div class="card-body">
                <label class="form-label">Waypoint Arrival Radius</label>
                <div class="input-group">
                    <input type="number" class="form-control" step="5" min="0" max="1000"
                           value="@AppSettings.WaypointArrivalRadiusMeters"
                           @onchange="(e) => OnWaypointArrivalChanged(e)" />
                    <span class="input-group-text">m</span>
                </div>
                <small class="text-muted">
                    Distance at which an active-course waypoint triggers the APPROACH
                    alarm. Set to 0 to disable. Typical inshore: 30-50 m.
                </small>
            </div>
        </div>
    </div>

    <div class="col-sm-6">
        <div class="card">
            <div class="card-body">
                <label class="form-label">Guard Zone Lookahead</label>
                <div class="input-group">
                    <input type="number" class="form-control" step="1" min="1" max="60"
                           value="@AppSettings.GuardZoneLookaheadMinutes"
                           @onchange="(e) => OnLookaheadChanged(e)" />
                    <span class="input-group-text">min</span>
                </div>
                <small class="text-muted">Only vessels whose CPA occurs within this window raise the alarm.</small>
            </div>
        </div>
    </div>

    <div class="col-sm-6">
        <div class="card">
            <div class="card-body">
                <label class="form-label">Wind Shift Alarm</label>
                <div class="input-group">
                    <input type="number" class="form-control" step="5" min="5" max="90"
                           value="@AppSettings.WindShiftAlarmThreshold"
                           @onchange="(e) => OnWindShiftChanged(e)" />
                    <span class="input-group-text">deg</span>
                </div>
                <small class="text-muted">Alert when TWD shifts more than this angle over the lookback window.</small>
            </div>
        </div>
    </div>

    <div class="col-sm-6">
        <div class="card">
            <div class="card-body">
                <label class="form-label">Wind Shift Lookback</label>
                <div class="input-group">
                    <input type="number" class="form-control" step="1" min="1" max="30"
                           value="@AppSettings.WindShiftLookbackMinutes"
                           @onchange="(e) => OnWindShiftLookbackChanged(e)" />
                    <span class="input-group-text">min</span>
                </div>
                <small class="text-muted">Shorter = responsive (racing); longer = smoothed (cruising).</small>
            </div>
        </div>
    </div>

    <div class="col-sm-6">
        <div class="card">
            <div class="card-body">
                <label class="form-label">Boat Draft</label>
                <div class="input-group">
                    <input type="number" class="form-control" step="0.1" min="0" max="10"
                           value="@AppSettings.BoatDraftMeters"
                           @onchange="(e) => OnBoatDraftChanged(e)" />
                    <span class="input-group-text">m</span>
                </div>
                <small class="text-muted">Used by the tide-aware anchor alarm to predict grounding at low water.</small>
            </div>
        </div>
    </div>

    <div class="col-sm-6">
        <div class="card">
            <div class="card-body">
                <label class="form-label">Anchor Tide Safety Margin</label>
                <div class="input-group">
                    <input type="number" class="form-control" step="0.1" min="0" max="5"
                           value="@AppSettings.AnchorTideSafetyMargin"
                           @onchange="(e) => OnAnchorTideMarginChanged(e)" />
                    <span class="input-group-text">m</span>
                </div>
                <small class="text-muted">Warn when predicted LW clearance is below this margin. Add more for soft mud / tender hulls.</small>
            </div>
        </div>
    </div>

    <div class="col-12 mt-3">
        <h5 class="text-muted" style="font-size:0.8rem; text-transform:uppercase; letter-spacing:0.1em;">Performance</h5>
    </div>

    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <label class="form-label">Boat Polars</label>
                @if (Polar.HasPolar)
                {
                    <p class="polar-status polar-status-ok">
                        <span class="polar-status-icon">&#10003;</span>
                        Loaded: @Polar.TwaValues.Length TWA rows &times; @Polar.TwsValues.Length TWS columns
                        (TWS @Polar.TwsValues[0]&ndash;@Polar.TwsValues[^1] kn)
                    </p>
                    @RenderPolarPlot()
                    <button class="btn btn-sm btn-outline-danger mt-2" @onclick="ClearPolar">Remove Polar</button>
                }
                else if (polarError is not null)
                {
                    <p class="polar-status polar-status-error">
                        <span class="polar-status-icon">&#9888;</span>
                        Import failed: @polarError
                    </p>
                    <p class="text-muted" style="font-size:0.8rem;">
                        Format: first column = TWA (degrees), header row = TWS (knots), cells = target speed (knots).
                        Separator is comma, semicolon, or tab. Decimals must use '.'.
                    </p>
                }
                else
                {
                    <p class="text-muted" style="font-size:0.8rem;">
                        Upload a CSV polar file. Format: first column = TWA (degrees), header row = TWS (knots), cells = target speed (knots).
                    </p>
                }
                <div class="mt-2">
                    <label class="btn btn-sm btn-outline-secondary" style="cursor:pointer;">
                        Upload Polar CSV
                        <InputFile OnChange="HandlePolarUpload" Accept=".csv,.txt,.pol" style="display:none;" />
                    </label>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 mt-3">
        <h5 class="text-muted" style="font-size:0.8rem; text-transform:uppercase; letter-spacing:0.1em;">Display</h5>
    </div>

    <div class="col-sm-6">
        <div class="card">
            <div class="card-body">
                <label class="form-label">Theme</label>
                <div class="btn-group w-100" role="group" aria-label="Theme">
                    @foreach (var (val, label) in new[] { ("system", "System"), ("light", "Light"), ("dark", "Dark") })
                    {
                        <input type="radio" class="btn-check" id="@($"theme-{val}")" name="theme"
                               checked="@(AppSettings.Theme == val)"
                               @onchange="() => OnThemeChanged(val)" />
                        <label class="btn btn-outline-secondary btn-sm" for="@($"theme-{val}")">@label</label>
                    }
                </div>
                <small class="text-muted d-block mt-1">System follows your device's dark/light preference.</small>
            </div>
        </div>
    </div>

    <div class="col-sm-6">
        <div class="card">
            <div class="card-body">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" checked="@AppSettings.NightMode"
                           @onchange="(e) => OnNightModeChanged(e)" />
                    <label class="form-check-label">Night Mode</label>
                </div>
                <small class="text-muted">Red-shifted display for night vision. Overlays on any theme.</small>
                @if (AppSettings.NightMode)
                {
                    <div class="btn-group mt-2" role="group" aria-label="Night mode preset">
                        @foreach (var (val, label, tip) in NightPresets)
                        {
                            <input type="radio" class="btn-check" name="night-preset"
                                   id="@($"night-{val}")" autocomplete="off"
                                   checked="@(AppSettings.NightModePreset == val)"
                                   @onchange="() => OnNightPresetChanged(val)" />
                            <label class="btn btn-outline-secondary btn-sm" for="@($"night-{val}")"
                                   title="@tip">@label</label>
                        }
                    </div>
                    <small class="text-muted d-block mt-1">
                        Soft: warm low-contrast. Amber: brighter for dusk. Red: single-channel, preserves
                        dark-adapted vision.
                    </small>
                }
                <div class="form-check form-switch mt-2">
                    <input class="form-check-input" type="checkbox"
                           checked="@AppSettings.NightModeAuto"
                           @onchange="OnNightAutoChanged" />
                    <label class="form-check-label">Auto flip at dusk</label>
                </div>
                <small class="text-muted d-block mt-1">
                    Uses the SignalK <code>environment.sun.altitude</code> path (install a
                    solar-position plugin). Flips on near civil twilight, off past dawn.
                    A manual Night tap suppresses the auto-flip for 1 hour so the app
                    doesn't fight your choice.
                </small>
            </div>
        </div>
    </div>
</div>

@code {
    private async Task OnDepthChanged(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out double val) && val >= 0)
            await AppSettings.SetDepthAlarmThresholdAsync(val);
    }

    private async Task OnCpaChanged(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out double val) && val >= 0)
            await AppSettings.SetCpaAlarmThresholdAsync(val);
    }

    private async Task OnWaypointArrivalChanged(ChangeEventArgs e)
    {
        // 0 disables -- the rule returns null when the configured radius
        // is <= 0. Clamp rather than silently drop so a user who types
        // 5000 gets a useful 1000 m instead of wondering why nothing
        // changed. Toast if the clamp kicked in.
        if (!double.TryParse(e.Value?.ToString(), out double raw)) return;
        double clamped = System.Math.Clamp(raw, 0, 1000);
        if (System.Math.Abs(clamped - raw) > 0.001)
            Toasts.Show($"Clamped to {clamped:F0} m (range 0–1000)");
        await AppSettings.SetWaypointArrivalRadiusMetersAsync(clamped);
    }

    private async Task OnLookaheadChanged(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out double val) && val >= 1)
            await AppSettings.SetGuardZoneLookaheadMinutesAsync(val);
    }

    private async Task OnWindShiftChanged(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out double val) && val >= 5)
            await AppSettings.SetWindShiftAlarmThresholdAsync(val);
    }

    private async Task OnWindShiftLookbackChanged(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out double val) && val >= 1)
            await AppSettings.SetWindShiftLookbackMinutesAsync(val);
    }

    private async Task OnBoatDraftChanged(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out double val) && val >= 0)
            await AppSettings.SetBoatDraftMetersAsync(val);
    }

    private async Task OnAnchorTideMarginChanged(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out double val) && val >= 0)
            await AppSettings.SetAnchorTideSafetyMarginAsync(val);
    }

    private async Task OnSailingModeChanged(string value)
        => await AppSettings.SetSailingModeAsync(value);

    private async Task OnKeepScreenAwakeChanged(ChangeEventArgs e)
    {
        bool on = e.Value is bool b && b;
        await AppSettings.SetKeepScreenAwakeAsync(on);
    }

    private static readonly (string val, string label, string tip)[] SailingModes =
    [
        ("cruise", "Cruise", "Navigation emphasis: depth, anchor, route, AIS."),
        ("race",   "Race",   "Performance emphasis: laylines, optimal TWA, target speed."),
    ];

    private async Task OnNightModeChanged(ChangeEventArgs e)
    {
        bool val = (bool)(e.Value ?? false);
        await AppSettings.SetNightModeAsync(val);
    }

    private async Task OnNightPresetChanged(string value)
        => await AppSettings.SetNightModePresetAsync(value);

    private async Task OnNightAutoChanged(ChangeEventArgs e)
    {
        bool val = e.Value is bool b && b;
        await AppSettings.SetNightModeAutoAsync(val);
    }

    private async Task OnThemeChanged(string value) => await AppSettings.SetThemeAsync(value);

    private static readonly (string val, string label, string tip)[] NightPresets =
    [
        ("soft",  "Soft",  "Warm low-contrast red shift; default."),
        ("amber", "Amber", "Brighter amber, good around dusk."),
        ("red",   "Red",   "Pure red, preserves dark-adapted vision."),
    ];

    private string? polarError;

    private async Task HandlePolarUpload(InputFileChangeEventArgs e)
    {
        polarError = null;
        try
        {
            using var reader = new System.IO.StreamReader(e.File.OpenReadStream(maxAllowedSize: 1024 * 1024));
            string csv = await reader.ReadToEndAsync();
            await Polar.ImportAsync(csv);
            Toasts.Success($"Polar loaded: {Polar.TwaValues.Length} TWA rows");
        }
        catch (Exception ex)
        {
            // Surface the exact parse error on the Settings page (not just
            // a transient toast) so the user can read the message while
            // inspecting their CSV.
            polarError = ex.Message;
            Toasts.Error($"Polar import failed: {ex.Message}");
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task ClearPolar()
    {
        await Polar.ClearAsync();
        Toasts.Success("Polar cleared");
        StateHasChanged();
    }

    // ---- Polar plot ---------------------------------------------------
    // Renders the loaded polar as a classic radial diagram: 0 deg TWA at
    // top (upwind), 180 deg at bottom (downwind); one curve per TWS
    // bucket, port-starboard mirrored. The plot gives serious sailors a
    // "does this polar look right?" sanity check that the bare "23 TWA x
    // 7 TWS" text couldn't (Jonas's UX-round ask).

    private const double PlotRadius = 150;       // SVG units
    private const double PlotPadding = 30;
    private const double PlotViewHalf = PlotRadius + PlotPadding;

    // Up to 5 TWS buckets evenly spaced across the loaded range. Colours
    // are a cool-to-warm gradient chosen from the same earth palette as
    // the AIS ship-type colours so the plot reads as part of the app.
    private static readonly string[] PlotColors =
    [
        "#4a7ca1", // muted blue     - lightest wind
        "#5a9aa8", // teal
        "#7ea888", // sage
        "#c08e4f", // amber
        "#b05b45", // terracotta     - strongest wind
    ];

    private (int index, double tws, string color)[] SelectedBuckets()
    {
        var all = Polar.TwsValues;
        if (all.Length == 0) return [];
        int n = Math.Min(all.Length, PlotColors.Length);
        var result = new (int, double, string)[n];
        for (int i = 0; i < n; i++)
        {
            // Evenly spaced indices; always include first and last TWS.
            int idx = n == 1 ? 0 : (int)Math.Round(i * (all.Length - 1) / (double)(n - 1));
            result[i] = (idx, all[idx], PlotColors[i]);
        }
        return result;
    }

    private double MaxPolarSpeed()
    {
        double max = 0;
        foreach (var tws in Polar.TwsValues)
        foreach (var p in Polar.GetPolarCurve(tws))
            if (p.Speed > max) max = p.Speed;
        // Round up to the next even knot for clean ring labels.
        return Math.Max(2, Math.Ceiling(max / 2.0) * 2.0);
    }

    // Polar (twa, boat-speed) -> SVG (x, y). TWA 0 is at the top; SVG y
    // grows downward so cos is negated.
    private static (double x, double y) ToSvg(double twaDeg, double speed, double maxSpeed)
    {
        double r = (speed / maxSpeed) * PlotRadius;
        double rad = twaDeg * Math.PI / 180.0;
        return (r * Math.Sin(rad), -r * Math.Cos(rad));
    }

    private static string F(double v) => v.ToString("F1", System.Globalization.CultureInfo.InvariantCulture);

    private RenderFragment RenderPolarPlot() => __builder =>
    {
        double maxSpeed = MaxPolarSpeed();
        var buckets = SelectedBuckets();
        if (buckets.Length == 0) return;

        int view = (int)(PlotViewHalf * 2);
        int half = (int)PlotViewHalf;

        <div class="polar-plot">
            <svg viewBox="@(-half) @(-half) @view @view" role="img" aria-label="Boat polar diagram">
                @* Concentric rings every 2 kn + labels on the right spoke. *@
                @for (int s = 2; s <= maxSpeed; s += 2)
                {
                    double r = (s / maxSpeed) * PlotRadius;
                    <circle cx="0" cy="0" r="@F(r)" fill="none"
                            stroke="rgba(255,255,255,0.08)" stroke-width="1"/>
                    @SvgLabel(r + 3, 3, $"{s}", "rgba(255,255,255,0.35)", 8, "start")
                }

                @* Radial spokes every 30 deg. Labels only on 0/30/60/.../180. *@
                @for (int a = 0; a < 360; a += 30)
                {
                    var (x, y) = ToSvg(a, maxSpeed, maxSpeed);
                    <line x1="0" y1="0" x2="@F(x)" y2="@F(y)"
                          stroke="rgba(255,255,255,0.08)" stroke-width="1"/>
                }
                @for (int a = 0; a <= 180; a += 30)
                {
                    var (x, y) = ToSvg(a, maxSpeed * 1.12, maxSpeed);
                    @SvgLabel(x, y + 3, $"{a}\u00B0", "rgba(255,255,255,0.5)", 9, "middle")
                }

                @* One curve per TWS bucket, mirrored port + starboard. *@
                @foreach (var (_, tws, color) in buckets)
                {
                    var curve = Polar.GetPolarCurve(tws);
                    if (curve.Length < 2) continue;
                    string starboard = BuildPolyline(curve, maxSpeed, mirror: false);
                    string port      = BuildPolyline(curve, maxSpeed, mirror: true);
                    <polyline points="@starboard" fill="none" stroke="@color" stroke-width="1.6"
                              stroke-linejoin="round" stroke-linecap="round" opacity="0.9"/>
                    <polyline points="@port" fill="none" stroke="@color" stroke-width="1.6"
                              stroke-linejoin="round" stroke-linecap="round" opacity="0.9"/>
                }

                @* Centre dot. *@
                <circle cx="0" cy="0" r="1.5" fill="rgba(255,255,255,0.5)"/>
            </svg>

            <div class="polar-plot-legend">
                @foreach (var (_, tws, color) in buckets)
                {
                    <span class="polar-legend-item">
                        <span class="polar-legend-swatch" style="background:@color"></span>
                        @F(tws)kn
                    </span>
                }
            </div>
        </div>
    };

    private static string BuildPolyline((double Twa, double Speed)[] curve, double maxSpeed, bool mirror)
    {
        var sb = new System.Text.StringBuilder();
        foreach (var (twa, speed) in curve)
        {
            double a = mirror ? -twa : twa;
            var (x, y) = ToSvg(a, speed, maxSpeed);
            if (sb.Length > 0) sb.Append(' ');
            sb.Append(F(x)).Append(',').Append(F(y));
        }
        return sb.ToString();
    }

    // Razor reserves <text> as a literal-text block marker in component
    // markup, so we emit SVG <text> elements via MarkupString to bypass
    // the parser. Mirrors the trick used in MapHud.SvgText.
    private static MarkupString SvgLabel(double x, double y, string content, string fill, int fontSize, string anchor)
    {
        return new MarkupString(
            $"<text x=\"{F(x)}\" y=\"{F(y)}\" fill=\"{fill}\" font-size=\"{fontSize}\" "
            + $"text-anchor=\"{anchor}\">{System.Net.WebUtility.HtmlEncode(content)}</text>");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Polar.InitializeAsync();
    }
}
