@* Dashboard: prioritized instrument display. Critical data first. *@

@page "/"
@using OnaPlotter.Services
@using OnaPlotter.Models
@implements IDisposable
@inject SignalkClient SignalkClient

<PageTitle>Dashboard</PageTitle>

@if (Data.LastTimestamp is null)
{
    <div class="text-muted mb-4" style="opacity: 0.6;">Waiting for data...</div>
}

@* === Primary: the three values you check most often === *@
<div class="row g-3 mb-4">
    <div class="col-md-4 col-sm-6">
        <div class="card dash-card-primary">
            <div class="card-body text-center">
                <h6 class="card-subtitle mb-1 text-muted">Speed</h6>
                <p class="card-text" style="font-size:3rem; font-weight:700; margin:0; font-variant-numeric:tabular-nums;">
                    @FormatSpeed(Data.SpeedOverGround)
                </p>
                <small class="text-muted">kn SOG</small>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-sm-6">
        <div class="card dash-card-primary">
            <div class="card-body text-center">
                <h6 class="card-subtitle mb-1 text-muted">Depth</h6>
                <p class="card-text @DepthClass" style="font-size:3rem; font-weight:700; margin:0; font-variant-numeric:tabular-nums;">
                    @FormatDecimal(Data.Depth, "F1")
                </p>
                <small class="text-muted">m</small>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-sm-6">
        <div class="card dash-card-primary">
            <div class="card-body text-center">
                <h6 class="card-subtitle mb-1 text-muted">Heading</h6>
                <p class="card-text" style="font-size:3rem; font-weight:700; margin:0; font-variant-numeric:tabular-nums;">
                    @FormatDegrees(Data.Heading)
                </p>
                <small class="text-muted">deg</small>
            </div>
        </div>
    </div>
</div>

@* === Wind: apparent + true side by side === *@
<h6 class="text-muted mb-2" style="text-transform:uppercase; letter-spacing:0.1em; font-size:0.7rem;">Wind</h6>
<div class="row g-3 mb-4">
    <div class="col-md-3 col-sm-6">
        <div class="card">
            <div class="card-body text-center">
                <h6 class="card-subtitle mb-1 text-muted">AWA</h6>
                <p class="card-text display-6">@FormatDegrees(Data.WindAngleApparent)</p>
                <small class="text-muted">apparent angle</small>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card">
            <div class="card-body text-center">
                <h6 class="card-subtitle mb-1 text-muted">AWS</h6>
                <p class="card-text display-6">@FormatSpeed(Data.WindSpeedApparent)</p>
                <small class="text-muted">kn apparent</small>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card">
            <div class="card-body text-center">
                <h6 class="card-subtitle mb-1 text-muted">TWA</h6>
                <p class="card-text display-6">@FormatDegrees(Data.WindAngleTrue)</p>
                <small class="text-muted">true angle</small>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card">
            <div class="card-body text-center">
                <h6 class="card-subtitle mb-1 text-muted">TWS</h6>
                <p class="card-text display-6">@FormatSpeed(Data.WindSpeedTrue)</p>
                <small class="text-muted">kn true</small>
            </div>
        </div>
    </div>
</div>

@* === Navigation: COG, TWD, Position === *@
<h6 class="text-muted mb-2" style="text-transform:uppercase; letter-spacing:0.1em; font-size:0.7rem;">Navigation</h6>
<div class="row g-3 mb-4">
    <div class="col-md-4 col-sm-6">
        <div class="card">
            <div class="card-body text-center">
                <h6 class="card-subtitle mb-1 text-muted">COG</h6>
                <p class="card-text display-6">@FormatDegrees(Data.CourseOverGround)</p>
                <small class="text-muted">deg</small>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-sm-6">
        <div class="card">
            <div class="card-body text-center">
                <h6 class="card-subtitle mb-1 text-muted">TWD</h6>
                <p class="card-text display-6">@FormatDegrees(Data.WindDirectionTrue)</p>
                <small class="text-muted">from</small>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-sm-6">
        <div class="card">
            <div class="card-body text-center">
                <h6 class="card-subtitle mb-1 text-muted">Position</h6>
                <p class="card-text" style="font-size:1.1rem;">@NauticalFormat.FormatPosition(Data.Latitude, Data.Longitude)</p>
            </div>
        </div>
    </div>
</div>

@* === Active Route (conditional) === *@
@if (Data.HasActiveCourse)
{
    <h6 class="text-muted mb-2" style="text-transform:uppercase; letter-spacing:0.1em; font-size:0.7rem;">
        @(Data.ActiveRouteName ?? "Active Route")
    </h6>
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-sm-6">
            <div class="card">
                <div class="card-body text-center">
                    <h6 class="card-subtitle mb-1 text-muted">DTG</h6>
                    <p class="card-text display-6">@FormatNm(Data.CourseNextPointDistance)</p>
                    <small class="text-muted">nm</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card">
                <div class="card-body text-center">
                    <h6 class="card-subtitle mb-1 text-muted">BRG</h6>
                    <p class="card-text display-6">@FormatDegrees(Data.CourseNextPointBearing)</p>
                    <small class="text-muted">deg</small>
                </div>
            </div>
        </div>
        @if (Data.CourseNextPointVmg is not null)
        {
            <div class="col-md-3 col-sm-6">
                <div class="card">
                    <div class="card-body text-center">
                        <h6 class="card-subtitle mb-1 text-muted">VMG</h6>
                        <p class="card-text display-6">@FormatSpeed(Data.CourseNextPointVmg)</p>
                        <small class="text-muted">kn</small>
                    </div>
                </div>
            </div>
        }
        @if (Data.CrossTrackError is not null)
        {
            <div class="col-md-3 col-sm-6">
                <div class="card">
                    <div class="card-body text-center">
                        <h6 class="card-subtitle mb-1 text-muted">XTE</h6>
                        <p class="card-text display-6 @XteClass">@FormatXte(Data.CrossTrackError)</p>
                    </div>
                </div>
            </div>
        }
        @if (Data.CourseNextPointTimeToGo is not null)
        {
            <div class="col-md-3 col-sm-6">
                <div class="card">
                    <div class="card-body text-center">
                        <h6 class="card-subtitle mb-1 text-muted">TTG</h6>
                        <p class="card-text display-6" style="font-size:1.4rem;">@FormatTTG(Data.CourseNextPointTimeToGo)</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="card">
                    <div class="card-body text-center">
                        <h6 class="card-subtitle mb-1 text-muted">ETA</h6>
                        <p class="card-text display-6" style="font-size:1.4rem;">@FormatEta(Data.CourseNextPointTimeToGo)</p>
                    </div>
                </div>
            </div>
        }
    </div>
}

@if (Data.LastTimestamp is not null)
{
    <p class="text-muted" style="font-size: 0.7rem; opacity: 0.5;">Last update: @Data.LastTimestamp</p>
}

@code {
    private Models.NavigationData Data => SignalkClient.Data;
    private const double MsToKnots = 1.94384;
    private const double RadToDeg = 180.0 / Math.PI;

    private string DepthClass => Data.Depth switch
    {
        null => "",
        < 3 => "depth-danger",
        < 8 => "depth-warn",
        _ => "depth-ok"
    };

    private string XteClass => Data.CrossTrackError switch
    {
        null => "",
        var x when Math.Abs(x.Value) < 50 => "xte-ok",
        var x when Math.Abs(x.Value) < 200 => "xte-warn",
        _ => "xte-danger"
    };

    protected override void OnInitialized()
    {
        SignalkClient.OnDataChanged += HandleDataChanged;
    }

    private async void HandleDataChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    private static string FormatSpeed(double? ms)
    {
        if (ms is null) return "--";
        return (ms.Value * MsToKnots).ToString("F1");
    }

    private static string FormatDegrees(double? rad)
    {
        if (rad is null) return "--";
        double deg = rad.Value * RadToDeg;
        if (deg < 0) deg += 360;
        return deg.ToString("F0");
    }

    private static string FormatDecimal(double? val, string format)
    {
        if (val is null) return "--";
        return val.Value.ToString(format);
    }

    private static string FormatNm(double? meters)
    {
        if (meters is null) return "--";
        double nm = meters.Value / 1852.0;
        return nm < 10 ? nm.ToString("F2") : nm.ToString("F1");
    }

    private static string FormatTTG(double? seconds)
    {
        if (seconds is null) return "--";
        var ts = TimeSpan.FromSeconds(seconds.Value);
        return ts.TotalHours >= 1 ? $"{(int)ts.TotalHours}h{ts.Minutes:D2}m" : $"{ts.Minutes}m{ts.Seconds:D2}s";
    }

    private static string FormatEta(double? ttgSeconds)
    {
        if (ttgSeconds is null) return "--";
        var eta = DateTime.Now.AddSeconds(ttgSeconds.Value);
        return eta.Date == DateTime.Today ? eta.ToString("HH:mm") : eta.ToString("dd.MM HH:mm");
    }

    private static string FormatXte(double? meters)
    {
        if (meters is null) return "--";
        double abs = Math.Abs(meters.Value);
        string side = meters > 0 ? "S" : meters < 0 ? "P" : "";
        return abs < 1000 ? $"{abs:F0}m {side}" : $"{(abs / 1852.0):F2}nm {side}";
    }

    public void Dispose()
    {
        SignalkClient.OnDataChanged -= HandleDataChanged;
    }
}
