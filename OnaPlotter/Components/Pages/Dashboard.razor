@* Dashboard: prioritized instrument display. Critical data first. *@

@page "/"
@using OnaPlotter.Services
@using OnaPlotter.Models
@implements IDisposable
@inject SignalkClient SignalkClient
@inject IPolarService Polar

<PageTitle>Dashboard</PageTitle>

@if (Data.LastReceivedUtc is null)
{
    <div class="text-muted mb-4" style="opacity: 0.6;">Waiting for data...</div>
}

@* === Primary: the three values you check most often ===
   Units sit inline after each digit in .dash-unit (small + muted),
   not as a separate caption below; saves vertical space without
   losing the "this is the unit, not part of the number" cue. *@
<div class="row g-3 mb-4">
    <div class="col-md-4 col-sm-6">
        <div class="card dash-card-primary">
            <div class="card-body text-center">
                <h6 class="card-subtitle mb-1 text-muted">Speed</h6>
                <p class="card-text metric-xl">
                    @Format.Speed(Data.SpeedOverGround)<span class="dash-unit">kn</span>
                </p>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-sm-6">
        <div class="card dash-card-primary">
            <div class="card-body text-center">
                <h6 class="card-subtitle mb-1 text-muted">Depth</h6>
                <p class="card-text metric-xl @Format.DepthClass(Data.Depth)">
                    @Format.Depth(Data.Depth)<span class="dash-unit">m</span>
                </p>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-sm-6">
        <div class="card dash-card-primary">
            <div class="card-body text-center">
                <h6 class="card-subtitle mb-1 text-muted">Heading</h6>
                <p class="card-text metric-xl">
                    @Format.Degrees(Data.Heading)<span class="dash-unit">&deg;</span>
                </p>
            </div>
        </div>
    </div>
</div>

@* === Polar Performance ===
   Only rendered when a polar is actually loaded. Two states:
     1. Polar + wind data -> Performance % + Target BSP cards
     2. Polar loaded, no wind data yet -> "Waiting for TWD/TWS" card
   No-polar boats get nothing here -- the Settings page is where you
   go to upload one, and the Dashboard should stay focused on live
   numbers rather than an empty nag card. *@
@if (Polar.HasPolar && PolarPerformancePct is not null)
{
    <div class="row g-3 mb-4">
        <div class="col-md-4 col-sm-6">
            <div class="card dash-card-primary">
                <div class="card-body text-center">
                    <h6 class="card-subtitle mb-1 text-muted">Performance</h6>
                    <p class="card-text metric-xl @PerfClass">
                        @((PolarPerformancePct.Value * 100).ToString("F0"))%
                    </p>
                    <small class="text-muted">of polar target</small>
                </div>
            </div>
        </div>
        <div class="col-md-4 col-sm-6">
            <div class="card">
                <div class="card-body text-center">
                    <h6 class="card-subtitle mb-1 text-muted">Target BSP</h6>
                    <p class="card-text display-6">@TargetSpeedKn</p>
                    <small class="text-muted">kn</small>
                </div>
            </div>
        </div>
    </div>
}
else if (Polar.HasPolar)
{
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body text-center">
                    <h6 class="card-subtitle mb-1 text-muted">Performance</h6>
                    <p class="card-text metric-md" style="color:var(--sk-text-muted);">
                        Waiting for true-wind data
                    </p>
                    <small class="text-muted">Needs TWD + TWS from SignalK</small>
                </div>
            </div>
        </div>
    </div>
}

@* === Wind: apparent + true side by side === *@
<h6 class="page-section-header mb-2">Wind</h6>
<div class="row g-3 mb-4">
    <div class="col-md-3 col-sm-6">
        <div class="card">
            <div class="card-body text-center">
                <h6 class="card-subtitle mb-1 text-muted">AWA</h6>
                <p class="card-text display-6">@Format.Degrees(Data.WindAngleApparent)<span class="dash-unit">&deg;</span></p>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card">
            <div class="card-body text-center">
                <h6 class="card-subtitle mb-1 text-muted">AWS</h6>
                <p class="card-text display-6">@Format.Speed(Data.WindSpeedApparent)<span class="dash-unit">kn</span></p>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card">
            <div class="card-body text-center">
                <h6 class="card-subtitle mb-1 text-muted">TWA</h6>
                <p class="card-text display-6">@Format.Degrees(Data.WindAngleTrue)<span class="dash-unit">&deg;</span></p>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card">
            <div class="card-body text-center">
                <h6 class="card-subtitle mb-1 text-muted">TWS</h6>
                <p class="card-text display-6">@Format.Speed(Data.WindSpeedTrue)<span class="dash-unit">kn</span></p>
            </div>
        </div>
    </div>
</div>

@* === Navigation: HDG, COG, TWD, Position ===
   HDG repeats here (it's also one of the three primary cards above)
   because navigators expect it next to COG -- the angular delta
   between the two is the heart of leeway / set-and-drift reading. *@
<h6 class="page-section-header mb-2">Navigation</h6>
<div class="row g-3 mb-4">
    <div class="col-md-3 col-sm-6">
        <div class="card">
            <div class="card-body text-center">
                <h6 class="card-subtitle mb-1 text-muted">HDG</h6>
                <p class="card-text display-6">@Format.Degrees(Data.Heading)<span class="dash-unit">&deg;</span></p>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card">
            <div class="card-body text-center">
                <h6 class="card-subtitle mb-1 text-muted">COG</h6>
                <p class="card-text display-6">@Format.Degrees(Data.CourseOverGround)<span class="dash-unit">&deg;</span></p>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card">
            <div class="card-body text-center">
                @* TWD is the meteorological "where the wind is coming
                   FROM" angle, not the "where it's going TO" angle like
                   COG. The convention is universal in sailing but worth
                   disambiguating in a tooltip rather than a stray small
                   caption (the previous one read just "from" with no
                   context, which raised "what is from?" reactions). *@
                <h6 class="card-subtitle mb-1 text-muted"
                    title="True wind direction (the bearing the wind is coming FROM)">TWD</h6>
                <p class="card-text display-6">@Format.Degrees(Data.WindDirectionTrue)<span class="dash-unit">&deg;</span></p>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card">
            <div class="card-body text-center">
                <h6 class="card-subtitle mb-1 text-muted">Position</h6>
                @* Stack lat/lon so this card matches the height of the
                   COG/TWD cards in the same row, and each value gets its
                   own line for easy reading at a glance. Both lines use
                   mb-0 so the card's total height matches the sibling
                   cards' single display-6 line rather than inheriting
                   Bootstrap's default paragraph bottom-margin on the
                   first line. *@
                @* display-6 (300) matches every other dashboard metric;
                   metric-lg (600) used to render the lat / lon noticeably
                   bolder than the rest of the grid -- helm wanted it to
                   look the same as SOG / depth / etc. *@
                <p class="card-text display-6 mb-0">@NauticalFormat.FormatLat(Data.Latitude)</p>
                <p class="card-text display-6 mb-0">@NauticalFormat.FormatLon(Data.Longitude)</p>
            </div>
        </div>
    </div>
</div>

@* === Tide (conditional: only when a SignalK tide plugin publishes data) === *@
@if (HasTideData)
{
    <h6 class="page-section-header mb-2">
        Tide
        @if (!string.IsNullOrWhiteSpace(Data.TideStationName))
        {
            @* Dashboard has a full-width header to spend; render the
               whole NOAA / UKHO station name. The map HUD truncates
               (where horizontal space is tight); see HudDepthCard. *@
            <span class="tide-station-name">@Data.TideStationName</span>
        }
    </h6>
    <div class="row g-3 mb-4">
        @if (Data.TideHeightNow is double hNow)
        {
            <div class="col-md-4 col-sm-6">
                <div class="card">
                    <div class="card-body text-center">
                        @* "Chart datum" is the proper term sailors recognise -- the
                           reference depth on the chart against which both tide heights
                           and depth soundings are stated. The previous "above datum"
                           was technically correct but read as jargon ("what is datum?").
                           Tooltip on the small caption explains the underlying datum
                           convention for non-sailors. *@
                        <h6 class="card-subtitle mb-1 text-muted">Height now</h6>
                        <p class="card-text display-6">
                            @hNow.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)
                        </p>
                        <small class="text-muted"
                               title="Metres above chart datum (the reference depth used on charts; usually Lowest Astronomical Tide)">
                            m above chart datum
                        </small>
                    </div>
                </div>
            </div>
        }
        @if (Data.TideTimeHigh is DateTime th && th > DateTime.UtcNow)
        {
            <div class="col-md-4 col-sm-6">
                <div class="card">
                    <div class="card-body text-center">
                        <h6 class="card-subtitle mb-1 text-muted">Next HW</h6>
                        <p class="card-text display-6">
                            @th.ToLocalTime().ToString("HH:mm")
                        </p>
                        <small class="text-muted">
                            @if (Data.TideHeightHigh is double hh)
                            {
                                @:@hh.ToString("F1", System.Globalization.CultureInfo.InvariantCulture) m,
                            }
                            @FormatDashInterval(th)
                        </small>
                    </div>
                </div>
            </div>
        }
        @if (Data.TideTimeLow is DateTime tl && tl > DateTime.UtcNow)
        {
            <div class="col-md-4 col-sm-6">
                <div class="card">
                    <div class="card-body text-center">
                        <h6 class="card-subtitle mb-1 text-muted">Next LW</h6>
                        <p class="card-text display-6">
                            @tl.ToLocalTime().ToString("HH:mm")
                        </p>
                        <small class="text-muted">
                            @if (Data.TideHeightLow is double hl)
                            {
                                @:@hl.ToString("F1", System.Globalization.CultureInfo.InvariantCulture) m,
                            }
                            @FormatDashInterval(tl)
                        </small>
                    </div>
                </div>
            </div>
        }
    </div>
}

@* === Active Route (conditional) === *@
@if (Data.HasActiveCourse)
{
    <h6 class="page-section-header mb-2">
        @(Data.ActiveRouteName ?? "Active Route")
    </h6>
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-sm-6">
            <div class="card">
                <div class="card-body text-center">
                    <h6 class="card-subtitle mb-1 text-muted">DTG</h6>
                    <p class="card-text display-6">@Format.Nm(Data.CourseNextPointDistance)<span class="dash-unit">nm</span></p>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card">
                <div class="card-body text-center">
                    <h6 class="card-subtitle mb-1 text-muted">BRG</h6>
                    <p class="card-text display-6">@Format.Degrees(Data.CourseNextPointBearing)<span class="dash-unit">&deg;</span></p>
                </div>
            </div>
        </div>
        @if (Data.CourseNextPointVmg is not null)
        {
            <div class="col-md-3 col-sm-6">
                <div class="card">
                    <div class="card-body text-center">
                        <h6 class="card-subtitle mb-1 text-muted">VMG</h6>
                        <p class="card-text display-6">@Format.Speed(Data.CourseNextPointVmg)<span class="dash-unit">kn</span></p>
                    </div>
                </div>
            </div>
        }
        @if (Data.CrossTrackError is not null)
        {
            <div class="col-md-3 col-sm-6">
                <div class="card">
                    <div class="card-body text-center">
                        <h6 class="card-subtitle mb-1 text-muted">XTE</h6>
                        <p class="card-text display-6 @Format.XteClass(Data.CrossTrackError)">@Format.Xte(Data.CrossTrackError)</p>
                    </div>
                </div>
            </div>
        }
        @if (Data.CourseNextPointTimeToGo is not null)
        {
            <div class="col-md-3 col-sm-6">
                <div class="card">
                    <div class="card-body text-center">
                        <h6 class="card-subtitle mb-1 text-muted">TTG</h6>
                        <p class="card-text display-6">@Format.TimeToGo(Data.CourseNextPointTimeToGo)</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="card">
                    <div class="card-body text-center">
                        <h6 class="card-subtitle mb-1 text-muted">ETA</h6>
                        <p class="card-text display-6">@Format.Eta(Data.CourseNextPointTimeToGo)</p>
                    </div>
                </div>
            </div>
        }
    </div>
}

@if (Data.LastReceivedUtc is DateTime lastRx)
{
    <p class="text-muted" style="font-size: 0.7rem; opacity: 0.5;">Last update: @lastRx.ToLocalTime().ToString("HH:mm:ss")</p>
}

@code {
    private Models.NavigationData Data => SignalkClient.Data;

    // Polar performance (returns null if polar not loaded or wind data missing).
    private double? PolarPerformancePct
    {
        get
        {
            if (!Polar.HasPolar || Data.SpeedOverGround is null
                || Data.WindAngleTrue is null || Data.WindSpeedTrue is null)
                return null;
            double sogKn = Data.SpeedOverGround.Value * Format.MsToKnots;
            double twaDeg = Data.WindAngleTrue.Value * Format.RadToDeg;
            double twsKn = Data.WindSpeedTrue.Value * Format.MsToKnots;
            return Polar.GetPerformance(sogKn, twaDeg, twsKn);
        }
    }

    private string TargetSpeedKn
    {
        get
        {
            if (!Polar.HasPolar || Data.WindAngleTrue is null || Data.WindSpeedTrue is null) return "--";
            double twaDeg = Data.WindAngleTrue.Value * Format.RadToDeg;
            double twsKn = Data.WindSpeedTrue.Value * Format.MsToKnots;
            var target = Polar.GetTargetSpeed(twaDeg, twsKn);
            return target is not null ? target.Value.ToString("F1") : "--";
        }
    }

    private string PerfClass => PolarPerformancePct switch
    {
        null => "",
        >= 0.95 => "depth-ok",
        >= 0.80 => "depth-warn",
        _ => "depth-danger"
    };

    private bool HasTideData =>
        Data.TideHeightNow is not null
        || Data.TideTimeHigh is not null
        || Data.TideTimeLow is not null;

    private static string FormatDashInterval(DateTime futureUtc)
    {
        var span = futureUtc - DateTime.UtcNow;
        if (span.TotalSeconds <= 0) return "now";
        if (span.TotalMinutes < 60) return $"in {(int)span.TotalMinutes}m";
        int hours = (int)span.TotalHours;
        int minutes = (int)(span.TotalMinutes - hours * 60);
        return minutes == 0 ? $"in {hours}h" : $"in {hours}h{minutes:D2}";
    }


    protected override async Task OnInitializedAsync()
    {
        SignalkClient.OnDataChanged += HandleDataChanged;
        await Polar.InitializeAsync();
    }

    /// <summary>Quantised snapshot of every Dashboard-rendered field
    /// so a SignalK delta that changes nothing visible (e.g. depth
    /// shifting from 4.235 m to 4.241 m, both rendering as "4.2 m")
    /// doesn't fire a full re-render of the 30+ Bootstrap cards.
    /// Each field is rounded to the same precision the
    /// Format.* helpers display, so two snapshots compare equal
    /// exactly when the rendered HTML would be the same. Drives
    /// HandleDataChanged's gate.</summary>
    private record struct DashboardSnapshot(
        double? SogKn, double? CogDeg, double? HdgDeg, double? DepthM,
        double? AwaDeg, double? AwsKn, double? TwaDeg, double? TwsKn, double? TwdDeg,
        double? Lat, double? Lon,
        double? Vmg, double? Xte, double? DistanceNm, double? BrgDeg, double? TtgSec,
        bool AnchorActive, double? AnchorRadius, string? SunState);

    private DashboardSnapshot _lastSnapshot;

    private DashboardSnapshot CurrentSnapshot()
    {
        var d = SignalkClient.Data;
        // Round to one decimal for display-grade quantisation. The
        // Format.Speed / Format.Degrees helpers display 1-decimal
        // precision; rounding here matches what the helm sees on
        // screen and lets two effectively-identical snapshots
        // compare equal. Lat/Lon at 5 decimals (~1 m precision).
        static double? R(double? v, int dec) => v is double x ? Math.Round(x, dec) : null;
        return new DashboardSnapshot(
            R(d.SpeedOverGround, 1), R(d.CourseOverGround, 1), R(d.HeadingTrue, 1), R(d.Depth, 1),
            R(d.WindAngleApparent, 1), R(d.WindSpeedApparent, 1),
            R(d.WindAngleTrue, 1), R(d.WindSpeedTrue, 1), R(d.WindDirectionTrue, 1),
            R(d.Latitude, 5), R(d.Longitude, 5),
            R(d.CourseNextPointVmg, 1), R(d.CrossTrackError, 1),
            R(d.CourseNextPointDistance, 1), R(d.CourseNextPointBearing, 1),
            R(d.CourseNextPointTimeToGo, 1),
            d.AnchorActive, R(d.AnchorCurrentRadius, 1), d.SunState);
    }

    /// <summary>Re-render gate: compare a quantised snapshot of every
    /// rendered field against the last one we acted on; skip when
    /// nothing the helm would notice has changed. Compiled once and
    /// reused across the SignalK delta cadence; saves the 30-card
    /// Bootstrap grid rebuild on idle ticks (most ticks). Pi 4 sees
    /// 5-20 ms saved per tick.</summary>
    private async void HandleDataChanged()
    {
        var snap = CurrentSnapshot();
        if (snap.Equals(_lastSnapshot)) return;
        _lastSnapshot = snap;
        try { await InvokeAsync(StateHasChanged); }
        catch (ObjectDisposedException) { }
    }

    public void Dispose()
    {
        SignalkClient.OnDataChanged -= HandleDataChanged;
    }
}
