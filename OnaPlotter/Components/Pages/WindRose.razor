@* Polar plot of apparent wind angle vs speed from track history. *@

@page "/wind"
@using OnaPlotter.Services
@using OnaPlotter.Services.Api
@using OnaPlotter.Models
@implements IDisposable
@inject SignalkClient SignalkClient
@inject IPolarService Polar
@inject IAppSettings Settings
@inject INavigationAverages Avg
@inject ITrackApi TrackApi

<PageTitle>Wind</PageTitle>

@* Back-to-chart chip removed - the sidebar + topbar already surface
   navigation back to the map, and the chip duplicated that affordance
   without earning its screen real estate. *@

@*
   Layout: two-column grid on screens >= 960 px (iPad landscape and
   any helm display); single column below. Left = polar rose; right =
   live readouts + history. Both columns sit inside .wind-card so the
   page reads as two grouped instrument clusters rather than four
   floating tiles.

   SVG colours come from theme tokens (no hex literals on the page)
   so night-mode + high-contrast modes follow without per-chart
   overrides. SVG text inherits Inter Variable via .wind-page svg
   text { font-family: inherit } - one rule fixes the "mixed fonts"
   complaint everywhere SVG text appears.

   Page-level controls: Apparent/True + a single time-window selector
   govern ALL cards (rose dot retention, hero readout, variability
   chips, history chart). The previous per-card selectors confused
   helms who couldn't tell why "30m here, 2m there" produced mismatched
   numbers for the same instant in time.
*@
<div class="app-page wind-page">
    <header class="app-page-header wind-page-header">
        <h1>Wind</h1>
        @* Apparent / True applies to the hero readout, the variability
           chips, AND the history chart. The polar rose stays on AWA
           (the rose's tactical reading is "where in my apparent wind
           window am I sailing?" - a true-wind rose would answer a
           different question and isn't worth the data-shape change). *@
        <div class="segmented segmented-sm" role="group" aria-label="Wind reference">
            <input type="radio" class="btn-check" name="@($"wind-mode-{_uid}")"
                   id="@($"wind-mode-app-{_uid}")" autocomplete="off"
                   checked="@(heroMode == "apparent")"
                   @onchange='() => SetHeroMode("apparent")' />
            <label class="btn" for="@($"wind-mode-app-{_uid}")">Apparent</label>
            <input type="radio" class="btn-check" name="@($"wind-mode-{_uid}")"
                   id="@($"wind-mode-true-{_uid}")" autocomplete="off"
                   checked="@(heroMode == "true")"
                   @onchange='() => SetHeroMode("true")' />
            <label class="btn" for="@($"wind-mode-true-{_uid}")">True</label>
        </div>
        @* Unified time window. Drives rose retention, history chart
           span, variability-chip window. Re-seeds the NavigationAverages
           wind buffers when the helm picks a window larger than what
           has been fetched so far. *@
        <TimeWindowSelector Value="windowMinutes"
                            ValueChanged="OnWindowChangedAsync"
                            Choices="WindowChoices"
                            AriaLabel="History window" />
    </header>

    <div class="wind-grid">
        @* === Left column: the polar rose + colour legend === *@
        <section class="wind-card wind-rose-section" aria-label="Wind rose">
            <div class="wind-rose-canvas">
                @if (!HasAnyWind)
                {
                    @* State-aware empty state - the helm landing on the page
                       with no rose data wants to know WHY. Three diagnoses:
                       (a) no SignalK feed at all, (b) feed up but cold-start
                       (no environment.wind.* paths yet), (c) feed up but
                       stale (link wedged after a few good deltas). The
                       SignalkClient already exposes IsConnected and
                       IsDataStale, so the page just dispatches on those. *@
                    var emptyState = ResolveEmptyState();
                    <div class="instrument-empty-state" role="status">
                        <strong>@emptyState.Title</strong>
                        @emptyState.Detail
                    </div>
                }
                <svg class="wind-rose-svg" viewBox="0 0 @Size @Size">
        @* Background circles. Stroke uses the theme token so the
           grid follows night / light / high-contrast modes. *@
        @for (int i = 1; i <= RingCount; i++)
        {
            double r = i * ringSpacing;
            <circle cx="@Cx" cy="@Cy" r="@r" fill="none"
                    style="stroke: var(--sk-border);" stroke-width="0.5" />
        }

        @* Compass direction lines + labels. Cardinals (N/E/S/W) are
           emphasised: larger size, weight 600, full --sk-text colour
           so the eye anchors on them at a glance. Numeric inter-
           mediates stay muted. Standard compass-rose convention. *@
        @foreach (var deg in compassDegrees)
        {
            double rad = deg * Math.PI / 180.0;
            double x1 = Cx + Math.Sin(rad) * 20;
            double y1 = Cy - Math.Cos(rad) * 20;
            double x2 = Cx + Math.Sin(rad) * MaxRadius;
            double y2 = Cy - Math.Cos(rad) * MaxRadius;
            double lx = Cx + Math.Sin(rad) * (MaxRadius + 14);
            double ly = Cy - Math.Cos(rad) * (MaxRadius + 14);
            bool isCardinal = deg is 0 or 90 or 180 or 270;
            <line x1="@x1" y1="@y1" x2="@x2" y2="@y2"
                  style="stroke: var(--sk-border);" stroke-width="0.5" />
            @SvgText(lx, ly, CompassLabel(deg),
                isCardinal ? "var(--sk-text)" : "var(--sk-text-muted)",
                isCardinal ? 13 : 10,
                fontWeight: isCardinal ? "600" : null)
        }

        @* Speed ring labels (knots). Placed just INSIDE each ring at
           the top so the outermost ("30 kn") doesn't crowd the
           cardinal label sitting outside the ring. Token colour, no
           hex literal. *@
        @for (int i = 1; i <= RingCount; i++)
        {
            double r = i * ringSpacing;
            double kn = i * speedPerRing;
            @SvgText(Cx + 4, Cy - r + 12, $"{kn:F0} kn",
                "var(--sk-text-muted)", 10, anchor: "start")
        }

        @* Historical wind data points, filtered to the unified
           window. The list is kept up to 24 h so picking a shorter
           window (e.g. "10m") doesn't discard data that a re-widening
           to "1h" would have to re-fetch. *@
        @{
            DateTime windowCutoff = DateTime.UtcNow - TimeSpan.FromMinutes(windowMinutes);
        }
        @foreach (var pt in windPoints)
        {
            if (pt.Time < windowCutoff) continue;
            <circle cx="@pt.X" cy="@pt.Y" r="2.5" fill="@pt.Color" opacity="0.6" />
        }

        @* Polar curve overlay (when polar loaded and TWS available) *@
        @if (Polar.HasPolar && SignalkClient.Data.WindSpeedTrue is not null)
        {
            double twsKn = SignalkClient.Data.WindSpeedTrue.Value * MsToKnots;
            var curve = Polar.GetPolarCurve(twsKn);
            if (curve.Length > 0)
            {
                var sb = new System.Text.StringBuilder();
                foreach (var (twa, spd) in curve)
                {
                    double angleRad = twa * Math.PI / 180.0;
                    double frac = Math.Min(spd / MaxSpeedKn, 1.0);
                    double r = frac * MaxRadius;
                    double px = Cx + Math.Sin(angleRad) * r;
                    double py = Cy - Math.Cos(angleRad) * r;
                    if (sb.Length > 0) sb.Append(' ');
                    sb.Append($"{px:F1},{py:F1}");
                }
                // Mirror for port side (negative angles).
                for (int i = curve.Length - 1; i >= 0; i--)
                {
                    double angleRad = -curve[i].Twa * Math.PI / 180.0;
                    double frac = Math.Min(curve[i].Speed / MaxSpeedKn, 1.0);
                    double r = frac * MaxRadius;
                    double px = Cx + Math.Sin(angleRad) * r;
                    double py = Cy - Math.Cos(angleRad) * r;
                    sb.Append($" {px:F1},{py:F1}");
                }
                <polyline fill="none" style="stroke: var(--sk-cyan);" stroke-width="2" opacity="0.7"
                          stroke-dasharray="4,3" points="@sb.ToString()">
                    <title>Boat polar: target boat speed at each TWA for the current TWS (@twsKn.ToString("F1") kn)</title>
                </polyline>
            }
        }

        @* Current wind arrow. currentColor inherits from the parent
           text colour (--sk-text, red-shifted in night mode). *@
        @if (currentWind is not null)
        {
            double rad = currentWind.Value.Angle;
            double speedFrac = Math.Min(currentWind.Value.SpeedKn / MaxSpeedKn, 1.0);
            double len = speedFrac * MaxRadius;
            double tipX = Cx + Math.Sin(rad) * len;
            double tipY = Cy - Math.Cos(rad) * len;
            <line x1="@Cx" y1="@Cy" x2="@tipX" y2="@tipY"
                  style="stroke: currentColor;" stroke-width="2.5" stroke-linecap="round" />
            <circle cx="@tipX" cy="@tipY" r="4" style="fill: currentColor;" />
        }
                </svg>

                @* Legend. Gradient id is per-component so if two WindRose
                   instances co-exist on a page, their SVG defs don't collide -
                   a stale cached gradient would otherwise paint the second
                   instance's rect grey. *@
                <div class="wind-legend">
                    <span class="wind-legend-label">Wind (kn)</span>
                    @* "Wind" not "Speed" - the rose's radial axis is wind
                       speed, not boat speed. The optional polar overlay
                       uses the same radial axis but encodes BOAT speed
                       (target BSP at given TWA / TWS), which is the dual-
                       axis confusion Tom (the tactician persona) flagged
                       in the field study. The .wind-polar-key chip below
                       the rose names the polar curve explicitly. *@
                    @* SVG width 44 (was 30): the rect occupies 16 px on
                       the left edge, leaving x=20..44 for the labels.
                       At width 30 the labels were anchored at x=20 with
                       only 10 px of room, so a two-digit MaxSpeedKn
                       like "30" was clipped at the right edge - the
                       helm saw "3" alone for the top tick. 44 px gives
                       room for up to three digits. *@
                    @* SVG height 188 (was 180) - the bottom "0" tick
                       sat at baseline y=178 with a 10 px font, and
                       the digit descender extended past y=180,
                       clipping the lower curve of the "0" against
                       the SVG box edge. The gradient rect still
                       runs 0..180 so the colour band lines up with
                       the top "30" tick at y=12; the extra 8 px
                       below the rect just lets the "0" glyph live
                       inside the SVG. *@
                    <svg width="44" height="188" aria-hidden="true">
                        <defs>
                            @* Viridis stops - match SpeedColor() in the
                               @code block. Perceptually uniform in
                               lightness so the legend reads the same
                               under colour-blindness and polarised sun. *@
                            <linearGradient id="@GradientId" x1="0" y1="1" x2="0" y2="0">
                                <stop offset="0%"   stop-color="#440154" />
                                <stop offset="25%"  stop-color="#3b528b" />
                                <stop offset="50%"  stop-color="#21918c" />
                                <stop offset="75%"  stop-color="#5ec962" />
                                <stop offset="100%" stop-color="#fde725" />
                            </linearGradient>
                        </defs>
                        <rect x="0" y="0" width="16" height="180" fill="url(#@GradientId)" rx="2" />
                        @SvgText(20, 12, $"{MaxSpeedKn:F0}", "currentColor", 10, anchor: "start")
                        @SvgText(20, 95, $"{MaxSpeedKn / 2:F0}", "currentColor", 10, anchor: "start")
                        @SvgText(20, 178, "0", "currentColor", 10, anchor: "start")
                    </svg>
                </div>
            </div>

            @* Polar key. Renders only when the polar service has data
               AND TWS is published, i.e. exactly the conditions that
               make the dashed cyan curve visible on the rose. Names
               the curve as a BOAT-SPEED target (radial axis here is
               wind speed for the dots; same line shows boat speed at
               TWA for current TWS) so the helm doesn't mis-read it
               as "wind shape". The "more in SailSteer" hint points to
               the dedicated tactical polar view; both pages share the
               same PolarService, no duplication. *@
            @if (Polar.HasPolar && SignalkClient.Data.WindSpeedTrue is not null)
            {
                <div class="wind-polar-key">
                    <span class="wind-polar-key-swatch" aria-hidden="true"></span>
                    <span class="wind-polar-key-text">
                        Boat polar &middot; target BSP at each TWA for current TWS
                    </span>
                    <a class="wind-polar-key-link" href="/sailsteer">SailSteer &rarr;</a>
                </div>
            }
        </section>

        @* === Right column: live readouts + history chart. <section>
           (not <aside>) because this column is the page's primary
           live data, not a tangentially-related sidebar - the
           "region" landmark is correctly announced to screen readers. *@
        <section class="wind-aside" aria-label="Live wind and history">
            @* Hero card. Eyebrow + value pair. Apparent vs True is
               driven from the page header so the same pick steers the
               history chart and the variability chips. True mode shows
               TWD (compass-from-north) + TWS; apparent shows AWA
               (0-360 relative to bow) + AWS. *@
            <section class="wind-card wind-hero" aria-label="Live wind">
                <div class="wind-hero-header">
                    <div class="wind-hero-eyebrow">@(heroMode == "true" ? "True wind" : "Apparent wind")</div>
                </div>
                <div class="wind-hero-readouts">
                    <div class="wind-hero-primary">
                        <span class="wind-hero-value">@HeroSpeedDisplay</span>
                        <span class="wind-hero-unit">kn</span>
                    </div>
                    <div class="wind-hero-secondary">
                        <span class="wind-hero-angle">@HeroAngleDisplay</span>
                    </div>
                </div>

                @* Variability chips: gust / lull / mean / var over the
                   unified window. Rendered only when the buffer has
                   enough samples to compute meaningful stats, so a
                   silent chip strip means "not enough data yet" rather
                   than "the wind is dead calm". The Shift chip lives
                   below as the always-on numeric headline above the
                   history chart. *@
                @{
                    string windowLabel = WindowLabel(windowMinutes);
                    string speedSourceLabel = heroMode == "true" ? "TWS" : "AWS";
                }
                @if (WindStats is (double gust, double lull, double mean, double sigma))
                {
                    <div class="wind-badges">
                        <span class="instrument-badge @(gust > 3 ? "instrument-badge-warn" : "")"
                              title="Peak @speedSourceLabel minus mean over the last @windowLabel">
                            <span class="instrument-badge-label">Gust</span>
                            +@gust.ToString("F1") kn
                        </span>
                        <span class="instrument-badge"
                              title="Lowest @speedSourceLabel minus mean over the last @windowLabel">
                            <span class="instrument-badge-label">Lull</span>
                            -@lull.ToString("F1") kn
                        </span>
                        <span class="instrument-badge"
                              title="Mean @speedSourceLabel over the last @windowLabel">
                            <span class="instrument-badge-label">Mean</span>
                            @mean.ToString("F1") kn
                        </span>
                        <span class="instrument-badge @(sigma > 4 ? "instrument-badge-warn" : "")"
                              title="Standard deviation of @speedSourceLabel over the last @windowLabel - higher = gustier / more variable">
                            <span class="instrument-badge-label">Var</span>
                            ±@sigma.ToString("F1") kn
                        </span>
                    </div>
                }
            </section>

            @* === TWD history strip ===
               Render bar:
                 - Suppress the chart entirely when fewer than 5 samples
                   exist or the timespan is < 30 s. A 2-point line with
                   a degenerate axis is misleading on a tactical display.
                 - Sample count moves to the section header (right-
                   aligned), separating "ambient state" from "chart
                   legend" - the previous one-line meta concatenated
                   three orthogonal facts. *@
            @{
                // Pull the active view's samples from the shared
                // NavigationAverages buffer. Projection depends on
                // (heroMode, historyView):
                //   apparent + direction -> AWA (rad -> deg [0,360))
                //   apparent + speed     -> AWS (m/s -> kn)
                //   true     + direction -> TWD (rad -> deg [0,360))
                //   true     + speed     -> TWS (m/s -> kn)
                var visible = GetHistorySamples(heroMode, historyView);
                bool hasUsableHistory = visible.Count >= 5
                    && (visible[^1].Time - visible[0].Time).TotalSeconds >= 30;
                int totalHistoryCount = Avg.Twd.Count + Avg.Tws.Count
                                      + Avg.Awa.Count + Avg.Aws.Count;
            }

            @if (totalHistoryCount > 1)
            {
                <section class="wind-card wind-history-section" aria-label="Wind history">
                    <header class="wind-section-header">
                        <h2 class="wind-section-title">Wind history</h2>
                        @* Direction / Speed toggle. Cruisers ask "is the
                           breeze settling for the night?"; racers ask
                           "is the wind shifting right?". Same chart
                           machinery, different y-axis projection. *@
                        <div class="segmented segmented-sm" role="group" aria-label="History view">
                            <input type="radio" class="btn-check" name="@($"hview-{_uid}")"
                                   id="@($"hview-dir-{_uid}")" autocomplete="off"
                                   checked="@(historyView == "direction")"
                                   @onchange='() => SetHistoryView("direction")' />
                            <label class="btn" for="@($"hview-dir-{_uid}")">Direction</label>
                            <input type="radio" class="btn-check" name="@($"hview-{_uid}")"
                                   id="@($"hview-spd-{_uid}")" autocomplete="off"
                                   checked="@(historyView == "speed")"
                                   @onchange='() => SetHistoryView("speed")' />
                            <label class="btn" for="@($"hview-spd-{_uid}")">Speed</label>
                        </div>
                        <span class="wind-section-meta wind-section-count">@visible.Count samples</span>
                    </header>

                    @* TWD slope numeric headline, always-on. Three
                       states: (a) numeric value with veering / backing /
                       steady label and a directional glyph; (b) "Steady"
                       when |slope| < 0.5 deg/min; (c) "Awaiting samples"
                       when fewer than 5 samples in the 5-min slope window.
                       Always reports TWD slope (the tactical shift
                       signal) regardless of whether the chart below is
                       in apparent or true mode - hence the explicit
                       "TWD" tag in the label. *@
                    <div class="wind-shift-headline" aria-live="polite">
                        @if (ShiftRate is double rate)
                        {
                            string trend = Math.Abs(rate) < 0.5 ? "Steady"
                                         : rate > 0 ? "Veering" : "Backing";
                            string glyph = Math.Abs(rate) < 0.5 ? "—"
                                         : rate > 0 ? "▲" : "▼";
                            string sign = rate >= 0 ? "+" : "";
                            string cls = Math.Abs(rate) >= 3 ? "wind-shift-strong"
                                       : Math.Abs(rate) >= 1 ? "wind-shift-mid"
                                       : "wind-shift-weak";
                            <span class="wind-shift-value @cls">@glyph @sign@rate.ToString("F1")&deg;/min</span>
                            <span class="wind-shift-label">@trend &middot; TWD over last @ShiftRateWindowMin min</span>
                        }
                        else
                        {
                            <span class="wind-shift-empty">Awaiting samples for shift detection</span>
                        }
                    </div>

                    @if (hasUsableHistory)
                    {
                        <svg class="wind-history-svg" viewBox="0 0 @WpWidth @WpHeight">
        @* Compute axis bounds once per render. For Direction view we
           use the unfolded degree range; for Speed view, knots. Mean
           line follows the same axis. *@
        @{
            (double yMin, double yMax, double yMean) = ComputeYAxis(visible, historyView);
            DateTime oldest = visible[0].Time;
            DateTime newest = visible[^1].Time;
            double timeSpan = Math.Max((newest - oldest).TotalSeconds, 1);
            double yRange = yMax - yMin;
            string axisUnit = historyView == "speed" ? "kn" : "°";
            string axisFmt = historyView == "speed" ? "F1" : "F0";
        }

        @* Grid lines + axis labels. *@
        @for (int i = 0; i <= 4; i++)
        {
            double y = WpPad + (WpPlotH * i / 4.0);
            double yVal = yMax - yRange * i / 4.0;
            <line x1="@WpPad" y1="@F(y)" x2="@(WpWidth - 10)" y2="@F(y)"
                  style="stroke: var(--sk-border);" stroke-width="0.5" />
            @SvgText(WpPad - 4, y, yVal.ToString(axisFmt, System.Globalization.CultureInfo.InvariantCulture),
                "var(--sk-text-muted)", 10, anchor: "end")
        }
        @* Y-axis unit (top-left corner) so the helm doesn't have to
           guess "is this kn or degrees?" when toggling views. *@
        @SvgText(WpPad - 4, WpPad - 14, axisUnit, "var(--sk-text-muted)", 10, anchor: "end")

        @* Mean line *@
        @{
            double meanY = WpPad + WpPlotH * (1 - (yMean - yMin) / yRange);
        }
        <line x1="@WpPad" y1="@F(meanY)" x2="@(WpWidth - 10)" y2="@F(meanY)"
              style="stroke: var(--sev-ok);" stroke-width="1.5" stroke-dasharray="6,4" opacity="0.7" />

        @* Data polyline. Accent blue so night mode red-shifts it. *@
        <polyline fill="none" style="stroke: var(--sk-accent);" stroke-width="1.5" opacity="0.9"
                  points="@HistoryPolylinePoints(visible, yMin, yMax, oldest, timeSpan)" />

        @* Time axis labels. Format adapts to span (-Ns / -N.Nm / -Nm). *@
        @for (int i = 0; i <= 3; i++)
        {
            double x = WpPad + (WpPlotW * i / 3.0);
            double secsAgo = timeSpan * (1 - i / 3.0);
            @SvgText(x, WpHeight - 4, FormatAgo(secsAgo),
                "var(--sk-text-muted)", 10)
        }

        @* Inline mean legend top-right. *@
        <line x1="@(WpWidth - 80)" y1="14" x2="@(WpWidth - 64)" y2="14"
              style="stroke: var(--sev-ok);" stroke-width="1.5" stroke-dasharray="4,3" opacity="0.7" />
        @SvgText(WpWidth - 60, 14, "mean", "var(--sk-text-muted)", 10, anchor: "start")
                        </svg>
                    }
                    else
                    {
                        <p class="wind-history-empty">
                            Collecting samples; chart appears once @(5 - visible.Count) more land.
                        </p>
                    }
                </section>
            }
        </section>
    </div>
</div>

@code {
    // Per-instance gradient id so the <linearGradient> in the legend
    // defs doesn't collide if two WindRose components render in the
    // same DOM (unlikely today but cheap defence).
    private readonly string GradientId = "speedGrad-" + Guid.NewGuid().ToString("N")[..8];

    private const int Size = 420;
    private const double Cx = Size / 2.0;
    private const double Cy = Size / 2.0;
    private const double MaxRadius = 170;
    private const int RingCount = 5;
    private const double MaxSpeedKn = 30;
    private const double MsToKnots = Format.MsToKnots;

    private readonly double ringSpacing = MaxRadius / RingCount;
    private readonly double speedPerRing = MaxSpeedKn / RingCount;
    private static readonly int[] compassDegrees = [0, 30, 60, 90, 120, 150, 180, 210, 240, 270, 300, 330];

    // Polar-scatter samples for the rose. The page owns this list -
    // historical samples come from the SignalK history API
    // (SeedWindAsync) and live samples from SignalkClient.OnDataChanged
    // throttled to 5s grain. The list retains up to PolarRetention
    // (matches the longest unified window) so the helm can scrub
    // 1m -> 24h -> 1m -> 24h without re-fetching every time the window
    // shrinks. Render-side filtering trims to the current windowMinutes.
    private List<WindPoint> windPoints = [];
    private (double Angle, double SpeedKn)? currentWind;
    private (double TwdRad, double TwsKn)? currentTrueWind;

    /// <summary>Polar scatter buffer retention. Matches the longest
    /// unified history-window choice (24 h) so shortening then
    /// re-widening the window doesn't lose data the page already has.</summary>
    private static readonly TimeSpan PolarRetention = TimeSpan.FromHours(24);

    /// <summary>Live-sample throttle. SignalkClient.OnDataChanged
    /// fires 1-3 Hz; without a gate a long sit on the page would push
    /// past 17 000 SVG circles at the 24 h ceiling. 5 s matches the
    /// seed cadence so dot density is consistent across historical
    /// and live regions.</summary>
    private const int LiveSampleIntervalMs = 5_000;
    private DateTime _lastLiveSampleUtc = DateTime.MinValue;

    // Per-instance suffix for radio-group names so two WindRose
    // components on a page (unlikely but cheap) don't share a group.
    private readonly string _uid = Guid.NewGuid().ToString("N")[..6];

    // Wind reference selector: "apparent" routes the hero, the
    // history chart, and the variability chips to AWA / AWS;
    // "true" routes them to TWD / TWS. The polar rose stays on AWA
    // regardless. Default seeded from IAppSettings on init so the
    // helm's last pick survives a page reload.
    private string heroMode = "apparent";

    // History view selector: "direction" plots the heading-style
    // value over time (shift detection); "speed" plots the speed
    // (settling / building trend). Orthogonal to apparent/true.
    // Per-session (no persistence) - toggling history view is a
    // quick diagnostic check, not a stable preference.
    private string historyView = "direction";

    private async Task SetHeroMode(string mode)
    {
        if (heroMode == mode) return;
        heroMode = mode;
        await Settings.SetWindHeroModeAsync(mode);
    }

    private void SetHistoryView(string view) => historyView = view;

    // Windplot: TWD + TWS over time. Samples come from the shared
    // NavigationAverages buffers so the chart, the AwsStats chips,
    // and the HUD smoothed readouts all read the same series.
    private const int WpWidth = 420;
    private const int WpHeight = 180;
    private const int WpPad = 40;
    private const int WpPlotW = WpWidth - WpPad - 10;
    private const int WpPlotH = WpHeight - WpPad - 20;

    // Page-level trailing window. Drives the rose's visible dots,
    // the history chart span, and the variability chips. Default 1 h
    // balances "what just happened on the last leg" (racer) and "is
    // tonight settling?" (cruiser).
    private int windowMinutes = 60;

    /// <summary>Largest window already fetched from server history.
    /// On <see cref="OnWindowChangedAsync"/> the page re-seeds only
    /// when the helm picks a window LARGER than what we've already
    /// covered; shrinking is a render-side decision (the buffer keeps
    /// the data so re-widening to that window doesn't re-fetch).</summary>
    private int _seededMinutes;

    // Unified window choices. Short end (1m/2m/10m) keeps the
    // variability chips usable for racers spotting a recent gust;
    // long end (8h/16h/24h) lets cruisers replay an entire passage.
    private static readonly (int Minutes, string Label)[] WindowChoices =
    [
        (1,    "1m"),
        (2,    "2m"),
        (10,   "10m"),
        (15,   "15m"),
        (30,   "30m"),
        (60,   "1h"),
        (120,  "2h"),
        (240,  "4h"),
        (480,  "8h"),
        (960,  "16h"),
        (1440, "24h"),
    ];

    // Shift rate has its own optimal window (~5 min: long enough to
    // smooth GPS / sensor jitter, short enough to flag a genuine veer
    // on typical mesoscale wind systems). Kept const, not user-tunable
    // - one less knob to fiddle with under sail, and the headline
    // semantics ("Veering/Backing over last 5 min") stay stable while
    // the surrounding chart axis re-scales with the unified window.
    private const int ShiftRateWindowMin = 5;

    // True when at least one live or historical wind reading exists
    // for ANY of the four channels. Used by the empty-state overlay
    // so a server that only publishes apparent data (no derived true
    // wind) still renders the rose and chips instead of showing the
    // "no environment.wind.*" message.
    private bool HasAnyWind =>
        currentWind is not null
        || currentTrueWind is not null
        || windPoints.Count > 0
        || Avg.Twd.Count > 0
        || Avg.Tws.Count > 0
        || Avg.Awa.Count > 0
        || Avg.Aws.Count > 0;

    /// <summary>
    /// Wind-speed variability over the unified window: gust (+ above
    /// mean), lull (- below mean), mean, and sigma (standard deviation,
    /// a single-number summary of how variable the wind is). Source
    /// follows <see cref="heroMode"/> - AWS for apparent, TWS for true -
    /// so the same chip strip is meaningful for racers reading the
    /// boat's actual sail-trim feel and cruisers reading the ambient
    /// wind field. All values in knots; gust/lull are non-negative
    /// magnitudes. Backed by the shared <see cref="INavigationAverages"/>
    /// rolling buffer (m/s); converted to knots here for display.
    /// </summary>
    private (double Gust, double Lull, double Mean, double Sigma)? WindStats
    {
        get
        {
            // warmupRatio: 0 here because chips happily surface
            // partial-window data on first connect - a 30s partial
            // fill of a 60-min window is still useful, and the chip
            // strip lives alongside the sample count so the helm can
            // read coverage themselves.
            var source = heroMode == "true" ? Avg.Tws : Avg.Aws;
            var stats = source.Stats(TimeSpan.FromMinutes(windowMinutes), warmupRatio: 0);
            if (stats is null) return null;
            var s = stats.Value;
            return (s.Gust * MsToKnots, s.Lull * MsToKnots, s.Mean * MsToKnots, s.Sigma * MsToKnots);
        }
    }

    /// <summary>Human-readable label for the active window (matches
    /// the segmented control's button text), used in chip tooltips so
    /// the helm doesn't have to re-derive "what window am I looking at"
    /// when hovering a Gust badge.</summary>
    private static string WindowLabel(int minutes)
    {
        foreach (var (mins, label) in WindowChoices)
            if (mins == minutes) return label;
        return $"{minutes}m";
    }

    /// <summary>
    /// Signed TWD slope in degrees per minute over the shift-rate
    /// window. Positive = veering (clockwise); negative = backing.
    /// Backed by the shared <see cref="INavigationAverages"/> rolling
    /// buffer; the unwrap + linear regression live in
    /// <see cref="OnaPlotter.Utilities.RollingDirectionSeries.ShiftRateDegPerMin"/>
    /// so the math is unit-tested and reusable from a future tactical
    /// HUD chip.
    /// </summary>
    private double? ShiftRate =>
        Avg.Twd.ShiftRateDegPerMin(TimeSpan.FromMinutes(ShiftRateWindowMin), warmupRatio: 0);

    /// <summary>Hero speed display in knots, formatted to 1 decimal,
    /// or "--" when the chosen wind reference (apparent / true) lacks
    /// a value. Driven by <see cref="heroMode"/>.</summary>
    private string HeroSpeedDisplay => heroMode == "true"
        ? (currentTrueWind?.TwsKn.ToString("F1") ?? "--")
        : (currentWind?.SpeedKn.ToString("F1") ?? "--");

    /// <summary>Hero angle display. In apparent mode shows AWA in
    /// 0..360 (0 = dead ahead). In true mode shows TWD (compass
    /// bearing the wind is coming FROM). Both rounded to whole
    /// degrees with the degree glyph; "--" when missing.</summary>
    private string HeroAngleDisplay
    {
        get
        {
            if (heroMode == "true")
            {
                if (currentTrueWind is null) return "--";
                double twdDeg = (currentTrueWind.Value.TwdRad * 180 / Math.PI + 360) % 360;
                return twdDeg.ToString("F0") + "°";
            }
            else
            {
                if (currentWind is null) return "--";
                double awaDeg = (currentWind.Value.Angle * 180 / Math.PI + 360) % 360;
                return awaDeg.ToString("F0") + "°";
            }
        }
    }

    /// <summary>Cancels the in-flight history seed when the page
    /// unmounts. Without this, a slow / wedged server would keep the
    /// fetch alive past navigation, then write into a disposed
    /// component's render context on completion.</summary>
    private CancellationTokenSource? _seedCts;

    protected override async Task OnInitializedAsync()
    {
        // Settings.InitializeAsync is idempotent; calling it here means
        // a deep-link straight to /wind doesn't race the MainLayout's
        // own init (the hero mode would otherwise flash "apparent" then
        // flip to the persisted value once settings landed).
        await Settings.InitializeAsync();
        heroMode = Settings.WindHeroMode;

        UpdateCurrentReadouts();
        SignalkClient.OnDataChanged += HandleSignalkData;
        await Polar.InitializeAsync();

        // Pre-warm NavigationAverages from server history for the
        // default window so the helm sees the recent shift trend +
        // variability chips immediately instead of after a 5-min stare.
        // Fire-and-forget: a transport failure here must not block the
        // page rendering; live deltas still flow. Resolution 5 s
        // preserves enough variance for gust/lull (30 s grain smooths
        // sigma artificially low).
        _ = ReseedAsync(windowMinutes);
    }

    /// <summary>Re-seed the shared wind buffers when the helm picks a
    /// larger window than what has already been fetched. Shrinking the
    /// window is a render-side decision (the buffer is bounded by
    /// <see cref="PolarRetention"/> so a 24 h → 1 m → 24 h shuffle
    /// only ever costs the initial 24 h fetch, not three).</summary>
    private async Task OnWindowChangedAsync(int newMinutes)
    {
        if (newMinutes == windowMinutes) return;
        windowMinutes = newMinutes;
        if (newMinutes > _seededMinutes)
        {
            await ReseedAsync(newMinutes);
        }
        // Re-render is implicit via the bound state change; no
        // StateHasChanged needed.
    }

    private async Task ReseedAsync(int windowMin)
    {
        // Cancel any in-flight seed before starting the next so two
        // concurrent fetches don't race to feed the same buffer.
        _seedCts?.Cancel();
        _seedCts?.Dispose();
        _seedCts = new CancellationTokenSource();
        var ct = _seedCts.Token;
        try
        {
            var seeded = await Avg.SeedWindAsync(
                TrackApi,
                window: TimeSpan.FromMinutes(windowMin),
                resolution: "5s",
                ct: ct);
            if (seeded is null || ct.IsCancellationRequested) return;

            _seededMinutes = Math.Max(_seededMinutes, windowMin);

            // Merge seeded historical samples into the polar list:
            // only add points OLDER than the oldest existing entry, so
            // a re-seed for a larger window extends the buffer
            // backwards without duplicating the overlap region.
            DateTime cutoff = windPoints.Count > 0 ? windPoints[0].Time : DateTime.MaxValue;
            var merged = new List<WindPoint>(seeded.Length + windPoints.Count);
            foreach (var pt in seeded)
            {
                if (pt.Timestamp >= cutoff) continue;
                if (TryBuildWindPoint(
                        pt.WindAngleApparent, pt.WindSpeedApparent, pt.Timestamp, out var wp))
                {
                    merged.Add(wp);
                }
            }
            merged.AddRange(windPoints);
            // Defensive sort: handles clock skew where a live sample
            // carries a ts older than the seed's most recent.
            merged.Sort(static (a, b) => a.Time.CompareTo(b.Time));
            windPoints = merged;
            EvictStaleSamples();

            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { }
    }

    /// <summary>SignalkClient.OnDataChanged handler. Refreshes the
    /// hero readouts on every delta, appends a polar dot if AWA + AWS
    /// are both fresh AND the throttle gate is open, then evicts
    /// samples older than the polar's retention window before re-render.</summary>
    private async void HandleSignalkData()
    {
        try
        {
            UpdateCurrentReadouts();
            TryAppendLiveSample();
            EvictStaleSamples();
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException) { }
    }

    /// <summary>Pulls the latest AWA / AWS + TWD / TWS values from the
    /// SignalK client into the hero card's display state. Cheap; runs
    /// on every delta regardless of throttle gate.</summary>
    private void UpdateCurrentReadouts()
    {
        var data = SignalkClient.Data;
        currentWind = data.WindAngleApparent is double awa && data.WindSpeedApparent is double aws
            ? (awa, aws * MsToKnots)
            : null;
        currentTrueWind = data.WindDirectionTrue is double twd && data.WindSpeedTrue is double tws
            ? (twd, tws * MsToKnots)
            : null;
    }

    /// <summary>Appends an AWA / AWS sample to the polar list if the
    /// 5 s throttle gate has elapsed since the last live add. Seeded
    /// samples bypass this gate (they already arrive at 5 s grain).</summary>
    private void TryAppendLiveSample()
    {
        var data = SignalkClient.Data;
        if (data.WindAngleApparent is not double angle
            || data.WindSpeedApparent is not double speedMs) return;
        var now = DateTime.UtcNow;
        if ((now - _lastLiveSampleUtc).TotalMilliseconds < LiveSampleIntervalMs) return;
        _lastLiveSampleUtc = now;
        if (TryBuildWindPoint(angle, speedMs, now, out var wp))
            windPoints.Add(wp);
    }

    /// <summary>Drops the leading prefix of <see cref="windPoints"/>
    /// older than <see cref="PolarRetention"/>. Cheap because the list
    /// is monotonic-ascending so a single walk finds the cut point.</summary>
    private void EvictStaleSamples()
    {
        if (windPoints.Count == 0) return;
        var cutoff = DateTime.UtcNow - PolarRetention;
        int firstKept = 0;
        while (firstKept < windPoints.Count && windPoints[firstKept].Time < cutoff)
            firstKept++;
        if (firstKept > 0)
            windPoints.RemoveRange(0, firstKept);
    }

    /// <summary>Projects an AWA radian / AWS m-per-s pair into the
    /// rose's SVG coordinate space. Centralised here so seed + live
    /// share the same projection (no drift between dot positions).</summary>
    private static bool TryBuildWindPoint(double? angleRad, double? speedMs, DateTime ts, out WindPoint wp)
    {
        if (angleRad is null || speedMs is null)
        {
            wp = default;
            return false;
        }
        double speedKn = speedMs.Value * MsToKnots;
        double frac = Math.Min(speedKn / MaxSpeedKn, 1.0);
        double r = frac * MaxRadius;
        double x = Cx + Math.Sin(angleRad.Value) * r;
        double y = Cy - Math.Cos(angleRad.Value) * r;
        wp = new WindPoint(ts, x, y, SpeedColor(frac));
        return true;
    }

    /// <summary>
    /// Picks a state-aware empty-state message for the rose overlay.
    /// Three diagnoses:
    ///   * <c>NoFeed</c>: SignalK websocket is not connected.
    ///   * <c>Stale</c>: connected but no message in &gt; 5 s
    ///     (SignalkClient.IsDataStale).
    ///   * <c>Cold</c>: connected and live but no wind sample yet (the
    ///     server isn't publishing environment.wind.* paths). The
    ///     helm needs to go check the sensor / SK paths config.
    /// Returns <c>null</c> Detail when there's nothing helpful to add.
    /// </summary>
    private (string Title, string Detail) ResolveEmptyState()
    {
        if (!SignalkClient.IsConnected)
            return ("No SignalK feed",
                    "Check the server URL or wait while the client reconnects.");
        if (SignalkClient.IsDataStale)
            return ("SignalK feed stale",
                    "Connected, but no message has arrived for several seconds.");
        return ("Awaiting wind sensor",
                "Connected. No environment.wind.* data yet; check the sensor or SK paths.");
    }

    /// <summary>
    /// Renders an SVG text element as raw markup, avoiding Razor's &lt;text&gt; directive conflict.
    /// Uses style="fill: ..." rather than the fill attribute so callers
    /// can pass CSS var() references (tokens) that SVG presentation-
    /// attribute parsing wouldn't resolve.
    /// </summary>
    private static MarkupString SvgText(double x, double y, string content, string fill, int fontSize,
        string? fontWeight = null, string anchor = "middle")
    {
        string weight = fontWeight is not null ? $" font-weight=\"{fontWeight}\"" : "";
        return new MarkupString(
            $"<text x=\"{x}\" y=\"{y}\" style=\"fill: {fill};\" font-size=\"{fontSize}\"{weight} " +
            $"text-anchor=\"{anchor}\" dominant-baseline=\"central\">{System.Net.WebUtility.HtmlEncode(content)}</text>");
    }

    /// <summary>
    /// Formats a "seconds ago" value as a short human-readable label
    /// for the TWD time axis. Adapts to the magnitude:
    ///   &lt; 60 s -> "-Ns"   (e.g. "-15s")
    ///   &lt; 10 min -> "-N.Nm" (e.g. "-3.5m")
    ///   otherwise -> "-Nm"   (e.g. "-25m")
    /// At the rightmost tick (now) returns "now" rather than "-0s".
    /// Replaces an integer-minute formatter that produced "-0m -0m
    /// -0m -0m" when the visible span was under a minute.
    /// </summary>
    private static string FormatAgo(double secsAgo)
    {
        if (secsAgo < 0.5) return "now";
        if (secsAgo < 60)  return $"-{(int)Math.Round(secsAgo)}s";
        double mins = secsAgo / 60.0;
        if (mins < 10) return $"-{mins.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)}m";
        return $"-{(int)Math.Round(mins)}m";
    }

    /// <summary>
    /// Maps a 0..1 fraction to a viridis colour (purple -> blue ->
    /// teal -> green -> yellow). Replaces the previous blue->yellow->red
    /// ramp, which (a) failed for ~8% of male sailors with deutera-
    /// nomaly in the yellow-green band, and (b) washed out under
    /// polarised sunglasses where yellow disappears. Viridis is
    /// perceptually uniform in lightness so it preserves ordering
    /// under both colour-deficient vision and bright sun.
    /// </summary>
    private static string SpeedColor(double frac)
    {
        frac = Math.Clamp(frac, 0, 1);
        // Five-stop viridis approximation - the canonical 256-step
        // matplotlib colormap is overkill for a polar-rose dot scatter,
        // and linear interpolation between stops at 0 / 0.25 / 0.5 /
        // 0.75 / 1.0 is indistinguishable to the eye from the full
        // table at the dot size we render.
        ReadOnlySpan<(double Stop, int R, int G, int B)> stops = stackalloc (double, int, int, int)[]
        {
            (0.00,  68,   1,  84),  // dark purple
            (0.25,  59,  82, 139),  // blue
            (0.50,  33, 145, 140),  // teal
            (0.75,  94, 201,  98),  // green
            (1.00, 253, 231,  37),  // yellow
        };
        int i = 0;
        while (i < stops.Length - 1 && frac > stops[i + 1].Stop) i++;
        var a = stops[i];
        var b = i + 1 < stops.Length ? stops[i + 1] : a;
        double span = b.Stop - a.Stop;
        double t = span > 1e-6 ? (frac - a.Stop) / span : 0;
        int r = (int)(a.R + t * (b.R - a.R));
        int g = (int)(a.G + t * (b.G - a.G));
        int bl = (int)(a.B + t * (b.B - a.B));
        return $"rgb({r},{g},{bl})";
    }

    private static string CompassLabel(int deg) => deg switch
    {
        0 => "N", 90 => "E", 180 => "S", 270 => "W",
        _ => deg.ToString()
    };

    public void Dispose()
    {
        SignalkClient.OnDataChanged -= HandleSignalkData;
        _seedCts?.Cancel();
        _seedCts?.Dispose();
    }

    private static string F(double v) => v.ToString("F1");

    /// <summary>
    /// Computes y-axis bounds + mean for the history chart. For
    /// "direction" view returns the unfolded TWD range padded by 5°
    /// either side; for "speed" view returns the TWS range padded by
    /// 1 kn either side. Floor on range width keeps a dead-flat trace
    /// from rendering as a hairline pinned to one grid stripe.
    /// </summary>
    private static (double Min, double Max, double Mean) ComputeYAxis(
        IReadOnlyList<OnaPlotter.Utilities.TimeSeriesSample> samples, string view)
    {
        double vMin = double.MaxValue, vMax = double.MinValue, sum = 0;
        foreach (var s in samples)
        {
            if (s.Value < vMin) vMin = s.Value;
            if (s.Value > vMax) vMax = s.Value;
            sum += s.Value;
        }
        double vMid = (vMin + vMax) / 2;
        // View-specific minimum range + padding so a flat trace
        // doesn't pin to a single grid stripe and the helm always
        // sees breathing room above / below the data.
        double minRange = view == "speed" ? 4 : 20;
        double pad = view == "speed" ? 1 : 5;
        double range = Math.Max(vMax - vMin, minRange);
        return (vMid - range / 2 - pad, vMid + range / 2 + pad, sum / samples.Count);
    }

    /// <summary>
    /// Generates the SVG polyline points string for the history chart.
    /// Each <see cref="OnaPlotter.Utilities.TimeSeriesSample"/> already
    /// carries the projected value (kn or deg) - the view-specific
    /// projection happens in <see cref="GetHistorySamples"/>.
    /// </summary>
    private string HistoryPolylinePoints(
        IReadOnlyList<OnaPlotter.Utilities.TimeSeriesSample> samples,
        double yMin, double yMax, DateTime oldest, double timeSpanSecs)
    {
        var sb = new System.Text.StringBuilder();
        double range = yMax - yMin;
        foreach (var s in samples)
        {
            double t = (s.Time - oldest).TotalSeconds;
            double x = WpPad + WpPlotW * (t / timeSpanSecs);
            double y = WpPad + WpPlotH * (1 - (s.Value - yMin) / range);
            if (sb.Length > 0) sb.Append(' ');
            sb.Append($"{x:F1},{y:F1}");
        }
        return sb.ToString();
    }

    /// <summary>Pulls the trailing-window samples from
    /// <see cref="INavigationAverages"/> and projects them into the
    /// active view's display unit (kn for speed, deg [0, 360) for
    /// direction). Source buffer follows the unified mode:
    ///   apparent + speed     -> AWS
    ///   apparent + direction -> AWA
    ///   true     + speed     -> TWS
    ///   true     + direction -> TWD
    /// Each render evaluates this once and the result is reused for
    /// axis bounds + polyline emission.</summary>
    private IReadOnlyList<OnaPlotter.Utilities.TimeSeriesSample> GetHistorySamples(string mode, string view)
    {
        var window = TimeSpan.FromMinutes(windowMinutes);
        if (view == "speed")
        {
            var source = mode == "true" ? Avg.Tws : Avg.Aws;
            var raw = source.SnapshotIn(window);
            var result = new List<OnaPlotter.Utilities.TimeSeriesSample>(raw.Count);
            foreach (var s in raw)
            {
                result.Add(new(s.Time, s.Value * MsToKnots));
            }
            return result;
        }
        // Direction view: rad -> deg, normalised to [0, 360). AWA in
        // apparent mode is bow-relative ±π in the buffer; the same
        // normalisation maps that to 0..360 (port wind shows as 270..359).
        var dirSource = mode == "true" ? Avg.Twd : Avg.Awa;
        var rawDir = dirSource.SnapshotIn(window);
        var dirResult = new List<OnaPlotter.Utilities.TimeSeriesSample>(rawDir.Count);
        foreach (var s in rawDir)
        {
            double deg = s.Value * 180.0 / Math.PI;
            if (deg < 0) deg += 360;
            dirResult.Add(new(s.Time, deg));
        }
        return dirResult;
    }

    /// <summary>One projected polar dot. <see cref="Time"/> is the
    /// sample's UTC timestamp - drives eviction past
    /// <see cref="PolarRetention"/>.</summary>
    private readonly record struct WindPoint(DateTime Time, double X, double Y, string Color);
}
