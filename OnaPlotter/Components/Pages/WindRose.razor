@* Polar plot of apparent wind angle vs speed from track history. *@

@page "/wind"
@using OnaPlotter.Services
@using OnaPlotter.Models
@implements IDisposable
@inject SignalkClient SignalkClient
@inject TrackBuffer TrackBuffer
@inject IPolarService Polar

<PageTitle>Wind</PageTitle>

@* Back-to-chart chip removed -- the sidebar + topbar already surface
   navigation back to the map, and the chip duplicated that affordance
   without earning its screen real estate. *@

@*
   Layout: a two-column grid on screens >= 960px (covers iPad landscape
   and any normal helm display), single column below. Left column owns
   the polar rose; right column owns the live readouts and the TWD
   history strip. Stacking the windplot below the rose -- the previous
   layout -- wasted half the screen on big displays and pushed the
   "current wind" reading below the fold.

   Typography is consolidated to one scale (page title, section header,
   meta, hero values) instead of the prior h2 / h4 / h6 / <p> mix that
   read as "different widget per row".

   Surface fills on the SVGs are dropped: on dark theme the
   (--sk-surface) tint barely registers and just adds visual noise; on
   light theme each section sits in a card via .wind-section so the
   framing is delivered by the wrapper, not the SVG itself.
*@
<div class="app-page wind-page">
    <header class="app-page-header">
        <h1>Wind</h1>
        <p class="app-page-subtitle">Apparent wind angle vs. speed; color indicates wind speed.</p>
    </header>

    <div class="wind-grid">
        @* === Left column: the polar rose + colour legend === *@
        <section class="wind-section wind-rose-section" aria-label="Wind rose">
            <div class="wind-rose-canvas">
                @if (!HasAnyWind)
                {
                    @* Empty state on top of the compass grid so the chrome is
                       visible but the user sees "no sensor data yet". *@
                    <div class="instrument-empty-state" role="status">
                        <strong>Waiting for wind data</strong>
                        WindRose needs <em>environment.wind.angleApparent</em> +
                        <em>speedApparent</em>. Connect a wind sensor or check the
                        SignalK server.
                    </div>
                }
                <svg class="wind-rose-svg" viewBox="0 0 @Size @Size">
        @* Background circles *@
        @for (int i = 1; i <= RingCount; i++)
        {
            double r = i * ringSpacing;
            <circle cx="@Cx" cy="@Cy" r="@r" fill="none" stroke="#444" stroke-width="0.5" />
        }

        @* Compass direction lines and labels *@
        @foreach (var deg in compassDegrees)
        {
            double rad = deg * Math.PI / 180.0;
            double x1 = Cx + Math.Sin(rad) * 20;
            double y1 = Cy - Math.Cos(rad) * 20;
            double x2 = Cx + Math.Sin(rad) * MaxRadius;
            double y2 = Cy - Math.Cos(rad) * MaxRadius;
            double lx = Cx + Math.Sin(rad) * (MaxRadius + 14);
            double ly = Cy - Math.Cos(rad) * (MaxRadius + 14);
            <line x1="@x1" y1="@y1" x2="@x2" y2="@y2" stroke="#555" stroke-width="0.5" />
            @SvgText(lx, ly, CompassLabel(deg), "#aaa", 11)
        }

        @* Speed ring labels (knots) *@
        @for (int i = 1; i <= RingCount; i++)
        {
            double r = i * ringSpacing;
            double kn = i * speedPerRing;
            @SvgText(Cx + 2, Cy - r - 2, $"{kn:F0} kn", "#666", 10, anchor: "start")
        }

        @* Historical wind data points *@
        @foreach (var pt in windPoints)
        {
            <circle cx="@pt.X" cy="@pt.Y" r="2.5" fill="@pt.Color" opacity="0.6" />
        }

        @* Polar curve overlay (when polar loaded and TWS available) *@
        @if (Polar.HasPolar && SignalkClient.Data.WindSpeedTrue is not null)
        {
            double twsKn = SignalkClient.Data.WindSpeedTrue.Value * MsToKnots;
            var curve = Polar.GetPolarCurve(twsKn);
            if (curve.Length > 0)
            {
                var sb = new System.Text.StringBuilder();
                foreach (var (twa, spd) in curve)
                {
                    double angleRad = twa * Math.PI / 180.0;
                    double frac = Math.Min(spd / MaxSpeedKn, 1.0);
                    double r = frac * MaxRadius;
                    double px = Cx + Math.Sin(angleRad) * r;
                    double py = Cy - Math.Cos(angleRad) * r;
                    if (sb.Length > 0) sb.Append(' ');
                    sb.Append($"{px:F1},{py:F1}");
                }
                // Mirror for port side (negative angles).
                for (int i = curve.Length - 1; i >= 0; i--)
                {
                    double angleRad = -curve[i].Twa * Math.PI / 180.0;
                    double frac = Math.Min(curve[i].Speed / MaxSpeedKn, 1.0);
                    double r = frac * MaxRadius;
                    double px = Cx + Math.Sin(angleRad) * r;
                    double py = Cy - Math.Cos(angleRad) * r;
                    sb.Append($" {px:F1},{py:F1}");
                }
                <polyline fill="none" stroke="#22d3ee" stroke-width="2" opacity="0.7"
                          stroke-dasharray="4,3" points="@sb.ToString()" />
            }
        }

        @* Current wind arrow. currentColor inherits from the parent
           text colour (--sk-text, red-shifted in night mode). *@
        @if (currentWind is not null)
        {
            double rad = currentWind.Value.Angle;
            double speedFrac = Math.Min(currentWind.Value.SpeedKn / MaxSpeedKn, 1.0);
            double len = speedFrac * MaxRadius;
            double tipX = Cx + Math.Sin(rad) * len;
            double tipY = Cy - Math.Cos(rad) * len;
            <line x1="@Cx" y1="@Cy" x2="@tipX" y2="@tipY"
                  style="stroke: currentColor;" stroke-width="2.5" stroke-linecap="round" />
            <circle cx="@tipX" cy="@tipY" r="4" style="fill: currentColor;" />
        }
                </svg>

                @* Legend. Gradient id is per-component so if two WindRose
                   instances co-exist on a page, their SVG defs don't collide --
                   a stale cached gradient would otherwise paint the second
                   instance's rect grey. *@
                <div class="wind-legend">
                    <span class="wind-legend-label">Speed (kn)</span>
                    <svg width="30" height="180" aria-hidden="true">
                        <defs>
                            <linearGradient id="@GradientId" x1="0" y1="1" x2="0" y2="0">
                                <stop offset="0%" stop-color="#2196F3" />
                                <stop offset="50%" stop-color="#FFEB3B" />
                                <stop offset="100%" stop-color="#F44336" />
                            </linearGradient>
                        </defs>
                        <rect x="0" y="0" width="16" height="180" fill="url(#@GradientId)" rx="2" />
                        @SvgText(20, 12, $"{MaxSpeedKn:F0}", "currentColor", 10, anchor: "start")
                        @SvgText(20, 95, $"{MaxSpeedKn / 2:F0}", "currentColor", 10, anchor: "start")
                        @SvgText(20, 178, "0", "currentColor", 10, anchor: "start")
                    </svg>
                </div>
            </div>
        </section>

        @* === Right column: live readouts + TWD history === *@
        <aside class="wind-aside">
            @* Hero card. The previous "Current: 12.3 kn at 45° apparent"
               sentence sat below the rose, well below the fold on tall
               displays. The hero pulls the live reading up to where the
               eye lands first. Speed dominates (it's what determines
               sail trim); angle is secondary. Empty dashes ("--")
               keep the layout stable when the sensor isn't reporting. *@
            <div class="wind-hero">
                <div class="wind-hero-primary">
                    <span class="wind-hero-value">@(currentWind?.SpeedKn.ToString("F1") ?? "--")</span>
                    <span class="wind-hero-unit">kn</span>
                </div>
                <div class="wind-hero-secondary">
                    <span class="wind-hero-angle">
                        @(currentWind is null ? "--" : ((currentWind.Value.Angle * 180 / Math.PI + 360) % 360).ToString("F0") + "°")
                    </span>
                    <span class="wind-hero-label">apparent</span>
                </div>
            </div>

            @* === Tactical badges row ===
               Gust / lull over the last 2 min and shift-rate over the last 5 min.
               Each renders nothing when its underlying sample count is
               insufficient, so "this badge is silent" stays meaningful. *@
            @if (GustLull is not null || ShiftRate is not null)
            {
                <div class="wind-badges">
                    @if (GustLull is (double gust, double lull, double mean))
                    {
                        <span class="instrument-badge @(gust > 3 ? "instrument-badge-warn" : "")"
                              title="Peak AWS minus mean over the last @GustLullWindowMin min">
                            <span class="instrument-badge-label">Gust</span>
                            +@gust.ToString("F1") kn
                        </span>
                        <span class="instrument-badge"
                              title="Lowest AWS minus mean over the last @GustLullWindowMin min">
                            <span class="instrument-badge-label">Lull</span>
                            -@lull.ToString("F1") kn
                        </span>
                        <span class="instrument-badge"
                              title="Mean AWS over the last @GustLullWindowMin min">
                            <span class="instrument-badge-label">Mean</span>
                            @mean.ToString("F1") kn
                        </span>
                    }
                    @if (ShiftRate is double rate)
                    {
                        string cls = Math.Abs(rate) >= 3 ? "instrument-badge-warn"
                                   : Math.Abs(rate) >= 1 ? "instrument-badge"
                                   : "instrument-badge-good";
                        string sign = rate >= 0 ? "+" : "";
                        <span class="instrument-badge @cls"
                              title="TWD slope over the last @ShiftRateWindowMin min -- positive = veering, negative = backing">
                            <span class="instrument-badge-label">Shift</span>
                            @sign@rate.ToString("F1") &deg;/min
                        </span>
                    }
                </div>
            }

            @* === TWD history strip === *@
            @{
                // Sliding window view of the TWD history. The buffer itself always
                // holds MaxWindowMinutes worth of samples; what the user sees is a
                // trailing slice selected by the segmented control. Short windows
                // (15m) are great for spotting a pending shift mid-race; long
                // windows (3h) are useful for a sunset wind-clocking pattern on a
                // cruise.
                var cutoff = DateTime.UtcNow.AddMinutes(-windowMinutes);
                var visible = twdHistory.Where(s => s.Time >= cutoff).ToList();
            }

            @if (twdHistory.Count > 1)
            {
                <section class="wind-section wind-history-section" aria-label="Wind direction history">
                    <header class="wind-section-header">
                        <h2 class="wind-section-title">TWD history</h2>
                        <TimeWindowSelector @bind-Value="windowMinutes"
                                            Choices="WindowChoices"
                                            AriaLabel="TWD history window" />
                    </header>
                    <p class="wind-section-meta">
                        Last @windowMinutes min &middot; @visible.Count samples &middot; green = mean
                    </p>
                    @if (visible.Count > 1)
                    {
                        <svg class="wind-history-svg" viewBox="0 0 @WpWidth @WpHeight">
        @* Y-axis labels (degrees) *@
        @{
            double twdMin = visible.Min(t => t.Deg);
            double twdMax = visible.Max(t => t.Deg);
            double twdRange = Math.Max(twdMax - twdMin, 20); // min 20 degree range
            double twdMid = (twdMin + twdMax) / 2;
            twdMin = twdMid - twdRange / 2 - 5;
            twdMax = twdMid + twdRange / 2 + 5;
            double meanTwd = visible.Average(t => t.Deg);
            DateTime oldest = visible[0].Time;
            DateTime newest = visible[^1].Time;
            double timeSpan = Math.Max((newest - oldest).TotalSeconds, 1);
        }

        @* Grid lines *@
        @for (int i = 0; i <= 4; i++)
        {
            double y = WpPad + (WpPlotH * i / 4.0);
            double deg = twdMax - (twdMax - twdMin) * i / 4.0;
            <line x1="@WpPad" y1="@F(y)" x2="@(WpWidth - 10)" y2="@F(y)" stroke="#333" stroke-width="0.5" />
            @SvgText(WpPad - 4, y, $"{deg:F0}", "#666", 10, anchor: "end")
        }

        @* Mean TWD line *@
        @{
            double meanY = WpPad + WpPlotH * (1 - (meanTwd - twdMin) / (twdMax - twdMin));
        }
        <line x1="@WpPad" y1="@F(meanY)" x2="@(WpWidth - 10)" y2="@F(meanY)"
              style="stroke: var(--sev-ok);" stroke-width="1.5" stroke-dasharray="6,4" opacity="0.7" />

        @* TWD data line -- accent blue token so night mode red-shifts it. *@
        <polyline fill="none" style="stroke: var(--sk-accent);" stroke-width="1.5" opacity="0.9"
                  points="@TwdPolylinePoints(visible, twdMin, twdMax, oldest, timeSpan)" />

        @* Time axis labels *@
        @for (int i = 0; i <= 3; i++)
        {
            double x = WpPad + (WpPlotW * i / 3.0);
            double secs = timeSpan * i / 3.0;
            string label = $"-{(int)((timeSpan - secs) / 60)}m";
            @SvgText(x, WpHeight - 4, label, "#666", 10)
        }
                        </svg>
                    }
                </section>
            }
        </aside>
    </div>
</div>

@code {
    // Per-instance gradient id so the <linearGradient> in the legend
    // defs doesn't collide if two WindRose components render in the
    // same DOM (unlikely today but cheap defence).
    private readonly string GradientId = "speedGrad-" + Guid.NewGuid().ToString("N")[..8];

    private const int Size = 420;
    private const double Cx = Size / 2.0;
    private const double Cy = Size / 2.0;
    private const double MaxRadius = 170;
    private const int RingCount = 5;
    private const double MaxSpeedKn = 30;
    private const double MsToKnots = Format.MsToKnots;

    private readonly double ringSpacing = MaxRadius / RingCount;
    private readonly double speedPerRing = MaxSpeedKn / RingCount;
    private static readonly int[] compassDegrees = [0, 30, 60, 90, 120, 150, 180, 210, 240, 270, 300, 330];

    private List<WindPoint> windPoints = [];
    private (double Angle, double SpeedKn)? currentWind;
    private int lastProcessedCount;

    // Windplot: TWD over time for shift detection. The buffer is sized
    // for the longest window offered; the user picks a trailing slice
    // of it via WindowChoices below. Hard cap MaxTwdSamples keeps
    // memory bounded even if we're fed a 10Hz TWD stream.
    private const int MaxWindowMinutes = 180;
    private const int MaxTwdSamples = 10800;   // 3h at 1 sample/sec; headroom for faster rates
    private const int WpWidth = 420;
    private const int WpHeight = 180;
    private const int WpPad = 40;
    private const int WpPlotW = WpWidth - WpPad - 10;
    private const int WpPlotH = WpHeight - WpPad - 20;
    private List<TwdSample> twdHistory = [];

    // User-selectable trailing window. Defaults to 30 min (unchanged
    // from the previous fixed behaviour). 15 min for racers spotting
    // a shift mid-leg; 1 h / 3 h for cruisers watching a sunset clock.
    private int windowMinutes = 30;

    private static readonly (int minutes, string label)[] WindowChoices =
    [
        (15,  "15m"),
        (30,  "30m"),
        (60,  "1h"),
        (180, "3h"),
    ];

    // Badge windows. Gust / lull wants a short window (a minute or two)
    // so a recent gust still reads as "recent". Shift-rate wants long
    // enough to smooth jitter, short enough to flag a genuine veer
    // (~5 min on typical wind systems).
    private const int GustLullWindowMin = 2;
    private const int ShiftRateWindowMin = 5;

    // True when at least one live or historical wind reading exists.
    // Used by the empty-state overlay.
    private bool HasAnyWind =>
        currentWind is not null
        || windPoints.Count > 0
        || twdHistory.Count > 0;

    /// <summary>
    /// Gust + lull relative to the short-window mean. A "gust" of +4
    /// means peak AWS was 4 kn above the window mean; "lull" likewise
    /// on the low side. Both in knots; never negative.
    /// </summary>
    private (double Gust, double Lull, double Mean)? GustLull
    {
        get
        {
            // Pull AWS samples from the track buffer's window rather
            // than keeping a separate ring; TrackBuffer.GetSnapshot
            // already carries WindSpeedApparent.
            var cutoff = DateTime.UtcNow.AddMinutes(-GustLullWindowMin);
            var samples = TrackBuffer.GetSnapshot()
                .Where(p => p.Timestamp >= cutoff && p.WindSpeedApparent is not null)
                .Select(p => p.WindSpeedApparent!.Value * MsToKnots)
                .ToList();
            if (samples.Count < 5) return null;
            double mean = samples.Average();
            double gust = Math.Max(0, samples.Max() - mean);
            double lull = Math.Max(0, mean - samples.Min());
            return (gust, lull, mean);
        }
    }

    /// <summary>
    /// Signed TWD slope in degrees per minute over the shift-rate
    /// window. Positive = veering (clockwise); negative = backing.
    /// Simple linear regression over the available samples; null when
    /// fewer than a handful of samples exist. Handles 0/360 wraparound
    /// by unfolding against the first sample.
    /// </summary>
    private double? ShiftRate
    {
        get
        {
            var cutoff = DateTime.UtcNow.AddMinutes(-ShiftRateWindowMin);
            var window = twdHistory.Where(s => s.Time >= cutoff).ToList();
            if (window.Count < 5) return null;

            // Unfold around the first sample so 359 -> 1 doesn't read
            // as a -358 degree jump. Each subsequent sample shifts by
            // at most +/- 180; anything bigger must have wrapped.
            double prev = window[0].Deg;
            double baseline = prev;
            var unfolded = new double[window.Count];
            double running = prev;
            unfolded[0] = running - baseline;
            for (int i = 1; i < window.Count; i++)
            {
                double d = window[i].Deg;
                double delta = d - prev;
                if (delta > 180) delta -= 360;
                else if (delta < -180) delta += 360;
                running += delta;
                unfolded[i] = running - baseline;
                prev = d;
            }

            // Linear regression slope: Σ(x-x̄)(y-ȳ) / Σ(x-x̄)²
            double tMean = 0, yMean = 0;
            var ts = new double[window.Count];
            for (int i = 0; i < window.Count; i++)
            {
                ts[i] = (window[i].Time - window[0].Time).TotalSeconds;
                tMean += ts[i];
                yMean += unfolded[i];
            }
            tMean /= window.Count;
            yMean /= window.Count;
            double num = 0, den = 0;
            for (int i = 0; i < window.Count; i++)
            {
                double dt = ts[i] - tMean;
                num += dt * (unfolded[i] - yMean);
                den += dt * dt;
            }
            if (den < 1) return null;
            double degPerSec = num / den;
            return degPerSec * 60;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        RefreshData(fullRebuild: true);
        TrackBuffer.OnTrackUpdated += HandleTrackUpdated;
        await Polar.InitializeAsync();
    }

    private async void HandleTrackUpdated()
    {
        try
        {
            RefreshData(fullRebuild: false);
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException) { }
    }

    private void RefreshData(bool fullRebuild)
    {
        var points = TrackBuffer.GetSnapshot();

        if (fullRebuild || points.Length < lastProcessedCount)
        {
            // Full rebuild on first load or if buffer wrapped.
            var result = new List<WindPoint>(points.Length);
            foreach (var pt in points)
                AddWindPoint(result, pt);
            windPoints = result;
        }
        else if (points.Length > lastProcessedCount)
        {
            // Incremental: only process new points.
            for (int i = lastProcessedCount; i < points.Length; i++)
                AddWindPoint(windPoints, points[i]);
        }

        lastProcessedCount = points.Length;

        var data = SignalkClient.Data;
        if (data.WindAngleApparent is not null && data.WindSpeedApparent is not null)
            currentWind = (data.WindAngleApparent.Value, data.WindSpeedApparent.Value * MsToKnots);
        else
            currentWind = null;

        // Update TWD history for windplot.
        if (data.WindDirectionTrue is not null)
        {
            double twdDeg = data.WindDirectionTrue.Value * 180.0 / Math.PI;
            if (twdDeg < 0) twdDeg += 360;
            twdHistory.Add(new TwdSample(DateTime.UtcNow, twdDeg));
            // Prune: retain up to the maximum supported window; the
            // visible slice picks its own cutoff.
            var cutoff = DateTime.UtcNow.AddMinutes(-MaxWindowMinutes);
            twdHistory.RemoveAll(s => s.Time < cutoff);
            if (twdHistory.Count > MaxTwdSamples)
                twdHistory.RemoveRange(0, twdHistory.Count - MaxTwdSamples);
        }
    }

    private void AddWindPoint(List<WindPoint> list, TrackPoint pt)
    {
        if (pt.WindAngleApparent is null || pt.WindSpeedApparent is null)
            return;

        double angle = pt.WindAngleApparent.Value;
        double speedKn = pt.WindSpeedApparent.Value * MsToKnots;
        double frac = Math.Min(speedKn / MaxSpeedKn, 1.0);
        double r = frac * MaxRadius;

        double x = Cx + Math.Sin(angle) * r;
        double y = Cy - Math.Cos(angle) * r;
        list.Add(new WindPoint(x, y, SpeedColor(frac)));
    }

    /// <summary>
    /// Renders an SVG text element as raw markup, avoiding Razor's &lt;text&gt; directive conflict.
    /// Uses style="fill: ..." rather than the fill attribute so callers
    /// can pass CSS var() references (tokens) that SVG presentation-
    /// attribute parsing wouldn't resolve.
    /// </summary>
    private static MarkupString SvgText(double x, double y, string content, string fill, int fontSize,
        string? fontWeight = null, string anchor = "middle")
    {
        string weight = fontWeight is not null ? $" font-weight=\"{fontWeight}\"" : "";
        return new MarkupString(
            $"<text x=\"{x}\" y=\"{y}\" style=\"fill: {fill};\" font-size=\"{fontSize}\"{weight} " +
            $"text-anchor=\"{anchor}\" dominant-baseline=\"central\">{System.Net.WebUtility.HtmlEncode(content)}</text>");
    }

    /// <summary>
    /// Interpolates blue -> yellow -> red based on 0..1 fraction.
    /// </summary>
    private static string SpeedColor(double frac)
    {
        frac = Math.Clamp(frac, 0, 1);
        int r, g, b;
        if (frac < 0.5)
        {
            double t = frac * 2;
            r = (int)(0x21 + t * (0xFF - 0x21));
            g = (int)(0x96 + t * (0xEB - 0x96));
            b = (int)(0xF3 + t * (0x3B - 0xF3));
        }
        else
        {
            double t = (frac - 0.5) * 2;
            r = (int)(0xFF + t * (0xF4 - 0xFF));
            g = (int)(0xEB + t * (0x43 - 0xEB));
            b = (int)(0x3B + t * (0x36 - 0x3B));
        }
        return $"rgb({r},{g},{b})";
    }

    private static string CompassLabel(int deg) => deg switch
    {
        0 => "N", 90 => "E", 180 => "S", 270 => "W",
        _ => deg.ToString()
    };

    public void Dispose()
    {
        TrackBuffer.OnTrackUpdated -= HandleTrackUpdated;
    }

    private static string F(double v) => v.ToString("F1");

    private string TwdPolylinePoints(IReadOnlyList<TwdSample> samples,
        double twdMin, double twdMax, DateTime oldest, double timeSpanSecs)
    {
        var sb = new System.Text.StringBuilder();
        foreach (var s in samples)
        {
            double t = (s.Time - oldest).TotalSeconds;
            double x = WpPad + WpPlotW * (t / timeSpanSecs);
            double y = WpPad + WpPlotH * (1 - (s.Deg - twdMin) / (twdMax - twdMin));
            if (sb.Length > 0) sb.Append(' ');
            sb.Append($"{x:F1},{y:F1}");
        }
        return sb.ToString();
    }

    private readonly record struct WindPoint(double X, double Y, string Color);
    private readonly record struct TwdSample(DateTime Time, double Deg);
}
