@* History playback: replay past track data on the map. *@

@page "/history"
@using OnaPlotter.Services
@using OnaPlotter.Models
@using OnaPlotter.Utilities
@using Microsoft.JSInterop
@using System.Globalization
@implements IAsyncDisposable
@using OnaPlotter.Services.Api
@inject ITrackApi TrackApi
@inject SignalkClient SignalkClient
@inject IJSRuntime JS

<PageTitle>History</PageTitle>

<div class="map-container">
    <div id="historyMapDiv" style="width:100%; height:100%;"></div>

    @* Playback controls *@
    <div class="history-controls">
        <div class="d-flex align-items-center gap-2 flex-wrap">
            @* Mode toggle: "Preset" exposes the relative-window
               dropdown ("Last 24 hours" etc.) -- fast for "what
               happened today?". "Custom" exposes from/to inputs --
               required for reviewing a specific passage / day.
               Default is Preset because that's the helm's normal
               glance use; Custom is the deliberate analysis use. *@
            <select class="form-select form-select-sm" style="width:auto;"
                    title="Window mode"
                    @onchange="OnModeChanged">
                <option value="preset" selected="@(rangeMode == "preset")">Preset</option>
                <option value="custom" selected="@(rangeMode == "custom")">Custom</option>
            </select>
            @if (rangeMode == "preset")
            {
                <select class="form-select form-select-sm" style="width:auto;"
                        @onchange="OnTimespanChanged">
                    <option value="1h" selected="@(selectedTimespan == "1h")">Last 1 hour</option>
                    <option value="6h" selected="@(selectedTimespan == "6h")">Last 6 hours</option>
                    <option value="1d" selected="@(selectedTimespan == "1d")">Last 24 hours</option>
                    <option value="3d" selected="@(selectedTimespan == "3d")">Last 3 days</option>
                    <option value="7d" selected="@(selectedTimespan == "7d")">Last 7 days</option>
                </select>
            }
            else
            {
                @* Custom date range. datetime-local takes wall-clock
                   input from the helm's tablet timezone; we convert
                   to UTC at fetch time so the API call is unambiguous
                   regardless of where the helm is. *@
                <input type="datetime-local" class="form-control form-control-sm"
                       style="width:auto;"
                       title="Start of window (local time)"
                       value="@FormatLocalForInput(customFromLocal)"
                       @onchange="OnCustomFromChanged" />
                <span style="font-size:0.85rem; color:var(--sk-text-muted);">to</span>
                <input type="datetime-local" class="form-control form-control-sm"
                       style="width:auto;"
                       title="End of window (local time)"
                       value="@FormatLocalForInput(customToLocal)"
                       @onchange="OnCustomToChanged" />
            }
            <button class="map-btn" @onclick="LoadTrack">Load</button>
            <button class="map-btn" @onclick="GoToBoat" title="Center on current boat position">
                @* .map-btn is inline-flex so the icon + label line up
                   without an inner wrapper; same visual as "Load". *@
                @((MarkupString)Icons.Follow) Boat
            </button>
        </div>

        @if (points is not null && points.Length > 0)
        {
            <div class="mt-2">
                <input type="range" class="form-range" min="0" max="@(points.Length - 1)"
                       value="@playbackIndex" @oninput="OnScrub" style="width:100%;" />
                <div class="d-flex justify-content-between" style="font-size:0.75rem; color:var(--sk-text-muted);">
                    <span>@FormatTime(0)</span>
                    <span style="font-size:0.9rem; color:var(--sk-text);">@CurrentTimeLabel</span>
                    <span>@FormatTime(points.Length - 1)</span>
                </div>
            </div>
            @* Step buttons disable at their respective boundary so the
               user isn't left wondering whether &lt;&lt; was registered
               but silently no-op'd at the start of the track. *@
            <div class="d-flex gap-2 mt-1 flex-wrap align-items-center">
                <button class="map-btn" @onclick="PlayPause">@(playing ? "Pause" : "Play")</button>
                <button class="map-btn" @onclick="() => StepBy(-10)"
                        disabled="@(playbackIndex == 0)">&lt;&lt;</button>
                <button class="map-btn" @onclick="() => StepBy(-1)"
                        disabled="@(playbackIndex == 0)">&lt;</button>
                <button class="map-btn" @onclick="() => StepBy(1)"
                        disabled="@(playbackIndex >= points.Length - 1)">&gt;</button>
                <button class="map-btn" @onclick="() => StepBy(10)"
                        disabled="@(playbackIndex >= points.Length - 1)">&gt;&gt;</button>
                @* Playback speed. User-selectable so a slow tablet can
                   pick 1x without being forced to watch 5x-fast jitter;
                   a desktop user reviewing a multi-day passage can pick
                   10x to scrub quickly. Timer reinitialises on change. *@
                <label class="d-inline-flex align-items-center gap-1 ms-2"
                       style="font-size:0.75rem; color:var(--sk-text-muted);">
                    Speed
                    <select class="form-select form-select-sm" style="width:auto;"
                            aria-label="Playback speed"
                            @onchange="OnSpeedChanged">
                        <option value="400">0.5x</option>
                        <option value="200" selected>1x</option>
                        <option value="100">2x</option>
                        <option value="40">5x</option>
                        <option value="20">10x</option>
                    </select>
                </label>
            </div>
        }
        else if (loadAttempted)
        {
            <EmptyState Compact="true"
                        Title="No track data for this timespan"
                        Message="Tracks come from a SignalK History provider (signalk-parquet, signalk-to-influxdb2). If you expected data, check the plugin is active on the server." />
        }
        else
        {
            <EmptyState Compact="true"
                        Title="Pick a timespan and tap Load" />
        }
    </div>
</div>

@code {
    private IJSObjectReference? module;
    // Rich points (lat/lon + timestamp + sog/cog/wind) drive both the
    // playback scrub (marker moves through this list, indices stable)
    // and the segmenter (stationary vs moving classification + per-
    // segment stats). The playback marker only needs (lat, lon) so we
    // expose a side array to keep MoveMarker's JS payload tiny.
    private TrackPoint[]? points;
    private TrackSegment[]? segments;
    private int playbackIndex;
    private string selectedTimespan = "1d";
    private bool playing;
    private bool loadAttempted;
    private System.Threading.Timer? playTimer;
    // Custom date-range state. "preset" mode uses selectedTimespan
    // (the dropdown); "custom" uses customFromLocal + customToLocal.
    // The local fields hold WALL-CLOCK times in the helm's tablet
    // timezone (matches what the datetime-local input emits); LoadTrack
    // converts to UTC before passing to TrackApi.
    private string rangeMode = "preset";
    private DateTime customFromLocal = DateTime.Now.AddHours(-6);
    private DateTime customToLocal = DateTime.Now;

    /// <summary>Surface the current scrub timestamp instead of the
    /// previous "Point N / total" placeholder. Helms reading the
    /// playback line want to know when something happened, not which
    /// sample number it was. Local time because the helm is reading
    /// the time on the helm, not in UTC.</summary>
    private string CurrentTimeLabel =>
        points is not null && playbackIndex < points.Length
            ? points[playbackIndex].Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
            : "--";

    /// <summary>End-of-range label for the playback slider. Boundary
    /// timestamps anchor the helm visually so the slider's halves
    /// read as "earlier" / "later" instead of just 0%/100%.</summary>
    private string FormatTime(int index)
    {
        if (points is null || index >= points.Length) return "--";
        return points[index].Timestamp.ToLocalTime().ToString("HH:mm");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/leafletInterop.js");

            // Initialize map. Default center on the boat's current position if available,
            // otherwise a generic fallback.
            double lat = SignalkClient.Data.Latitude ?? 47.4;
            double lon = SignalkClient.Data.Longitude ?? 8.5;
            int zoom = SignalkClient.Data.Latitude is not null ? 13 : 8;

            await JS.InvokeVoidAsync("eval", $@"
                (function() {{
                    if (window._historyMap) window._historyMap.remove();
                    var m = L.map('historyMapDiv', {{ zoomControl: true }}).setView([{lat}, {lon}], {zoom});
                    // OpenSeaMap as the primary visual reference (matches user preference).
                    L.tileLayer('https://tile.openstreetmap.org/{{z}}/{{x}}/{{y}}.png',
                        {{ maxZoom: 19, attribution: '&copy; OSM', referrerPolicy: 'strict-origin-when-cross-origin' }}).addTo(m);
                    L.tileLayer('https://tiles.openseamap.org/seamark/{{z}}/{{x}}/{{y}}.png',
                        {{ maxZoom: 19, opacity: 0.8, referrerPolicy: 'strict-origin-when-cross-origin' }}).addTo(m);
                    window._historyMap = m;
                    window._historyMarker = null;
                    window._historyTrack = null;
                    window._historyBoatMarker = null;
                }})()
            ");

            // Draw boat position if available.
            if (SignalkClient.Data.Latitude is not null && SignalkClient.Data.Longitude is not null)
            {
                await DrawBoatMarker();
            }

            // Auto-load the default timespan.
            await LoadTrack();
        }
        catch (JSDisconnectedException) { /* page teardown race */ }
        catch (JSException ex)
        {
            // Silent swallow would hide a Leaflet / CDN failure; log so
            // the browser console tells a developer what broke. The
            // user sees an empty map rather than the Blazor error UI.
            Console.Error.WriteLine($"[history] init: {ex.Message}");
        }
    }

    private async Task DrawBoatMarker()
    {
        if (SignalkClient.Data.Latitude is null || SignalkClient.Data.Longitude is null) return;
        double lat = SignalkClient.Data.Latitude.Value;
        double lon = SignalkClient.Data.Longitude.Value;
        await JS.InvokeVoidAsync("eval", $@"
            (function() {{
                var m = window._historyMap;
                if (!m) return;
                if (window._historyBoatMarker) m.removeLayer(window._historyBoatMarker);
                window._historyBoatMarker = L.circleMarker([{lat}, {lon}], {{
                    radius: 7, color: '#60a5fa', fillColor: '#60a5fa', fillOpacity: 1, weight: 2
                }}).bindTooltip('Current position').addTo(m);
            }})()
        ");
    }

    private async Task GoToBoat()
    {
        if (SignalkClient.Data.Latitude is null || SignalkClient.Data.Longitude is null) return;
        double lat = SignalkClient.Data.Latitude.Value;
        double lon = SignalkClient.Data.Longitude.Value;
        await JS.InvokeVoidAsync("eval", $@"
            (function() {{
                var m = window._historyMap;
                if (m) m.setView([{lat}, {lon}], 14);
            }})()
        ");
        await DrawBoatMarker();
    }

    private void OnTimespanChanged(ChangeEventArgs e)
    {
        selectedTimespan = e.Value?.ToString() ?? "1d";
    }

    private void OnModeChanged(ChangeEventArgs e)
    {
        rangeMode = e.Value?.ToString() == "custom" ? "custom" : "preset";
    }

    private void OnCustomFromChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var dt))
        {
            // datetime-local emits a timezone-naive value in the
            // helm's tablet timezone. Mark it Unspecified so future
            // ToUniversalTime() conversion treats it as local rather
            // than guessing.
            customFromLocal = DateTime.SpecifyKind(dt, DateTimeKind.Unspecified);
        }
    }

    private void OnCustomToChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var dt))
        {
            customToLocal = DateTime.SpecifyKind(dt, DateTimeKind.Unspecified);
        }
    }

    /// <summary>Format a local DateTime for an HTML datetime-local
    /// input: <c>yyyy-MM-ddTHH:mm</c>. Anything else (full ISO with
    /// offset, etc.) renders the input blank because the spec is
    /// strict about the format. Invariant culture so the helm's
    /// locale doesn't accidentally produce <c>05.06.2024</c>.</summary>
    private static string FormatLocalForInput(DateTime t) =>
        t.ToString("yyyy-MM-ddTHH:mm", System.Globalization.CultureInfo.InvariantCulture);

    /// <summary>Pulls the current Leaflet viewport bounds from JS and
    /// returns them as a <see cref="TrackBbox"/> padded outward by
    /// <see cref="BboxPadFraction"/>. Returns null when the map isn't
    /// ready, when JS interop fails (page teardown), or when the
    /// bounds aren't a sensible numeric quadruple. Padding the bounds
    /// avoids re-fetching every time the helm pans by a few pixels --
    /// 20 % means the box only "moves" once the helm pans ~10 % of
    /// the viewport off-screen.</summary>
    private const double BboxPadFraction = 0.20;

    private async Task<TrackBbox?> TryGetViewportBboxAsync()
    {
        try
        {
            // Returns [south, west, north, east] from Leaflet's
            // getBounds(). Defensive: if any of those isn't a finite
            // number, fall back to "no bbox" rather than send garbage.
            var raw = await JS.InvokeAsync<double[]?>("eval", $@"
                (function() {{
                    var m = window._historyMap;
                    if (!m) return null;
                    var b = m.getBounds();
                    return [b.getSouth(), b.getWest(), b.getNorth(), b.getEast()];
                }})()
            ");
            if (raw is null || raw.Length != 4) return null;
            double s = raw[0], w = raw[1], n = raw[2], e = raw[3];
            if (!double.IsFinite(s) || !double.IsFinite(w)
                || !double.IsFinite(n) || !double.IsFinite(e)) return null;
            // Pad outward 20 % per axis so a small pan doesn't
            // re-fetch. dLat / dLon are signed so we correctly
            // expand both N+S and E+W.
            double dLat = (n - s) * BboxPadFraction;
            double dLon = (e - w) * BboxPadFraction;
            return new TrackBbox(
                South: s - dLat, West: w - dLon,
                North: n + dLat, East: e + dLon);
        }
        catch (JSDisconnectedException) { return null; }
        catch (JSException) { return null; }
        catch (ObjectDisposedException) { return null; }
    }

    private async Task LoadTrack()
    {
        loadAttempted = true;
        // Resolve the time window from the current mode. Custom mode
        // sends absolute (from, to) UTC instants -- helm-locale
        // wall-clock at this layer becomes UTC at the API boundary.
        // Preset mode sends a relative duration (timespan).
        DateTimeOffset? fromUtc = null, toUtc = null;
        string? span = selectedTimespan;
        if (rangeMode == "custom")
        {
            // Guard against an inverted range (start > end). Snap by
            // swapping rather than refusing, since the helm probably
            // just edited the inputs in the wrong order and a silent
            // swap is friendlier than an error toast.
            var (lo, hi) = customFromLocal <= customToLocal
                ? (customFromLocal, customToLocal)
                : (customToLocal, customFromLocal);
            fromUtc = new DateTimeOffset(lo.ToUniversalTime(), TimeSpan.Zero);
            toUtc = new DateTimeOffset(hi.ToUniversalTime(), TimeSpan.Zero);
            span = null;     // ignored when from is supplied; explicit for clarity
        }

        // Optional bbox hint from the current viewport, oversized 20 %
        // outward so a small pan doesn't trigger a re-fetch. The
        // server may or may not honour the bbox; signalk-parquet does,
        // others ignore unknown query params and we fall back to
        // time-only filtering. Skipped when the map isn't ready yet
        // or the bounds call fails.
        TrackBbox? bbox = await TryGetViewportBboxAsync();

        // Rich fetch: timestamps + sog + wind in one round-trip.
        // Segmenter splits into stationary/moving runs which JS
        // renders with distinct styling + per-segment hover tooltips.
        points = await TrackApi.GetServerTrackPointsAsync(
            from: fromUtc, to: toUtc, timespan: span,
            resolution: "30s", bbox: bbox);
        segments = points is { Length: > 0 } ? TrackSegmenter.Segment(points) : null;
        playbackIndex = 0;
        playing = false;
        playTimer?.Dispose();
        playTimer = null;

        if (points is { Length: > 0 } && segments is { Length: > 0 })
        {
            // Build per-segment payloads in C#. Each entry carries the
            // segment's [lat, lon] coordinate list (sliced from the
            // chronological points by timestamp window) plus a
            // pre-formatted tooltip body. Formatting in C# keeps the
            // JS dumb (just pass strings through to Leaflet's
            // bindTooltip) and matches the project's preference for
            // C# over JS for anything past pure rendering.
            var segPayload = HistorySegmentRender.BuildSegmentPayload(points, segments);
            // Playback marker only needs (lat, lon). Pass a flat array
            // so MoveMarker doesn't have to thread the rich record
            // shape through JSON every scrub.
            var coords = points.Select(p => new[] { p.Latitude, p.Longitude }).ToArray();

            await JS.InvokeVoidAsync("eval", $@"
                (function() {{
                    var m = window._historyMap;
                    if (!m) return;
                    if (window._historySegments) {{
                        window._historySegments.forEach(function(l) {{ m.removeLayer(l); }});
                    }}
                    window._historySegments = [];

                    var segs = {System.Text.Json.JsonSerializer.Serialize(segPayload)};
                    var movingColor = getComputedStyle(document.documentElement)
                        .getPropertyValue('--map-own').trim() || '#ec4899';
                    var stationaryColor = getComputedStyle(document.documentElement)
                        .getPropertyValue('--sk-text-muted').trim() || '#94a3b8';

                    var bounds = null;
                    segs.forEach(function(s) {{
                        // Stationary segments render dimmer + thinner +
                        // dashed so the eye walks the passage shape
                        // rather than getting drawn into the dwell
                        // knots. Moving segments use the same magenta
                        // weight as the live own-vessel track on the
                        // Map page so muscle memory carries.
                        var style = s.isStationary
                            ? {{ color: stationaryColor, weight: 2.5, opacity: 0.55, dashArray: '4 4' }}
                            : {{ color: movingColor, weight: 3.5, opacity: 0.9 }};
                        style.lineJoin = 'round';
                        style.lineCap = 'round';
                        var poly = L.polyline(s.coords, style)
                            .bindTooltip(s.tooltip, {{ sticky: true, direction: 'top' }})
                            .addTo(m);
                        window._historySegments.push(poly);
                        var b = poly.getBounds();
                        bounds = bounds ? bounds.extend(b) : b;
                    }});
                    if (bounds) m.fitBounds(bounds, {{ padding: [40, 40] }});

                    if (window._historyMarker) m.removeLayer(window._historyMarker);
                    var coords = {System.Text.Json.JsonSerializer.Serialize(coords)};
                    window._historyMarker = L.circleMarker(coords[0], {{
                        radius: 8, color: '#fbbf24', fillColor: '#fbbf24', fillOpacity: 1, weight: 2
                    }}).bindTooltip('Playback').addTo(m);
                    // Stash the flat coords for the scrub path so
                    // MoveMarker stays a one-liner.
                    window._historyCoords = coords;
                }})()
            ");
        }
        await DrawBoatMarker();
        StateHasChanged();
    }

    // Segment-payload + tooltip formatting moved to
    // OnaPlotter.Utilities.HistorySegmentRender so the pure-function
    // logic can be unit-tested without standing up the Razor page.

    private async Task OnScrub(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int idx))
        {
            playbackIndex = idx;
            await MoveMarker();
        }
    }

    private int playbackPeriodMs = 200;   // default 1x

    private void OnSpeedChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int ms))
        {
            playbackPeriodMs = Math.Clamp(ms, 20, 1000);
            if (playing)
            {
                // Re-arm timer at the new cadence.
                playTimer?.Dispose();
                playTimer = NewPlayTimer();
            }
        }
    }

    private System.Threading.Timer NewPlayTimer() =>
        new(async _ =>
        {
            if (!playing || points is null) return;
            playbackIndex = Math.Min(playbackIndex + 1, points.Length - 1);
            if (playbackIndex >= points.Length - 1) playing = false;
            await MoveMarker();
            try { await InvokeAsync(StateHasChanged); }
            catch (ObjectDisposedException) { }
        }, null, 0, playbackPeriodMs);

    private void PlayPause()
    {
        playing = !playing;
        if (playing)
        {
            playTimer = NewPlayTimer();
        }
        else
        {
            playTimer?.Dispose();
            playTimer = null;
        }
    }

    private void StepBy(int delta)
    {
        if (points is null || points.Length == 0) return;
        playbackIndex = Math.Clamp(playbackIndex + delta, 0, points.Length - 1);
        _ = MoveMarker();
    }

    private async Task MoveMarker()
    {
        if (points is null || points.Length == 0) return;
        if (playbackIndex < 0 || playbackIndex >= points.Length) return;
        var pt = points[playbackIndex];
        try
        {
            // Use invariant culture on the coordinate doubles -- the
            // helm's locale (e.g. de-CH) would otherwise render the
            // decimal as a comma and Leaflet would parse 47,4 as
            // [47, 4] silently. Matches the JSON-serialised format
            // used by LoadTrack's per-segment payload.
            string lat = pt.Latitude.ToString(CultureInfo.InvariantCulture);
            string lon = pt.Longitude.ToString(CultureInfo.InvariantCulture);
            await JS.InvokeVoidAsync("eval", $@"
                (function() {{
                    var m = window._historyMap;
                    if (!m || !window._historyMarker) return;
                    window._historyMarker.setLatLng([{lat}, {lon}]);
                }})()
            ");
        }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
    }

    public async ValueTask DisposeAsync()
    {
        playing = false;
        if (playTimer is not null) await playTimer.DisposeAsync();
        try
        {
            await JS.InvokeVoidAsync("eval",
                "if(window._historyMap){window._historyMap.remove();window._historyMap=null;}");
        }
        catch { /* Ignore on disconnect. */ }
        if (module is not null) await module.DisposeAsync();
    }
}
