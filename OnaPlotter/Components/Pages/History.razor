@* History playback: replay past track data on the map. *@

@page "/history"
@using OnaPlotter.Services
@using OnaPlotter.Models
@using OnaPlotter.Utilities
@using Microsoft.JSInterop
@using System.Globalization
@implements IAsyncDisposable
@using OnaPlotter.Services.Api
@inject ITrackApi TrackApi
@inject IChartApi ChartApi
@inject IRouteApi RouteApi
@inject ISignalKBaseUrl SkBaseUrl
@inject SignalkClient SignalkClient
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject IToastService Toasts
@inject IConfirmationService Confirmations
@inject OnaPlotter.Services.State.HistoryPageState State

<PageTitle>History</PageTitle>

<div class="history-page">
    @* Top toolbar: view-mode + filters + Load. Lives at the top so
       the helm sees what window they're looking at AND can pick the
       map/table view without scrolling past the playback strip. The
       same filters drive both views (segments are computed from the
       same fetched points whichever mode is active), so changing the
       timespan / resolution refreshes both at once. *@
    <div class="history-top-bar">
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <div class="btn-group btn-group-sm" role="group" aria-label="View mode">
                <button class="btn @(viewMode == "map" ? "btn-primary" : "btn-outline-secondary")"
                        @onclick="@(() => viewMode = "map")"
                        title="Map view (playback)">Map</button>
                <button class="btn @(viewMode == "table" ? "btn-primary" : "btn-outline-secondary")"
                        @onclick="@(() => viewMode = "table")"
                        disabled="@(segments is null || segments.Length == 0)"
                        title="Table view (list of trips)">Table</button>
            </div>
            <select class="form-select form-select-sm" data-history-input
                    title="Window mode"
                    @onchange="OnModeChanged">
                <option value="preset" selected="@(rangeMode == "preset")">Preset</option>
                <option value="custom" selected="@(rangeMode == "custom")">Custom</option>
            </select>
            @if (rangeMode == "preset")
            {
                @* Mirrors the Stats page's preset list 1:1 so a helm
                   switching between the two pages sees the same options
                   in the same order with the same labels. The 30d/90d/
                   365d additions extend the History map view to long
                   windows for season-review playback; long-window
                   defaults use a coarser resolution to keep the row
                   count manageable. *@
                <select class="form-select form-select-sm" data-history-input
                        @onchange="OnTimespanChanged">
                    <option value="1h"   selected="@(selectedTimespan == "1h")">Last 1 hour</option>
                    <option value="6h"   selected="@(selectedTimespan == "6h")">Last 6 hours</option>
                    <option value="1d"   selected="@(selectedTimespan == "1d")">Today (24 h)</option>
                    <option value="3d"   selected="@(selectedTimespan == "3d")">Last 3 days</option>
                    <option value="7d"   selected="@(selectedTimespan == "7d")">Last 7 days</option>
                    <option value="30d"  selected="@(selectedTimespan == "30d")">Last 30 days</option>
                    <option value="90d"  selected="@(selectedTimespan == "90d")">Last 90 days</option>
                    <option value="365d" selected="@(selectedTimespan == "365d")">Last year</option>
                </select>
            }
            else
            {
                @* Custom date range. datetime-local takes wall-clock
                   input from the helm's tablet timezone; we convert
                   to UTC at fetch time so the API call is unambiguous
                   regardless of where the helm is. *@
                <input type="datetime-local" class="form-control form-control-sm"
                       data-history-input
                       title="Start of window (local time)"
                       value="@FormatLocalForInput(customFromLocal)"
                       @onchange="OnCustomFromChanged" />
                <span class="history-muted-sm">to</span>
                <input type="datetime-local" class="form-control form-control-sm"
                       data-history-input
                       title="End of window (local time)"
                       value="@FormatLocalForInput(customToLocal)"
                       @onchange="OnCustomToChanged" />
            }
            @* Sampling resolution. Wider range than the Stats page
               because History is also the playback view -- a helm
               investigating "what happened in that 90-second tack
               at 14:32" needs 1 s, while a helm reviewing a
               trans-Atlantic at 90 d is fine with 1 h. The chunker
               (TrackApi.GetServerTrackPointsAsync) keeps fine-
               resolution-over-long-window loads under the SK history
               provider's per-response cap by issuing parallel sub-
               requests. *@
            <select class="form-select form-select-sm" data-history-input
                    title="Sampling resolution"
                    aria-label="Sampling resolution"
                    @onchange="OnResolutionChanged">
                <option value="1s"  selected="@(resolution == "1s")">1 s (sub-second tacks)</option>
                <option value="30s" selected="@(resolution == "30s")">30 s</option>
                <option value="1m"  selected="@(resolution == "1m")">1 m</option>
                <option value="5m"  selected="@(resolution == "5m")">5 m</option>
                <option value="15m" selected="@(resolution == "15m")">15 m</option>
                <option value="30m" selected="@(resolution == "30m")">30 m</option>
                <option value="1h"  selected="@(resolution == "1h")">1 h</option>
                <option value="4h"  selected="@(resolution == "4h")">4 h (season review)</option>
            </select>
            @* Loading-aware Load button. While a fetch is in flight
               the same button doubles as Cancel: helm tap signals
               the in-flight CTS so a slow sat-link fetch can be
               aborted without waiting it out. The button STAYS
               enabled while loading (we want the cancel tap), the
               spinner conveys "still working", and the title text
               shifts to "tap to cancel" so the helm doesn't think
               the second tap will racetrack a duplicate request. *@
            <button class="map-btn @(loading ? "loading-cancel" : "")"
                    @onclick="LoadTrack"
                    title="@(loading ? "Loading… tap to cancel" : "Load track for the chosen window")">
                @if (loading)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                    <span>Cancel</span>
                }
                else
                {
                    <span>Load</span>
                }
            </button>
            @* Stationary-as-dot toggle. Default ON: each stationary
               segment collapses to a single circleMarker at its
               centroid so a 7-day window of swing-at-anchor doesn't
               drown the moving passages in dashed grey. OFF brings
               back the full polyline. Reuses the cached points +
               segments -- no refetch on flip, just a JS re-render.
               Lives in the top toolbar alongside resolution because
               both knobs control "what the helm sees for this data
               window", not "what data we fetch". *@
            <label class="d-inline-flex align-items-center gap-1"
                   style="font-size:0.85rem; color:var(--sk-text-muted);"
                   title="Stationary segments collapse to a single dot at their centroid; uncheck for the full dashed-grey track">
                <input type="checkbox" @bind="mapStationaryAsDot" @bind:after="RerenderMapSegmentsAsync" />
                Stationary as dot
            </label>
        </div>
    </div>

    <div class="history-body">
        @* Map div stays mounted regardless of viewMode so Leaflet's
           internal state (tiles, layers, viewport) survives flips
           between Map and Table views. We just hide it visually when
           the table is on top. *@
        <div id="historyMapDiv"
             class="@(viewMode == "table" ? "history-map-hidden" : "")"></div>

        @if (viewMode == "table" && segments is { Length: > 0 })
        {
            <div class="history-table-view">
                <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
                    <h3 class="mb-0 history-trips-title">Trips</h3>
                    <span class="history-muted-sm">
                        @VisibleSegments(segments).Count() of @segments.Length segments
                    </span>
                    <label class="d-inline-flex align-items-center gap-1 ms-auto history-text-sm">
                        <input type="checkbox" @bind="tableShowStationary" />
                        Show stationary
                    </label>
                </div>
                <div class="history-table-scroll">
                    <table class="table table-sm table-hover history-trip-table">
                        <thead>
                            <tr>
                                <th>From</th>
                                <th>To</th>
                                <th class="text-end">Duration</th>
                                <th class="text-end">Distance</th>
                                <th class="text-end">SOG avg</th>
                                <th class="text-end">SOG max</th>
                                <th class="text-end">TWS avg</th>
                                <th>Type</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int row = 0;
                                foreach (var s in segments)
                                {
                                    int idx = row++;
                                    if (s.IsStationary && !tableShowStationary) continue;
                                    @* Click a row to open the trip detail
                                       panel (rich stats + per-trip action
                                       row). The "Open map" / "Save route" /
                                       "Export" / "Share" buttons in the
                                       Actions column stop propagation so
                                       a tap on them doesn't ALSO open the
                                       detail. Replaces the previous "click
                                       row -> fly to map" behaviour; the
                                       Open button now carries that intent
                                       explicitly so the row click stays
                                       reserved for "tell me more about
                                       this trip". *@
                                    <tr class="history-trip-row" @onclick="@(() => OpenTripDetail(idx))"
                                        title="Click for trip detail">
                                        <td>@s.StartUtc.ToLocalTime().ToString("ddd yyyy-MM-dd HH:mm", CultureInfo.CurrentCulture)</td>
                                        <td>@s.EndUtc.ToLocalTime().ToString("HH:mm")</td>
                                        <td class="text-end">@Format.TimeToGo(s.Duration.TotalSeconds)</td>
                                        <td class="text-end">@Format.Nm(s.DistanceMetres) nm</td>
                                        <td class="text-end">@(s.SogAvgMs is null ? "—" : Format.Speed(s.SogAvgMs))</td>
                                        <td class="text-end">@(s.SogMaxMs is null ? "—" : Format.Speed(s.SogMaxMs))</td>
                                        <td class="text-end">@(s.WindSpeedAvgMs is null ? "—" : Format.Speed(s.WindSpeedAvgMs))</td>
                                        <td>@(s.IsStationary ? "Stationary" : "Moving")</td>
                                        <td class="text-end">
                                            @* Action buttons. stopPropagation
                                               on each click handler so the
                                               row's open-detail handler
                                               doesn't fire twice. Save /
                                               Export / Share are only
                                               offered on moving segments
                                               (a stationary dwell isn't a
                                               trip a friend would want).
                                               Open map is fine on either
                                               so the helm can fly to a
                                               long anchor sit too. *@
                                            <div class="d-inline-flex gap-1 flex-nowrap">
                                                <button class="btn btn-sm btn-outline-secondary trip-action-btn"
                                                        @onclick="() => OpenSegmentOnMap(idx)"
                                                        @onclick:stopPropagation="true"
                                                        title="Show this trip on the map">Open</button>
                                                @if (!s.IsStationary)
                                                {
                                                    <button class="btn btn-sm btn-outline-secondary trip-action-btn"
                                                            @onclick="() => SaveSegmentAsRouteAsync(s)"
                                                            @onclick:stopPropagation="true"
                                                            title="Save this trip as a route on the SignalK server">Save</button>
                                                    <button class="btn btn-sm btn-outline-secondary trip-action-btn"
                                                            @onclick="() => ExportSegmentAsync(s)"
                                                            @onclick:stopPropagation="true"
                                                            title="Download this trip as GPX or GeoJSON">Export</button>
                                                    <button class="btn btn-sm btn-outline-secondary trip-action-btn"
                                                            @onclick="() => ShareSegmentAsync(s)"
                                                            @onclick:stopPropagation="true"
                                                            title="Share this trip via system share sheet or clipboard">Share</button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @* Trip detail panel. Renders as an overlay above the table /
           map when the helm clicks a row. Closes via the X button or
           the Esc key (handled in the page's keydown). Built as an
           in-page panel rather than a Bootstrap modal so it inherits
           the page's theme tokens cleanly without the modal-backdrop
           opacity logic getting in the way. *@
        @if (tripDetailIdx is int detailIdx
             && segments is { Length: > 0 }
             && detailIdx >= 0 && detailIdx < segments.Length)
        {
            <TripDetailPanel Segment="segments[detailIdx]"
                             Points="SegmentPoints(segments[detailIdx])"
                             OnClose="CloseTripDetail"
                             OnOpenOnMap="@(() => OpenSegmentOnMap(detailIdx))"
                             OnSave="@(() => SaveSegmentAsRouteAsync(segments[detailIdx]))"
                             OnExport="@(() => ExportSegmentAsync(segments[detailIdx]))"
                             OnShare="@(() => ShareSegmentAsync(segments[detailIdx]))" />
        }
    </div>

    @* Bottom strip: playback + locate-boat + charts. ONLY rendered
       when viewMode == "map" -- on the table the playback isn't
       meaningful (no marker on screen) and the chart toggle
       reorganises the underlying map which the helm can't see
       anyway. The empty-state message + the "Pick a timespan" hint
       also live here so the bottom strip retains a purpose during
       the pre-load idle. *@
    @if (viewMode == "map")
    {
        <div class="history-controls">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <button class="map-btn" @onclick="GoToBoat" title="Center on current boat position">
                    @((MarkupString)Icons.Follow) Boat
                </button>
                @* Charts toggle. Minimal version of the Map page's
                   LayersPanel: just a flat list of available charts
                   with a checkbox each. The list is bbox-filtered to
                   the current viewport so the picker doesn't drown
                   the helm in irrelevant chart entries on a passage
                   review (a 10-NM Solent zoom doesn't need to list
                   the helm's Med-coast offline tiles).
                   No quick-bar, no drag-reorder, no persistence --
                   chart selection is per-session here so opening
                   History to review a passage doesn't clobber the
                   helm's chart preferences on the live Map page. *@
                @if (VisibleChartCount() > 0 || enabledChartIds.Count > 0)
                {
                    <button class="map-btn" @onclick="ToggleChartsPanel"
                            title="Show / hide chart layers (filtered to map viewport)">
                        Charts (@enabledChartIds.Count / @VisibleChartCount())
                    </button>
                }
            </div>

            @if (chartsPanelOpen)
            {
                <div class="history-charts-panel">
                    @foreach (var chart in VisibleCharts())
                    {
                        <label class="d-flex align-items-center gap-2 history-charts-item">
                            <input type="checkbox"
                                   checked="@enabledChartIds.Contains(chart.Identifier)"
                                   @onchange="async e => await ToggleChartAsync(chart, e)" />
                            <span>@(string.IsNullOrEmpty(chart.Name) ? chart.Identifier : chart.Name)</span>
                        </label>
                    }
                    @if (!VisibleCharts().Any())
                    {
                        <div class="history-empty-msg">
                            No charts cover the current viewport.
                        </div>
                    }
                </div>
            }

            @if (points is not null && points.Length > 0)
            {
                <div class="mt-2">
                    <input type="range" class="form-range" min="0" max="@(points.Length - 1)"
                           value="@playbackIndex" @oninput="OnScrub" />
                    <div class="d-flex justify-content-between history-muted-xs">
                        <span>@FormatTime(0)</span>
                        <span class="history-time-current">@CurrentTimeLabel</span>
                        <span>@FormatTime(points.Length - 1)</span>
                    </div>
                </div>
                @* Step buttons disable at their respective boundary so the
                   user isn't left wondering whether &lt;&lt; was registered
                   but silently no-op'd at the start of the track. *@
                <div class="d-flex gap-2 mt-1 flex-wrap align-items-center">
                    <button class="map-btn" @onclick="PlayPause">@(playing ? "Pause" : "Play")</button>
                    <button class="map-btn" @onclick="() => StepBy(-10)"
                            disabled="@(playbackIndex == 0)">&lt;&lt;</button>
                    <button class="map-btn" @onclick="() => StepBy(-1)"
                            disabled="@(playbackIndex == 0)">&lt;</button>
                    <button class="map-btn" @onclick="() => StepBy(1)"
                            disabled="@(playbackIndex >= points.Length - 1)">&gt;</button>
                    <button class="map-btn" @onclick="() => StepBy(10)"
                            disabled="@(playbackIndex >= points.Length - 1)">&gt;&gt;</button>
                    @* Playback speed -- 1x default; multipliers map
                       through OnSpeedChanged into the timer interval. *@
                    <label class="d-inline-flex align-items-center gap-1 ms-2 history-muted-xs">
                        Speed
                        <select class="form-select form-select-sm" data-history-input
                                aria-label="Playback speed"
                                @onchange="OnSpeedChanged">
                            <option value="0.5">0.5x</option>
                            <option value="1" selected>1x</option>
                            <option value="2">2x</option>
                            <option value="5">5x</option>
                            <option value="10">10x</option>
                        </select>
                    </label>
                </div>
            }
            else if (loadAttempted)
            {
                <EmptyState Compact="true"
                            Title="No track data for this timespan"
                            Message="Tracks come from a SignalK History provider (signalk-parquet, signalk-to-influxdb2). If you expected data, check the plugin is active on the server." />
            }
            else
            {
                <EmptyState Compact="true"
                            Title="Pick a timespan and tap Load" />
            }
        </div>
    }
</div>

@code {
    private IJSObjectReference? module;
    /// <summary>DotNet ref handed to JS so the Leaflet moveend
    /// handler can invoke <see cref="OnHistoryViewportChanged"/> when
    /// the helm pans / zooms. The chart-picker's bbox filter listens
    /// via the cached viewport bounds. Disposed alongside the page.</summary>
    private DotNetObjectReference<History>? _historyDotNet;
    // Rich points (lat/lon + timestamp + sog/cog/wind) drive both the
    // playback scrub (marker moves through this list, indices stable)
    // and the segmenter (stationary vs moving classification + per-
    // segment stats). The playback marker only needs (lat, lon) so we
    // expose a side array to keep MoveMarker's JS payload tiny.
    private TrackPoint[]? points;
    private TrackSegment[]? segments;
    private int playbackIndex;
    private string selectedTimespan = "1d";
    private bool playing;
    private bool loadAttempted;
    /// <summary>True while a LoadTrack fetch is in flight. Drives the
    /// Load button's spinner + disabled state so a slow History API
    /// (sat-link, large window) doesn't have helms tapping Load
    /// repeatedly thinking the page froze.</summary>
    private bool loading;
    /// <summary>Cancellation source for the in-flight LoadTrack fetch.
    /// Tapping the Loading… button (which doubles as Cancel while a
    /// fetch is in flight) signals this CTS, the History API call
    /// throws OperationCanceledException, and we drop back to the
    /// idle state without applying a partial result. Helm-initiated
    /// cancel is silent (no error toast); a server / network failure
    /// is still surfaced by the underlying API layer's toast.</summary>
    private CancellationTokenSource? _loadCts;
    /// <summary>True when the helm tapped the Cancel button to abort
    /// the in-flight fetch (vs the 30 s timeout firing on its own).
    /// Used in the OperationCanceledException catch to decide whether
    /// to surface a "fetch timed out" toast: helm-tap gets silence
    /// because they know they tapped; timeout gets explained.</summary>
    private bool _userInitiatedCancel;
    private System.Threading.Timer? playTimer;
    // Custom date-range state. "preset" mode uses selectedTimespan
    // (the dropdown); "custom" uses customFromLocal + customToLocal.
    // The local fields hold WALL-CLOCK times in the helm's tablet
    // timezone (matches what the datetime-local input emits); LoadTrack
    // converts to UTC before passing to TrackApi.
    private string rangeMode = "preset";
    private DateTime customFromLocal = DateTime.Now.AddHours(-6);
    private DateTime customToLocal = DateTime.Now;
    // Sampling resolution. 5 m default after helm field-test on long
    // windows: at 30 s a 7-day load chunks into ~42 sub-requests
    // (the History API caps each response at 500 rows), which on a
    // sat-link feels slow. 5 m gives 7 d × 12 buckets/h = ~2 016
    // rows -- one round-trip, sub-second on LAN -- and the helm
    // who actually wants finer (down to 1 s for sub-second tack
    // analysis) or coarser (up to 4 h for season review) detail
    // can still pick it from the dropdown. The default is paired
    // with the "Today (24 h)" timespan default so a fresh visit
    // shows 24 h × 12 buckets/h = 288 rows -- one round-trip,
    // smooth playback.
    private string resolution = "5m";
    // View mode toggle. "map" is the default playback view; "table"
    // hides the map behind a list of segments (filtered to moving by
    // default; toggle to include stationary). Click a row to flip
    // back to map and fly to that segment's bounds. Map stays mounted
    // throughout so Leaflet's tile cache survives the swap -- no
    // re-fetching basemap tiles on every flip.
    private string viewMode = "map";
    private bool tableShowStationary;
    /// <summary>Map-side stationary render mode. <c>true</c> (default)
    /// collapses each stationary segment to a single circleMarker at
    /// its centroid -- visually quiet, the eye walks moving-trip
    /// passages without getting tangled in dwell jitter. <c>false</c>
    /// brings back the full dashed-grey polyline so the helm can see
    /// where the boat actually swung at anchor. Independent of
    /// <see cref="tableShowStationary"/> (table-row filter) so the
    /// two views can be tuned separately for the same data.</summary>
    private bool mapStationaryAsDot = true;
    // Chart-layer state. Loaded once from IChartApi after the map
    // initialises. enabledChartIds holds the per-session set; no
    // persistence (the Map page's IChartSettings is not shared with
    // this page on purpose, so opening History to review yesterday
    // doesn't clobber the helm's live-Map chart preferences).
    private List<OnaPlotter.Models.SignalkChart>? availableCharts;
    private readonly HashSet<string> enabledChartIds = new(StringComparer.Ordinal);
    private bool chartsPanelOpen;
    /// <summary>Open trip-detail target. Index into the FULL
    /// <c>segments</c> array (not the visible-segments filter).
    /// Null when no detail panel is open.</summary>
    private int? tripDetailIdx;
    /// <summary>Last-seen viewport bounds (south, west, north, east),
    /// updated on map moveend so the chart-picker can re-filter
    /// without a fresh JS roundtrip every render.</summary>
    private double[]? viewportBounds;

    /// <summary>Surface the current scrub timestamp instead of the
    /// previous "Point N / total" placeholder. Helms reading the
    /// playback line want to know when something happened, not which
    /// sample number it was. Local time because the helm is reading
    /// the time on the helm, not in UTC.</summary>
    private string CurrentTimeLabel =>
        points is not null && playbackIndex < points.Length
            ? points[playbackIndex].Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
            : "--";

    /// <summary>End-of-range label for the playback slider. Boundary
    /// timestamps anchor the helm visually so the slider's halves
    /// read as "earlier" / "later" instead of just 0%/100%.</summary>
    private string FormatTime(int index)
    {
        if (points is null || index >= points.Length) return "--";
        return points[index].Timestamp.ToLocalTime().ToString("HH:mm");
    }

    protected override void OnInitialized()
    {
        // Restore the helm's last-picked inputs from the singleton
        // page-state cache so navigating away + back finds the page
        // exactly where they left it (focus-group request 2026-04).
        // We ONLY restore inputs; the loaded geometry refetches via
        // LoadTrack so the helm sees fresh data on return rather
        // than a stale cache.
        rangeMode = State.RangeMode;
        selectedTimespan = State.SelectedTimespan;
        customFromLocal = State.CustomFromLocal;
        customToLocal = State.CustomToLocal;
        resolution = State.Resolution;
        viewMode = State.ViewMode;
    }

    /// <summary>Snapshot the current input state into the page-state
    /// cache so the next visit restores the same window + view
    /// pick. Loaded geometry is NOT cached -- LoadTrack on the next
    /// mount refetches with the same inputs, surfacing fresh
    /// numbers.</summary>
    private void SaveToState()
    {
        State.RangeMode = rangeMode;
        State.SelectedTimespan = selectedTimespan;
        State.CustomFromLocal = customFromLocal;
        State.CustomToLocal = customToLocal;
        State.Resolution = resolution;
        State.ViewMode = viewMode;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/leafletInterop.js");

            // Initialize map. Default center on the boat's current position if available,
            // otherwise a generic fallback.
            double lat = SignalkClient.Data.Latitude ?? 47.4;
            double lon = SignalkClient.Data.Longitude ?? 8.5;
            int zoom = SignalkClient.Data.Latitude is not null ? 13 : 8;

            // Build a DotNet ref before constructing the map so the
            // moveend handler can call back into C# to refresh the
            // viewport-bounds cache for the bbox-filtered chart
            // picker. The ref is disposed alongside the page (see
            // DisposeAsync).
            _historyDotNet = DotNetObjectReference.Create(this);
            // Stash the dotnet-ref globally first so the moveend
            // handler attached below has it ready by the time the
            // helm pans. Two-step (set ref, then create map +
            // listeners) keeps the wire-up race-free.
            //
            // Was previously eval("window._historyDotNet = arguments[0]",
            // ref). That threw "arguments is not defined" -- eval
            // runs in the surrounding strict-module context where
            // `arguments` isn't bound, and Blazor's eval interop
            // doesn't pass extra args to the eval'd code anyway.
            // The exported helper receives serialised args
            // correctly because it's a real exported function.
            await module.InvokeVoidAsync("setHistoryDotNetRef", _historyDotNet);
            await JS.InvokeVoidAsync("eval", $@"
                (function() {{
                    if (window._historyMap) window._historyMap.remove();
                    var m = L.map('historyMapDiv', {{ zoomControl: true }}).setView([{lat}, {lon}], {zoom});
                    // OpenSeaMap as the primary visual reference (matches user preference).
                    L.tileLayer('https://tile.openstreetmap.org/{{z}}/{{x}}/{{y}}.png',
                        {{ maxZoom: 19, attribution: '&copy; OSM', referrerPolicy: 'strict-origin-when-cross-origin' }}).addTo(m);
                    L.tileLayer('https://tiles.openseamap.org/seamark/{{z}}/{{x}}/{{y}}.png',
                        {{ maxZoom: 19, opacity: 0.8, referrerPolicy: 'strict-origin-when-cross-origin' }}).addTo(m);
                    window._historyMap = m;
                    window._historyMarker = null;
                    window._historyTrack = null;
                    window._historyBoatMarker = null;

                    // moveend / zoomend invoke C# so the chart-picker
                    // bbox filter stays in sync with the visible map.
                    var ref = window._historyDotNet;
                    if (ref) {{
                        m.on('moveend zoomend', function() {{
                            ref.invokeMethodAsync('OnHistoryViewportChanged');
                        }});
                    }}
                }})()
            ");

            // Draw boat position if available.
            if (SignalkClient.Data.Latitude is not null && SignalkClient.Data.Longitude is not null)
            {
                await DrawBoatMarker();
            }

            // Pull the available charts list once. The History page's
            // chart toggle is per-session (no persisted enabled set)
            // so we can fetch and cache here without worrying about
            // re-syncing across page mounts. A 404 / 5xx returns an
            // empty list -- the Charts button just doesn't render.
            try
            {
                availableCharts = await ChartApi.GetAllAsync();
            }
            catch (HttpRequestException) { availableCharts = []; }

            // Apply incoming query params before the auto-load, so a
            // deep link (?from=...&to=...&view=table) lands on the
            // requested window + view instead of the page default.
            // Drill-down from /stats uses this to "show me these
            // trips" without forcing a re-pick of the date range.
            ApplyQueryParams();

            // Auto-load the (possibly query-overridden) timespan.
            await LoadTrack();
        }
        catch (JSDisconnectedException) { /* page teardown race */ }
        catch (JSException ex)
        {
            // Silent swallow would hide a Leaflet / CDN failure; log so
            // the browser console tells a developer what broke. The
            // user sees an empty map rather than the Blazor error UI.
            Console.Error.WriteLine($"[history] init: {ex.Message}");
        }
    }

    private async Task DrawBoatMarker()
    {
        if (SignalkClient.Data.Latitude is null || SignalkClient.Data.Longitude is null) return;
        double lat = SignalkClient.Data.Latitude.Value;
        double lon = SignalkClient.Data.Longitude.Value;
        await JS.InvokeVoidAsync("eval", $@"
            (function() {{
                var m = window._historyMap;
                if (!m) return;
                if (window._historyBoatMarker) m.removeLayer(window._historyBoatMarker);
                // Pull --sk-accent so the marker tracks theme. Falls
                // back to the previous frozen sky-blue if the token
                // isn't set (defensive; in practice every theme block
                // defines it).
                var col = getComputedStyle(document.documentElement)
                    .getPropertyValue('--sk-accent').trim() || '#60a5fa';
                window._historyBoatMarker = L.circleMarker([{lat}, {lon}], {{
                    radius: 7, color: col, fillColor: col, fillOpacity: 1, weight: 2
                }}).bindTooltip('Current position').addTo(m);
            }})()
        ");
    }

    private async Task GoToBoat()
    {
        if (SignalkClient.Data.Latitude is null || SignalkClient.Data.Longitude is null) return;
        double lat = SignalkClient.Data.Latitude.Value;
        double lon = SignalkClient.Data.Longitude.Value;
        await JS.InvokeVoidAsync("eval", $@"
            (function() {{
                var m = window._historyMap;
                if (m) m.setView([{lat}, {lon}], 14);
            }})()
        ");
        await DrawBoatMarker();
    }

    /// <summary>Parse <c>?from=&amp;to=&amp;view=table</c> from the
    /// current URL and apply to the page state. Used for the Stats
    /// page's "View these trips" drill-down: the link encodes the
    /// helm's chosen window + a request for table view, History
    /// reads it, switches to custom mode + table mode, then
    /// LoadTrack picks up the values.
    /// <para>
    /// Robust to malformed input: any unparseable timestamp is
    /// silently ignored and the page falls back to its preset
    /// default. Same posture as the Map page's
    /// <c>?focus=</c> / <c>?edit=</c> handlers; the helm shouldn't
    /// see a stack trace because someone hand-edited the URL.
    /// </para>
    /// </summary>
    private void ApplyQueryParams()
    {
        try
        {
            var uri = new Uri(Nav.Uri);
            var qs = System.Web.HttpUtility.ParseQueryString(uri.Query);
            string? fromStr = qs["from"];
            string? toStr = qs["to"];
            string? view = qs["view"];

            // Window: when both from + to are valid, switch to custom
            // mode + apply. Just one valid (or none) keeps the helm's
            // preset default rather than half-applying.
            if (DateTime.TryParse(fromStr, System.Globalization.CultureInfo.InvariantCulture,
                    System.Globalization.DateTimeStyles.RoundtripKind, out var fromUtc)
                && DateTime.TryParse(toStr, System.Globalization.CultureInfo.InvariantCulture,
                    System.Globalization.DateTimeStyles.RoundtripKind, out var toUtc))
            {
                rangeMode = "custom";
                customFromLocal = DateTime.SpecifyKind(fromUtc.ToLocalTime(), DateTimeKind.Unspecified);
                customToLocal = DateTime.SpecifyKind(toUtc.ToLocalTime(), DateTimeKind.Unspecified);
            }

            // View: only "table" is meaningful as a deep-link target;
            // "map" is the default. Falls through silently for
            // anything else.
            if (view == "table") viewMode = "table";
        }
        catch (UriFormatException) { /* unparseable URI; keep defaults */ }
    }

    private void OnTimespanChanged(ChangeEventArgs e)
    {
        selectedTimespan = e.Value?.ToString() ?? "1d";
    }

    private void OnResolutionChanged(ChangeEventArgs e)
    {
        var v = e.Value?.ToString();
        if (!string.IsNullOrEmpty(v)) resolution = v;
    }

    private void OnModeChanged(ChangeEventArgs e)
    {
        rangeMode = e.Value?.ToString() == "custom" ? "custom" : "preset";
    }

    private void OnCustomFromChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var dt))
        {
            // datetime-local emits a timezone-naive value in the
            // helm's tablet timezone. Mark it Unspecified so future
            // ToUniversalTime() conversion treats it as local rather
            // than guessing.
            customFromLocal = DateTime.SpecifyKind(dt, DateTimeKind.Unspecified);
        }
    }

    private void OnCustomToChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var dt))
        {
            customToLocal = DateTime.SpecifyKind(dt, DateTimeKind.Unspecified);
        }
    }

    /// <summary>Format a local DateTime for an HTML datetime-local
    /// input: <c>yyyy-MM-ddTHH:mm</c>. Anything else (full ISO with
    /// offset, etc.) renders the input blank because the spec is
    /// strict about the format. Invariant culture so the helm's
    /// locale doesn't accidentally produce <c>05.06.2024</c>.</summary>
    private static string FormatLocalForInput(DateTime t) =>
        t.ToString("yyyy-MM-ddTHH:mm", System.Globalization.CultureInfo.InvariantCulture);

    private async Task ToggleChartsPanel()
    {
        chartsPanelOpen = !chartsPanelOpen;
        if (chartsPanelOpen)
        {
            // Refresh the cached viewport bounds when the panel opens
            // so a freshly-rendered list reflects the current map
            // view -- otherwise the helm sees stale entries from the
            // last moveend until the next pan.
            await RefreshViewportBoundsAsync();
        }
    }

    /// <summary>Pull the current Leaflet viewport bounds and stash on
    /// <see cref="viewportBounds"/>. Used by the chart picker's
    /// bbox filter. Silently no-ops on JS interop failure (page
    /// teardown, map not ready) so a load-time invocation can't
    /// crash the page.</summary>
    private async Task RefreshViewportBoundsAsync()
    {
        try
        {
            var raw = await JS.InvokeAsync<double[]?>("eval", $@"
                (function() {{
                    var m = window._historyMap;
                    if (!m) return null;
                    var b = m.getBounds();
                    return [b.getSouth(), b.getWest(), b.getNorth(), b.getEast()];
                }})()
            ");
            if (raw is { Length: 4 }
                && double.IsFinite(raw[0]) && double.IsFinite(raw[1])
                && double.IsFinite(raw[2]) && double.IsFinite(raw[3]))
            {
                viewportBounds = raw;
            }
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
    }

    /// <summary>Charts whose declared bounds intersect (or are
    /// world-spanning over) the current viewport. Built-in charts
    /// (OSM / OpenSeaMap) ship null bounds and always pass through.
    /// SK-served charts with a [west, south, east, north] tuple
    /// pass through when their bbox overlaps viewport. Charts with
    /// no bounds we don't have evidence to drop, so they pass too.
    /// Empty viewport (panel opened before map ready) = unfiltered.</summary>
    private IEnumerable<OnaPlotter.Models.SignalkChart> VisibleCharts()
    {
        if (availableCharts is null) yield break;
        if (viewportBounds is not { Length: 4 })
        {
            foreach (var c in availableCharts) yield return c;
            yield break;
        }
        double vS = viewportBounds[0], vW = viewportBounds[1];
        double vN = viewportBounds[2], vE = viewportBounds[3];
        foreach (var c in availableCharts)
        {
            if (c.Bounds is not { Length: 4 })
            {
                // Unbounded -> world-covering by convention.
                yield return c;
                continue;
            }
            // Bounds shape: [west, south, east, north].
            double cW = c.Bounds[0], cS = c.Bounds[1];
            double cE = c.Bounds[2], cN = c.Bounds[3];
            // Reject only if there's no overlap on either axis.
            // (cE < vW) means chart entirely west of viewport.
            // Standard AABB intersection.
            if (cE < vW || cW > vE || cN < vS || cS > vN) continue;
            yield return c;
        }
    }

    private int VisibleChartCount() => VisibleCharts().Count();

    /// <summary>Filter segments according to the table's current
    /// stationary toggle. Used by both the row count and the table
    /// body iteration so they stay in sync.</summary>
    private IEnumerable<TrackSegment> VisibleSegments(TrackSegment[] all) =>
        tableShowStationary ? all : all.Where(s => !s.IsStationary);

    /// <summary>Row click: switch back to map view and ask Leaflet to
    /// fit the segment's bounds. Index is into the full
    /// <c>segments</c> array (NOT the filtered one) so the JS can
    /// look up the matching polyline by position in
    /// <c>window._historySegments</c>. The flip + fly happens in two
    /// frames -- viewMode change re-renders, then a one-shot timer
    /// gives the map a chance to catch up before we call fitBounds.</summary>
    /// <summary>Promote a moving segment to a saved SignalK route.
    /// Helm wants this when an unplanned passage turned out useful
    /// ("we found a nice anchorage; do that again next time"); the
    /// existing route picker is then a one-click "Activate" away
    /// from re-running it.
    /// <para>
    /// Coords come from slicing the chronological <c>points</c>
    /// array by the segment's [StartUtc, EndUtc] window. RouteApi
    /// does the rest (POST to /resources/routes; SignalK assigns the
    /// id). Default name = "Trip yyyy-MM-dd HH:mm" so saved trips
    /// list naturally; the helm can rename later via the Resources
    /// page or the Layers panel.
    /// </para>
    /// </summary>
    private async Task SaveSegmentAsRouteAsync(TrackSegment s)
    {
        if (points is null) return;

        // Suggest a name, let the helm tweak before commit. Cancel
        // = abort. Whitespace-only = use the suggestion.
        string suggested = $"Trip {s.StartUtc.ToLocalTime():yyyy-MM-dd HH:mm}";
        var chosen = await Confirmations.PromptAsync(
            $"Save this trip ({Format.TimeToGo(s.Duration.TotalSeconds)}, "
            + $"{Format.Nm(s.DistanceMetres)} nm) as a route. Name:",
            initialValue: suggested,
            confirmLabel: "Save");
        if (chosen is null) return;
        string name = string.IsNullOrWhiteSpace(chosen) ? suggested : chosen;

        // Slice chronological points by the segment time window. Same
        // boundary inclusivity as HistorySegmentRender: start <= ts
        // <= end. Cursor walks forward; we don't need to re-sort.
        var coords = new List<double[]>();
        foreach (var p in points)
        {
            if (p.Timestamp < s.StartUtc) continue;
            if (p.Timestamp > s.EndUtc) break;
            coords.Add([p.Latitude, p.Longitude]);
        }
        if (coords.Count < 2)
        {
            Toasts.Error("Trip has fewer than 2 points -- can't save as a route.");
            return;
        }

        ApiResult<string> r;
        try { r = await RouteApi.SaveAsync(name, [.. coords]); }
        catch (Exception ex) { Toasts.Error($"Save route failed: {ex.Message}"); return; }
        if (!r.Success)
        {
            Toasts.Error($"Save route failed: {r.Error ?? "server rejected"}");
            return;
        }
        Toasts.Success($"Saved as route '{name}'");
    }

    /// <summary>Row "Open" button: switch to map view and ask Leaflet
    /// to fit the segment's bounds. Index is into the full
    /// <c>segments</c> array (NOT the filtered one) so the JS can
    /// look up the matching polyline by position in
    /// <c>window._historySegments</c>. Closes the trip-detail panel
    /// if it was open over the table.</summary>
    private async Task OpenSegmentOnMap(int segmentIndex)
    {
        tripDetailIdx = null;
        viewMode = "map";
        // Let the page re-render with the map visible before we ask
        // Leaflet to fit bounds. Without the StateHasChanged + small
        // yield, fitBounds runs while the map is still display:none
        // and Leaflet records zero dimensions for the viewport (next
        // tile fetch then misses the visible area entirely).
        StateHasChanged();
        await Task.Yield();
        try
        {
            await JS.InvokeVoidAsync("eval", $@"
                (function() {{
                    var m = window._historyMap;
                    var segs = window._historySegments;
                    if (!m || !segs) return;
                    var idx = {segmentIndex.ToString(System.Globalization.CultureInfo.InvariantCulture)};
                    var poly = segs[idx];
                    if (!poly) return;
                    m.invalidateSize();
                    m.fitBounds(poly.getBounds(), {{ padding: [40, 40] }});
                }})()
            ");
        }
        catch (JSDisconnectedException) { }
    }

    /// <summary>Row click: open the trip detail panel for the segment
    /// at <paramref name="segmentIndex"/>. The detail view shows
    /// rich stats (avg / max / min SOG, TWS, dwell breakdown,
    /// heading distribution) and the same per-trip action buttons
    /// the table row carries -- so the helm can drive everything
    /// from the detail panel without going back to the table.</summary>
    private void OpenTripDetail(int segmentIndex)
    {
        tripDetailIdx = segmentIndex;
    }

    private void CloseTripDetail()
    {
        tripDetailIdx = null;
    }

    /// <summary>Slice the chronological <c>points</c> array by the
    /// supplied segment's [StartUtc, EndUtc] window. Used by the
    /// trip-detail panel + by the per-trip Export / Share /
    /// Save-as-route paths so they share one slicing rule. Returns
    /// an empty array when <c>points</c> is null (lifecycle race).
    /// </summary>
    private IReadOnlyList<TrackPoint> SegmentPoints(TrackSegment s)
    {
        if (points is null || points.Length == 0) return [];
        var slice = new List<TrackPoint>();
        foreach (var p in points)
        {
            if (p.Timestamp < s.StartUtc) continue;
            if (p.Timestamp > s.EndUtc) break;
            slice.Add(p);
        }
        return slice;
    }

    /// <summary>GPX or GeoJSON download of the trip. The format
    /// chooser uses the shared confirmation modal so the helm sees
    /// the same dialog they use for waypoints / routes / regions on
    /// the Resources page; cancel = abort.</summary>
    private async Task ExportSegmentAsync(TrackSegment s)
    {
        var pts = SegmentPoints(s);
        if (pts.Count < 2)
        {
            Toasts.Error("Trip has fewer than 2 points -- nothing to export.");
            return;
        }

        const string FormatGpx = "GPX";
        const string FormatGeoJson = "GeoJSON";
        var picked = await Confirmations.ChooseAsync(
            "Export this trip as which format?",
            [FormatGpx, FormatGeoJson]);
        if (picked is null) return;

        string suggested = $"Trip {s.StartUtc.ToLocalTime():yyyy-MM-dd HH-mm}";
        string? content = picked == FormatGpx
            ? ResourceExporter.TripGpx(suggested, pts)
            : ResourceExporter.TripGeoJson(suggested, s, pts);
        if (content is null)
        {
            Toasts.Error("Couldn't build export -- trip has no usable geometry.");
            return;
        }

        // Sanitised filename so the OS save dialog doesn't reject
        // colons / slashes from the human-readable suggested name.
        string ext = picked == FormatGpx ? "gpx" : "geojson";
        string filename = SanitiseFilename(suggested) + "." + ext;
        try
        {
            var fileTransfer = await JS.InvokeAsync<IJSObjectReference>(
                "import", "./js/platform/fileTransfer.js");
            await fileTransfer.InvokeVoidAsync("triggerFileDownload", filename, content);
            Toasts.Success($"Exported {filename}");
        }
        catch (JSDisconnectedException) { }
        catch (JSException ex) { Toasts.Error($"Export failed: {ex.Message}"); }
    }

    /// <summary>Web Share API (system share sheet on iPad / Android
    /// Chrome) with a clipboard fallback when the API isn't
    /// available. Shares the GeoJSON because that's the
    /// most-portable format that round-trips through every consumer
    /// the helm is likely to send to (Freeboard-SK, QGIS, browser
    /// previews); GPX would be more interop-friendly with Garmin
    /// chartplotters but doesn't preview as nicely in chat apps.</summary>
    private async Task ShareSegmentAsync(TrackSegment s)
    {
        var pts = SegmentPoints(s);
        if (pts.Count < 2)
        {
            Toasts.Error("Trip has fewer than 2 points -- nothing to share.");
            return;
        }
        string suggested = $"Trip {s.StartUtc.ToLocalTime():yyyy-MM-dd HH:mm}";
        string? content = ResourceExporter.TripGeoJson(suggested, s, pts);
        if (content is null) return;

        try
        {
            var fileTransfer = await JS.InvokeAsync<IJSObjectReference>(
                "import", "./js/platform/fileTransfer.js");
            string outcome = await fileTransfer.InvokeAsync<string>(
                "shareOrCopy", suggested, content);
            switch (outcome)
            {
                case "shared":      Toasts.Success("Shared"); break;
                case "copied":      Toasts.Success("Copied to clipboard"); break;
                case "cancelled":   /* helm tapped cancel; no toast */ break;
                default:            Toasts.Error("Couldn't share or copy."); break;
            }
        }
        catch (JSDisconnectedException) { }
        catch (JSException ex) { Toasts.Error($"Share failed: {ex.Message}"); }
    }

    /// <summary>Strip filesystem-illegal characters from a humanly-
    /// chosen name so the browser-side download dialog doesn't reject
    /// it. Same conservative whitelist the Resources page uses for
    /// per-resource exports.</summary>
    private static string SanitiseFilename(string raw)
    {
        var sb = new System.Text.StringBuilder(raw.Length);
        foreach (var ch in raw)
        {
            if (char.IsLetterOrDigit(ch) || ch == '-' || ch == '_' || ch == ' ')
                sb.Append(ch);
            else
                sb.Append('_');
        }
        return sb.ToString().Trim();
    }

    private async Task ToggleChartAsync(OnaPlotter.Models.SignalkChart chart, ChangeEventArgs e)
    {
        bool turningOn = e.Value is bool b && b;
        var tileUrl = chart.GetTileUrl();
        if (string.IsNullOrEmpty(tileUrl)) return;
        if (turningOn)
        {
            enabledChartIds.Add(chart.Identifier);
            await AddHistoryChartLayerAsync(chart, tileUrl);
        }
        else
        {
            enabledChartIds.Remove(chart.Identifier);
            await RemoveHistoryChartLayerAsync(chart.Identifier);
        }
    }

    /// <summary>Adds a chart tile layer to <c>_historyMap</c>. We can't
    /// reuse <c>leafletInterop.js::addChartLayer</c> because that
    /// targets the Map page's global <c>map</c> variable; the History
    /// page has its own map instance under <c>_historyMap</c>. The
    /// helper below is a minimal version: bounds-clipped tile layer
    /// with the standard 0.85 opacity. No multi-chart opacity ramp,
    /// no z-index reordering -- the helm rarely stacks charts on
    /// History (one passage = one chart series), so the simpler
    /// behaviour is enough.</summary>
    private async Task AddHistoryChartLayerAsync(
        OnaPlotter.Models.SignalkChart chart, string tileUrl)
    {
        // Resolve relative tile URLs against the SK server. This
        // matches what the Map page's interop does for the same
        // chart resource. The SK base URL is whatever the running
        // page was served from -- the same origin the WebSocket
        // connects to. ISignalKBaseUrl resolves config-override or
        // falls back to the page origin.
        var resolved = tileUrl.StartsWith("http://") || tileUrl.StartsWith("https://")
            ? tileUrl
            : new Uri(new Uri(SkBaseUrl.BaseUrl + "/"), tileUrl.TrimStart('/')).ToString();
        // Bounds shape from SignalkChart: [west, south, east, north].
        // Leaflet wants [[s,w],[n,e]] so we reorder server-side.
        double[]? bounds = chart.Bounds;
        try
        {
            await JS.InvokeVoidAsync("eval", $@"
                (function() {{
                    var m = window._historyMap;
                    if (!m) return;
                    if (!window._historyChartLayers) window._historyChartLayers = {{}};
                    var id = {System.Text.Json.JsonSerializer.Serialize(chart.Identifier)};
                    if (window._historyChartLayers[id]) return;
                    var opts = {{
                        minZoom: {(chart.MinZoom ?? 1).ToString(System.Globalization.CultureInfo.InvariantCulture)},
                        maxZoom: {(chart.MaxZoom ?? 18).ToString(System.Globalization.CultureInfo.InvariantCulture)},
                        opacity: 0.85,
                        keepBuffer: 6,
                        crossOrigin: 'anonymous',
                        attribution: '',
                        errorTileUrl: ''
                    }};
                    var b = {(bounds is { Length: 4 } ? System.Text.Json.JsonSerializer.Serialize(bounds) : "null")};
                    if (b) opts.bounds = L.latLngBounds([b[1], b[0]], [b[3], b[2]]);
                    var layer = L.tileLayer({System.Text.Json.JsonSerializer.Serialize(resolved)}, opts);
                    layer.setZIndex(50);
                    layer.addTo(m);
                    window._historyChartLayers[id] = layer;
                }})()
            ");
        }
        catch (JSDisconnectedException) { }
    }

    private async Task RemoveHistoryChartLayerAsync(string id)
    {
        try
        {
            await JS.InvokeVoidAsync("eval", $@"
                (function() {{
                    var m = window._historyMap;
                    if (!m) return;
                    var bag = window._historyChartLayers;
                    if (!bag) return;
                    var id = {System.Text.Json.JsonSerializer.Serialize(id)};
                    var l = bag[id];
                    if (l) {{ m.removeLayer(l); delete bag[id]; }}
                }})()
            ");
        }
        catch (JSDisconnectedException) { }
    }

    /// <summary>Pulls the current Leaflet viewport bounds from JS and
    /// returns them as a <see cref="TrackBbox"/> padded outward by
    /// <see cref="TrackBbox.DefaultPadFraction"/>. Returns null when
    /// the map isn't ready, when JS interop fails (page teardown), or
    /// when the bounds aren't a sensible numeric quadruple. Padding
    /// the bounds avoids re-fetching every time the helm pans by a
    /// few pixels.</summary>
    private async Task<TrackBbox?> TryGetViewportBboxAsync()
    {
        try
        {
            // Returns [south, west, north, east] from Leaflet's
            // getBounds(). Defensive: if any of those isn't a finite
            // number, fall back to "no bbox" rather than send garbage.
            var raw = await JS.InvokeAsync<double[]?>("eval", $@"
                (function() {{
                    var m = window._historyMap;
                    if (!m) return null;
                    var b = m.getBounds();
                    return [b.getSouth(), b.getWest(), b.getNorth(), b.getEast()];
                }})()
            ");
            if (raw is null || raw.Length != 4) return null;
            double s = raw[0], w = raw[1], n = raw[2], e = raw[3];
            if (!double.IsFinite(s) || !double.IsFinite(w)
                || !double.IsFinite(n) || !double.IsFinite(e)) return null;
            // Padding lives on the model so a test can drive it
            // without going through the page's JS-interop code path.
            return new TrackBbox(s, w, n, e).Pad(TrackBbox.DefaultPadFraction);
        }
        catch (JSDisconnectedException) { return null; }
        catch (JSException) { return null; }
        catch (ObjectDisposedException) { return null; }
    }

    private async Task LoadTrack()
    {
        // While a fetch is in flight, the same button doubles as
        // Cancel: flag the helm-initiated path, cancel the CTS, let
        // the LoadTrackInner await throw OperationCanceledException,
        // and drop back to idle. The finally below clears state
        // regardless of which path won. Helm-initiated cancel is
        // silent; the 30 s timeout fires a toast so the helm knows
        // why their fetch stopped without their tap; a real transport
        // / server failure still surfaces through the API layer.
        if (loading)
        {
            _userInitiatedCancel = true;
            _loadCts?.Cancel();
            return;
        }
        loadAttempted = true;
        loading = true;
        _userInitiatedCancel = false;
        // New CTS per fetch -- one-shot CTS objects are simpler than
        // resetting state on a reused instance, and cheap (no
        // unmanaged handles in the cancel path here). The 30 s
        // CancelAfter is a server-stalled-out backstop: a healthy
        // signalk-parquet (or signalk-to-influxdb2) returns the full
        // window in one round-trip in well under a second on LAN, a
        // few seconds on a sat link. Anything past 30 s is the server
        // wedged or the request shape (e.g. 1 s resolution × 365 d)
        // exceeding what the provider can stream; either way the helm
        // wants to know fast rather than waiting out HttpClient's
        // 100 s default.
        var cts = new CancellationTokenSource();
        cts.CancelAfter(TimeSpan.FromSeconds(30));
        _loadCts = cts;
        StateHasChanged();
        try
        {
            await LoadTrackInner(cts.Token);
        }
        catch (OperationCanceledException) when (cts.IsCancellationRequested)
        {
            // Two paths feed this: helm tap or 30 s timeout. The
            // helm-tap path sets _userInitiatedCancel above; if that
            // flag is false, the CancelAfter expired and we owe the
            // helm a toast explaining why the fetch dropped without
            // their tap. Either way, leave the previous map / segments
            // on screen -- a half-applied fetch result wouldn't have
            // made it past the throwing await.
            if (!_userInitiatedCancel)
            {
                Toasts.Error("History fetch timed out after 30 s. Try a coarser resolution or shorter window.");
            }
        }
        finally
        {
            loading = false;
            // Defensive: if a sibling tap ran the cancel path and
            // assigned a new CTS in between, don't clobber that one.
            if (ReferenceEquals(_loadCts, cts)) _loadCts = null;
            cts.Dispose();
            StateHasChanged();
        }
    }

    private async Task LoadTrackInner(CancellationToken ct)
    {
        // Resolve the time window from the current mode. Custom mode
        // sends absolute (from, to) UTC instants -- helm-locale
        // wall-clock at this layer becomes UTC at the API boundary.
        // Preset mode sends a relative duration (timespan).
        DateTimeOffset? fromUtc = null, toUtc = null;
        string? span = selectedTimespan;
        if (rangeMode == "custom")
        {
            // Guard against an inverted range (start > end). Snap by
            // swapping rather than refusing, since the helm probably
            // just edited the inputs in the wrong order and a silent
            // swap is friendlier than an error toast.
            var (lo, hi) = customFromLocal <= customToLocal
                ? (customFromLocal, customToLocal)
                : (customToLocal, customFromLocal);
            fromUtc = new DateTimeOffset(lo.ToUniversalTime(), TimeSpan.Zero);
            toUtc = new DateTimeOffset(hi.ToUniversalTime(), TimeSpan.Zero);
            span = null;     // ignored when from is supplied; explicit for clarity
        }

        // Optional bbox hint from the current viewport, oversized 20 %
        // outward so a small pan doesn't trigger a re-fetch. The
        // server may or may not honour the bbox; signalk-parquet does,
        // others ignore unknown query params and we fall back to
        // time-only filtering. Skipped when the map isn't ready yet
        // or the bounds call fails.
        TrackBbox? bbox = await TryGetViewportBboxAsync();

        // Rich fetch: timestamps + sog + wind in one round-trip.
        // Segmenter splits into stationary/moving runs which JS
        // renders with distinct styling + per-segment hover tooltips.
        // CT lets the helm cancel a slow sat-link fetch via the
        // Loading…/Cancel button.
        points = await TrackApi.GetServerTrackPointsAsync(
            from: fromUtc, to: toUtc, timespan: span,
            resolution: resolution, bbox: bbox, ct: ct);
        segments = points is { Length: > 0 } ? TrackSegmenter.Segment(points) : null;
        playbackIndex = 0;
        playing = false;
        playTimer?.Dispose();
        playTimer = null;

        if (points is { Length: > 0 } && segments is { Length: > 0 })
        {
            await RenderMapSegmentsAsync(fitBounds: true);
        }
        await DrawBoatMarker();
        StateHasChanged();
    }

    /// <summary>Re-render the cached points + segments onto the map
    /// without re-fetching. Called from <see cref="LoadTrack"/> after
    /// a fresh fetch (with <paramref name="fitBounds"/> true so the
    /// viewport snaps to the loaded data) and from
    /// <see cref="RerenderMapSegmentsAsync"/> when the helm flips the
    /// stationary-as-dot toggle (without fitBounds so the helm's
    /// chosen pan / zoom survives the re-render).</summary>
    private async Task RenderMapSegmentsAsync(bool fitBounds)
    {
        if (points is null || points.Length == 0
            || segments is null || segments.Length == 0) return;

        // Build per-segment payloads in C#. Each entry carries the
        // segment's [lat, lon] coordinate list (sliced from the
        // chronological points by timestamp window) plus a
        // pre-formatted tooltip body. Formatting in C# keeps the
        // JS dumb (just pass strings through to Leaflet's
        // bindTooltip) and matches the project's preference for
        // C# over JS for anything past pure rendering.
        var segPayload = HistorySegmentRender.BuildSegmentPayload(points, segments);
        // Playback marker only needs (lat, lon). Pass a flat array
        // so MoveMarker doesn't have to thread the rich record
        // shape through JSON every scrub.
        var coords = points.Select(p => new[] { p.Latitude, p.Longitude }).ToArray();

        // Bool flags interpolated as JS literals (not JSON-serialised)
        // so the eval template stays readable without the
        // {System.Text.Json.JsonSerializer.Serialize(...)} ceremony.
        string statAsDotJs = mapStationaryAsDot ? "true" : "false";
        string fitBoundsJs = fitBounds ? "true" : "false";

        try
        {
            await JS.InvokeVoidAsync("eval", $@"
                (function() {{
                    var m = window._historyMap;
                    if (!m) return;
                    if (window._historySegments) {{
                        window._historySegments.forEach(function(l) {{ m.removeLayer(l); }});
                    }}
                    window._historySegments = [];

                    // Property names follow C# PascalCase since the
                    // segPayload record is serialised with default
                    // System.Text.Json options (no naming policy). Reads
                    // below use s.Coords / s.IsStationary / s.Tooltip
                    // accordingly. A previous version read s.coords and
                    // crashed at L.polyline(undefined, ...) on every
                    // History mount.
                    var segs = {System.Text.Json.JsonSerializer.Serialize(segPayload)};
                    var statAsDot = {statAsDotJs};
                    var movingBaseColor = getComputedStyle(document.documentElement)
                        .getPropertyValue('--map-own').trim() || '#ec4899';
                    // Pull the dedicated --map-stationary token. The
                    // previous code used --sk-text-muted (slate-grey
                    // body-copy ink) which on the light-theme OSM
                    // basemap was effectively invisible against the
                    // slate-blue water tiles. The new token has a
                    // theme-specific value designed for legibility on
                    // both dark and light water.
                    var stationaryColor = getComputedStyle(document.documentElement)
                        .getPropertyValue('--map-stationary').trim() || '#94a3b8';

                    // Trip palette: cycles through 8 distinct hues so
                    // consecutive moving segments are visually
                    // distinguishable on the map (helm wants to pick
                    // out the Tuesday passage from the Wednesday one
                    // without checking the tooltip). The first slot
                    // is the live-track magenta so a one-trip view
                    // keeps the colour the helm has built muscle
                    // memory for. Stationary always uses the neutral
                    // stationary token regardless of trip index.
                    var palette = [
                        movingBaseColor,
                        '#a78bfa', '#fbbf24', '#34d399',
                        '#60a5fa', '#f87171', '#22d3ee', '#fb923c'
                    ];

                    var bounds = null;
                    var movingCount = 0;
                    var ref_ = window._historyDotNet;
                    segs.forEach(function(s, idx) {{
                        var leafletObj;
                        if (s.IsStationary) {{
                            // Stationary rendering branches on the
                            // helm's preference. Dot mode: a single
                            // circleMarker at the segment's centroid
                            // (middle index of the coord list, the
                            // typical anchorage centre). Track mode:
                            // the legacy dashed grey polyline.
                            if (statAsDot) {{
                                var mid = s.Coords[Math.floor(s.Coords.length / 2)] || s.Coords[0];
                                leafletObj = L.circleMarker(mid, {{
                                    radius: 5,
                                    color: stationaryColor, fillColor: stationaryColor,
                                    fillOpacity: 0.6, weight: 1
                                }}).bindTooltip(s.Tooltip, {{ sticky: true, direction: 'top' }})
                                  .addTo(m);
                                if (!bounds) bounds = L.latLngBounds(mid, mid);
                                else bounds.extend(mid);
                            }} else {{
                                var statStyle = {{
                                    color: stationaryColor, weight: 2.5,
                                    opacity: 0.55, dashArray: '4 4',
                                    lineJoin: 'round', lineCap: 'round'
                                }};
                                leafletObj = L.polyline(s.Coords, statStyle)
                                    .bindTooltip(s.Tooltip, {{ sticky: true, direction: 'top' }})
                                    .addTo(m);
                                var b = leafletObj.getBounds();
                                bounds = bounds ? bounds.extend(b) : b;
                            }}
                        }} else {{
                            // Moving segments cycle through the
                            // palette. movingCount counts only moving
                            // segments so palette[0] always lands on
                            // the FIRST trip regardless of how many
                            // stationary segments precede it.
                            var color = palette[movingCount % palette.length];
                            movingCount++;
                            var moveStyle = {{
                                color: color, weight: 3.5, opacity: 0.9,
                                lineJoin: 'round', lineCap: 'round'
                            }};
                            leafletObj = L.polyline(s.Coords, moveStyle)
                                .bindTooltip(s.Tooltip, {{ sticky: true, direction: 'top' }})
                                .addTo(m);
                            var b = leafletObj.getBounds();
                            bounds = bounds ? bounds.extend(b) : b;
                        }}

                        // Click on a polyline / dot opens the trip
                        // detail panel for that segment, mirroring
                        // the table row click. stopPropagation so
                        // the map's own click handler (dismiss
                        // context menu) doesn't also fire. Wrapped
                        // in catch(noop) for the page-teardown race
                        // where dotNetRef has been disposed but a
                        // stale click event lands.
                        leafletObj.on('click', function(ev) {{
                            L.DomEvent.stopPropagation(ev);
                            if (ref_) {{
                                ref_.invokeMethodAsync('OpenTripDetailFromMap', idx)
                                    .catch(function() {{}});
                            }}
                        }});
                        window._historySegments.push(leafletObj);
                    }});
                    if ({fitBoundsJs} && bounds) m.fitBounds(bounds, {{ padding: [40, 40] }});

                    if (window._historyMarker) m.removeLayer(window._historyMarker);
                    var coords = {System.Text.Json.JsonSerializer.Serialize(coords)};
                    // Playback marker pulls --map-playback so a future
                    // palette tweak doesn't leave a frozen amber here.
                    var playbackCol = getComputedStyle(document.documentElement)
                        .getPropertyValue('--map-playback').trim() || '#fbbf24';
                    window._historyMarker = L.circleMarker(coords[0], {{
                        radius: 8, color: playbackCol, fillColor: playbackCol, fillOpacity: 1, weight: 2
                    }}).bindTooltip('Playback').addTo(m);
                    // Stash the flat coords for the scrub path so
                    // MoveMarker stays a one-liner.
                    window._historyCoords = coords;
                }})()
            ");
        }
        catch (JSDisconnectedException) { /* page teardown race */ }
    }

    /// <summary>Bound to the "Stationary as dot" checkbox via
    /// <c>@bind:after</c> so flipping the toggle re-renders the
    /// cached segments without a fresh API fetch. Cheap because
    /// every per-segment polyline / dot is rebuilt from the same
    /// coord arrays we already have in memory.</summary>
    private async Task RerenderMapSegmentsAsync()
    {
        await RenderMapSegmentsAsync(fitBounds: false);
    }

    /// <summary>Map-side polyline / dot click handler. Mirrors the
    /// table-row click: opens the trip detail panel for the segment
    /// the helm picked. Index is into the FULL <c>segments</c> array
    /// (matches the order JS got via <c>BuildSegmentPayload</c>) so
    /// stationary toggle changes don't shift the indexing.</summary>
    [JSInvokable]
    public async Task OpenTripDetailFromMap(int idx)
    {
        if (segments is null || idx < 0 || idx >= segments.Length) return;
        tripDetailIdx = idx;
        await InvokeAsync(StateHasChanged);
    }

    // Segment-payload + tooltip formatting moved to
    // OnaPlotter.Utilities.HistorySegmentRender so the pure-function
    // logic can be unit-tested without standing up the Razor page.

    private async Task OnScrub(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int idx))
        {
            playbackIndex = idx;
            await MoveMarker();
        }
    }

    private int playbackPeriodMs = 200;   // default 1x

    /// <summary>Map the dropdown's speed multiplier (0.5x, 1x, 2x,
    /// 5x, 10x) to a timer interval. 1x = 200 ms per step (5 steps
    /// per second). Faster multipliers shorten the period; slower
    /// ones lengthen it. Clamped to [20, 1000] ms so an arbitrary
    /// dropdown value can't starve the renderer (20 ms = 50 fps,
    /// 1000 ms = 1 fps -- below that the helm thinks the playback
    /// has stuck).</summary>
    private void OnSpeedChanged(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(),
                            System.Globalization.NumberStyles.Float,
                            CultureInfo.InvariantCulture,
                            out double mult)
            && mult > 0)
        {
            int period = (int)Math.Round(200.0 / mult);
            playbackPeriodMs = Math.Clamp(period, 20, 1000);
            if (playing)
            {
                // Re-arm timer at the new cadence.
                playTimer?.Dispose();
                playTimer = NewPlayTimer();
            }
        }
    }

    private System.Threading.Timer NewPlayTimer() =>
        new(async _ =>
        {
            if (!playing || points is null) return;
            playbackIndex = Math.Min(playbackIndex + 1, points.Length - 1);
            if (playbackIndex >= points.Length - 1) playing = false;
            await MoveMarker();
            try { await InvokeAsync(StateHasChanged); }
            catch (ObjectDisposedException) { }
        }, null, 0, playbackPeriodMs);

    private void PlayPause()
    {
        playing = !playing;
        if (playing)
        {
            playTimer = NewPlayTimer();
        }
        else
        {
            playTimer?.Dispose();
            playTimer = null;
        }
    }

    private void StepBy(int delta)
    {
        if (points is null || points.Length == 0) return;
        playbackIndex = Math.Clamp(playbackIndex + delta, 0, points.Length - 1);
        _ = MoveMarker();
    }

    private async Task MoveMarker()
    {
        if (points is null || points.Length == 0) return;
        if (playbackIndex < 0 || playbackIndex >= points.Length) return;
        var pt = points[playbackIndex];
        try
        {
            // Use invariant culture on the coordinate doubles -- the
            // helm's locale (e.g. de-CH) would otherwise render the
            // decimal as a comma and Leaflet would parse 47,4 as
            // [47, 4] silently. Matches the JSON-serialised format
            // used by LoadTrack's per-segment payload.
            string lat = pt.Latitude.ToString(CultureInfo.InvariantCulture);
            string lon = pt.Longitude.ToString(CultureInfo.InvariantCulture);
            await JS.InvokeVoidAsync("eval", $@"
                (function() {{
                    var m = window._historyMap;
                    if (!m || !window._historyMarker) return;
                    window._historyMarker.setLatLng([{lat}, {lon}]);
                }})()
            ");
        }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
    }

    /// <summary>JS-invoked callback wired to Leaflet's moveend +
    /// zoomend events. Refreshes the cached viewport bounds and
    /// re-renders so the chart-picker's bbox filter shows the
    /// charts that actually cover the map area in front of the
    /// helm. Cheap; doesn't refetch chart metadata.</summary>
    [JSInvokable]
    public async Task OnHistoryViewportChanged()
    {
        await RefreshViewportBoundsAsync();
        // Only fire StateHasChanged when the chart panel is actually
        // visible -- otherwise every pan would re-render the page
        // for no UX win.
        if (chartsPanelOpen) StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        // Persist the helm's last-seen inputs so the next visit
        // restores the same window + view. Catches a helm who
        // tweaked the range and navigated away without tapping
        // Load -- the new range survives.
        SaveToState();
        playing = false;
        // Abort any in-flight LoadTrack so the API call doesn't
        // continue past the page being torn down (would StateHasChanged
        // on a disposed component and surface as a noisy log line).
        try { _loadCts?.Cancel(); _loadCts?.Dispose(); _loadCts = null; }
        catch (ObjectDisposedException) { /* already disposed */ }
        if (playTimer is not null) await playTimer.DisposeAsync();
        try
        {
            await JS.InvokeVoidAsync("eval",
                "if(window._historyMap){window._historyMap.remove();window._historyMap=null;}"
                + "window._historyDotNet=null;");
        }
        // Narrow to disconnect / interop errors so a future regression
        // in the eval string (typo, leaked promise rejection, Leaflet
        // teardown bug) propagates to the global boundary instead of
        // being silenced under a long passage's heap leak.
        catch (Microsoft.JSInterop.JSDisconnectedException) { }
        catch (Microsoft.JSInterop.JSException) { }
        catch (TaskCanceledException) { }
        _historyDotNet?.Dispose();
        if (module is not null) await module.DisposeAsync();
    }
}
