@* Chartplotter: live map with HUD instruments, AIS targets, MOB, anchor watch. *@

@page "/map"
@using OnaPlotter.Services
@using OnaPlotter.Models
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject SignalkClient SignalkClient
@inject TrackBuffer TrackBuffer
@inject AisStore AisStore
@inject ChartService ChartService
@inject IJSRuntime JS

<PageTitle>Map</PageTitle>

<div class="map-container @(nightMode ? "night-mode" : "") @(fullscreen ? "map-fullscreen" : "")"
     @onfullscreenchange="OnFullscreenChange">
    <div id="mapDiv"></div>

    @* === HUD: Top-Left — Speed, Course & Position === *@
    <div class="hud hud-top-left">
        <div class="hud-panel">
            <div class="hud-label">SOG</div>
            <div class="hud-value">@FormatKnots(Data.SpeedOverGround)<span class="hud-unit">kn</span></div>
            <div class="hud-label" style="margin-top:4px;">COG</div>
            <div class="hud-value">@FormatDeg(Data.CourseOverGround)<span class="hud-unit">&deg;</span></div>
            <div class="hud-position">@NauticalFormat.FormatPosition(Data.Latitude, Data.Longitude)</div>
        </div>
    </div>

    @* === HUD: Top-Right — Wind === *@
    <div class="hud hud-top-right">
        <div class="hud-panel" style="text-align:center;">
            <div class="hud-label">AWA / AWS</div>
            @if (Data.WindSpeedApparent is not null)
            {
                <svg width="48" height="48" viewBox="-24 -24 48 48" class="wind-arrow"
                     style="transform: rotate(@WindAngleDegStr);" role="img" aria-label="Apparent wind">
                    <circle cx="0" cy="0" r="22" fill="none" stroke="rgba(255,255,255,0.15)" stroke-width="1"/>
                    <polygon points="0,-20 4,-8 0,-12 -4,-8" fill="#3b82f6" stroke="none"/>
                </svg>
                <div class="hud-value" style="font-size:1.1rem;">@FormatKnots(Data.WindSpeedApparent)<span class="hud-unit">kn</span></div>
            }
            else
            {
                <div style="color: rgba(255,255,255,0.25); font-size:0.8rem; padding: 4px 0;">--</div>
            }
            @if (Data.WindSpeedTrue is not null)
            {
                <div style="margin-top:4px; border-top:1px solid rgba(255,255,255,0.1); padding-top:4px;">
                    <div class="hud-label">TWA / TWS</div>
                    <svg width="36" height="36" viewBox="-18 -18 36 36" class="wind-arrow"
                         style="transform: rotate(@TrueWindAngleDegStr);" role="img" aria-label="True wind">
                        <circle cx="0" cy="0" r="16" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="1"/>
                        <polygon points="0,-14 3,-6 0,-9 -3,-6" fill="#22c55e" stroke="none"/>
                    </svg>
                    <div class="hud-value" style="font-size:1rem;">@FormatKnots(Data.WindSpeedTrue)<span class="hud-unit">kn</span></div>
                </div>
            }
        </div>
    </div>

    @* === HUD: Bottom-Left — Depth === *@
    <div class="hud hud-bottom-left">
        <div class="hud-panel">
            <div class="hud-label">Depth</div>
            <div class="hud-value @DepthClass">@FormatDepth(Data.Depth)<span class="hud-unit">m</span></div>
        </div>
    </div>

    @* === HUD: Bottom-Right — Heading Compass === *@
    <div class="hud hud-bottom-right">
        <div class="hud-panel" style="text-align:center;">
            <div class="hud-label">HDG</div>
            <svg width="52" height="52" viewBox="-26 -26 52 52">
                <circle cx="0" cy="0" r="24" fill="none" stroke="rgba(255,255,255,0.15)" stroke-width="1"/>
                @SvgTextMarkup(0, -18, "N", "rgba(255,255,255,0.5)", 7)
                @SvgTextMarkup(18, 0, "E", "rgba(255,255,255,0.3)", 7)
                @SvgTextMarkup(0, 19, "S", "rgba(255,255,255,0.3)", 7)
                @SvgTextMarkup(-18, 0, "W", "rgba(255,255,255,0.3)", 7)
                <line x1="0" y1="0" x2="@HeadingX" y2="@HeadingY"
                      stroke="#3b82f6" stroke-width="2" stroke-linecap="round"
                      class="compass-rose" />
                <circle cx="0" cy="0" r="2.5" fill="#3b82f6"/>
            </svg>
            <div class="hud-value" style="font-size:1.1rem;">@FormatDeg(Data.Heading)<span class="hud-unit">&deg;</span></div>
        </div>
    </div>

    @* === HUD: Route Info (only visible when an active course exists) === *@
    @if (Data.HasActiveCourse)
    {
        <div class="hud hud-route">
            <div class="hud-panel route-panel">
                <div class="hud-label">
                    @(Data.ActiveRouteName ?? "Active Route")
                </div>
                <div class="route-info-grid">
                    <div>
                        <div class="hud-label">DTW</div>
                        <div class="hud-value route-value">@FormatNm(Data.CourseNextPointDistance)<span class="hud-unit">nm</span></div>
                    </div>
                    <div>
                        <div class="hud-label">BRG</div>
                        <div class="hud-value route-value">@FormatDeg(Data.CourseNextPointBearing)<span class="hud-unit">&deg;</span></div>
                    </div>
                    @if (Data.CourseNextPointVmg is not null)
                    {
                        <div>
                            <div class="hud-label">VMG</div>
                            <div class="hud-value route-value">@FormatKnots(Data.CourseNextPointVmg)<span class="hud-unit">kn</span></div>
                        </div>
                    }
                    @if (Data.CourseNextPointTimeToGo is not null)
                    {
                        <div>
                            <div class="hud-label">TTG</div>
                            <div class="hud-value route-value">@FormatTimeToGo(Data.CourseNextPointTimeToGo)</div>
                        </div>
                        <div>
                            <div class="hud-label">ETA</div>
                            <div class="hud-value route-value">@FormatEta(Data.CourseNextPointTimeToGo)</div>
                        </div>
                    }
                    @if (Data.CrossTrackError is not null)
                    {
                        <div>
                            <div class="hud-label">XTE</div>
                            <div class="hud-value route-value @XteClass">@FormatXte(Data.CrossTrackError)<span class="hud-unit">@XteSideLabel</span></div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    @* === HUD: Anchor Info (when server-side anchor alarm is active) === *@
    @if (Data.AnchorActive)
    {
        <div class="hud hud-anchor">
            <div class="hud-panel anchor-panel @AnchorAlarmClass">
                <div class="hud-label">Anchor Watch</div>
                <div class="anchor-info-row">
                    <div>
                        <div class="hud-label">Dist</div>
                        <div class="hud-value route-value @AnchorDistClass">@FormatMeters(Data.AnchorCurrentRadius)</div>
                    </div>
                    @if (Data.AnchorMaxRadius is not null)
                    {
                        <div>
                            <div class="hud-label">Radius</div>
                            <div class="hud-value route-value">@FormatMeters(Data.AnchorMaxRadius)</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    @* === HUD: Autopilot Panel === *@
    @if (Data.AutopilotState is not null)
    {
        <div class="hud hud-autopilot">
            <div class="hud-panel autopilot-panel @(Data.AutopilotState != "standby" ? "ap-engaged" : "")">
                <div class="hud-label">Autopilot</div>
                <div class="ap-state">@(Data.AutopilotState?.ToUpperInvariant() ?? "--")</div>
                @if (Data.AutopilotTargetHeading is not null)
                {
                    <div class="hud-value route-value" style="font-size:1.1rem;">
                        @FormatDeg(Data.AutopilotTargetHeading)<span class="hud-unit">&deg;</span>
                    </div>
                }
                <div class="ap-controls">
                    <button class="ap-btn" @onclick='() => ChartService.AdjustAutopilotHeadingAsync(-10)'>-10</button>
                    <button class="ap-btn" @onclick='() => ChartService.AdjustAutopilotHeadingAsync(-1)'>-1</button>
                    <button class="ap-btn" @onclick='() => ChartService.AdjustAutopilotHeadingAsync(1)'>+1</button>
                    <button class="ap-btn" @onclick='() => ChartService.AdjustAutopilotHeadingAsync(10)'>+10</button>
                </div>
                <div class="ap-modes">
                    <button class="ap-mode-btn @(Data.AutopilotState == "standby" ? "active" : "")"
                            @onclick='() => ChartService.SetAutopilotStateAsync("standby")'>Stby</button>
                    <button class="ap-mode-btn @(Data.AutopilotState == "auto" ? "active" : "")"
                            @onclick='() => ChartService.SetAutopilotStateAsync("auto")'>Auto</button>
                    <button class="ap-mode-btn @(Data.AutopilotState == "wind" ? "active" : "")"
                            @onclick='() => ChartService.SetAutopilotStateAsync("wind")'>Wind</button>
                    <button class="ap-mode-btn @(Data.AutopilotState == "route" ? "active" : "")"
                            @onclick='() => ChartService.SetAutopilotStateAsync("route")'>Route</button>
                </div>
            </div>
        </div>
    }

    @* === Control Bar === *@
    <div class="map-controls">
        <button class="map-btn @(follow ? "active" : "")" @onclick="ToggleFollow" title="Keyboard: F">
            @(follow ? "Following" : "Follow")
        </button>
        <button class="map-btn" @onclick="CycleMapOrientation" title="Keyboard: O">
            @mapOrientationLabel
        </button>
        <button class="map-btn @(nightMode ? "active" : "")" @onclick="ToggleNightMode" title="Keyboard: N">
            Night
        </button>
        <button class="map-btn @(AnchorButtonActive ? "active" : "")" @onclick="ToggleAnchor" title="Keyboard: A">
            @(AnchorButtonActive ? "Anchored" : "Anchor")
        </button>
        <button class="map-btn mob-btn @(mobActive ? "active" : "")" @onclick="ToggleMob" title="Keyboard: M">
            MOB
        </button>
        <button class="map-btn" @onclick="ZoomToTrack" title="Keyboard: T">Fit Track</button>
        <button class="map-btn" @onclick="ToggleFullscreen" title="Keyboard: Escape to exit">
            @(fullscreen ? "Exit" : "Fullscreen")
        </button>
        <button class="map-btn @(laylinesVisible ? "active" : "")" @onclick="ToggleLaylines" title="Keyboard: L">
            Laylines
        </button>
        @if (!routeEditMode)
        {
            <button class="map-btn" @onclick="StartRouteEdit">New Route</button>
        }
        <button class="map-btn @(chartPanelOpen ? "active" : "")" @onclick="() => chartPanelOpen = !chartPanelOpen">
            Layers
        </button>
    </div>

    @* === Route Editing Bar === *@
    @if (routeEditMode)
    {
        <div class="route-edit-bar">
            <input type="text" class="route-name-input" placeholder="Route name..."
                   @bind="routeEditName" @bind:event="oninput" />
            <button class="map-btn active" @onclick="SaveRoute">Save</button>
            <button class="map-btn" @onclick="CancelRouteEdit">Cancel</button>
        </div>
    }

    @* === Context Menu (right-click) === *@
    @if (contextMenuVisible)
    {
        <div class="map-context-menu" style="left:@(contextMenuX)px; top:@(contextMenuY)px;">
            <button class="ctx-menu-item" @onclick="CreateWaypointHere">Create Waypoint</button>
            <button class="ctx-menu-item" @onclick="NavigateHere">Navigate Here</button>
            @if (Data.HasActiveCourse)
            {
                <button class="ctx-menu-item ctx-menu-danger" @onclick="StopNavigation">Stop Navigation</button>
            }
        </div>
    }

    @* === Waypoint Name Dialog === *@
    @if (waypointDialogVisible)
    {
        <div class="waypoint-dialog">
            <div class="hud-label" style="margin-bottom:8px;">Create Waypoint</div>
            <input type="text" class="route-name-input" placeholder="Waypoint name..."
                   @bind="newWaypointName" @bind:event="oninput" />
            <div style="display:flex; gap:6px; margin-top:8px;">
                <button class="map-btn active" @onclick="SaveWaypoint">Save</button>
                <button class="map-btn" @onclick="() => waypointDialogVisible = false">Cancel</button>
            </div>
        </div>
    }

    @* === Layers Panel === *@
    @if (chartPanelOpen)
    {
        <div class="chart-panel">
            @if (availableCharts.Count + availableRoutes.Count > 6)
            {
                <input type="text" class="layer-search" placeholder="Filter..."
                       @oninput="OnLayerFilterInput" />
            }

            @if (FilteredCharts.Length > 0)
            {
                <div class="chart-panel-header section-toggle" @onclick="() => chartsExpanded = !chartsExpanded">
                    <span class="toggle-arrow">@(chartsExpanded ? "v" : ">")</span>
                    Charts <span class="section-count">@FilteredCharts.Length</span>
                </div>
                @if (chartsExpanded)
                {
                    @foreach (var chart in FilteredCharts)
                    {
                        <label class="chart-item">
                            <input type="checkbox" checked="@enabledCharts.Contains(chart.Identifier)"
                                   @onchange="(e) => ToggleChart(chart, (bool)(e.Value ?? false))" />
                            <div class="chart-item-body">
                                <div class="chart-name">@chart.Name</div>
                                @if (chart.Description is not null)
                                {
                                    <div class="chart-desc">@chart.Description</div>
                                }
                                @if (chart.MinZoom is not null || chart.MaxZoom is not null)
                                {
                                    <div class="chart-desc">z@(chart.MinZoom ?? 1)-@(chart.MaxZoom ?? 18)</div>
                                }
                            </div>
                        </label>
                    }
                }
            }

            @if (FilteredRoutes.Length > 0)
            {
                <div class="chart-panel-header section-toggle" @onclick="() => routesExpanded = !routesExpanded">
                    <span class="toggle-arrow">@(routesExpanded ? "v" : ">")</span>
                    Routes <span class="section-count">@FilteredRoutes.Length</span>
                </div>
                @if (routesExpanded)
                {
                    @foreach (var route in FilteredRoutes)
                    {
                        <label class="chart-item">
                            <input type="checkbox" checked="@enabledRoutes.Contains(route.Id)"
                                   @onchange="(e) => ToggleRoute(route, (bool)(e.Value ?? false))" />
                            <div class="chart-item-body">
                                <div class="chart-name">@(route.Name ?? route.Id[..8])</div>
                                @if (route.Distance is not null)
                                {
                                    <div class="chart-desc">@((route.Distance.Value / 1852).ToString("F1")) nm</div>
                                }
                            </div>
                        </label>
                    }
                }
            }

            @if (loadedWaypoints.Count > 0)
            {
                <div class="chart-panel-header section-toggle" @onclick="() => waypointsExpanded = !waypointsExpanded">
                    <span class="toggle-arrow">@(waypointsExpanded ? "v" : ">")</span>
                    Waypoints <span class="section-count">@loadedWaypoints.Count</span>
                </div>
                @if (waypointsExpanded)
                {
                    @foreach (var wp in loadedWaypoints)
                    {
                        <div class="chart-item" style="display:flex; justify-content:space-between; align-items:center;">
                            <div class="chart-item-body">
                                <div class="chart-name">@(wp.Name ?? wp.Id[..8])</div>
                            </div>
                            <button class="map-btn" style="font-size:0.65rem; padding:2px 8px; min-width:0;"
                                    @onclick="() => NavigateToWaypoint(wp)">Go</button>
                        </div>
                    }
                }
            }

            <div class="chart-panel-header section-toggle" @onclick="() => trackExpanded = !trackExpanded">
                <span class="toggle-arrow">@(trackExpanded ? "v" : ">")</span>
                Track History
            </div>
            @if (trackExpanded)
            {
                <label class="chart-item">
                    <input type="checkbox" checked="@serverTrackVisible"
                           @onchange="ToggleServerTrack" />
                    <div class="chart-item-body">
                        <div class="chart-name">Server Track (24h)</div>
                        <div class="chart-desc">Position history from SignalK</div>
                    </div>
                </label>
            }

            <div class="chart-panel-header section-toggle" @onclick="() => weatherExpanded = !weatherExpanded">
                <span class="toggle-arrow">@(weatherExpanded ? "v" : ">")</span>
                Weather Overlay
            </div>
            @if (weatherExpanded)
            {
                <label class="chart-item">
                    <input type="checkbox" checked="@weatherOverlayVisible"
                           @onchange="ToggleWeatherOverlay" />
                    <div class="chart-item-body">
                        <div class="chart-name">Wind Speed (OWM)</div>
                        <div class="chart-desc">OpenWeatherMap wind overlay</div>
                    </div>
                </label>
            }

            <div class="chart-panel-header" style="margin-top:8px; border-top:1px solid var(--sk-border); padding-top:8px;">
                <div style="display:flex; gap:6px;">
                    <label class="map-btn" style="font-size:0.7rem; cursor:pointer; padding:3px 8px;">
                        Import GPX
                        <InputFile OnChange="HandleGpxImport" Accept=".gpx" style="display:none;" />
                    </label>
                    <button class="map-btn" style="font-size:0.7rem; padding:3px 8px;" @onclick="ExportGpx">
                        Export GPX
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private IJSObjectReference? module;
    private DotNetObjectReference<Map>? dotNetRef;
    private bool follow = true;
    private bool nightMode;
    private bool mobActive;
    private bool anchorManualActive;
    private bool mapInitialized;
    private bool chartPanelOpen;
    private bool fullscreen;
    private double? prevLat, prevLon;
    private System.Threading.Timer? aisTimer;
    // Active route navigation state.
    private string? lastActiveRouteHref;
    private double[][]? activeRouteCoords;
    private bool courseLineDrawn;
    private double? lastNextWpLat, lastNextWpLon;
    private bool laylinesVisible;
    private int laylinesSkip;  // Throttle: update laylines every 5th position fix.
    private string mapOrientation = "north"; // "north", "course", "head"
    private string mapOrientationLabel = "N-Up";
    // Route editing state.
    private bool routeEditMode;
    private string routeEditName = "";
    // Context menu and waypoint state.
    private bool contextMenuVisible;
    private double contextMenuLat, contextMenuLon;
    private double contextMenuX, contextMenuY;
    private bool waypointDialogVisible;
    private string newWaypointName = "";
    private List<SignalkWaypoint> loadedWaypoints = [];
    private bool waypointsExpanded = true;
    private bool weatherExpanded;
    private bool weatherOverlayVisible;
    private List<SignalkChart> availableCharts = [];
    private List<SignalkRoute> availableRoutes = [];
    private readonly HashSet<string> enabledCharts = [];
    private readonly HashSet<string> enabledRoutes = [];
    private bool serverTrackVisible;
    private bool chartsExpanded = true;
    private bool routesExpanded = true;
    private bool trackExpanded = true;
    private string layerFilter = "";
    private double? viewWest, viewSouth, viewEast, viewNorth;

    // Cached filtered lists, rebuilt only when inputs change.
    private SignalkChart[] cachedFilteredCharts = [];
    private SignalkRoute[] cachedFilteredRoutes = [];
    private string lastFilterKey = "";

    private SignalkChart[] FilteredCharts => cachedFilteredCharts;
    private SignalkRoute[] FilteredRoutes => cachedFilteredRoutes;

    // Pre-computed route bounding boxes (avoids re-parsing GeoJSON on every filter).
    private readonly Dictionary<string, (double MinLat, double MaxLat, double MinLon, double MaxLon)?> routeBounds = [];

    private void OnLayerFilterInput(ChangeEventArgs e)
    {
        layerFilter = e.Value?.ToString() ?? "";
        RebuildFilteredLayers();
    }

    private void RebuildFilteredLayers()
    {
        // Build a cache key from the inputs that affect filtering.
        var key = $"{layerFilter}|{viewWest:F4}|{viewSouth:F4}|{viewEast:F4}|{viewNorth:F4}|{availableCharts.Count}|{availableRoutes.Count}";
        if (key == lastFilterKey) return;
        lastFilterKey = key;

        cachedFilteredCharts = availableCharts
            .Where(c => (string.IsNullOrEmpty(layerFilter) || c.Name.Contains(layerFilter, StringComparison.OrdinalIgnoreCase))
                     && ChartIntersectsViewport(c))
            .ToArray();

        cachedFilteredRoutes = availableRoutes
            .Where(r => (string.IsNullOrEmpty(layerFilter) || (r.Name ?? r.Id).Contains(layerFilter, StringComparison.OrdinalIgnoreCase))
                     && RouteIntersectsViewport(r))
            .ToArray();
    }

    private const double MsToKnots = 1.94384;
    private const double RadToDeg = 180.0 / Math.PI;

    private NavigationData Data => SignalkClient.Data;

    // Heading compass needle endpoint. Sticky: keeps last known heading if data drops.
    private double? lastHeading;
    private double HeadingRad
    {
        get
        {
            if (Data.Heading is not null) lastHeading = Data.Heading;
            return lastHeading ?? 0;
        }
    }
    private string HeadingX => (Math.Sin(HeadingRad) * 16).ToString("F1");
    private string HeadingY => (-Math.Cos(HeadingRad) * 16).ToString("F1");

    // Wind arrow rotation.
    private string WindAngleDegStr =>
        Data.WindAngleApparent is not null
            ? $"{(Data.WindAngleApparent.Value * RadToDeg):F0}deg"
            : "0deg";

    private string TrueWindAngleDegStr =>
        Data.WindAngleTrue is not null
            ? $"{(Data.WindAngleTrue.Value * RadToDeg):F0}deg"
            : "0deg";

    // Depth warning class.
    private string DepthClass => Data.Depth switch
    {
        null => "",
        < 3 => "depth-danger",
        < 8 => "depth-warn",
        _ => "depth-ok"
    };

    // Anchor state: server anchor takes priority over manual.
    private bool AnchorButtonActive => Data.AnchorActive || anchorManualActive;

    // Anchor alarm: red when current radius exceeds max radius.
    private bool AnchorDragging => Data.AnchorActive
        && Data.AnchorCurrentRadius is not null
        && Data.AnchorMaxRadius is not null
        && Data.AnchorCurrentRadius > Data.AnchorMaxRadius;

    private string AnchorAlarmClass => AnchorDragging ? "anchor-alarm" : "";
    private string AnchorDistClass => AnchorDragging ? "depth-danger"
        : Data.AnchorCurrentRadius is not null ? "depth-ok" : "";

    // Track whether we've already drawn the server anchor on the map.
    private bool serverAnchorDrawn;
    private double lastPushedAnchorRadius;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/leafletInterop.js");
        dotNetRef = DotNetObjectReference.Create(this);

        double lat = Data.Latitude ?? 0;
        double lon = Data.Longitude ?? 0;
        int zoom = Data.Latitude is not null ? 14 : 3;

        await module.InvokeVoidAsync("initMap", "mapDiv", lat, lon, zoom, dotNetRef);
        mapInitialized = true;

        // Load existing track as speed-colored segments.
        var points = TrackBuffer.GetSnapshot();
        if (points.Length > 0)
        {
            var jsPoints = points.Select(p => new[] { p.Latitude, p.Longitude, p.SpeedOverGround ?? 0 }).ToArray();
            await module.InvokeVoidAsync("setColoredTrack", (object)jsPoints);
            prevLat = points[^1].Latitude;
            prevLon = points[^1].Longitude;
        }

        // Load available charts and routes from SignalK server.
        availableCharts = await ChartService.GetChartsAsync();
        availableRoutes = await ChartService.GetRoutesAsync();
        loadedWaypoints = await ChartService.GetWaypointsAsync();
        PrecomputeRouteBounds();
        RebuildFilteredLayers();
        StateHasChanged();

        // Draw waypoint markers on the map.
        foreach (var wp in loadedWaypoints)
        {
            if (wp.Latitude is not null && wp.Longitude is not null)
                await module.InvokeVoidAsync("addWaypointMarker", wp.Id, wp.Latitude, wp.Longitude, wp.Name);
        }

        SignalkClient.OnDataChanged += HandleDataChanged;
        aisTimer = new System.Threading.Timer(_ => _ = PushAisTargets(), null, 1000, 3000);

        await module.InvokeVoidAsync("enableKeyboardShortcuts", dotNetRef);
    }

    [JSInvokable]
    public async Task OnKeyShortcut(string key)
    {
        switch (key)
        {
            case "m": await ToggleMob(); break;
            case "n": await ToggleNightMode(); break;
            case "f": await ToggleFollow(); break;
            case "a": await ToggleAnchor(); break;
            case "t": await ZoomToTrack(); break;
            case "l": await ToggleLaylines(); break;
            case "o": await CycleMapOrientation(); break;
        }
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnMapBoundsChanged(double west, double south, double east, double north)
    {
        viewWest = west;
        viewSouth = south;
        viewEast = east;
        viewNorth = north;
        RebuildFilteredLayers();
        // Only re-render if the layer panel is actually open.
        if (chartPanelOpen)
            _ = InvokeAsync(StateHasChanged);
    }

    // Charts without bounds are always shown. Otherwise AABB intersection test.
    private bool ChartIntersectsViewport(SignalkChart chart)
    {
        if (chart.Bounds is null || chart.Bounds.Length < 4) return true;

        double cWest = chart.Bounds[0], cSouth = chart.Bounds[1];
        double cEast = chart.Bounds[2], cNorth = chart.Bounds[3];

        return !(cEast < viewWest || cWest > viewEast || cNorth < viewSouth || cSouth > viewNorth);
    }

    // Uses pre-computed bounding box (computed once when routes are loaded).
    private bool RouteIntersectsViewport(SignalkRoute route)
    {
        if (viewWest is null) return true;
        if (!routeBounds.TryGetValue(route.Id, out var bbox) || bbox is null) return true;

        return !(bbox.Value.MaxLon < viewWest || bbox.Value.MinLon > viewEast
              || bbox.Value.MaxLat < viewSouth || bbox.Value.MinLat > viewNorth);
    }

    // Pre-compute bounding boxes for all routes (called once after loading).
    private void PrecomputeRouteBounds()
    {
        routeBounds.Clear();
        foreach (var route in availableRoutes)
        {
            if (route.Feature?.Geometry is null) { routeBounds[route.Id] = null; continue; }
            try
            {
                double minLat = double.MaxValue, maxLat = double.MinValue;
                double minLon = double.MaxValue, maxLon = double.MinValue;
                foreach (var point in route.Feature.Geometry.Coordinates.EnumerateArray())
                {
                    var arr = new double[2];
                    int i = 0;
                    foreach (var val in point.EnumerateArray())
                    {
                        if (i < 2) arr[i++] = val.GetDouble();
                    }
                    double lon = arr[0], lat = arr[1];
                    if (lat < minLat) minLat = lat;
                    if (lat > maxLat) maxLat = lat;
                    if (lon < minLon) minLon = lon;
                    if (lon > maxLon) maxLon = lon;
                }
                routeBounds[route.Id] = (minLat, maxLat, minLon, maxLon);
            }
            catch
            {
                routeBounds[route.Id] = null;
            }
        }
    }

    // Cached HUD values for change detection. Only re-render when these actually change.
    private string lastHudKey = "";

    private string BuildHudKey() =>
        $"{Data.SpeedOverGround:F2}|{Data.CourseOverGround:F3}|{Data.Heading:F3}|{Data.Depth:F1}|{Data.WindAngleApparent:F3}|{Data.WindSpeedApparent:F2}|{Data.WindAngleTrue:F3}|{Data.WindSpeedTrue:F2}|{Data.WindDirectionTrue:F3}" +
        $"|{Data.CourseNextPointDistance:F0}|{Data.CourseNextPointBearing:F2}|{Data.CourseNextPointVmg:F2}|{Data.CourseNextPointTimeToGo:F0}" +
        $"|{Data.AnchorCurrentRadius:F1}|{Data.AnchorMaxRadius:F1}|{Data.AnchorLatitude:F6}" +
        $"|{Data.CrossTrackError:F1}|{Data.ActiveRouteHref}";

    private async void HandleDataChanged()
    {
        if (!mapInitialized || module is null) return;

        try
        {
            if (Data.Latitude is not null && Data.Longitude is not null)
            {
                await module.InvokeVoidAsync("updatePosition",
                    Data.Latitude, Data.Longitude, Data.Heading,
                    Data.CourseOverGround, Data.SpeedOverGround);

                if (prevLat is not null && prevLon is not null)
                {
                    await module.InvokeVoidAsync("addColoredTrackPoint",
                        Data.Latitude, Data.Longitude, Data.SpeedOverGround,
                        prevLat, prevLon);
                }
                prevLat = Data.Latitude;
                prevLon = Data.Longitude;
            }

            // Sync server-side anchor alarm to map visualization.
            await SyncServerAnchorAsync();

            // Sync active route visualization.
            await SyncActiveRouteAsync();

            // Update course line (boat-to-WP, leg line, XTE).
            // Snapshot nullable values to locals to avoid race with concurrent updates.
            var wpLat = Data.CourseNextPointLatitude;
            var wpLon = Data.CourseNextPointLongitude;
            if (wpLat is not null && wpLon is not null && Data.Latitude is not null && Data.Longitude is not null)
            {
                await module.InvokeVoidAsync("setCourseLine",
                    Data.Latitude, Data.Longitude,
                    wpLat, wpLon,
                    Data.CoursePreviousPointLatitude, Data.CoursePreviousPointLongitude,
                    Data.CrossTrackError);
                courseLineDrawn = true;
            }
            else if (courseLineDrawn)
            {
                await module.InvokeVoidAsync("clearCourseLine");
                courseLineDrawn = false;
            }

            // Update tidal current arrow when data available.
            if (Data.CurrentSet is not null && Data.CurrentDrift is not null
                && Data.CurrentDrift > 0.05 // Only show if drift > ~0.1 kn
                && Data.Latitude is not null && Data.Longitude is not null)
            {
                await module.InvokeVoidAsync("setCurrentArrow",
                    Data.Latitude, Data.Longitude, Data.CurrentSet, Data.CurrentDrift);
            }

            // Push laylines when visible and TWD is available (throttled: every 5th fix).
            if (laylinesVisible && Data.WindDirectionTrue is not null
                && Data.Latitude is not null && Data.Longitude is not null
                && ++laylinesSkip >= 5)
            {
                laylinesSkip = 0;
                double twa = Data.WindAngleTrue is not null
                    ? Math.Abs(Data.WindAngleTrue.Value)
                    : 45.0 * Math.PI / 180.0; // default 45 degrees

                await module.InvokeVoidAsync("setLaylines",
                    Data.Latitude, Data.Longitude,
                    Data.WindDirectionTrue,
                    twa,
                    Data.HasActiveCourse ? Data.CourseNextPointLatitude : null,
                    Data.HasActiveCourse ? Data.CourseNextPointLongitude : null);
            }

            // Only re-render Blazor component if HUD values actually changed.
            var hudKey = BuildHudKey();
            if (hudKey != lastHudKey)
            {
                lastHudKey = hudKey;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
    }

