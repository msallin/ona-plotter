    private async Task ToggleChart(SignalkChart chart, bool enabled)
    {
        if (module is null) return;

        var tileUrl = chart.GetTileUrl();
        if (tileUrl is null) return;

        if (enabled)
        {
            try
            {
                await module.InvokeVoidAsync("addChartLayer",
                    chart.Identifier, tileUrl, chart.MinZoom ?? 1, chart.MaxZoom ?? 18, 0.8,
                    chart.Bounds);
            }
            catch (JSDisconnectedException) { return; }
            catch (JSException ex)
            {
                // A JS-side regression (wrong object shape, missing layer
                // type, etc.) must not bubble into Blazor's error UI and
                // freeze the render pass -- that's what hid the own-boat
                // marker on the "chartLayers.map is undefined" crash.
                // Toast the user, log the detail, stay alive.
                Toasts.Error($"Chart {chart.Name}: could not enable ({ex.Message})");
                return;
            }
            enabledCharts.Add(chart.Identifier);
            // Seed the chart order with any newly-seen id so user-driven
            // reorders have something to reorder. Append -- new charts go
            // to the top of the draw stack (last .addTo wins).
            if (!Settings.ChartOrder.Contains(chart.Identifier))
            {
                await Settings.SetChartOrderAsync(Settings.ChartOrder.Append(chart.Identifier));
                ApplyChartOrder();
            }
            // Keep the quick-bar set in sync with any auto-enabled chart
            // (first-run OpenSeaMap seeding, future auto-rules). Without
            // this the chart would render but be missing from the quick
            // bar, so the user couldn't tap to hide it again.
            if (quickBarCharts.Add(chart.Identifier))
                await Settings.SetQuickBarChartsAsync(quickBarCharts);
        }
        else
        {
            try { await module.InvokeVoidAsync("removeChartLayer", chart.Identifier); }
            catch (JSDisconnectedException) { return; }
            catch (JSException ex)
            {
                Toasts.Error($"Chart {chart.Name}: could not disable ({ex.Message})");
                return;
            }
            enabledCharts.Remove(chart.Identifier);
        }
        await Settings.SetEnabledChartsAsync(enabledCharts);
    }

    /// <summary>
    /// Moves a chart up (-1) or down (+1) in the draw stack. "Up" in the UI
    /// means "closer to the top of the rendered map", which is LATER in
    /// the draw order (later .addTo wins). ApplyChartOrder() reorders
    /// availableCharts to match, and the JS side re-applies z-index.
    /// </summary>
    private async Task ReorderChart(SignalkChart chart, int direction)
    {
        if (module is null) return;
        var order = Settings.ChartOrder.ToList();

        // Defensive: ensure EVERY currently-enabled chart is represented
        // in the order list before we reorder. Without this, a stale
        // storage state (e.g. from the pre-fix SetChartOrderAsync bug
        // that wiped ChartOrder to just the last-toggled chart) can
        // leave a neighbour missing, so the bounds check `swapWith >=
        // order.Count` returns and the user sees nothing happen.
        foreach (var enabledId in enabledCharts)
        {
            if (!order.Contains(enabledId)) order.Add(enabledId);
        }
        if (!order.Contains(chart.Identifier)) order.Add(chart.Identifier);

        int idx = order.IndexOf(chart.Identifier);
        // UI convention: up = visually up in the panel list, which is
        // earlier in the displayed Charts order. Since Charts is iterated
        // in ChartOrder (the same list we're editing), "earlier" = lower
        // index. direction is -1 for up / +1 for down, so swapWith is
        // simply idx + direction -- no flip.
        //
        // Earlier revisions flipped the direction on the premise that
        // "up should mean up in the z-stack" (draw-order end); that put
        // the arrow direction at odds with visual motion and made the
        // buttons look broken ("I tapped up and it went down"). Keep
        // the panel and the arrow in sync; z-ordering follows.
        int swapWith = idx + direction;
        if (swapWith < 0 || swapWith >= order.Count) return;
        (order[idx], order[swapWith]) = (order[swapWith], order[idx]);

        await Settings.SetChartOrderAsync(order);
        ApplyChartOrder();

        // Push the new draw order to JS so z-index on each layer matches.
        try { await module.InvokeVoidAsync("setChartLayerOrder", order.ToArray()); }
        catch (JSDisconnectedException) { }
        catch (JSException ex)
        {
            // Symptom of the "reorder button does nothing" bug: a JS
            // exception in setChartLayerOrder silently wedges the UI.
            // Toast so the user sees something happened.
            Toasts.Error($"Reorder failed ({ex.Message})");
        }

        StateHasChanged();
    }

    /// <summary>
    /// Sorts availableCharts by <see cref="IAppSettings.ChartOrder"/>.
    /// Charts listed in the order come first (by index); unseen charts
    /// append in server-provided order.
    /// </summary>
    private void ApplyChartOrder()
    {
        var order = Settings.ChartOrder;
        if (order.Count == 0) return;
        var index = new Dictionary<string, int>(StringComparer.Ordinal);
        for (int i = 0; i < order.Count; i++) index[order[i]] = i;
        availableCharts = availableCharts
            .OrderBy(c => index.TryGetValue(c.Identifier, out var i) ? i : int.MaxValue)
            .ToList();
        // Reorder changes the ORDER of availableCharts, not the count --
        // RebuildFilteredLayers's cache key is count-based, so flush it
        // explicitly and rebuild now. Without this, the Layers panel's
        // chip stack kept showing the pre-reorder order and the reorder
        // button appeared to do nothing (the reorder DID happen, the UI
        // just didn't reflect it until the next cache miss).
        lastFilterKey = "";
        RebuildFilteredLayers();
    }

    private async Task ToggleRoute(SignalkRoute route, bool enabled)
    {
        if (module is null || route.Feature?.Geometry is null) return;

        if (enabled)
        {
            // Suppress the regular polyline if this route is the active
            // course -- the active overlay handles the visual and a
            // duplicate polyline underneath reads as a stuck progress
            // bar. Same logic as SyncActiveRouteAsync.
            if (_activeRouteRegularSuppressed != route.Id)
            {
                await AddRouteToMap(route);
            }
            enabledRoutes.Add(route.Id);
        }
        else
        {
            await module.InvokeVoidAsync("removeRoute", route.Id);
            enabledRoutes.Remove(route.Id);
        }
        await Settings.SetEnabledRoutesAsync(enabledRoutes);
    }

    /// <summary>Push a SignalK route to Leaflet as a visible layer. Shared
    /// between the Layers-panel toggle and the post-save auto-enable path
    /// (which otherwise only updated state but forgot to draw).</summary>
    private async Task AddRouteToMap(SignalkRoute route)
    {
        if (module is null || route.Feature?.Geometry is null) return;

        // Convert GeoJSON [lon, lat] to Leaflet [lat, lon].
        var coords = new List<double[]>();
        foreach (var point in route.Feature.Geometry.Coordinates.EnumerateArray())
        {
            var arr = new double[2];
            int i = 0;
            foreach (var val in point.EnumerateArray())
            {
                if (i < 2) arr[i++] = val.GetDouble();
            }
            coords.Add([arr[1], arr[0]]); // [lat, lon]
        }

        await module.InvokeVoidAsync("addRoute", route.Id, route.Name, coords.ToArray());
    }

    private async Task ToggleServerTrack(bool enabled)
    {
        serverTrackVisible = enabled;
        if (module is null) return;

        if (serverTrackVisible)
        {
            var points = await TrackApi.GetServerTrackAsync("1d", "1m");
            if (points is not null && points.Length > 0)
                await module.InvokeVoidAsync("setServerTrack", (object)points);
            else
                serverTrackVisible = false;
        }
        else
        {
            await module.InvokeVoidAsync("clearServerTrack");
        }
    }

    private async Task ToggleNightMode()
    {
        // Persist the manual-toggle timestamp (12-h auto-suppress window).
        // Lives in IAppSettings rather than a component field so leaving
        // and re-entering the Map page doesn't let auto-night flip back
        // and fight the helm's last choice.
        await Settings.MarkManualNightToggleAsync();
        nightMode = !nightMode;
        await Settings.SetNightModeAsync(nightMode);
        if (module is not null)
            await module.InvokeVoidAsync("setNightMode", nightMode);
    }

    // Deadman refresh. Wired to pointerdown + keydown at the map-container
    // level; any pointer or key event resets the inactivity timer. Keeping
    // it sync (no await) so it never slows down input handling; the
    // tracker is a lock-free field write.
    private void TouchDeadman() => DeadmanTracker.Touch();

    // Auto-night plumbing. Dormant unless the user opts in via Settings
    // AND the server publishes environment.sun as one of
    // "day" / "dawn" / "dusk" / "night". The plugin knows about
    // civil-twilight cutoffs so we don't reimplement them. A manual
    // Night tap within the last 12 h suppresses the auto-flip so a
    // helmsman who wants day-mode at dusk isn't fought. Persisted in
    // Settings.LastManualNightToggleUtc so the window survives page
    // navigation and browser reload.
    private const int ManualNightOverrideMinutes = 12 * 60;
    private DateTime _lastAutoNightCheckUtc = DateTime.MinValue;

    private async Task CheckAutoNightAsync()
    {
        if (!Settings.NightModeAuto) return;

        // Dusk / night => night on. Day / dawn => night off. Any
        // other value (empty, unknown, plugin not installed) skips
        // the flip entirely.
        bool? wantNightNullable = Data.SunState switch
        {
            "night" or "dusk" => true,
            "day" or "dawn" => false,
            _ => null,
        };
        if (wantNightNullable is not bool wantNight) return;

        var now = DateTime.UtcNow;
        // 30 s throttle -- sun altitude changes at ~0.004 rad/min so we
        // don't need sub-minute responsiveness.
        if ((now - _lastAutoNightCheckUtc).TotalSeconds < 30) return;
        _lastAutoNightCheckUtc = now;

        // Respect recent manual toggles. Source of truth is
        // Settings.LastManualNightToggleUtc so the window survives
        // navigation / reload.
        if (Settings.LastManualNightToggleUtc is DateTime t
            && (now - t).TotalMinutes < ManualNightOverrideMinutes) return;

        if (wantNight == nightMode) return;

        nightMode = wantNight;
        await Settings.SetNightModeAsync(nightMode);
        if (module is not null)
        {
            try { await module.InvokeVoidAsync("setNightMode", nightMode); }
            catch (JSDisconnectedException) { return; }
        }
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Dark Ops: chrome-off mode for long offshore watches. Map + alarms
    /// remain; control bar, HUDs, overlays all hide. Toggle via long-press
    /// on the Night button, or Esc. Ephemeral (not persisted) because the
    /// helm wants this only for the current watch.
    /// </summary>
    private void ToggleDarkOps()
    {
        darkOps = !darkOps;
        StateHasChanged();
    }

    // MOB clear confirmation now lives on MapControls (OnMobClicked)
    // as a two-tap pattern matching Stop-Navigation. The old
    // TaskCompletionSource-backed modal is gone; ToggleMob is called
    // only after the user has already armed + confirmed.

    private async Task ToggleMob()
    {
        if (module is null) return;

        if (!mobActive)
        {
            // If the GPS is dead at the exact moment the user taps MOB,
            // silently doing nothing is the worst outcome. Better to
            // tell them immediately so they can try again, raise VHF,
            // or use a handheld GPS. Don't set mobActive either, so the
            // button UI reflects the un-set state.
            if (Data.Latitude is not double lat || Data.Longitude is not double lon)
            {
                Toasts.Error("MOB: no GPS position -- use VHF and handheld");
                return;
            }
            await module.InvokeVoidAsync("setMob", lat, lon);
            mobActive = true;
            // setMob also plays a two-tone chime so the helm has
            // audio confirmation even if they were looking overboard
            // when the button was pressed. Persistent toast carries
            // the exact lat/lon so the helm can read it on the radio.
            var ns = lat >= 0 ? 'N' : 'S';
            var ew = lon >= 0 ? 'E' : 'W';
            Toasts.Show(
                $"MOB dropped {DateTime.Now:HH:mm:ss} -- {Math.Abs(lat):F5}\u00B0{ns}, {Math.Abs(lon):F5}\u00B0{ew}",
                ToastService.ToastLevel.Success,
                durationSec: 30);
        }
        else
        {
            // Guard against false-trigger clears: a kid leaning on the button,
            // Guard against false-trigger clears handled in MapControls
            // via the two-tap confirm pattern (parallel to Stop-
            // Navigation). By the time ToggleMob fires for a clear,
            // the user has already armed + confirmed. No second prompt
            // needed here.
            await module.InvokeVoidAsync("clearMob");
            mobActive = false;
        }
    }

    private async Task ToggleAnchor()
    {
        if (module is null) return;

        // Confirmation for raising the watch now lives on the Anchor
        // button itself as a two-tap arm-then-confirm pattern (parallel
        // to MOB-clear + Stop-Navigation). By the time ToggleAnchor
        // runs for a raise, the user has already armed + confirmed on
        // the button; no second modal.
        if (Data.AnchorActive)
        {
            // Server-side anchor (signalk-anchoralarm-plugin). Raise
            // via REST so the alarm actually stops on the server side
            // rather than just on the client.
            ApiResult r;
            try { r = await AnchorAlarmApi.RaiseAsync(); }
            catch (Exception ex) { Toasts.Error($"Raise anchor failed: {ex.Message}"); return; }

            if (!r.Success)
            {
                // 404 usually means the plugin isn't installed on this
                // server. Surface the reason so the helm knows whether
                // to fall back to the plugin's own UI.
                Toasts.Error($"Raise anchor failed: {r.Error ?? "server rejected"}");
                return;
            }
            Toasts.Success("Anchor raised");
            // Visual "raising in progress" feedback until the SK delta
            // confirms (Data.AnchorActive flips false). Same pattern as
            // the route-activate auto-raise path.
            _anchorRaisePendingUtc = DateTime.UtcNow;
            try { await module.InvokeVoidAsync("setAnchorRaising", true); }
            catch (JSDisconnectedException) { }
            return;
        }

        if (!anchorManualActive && Data.Latitude is not null && Data.Longitude is not null)
        {
            // Route + anchor share the bottom-center HUD slot and represent
            // contradictory modes: "I'm going there" vs "I'm staying here".
            // If a course is active when the user drops anchor, clear it
            // first so the HUDs don't stack on top of each other and the
            // APPROACH / XTE alarms don't chatter against a static boat.
            if (Data.HasActiveCourse)
                try { await CourseApi.ClearAsync(); }
                catch (Exception ex) { Toasts.Error($"Stop course failed: {ex.Message}"); }

            // Use the user's last-chosen radius. Default 30 m on first
            // use; persists across sessions via IAppSettings.
            await module.InvokeVoidAsync("setAnchor",
                Data.Latitude, Data.Longitude, Settings.ManualAnchorRadiusMeters);
            anchorManualLat = Data.Latitude.Value;
            anchorManualLon = Data.Longitude.Value;
            anchorManualActive = true;
        }
        else if (anchorManualActive)
        {
            // Manual-anchor clear. Arm + confirm already handled on the
            // button (same as the server-anchor raise above).
            await module.InvokeVoidAsync("clearAnchor");
            anchorManualActive = false;
        }
    }

    // Origin of the manual anchor drop. Captured at toggle-on time so the
    // radius chips can re-draw the circle at the same centre without
    // needing a fresh GPS fix.
    private double anchorManualLat;
    private double anchorManualLon;

    /// <summary>
    /// Updates the manual anchor's radius live without clearing the drop
    /// point. Called from the inline chips on the anchor HUD card.
    /// </summary>
    private async Task SetManualAnchorRadius(double radiusMeters)
    {
        if (!anchorManualActive || module is null) return;
        await Settings.SetManualAnchorRadiusMetersAsync(radiusMeters);
        try
        {
            await module.InvokeVoidAsync("setAnchor",
                anchorManualLat, anchorManualLon, radiusMeters);
        }
        catch (JSDisconnectedException) { }
    }

    /// <summary>
    /// Syncs anchor alarm state from SignalK server to the map.
    /// When the server provides anchor data, it overrides the manual anchor watch.
    /// </summary>
    private async Task SyncServerAnchorAsync()
    {
        if (!mapInitialized || module is null) return;

        if (Data.AnchorActive)
        {
            double radius = Data.AnchorMaxRadius ?? 30;
            if (!serverAnchorDrawn)
            {
                // Server anchor just appeared — draw it and disable manual.
                if (anchorManualActive)
                {
                    if (!mapInitialized) return;
                    await module.InvokeVoidAsync("clearAnchor");
                    anchorManualActive = false;
                }
                // A boat that just dropped anchor is unambiguously not
                // under way -- clear any active course so XTE /
                // APPROACH alarms don't chatter against a static boat
                // and the route HUD doesn't stack with the anchor HUD.
                // Note: we do NOT do the reverse (auto-raise anchor
                // when a route is activated) -- the helm may be
                // planning the next leg while still on the hook, and
                // auto-raising surprised users. Anchor is the more
                // decisive intent so it wins this asymmetry.
                if (Data.HasActiveCourse)
                {
                    try { await CourseApi.ClearAsync(); }
                    catch (Exception ex) { Toasts.Error($"Stop course failed: {ex.Message}"); }
                }
                if (!mapInitialized) return;
                await module.InvokeVoidAsync("setAnchor",
                    Data.AnchorLatitude, Data.AnchorLongitude, radius);
                serverAnchorDrawn = true;
                lastPushedAnchorRadius = radius;
            }
            else if (Math.Abs(radius - lastPushedAnchorRadius) > 0.1)
            {
                // Only update JS if radius actually changed.
                if (!mapInitialized) return;
                await module.InvokeVoidAsync("updateAnchorRadius", radius);
                lastPushedAnchorRadius = radius;
            }

            // Watchdog: if the helm tapped raise and Data.AnchorActive
            // is STILL true beyond the timeout, surface a warning and
            // un-dim the marker so the helm investigates rather than
            // staring at a dimmed-indefinitely anchor.
            //
            // Suppressed while the WebSocket is disconnected -- the
            // delta might have been published server-side but the
            // client isn't subscribed to receive it. Reset the timer
            // on reconnect so the user gets a fresh 5 s window once
            // we're listening again, instead of a false-positive
            // "server didn't confirm" the moment the connection is
            // restored. Without this, every reconnect during a raise
            // would blast a misleading warning.
            if (_anchorRaisePendingUtc is DateTime t)
            {
                if (!SignalkClient.IsConnected)
                {
                    _anchorRaisePendingUtc = DateTime.UtcNow;  // re-arm
                }
                else if ((DateTime.UtcNow - t).TotalSeconds > AnchorRaiseTimeoutSec)
                {
                    _anchorRaisePendingUtc = null;
                    Toasts.Warning("Anchor raise not confirmed by server -- still anchored");
                    if (!mapInitialized) return;
                    try { await module.InvokeVoidAsync("setAnchorRaising", false); }
                    catch (JSDisconnectedException) { }
                }
            }
        }
        else if (serverAnchorDrawn)
        {
            // Server anchor was raised — clear from map. Also clear
            // any "raising in progress" visual (the marker is going
            // away anyway, but the flag should follow truth).
            if (!mapInitialized) return;
            await module.InvokeVoidAsync("clearAnchor");
            serverAnchorDrawn = false;
            _anchorRaisePendingUtc = null;
        }
    }

    /// <summary>
    /// Drives the JS active-route layer in response to course changes.
    /// Triggers:
    /// 1) Route href changes (activation / deactivation / replace) --
    ///    fetches the route geometry once and draws the polyline.
    /// 2) Next-WP coords change while href stays the same (leg
    ///    advance from any source: our own button, auto-advance, or
    ///    another client like Freeboard). Reuses cached coords so the
    ///    pulsing marker hops to the new leg without an HTTP fetch.
    /// 3) <paramref name="force"/>=true -- refetches even on unchanged
    ///    href. Needed after an in-place edit of an already-active
    ///    route, where the href is identical but geometry is new.
    ///
    /// Also runs the Stop Navigation watchdog as a side effect:
    /// CourseApi.ClearAsync returned success but the SK delta hasn't
    /// cleared the active route within CourseStopTimeoutSec. We warn
    /// and un-dim the polyline rather than leaving the helm staring
    /// at a dimmed route forever.
    /// </summary>
    private async Task SyncActiveRouteAsync(bool force = false)
    {
        if (!mapInitialized || module is null) return;

        var currentHref = Data.ActiveRouteHref;
        var nextLat = Data.CourseNextPointLatitude;
        var nextLon = Data.CourseNextPointLongitude;

        // Watchdog for a pending Stop Navigation: if the helm tapped
        // Stop and CourseApi.ClearAsync returned success but the SK
        // delta hasn't cleared the active route within the timeout,
        // surface a warning rather than leaving the polyline dimmed
        // forever. Restore the un-dimmed style so the helm can see the
        // route is genuinely still active server-side.
        //
        // Suppressed while the WebSocket is disconnected: the delta
        // might exist server-side but the client isn't listening, so
        // a "server didn't confirm" warning would be misleading. Re-
        // arm the timer on every disconnected pass so the helm gets a
        // fresh 5 s grace once we reconnect.
        if (_courseStopPendingUtc is DateTime stopT && currentHref is not null)
        {
            if (!SignalkClient.IsConnected)
            {
                _courseStopPendingUtc = DateTime.UtcNow;  // re-arm
            }
            else if ((DateTime.UtcNow - stopT).TotalSeconds > CourseStopTimeoutSec)
            {
                _courseStopPendingUtc = null;
                Toasts.Warning("Stop navigation not confirmed by server -- still navigating");
                try { await module.InvokeVoidAsync("setActiveRouteStopping", false); }
                catch (JSDisconnectedException) { }
            }
        }
        // If the delta cleared the route, the pending flag should
        // follow truth -- the dimming is moot once the polyline is
        // gone, but the flag drives the watchdog above.
        if (currentHref is null) _courseStopPendingUtc = null;

        bool hrefChanged = currentHref != lastActiveRouteHref;
        bool nextWpChanged = nextLat != lastNextWpLat || nextLon != lastNextWpLon;
        if (!force && !hrefChanged && !nextWpChanged) return;

        if (hrefChanged || force)
        {
            // Route changed, deactivated, or forced refresh: clear
            // previous. For a forced refresh the href stayed the same
            // but the geometry didn't, so we still need to wipe the old
            // polyline.
            if (lastActiveRouteHref is not null || force)
            {
                await module.InvokeVoidAsync("clearActiveRoute");
                if (!mapInitialized) return;
                await module.InvokeVoidAsync("clearCourseLine");
                activeRouteCoords = null;
                _frameBuilder.CourseLineDrawn = false;
            }

            lastActiveRouteHref = currentHref;

            // The active overlay drawn by setActiveRoute would
            // otherwise sit on top of the regular polyline (drawn by
            // addRoute) for the same route id, producing a visible
            // double-stroke that confuses progress-vs-plan reading.
            // Hide the regular polyline of the new active route, and
            // restore the previous one if we suppressed it.
            string? newActiveId = string.IsNullOrEmpty(currentHref)
                ? null
                : SignalKUrls.ExtractRouteId(currentHref);
            if (_activeRouteRegularSuppressed is string prev
                && prev != newActiveId
                && enabledRoutes.Contains(prev))
            {
                var prevRoute = availableRoutes.FirstOrDefault(r => r.Id == prev);
                if (prevRoute is not null)
                {
                    try { await AddRouteToMap(prevRoute); }
                    catch (JSDisconnectedException) { }
                    catch (JSException) { /* layer may already exist; harmless */ }
                }
                _activeRouteRegularSuppressed = null;
            }
            if (!string.IsNullOrEmpty(newActiveId)
                && _activeRouteRegularSuppressed != newActiveId)
            {
                if (enabledRoutes.Contains(newActiveId))
                {
                    try { await module.InvokeVoidAsync("removeRoute", newActiveId); }
                    catch (JSDisconnectedException) { }
                }
                _activeRouteRegularSuppressed = newActiveId;
            }

            // Route activated: fetch geometry once. The HTTP round-trip
            // is where dispose races most often -- by the time the fetch
            // completes, the page may have navigated away. Re-check
            // mapInitialized after the await so a disposed module
            // doesn't get called.
            if (!string.IsNullOrEmpty(currentHref))
            {
                activeRouteCoords = await RouteApi.GetCoordinatesAsync(currentHref);
                if (!mapInitialized) return;
                _activeRouteDistanceTotal = activeRouteCoords is not null
                    ? OnaPlotter.Utilities.RouteProgress.TotalDistanceMeters(activeRouteCoords)
                    : null;
            }
            else
            {
                _activeRouteDistanceTotal = null;
            }
        }

        // Redraw whenever we have the geometry and a next-WP fix.
        // Covers the initial draw (hrefChanged or force), the leg-
        // advance case (nextWpChanged on an unchanged route), and the
        // post-edit refetch (force). The next-WP index is resolved
        // here so the JS side stays a thin renderer; the lookup
        // matches the next-point lat/lon to the closest vertex in
        // the route and is unit-tested in RouteProgressTests.
        if (activeRouteCoords is not null && activeRouteCoords.Length > 0
            && nextLat is not null && nextLon is not null)
        {
            string routeId = string.IsNullOrEmpty(currentHref)
                ? string.Empty
                : SignalKUrls.ExtractRouteId(currentHref);
            int nextWpIdx = OnaPlotter.Utilities.RouteProgress.FindClosestWaypointIndex(
                activeRouteCoords, nextLat.Value, nextLon.Value);
            await module.InvokeVoidAsync("setActiveRoute",
                (object)activeRouteCoords,
                nextWpIdx,
                routeId);
        }

        lastNextWpLat = nextLat;
        lastNextWpLon = nextLon;
    }

    private async Task ZoomToTrack()
    {
        if (module is not null)
            await module.InvokeVoidAsync("zoomToTrack");
    }

    // Zoom the map to the bounding box of the given route. Called from
    // the Resources-page "View" deep-link; the route may not be
    // currently enabled, so we flip it on first so the polyline is
    // actually visible after the fit.
    private async Task FocusRoute(SignalkRoute route)
    {
        if (module is null) return;
        chartPanelOpen = false;
        if (!enabledRoutes.Contains(route.Id))
        {
            await ToggleRoute(route, true);
        }
        if (!routeBounds.TryGetValue(route.Id, out var bbox) || bbox is null)
        {
            Toasts.Warning("Route has no mappable geometry");
            return;
        }
        await DisableFollowAsync();
        try
        {
            await module.InvokeVoidAsync("fitBounds",
                bbox.Value.MinLat, bbox.Value.MinLon,
                bbox.Value.MaxLat, bbox.Value.MaxLon);
        }
        catch (JSDisconnectedException) { }
    }

    // Zoom +/- handlers used to live here for an in-map overlay
    // button pair. They're now in MainLayout.razor's topbar (the JS
    // exports zoomIn/zoomOut on leafletInterop are still the
    // contract); kept the JS exports, dropped the C# wrappers since
    // no other call site needed them.

    /// <summary>
    /// One-shot pan to own-boat at the current zoom level. Distinct from
    /// Follow, which continuously re-centres on every position update.
    /// A helmsman panning the chart to look ahead wants a single "take
    /// me back to me" tap without engaging the lock.
    /// </summary>
    private async Task CentreOnBoat()
    {
        if (module is null) return;
        if (Data.Latitude is not double lat || Data.Longitude is not double lon)
        {
            // Silent no-op would look like a dead button at the helm;
            // tell the user WHY the tap did nothing.
            Toasts.Show("No GPS fix yet");
            return;
        }
        try { await module.InvokeVoidAsync("panTo", lat, lon); }
        catch (JSDisconnectedException) { }
    }

    // unsaved-changes guard (editNavGuard / InstallEditNavGuard /
    // RemoveEditNavGuard) lives in Map.Editing.razor.cs with the
    // edit flows it protects.

    public async ValueTask DisposeAsync()
    {
        // Flip mapInitialized FIRST so any HandleDataChanged / Sync*Async
        // that's currently parked between awaits bails at its next check
        // instead of hitting a half-torn-down JS module. The unsubscribe
        // below stops NEW invocations, but an in-flight one that's
        // already past its entry guard (fetching route coords, waiting
        // on an HTTP round-trip, etc.) would otherwise resume into a
        // disposed module and throw "addLayer on null" in the browser
        // console.
        mapInitialized = false;
        SignalkClient.OnDataChanged -= HandleDataChanged;
        SignalkClient.OnConnectionChanged -= HandleConnectionChanged;
        Atons.OnAtonsUpdated -= HandleAtonsUpdated;
        Settings.OnSettingsChanged -= HandleSettingsChanged;
        RemoveEditNavGuard();
        if (aisTimer is not null) await aisTimer.DisposeAsync();
        if (resourcePollTimer is not null) await resourcePollTimer.DisposeAsync();
        if (raceTimer is not null) await raceTimer.DisposeAsync();
        if (routeStatsTimer is not null) await routeStatsTimer.DisposeAsync();
        if (polygonStatsTimer is not null) await polygonStatsTimer.DisposeAsync();
        if (touchCoachmarkTimer is not null) await touchCoachmarkTimer.DisposeAsync();
        if (module is not null)
        {
            try
            {
                await module.InvokeVoidAsync("clearActiveRoute");
                await module.InvokeVoidAsync("clearCourseLine");
                await module.InvokeVoidAsync("clearLaylines");
                await module.InvokeVoidAsync("clearCurrentArrow");
                await module.InvokeVoidAsync("clearWeatherOverlay");
                await module.InvokeVoidAsync("disableKeyboardShortcuts");
                // Wake lock is owned by MainLayout now; do NOT release
                // it here, otherwise switching Chart -> Wind would
                // briefly drop the lock.
                await module.InvokeVoidAsync("dispose");
                await module.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
        }
        dotNetRef?.Dispose();
    }
