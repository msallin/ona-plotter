        {
            var r = await CourseApi.SetDestinationPositionAsync(lat, lon);
            if (!r.Success) { Toasts.Error($"Navigate failed: {r.Error ?? "server rejected"}"); return; }
            Toasts.Success($"Navigating to {lat:F4}, {lon:F4}");
        }
        catch (Exception ex) { Toasts.LogException(ex, "Navigate"); }
    }

