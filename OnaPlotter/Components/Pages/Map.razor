    private async Task SaveRoute()
    {
        if (module is null) return;
        var coords = await module.InvokeAsync<double[][]>("getEditRouteCoords");
        if (coords is null || coords.Length < 2)
        {
            routeEditMode = false;
            await module.InvokeVoidAsync("stopRouteEdit");
            return;
        }
        string name = string.IsNullOrWhiteSpace(routeEditName) ? $"Route {DateTime.Now:HH:mm}" : routeEditName;
        bool ok = await ChartService.SaveRouteAsync(name, coords);
        if (ok)
        {
            availableRoutes = await ChartService.GetRoutesAsync();
            PrecomputeRouteBounds();
            RebuildFilteredLayers();
        }
        routeEditMode = false;
        await module.InvokeVoidAsync("stopRouteEdit");
    }

