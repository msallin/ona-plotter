    /// <summary>
    /// Harbor mode is the helm's "I'm entering / leaving a busy port"
    /// switch. C# side flips the IAppSettings flag (which gates
    /// CpaAlarmRule + the moored-vessel filter in PushAisTargets);
    /// JS side gets the same flag pushed via setHarborMode so name
    /// labels, COG vectors, CPA arcs, and the guard-zone ring vanish
    /// in lock-step. Resets to false on every page reload (in-memory
    /// only) so a forgotten Harbor mode never silently rides into
    /// open water with the alarms still off.
    /// </summary>
    private async Task ToggleHarborMode()
    {
        // Failure mode this guards against (PARA-001): if the JS interop
        // throws after the C# flag has flipped to true, CpaAlarmRule
        // short-circuits (alarms muted) but the chart still shows live
        // AIS labels, COG vectors, and CPA arcs because the JS-side
        // teardown never ran. The helm gets the worst of both worlds:
        // alarms suppressed, visual cues unchanged, no signal that
        // anything went wrong. Roll back the C# flag and toast the
        // operator so the safety invariant ("alarms armed by default")
        // is preserved.
        bool requested = !Settings.HarborMode;
        await Settings.SetHarborModeAsync(requested);
        bool jsOk = true;
        if (_aisJs is not null)
        {
            // JSDisconnected / ObjectDisposed are absorbed inside the
            // wrapper (page is unmounting; rollback would be pointless).
            // A real JS-side regression bubbles through as a JSException
            // and trips the rollback so the alarm-armed invariant
            // doesn't drift away from the user's flag.
            try { await _aisJs.SetHarborModeAsync(Settings.HarborMode); }
            catch (Exception ex)
            {
                jsOk = false;
                Console.Error.WriteLine($"[interop] setHarborMode: {ex.Message}");
            }
        }
        if (!jsOk)
        {
            await Settings.SetHarborModeAsync(!requested);
            Toasts.Error("Harbor mode could not be applied; alarms remain active.");
            return;
        }
        // Force an immediate AIS push so the moored-vessel filter takes
        // effect now rather than at the next 3 s tick. Without this
        // the visual change lags the button tap by enough to feel
        // unresponsive.
        _ = PushAisTargets();
    }

