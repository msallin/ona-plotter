    // SK WebSocket delta stream (probed against openplotter - 195
    // unique paths, zero radar-related), so REST polling is the only
    // way to learn about state changes; the rest of the resources tab
    // (waypoints / routes / notes / regions) is delta-driven now and
    // doesn't need a parallel REST refresh on this hot path.
    private async Task RefreshRadarsAsync()
    {
        try
        {
            var radars = await RadarApi.GetAllAsync();
            await RadarOverlay.OnRadarListUpdatedAsync(radars);
            StateHasChanged();
        }
        catch (Exception) { /* next regular poll retries */ }
    }

