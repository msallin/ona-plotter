    {
        if (string.IsNullOrEmpty(wp.Id)) return;
        string label = wp.Name ?? wp.Id;
        ApiResult r;
        try { r = await WaypointApi.DeleteAsync(wp.Id); }
        catch (Exception ex) { Toasts.LogException(ex, $"Delete waypoint '{label}'"); return; }
        if (!r.Success) { Toasts.Error($"Delete waypoint '{label}' failed: {r.Error ?? "server rejected"}"); return; }

        if (_resourceJs is not null)
            await _resourceJs.RemoveWaypointMarkerAsync(wp.Id);
        loadedWaypoints.RemoveAll(w => w.Id == wp.Id);
        Toasts.Info($"Waypoint '{label}' deleted");
