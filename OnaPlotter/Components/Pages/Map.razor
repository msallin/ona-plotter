    // MaybeShowTouchCoachmarkAsync / DismissTouchCoachmark live in the
    // Map.FirstRun.razor.cs partial.

    private async Task PushGuardZoneAsync()
    {
        if (module is null) return;
        try
        {
            await module.InvokeVoidAsync("setGuardZone",
                Settings.CpaAlarmThreshold,
                Settings.GuardZoneLookaheadMinutes,
                Settings.GuardZoneWarningFactor);
        }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
    }

    // Fire-and-forget on the settings-changed event. PushGuardZoneAsync swallows
    // expected disposal races so nothing escapes as an unobserved task exception.
    private void HandleSettingsChanged()
    {
        _ = PushGuardZoneAsync();
        // Propagate KeepScreenAwake toggles live; a user flipping the
        // switch from Settings should see the lock engage / release
        // immediately, not only after navigating back to the Map page.
        if (module is not null)
        {
            var wanted = Settings.KeepScreenAwake;
            _ = InvokeVoidSafeAsync("setWakeLock", (object)wanted);
        }

        // Night-mode: if the user toggled it from Settings (not from
        // the Map page's own button) we hold a stale local `nightMode`
        // field and, crucially, the Leaflet tile filter never gets
        // applied. Resync both when Settings differs from our copy.
        if (Settings.NightMode != nightMode)
        {
            nightMode = Settings.NightMode;
            if (module is not null)
                _ = InvokeVoidSafeAsync("setNightMode", (object)nightMode);
            _ = InvokeAsync(StateHasChanged);
        }
    }

    // Minimal swallower for fire-and-forget module calls from sync
    // event handlers. Matches the JSDisconnected / ObjectDisposed
    // defence we apply at every other interop site; also catches
    // JSException so a buggy JS call can't take down the render pass.
    private async Task InvokeVoidSafeAsync(string identifier, params object?[] args)
    {
        if (module is null) return;
        try { await module.InvokeVoidAsync(identifier, args); }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
        catch (JSException ex)
        {
            Console.Error.WriteLine($"[interop] {identifier}: {ex.Message}");
        }
    }

    [JSInvokable]
    public async Task OnKeyShortcut(string key)
    {
        switch (key)
        {
            case "m": await ToggleMob(); break;
            case "n": await ToggleNightMode(); break;
            case "f": await ToggleFollow(); break;
            case "a": await ToggleAnchor(); break;
            case "t": await ZoomToTrack(); break;
            case "l": await ToggleLaylines(); break;
            case "o": await CycleMapOrientation(); break;
            case "r": ToggleRaceTimer(); break;
            case "d": await ToggleMeasure(); break;
            case "?":
                // "?" only opens the shortcuts card when keyboard hints
                // are enabled in Settings. Default off so touch-only
                // users don't land on an unexpected modal if they
                // connect a keyboard and brush the key.
                if (Settings.ShowKeyboardHints) shortcutsVisible = !shortcutsVisible;
                break;
            case "escape":
                if (measureActive) { await ToggleMeasure(); }
                // Esc also cancels in-progress route / polygon edits so
                // the user can bail without reaching for the mouse.
                if (routeEditMode) { await CancelRouteEdit(); }
                if (polygonEditMode) { await CancelPolygonEdit(); }
                if (fabMenuOpen) { fabMenuOpen = false; }
                if (legendOpen) { legendOpen = false; }
                if (darkOps) { darkOps = false; }
                shortcutsVisible = false;
                break;
        }
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnMapBoundsChanged(double west, double south, double east, double north)
    {
        viewWest = west;
        viewSouth = south;
        viewEast = east;
        viewNorth = north;
        RebuildFilteredLayers();
        // Only re-render if the layer panel is actually open.
        if (chartPanelOpen)
            _ = InvokeAsync(StateHasChanged);
    }

    // Charts without bounds are always shown. Otherwise AABB intersection test.
    private bool ChartIntersectsViewport(SignalkChart chart)
    {
        if (chart.Bounds is null || chart.Bounds.Length < 4) return true;

        double cWest = chart.Bounds[0], cSouth = chart.Bounds[1];
        double cEast = chart.Bounds[2], cNorth = chart.Bounds[3];

        return !(cEast < viewWest || cWest > viewEast || cNorth < viewSouth || cSouth > viewNorth);
    }

    // Uses pre-computed bounding box (computed once when routes are loaded).
    private bool RouteIntersectsViewport(SignalkRoute route)
    {
        if (viewWest is null) return true;
        if (!routeBounds.TryGetValue(route.Id, out var bbox) || bbox is null) return true;

        return !(bbox.Value.MaxLon < viewWest || bbox.Value.MinLon > viewEast
              || bbox.Value.MaxLat < viewSouth || bbox.Value.MinLat > viewNorth);
    }

    // Pre-compute bounding boxes for all routes (called once after loading).
    private void PrecomputeRouteBounds()
    {
        routeBounds.Clear();
        foreach (var route in availableRoutes)
        {
            if (route.Feature?.Geometry is null) { routeBounds[route.Id] = null; continue; }
            try
            {
                double minLat = double.MaxValue, maxLat = double.MinValue;
                double minLon = double.MaxValue, maxLon = double.MinValue;
                foreach (var point in route.Feature.Geometry.Coordinates.EnumerateArray())
                {
                    var arr = new double[2];
                    int i = 0;
                    foreach (var val in point.EnumerateArray())
                    {
                        if (i < 2) arr[i++] = val.GetDouble();
                    }
                    double lon = arr[0], lat = arr[1];
                    if (lat < minLat) minLat = lat;
                    if (lat > maxLat) maxLat = lat;
                    if (lon < minLon) minLon = lon;
                    if (lon > maxLon) maxLon = lon;
                }
                routeBounds[route.Id] = (minLat, maxLat, minLon, maxLon);
            }
            catch
            {
                routeBounds[route.Id] = null;
            }
        }
    }

    // Cached HUD values for change detection. Only re-render when these actually change.
    private string lastHudKey = "";

    private string BuildHudKey() =>
        $"{Data.SpeedOverGround:F2}|{Data.CourseOverGround:F3}|{Data.Heading:F3}|{Data.Depth:F1}|{Data.WindAngleApparent:F3}|{Data.WindSpeedApparent:F2}|{Data.WindAngleTrue:F3}|{Data.WindSpeedTrue:F2}|{Data.WindDirectionTrue:F3}" +
        $"|{Data.CourseNextPointDistance:F0}|{Data.CourseNextPointBearing:F2}|{Data.CourseNextPointVmg:F2}|{Data.CourseNextPointTimeToGo:F0}" +
        $"|{Data.AnchorCurrentRadius:F1}|{Data.AnchorMaxRadius:F1}|{Data.AnchorLatitude:F6}" +
        $"|{Data.CrossTrackError:F1}|{Data.ActiveRouteHref}" +
        // Route-level fields: progress chip + route-total row on the
        // active-route card. Without them in the key, a waypoint
        // advance would show new leg numbers but the "WP 3 of 7" chip
        // would lag until another field changed.
        $"|{Data.ActiveRoutePointIndex}|{Data.ActiveRoutePointTotal}" +
        $"|{Data.ActiveRouteDistanceRemaining:F0}|{Data.ActiveRouteTimeToGo:F0}";

    // One-time flag so we only push the own MMSI to JS once per
    // session. Self context resolves asynchronously via the hello
    // message; HandleDataChanged is the reliable cadence where
    // OwnMmsi becomes non-null.
    private bool _ownMmsiPushed;

    private async void HandleDataChanged()
    {
        if (!mapInitialized || module is null) return;

        // Keep the sticky last-heading field current for the HUD compass needle.
        if (Data.Heading is not null) lastHeading = Data.Heading;

        // Push own MMSI to JS once the SignalK hello resolves it so
        // buildSelfPopupHtml can fetch the country flag from the
        // signalk-flags plugin (same endpoint as AIS markers).
        if (!_ownMmsiPushed && SignalkClient.OwnMmsi is string mmsi)
        {
            _ownMmsiPushed = true;
            try { await module.InvokeVoidAsync("setOwnMmsi", mmsi); }
            catch (JSDisconnectedException) { _ownMmsiPushed = false; }
        }

        // Auto-flip Night mode near / past civil twilight if enabled.
        // Throttled to once per 30 s because sun altitude changes slowly.
        // Must sit after the mapInitialized guard so we don't try to
        // push setNightMode at a not-yet-imported module.
        await CheckAutoNightAsync();

        try
        {
            // Build the per-tick frame via the extracted builder. One
            // Blazor->JS bridge crossing per tick for up to six
            // overlays (position / track segment / course line / clear-
            // course / current arrow / laylines). Blazor's default
            // JSRuntime JsonOptions is CamelCase so the record-struct
            // fields arrive in JS as `pos.lat`, `pos.headingRad`, etc,
            // which is exactly what applyFrame expects.
            _frameBuilder.LaylinesVisible = laylinesVisible;
            var frame = _frameBuilder.Build(Data);
            await module.InvokeVoidAsync("applyFrame", frame);

            // Sync server-side anchor alarm to map visualization. Kept
            // out of applyFrame because it has its own diff-before-push
            // logic (href / radii) that doesn't map to a plain per-tick
            // snapshot.
            await SyncServerAnchorAsync();

            // Sync active route visualization (href-diff -> fetch + draw).
            await SyncActiveRouteAsync();

            // Only re-render Blazor component if HUD values actually changed.
            var hudKey = BuildHudKey();
            if (hudKey != lastHudKey)
            {
                lastHudKey = hudKey;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
        catch (JSException ex)
        {
            // A JS-side regression in any of updatePosition / setCourseLine
            // / setLaylines etc. used to bubble into Blazor's error UI and
            // freeze the render pass -- that's what hid the own-boat marker
            // in the chartLayers crash. Swallow + log so the UI stays live
            // and the browser console still surfaces the regression for
            // the dev. We fire at 1 Hz; a toast per tick would be spam.
            Console.Error.WriteLine($"[interop] HandleDataChanged: {ex.Message}");
        }
    }

    private async Task PushAisTargets()
    {
        if (!mapInitialized || module is null) return;
        try
        {
            var vessels = AisStore.GetVessels();
            // AisStore filters on position when building the snapshot, but
            // defend against someone clearing a position between snapshots
            // anyway - force-unwrap is never worth the risk in a hot path.
            // Pre-compute COLREGS per vessel (requires own lat/lon/cog/sog) so
            // the JS popup can render the category + give-way role without
            // re-implementing the math on the JS side.
            double? ownLat = Data.Latitude;
            double? ownLon = Data.Longitude;
            double? ownCog = Data.CourseOverGround;
            double? ownSog = Data.SpeedOverGround;

            var jsVessels = vessels
                .Where(v => v.Latitude is not null && v.Longitude is not null)
                .Select(v =>
                {
                    // Pre-compute COLREGS + CPA in C#. The router's JS
                    // used to run its own computeCpa per vessel per push;
                    // lifting it up means (a) single source of truth
                    // with Utilities/Cpa.cs + CpaTests, and (b) the
                    // BuildVesselList / PushAisTargets paths can't drift.
                    double? cpaNm = null;
                    double? tcpaMin = null;
                    string? colregsLabel = null;
                    string? colregsRole = null;
                    if (ownLat is not null && ownLon is not null
                        && ownCog is not null && ownSog is not null
                        && v.CourseOverGround is not null && v.SpeedOverGround is not null)
                    {
                        var cpa = Cpa.Compute(
                            ownLat.Value, ownLon.Value, ownCog, ownSog,
                            v.Latitude!.Value, v.Longitude!.Value,
                            v.CourseOverGround, v.SpeedOverGround);
                        if (cpa is { } c)
                        {
                            cpaNm = c.CpaNm;
                            tcpaMin = c.TcpaMin;
                        }

                        var r = Colregs.Classify(
                            ownLat.Value, ownLon.Value, ownCog.Value, ownSog.Value,
                            v.Latitude!.Value, v.Longitude!.Value,
                            v.CourseOverGround.Value, v.SpeedOverGround.Value);
                        if (r.Category != Colregs.Category.Indeterminate)
                        {
                            colregsLabel = Colregs.ShortLabel(r.Category);
                            colregsRole = Colregs.RoleLabel(r.Role);
                        }
                    }
                    // Pre-resolved visual fields so the JS layer is a
                    // dumb renderer: one source of truth for the AIS
                    // palette + SART classification in C#, tested in
                    // AisPaletteTests / AisSartAlarmRuleTests.
                    string? sartCat = OnaPlotter.Utilities.AisSart.CategoryFromAny(v.Mmsi, v.Context);
                    string? glyphCategory = OnaPlotter.Utilities.AisPalette.ShipTypeCategory(v.ShipType);

                    return new
                    {
                        context = v.Context, name = v.Name, mmsi = v.Mmsi, callsign = v.Callsign,
                        lat = v.Latitude!.Value, lon = v.Longitude!.Value,
                        headingRad = v.Heading, cogRad = v.CourseOverGround,
                        sogMs = v.SpeedOverGround, shipType = v.ShipType,
                        buddy = v.IsBuddy,
                        // Tell JS whether to render with an AIS or radar-ARPA
                        // icon. Radar targets lose buddy/danger overlays too;
                        // JS looks at this flag.
                        source = v.Source == OnaPlotter.Models.TargetSource.Radar ? "radar" : "ais",
                        sartCategory = sartCat,       // "SART"/"MOB"/"EPIRB" or null
                        glyphCategory,                 // "sail"/"fish"/"commercial"/"service"/null
                        shipColor = OnaPlotter.Utilities.AisPalette.ShipTypeColor(v.ShipType),
                        cpaNm,                         // nautical miles or null
                        tcpaMin,                       // minutes or null
                        colregsLabel,
                        colregsRole,
                        // Seconds since we last heard from this target. JS
                        // uses it to fade stale markers (>30 s) so the
                        // chart visually distinguishes a live target from
                        // a ghost that hasn't updated in minutes.
                        ageSec = (int)(DateTime.UtcNow - v.LastSeen).TotalSeconds
                    };
                }).ToArray();
            await module.InvokeVoidAsync("updateAisTargets", (object)jsVessels);
        }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
        catch (JSException ex)
        {
            // Hot path (every AIS tick). See HandleDataChanged for the
            // rationale: silent-but-logged stops a JS regression from
            // taking down the whole map UI.
            Console.Error.WriteLine($"[interop] PushAisTargets: {ex.Message}");
        }
    }

