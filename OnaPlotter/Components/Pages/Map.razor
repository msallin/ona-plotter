    // --- GPX Import/Export ---

    private async Task HandleGpxImport(InputFileChangeEventArgs e)
    {
        try
        {
            using var reader = new System.IO.StreamReader(e.File.OpenReadStream(maxAllowedSize: MaxGpxImportBytes));
            string xml = await reader.ReadToEndAsync();
            var data = GpxService.Parse(xml);

            foreach (var route in data.Routes)
                await RouteApi.SaveAsync(route.Name, route.Coords);

            foreach (var wp in data.Waypoints)
                await WaypointApi.CreateAsync(wp.Name, wp.Lat, wp.Lon);

            // Refresh lists.
            availableRoutes = await RouteApi.GetAllAsync();
            loadedWaypoints = await WaypointApi.GetAllAsync();
            PrecomputeRouteBounds();
            RebuildFilteredLayers();
            StateHasChanged();
            Toasts.Success($"Imported {data.Routes.Count} routes, {data.Waypoints.Count} waypoints");
        }
        catch (Exception ex)
        {
            Toasts.Error($"GPX import failed: {ex.Message}");
        }
    }

    private async Task ExportGpx()
    {
        if (module is null) return;
        try
        {
            string gpx = GpxService.Export(availableRoutes, loadedWaypoints);
            await module.InvokeVoidAsync("triggerFileDownload", $"export-{DateTime.Now:yyyyMMdd-HHmm}.gpx", gpx);
            Toasts.Success($"Exported {availableRoutes.Count} routes, {loadedWaypoints.Count} waypoints");
        }
        catch (Exception ex)
        {
            Toasts.Error($"GPX export failed: {ex.Message}");
        }
    }

    private async Task ToggleChart(SignalkChart chart, bool enabled)
    {
        if (module is null) return;

        var tileUrl = chart.GetTileUrl();
        if (tileUrl is null) return;

        if (enabled)
        {
            try
            {
                await module.InvokeVoidAsync("addChartLayer",
                    chart.Identifier, tileUrl, chart.MinZoom ?? 1, chart.MaxZoom ?? 18, 0.8,
                    chart.Bounds);
            }
            catch (JSDisconnectedException) { return; }
            catch (JSException ex)
            {
                // A JS-side regression (wrong object shape, missing layer
                // type, etc.) must not bubble into Blazor's error UI and
                // freeze the render pass -- that's what hid the own-boat
                // marker on the "chartLayers.map is undefined" crash.
                // Toast the user, log the detail, stay alive.
                Toasts.Error($"Chart {chart.Name}: could not enable ({ex.Message})");
                return;
            }
            enabledCharts.Add(chart.Identifier);
            // Seed the chart order with any newly-seen id so user-driven
            // reorders have something to reorder. Append -- new charts go
            // to the top of the draw stack (last .addTo wins).
            if (!Settings.ChartOrder.Contains(chart.Identifier))
            {
                await Settings.SetChartOrderAsync(Settings.ChartOrder.Append(chart.Identifier));
                ApplyChartOrder();
            }
        }
        else
        {
            try { await module.InvokeVoidAsync("removeChartLayer", chart.Identifier); }
            catch (JSDisconnectedException) { return; }
            catch (JSException ex)
            {
                Toasts.Error($"Chart {chart.Name}: could not disable ({ex.Message})");
                return;
            }
            enabledCharts.Remove(chart.Identifier);
        }
        await Settings.SetEnabledChartsAsync(enabledCharts);
    }

    /// <summary>
    /// Moves a chart up (-1) or down (+1) in the draw stack. "Up" in the UI
    /// means "closer to the top of the rendered map", which is LATER in
    /// the draw order (later .addTo wins). ApplyChartOrder() reorders
    /// availableCharts to match, and the JS side re-applies z-index.
    /// </summary>
    private async Task ReorderChart(SignalkChart chart, int direction)
    {
        if (module is null) return;
        var order = Settings.ChartOrder.ToList();
        // Ensure the chart is in the order list; if not, append then reorder.
        if (!order.Contains(chart.Identifier)) order.Add(chart.Identifier);

        int idx = order.IndexOf(chart.Identifier);
        // UI convention: up arrow = move toward the top of the stack. In the
        // order list, top of stack = end (last .addTo). So "up" = +1 index,
        // "down" = -1. Direction passed in is -1 for up / +1 for down in
        // the visual list, so flip it here.
        int swapWith = idx - direction;
        if (swapWith < 0 || swapWith >= order.Count) return;
        (order[idx], order[swapWith]) = (order[swapWith], order[idx]);

        await Settings.SetChartOrderAsync(order);
        ApplyChartOrder();

        // Push the new draw order to JS so z-index on each layer matches.
        try { await module.InvokeVoidAsync("setChartLayerOrder", order.ToArray()); }
        catch (JSDisconnectedException) { }
        catch (JSException ex)
        {
            // Symptom of the "reorder button does nothing" bug: a JS
            // exception in setChartLayerOrder silently wedges the UI.
            // Toast so the user sees something happened.
            Toasts.Error($"Reorder failed ({ex.Message})");
        }

        StateHasChanged();
    }

    /// <summary>
    /// Sorts availableCharts by <see cref="IAppSettings.ChartOrder"/>.
    /// Charts listed in the order come first (by index); unseen charts
    /// append in server-provided order.
    /// </summary>
    private void ApplyChartOrder()
    {
        var order = Settings.ChartOrder;
        if (order.Count == 0) return;
        var index = new Dictionary<string, int>(StringComparer.Ordinal);
        for (int i = 0; i < order.Count; i++) index[order[i]] = i;
        availableCharts = availableCharts
            .OrderBy(c => index.TryGetValue(c.Identifier, out var i) ? i : int.MaxValue)
            .ToList();
        // Reorder changes the ORDER of availableCharts, not the count --
        // RebuildFilteredLayers's cache key is count-based, so flush it
        // explicitly and rebuild now. Without this, the Layers panel's
        // chip stack kept showing the pre-reorder order and the reorder
        // button appeared to do nothing (the reorder DID happen, the UI
        // just didn't reflect it until the next cache miss).
        lastFilterKey = "";
        RebuildFilteredLayers();
    }

    private async Task ToggleRoute(SignalkRoute route, bool enabled)
    {
        if (module is null || route.Feature?.Geometry is null) return;

        if (enabled)
        {
            // Convert GeoJSON [lon, lat] to Leaflet [lat, lon].
            var coords = new List<double[]>();
            foreach (var point in route.Feature.Geometry.Coordinates.EnumerateArray())
            {
                var arr = new double[2];
                int i = 0;
                foreach (var val in point.EnumerateArray())
                {
                    if (i < 2) arr[i++] = val.GetDouble();
                }
                coords.Add([arr[1], arr[0]]); // [lat, lon]
            }

            await module.InvokeVoidAsync("addRoute", route.Id, route.Name, coords.ToArray());
            enabledRoutes.Add(route.Id);
        }
        else
        {
            await module.InvokeVoidAsync("removeRoute", route.Id);
            enabledRoutes.Remove(route.Id);
        }
        await Settings.SetEnabledRoutesAsync(enabledRoutes);
    }

    private async Task ToggleServerTrack(bool enabled)
    {
        serverTrackVisible = enabled;
        if (module is null) return;

        if (serverTrackVisible)
        {
            var points = await TrackApi.GetServerTrackAsync("1d", "1m");
            if (points is not null && points.Length > 0)
                await module.InvokeVoidAsync("setServerTrack", (object)points);
            else
                serverTrackVisible = false;
        }
        else
        {
            await module.InvokeVoidAsync("clearServerTrack");
        }
    }

    private async Task ToggleNightMode()
    {
        _lastManualNightToggleUtc = DateTime.UtcNow;
        nightMode = !nightMode;
        await Settings.SetNightModeAsync(nightMode);
        if (module is not null)
            await module.InvokeVoidAsync("setNightMode", nightMode);
    }

    // Deadman refresh. Wired to pointerdown + keydown at the map-container
    // level; any pointer or key event resets the inactivity timer. Keeping
    // it sync (no await) so it never slows down input handling; the
    // tracker is a lock-free field write.
    private void TouchDeadman() => DeadmanTracker.Touch();

    // Auto-night plumbing. Dormant unless the user opts in via Settings
    // AND the server publishes environment.sun.altitude. A manual Night
    // tap within the last hour suppresses the auto-flip so a helmsman
    // who wants day-mode at dusk isn't fought.
    private const double NightSunAltitudeThresholdRad = -0.1;  // ~civil twilight
    private const int ManualNightOverrideMinutes = 60;
    private DateTime? _lastManualNightToggleUtc;
    private DateTime _lastAutoNightCheckUtc = DateTime.MinValue;

    private async Task CheckAutoNightAsync()
    {
        if (!Settings.NightModeAuto) return;
        if (Data.SunAltitude is not double alt) return;

        var now = DateTime.UtcNow;
        // 30 s throttle -- sun altitude changes at ~0.004 rad/min so we
        // don't need sub-minute responsiveness.
        if ((now - _lastAutoNightCheckUtc).TotalSeconds < 30) return;
        _lastAutoNightCheckUtc = now;

        // Respect recent manual toggles.
        if (_lastManualNightToggleUtc is DateTime t
            && (now - t).TotalMinutes < ManualNightOverrideMinutes) return;

        bool wantNight = alt < NightSunAltitudeThresholdRad;
        if (wantNight == nightMode) return;

        nightMode = wantNight;
        await Settings.SetNightModeAsync(nightMode);
        if (module is not null)
        {
            try { await module.InvokeVoidAsync("setNightMode", nightMode); }
            catch (JSDisconnectedException) { return; }
        }
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Dark Ops: chrome-off mode for long offshore watches. Map + alarms
    /// remain; control bar, HUDs, overlays all hide. Toggle via long-press
    /// on the Night button, or Esc. Ephemeral (not persisted) because the
    /// helm wants this only for the current watch.
    /// </summary>
    private void ToggleDarkOps()
    {
        darkOps = !darkOps;
        StateHasChanged();
    }

    // --- MOB clear confirmation ---------------------------------------
    // TaskCompletionSource-backed await-modal pattern so ToggleMob can
    // await the user's Cancel / Confirm decision from the Blazor modal.
    // Keeps the code linear without a callback mess or re-entry bugs.
    private bool mobClearConfirmVisible;
    private TaskCompletionSource<bool>? mobClearTcs;

    private Task<bool> AskMobClearAsync()
    {
        mobClearTcs = new TaskCompletionSource<bool>(TaskCreationOptions.RunContinuationsAsynchronously);
        mobClearConfirmVisible = true;
        StateHasChanged();
        return mobClearTcs.Task;
    }

    private void MobClearConfirm(bool ok)
    {
        mobClearConfirmVisible = false;
        mobClearTcs?.TrySetResult(ok);
        mobClearTcs = null;
        StateHasChanged();
    }

    private async Task ToggleMob()
    {
        if (module is null) return;

        if (!mobActive && Data.Latitude is not null && Data.Longitude is not null)
        {
            await module.InvokeVoidAsync("setMob", Data.Latitude, Data.Longitude);
            mobActive = true;
        }
        else if (mobActive)
        {
            // Guard against false-trigger clears: a kid leaning on the button,
            // a double-tap in heavy seas, or an accidental keyboard 'M' while
            // typing in a note. If this IS the real event, a one-second delay
            // + confirm is trivial compared to a lost crewmember. Uses a
            // Blazor modal instead of JS confirm() so iPad landscape reads
            // the full message and the "Cancel" button takes default focus.
            bool ok = await AskMobClearAsync();
            if (!ok) return;

            await module.InvokeVoidAsync("clearMob");
            mobActive = false;
        }
        // No position available: do nothing, don't toggle state.
    }

    private async Task ToggleAnchor()
    {
        if (module is null) return;

        // If server-side anchor is active, the button is read-only (controlled by SignalK plugin).
        if (Data.AnchorActive) return;

        if (!anchorManualActive && Data.Latitude is not null && Data.Longitude is not null)
        {
            // Use the user's last-chosen radius. Default 30 m on first
            // use; persists across sessions via IAppSettings.
            await module.InvokeVoidAsync("setAnchor",
                Data.Latitude, Data.Longitude, Settings.ManualAnchorRadiusMeters);
            anchorManualLat = Data.Latitude.Value;
            anchorManualLon = Data.Longitude.Value;
            anchorManualActive = true;
        }
        else if (anchorManualActive)
        {
            await module.InvokeVoidAsync("clearAnchor");
            anchorManualActive = false;
        }
    }

    // Origin of the manual anchor drop. Captured at toggle-on time so the
    // radius chips can re-draw the circle at the same centre without
    // needing a fresh GPS fix.
    private double anchorManualLat;
    private double anchorManualLon;

    /// <summary>
    /// Updates the manual anchor's radius live without clearing the drop
    /// point. Called from the inline chips on the anchor HUD card.
    /// </summary>
    private async Task SetManualAnchorRadius(double radiusMeters)
    {
        if (!anchorManualActive || module is null) return;
        await Settings.SetManualAnchorRadiusMetersAsync(radiusMeters);
        try
        {
            await module.InvokeVoidAsync("setAnchor",
                anchorManualLat, anchorManualLon, radiusMeters);
        }
        catch (JSDisconnectedException) { }
    }

    /// <summary>
    /// Syncs anchor alarm state from SignalK server to the map.
    /// When the server provides anchor data, it overrides the manual anchor watch.
    /// </summary>
    private async Task SyncServerAnchorAsync()
    {
        if (module is null) return;

        if (Data.AnchorActive)
        {
            double radius = Data.AnchorMaxRadius ?? 30;
            if (!serverAnchorDrawn)
            {
                // Server anchor just appeared — draw it and disable manual.
                if (anchorManualActive)
                {
                    await module.InvokeVoidAsync("clearAnchor");
                    anchorManualActive = false;
                }
                await module.InvokeVoidAsync("setAnchor",
                    Data.AnchorLatitude, Data.AnchorLongitude, radius);
                serverAnchorDrawn = true;
                lastPushedAnchorRadius = radius;
            }
            else if (Math.Abs(radius - lastPushedAnchorRadius) > 0.1)
            {
                // Only update JS if radius actually changed.
                await module.InvokeVoidAsync("updateAnchorRadius", radius);
                lastPushedAnchorRadius = radius;
            }
        }
        else if (serverAnchorDrawn)
        {
            // Server anchor was raised — clear from map.
            await module.InvokeVoidAsync("clearAnchor");
            serverAnchorDrawn = false;
        }
    }

    /// <summary>
    /// Detects changes to the active route href and fetches/draws the route on the map.
    /// </summary>
    private async Task SyncActiveRouteAsync()
    {
        if (module is null) return;

        var currentHref = Data.ActiveRouteHref;

        if (currentHref == lastActiveRouteHref) return;

        // Route changed or deactivated: clear previous.
        if (lastActiveRouteHref is not null)
        {
            await module.InvokeVoidAsync("clearActiveRoute");
            await module.InvokeVoidAsync("clearCourseLine");
            activeRouteCoords = null;
            courseLineDrawn = false;
        }

        lastActiveRouteHref = currentHref;

        // Route activated: fetch and draw.
        if (!string.IsNullOrEmpty(currentHref))
        {
            activeRouteCoords = await RouteApi.GetCoordinatesAsync(currentHref);
            if (activeRouteCoords is not null && activeRouteCoords.Length > 0)
            {
                await module.InvokeVoidAsync("setActiveRoute",
                    (object)activeRouteCoords,
                    Data.CourseNextPointLatitude ?? 0,
                    Data.CourseNextPointLongitude ?? 0);
            }
        }
    }

    private async Task ZoomToTrack()
    {
        if (module is not null)
            await module.InvokeVoidAsync("zoomToTrack");
    }

    /// <summary>
    /// One-shot pan to own-boat at the current zoom level. Distinct from
    /// Follow, which continuously re-centres on every position update.
    /// A helmsman panning the chart to look ahead wants a single "take
    /// me back to me" tap without engaging the lock.
    /// </summary>
    private async Task CentreOnBoat()
    {
        if (module is null) return;
        if (Data.Latitude is not double lat || Data.Longitude is not double lon)
        {
            // Silent no-op would look like a dead button at the helm;
            // tell the user WHY the tap did nothing.
            Toasts.Show("No GPS fix yet");
            return;
        }
        try { await module.InvokeVoidAsync("panTo", lat, lon); }
        catch (JSDisconnectedException) { }
    }

    private async Task ToggleFullscreen()
    {
        fullscreen = !fullscreen;
        // Use native Fullscreen API where supported (desktop), fall back to CSS-only (iOS).
        if (fullscreen)
        {
            try
            {
                await JS.InvokeVoidAsync("eval",
                    "var el=document.querySelector('.map-container');" +
                    "if(el.requestFullscreen)el.requestFullscreen();" +
                    "else if(el.webkitRequestFullscreen)el.webkitRequestFullscreen();");
            }
            catch { /* CSS fallback handles it. */ }
        }
        else
        {
            try
            {
                await JS.InvokeVoidAsync("eval",
                    "if(document.exitFullscreen)document.exitFullscreen();" +
                    "else if(document.webkitExitFullscreen)document.webkitExitFullscreen();");
            }
            catch { /* CSS fallback handles it. */ }
        }
        // Leaflet needs a size recalculation after fullscreen change.
        if (module is not null)
        {
            await Task.Delay(100);
            await module.InvokeVoidAsync("eval", "if(window._onaMap)window._onaMap.invalidateSize()");
        }
    }

    private void OnFullscreenChange()
    {
        _ = InvokeAsync(async () =>
        {
            var isFs = await JS.InvokeAsync<bool>("eval",
                "!!(document.fullscreenElement||document.webkitFullscreenElement)");
            if (fullscreen != isFs)
            {
                fullscreen = isFs;
                StateHasChanged();
            }
        });
    }

    // --- unsaved-changes guard for in-app navigation -----------------
    // Registered while route-edit or polygon-edit is active so switching
    // to Dashboard / Settings / etc. prompts before discarding the edit.
    // Browser-level navigation (close tab, back) is handled JS-side via
    // beforeunload in the same `startRouteEdit` / `startPolygonEdit`
    // module calls. RegisterLocationChangingHandler returns IDisposable;
    // disposing cancels the registration.
    private IDisposable? editNavGuard;

    private void InstallEditNavGuard()
    {
        if (editNavGuard is not null) return;
        editNavGuard = Nav.RegisterLocationChangingHandler(async ctx =>
        {
            if (!routeEditMode && !polygonEditMode) return;
            bool ok;
            try
            {
                ok = await JS.InvokeAsync<bool>("confirm",
                    "You have an unsaved edit. Leave and discard it?");
            }
            catch (JSDisconnectedException) { return; }
            if (!ok) ctx.PreventNavigation();
        });
    }

    private void RemoveEditNavGuard()
    {
        editNavGuard?.Dispose();
        editNavGuard = null;
    }

    public async ValueTask DisposeAsync()
    {
        SignalkClient.OnDataChanged -= HandleDataChanged;
        SignalkClient.OnConnectionChanged -= HandleConnectionChanged;
        Settings.OnSettingsChanged -= HandleSettingsChanged;
        RemoveEditNavGuard();
        if (aisTimer is not null) await aisTimer.DisposeAsync();
        if (raceTimer is not null) await raceTimer.DisposeAsync();
        if (routeStatsTimer is not null) await routeStatsTimer.DisposeAsync();
        if (polygonStatsTimer is not null) await polygonStatsTimer.DisposeAsync();
        if (touchCoachmarkTimer is not null) await touchCoachmarkTimer.DisposeAsync();
        if (module is not null)
        {
            try
            {
                await module.InvokeVoidAsync("clearActiveRoute");
                await module.InvokeVoidAsync("clearCourseLine");
                await module.InvokeVoidAsync("clearLaylines");
                await module.InvokeVoidAsync("clearCurrentArrow");
                await module.InvokeVoidAsync("clearWeatherOverlay");
                await module.InvokeVoidAsync("disableKeyboardShortcuts");
                // Release the wake lock when navigating off the Map page;
                // other pages don't need the screen pinned on.
                await module.InvokeVoidAsync("setWakeLock", false);
                await module.InvokeVoidAsync("dispose");
                await module.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
        }
        dotNetRef?.Dispose();
    }
}
