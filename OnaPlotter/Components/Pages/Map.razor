    // second one without explicitly dismissing the first was a common
    // stacked-modal bug in earlier builds.
    private enum BottomBarFlyout { Layers, Fab, More }
    private void CloseOtherFlyouts(BottomBarFlyout keep)
    {
        if (keep != BottomBarFlyout.Layers) chartPanelOpen = false;
        if (keep != BottomBarFlyout.Fab)    fabMenuOpen    = false;
        if (keep != BottomBarFlyout.More)   moreMenuOpen   = false;
