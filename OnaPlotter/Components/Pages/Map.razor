@* Chartplotter: live map with HUD instruments, AIS targets, MOB, anchor watch. *@

@page "/map"
@using OnaPlotter.Services
@using OnaPlotter.Services.Api
@using OnaPlotter.Models
@using OnaPlotter.Components.Map
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject SignalkClient SignalkClient
@inject TrackBuffer TrackBuffer
@inject AisStore AisStore
@inject IChartApi ChartApi
@inject IRouteApi RouteApi
@inject IWaypointApi WaypointApi
@inject INoteApi NoteApi
@inject IRegionApi RegionApi
@inject ICourseApi CourseApi
@inject IAutopilotApi AutopilotApi
@inject ITrackApi TrackApi
@inject IBuddyListApi BuddyListApi
@inject IWeatherForecastApi WeatherApi
@inject IPolarService Polar
@inject IAppSettings Settings
@inject IToastService Toasts
@inject IKeyValueStore Kv
@inject IJSRuntime JS

<PageTitle>Map</PageTitle>

<div class="map-container @(nightMode ? "night-mode" : "") @(fullscreen ? "map-fullscreen" : "") mode-@Settings.SailingMode"
     @onfullscreenchange="OnFullscreenChange">
    <div id="mapDiv"></div>

    @* Connection status chip. Rendered unconditionally; CSS hides it
       except when the map is in fullscreen (native or our .map-fullscreen
       CSS-only fallback). Avoids duplicating the MainLayout top-row
       indicator but still shows on iPad where native fullscreen is spotty. *@
    <div class="conn-chip conn-@ConnClass" title="@ConnTooltip">
        <span class="conn-dot"></span>
        @ConnLabel
    </div>

    <MapHud Data="Data" Autopilot="AutopilotApi"
            LastHeadingRad="lastHeading" AnchorDragging="AnchorDragging"
            DepthAlarmThreshold="Settings.DepthAlarmThreshold"
            SailingMode="@Settings.SailingMode"
            Polar="Polar"
            OnStopNavigation="StopNavigation" />

    @* Nearest-waypoint chip. Only shows when we have own-boat position,
       at least one waypoint, and no active route (the route HUD already
       tells you where you're heading). One-tap shortcut that saves
       opening the Layers panel + scrolling to find the closest target
       -- a common sailor workflow before setting a destination. *@
    @if (!Data.HasActiveCourse && NearestWp is { } nearest)
    {
        <button class="nearest-wp-chip" @onclick="() => FocusWaypoint(nearest.Wp)"
                title="@($"Pan to {nearest.Wp.Name ?? nearest.Wp.Id}")">
            <span class="nearest-wp-label">NEAREST WP</span>
            <span class="nearest-wp-name">@(nearest.Wp.Name ?? nearest.Wp.Id[..Math.Min(8, nearest.Wp.Id.Length)])</span>
            <span class="nearest-wp-dist">
                @nearest.Nm.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)<span class="hud-unit">nm</span>
            </span>
            <span class="nearest-wp-brg">
                @((int)Math.Round(nearest.BearingDeg))<span class="hud-unit">&deg;</span>
            </span>
        </button>
    }

    <MapControls Follow="follow"
                 OrientationLabel="@mapOrientationLabel"
                 NightMode="nightMode"
                 AnchorActive="AnchorButtonActive"
                 MobActive="mobActive"
                 LaylinesVisible="laylinesVisible"
                 MeasureActive="measureActive"
                 RouteEditMode="routeEditMode"
                 RaceTimerActive="raceTimerActive"
                 RaceTimerLabel="@FormatRaceTimer()"
                 LayersPanelOpen="chartPanelOpen"
                 EnabledLayerCount="enabledCharts.Count + enabledRoutes.Count"
                 TotalLayerCount="availableCharts.Count + availableRoutes.Count"
                 OnToggleFollow="ToggleFollow"
                 OnCycleOrientation="CycleMapOrientation"
                 OnToggleNight="ToggleNightMode"
                 OnToggleAnchor="ToggleAnchor"
                 OnToggleMob="ToggleMob"
                 OnZoomToTrack="ZoomToTrack"
                 OnToggleLaylines="ToggleLaylines"
                 OnToggleMeasure="ToggleMeasure"
                 OnStartRouteEdit="StartRouteEdit"
                 OnToggleRaceTimer="ToggleRaceTimer"
                 OnToggleLayers="ToggleLayersPanel" />

    @if (shortcutsVisible)
    {
        <MapShortcutsOverlay OnDismiss="() => shortcutsVisible = false" />
    }

    @* First-run long-press hint. CSS gates on `@@media (pointer: coarse)`
       so desktop users never see it. Dismisses on tap or after 6s; the
       dismissal flag is stored in KV so it only shows once per device. *@
    @if (touchCoachmarkVisible)
    {
        <div class="touch-coachmark" @onclick="DismissTouchCoachmark">
            <span>Tip: long-press the map for options</span>
        </div>
    }

    @* First-visit welcome card: three concrete things the user should
       do to get the app working. Shown once ever per device (KV flag);
       dismissible via the Got it button. Shows instead of the touch
       coachmark on first-ever visit since it covers the same ground
       and more. *@
    @if (welcomeVisible)
    {
        <div class="welcome-backdrop" @onclick="DismissWelcome"></div>
        <div class="welcome-card" @onclick:stopPropagation role="dialog"
             aria-labelledby="welcome-title">
            <h3 id="welcome-title">Welcome aboard</h3>
            <p class="welcome-sub">Three things to get you sailing:</p>
            <ol class="welcome-steps">
                <li>
                    <strong>Turn on a chart.</strong> Tap
                    <span class="welcome-kbd">Layers</span> (bottom bar) to
                    enable the charts your SignalK server provides.
                </li>
                <li>
                    <strong>Set your depth alarm.</strong> Open
                    <span class="welcome-kbd">Settings</span> and pick a
                    threshold for your boat's draft.
                </li>
                <li>
                    <strong>Long-press the map</strong> (or right-click) for
                    options: Create Waypoint, Add Note, Add Region,
                    Navigate Here, Route with wind.
                </li>
            </ol>
            <button class="welcome-dismiss map-btn active" @onclick="DismissWelcome">
                Got it
            </button>
        </div>
    }

    @if (routeEditMode)
    {
        <RouteEditPanel Name="routeEditName"
                        NameChanged="v => routeEditName = v"
                        Stats="@routeEditStats"
                        OnUndo="UndoLastWaypoint"
                        OnSave="SaveRoute"
                        OnCancel="CancelRouteEdit" />
    }

    @* === Context Menu (right-click) === *@
    @if (contextMenuVisible)
    {
        <div class="map-context-menu" style="left:@(contextMenuX)px; top:@(contextMenuY)px;">
            <button class="ctx-menu-item" @onclick="CreateWaypointHere">Create Waypoint</button>
            <button class="ctx-menu-item" @onclick="CreateNoteHere">Add Note</button>
            <button class="ctx-menu-item" @onclick="CreateRegionHere">Add Region</button>
            <button class="ctx-menu-item" @onclick="NavigateHere">Navigate Here</button>
            <button class="ctx-menu-item" @onclick="RouteWithWindHere"
                    disabled="@(!Polar.HasPolar)"
                    title="@(Polar.HasPolar ? "Isochrone weather routing" : "Upload a polar in Settings first")">
                Route with wind
            </button>
            @if (Data.HasActiveCourse)
            {
                <button class="ctx-menu-item ctx-menu-danger" @onclick="StopNavigation">Stop Navigation</button>
            }
        </div>
    }

    @* === Waypoint Name Dialog === *@
    @if (waypointDialogVisible)
    {
        <div class="waypoint-dialog">
            <div class="hud-label" style="margin-bottom:8px;">Create Waypoint</div>
            <input type="text" class="route-name-input" aria-label="Waypoint name"
                   @bind="newWaypointName" @bind:event="oninput" />
            <div style="display:flex; gap:6px; margin-top:8px;">
                <button class="map-btn active" @onclick="SaveWaypoint">Save</button>
                <button class="map-btn" @onclick="() => waypointDialogVisible = false">Cancel</button>
            </div>
        </div>
    }

    @* === Note Dialog === *@
    @if (noteDialogVisible)
    {
        <div class="waypoint-dialog note-dialog">
            <div class="hud-label" style="margin-bottom:8px;">Add Note</div>
            <input type="text" class="route-name-input" aria-label="Note title"
                   placeholder="Title" @bind="newNoteTitle" @bind:event="oninput" />
            <textarea class="route-name-input note-dialog-body" aria-label="Note description"
                      placeholder="Description (optional)" rows="4"
                      @bind="newNoteDescription" @bind:event="oninput"></textarea>
            <div style="display:flex; gap:6px; margin-top:8px;">
                <button class="map-btn active" @onclick="SaveNote">Save</button>
                <button class="map-btn" @onclick="() => noteDialogVisible = false">Cancel</button>
            </div>
        </div>
    }

    @* === Region Dialog (circle only in this phase) === *@
    @if (regionDialogVisible)
    {
        <div class="waypoint-dialog note-dialog">
            <div class="hud-label" style="margin-bottom:8px;">Add Region (circle)</div>
            <input type="text" class="route-name-input" aria-label="Region title"
                   placeholder="Title" @bind="newRegionTitle" @bind:event="oninput" />
            <textarea class="route-name-input note-dialog-body" aria-label="Region description"
                      placeholder="Description (optional)" rows="3"
                      @bind="newRegionDescription" @bind:event="oninput"></textarea>
            <div class="hud-label" style="margin-top:10px;">Radius</div>
            <div class="region-radius-chips">
                @foreach (var (m, label) in RegionRadiusPresets)
                {
                    <button class="map-btn @(newRegionRadiusMeters == m ? "active" : "")"
                            @onclick="() => newRegionRadiusMeters = m" type="button">@label</button>
                }
            </div>
            <div style="display:flex; gap:6px; margin-top:10px;">
                <button class="map-btn active" @onclick="SaveRegion">Save</button>
                <button class="map-btn" @onclick="() => regionDialogVisible = false">Cancel</button>
            </div>
        </div>
    }

    @* === Quick Chart Switcher (visible when layers panel is closed) === *@
    @if (!chartPanelOpen && availableCharts.Count > 0)
    {
        <div class="chart-quick-bar">
            @foreach (var chart in availableCharts.Take(6))
            {
                bool active = enabledCharts.Contains(chart.Identifier);
                <button class="chart-quick-chip @(active ? "active" : "")"
                        @onclick="() => ToggleChart(chart, !active)">
                    @chart.Name
                </button>
            }
        </div>
    }

    @if (chartPanelOpen)
    {
        @* Click-outside-to-close: invisible backdrop covers the map beneath
           the panel. The panel sits at z-index:var(--z-controls), backdrop
           one layer under. LayersPanel itself stops click propagation via
           its own stopPropagation, so taps inside keep the panel open. *@
        <div class="panel-backdrop" @onclick="() => chartPanelOpen = false"></div>
        <LayersPanel AvailableCharts="availableCharts"
                     AvailableRoutes="availableRoutes"
                     FilteredCharts="FilteredCharts"
                     FilteredRoutes="FilteredRoutes"
                     LoadedWaypoints="loadedWaypoints"
                     LoadedNotes="loadedNotes"
                     NotesVisible="notesVisible"
                     OnFocusNote="FocusNote"
                     OnToggleNotesVisible="ToggleNotesVisible"
                     LoadedRegions="loadedRegions"
                     RegionsVisible="regionsVisible"
                     OnFocusRegion="FocusRegion"
                     OnToggleRegionsVisible="ToggleRegionsVisible"
                     Vessels="@BuildVesselList()"
                     Buddies="loadedBuddies"
                     EnabledCharts="enabledCharts"
                     EnabledRoutes="enabledRoutes"
                     ServerTrackVisible="serverTrackVisible"
                     WeatherOverlayVisible="weatherOverlayVisible"
                     LayerFilter="layerFilter"
                     LayerFilterChanged="OnLayerFilterChanged"
                     OnToggleChart="OnToggleChartCallback"
                     OnToggleRoute="OnToggleRouteCallback"
                     OnEditRoute="EditRoute"
                     OnNavigateToWaypoint="NavigateToWaypoint"
                     OnFocusVessel="FocusVessel"
                     OnRefreshBuddies="RefreshBuddiesAsync"
                     OnToggleServerTrack="ToggleServerTrack"
                     OnToggleWeatherOverlay="ToggleWeatherOverlay"
                     OnGpxImport="HandleGpxImport"
                     OnGpxExport="ExportGpx" />
    }
</div>

@code {
    // Timing constants. Implementation details; not user-configurable.
    private const int AisPushInitialDelayMs = 1_000;
    private const int AisPushIntervalMs = 3_000;
    private const int RouteStatsPollIntervalMs = 500;
    private const int RaceTimerTickMs = 1_000;
    private const int LaylinePushEveryNFixes = 5;
    /// <summary>Below this drift (m/s) the tidal current arrow is suppressed (~0.1 kn).</summary>
    private const double MinCurrentDriftMs = 0.05;
    /// <summary>GPX import size cap to prevent OOM on pathological input.</summary>
    private const long MaxGpxImportBytes = 10L * 1024 * 1024;

    private IJSObjectReference? module;
    private DotNetObjectReference<Map>? dotNetRef;
    private bool follow;
    private bool nightMode;
    private bool mobActive;
    private bool anchorManualActive;
    private bool mapInitialized;
    private bool chartPanelOpen;
    private bool fullscreen;
    private double? prevLat, prevLon;
    private System.Threading.Timer? aisTimer;
    // Active route navigation state.
    private string? lastActiveRouteHref;
    private double[][]? activeRouteCoords;
    private bool courseLineDrawn;
    private bool laylinesVisible;
    private bool measureActive;
    private int laylinesSkip;  // Throttle: update laylines every 5th position fix.
    private string mapOrientation = "north"; // "north", "course", "head"
    private string mapOrientationLabel = "N\u2191";
    // Route editing state.
    private bool routeEditMode;
    private string routeEditName = "";
    private string routeEditStats = "0 WP / 0 nm";
    private System.Threading.Timer? routeStatsTimer;
    // Context menu and waypoint state.
    private bool contextMenuVisible;
    private double contextMenuLat, contextMenuLon;
    private double contextMenuX, contextMenuY;
    private IReadOnlyList<SignalkBuddy> loadedBuddies = [];
    // Note / Region / Waypoint CRUD state + RouteWithWindHere live in
    // the Map.razor.cs code-behind; they all share the context-menu ->
    // dialog -> POST -> JS-marker shape and moving them out keeps
    // this file focused on map lifecycle and layout.
    // Race timer.
    private bool raceTimerActive;
    private bool shortcutsVisible;
    private DateTime raceTimerTarget;
    private System.Threading.Timer? raceTimer;
    private bool weatherOverlayVisible;
    private List<SignalkChart> availableCharts = [];
    private List<SignalkRoute> availableRoutes = [];
    private readonly HashSet<string> enabledCharts = [];
    private readonly HashSet<string> enabledRoutes = [];
    private bool serverTrackVisible;
    private string layerFilter = "";
    private double? viewWest, viewSouth, viewEast, viewNorth;

    // Cached filtered lists, rebuilt only when inputs change.
    private SignalkChart[] cachedFilteredCharts = [];
    private SignalkRoute[] cachedFilteredRoutes = [];
    private string lastFilterKey = "";

    private SignalkChart[] FilteredCharts => cachedFilteredCharts;
    private SignalkRoute[] FilteredRoutes => cachedFilteredRoutes;

    // Pre-computed route bounding boxes (avoids re-parsing GeoJSON on every filter).
    private readonly Dictionary<string, (double MinLat, double MaxLat, double MinLon, double MaxLon)?> routeBounds = [];

    private void OnLayerFilterChanged(string v)
    {
        layerFilter = v;
        RebuildFilteredLayers();
    }

    private void ToggleLayersPanel() => chartPanelOpen = !chartPanelOpen;

    private Task OnToggleChartCallback((SignalkChart chart, bool enabled) t) =>
        ToggleChart(t.chart, t.enabled);

    private Task OnToggleRouteCallback((SignalkRoute route, bool enabled) t) =>
        ToggleRoute(t.route, t.enabled);

    /// <summary>
    /// Snapshot of every known AIS vessel sorted by threat: vessels with a
    /// valid TCPA first (ascending), then the rest by raw distance. Built on
    /// demand from <see cref="AisStore"/> so the layers panel always reflects
    /// the latest fixes without subscribing to AIS updates directly.
    /// </summary>
    private IReadOnlyList<VesselListEntry> BuildVesselList()
    {
        var vessels = AisStore.GetVessels();
        if (vessels.Length == 0) return [];

        var ownLat = Data.Latitude;
        var ownLon = Data.Longitude;
        var ownCog = Data.CourseOverGround;
        var ownSog = Data.SpeedOverGround;

        var entries = new List<VesselListEntry>(vessels.Length);
        foreach (var v in vessels)
        {
            if (v.Latitude is null || v.Longitude is null) continue;

            double? distNm = null, brgDeg = null;
            if (ownLat is not null && ownLon is not null)
            {
                distNm = HaversineNm(ownLat.Value, ownLon.Value, v.Latitude.Value, v.Longitude.Value);
                brgDeg = BearingDeg(ownLat.Value, ownLon.Value, v.Latitude.Value, v.Longitude.Value);
            }

            Cpa.Result? cpa = null;
            Colregs.Result? colregs = null;
            if (ownLat is not null && ownLon is not null)
            {
                cpa = Cpa.Compute(
                    ownLat.Value, ownLon.Value, ownCog, ownSog,
                    v.Latitude.Value, v.Longitude.Value, v.CourseOverGround, v.SpeedOverGround);

                if (ownCog is not null && ownSog is not null
                    && v.CourseOverGround is not null && v.SpeedOverGround is not null)
                {
                    colregs = Colregs.Classify(
                        ownLat.Value, ownLon.Value, ownCog.Value, ownSog.Value,
                        v.Latitude.Value, v.Longitude.Value, v.CourseOverGround.Value, v.SpeedOverGround.Value);
                }
            }

            string? colregsLabel = colregs is { Category: var cat and not Colregs.Category.Indeterminate }
                ? Colregs.ShortLabel(cat) : null;
            string? colregsRole = colregs is { Role: var role and not Colregs.Role.None }
                ? Colregs.RoleLabel(role) : null;

            entries.Add(new VesselListEntry(
                Context: v.Context,
                DisplayName: v.Name ?? v.Callsign ?? (v.Mmsi is not null ? $"MMSI {v.Mmsi}" : v.Context),
                Mmsi: v.Mmsi,
                CpaNm: cpa?.CpaNm,
                TcpaMin: cpa?.TcpaMin,
                DistanceNm: distNm,
                BearingDeg: brgDeg,
                SogKn: v.SpeedOverGround is not null ? v.SpeedOverGround * Format.MsToKnots : null,
                ShipType: v.ShipType,
                IsBuddy: v.IsBuddy,
                ColregsLabel: colregsLabel,
                ColregsRole: colregsRole));
        }

        // TCPA-sorted; non-converging vessels fall to the bottom, sorted by distance.
        entries.Sort((a, b) =>
        {
            bool aHas = a.TcpaMin is not null;
            bool bHas = b.TcpaMin is not null;
            if (aHas && bHas) return a.TcpaMin!.Value.CompareTo(b.TcpaMin!.Value);
            if (aHas) return -1;
            if (bHas) return 1;
            return (a.DistanceNm ?? double.MaxValue).CompareTo(b.DistanceNm ?? double.MaxValue);
        });
        return entries;
    }

    /// <summary>
    /// Calls a SignalK resources-API loader and swallows HTTP/network
    /// failures so a missing plugin or unreachable server does not take the
    /// whole page down. Returns null on failure; callers coalesce to an
    /// empty list. A Toast surfaces the error so the captain knows.
    /// </summary>
    private async Task<T?> SafeLoad<T>(Func<Task<T>> loader, string what) where T : class
    {
        try { return await loader(); }
        catch (HttpRequestException ex)
        {
            Toasts.Error($"Couldn't load {what}: {ex.Message}");
            return null;
        }
        catch (TaskCanceledException)
        {
            Toasts.Error($"Timed out loading {what}");
            return null;
        }
    }

    private async Task FocusVessel(string context)
    {
        if (module is null) return;
        chartPanelOpen = false;
        try { await module.InvokeVoidAsync("focusVessel", context); }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
    }

    private static double HaversineNm(double lat1, double lon1, double lat2, double lon2)
    {
        const double R = 6371000;
        double dLat = (lat2 - lat1) * Math.PI / 180;
        double dLon = (lon2 - lon1) * Math.PI / 180;
        double a = Math.Sin(dLat / 2) * Math.Sin(dLat / 2) +
                   Math.Cos(lat1 * Math.PI / 180) * Math.Cos(lat2 * Math.PI / 180) *
                   Math.Sin(dLon / 2) * Math.Sin(dLon / 2);
        double meters = R * 2 * Math.Atan2(Math.Sqrt(a), Math.Sqrt(1 - a));
        return meters / 1852.0;
    }

    private static double BearingDeg(double lat1, double lon1, double lat2, double lon2)
    {
        double rad1 = lat1 * Math.PI / 180, rad2 = lat2 * Math.PI / 180;
        double dLon = (lon2 - lon1) * Math.PI / 180;
        double y = Math.Sin(dLon) * Math.Cos(rad2);
        double x = Math.Cos(rad1) * Math.Sin(rad2) - Math.Sin(rad1) * Math.Cos(rad2) * Math.Cos(dLon);
        double deg = Math.Atan2(y, x) * 180.0 / Math.PI;
        return (deg + 360) % 360;
    }

    private void RebuildFilteredLayers()
    {
        // Build a cache key from the inputs that affect filtering.
        var key = $"{layerFilter}|{viewWest:F4}|{viewSouth:F4}|{viewEast:F4}|{viewNorth:F4}|{availableCharts.Count}|{availableRoutes.Count}";
        if (key == lastFilterKey) return;
        lastFilterKey = key;

        cachedFilteredCharts = availableCharts
            .Where(c => (string.IsNullOrEmpty(layerFilter) || c.Name.Contains(layerFilter, StringComparison.OrdinalIgnoreCase))
                     && ChartIntersectsViewport(c))
            .ToArray();

        cachedFilteredRoutes = availableRoutes
            .Where(r => (string.IsNullOrEmpty(layerFilter) || (r.Name ?? r.Id).Contains(layerFilter, StringComparison.OrdinalIgnoreCase))
                     && RouteIntersectsViewport(r))
            .ToArray();
    }


    private NavigationData Data => SignalkClient.Data;

    /// <summary>Last non-null heading (radians). Keeps compass needle pointing
    /// in a stable direction if the SignalK feed briefly drops Heading.</summary>
    private double? lastHeading;

    private async void HandleConnectionChanged()
    {
        try { await InvokeAsync(StateHasChanged); }
        catch (ObjectDisposedException) { }
    }

    // Connection status chip (visible on the map, including fullscreen).
    private string ConnClass => SignalkClient.IsConnected
        ? (SignalkClient.IsDataStale ? "stale" : "live")
        : "offline";
    private string ConnLabel => SignalkClient.IsConnected
        ? (SignalkClient.IsDataStale ? "Stale" : "Live")
        : "Offline";
    private string ConnTooltip => SignalkClient.IsConnected
        ? (SignalkClient.IsDataStale ? "Connected but no data for 5+ seconds" : "Receiving live data")
        : "WebSocket disconnected";

    // Anchor state: server anchor takes priority over manual.
    private bool AnchorButtonActive => Data.AnchorActive || anchorManualActive;

    // Anchor alarm: red when current radius exceeds max radius.
    private bool AnchorDragging => Data.AnchorActive
        && Data.AnchorCurrentRadius is not null
        && Data.AnchorMaxRadius is not null
        && Data.AnchorCurrentRadius > Data.AnchorMaxRadius;

    // Track whether we've already drawn the server anchor on the map.
    private bool serverAnchorDrawn;
    private double lastPushedAnchorRadius;

    /// <summary>First-run long-press hint state. Shown once per device on
    /// touch devices only (gated in CSS via <c>@@media (pointer: coarse)</c>).
    /// Stored behind a KV flag so desktop-devtools and QA runs also see
    /// it once, not every reload.</summary>
    private const string TouchCoachmarkKey = "hints.mapLongPress.dismissed";
    private bool touchCoachmarkVisible;
    private System.Threading.Timer? touchCoachmarkTimer;

    /// <summary>First-visit welcome card. Versioned KV key so a future
    /// welcome revision can re-trigger the card ("welcome.v2.dismissed").
    /// Shown on first-ever run; the touch coachmark (for long-press
    /// discovery) is suppressed on that first visit because the welcome
    /// already explains long-press.</summary>
    private const string WelcomeKey = "hints.welcome.v1.dismissed";
    private bool welcomeVisible;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/leafletInterop.js");
        dotNetRef = DotNetObjectReference.Create(this);

        double lat = Data.Latitude ?? 0;
        double lon = Data.Longitude ?? 0;
        int zoom = Data.Latitude is not null ? 14 : 3;

        await module.InvokeVoidAsync("initMap", "mapDiv", lat, lon, zoom, dotNetRef);
        mapInitialized = true;

        // Load existing track as speed-colored segments.
        var points = TrackBuffer.GetSnapshot();
        if (points.Length > 0)
        {
            var jsPoints = points.Select(p => new[] { p.Latitude, p.Longitude, p.SpeedOverGround ?? 0 }).ToArray();
            await module.InvokeVoidAsync("setColoredTrack", (object)jsPoints);
            prevLat = points[^1].Latitude;
            prevLon = points[^1].Longitude;
        }

        // Load available charts and routes from SignalK server. Any of these
        // endpoints can 404 or time out (SignalK unreachable, plugin not
        // installed, webapp running standalone for dev). Degrade gracefully
        // - the map itself is still usable without these.
        availableCharts = await SafeLoad(() => ChartApi.GetAllAsync(), "charts") ?? [];
        availableRoutes = await SafeLoad(() => RouteApi.GetAllAsync(), "routes") ?? [];
        loadedWaypoints = await SafeLoad(() => WaypointApi.GetAllAsync(), "waypoints") ?? [];
        loadedNotes = await SafeLoad(() => NoteApi.GetAllAsync(), "notes") ?? [];
        loadedRegions = await SafeLoad(() => RegionApi.GetAllAsync(), "regions") ?? [];

        // Optional: buddy-list plugin. Silently no-ops if not installed.
        // The returned list seeds AisStore so vessels tracked later get
        // IsBuddy set on creation; live updates still come via the `buddy`
        // delta path.
        var buddies = await BuddyListApi.GetAllAsync();
        if (buddies is not null)
        {
            loadedBuddies = buddies;
            AisStore.UpdateBuddies(buddies.Select(b => $"vessels.{b.Urn}"));
        }
        PrecomputeRouteBounds();
        RebuildFilteredLayers();
        StateHasChanged();

        // Draw waypoint markers on the map.
        foreach (var wp in loadedWaypoints)
        {
            if (wp.Latitude is not null && wp.Longitude is not null)
                await module.InvokeVoidAsync("addWaypointMarker", wp.Id, wp.Latitude, wp.Longitude, wp.Name);
        }

        // Draw note markers. Notes use a bare position (not a GeoJSON
        // Feature); GetAllAsync has already filtered out entries without
        // a position, so the nullability check is just defensive.
        foreach (var n in loadedNotes)
        {
            if (n.Position is not null)
                await module.InvokeVoidAsync("addNoteMarker",
                    n.Id, n.Position.Latitude, n.Position.Longitude, n.Title, n.Description);
        }

        // Draw region polygons. OuterRings is in Leaflet [lat, lon]
        // order already, one ring per polygon (MultiPolygon produces
        // multiple).
        foreach (var r in loadedRegions)
        {
            await module.InvokeVoidAsync("addRegion",
                r.Id, r.OuterRings, r.Name, r.Description);
        }

        // Restore persisted settings (including enabled charts/routes) before
        // applying defaults so user choices survive a reload.
        await Settings.InitializeAsync();

        if (Settings.EnabledChartIds.Count > 0)
        {
            foreach (var chart in availableCharts)
                if (Settings.EnabledChartIds.Contains(chart.Identifier))
                    await ToggleChart(chart, true);
        }
        else
        {
            // First run: auto-enable OpenSeaMap-named charts.
            foreach (var chart in availableCharts)
            {
                if (chart.Name.Contains("seamap", StringComparison.OrdinalIgnoreCase)
                    || chart.Name.Contains("sea map", StringComparison.OrdinalIgnoreCase))
                {
                    await ToggleChart(chart, true);
                }
            }
        }

        foreach (var route in availableRoutes)
            if (Settings.EnabledRouteIds.Contains(route.Id))
                await ToggleRoute(route, true);

        follow = Settings.FollowBoat;
        nightMode = Settings.NightMode;
        laylinesVisible = Settings.LaylinesVisible;
        mapOrientation = Settings.MapOrientation;
        mapOrientationLabel = mapOrientation switch { "course" => "C\u2191", "head" => "H\u2191", _ => "N\u2191" };

        await module.InvokeVoidAsync("setFollow", follow);
        if (nightMode) await module.InvokeVoidAsync("setNightMode", true);
        if (mapOrientation != "north") await module.InvokeVoidAsync("setMapOrientation", mapOrientation);

        await PushGuardZoneAsync();
        Settings.OnSettingsChanged += HandleSettingsChanged;

        SignalkClient.OnDataChanged += HandleDataChanged;
        SignalkClient.OnConnectionChanged += HandleConnectionChanged;
        aisTimer = new System.Threading.Timer(_ => _ = PushAisTargets(), null, AisPushInitialDelayMs, AisPushIntervalMs);

        await module.InvokeVoidAsync("enableKeyboardShortcuts", dotNetRef);

        // Welcome card takes precedence over the touch coachmark on
        // first-ever visit since it covers long-press explicitly.
        var welcomeShown = await MaybeShowWelcomeAsync();
        if (!welcomeShown) await MaybeShowTouchCoachmarkAsync();
    }

