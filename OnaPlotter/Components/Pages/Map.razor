    /// <summary>Sets a radar's power state via REST and re-syncs the
    /// device list afterwards so the UI reflects the new value. Only
    /// <see cref="RadarPower.Standby"/> and <see cref="RadarPower.Transmit"/>
    /// are user-settable on a healthy radar; the others are radar-
    /// internal transitions. No confirm prompt; the operator owns the
    /// boat.</summary>
    public async Task SetRadarPowerAsync(string radarId, RadarPower power)
    {
        if (string.IsNullOrEmpty(radarId)) return;
        var body = new ControlValue
        {
            Value = JsonSerializer.SerializeToElement((int)power),
        };
        try
        {
            var r = await RadarApi.SetControlAsync(radarId, "power", body);
            if (!r.Success) { Toasts.Error($"Radar power change failed: {r.Error ?? "server rejected"}"); return; }
        }
        catch (Exception ex) { Toasts.LogException(ex, "Radar power change"); return; }
        // Targeted refresh: only re-fetch the radar list (1 GET),
        // not the broad resource refresh (which fired 5+ unrelated
        // GETs for waypoints / routes / notes / regions / charts).
        await RefreshRadarsAsync();
        // Schedule a follow-up: HALO transitions standby <-> transmit
        // through an intermediate "off" / "preparing" status that
        // Mayara reports for ~1s. The first refresh catches that
        // transient; the follow-up catches the settled state without
        // making the helm click a second time.
        ScheduleRadarRefreshAfter(TimeSpan.FromMilliseconds(1500));
    }

    public async Task SetRadarRangeAsync(string radarId, int rangeMeters)
    {
        if (string.IsNullOrEmpty(radarId) || rangeMeters <= 0) return;
        // Body shape (string-valued, not numeric) lives on the DTO so
        // the wire-shape contract is testable without spinning up a
        // Razor host. See ControlValue.ForRange for the SK quirk that
        // motivates the string form.
        var body = ControlValue.ForRange(rangeMeters);
        try
        {
            var r = await RadarApi.SetControlAsync(radarId, "range", body);
            if (!r.Success) { Toasts.Error($"Radar range change failed: {r.Error ?? "server rejected"}"); return; }
        }
        catch (Exception ex) { Toasts.LogException(ex, "Radar range change"); return; }
        // Range writes apply immediately on Mayara -- a single
        // targeted refresh is enough; no transitional state to
        // wait through.
        await RefreshRadarsAsync();
    }

    // Re-fetch ONLY the radar list and feed it through the manager.
    // Avoids the broad RefreshServerResourcesAsync which also pulls
    // waypoints / routes / notes / regions / charts -- noise the
    // operator's network tab fills up with on every Transmit click.
    // The Mayara SK plugin doesn't publish radar paths over the SK
    // WebSocket delta stream (probed against openplotter -- 195
    // unique paths, zero radar-related), so REST polling is the only
    // way to learn about state changes.
    private async Task RefreshRadarsAsync()
    {
        try
        {
            var radars = await RadarApi.GetAllAsync();
            await RadarOverlay.OnRadarListUpdatedAsync(radars);
            StateHasChanged();
        }
        catch (Exception) { /* next regular poll retries */ }
    }

    private void ScheduleRadarRefreshAfter(TimeSpan delay)
    {
        _ = Task.Delay(delay).ContinueWith(_ =>
            InvokeAsync(RefreshRadarsAsync));
    }

