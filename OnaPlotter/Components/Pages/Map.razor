    /// <summary>
    /// Snapshot of every known AIS vessel sorted by threat: vessels with a
    /// valid TCPA first (ascending), then the rest by raw distance. Built on
    /// demand from <see cref="AisStore"/> so the layers panel always reflects
    /// the latest fixes without subscribing to AIS updates directly.
    /// </summary>
    private IReadOnlyList<VesselListEntry> BuildVesselList()
    {
        var vessels = AisStore.GetVessels();
        if (vessels.Length == 0) return [];

        var ownLat = Data.Latitude;
        var ownLon = Data.Longitude;
        var ownCog = Data.CourseOverGround;
        var ownSog = Data.SpeedOverGround;

        // Pre-compute own-ship sin/cos of COG ONCE for the per-vessel
        // CPA pass below. Skips the trig + null-checks N times per
        // BuildVesselList tick. Null is fine - inner loop's
        // ownLat-null guard already handles the missing-own-ship case.
        var ownSnap = (ownLat is not null && ownLon is not null)
            ? Cpa.PrecomputeOwn(ownLat.Value, ownLon.Value, ownCog, ownSog)
            : null;

        var entries = new List<VesselListEntry>(vessels.Length);
        foreach (var v in vessels)
        {
            if (v.Latitude is null || v.Longitude is null) continue;

            double? distNm = null, brgDeg = null;
            if (ownLat is not null && ownLon is not null)
            {
                distNm = HaversineNm(ownLat.Value, ownLon.Value, v.Latitude.Value, v.Longitude.Value);
                brgDeg = BearingDeg(ownLat.Value, ownLon.Value, v.Latitude.Value, v.Longitude.Value);
            }

            Cpa.Result? cpa = null;
            Colregs.Result? colregs = null;
            if (ownLat is not null && ownLon is not null)
            {
                cpa = ownSnap is not null
                    ? Cpa.Compute(
                        ownSnap.Value,
                        v.Latitude.Value, v.Longitude.Value,
                        v.CourseOverGround, v.SpeedOverGround)
                    : null;

                if (ownCog is not null && ownSog is not null
                    && v.CourseOverGround is not null && v.SpeedOverGround is not null)
                {
                    colregs = Colregs.Classify(
                        ownLat.Value, ownLon.Value, ownCog.Value, ownSog.Value,
                        v.Latitude.Value, v.Longitude.Value, v.CourseOverGround.Value, v.SpeedOverGround.Value);
                }
            }

            string? colregsLabel = colregs is { Category: var cat and not Colregs.Category.Indeterminate }
                ? Colregs.ShortLabel(cat) : null;
            string? colregsRole = colregs is { Role: var role and not Colregs.Role.None }
                ? Colregs.RoleLabel(role) : null;

            entries.Add(new VesselListEntry(
                Context: v.Context,
                DisplayName: v.Name ?? v.Callsign ?? (v.Mmsi is not null ? $"MMSI {v.Mmsi}" : v.Context),
                Mmsi: v.Mmsi,
                CpaNm: cpa?.CpaNm,
                TcpaMin: cpa?.TcpaMin,
                DistanceNm: distNm,
                BearingDeg: brgDeg,
                SogKn: v.SpeedOverGround is not null ? v.SpeedOverGround * Format.MsToKnots : null,
                ShipType: v.ShipType,
                IsBuddy: v.IsBuddy,
                ColregsLabel: colregsLabel,
                ColregsRole: colregsRole,
                LengthOverallMeters: v.LengthOverallMeters,
                BeamMeters: v.BeamMeters));
        }

        // TCPA-sorted; non-converging vessels fall to the bottom, sorted by distance.
        entries.Sort((a, b) =>
        {
            bool aHas = a.TcpaMin is not null;
            bool bHas = b.TcpaMin is not null;
            if (aHas && bHas) return a.TcpaMin!.Value.CompareTo(b.TcpaMin!.Value);
            if (aHas) return -1;
            if (bHas) return 1;
            return (a.DistanceNm ?? double.MaxValue).CompareTo(b.DistanceNm ?? double.MaxValue);
        });
        return entries;
    }

    /// <summary>
    /// Calls a SignalK resources-API loader and swallows HTTP/network
    /// failures so a missing plugin or unreachable server does not take the
    /// whole page down. Returns null on failure; callers coalesce to an
    /// empty list. A Toast surfaces the error so the captain knows.
    /// While SignalK is offline we suppress these per-resource toasts:
    /// the connection chip (top-left) and the first-run "server unreachable"
    /// toast already convey the situation, and stacking five "Couldn't load
    /// X: TypeError: Failed to fetch" toasts on a fresh-device first paint
    /// reads as "broken app" rather than "server isn't reachable".
    /// </summary>
    private async Task<T?> SafeLoad<T>(Func<Task<T>> loader, string what) where T : class
    {
        try { return await loader(); }
        catch (HttpRequestException ex)
        {
            if (SignalkClient.IsConnected)
                Toasts.LogException(ex, $"Load {what}");
            return null;
        }
        catch (TaskCanceledException)
        {
            if (SignalkClient.IsConnected)
                Toasts.Error($"Timed out loading {what}");
            return null;
        }
    }

    private async Task FocusVessel(string context)
    {
        if (_aisJs is null || _controlsJs is null) return;
        chartPanelOpen = false;
        // Follow-boat mode re-centres on own boat on every position
        // update (roughly once per second), so focusVessel's panTo was
        // being overwritten within 1 s - the user saw a brief flash
        // of the selected vessel, then a snap back to own boat. Treat
        // "tap a vessel in the list" as the user asking for a look at
        // that vessel; follow has to let go. Keyboard / F-toggle /
        // Centre-on-boat button are the explicit way back.
        bool wasFollowing = follow;
        await DisableFollowAsync();
        bool found = await _aisJs.FocusVesselAsync(context);
        if (!found)
        {
            // The JS side couldn't find the marker - vessel aged
            // out, AIS filter hid it, or the list was stale.
            // Toast + put follow back where it was so the helm
            // doesn't lose their view for a no-op tap.
            Toasts.Info("Vessel out of range or AIS feed lost");
            if (wasFollowing)
            {
                follow = true;
                await Settings.SetFollowBoatAsync(true);
                await _controlsJs.SetFollowAsync(true);
            }
        }
    }

    private static double HaversineNm(double lat1, double lon1, double lat2, double lon2)
    {
        const double R = 6371000;
        double dLat = (lat2 - lat1) * Math.PI / 180;
        double dLon = (lon2 - lon1) * Math.PI / 180;
        double a = Math.Sin(dLat / 2) * Math.Sin(dLat / 2) +
                   Math.Cos(lat1 * Math.PI / 180) * Math.Cos(lat2 * Math.PI / 180) *
                   Math.Sin(dLon / 2) * Math.Sin(dLon / 2);
        double meters = R * 2 * Math.Atan2(Math.Sqrt(a), Math.Sqrt(1 - a));
        return meters / 1852.0;
    }

    private static double BearingDeg(double lat1, double lon1, double lat2, double lon2)
    {
        double rad1 = lat1 * Math.PI / 180, rad2 = lat2 * Math.PI / 180;
        double dLon = (lon2 - lon1) * Math.PI / 180;
        double y = Math.Sin(dLon) * Math.Cos(rad2);
        double x = Math.Cos(rad1) * Math.Sin(rad2) - Math.Sin(rad1) * Math.Cos(rad2) * Math.Cos(dLon);
        double deg = Math.Atan2(y, x) * 180.0 / Math.PI;
        return (deg + 360) % 360;
    }

    private void RebuildFilteredLayers()
    {
        // Bucket the bounds at 4 decimals so a 1 m pan jitter doesn't
        // invalidate the cache. Same shape as the previous string-
        // interpolated key but compares via record-struct .Equals
        // without the per-call string allocation.
        static double R(double? v) => v is double x ? Math.Round(x, 4) : 0;
        var key = new FilterCacheKey(
            layerFilter ?? "",
            R(viewWest), R(viewSouth), R(viewEast), R(viewNorth),
            availableCharts.Count, availableRoutes.Count,
            loadedWaypoints.Count, loadedNotes.Count);
        if (key.Equals(lastFilterKey)) return;
        lastFilterKey = key;

        cachedFilteredCharts = availableCharts
            .Where(c => (string.IsNullOrEmpty(layerFilter) || c.Name.Contains(layerFilter, StringComparison.OrdinalIgnoreCase))
                     && ChartIntersectsViewport(c))
            .ToArray();

        cachedFilteredRoutes = availableRoutes
            .Where(r => (string.IsNullOrEmpty(layerFilter) || (r.Name ?? r.Id).Contains(layerFilter, StringComparison.OrdinalIgnoreCase))
                     && RouteIntersectsViewport(r))
            .ToArray();

        cachedFilteredWaypoints = loadedWaypoints
            .Where(wp => (string.IsNullOrEmpty(layerFilter)
                          || (wp.Name?.Contains(layerFilter, StringComparison.OrdinalIgnoreCase) ?? false)
                          || wp.Id.Contains(layerFilter, StringComparison.OrdinalIgnoreCase))
                     && WaypointIntersectsViewport(wp))
            .ToArray();

        cachedFilteredNotes = loadedNotes
            .Where(n => (string.IsNullOrEmpty(layerFilter)
                         || (n.Title?.Contains(layerFilter, StringComparison.OrdinalIgnoreCase) ?? false)
                         || (n.Description?.Contains(layerFilter, StringComparison.OrdinalIgnoreCase) ?? false))
                     && NoteIntersectsViewport(n))
            .ToArray();
    }

    /// <summary>Point-in-bbox test for a waypoint. Mirrors
    /// ChartIntersectsViewport / RouteIntersectsViewport: when bounds
    /// haven't been observed yet (first paint, before the initial
    /// moveend), fall through to "always show" so the panel isn't
    /// briefly empty. Waypoints with missing lat/lon are treated as
    /// "show always" too - a waypoint without a fix is degenerate
    /// data and hiding it would leave the helm wondering where it
    /// went.</summary>
    private bool WaypointIntersectsViewport(SignalkWaypoint wp)
    {
        if (viewWest is null) return true;
        if (wp.Latitude is not double lat || wp.Longitude is not double lon) return true;
        return lat >= viewSouth && lat <= viewNorth
            && lon >= viewWest && lon <= viewEast;
    }

    /// <summary>Point-in-bbox test for a note. Same fallback rules as
    /// the waypoint variant - missing position or pre-bounds state
    /// keeps the note in the panel rather than dropping it silently.
    /// </summary>
    private bool NoteIntersectsViewport(SignalkNote note)
    {
        if (viewWest is null) return true;
        if (note.Position is null) return true;
        double lat = note.Position.Latitude;
        double lon = note.Position.Longitude;
        return lat >= viewSouth && lat <= viewNorth
            && lon >= viewWest && lon <= viewEast;
    }


    private NavigationData Data => SignalkClient.Data;

    /// <summary>Last non-null heading (radians). Keeps compass needle pointing
    /// in a stable direction if the SignalK feed briefly drops Heading.</summary>
    private double? lastHeading;

    private async void HandleConnectionChanged()
    {
        // Connection-state UI only - the chip + the chart-bound
        // banner colour depend on this re-render. MOB cross-reload
        // recovery used to live here too but now owns its own
        // OnConnectionChanged subscription inside MobService, so
        // the reconcile runs regardless of which page the helm is
        // on (Map.razor is not safety-critical infrastructure).
        try { await InvokeAsync(StateHasChanged); }
        catch (ObjectDisposedException) { }
    }

    // Anchor state: server-driven only (signalk-anchoralarm-plugin
    // v2.0.0+ is required; the legacy JS-only manual fallback was
    // removed because the helm explicitly required the plugin).
    private bool AnchorButtonActive => Data.AnchorActive;

    // Anchor alarm: red when current radius exceeds max radius.
    private bool AnchorDragging => Data.AnchorActive
        && Data.AnchorCurrentRadius is not null
        && Data.AnchorMaxRadius is not null
        && Data.AnchorCurrentRadius > Data.AnchorMaxRadius;

    // Depth trend over the last minute, in metres per minute.
    // Computed lazily from TrackBuffer; null when we don't have enough
    // samples yet or the depth plugin isn't publishing.
    private double? depthTrendMpm =>
        TrackBuffer.GetDepthTrendMetersPerMinute(TimeSpan.FromMinutes(1));

    // Server anchor visualisation + raise-confirmation watchdog live in
    // ServerAnchorSync; the page hands the controller per-tick deltas
    // and the manual-clear callback. Created in OnAfterRenderAsync once
    // the JS module is loaded.
    private OnaPlotter.Services.Js.MapAnchorJs? _anchorJs;
    private OnaPlotter.Services.Map.ServerAnchorSync? _anchorSync;

    // Course-stop watchdog state lives on ActiveRouteSync. The page
    // reads CourseStopPending for HUD-card binding and calls
    // MarkCourseStopPending() from the StopNavigation flow.

    // First-visit welcome + touch coachmark state moved to
    // Map.FirstRun.razor.cs so the onboarding overlays stay together.
    // Fields referenced from the markup (welcomeVisible, touchCoachmarkVisible)
    // are declared in that partial.

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Initial-render setup is a long sequence of JS interop calls
        // (initMap, REST seeds, marker pushes, settings restores). If the
        // helm navigates AWAY mid-load, DisposeAsync runs concurrently
        // and disposes `module`; any in-flight InvokeVoidAsync that
        // resumes after that throws ObjectDisposedException, which
        // bubbled out of OnAfterRenderAsync as an unhandled render
        // exception and tripped the Blazor error boundary. JSDisconnected
        // is the same idea for the SignalR-circuit case. Wrapping the
        // whole body keeps a navigate-away-during-load benign instead of
        // crashing the renderer.
        try
        {
        module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/leafletInterop.js");
        dotNetRef = DotNetObjectReference.Create(this);

        // Hand the loaded module to the radar overlay host so the
        // manager can drive it. Wired here (not in DI) because the
        // module reference only exists after the import resolves.
        // Toast surface plugged in once - the manager calls back
        // through here on overlay-start failures.
        RadarOverlayHost.SetModule(module);
        RadarOverlay.OnError = msg => Toasts.Error(msg);

        // Per-tick / per-event sync controllers. Each owns a slice of
        // Map.razor's old "diff state + interop pipeline" and the page
        // becomes a thin wiring layer that forwards data + UI events.
        // Constructed once the JS module is available; disposed
        // implicitly on page unload via the JS wrappers' MarkDisposed
        // hooks that the page calls in DisposeAsync.
        _anchorJs = new OnaPlotter.Services.Js.MapAnchorJs(module);
        _anchorSync = new OnaPlotter.Services.Map.ServerAnchorSync(
            _anchorJs,
            isSignalKConnected: () => SignalkClient.IsConnected,
            raiseTimeoutWarning: msg => Toasts.Warning(msg));
        _routeJs = new OnaPlotter.Services.Js.MapRouteJs(module);
        // _controlsJs hoisted above _activeRouteSync because the
        // route sync uses it (SetRangeScaleHiddenAsync) to hide the
        // bottom-centre range scale while the route HUD card sits
        // in that slot. Other wrappers stay in their current order.
        _controlsJs = new OnaPlotter.Services.Js.MapControlsJs(module);
        _activeRouteSync = new OnaPlotter.Services.Map.ActiveRouteSync(
            _routeJs,
            _controlsJs,
            RouteApi,
            isSignalKConnected: () => SignalkClient.IsConnected,
            stopTimeoutWarning: msg => Toasts.Warning(msg))
        {
            // When the active route changes, restore the previously-
            // suppressed regular polyline if it's still enabled. The
            // page owns the available-routes list + AddRouteToMap helper
            // so the controller calls back through here.
            OnRestoreSuppressedRoute = async id =>
            {
                var prevRoute = availableRoutes.FirstOrDefault(r => r.Id == id);
                if (prevRoute is not null) await AddRouteToMap(prevRoute);
            },
            // Per-tick frame-builder flag lives on the page; the
            // controller signals here so the next frame redraws the
            // course line from scratch instead of treating it as
            // already drawn.
            OnActiveOverlayCleared = () => _frameBuilder.CourseLineDrawn = false,
        };
        _aisJs = new OnaPlotter.Services.Js.MapAisJs(module);
        _aisPush = new OnaPlotter.Services.Map.AisPushService(
            _aisJs, AisStore, MooredVessels, Settings, Time);
        _atonPush = new OnaPlotter.Services.Map.AtonPushService(_aisJs, Atons);
        _marinePoiJs = new OnaPlotter.Services.Js.MapMarinePoiJs(module);
        _marinePoi = new OnaPlotter.Services.Map.MarinePoiController(
            MarinePois, MarinePoiCache, _marinePoiJs, Settings, MarinePoiLogger);
        _overlaysJs = new OnaPlotter.Services.Js.MapOverlaysJs(module);
        _weather = new OnaPlotter.Services.Map.WeatherOverlayController(_overlaysJs, Settings);
        // Seed from persisted settings so a helm's last picked window /
        // resolution / clip-to-bounds choice carries across reloads.
        _serverTrack = new OnaPlotter.Services.Map.ServerTrackController(
            _overlaysJs, TrackApi, msg => Toasts.Info(msg),
            initialDuration: Settings.ServerTrackDuration,
            initialResolution: Settings.ServerTrackResolution,
            initialWithinBounds: Settings.ServerTrackWithinBounds);
        _charts = new OnaPlotter.Services.Map.ChartLayerController(
            _overlaysJs, Settings, Settings,
            toastError: (chartName, msg) => Toasts.Error($"Chart {chartName}: {msg}"))
        {
            // Re-sort the page-side availableCharts list when the
            // controller mutates the persisted draw order. The
            // markup binds against availableCharts directly so the
            // re-sort propagates without an extra render call.
            OnChartOrderChanged = ReSortAvailableCharts,
        };
        _resourceJs = new OnaPlotter.Services.Js.MapResourceJs(module);
        _resources = new OnaPlotter.Services.Map.MapResourceController(_resourceJs);
        _editJs = new OnaPlotter.Services.Js.MapEditJs(module);

        // Prefer the persisted view so re-opening the app lands where
        // the user left off. FollowBoat, when on, will pan to the boat
        // position on the first delta anyway, so preferring the saved
        // view doesn't fight the follow mode. Fallback order:
        //  1. Persisted view from IAppSettings (mapView.v1)
        //  2. Current boat position at zoom 14
        //  3. World view centred at (0,0) at zoom 3
        double lat;
        double lon;
        int zoom;
        if (Settings.MapViewLat is double vlat && Settings.MapViewLon is double vlon
            && Settings.MapViewZoom is int vzoom)
        {
            lat = vlat; lon = vlon; zoom = vzoom;
        }
        else if (Data.Latitude is double dlat && Data.Longitude is double dlon)
        {
            lat = dlat; lon = dlon; zoom = 14;
        }
        else
        {
            lat = 0; lon = 0; zoom = 3;
        }

        // Bare interop: page-load bootstrap that mounts Leaflet and
        // hooks the JS side into the .NET dotNetRef. None of the
        // feature wrappers cover this primitive; it's the call that
        // makes them all subsequently work.
        // Resolve the slow-client flag in C# first so the JS side
        // doesn't have to detect it: pass the boolean into initMap so
        // tile/renderer choices flow from the same source the rest of
        // the C# perf gates use.
        await ClientCaps.InitializeAsync();
        await module.InvokeVoidAsync("initMap", "mapDiv", lat, lon, zoom, dotNetRef,
            ClientCaps.IsSlowClient);
        mapInitialized = true;

        // Tell the JS side where the SignalK server lives so its
        // origin-bound URLs (flag images today; future direct hits
        // tomorrow) target the configured server rather than the
        // page origin. With the default same-origin setup this
        // pushes "" and existing relative URLs keep working.
        await _controlsJs.SetSignalKBaseUrlAsync(SkBaseUrl.BaseUrl);

        // Auto-enable the server-side ship track if the helm's last
        // setting was on (default true). The controller fetches +
        // pushes asynchronously; we don't await so the rest of the
        // page bootstrap (chart load, route fetch) doesn't block on
        // a slow history endpoint.
        if (Settings.ServerTrackVisible && _serverTrack is not null)
            _ = _serverTrack.ToggleAsync(true);

        // Load existing track as speed-colored segments. Skipped when
        // the helm has the local-trail toggle off; we still seed
        // PrevLat / PrevLon so a re-enable later starts the trail
        // from the correct previous fix without a one-tick gap.
        var points = TrackBuffer.GetSnapshot();
        if (points.Length > 0)
        {
            if (Settings.LocalTrackVisible)
            {
                var jsPoints = points.Select(p => new[] { p.Latitude, p.Longitude, p.SpeedOverGround ?? 0 }).ToArray();
                await _overlaysJs.SetColoredTrackAsync(jsPoints);
            }
            _frameBuilder.PrevLat = points[^1].Latitude;
            _frameBuilder.PrevLon = points[^1].Longitude;
        }

        // Wire ResourceStore subscriptions BEFORE we read the
        // snapshot below so a delta / startup-load completion that
        // lands between the read and the subscribe doesn't fall on
        // the floor. The per-id handlers go through the batch-drain
        // pattern (DrainPendingRouteChangesAsync etc.) so a Replace
        // that fires 50+ Changed events still coalesces to one
        // drain pass.
        ResourceStore.OnRouteChanged += HandleRouteChangedFromStore;
        ResourceStore.OnRouteRemoved += HandleRouteRemovedFromStore;
        ResourceStore.OnWaypointChanged += HandleWaypointChangedFromStore;
        ResourceStore.OnWaypointRemoved += HandleWaypointRemovedFromStore;
        ResourceStore.OnNoteChanged += HandleNoteChangedFromStore;
        ResourceStore.OnNoteRemoved += HandleNoteRemovedFromStore;
        ResourceStore.OnRegionChanged += HandleRegionChangedFromStore;
        ResourceStore.OnRegionRemoved += HandleRegionRemovedFromStore;

        // Resources (routes / waypoints / notes / regions) come from
        // ResourceStore. The store is populated at app startup
        // (Program.cs kicks RefreshAllAsync) and kept fresh via SK
        // resources.* deltas + reconnect reconcile, so reading the
        // snapshot here avoids the duplicate REST round-trip the
        // Map used to issue on every mount. Cold-start cases where
        // the startup-load hasn't completed yet land an empty
        // snapshot; the per-id Changed events fired during the
        // store's bulk Replace then drop the markers in via
        // ApplyWaypointChangedFromStoreAsync etc. a moment later
        // (idempotent JS-side: AddWaypointMarker returns early when
        // the id is already on the map).
        availableRoutes = [.. ResourceStore.Routes];
        loadedWaypoints = [.. ResourceStore.Waypoints];
        loadedNotes     = [.. ResourceStore.Notes];
        loadedRegions   = [.. ResourceStore.Regions];
        // Mirror regions into the singleton store; the
        // HazardousRegionAlarmRule reads from there.
        RegionStore.SetRegions(loadedRegions);

        PrecomputeRouteBounds();
        RebuildFilteredLayers();
        StateHasChanged();

        // First-paint barrier. Everything above is the chart shell
        // + the resource snapshot the helm sees on reload. The
        // bootstrap below (marker pushes, charts/radars/buddies
        // fetch, settings restore, layer pushes) used to stack 96+
        // microtasks behind a single timer-fire and pin the main
        // thread for ~2.5 s on a throttled / slow client. Yielding
        // here gives the browser a chance to paint the shell
        // before the heavy fan-out runs; each subsequent Task.Yield
        // breaks the next batch into its own timer-fire so the
        // helm sees progressive paint instead of one giant hang.
        await Task.Yield();

        // Batch-push markers via the resource controller. The page
        // still owns loadedWaypoints / loadedNotes / loadedRegions
        // because the CRUD flows on Map.razor.cs need them; the
        // controller is the rendering facade.
        await _resources!.DrawAllAsync(loadedWaypoints, loadedNotes, loadedRegions);

        await Task.Yield();

        // Charts / radars / buddies are NOT in ResourceStore - they
        // come from their own SignalK endpoints, so we still fetch
        // them here. Parallel WhenAll keeps the wall-clock to the
        // longest single round-trip. SafeLoad swallows per-call
        // failures so one bad endpoint can't take the rest down.
        var chartsTask  = SafeLoad(() => ChartApi.GetAllAsync(),  "charts");
        var radarsTask  = SafeLoad(() => RadarApi.GetAllAsync(),  "radars");
        var buddiesTask = BuddyListApi.GetAllAsync();
        await Task.WhenAll(chartsTask, radarsTask, buddiesTask);

        availableCharts = chartsTask.Result ?? [];
        ReSortAvailableCharts();
        // Radar device discovery. Empty list when no radar-provider
        // plugin is installed, which is the common case; the Layers
        // panel hides the section entirely in that state.
        await RadarOverlay.OnRadarListUpdatedAsync(radarsTask.Result ?? []);

        // Optional: buddy-list plugin. Silently no-ops if not installed.
        // The returned list seeds AisStore so vessels tracked later get
        // IsBuddy set on creation; live updates still come via the `buddy`
        // delta path.
        var buddies = buddiesTask.Result;
        if (buddies is not null)
        {
            loadedBuddies = buddies;
            AisStore.UpdateBuddies(buddies.Select(b => $"vessels.{b.Urn}"));
        }
        StateHasChanged();

        // Restore persisted settings (including enabled charts/routes) before
        // applying defaults so user choices survive a reload. Settings
        // init is idempotent (Program.cs runs it once at startup) so
        // this call is essentially free after the first paint.
        await Settings.InitializeAsync();

        // Wake lock is managed globally from MainLayout now (used to be
        // per-Map-page, but that let the screen sleep when the helm
        // switched to Wind / History mid-watch). No-op here.

        await Task.Yield();

        // Re-enable charts the user had turned on before navigating
        // away / reloading. Snapshot the persisted set FIRST - if we
        // iterate against Settings.EnabledChartIds directly, the
        // controller's ToggleAsync calls SetEnabledChartsAsync on
        // every iteration, which rewrites the persisted set to "only
        // the charts we've restored so far". That wiped every chart
        // after the first on page navigation, showing as "settings
        // reset" in the field.
        var chartsToRestore = Settings.EnabledChartIds.ToList();
        foreach (var chart in availableCharts)
            if (chartsToRestore.Contains(chart.Identifier))
                await _charts!.ToggleAsync(chart, true);

        // First-run seeding: auto-enable the built-in OSM + OpenSeaMap
        // charts (the basemap pair that used to be hardcoded as
        // permanent Leaflet base layers in initMap) plus any
        // SK-server chart whose name reads as "seamap" so the map
        // isn't blank on first visit. ChartsSeeded is persisted so
        // this fires EXACTLY ONCE in a device's history - earlier
        // revisions re-seeded whenever EnabledChartIds was empty,
        // which "reset" the user's deliberate choice to disable every
        // chart (common when plotter is paired with offline tiles).
        //
        // The OSM + OpenSeaMap entries come from
        // OnaPlotter/Utilities/BuiltInCharts.cs via ChartApi; matching
        // them by Identifier rather than Name is more robust because
        // a SK plugin could theoretically also publish a chart named
        // "OpenStreetMap".
        if (!Settings.ChartsSeeded)
        {
            foreach (var chart in availableCharts)
            {
                bool builtInBasemap =
                    chart.Identifier == OnaPlotter.Utilities.BuiltInCharts.OsmIdentifier
                    || chart.Identifier == OnaPlotter.Utilities.BuiltInCharts.OpenSeaMapIdentifier;
                bool seamapByName =
                    chart.Name.Contains("seamap", StringComparison.OrdinalIgnoreCase)
                    || chart.Name.Contains("sea map", StringComparison.OrdinalIgnoreCase);
                if (builtInBasemap || seamapByName)
                {
                    await _charts!.ToggleAsync(chart, true);
                }
            }
            await Settings.MarkChartsSeededAsync();
        }

        // Same snapshot-first pattern as charts above: ToggleRoute
        // writes SetEnabledRoutesAsync(enabledRoutes) on every
        // iteration, which would mid-loop wipe the persisted set.
        var routesToRestore = Settings.EnabledRouteIds.ToList();
        foreach (var route in availableRoutes)
            if (routesToRestore.Contains(route.Id))
                await ToggleRoute(route, true);

        // Quick-bar membership. Seed the controller's local mirror
        // from persisted settings; AppSettingsService has already
        // migrated first-run users by copying EnabledChartIds into
        // QuickBarChartIds.
        _charts!.SeedFromSettings();

        follow = Settings.FollowBoat;
        nightMode = Settings.NightMode;
        // ShipLinesVisible is loaded from settings (default true). The
        // initial push to JS happens after _controlsJs is constructed
        // (see the OnAfterRenderAsync init path below).
        mapOrientation = Settings.MapOrientation;
        mapOrientationLabel = mapOrientation switch { "course" => "C\u2191", "head" => "H\u2191", _ => "N\u2191" };

        await _controlsJs.SetFollowAsync(follow);
        if (nightMode) await _controlsJs.SetNightModeAsync(true);
        if (mapOrientation != "north") await _controlsJs.SetMapOrientationAsync(mapOrientation);

        await PushGuardZoneAsync();
        await _controlsJs.SetCogVectorMinutesAsync(
            Settings.OwnCogVectorMinutes,
            Settings.AisCogVectorMinutes);
        // Push the persisted ship-lines gate so a helm who disabled it
        // last session sees the chart decluttered immediately, not
        // "after the toggle is touched once". JS-side default is true
        // so we only push when the helm-set value differs.
        if (!Settings.ShipLinesVisible)
            await _controlsJs.SetShipLinesVisibleAsync(false);
        // Radar range rings: push persisted config so the rings are
        // sized + visible the moment a radar overlay starts. The
        // radar layer caches the config module-globally so the push
        // is independent of which radars are active.
        await _controlsJs.SetRadarRangeRingsAsync(
            Settings.RadarRangeRingsEnabled,
            Settings.RadarRangeRingsCount);
        // Push the persisted chart-display CSS filter once at init so
        // every chart layer added below picks it up. addChartLayer
        // re-applies the current filter on each layer creation, so
        // the order of "set filter" vs "add layers" is forgiving -
        // we set it here so a tab opened on a stack of charts
        // pre-tinted by the helm doesn't flash unfiltered for one
        // paint while the OnSettingsChanged path catches up.
        await PushChartFilterAsync();
        Settings.OnSettingsChanged += HandleSettingsChanged;

        SignalkClient.OnDataChanged += HandleDataChanged;
        SignalkClient.OnConnectionChanged += HandleConnectionChanged;

        // ResourceStore subscriptions (per-id delta + REST reconcile)
        // moved up to fire BEFORE we read the snapshot from the
        // store, so a Replace that lands during page mount doesn't
        // fall on the floor. See the snapshot block earlier in this
        // method.

        // MOB cross-reload recovery is owned by MobService itself
        // (kicked once at Program.cs startup + re-runs on every WS
        // reconnect edge via the service's internal subscription).
        // No manual kick needed here - the previous routing through
        // this page's HandleConnectionChanged meant MOB recovery
        // only ran if the helm happened to be on the chart page, a
        // safety regression that the startup-kick path fixes.

        KickInitialDataSyncAfterSubscribe();

        await Task.Yield();

        aisTimer = new System.Threading.Timer(_ => _ = PushAisTargets(), null, AisPushInitialDelayMs, AisPushIntervalMs);
        // AtoNs are static enough not to need a timer - push on
        // store-change events plus once after init. AtonsVisible
        // setting is honoured by setAtonsVisible JS-side.
        Atons.OnAtonsUpdated += HandleAtonsUpdated;
        await _aisJs.SetAtonsVisibleAsync(Settings.AtonsVisible);
        await _aisJs.SetAisLabelsVisibleAsync(Settings.AisLabelsVisible);
        await _aisJs.SetGuardZoneVisibleAsync(Settings.GuardZoneVisible);
        await _aisJs.SetGuardZoneWarningRingVisibleAsync(Settings.GuardZoneWarningRingVisible);
        _ = _atonPush!.PushAsync();

        // Marine-POI overlay: push initial visibility (= "any category
        // enabled?") so the JS master gate matches the helm's
        // persisted choice. The first OnMapBoundsChanged below will
        // fire the cache-render / fetch path when the map settles.
        if (_marinePoi is not null)
        {
            await _marinePoi.InitAsync();
        }
        // No resource-poll timer here any more. ResourceStore subscribes
        // to resources.* SK deltas at startup and reconciles via REST
        // on every reconnect, so waypoints / routes / notes / regions
        // added from another plotter land on the chart within delta
        // RTT (or one reconnect cycle for offline-edits). The previous
        // 60 s REST poll is now redundant.

        await _controlsJs.EnableKeyboardShortcutsAsync(dotNetRef);

        // Welcome card takes precedence over the touch coachmark on
        // first-ever visit since it covers long-press explicitly.
        // The card is now surfaced from OnInitializedAsync so it can
        // paint BEFORE the REST-fetch toasts; here we only chain the
        // coachmark when the welcome wasn't shown.
        if (!welcomeVisible) await MaybeShowTouchCoachmarkAsync();

        // Resolve any deep-link from /map?focus=<type>:<id> or
        // ?edit=<type>:<id> - set by the Resources page's View / Edit
        // buttons. Runs after the REST seed + map module are ready so
        // the target layers are already on the map.
        await ApplyMapDeepLinkAsync();

        // If a route-edit draft survived the last session (save
        // failed mid-edit, accidental tab close, browser crash),
        // prompt the helm to restore. AFTER deep-link so the
        // deep-link target wins on contention; AFTER welcome so
        // first-ever helms see the welcome card before the more
        // niche restore prompt.
        await MaybeShowRouteDraftRestoreAsync();
        }
        catch (JSDisconnectedException) { /* circuit gone - no-op */ }
        catch (ObjectDisposedException) { /* navigated away during load */ }
    }

    // Parse ?focus= or ?edit= from the URL and act on it. Silent no-op
    // if absent or unparseable; an unknown id surfaces a toast so the
    // user knows the target vanished (e.g. someone else deleted it on
    // another plotter after they opened the Resources page).
    private async Task ApplyMapDeepLinkAsync()
    {
        var uri = new Uri(Nav.Uri);
        // Welcome-card deep link is a separate URL contract from the
        // focus/edit deep links that MapDeepLink owns: it carries no
        // target id, just a flag the welcome-card lifecycle picked up
        // in OnInitializedAsync. We still need to drop the query
        // string after consume so a page reload doesn't re-trigger
        // the card. Strips ?welcome=1 cleanly whether or not a
        // focus/edit deep link is also present.
        if (Map.ShouldForceShowFromUri(Nav.Uri))
        {
            // forceLoad: false keeps the JS map alive across the
            // navigation; replace: true rewrites history so the
            // back button doesn't loop.
            Nav.NavigateTo("map", forceLoad: false, replace: true);
            return;
        }
        if (OnaPlotter.Utilities.MapDeepLink.Parse(uri.Query) is not { } target) return;
        string kind = target.Kind;
        string id = target.Id;
        bool editFlow = target.IsEdit;

        switch (kind)
        {
            case "route":
                var route = availableRoutes.FirstOrDefault(r => r.Id == id);
                if (route is null) { Toasts.Warning("Route not found"); break; }
                if (editFlow) await EditRoute(route);
                else await FocusRoute(route);
                break;
            case "waypoint":
                var wp = loadedWaypoints.FirstOrDefault(w => w.Id == id);
                if (wp is null) { Toasts.Warning("Waypoint not found"); break; }
                if (wp.Latitude is double lat && wp.Longitude is double lon
                    && _controlsJs is not null)
                {
                    await DisableFollowAsync();
                    await _controlsJs.PanToAsync(lat, lon);
                }
                break;
            case "note":
                var n = loadedNotes.FirstOrDefault(x => x.Id == id);
                if (n is null) { Toasts.Warning("Note not found"); break; }
                await FocusNote(n);
                break;
            case "region":
                var reg = loadedRegions.FirstOrDefault(x => x.Id == id);
                if (reg is null) { Toasts.Warning("Region not found"); break; }
                if (editFlow) await EditRegion(reg);
                else await FocusRegion(reg);
                break;
        }

        // Drop the query string once consumed so a page reload doesn't
        // re-apply the deep-link every time, and the URL shows /map
        // cleanly from the user's perspective. Use a relative path so
        // the SignalK-webapp mount point (e.g. /signalk-onaplotter/)
        // is preserved - an absolute "/map" jumps off-mount.
        Nav.NavigateTo("map", forceLoad: false, replace: true);
    }

    // MaybeShowWelcomeAsync / DismissWelcome /
    // MaybeShowTouchCoachmarkAsync / DismissTouchCoachmark live in the
    // Map.FirstRun.razor.cs partial.

    private async Task PushGuardZoneAsync()
    {
        if (_controlsJs is null) return;
        // Effective radius via the shared Cpa.EffectiveRadiusNm helper.
        // Three render paths consume it: the alarm rule
        // (CpaAlarmRule.EffectiveCpaRadiusNm), the chip classifier
        // (AisPushService.BuildSnapshot), and the visible rings
        // (this call site). All three MUST settle on one number -
        // a previous bug had the rings narrow under anchor while
        // chips kept the underway threshold, helm saw chips outside
        // the rings and asked "how can this be?".
        double radiusNm = OnaPlotter.Utilities.Cpa.EffectiveRadiusNm(
            Settings.CpaAlarmThreshold,
            SignalkClient.Data.AnchorActive,
            SignalkClient.Data.AnchorMaxRadius);
        await _controlsJs.SetGuardZoneAsync(
            radiusNm,
            Settings.GuardZoneLookaheadMinutes,
            // Single source of truth: C# owns the outer-ring scale
            // factor (Cpa.OuterRingMultiplier) so the JS overlay
            // can't drift from the threat classifier on it.
            OnaPlotter.Utilities.Cpa.OuterRingMultiplier);
    }

    // Per-push diff-caches. OnSettingsChanged fires for ANY setting
    // (font size, night mode preset, harbor mode, ...); the previous
    // handler unconditionally fired 6+ JS interop calls per fire,
    // turning a single helm toggle into a fan-out of redundant pushes.
    // Each push now gates on its own snapshot of the inputs it consumes.
    private (double Cpa, double LookaheadMin,
        bool AnchorActive, double? AnchorMaxRadius) _cachedGuardZone;
    private (double OwnCog, double AisCog) _cachedCogVector;
    private (bool Enabled, int Count) _cachedRadarRangeRings;
    private bool _cachedAtonsVisible;
    private bool _cachedAisLabelsVisible;
    private bool _cachedGuardZoneWarningRingVisible;
    private (int Contrast, int Saturation, int Brightness) _cachedChartFilter;

    // Fire-and-forget on the settings-changed event. Each push compares
    // its inputs against the last-seen snapshot and skips the JS interop
    // when nothing relevant changed. PushGuardZoneAsync swallows
    // expected disposal races so nothing escapes as an unobserved task
    // exception.
    private void HandleSettingsChanged()
    {
        var guardZoneNow = (
            Settings.CpaAlarmThreshold,
            Settings.GuardZoneLookaheadMinutes,
            SignalkClient.Data.AnchorActive,
            SignalkClient.Data.AnchorMaxRadius);
        if (!guardZoneNow.Equals(_cachedGuardZone))
        {
            _cachedGuardZone = guardZoneNow;
            _ = PushGuardZoneAsync();
        }

        if (_controlsJs is not null)
        {
            var cogNow = (Settings.OwnCogVectorMinutes, Settings.AisCogVectorMinutes);
            if (!cogNow.Equals(_cachedCogVector))
            {
                _cachedCogVector = cogNow;
                _ = _controlsJs.SetCogVectorMinutesAsync(cogNow.OwnCogVectorMinutes, cogNow.AisCogVectorMinutes);
            }

            var rrNow = (Settings.RadarRangeRingsEnabled, Settings.RadarRangeRingsCount);
            if (!rrNow.Equals(_cachedRadarRangeRings))
            {
                _cachedRadarRangeRings = rrNow;
                _ = _controlsJs.SetRadarRangeRingsAsync(rrNow.RadarRangeRingsEnabled, rrNow.RadarRangeRingsCount);
            }
        }
        // Wake-lock toggles are handled by MainLayout's OnSettingsChanged
        // handler; the Map page no longer needs to relay them.

        // Night-mode: if the user toggled it from Settings (not from
        // the Map page's own button) we hold a stale local `nightMode`
        // field and, crucially, the Leaflet tile filter never gets
        // applied. Resync both when Settings differs from our copy.
        if (Settings.NightMode != nightMode)
        {
            nightMode = Settings.NightMode;
            if (_controlsJs is not null)
                _ = _controlsJs.SetNightModeAsync(nightMode);
            _ = InvokeAsync(StateHasChanged);
        }

        // AtoN visibility toggle. The marker layer state survives the
        // hide/show cycle so flipping back doesn't have to re-fetch.
        if (_aisJs is not null)
        {
            if (Settings.AtonsVisible != _cachedAtonsVisible)
            {
                _cachedAtonsVisible = Settings.AtonsVisible;
                _ = _aisJs.SetAtonsVisibleAsync(_cachedAtonsVisible);
            }
            // AIS vessel name labels: independent of harbor mode (which
            // also suppresses labels). The JS gate ANDs both.
            if (Settings.AisLabelsVisible != _cachedAisLabelsVisible)
            {
                _cachedAisLabelsVisible = Settings.AisLabelsVisible;
                _ = _aisJs.SetAisLabelsVisibleAsync(_cachedAisLabelsVisible);
            }
            // Outer guard-zone warning ring: tracked here too so a
            // Settings-page toggle reaches the JS layer without the
            // helm having to refresh the Map page.
            if (Settings.GuardZoneWarningRingVisible != _cachedGuardZoneWarningRingVisible)
            {
                _cachedGuardZoneWarningRingVisible = Settings.GuardZoneWarningRingVisible;
                _ = _aisJs.SetGuardZoneWarningRingVisibleAsync(_cachedGuardZoneWarningRingVisible);
            }
        }

        // Chart-display CSS filter: only re-push when a slider commit
        // (or a Settings-page edit) actually moved one of the three
        // channels. Without the gate every helm tweak (e.g. flipping
        // BigType) was re-walking the chart-layer map and reassigning
        // the same filter string, which the browser elides but the
        // C#-JS interop still costs.
        var chartFilterNow = (
            Settings.ChartContrastPercent,
            Settings.ChartSaturationPercent,
            Settings.ChartBrightnessPercent);
        if (!chartFilterNow.Equals(_cachedChartFilter))
        {
            _cachedChartFilter = chartFilterNow;
            _ = PushChartFilterAsync();
        }

        // Marine-POI controller has its own internal diff-cache (see
        // OnSettingsChangedAsync); calling unconditionally here is
        // cheap because the controller skips the re-render+fetch when
        // none of its consumed flags changed.
        _ = _marinePoi?.OnSettingsChangedAsync();
    }

    /// <summary>Push the persisted chart-display CSS filter to the JS
    /// layer. Called once on map init and on every OnSettingsChanged
    /// broadcast so a slider-commit (or a programmatic setter) lands
    /// on the chart immediately. The string is built C#-side via
    /// <see cref="OnaPlotter.Utilities.ChartFilter.Format"/> so the
    /// invariant-culture decimal pinning + clamp logic stays in one
    /// place.</summary>
    private Task PushChartFilterAsync()
    {
        if (_overlaysJs is null) return Task.CompletedTask;
        return _overlaysJs.SetChartFilterAsync(
            OnaPlotter.Utilities.ChartFilter.Format(
                Settings.ChartContrastPercent,
                Settings.ChartSaturationPercent,
                Settings.ChartBrightnessPercent));
    }

    /// <summary>Live-preview path for the chart-filter sliders during
    /// a drag. Bypasses the settings save (helm hasn't released the
    /// slider yet) and pushes the candidate filter directly to JS so
    /// the chart updates per slider tick. Per-tick localStorage writes
    /// are reserved for the @onchange commit handler.</summary>
    private Task PreviewChartFilterAsync(int contrastPct, int saturationPct, int brightnessPct)
    {
        if (_overlaysJs is null) return Task.CompletedTask;
        return _overlaysJs.SetChartFilterAsync(
            OnaPlotter.Utilities.ChartFilter.Format(
                contrastPct, saturationPct, brightnessPct));
    }

    /// <summary>Reset every chart-filter channel to identity (100) in
    /// one batch. Persists all three settings then relies on the
    /// usual OnSettingsChanged broadcast to re-push the filter (the
    /// individual setters each fire their own event but the JS push
    /// is idempotent so the duplicate fan-out is fine).</summary>
    private async Task ResetChartFilterAsync()
    {
        await Settings.SetChartContrastPercentAsync(
            OnaPlotter.Utilities.ChartFilter.DefaultPercent);
        await Settings.SetChartSaturationPercentAsync(
            OnaPlotter.Utilities.ChartFilter.DefaultPercent);
        await Settings.SetChartBrightnessPercentAsync(
            OnaPlotter.Utilities.ChartFilter.DefaultPercent);
    }

    [JSInvokable]
    public async Task OnKeyShortcut(string key)
    {
        switch (key)
        {
            case "m": await ToggleMob(); break;
            case "n": await ToggleNightMode(); break;
            case "f": await ToggleFollow(); break;
            case "a": await ToggleAnchor(); break;
            case "t": await ZoomToTrack(); break;
            case "l": await OnToggleLaylinesPersist(!Settings.LaylinesVisible); break;
            case "o": await CycleMapOrientation(); break;
            case "r": ToggleRaceTimer(); break;
            case "d": await ToggleMeasure(); break;
            case "?":
                // "?" only opens the shortcuts card when keyboard hints
                // are enabled in Settings. Default off so touch-only
                // users don't land on an unexpected modal if they
                // connect a keyboard and brush the key.
                // InitializeAsync is idempotent (semaphore-guarded
                // _initialized flag); awaiting here closes the race
                // where the JS keyboard handler attaches before
                // MainLayout's first-render Settings load completes
                // and a fast helm hits '?' inside that gap.
                await Settings.InitializeAsync();
                if (Settings.ShowKeyboardHints) shortcutsVisible = !shortcutsVisible;
                break;
            case "escape":
                if (measureActive) { await ToggleMeasure(); }
                // Esc also cancels in-progress route / polygon edits so
                // the user can bail without reaching for the mouse.
                if (routeEditMode) { await CancelRouteEdit(); }
                if (polygonEditMode) { await CancelPolygonEdit(); }
                if (fabMenuOpen) { fabMenuOpen = false; }
                if (legendOpen) { legendOpen = false; }
                shortcutsVisible = false;
                break;
        }
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnMapBoundsChanged(double west, double south, double east, double north,
        double centerLat, double centerLon, double zoom)
    {
        viewWest = west;
        viewSouth = south;
        viewEast = east;
        viewNorth = north;
        RebuildFilteredLayers();
        // Only re-render if the layer panel is actually open.
        if (chartPanelOpen)
            _ = InvokeAsync(StateHasChanged);

        // Persist the new view. Fire-and-forget: a failed localStorage
        // write is the same as "storage disabled", which the settings
        // layer already tolerates silently. Guard on the zoom integer
        // round since Leaflet uses a non-integer zoom while pinching
        // and we only care about the settled zoom.
        int zoomInt = (int)Math.Round(zoom);
        _ = Settings.SetMapViewAsync(centerLat, centerLon, zoomInt);

        // OSM marine POIs: cache-render the new viewport immediately +
        // schedule a debounced Overpass fetch (skipped above zoom gate
        // / when no category is enabled). Fire-and-forget per the
        // controller's contract.
        _ = _marinePoi?.OnBoundsChangedAsync(west, south, east, north, zoom);
    }

    // Charts without bounds are always shown. Otherwise AABB intersection test.
    private bool ChartIntersectsViewport(SignalkChart chart)
    {
        if (chart.Bounds is null || chart.Bounds.Length < 4) return true;
        // Pre-bounds-fix default: before the first OnMapBoundsChanged
        // delta arrives the view* fields are null. Mirror
        // RouteIntersectsViewport's explicit guard so a future change
        // to the comparison can't silently invert the default.
        if (viewWest is null) return true;

        double cWest = chart.Bounds[0], cSouth = chart.Bounds[1];
        double cEast = chart.Bounds[2], cNorth = chart.Bounds[3];

        return !(cEast < viewWest || cWest > viewEast || cNorth < viewSouth || cSouth > viewNorth);
    }

    // Uses pre-computed bounding box (computed once when routes are loaded).
    private bool RouteIntersectsViewport(SignalkRoute route)
    {
        if (viewWest is null) return true;
        if (!routeBounds.TryGetValue(route.Id, out var bbox) || bbox is null) return true;

        return !(bbox.Value.MaxLon < viewWest || bbox.Value.MinLon > viewEast
              || bbox.Value.MaxLat < viewSouth || bbox.Value.MinLat > viewNorth);
    }

    // Pre-compute bounding boxes for all routes (called once after loading).
    // Also seeds routeCoordsCache so AddRouteToMap doesn't re-parse the
    // JsonElement enumerator. Both reads off one parse pass.
    private void PrecomputeRouteBounds()
    {
        routeBounds.Clear();
        routeCoordsCache.Clear();
        foreach (var route in availableRoutes)
        {
            if (route.Feature?.Geometry is null) { routeBounds[route.Id] = null; continue; }
            try
            {
                var coords = ParseRouteCoords(route);
                routeCoordsCache[route.Id] = coords;
                if (coords.Length == 0) { routeBounds[route.Id] = null; continue; }

                double minLat = double.MaxValue, maxLat = double.MinValue;
                double minLon = double.MaxValue, maxLon = double.MinValue;
                foreach (var ll in coords)
                {
                    double lat = ll[0], lon = ll[1];
                    if (lat < minLat) minLat = lat;
                    if (lat > maxLat) maxLat = lat;
                    if (lon < minLon) minLon = lon;
                    if (lon > maxLon) maxLon = lon;
                }
                routeBounds[route.Id] = (minLat, maxLat, minLon, maxLon);
            }
            catch
            {
                routeBounds[route.Id] = null;
            }
        }
    }

    /// <summary>Parse a route's GeoJSON Coordinates into Leaflet-ordered
    /// [lat, lon] pairs. Used by both PrecomputeRouteBounds (which
    /// seeds the cache) and AddRouteToMap (which reads from it for
    /// routes already cached, parses fresh for ad-hoc routes that
    /// arrive after the seed). Pure helper; no side effects.</summary>
    private static double[][] ParseRouteCoords(SignalkRoute route)
    {
        if (route.Feature?.Geometry is null) return [];
        var coords = new List<double[]>();
        foreach (var point in route.Feature.Geometry.Coordinates.EnumerateArray())
        {
            var arr = new double[2];
            int i = 0;
            foreach (var val in point.EnumerateArray())
            {
                if (i < 2) arr[i++] = val.GetDouble();
            }
            // GeoJSON [lon, lat] -> Leaflet [lat, lon].
            coords.Add([arr[1], arr[0]]);
        }
        return [.. coords];
    }

    // Cached HUD values for change detection. Only re-render when these
    // actually change. The previous implementation built an interpolated
    // string with 22 fields each tick; on a 1 Hz feed (well-instrumented
    // boats burst higher) that allocated ~200 bytes plus the double
    // formatting cost on every delta. The struct holds the same fields
    // in their native form, gets value-equality for free, and is a stack-
    // local on the comparison path - zero per-tick heap traffic.
    //
    // Quantisation matches the original key's :Fn suffixes so the render
    // gate fires at the same granularity as before (e.g. SOG only
    // triggers a render when it moves by >=0.01 m/s).
    private HudSnapshot _lastHudSnapshot;

    private readonly record struct HudSnapshot(
        long Sog, long Cog, long Hdg, long Depth,
        long Awa, long Aws, long Twa, long Tws, long Twd,
        long NextDist, long NextBrg, long NextVmg, long NextTtg,
        long AnchorCur, long AnchorMax, long AnchorLat,
        long Xte, string? RouteHref,
        int? RoutePtIdx, int? RoutePtTotal,
        long RouteDistRem, long RouteTtg);

    // Quantises a nullable double so equality comparison fires at the
    // same granularity as the old string key's :Fn formatting, without
    // allocating a string. long.MinValue stands in for null so the
    // record's value-equality stays correct. Inlined hot path: this
    // runs ~22 times per HandleDataChanged tick.
    private static long Q(double? v, int decimals)
    {
        if (v is null) return long.MinValue;
        return (long)Math.Round(v.Value * Math.Pow(10, decimals));
    }

    private HudSnapshot BuildHudSnapshot() => new(
        Q(Data.SpeedOverGround, 2),
        Q(Data.CourseOverGround, 3),
        Q(Data.Heading, 3),
        Q(Data.Depth, 1),
        Q(Data.WindAngleApparent, 3),
        Q(Data.WindSpeedApparent, 2),
        Q(Data.WindAngleTrue, 3),
        Q(Data.WindSpeedTrue, 2),
        Q(Data.WindDirectionTrue, 3),
        Q(Data.CourseNextPointDistance, 0),
        Q(Data.CourseNextPointBearing, 2),
        Q(Data.CourseNextPointVmg, 2),
        Q(Data.CourseNextPointTimeToGo, 0),
        Q(Data.AnchorCurrentRadius, 1),
        Q(Data.AnchorMaxRadius, 1),
        Q(Data.AnchorLatitude, 6),
        Q(Data.CrossTrackError, 1),
        Data.ActiveRouteHref,
        // Route-level fields: progress chip + route-total row on the
        // active-route card. Without them in the snapshot, a waypoint
        // advance would show new leg numbers but the "WP 3 of 7" chip
        // would lag until another field changed.
        Data.ActiveRoutePointIndex,
        Data.ActiveRoutePointTotal,
        Q(Data.ActiveRouteDistanceRemaining, 0),
        Q(Data.ActiveRouteTimeToGo, 0));

    // One-time flag so we only push the own MMSI to JS once per
    // session. Self context resolves asynchronously via the hello
    // message; HandleDataChanged is the reliable cadence where
    // OwnMmsi becomes non-null.
    private bool _ownMmsiPushed;
    private string? _lastPushedOwnCallsign;

    /// <summary>Last (active, maxRadiusMeters) tuple pushed to the
    /// guard-zone JS layer. We diff per tick so transitions
    /// (anchor activated / radius changed / dropped) repaint the
    /// ring + threshold while steady-state ticks stay no-op.</summary>
    private (bool active, double? maxM) _lastAnchorPushedState = (false, null);

    /// <summary>
    /// Closes the seed-vs-subscribe race in <c>OnAfterRenderAsync</c>:
    /// <see cref="SignalkClient.SeedSelfCourseFromRestAsync"/> fires its
    /// <c>OnDataChanged</c> right after the WebSocket connects, long
    /// before <c>OnAfterRenderAsync</c> has finished its REST seeds +
    /// chart / route restores and reaches the subscription line. Without
    /// a kick, <see cref="NavigationData"/> holds the active-route href
    /// but the map is oblivious - and on a moored vessel with no live
    /// position deltas, nothing ever triggers a follow-up sync, so the
    /// helm sees their active route silently disappear on every page
    /// reload. Calling <see cref="HandleDataChanged"/> once after the
    /// subscription lands catches up; the diff-based logic in
    /// <c>SyncActiveRouteAsync</c> keeps it a no-op when the seed
    /// hasn't landed yet, and the seed's own <c>OnDataChanged</c> (now
    /// subscribed) handles the late case.
    /// </summary>
    private void KickInitialDataSyncAfterSubscribe() => HandleDataChanged();

    private async void HandleDataChanged()
    {
        if (!mapInitialized || module is null) return;

        // Anchor panel orphan-close: if the helm has the SetRadius
        // panel open and the server-side anchor was cleared (raise
        // came from a different plotter, plugin reset, etc.), the
        // panel is staring at a non-existent anchor. Tapping Set in
        // that state would PUT maxRadius against a cleared anchor
        // and silently fail. Snap the panel shut + toast so the
        // helm sees what changed without losing input mid-thought.
        // (Drop mode does NOT need the same close: the state is
        // identical to "no anchor active", which is exactly what
        // Drop mode expects.)
        if (anchorEditMode
            && _anchorPanelMode == OnaPlotter.Components.Map.AnchorEditPanel.AnchorPanelMode.SetRadius
            && !Data.AnchorActive)
        {
            anchorEditMode = false;
            anchorEditBusy = false;
            // Anchor is gone - ServerAnchorSync will tear the on-
            // map ring down; just drop the preview flag so a
            // subsequent panel re-open doesn't think there's still
            // an outstanding revert to do.
            _anchorPreviewActive = false;
            Toasts.Warning("Anchor was raised by another plotter or the server - panel closed");
        }

        // Keep the sticky last-heading field current for the HUD compass needle.
        if (Data.Heading is not null) lastHeading = Data.Heading;

        // Push own MMSI to JS once the SignalK hello resolves it so
        // buildSelfPopupHtml can fetch the country flag from the
        // signalk-flags plugin (same endpoint as AIS markers).
        if (!_ownMmsiPushed && SignalkClient.OwnMmsi is string mmsi && _aisJs is not null)
        {
            // Once-per-page push: the wrapper silently no-ops after
            // dispose / disconnect, and the page won't get another
            // tick after that anyway, so the latch never needs reset.
            _ownMmsiPushed = true;
            await _aisJs.SetOwnMmsiAsync(mmsi);
        }
        // Push own callsign once the SK feed has delivered it so
        // the ownship popup can show MMSI + callsign together.
        // Re-pushable: an SK feed might re-publish callsignVhf on
        // a sensor swap, so we don't latch - the JS setter is
        // idempotent for unchanged values anyway.
        if (SignalkClient.OwnCallsign is string callsign
            && callsign != _lastPushedOwnCallsign
            && _aisJs is not null)
        {
            _lastPushedOwnCallsign = callsign;
            await _aisJs.SetOwnCallsignAsync(callsign);
        }

        // Auto-flip Night mode near / past civil twilight if enabled.
        // Throttled to once per 30 s because sun altitude changes slowly.
        // Must sit after the mapInitialized guard so we don't try to
        // push setNightMode at a not-yet-imported module.
        await CheckAutoNightAsync();

        try
        {
            // Build the per-tick frame via the extracted builder. One
            // Blazor->JS bridge crossing per tick for up to six
            // overlays (position / track segment / course line / clear-
            // course / current arrow / laylines). Blazor's default
            // JSRuntime JsonOptions is CamelCase so the record-struct
            // fields arrive in JS as `pos.lat`, `pos.headingRad`, etc,
            // which is exactly what applyFrame expects.
            // Laylines have their own Layers-panel toggle, separate
            // from the master ShipLines knob (which gates COG vector
            // + tidal current arrow only). Helms who motor never
            // want laylines; helms who race want them visible
            // independently of the always-on indicators.
            _frameBuilder.LaylinesVisible = Settings.LaylinesVisible;
            // Push the arrival-circle radius each tick so the JS
            // course-line layer can draw the ring at the active WP.
            // Single source of truth: navigation.course.arrivalCircle
            // from the SK v2 Course API. Null (server doesn't publish)
            // becomes 0, which the JS layer treats as "hide the ring"
            // - matches the server's actual state rather than guessing
            // a local default the autopilot would not agree with.
            _frameBuilder.ArrivalRadiusMeters =
                Data.CourseArrivalCircleMeters ?? 0.0;
            // Helm picks two COG sources independently: one for the
            // HUD numerical readout, one for the on-map COG vector
            // line. The vector source flows through the frame builder
            // here; the readout source is read by the HUD card
            // directly. Each axis-pair (smoothed vs realtime, true
            // vs magnetic) falls back through the chain in
            // CogSourceResolver so a missing SK path doesn't blank
            // the chart.
            var orientationSource = OnaPlotter.Utilities.ShipOrientationResolver.Parse(
                Settings.ShipOrientationSource);
            var vectorSource = OnaPlotter.Utilities.CogSourceResolver.Parse(
                Settings.OwnCogVectorSource);
            double? vectorCog = OnaPlotter.Utilities.CogSourceResolver.Resolve(
                vectorSource, Data,
                smoothedTrue: Avg.CogTrueMean30Sec,
                smoothedMagnetic: Avg.CogMagneticMean30Sec);
            double? smoothedSog = Avg.SogMean30Sec ?? Data.SpeedOverGround;
            // Boat-icon orientation has its own source (Heading vs
            // COG); when the helm picks a COG variant the smoothed
            // buffer matching the picked axis feeds in so the icon
            // doesn't twitch with every wave.
            double? orientationSmoothedCog = orientationSource switch
            {
                OnaPlotter.Utilities.ShipOrientationSource.CogTrue => Avg.CogTrueMean30Sec,
                OnaPlotter.Utilities.ShipOrientationSource.CogMagnetic => Avg.CogMagneticMean30Sec,
                _ => null,
            };
            double? orientation = OnaPlotter.Utilities.ShipOrientationResolver.Resolve(
                orientationSource, Data, smoothedCog: orientationSmoothedCog);
            var frame = _frameBuilder.Build(Data,
                orientationOverride: orientation,
                cogOverride: vectorCog,
                sogOverride: smoothedSog);
            if (_controlsJs is not null) await _controlsJs.ApplyFrameAsync(frame);

            // Sync server-side anchor alarm to map visualization. Kept
            // out of applyFrame because it has its own diff-before-push
            // logic (href / radii) that doesn't map to a plain per-tick
            // snapshot.
            if (_anchorSync is not null) await _anchorSync.SyncAsync(Data);

            // Re-push the guard zone when anchor state transitions
            // (active flip, or radius change while active). Effective
            // CPA radius narrows to the anchor swing while the
            // anchoralarm-plugin has a drop point set; without this
            // diff-and-push the visible ring + threshold stay at the
            // underway value until the next settings change.
            (bool active, double? maxM) anchorState = (Data.AnchorActive, Data.AnchorMaxRadius);
            if (anchorState != _lastAnchorPushedState)
            {
                _lastAnchorPushedState = anchorState;
                await PushGuardZoneAsync();
            }

            // Sync active route visualization (href-diff -> fetch + draw).
            if (_activeRouteSync is not null)
                await _activeRouteSync.SyncAsync(Data, enabledRoutes, availableRoutes);

            // Route-active server-track stewardship. When a route is
            // active AND the helm has the server-track layer on, the
            // server polyline is the long trail-of-record, so the
            // local in-memory trail is suppressed (cleared on the
            // activation transition, future segments skipped). A
            // 60 s refresh keeps the server polyline catching up to
            // the active leg without the helm having to toggle the
            // layer manually. When either the route or the
            // server-track turns off, local emission resumes - the
            // trail picks up from the current fix (not bridged from
            // the pre-route position; the transition resets PrevLat /
            // PrevLon).
            await SyncRouteActiveServerTrackAsync();

            // Only re-render Blazor component if HUD values actually changed.
            // The snapshot is a record struct - equality is by value, no
            // string allocation per tick.
            var hudSnap = BuildHudSnapshot();
            if (!hudSnap.Equals(_lastHudSnapshot))
            {
                _lastHudSnapshot = hudSnap;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
        catch (JSException ex)
        {
            // A JS-side regression in any of updatePosition / setCourseLine
            // / setLaylines etc. used to bubble into Blazor's error UI and
            // freeze the render pass - that's what hid the own-boat marker
            // in the chartLayers crash. Swallow + log so the UI stays live
            // and the browser console still surfaces the regression for
            // the dev. We fire at 1 Hz; a toast per tick would be spam.
            Console.Error.WriteLine($"[interop] HandleDataChanged: {ex.Message}");
        }
        catch (Exception ex)
        {
            // Defense-in-depth for an async-void event handler: ANY
            // exception that escapes here terminates the WASM runtime
            // ("Assert failed: .NET runtime already exited with 1"),
            // and the helm has to reload. Keeping the catches above
            // typed for the documented JS-interop cases, then a
            // generic catch so a future surface (HTTP failure in a
            // sub-syncer, an alarm-rule throw, etc.) doesn't take
            // down the runtime over a recoverable per-tick failure.
            // 1 Hz cadence -> log only, no toast spam.
            Console.Error.WriteLine(
                $"[handle-data] unhandled {ex.GetType().Name}: {ex.Message}");
        }
    }

    /// <summary>
    /// Per-tick steward for the route-active server-track refresher.
    /// Runs after <c>_activeRouteSync.SyncAsync</c> so the active-
    /// course state has settled for the current frame.
    ///
    /// Three jobs:
    /// 1. Activation transition (route + server-track go from "off"
    ///    to "on"): clear the local trail polyline, reset PrevLat /
    ///    PrevLon so the next post-route fix doesn't bridge across
    ///    the pre-route position, latch the suppression flag.
    /// 2. Deactivation transition: drop the suppression flag so the
    ///    next per-tick segment-emit pushes again.
    /// 3. While both still active: every 60 s, kick the server-track
    ///    controller to refetch so the trail catches up to the
    ///    active leg without manual intervention.
    /// </summary>
    private async Task SyncRouteActiveServerTrackAsync()
    {
        bool routeAndServerTrack = Data.HasActiveCourse
            && (_serverTrack?.Visible ?? false);

        if (routeAndServerTrack && !_localTrackSuppressedForRoute)
        {
            // Activation transition: drop the local in-memory trail
            // (clearLayers via empty-seed) and reset Prev so the
            // local trail picks up cleanly when the route ends.
            if (_overlaysJs is not null)
                await _overlaysJs.SetColoredTrackAsync([]);
            _frameBuilder.PrevLat = null;
            _frameBuilder.PrevLon = null;
            _localTrackSuppressedForRoute = true;
            _lastServerTrackRefreshUtc = Time.GetUtcNow();
        }
        else if (!routeAndServerTrack && _localTrackSuppressedForRoute)
        {
            // Deactivation transition: drop the latch + null the
            // refresh stamp so the next activation triggers a clean
            // start.
            _localTrackSuppressedForRoute = false;
            _lastServerTrackRefreshUtc = null;
        }
        // Suppression has two sources: the route-active latch above
        // and the helm's "Show local trail" toggle. ORing them keeps
        // the frame builder ignorant of which path turned the trail
        // off; the toggle handler below clears the existing JS layer
        // on its own when the helm flips it.
        _frameBuilder.SuppressLocalTrack =
            _localTrackSuppressedForRoute || !Settings.LocalTrackVisible;

        if (routeAndServerTrack
            && _lastServerTrackRefreshUtc is DateTimeOffset last
            && (Time.GetUtcNow() - last).TotalSeconds >= RouteServerTrackRefreshIntervalSeconds)
        {
            _lastServerTrackRefreshUtc = Time.GetUtcNow();
            // Fire-and-forget: the controller's RefreshAsync is
            // self-contained (toasts on empty result, swallows JS
            // disconnects on its own). Awaiting it here would block
            // the per-tick frame-emit on a server round-trip -
            // the helm shouldn't see the position update halt while
            // history fetches.
            _ = _serverTrack!.RefreshAsync();
        }
    }

    // Shared moored-vessel classifier (singleton DI). Same instance the
    // CPA alarm rule uses, so the harbour filter and the alarm-suppress
    // path can never disagree on whether a given vessel is moored. Was
    // previously a local `new MooredVesselTracker()` here that ticked
    // a parallel dwell ring; the duplication invited "alarm thinks X is
    // moored, harbour filter doesn't" debugging.
    [Inject] private OnaPlotter.Services.IMooredVesselTracker MooredVessels { get; set; } = default!;

    // TimeProvider for hot-path UtcNow reads (harbor filter, ageSec
    // staleness on AIS markers). The provider is the same one
    // SignalkClient already takes; injecting here lets the harbor
    // filter helper be tested deterministically. Only the two AIS-
    // payload sites use it for now - the various pending / debounce
    // timestamps elsewhere (course-stop, anchor-raise, race timer)
    // are left on DateTime.UtcNow because they're behaviour-tested
    // through Playwright, not C# unit tests.
    [Inject] private TimeProvider Time { get; set; } = default!;

    /// <summary>
    /// Forwards the AIS push to <see cref="AisPushService"/>. Stays as
    /// an instance method (not a direct call site) because the AIS
    /// timer + harbour-mode handler + buddy-toggle path all need a
    /// consistent gate: skip if the map isn't initialised yet.
    /// </summary>
    private Task PushAisTargets()
    {
        if (!mapInitialized || _aisPush is null) return Task.CompletedTask;
        return _aisPush.PushAsync(Data);
    }

    private void HandleAtonsUpdated()
    {
        // AtonStore.OnAtonsUpdated fires from the websocket thread on
        // every delta-affecting change. WASM is single-threaded so
        // there's no thread-marshal needed; we just kick off the JS
        // push and let it await on its own.
        if (mapInitialized) _ = (_atonPush?.PushAsync() ?? Task.CompletedTask);
    }

