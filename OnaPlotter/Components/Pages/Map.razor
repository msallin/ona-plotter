    private bool AnchorDragging => Data.AnchorActive
        && Data.AnchorCurrentRadius is not null
        && Data.AnchorMaxRadius is not null
        && Data.AnchorCurrentRadius > Data.AnchorMaxRadius;

    // Depth trend over the last minute, in metres per minute.
    // Computed lazily from TrackBuffer; null when we don't have enough
    // samples yet or the depth plugin isn't publishing.
    private double? depthTrendMpm =>
        TrackBuffer.GetDepthTrendMetersPerMinute(TimeSpan.FromMinutes(1));

    // Track whether we've already drawn the server anchor on the map.
    private bool serverAnchorDrawn;
    private double lastPushedAnchorRadius;

    // "Raising in progress" state: set when AnchorAlarmApi.RaiseAsync
    // returns success, cleared when SyncServerAnchorAsync sees the
    // anchor delta arrive (Data.AnchorActive flips false). While set,
    // the on-map anchor marker / watch circle / radius line dim via
    // setAnchorRaising so the helm sees their tap took effect without
    // us masking a possible server-side failure (we never hide the
    // marker; we only style it). A wallclock watchdog of
    // AnchorRaiseTimeoutSec surfaces a warning toast if the delta
    // never arrives -- pointing at a real server-side issue rather
    // than a transient delta gap.
    private DateTime? _anchorRaisePendingUtc;
    private const int AnchorRaiseTimeoutSec = 5;

    // "Stopping navigation in progress" state: set when StopNavigation's
    // CourseApi.ClearAsync returns success, cleared when
    // SyncActiveRouteAsync sees Data.ActiveRouteHref become null.
    // Same single-source-of-truth pattern as _anchorRaisePendingUtc:
    // never mutate the data model locally, just style the on-map
    // active-route elements as "fading out" while we wait for the
    // server delta to confirm. Watchdog warns if the delta never
    // arrives.
    private DateTime? _courseStopPendingUtc;
    private const int CourseStopTimeoutSec = 5;

    // First-visit welcome + touch coachmark state moved to
    // Map.FirstRun.razor.cs so the onboarding overlays stay together.
    // Fields referenced from the markup (welcomeVisible, touchCoachmarkVisible)
    // are declared in that partial.

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/leafletInterop.js");
        dotNetRef = DotNetObjectReference.Create(this);

        // Prefer the persisted view so re-opening the app lands where
        // the user left off. FollowBoat, when on, will pan to the boat
        // position on the first delta anyway, so preferring the saved
        // view doesn't fight the follow mode. Fallback order:
        //  1. Persisted view from IAppSettings (mapView.v1)
        //  2. Current boat position at zoom 14
        //  3. World view centred at (0,0) at zoom 3
        double lat;
        double lon;
        int zoom;
        if (Settings.MapViewLat is double vlat && Settings.MapViewLon is double vlon
            && Settings.MapViewZoom is int vzoom)
        {
            lat = vlat; lon = vlon; zoom = vzoom;
        }
        else if (Data.Latitude is double dlat && Data.Longitude is double dlon)
        {
            lat = dlat; lon = dlon; zoom = 14;
        }
        else
        {
            lat = 0; lon = 0; zoom = 3;
        }

        await module.InvokeVoidAsync("initMap", "mapDiv", lat, lon, zoom, dotNetRef);
        mapInitialized = true;

        // Tell the JS side where the SignalK server lives so its
        // origin-bound URLs (flag images today; future direct hits
        // tomorrow) target the configured server rather than the
        // page origin. With the default same-origin setup this
        // pushes "" and existing relative URLs keep working.
        try { await module.InvokeVoidAsync("setSignalKBaseUrl", SkBaseUrl.BaseUrl); }
        catch (JSDisconnectedException) { return; }

        // Load existing track as speed-colored segments.
        var points = TrackBuffer.GetSnapshot();
        if (points.Length > 0)
        {
            var jsPoints = points.Select(p => new[] { p.Latitude, p.Longitude, p.SpeedOverGround ?? 0 }).ToArray();
            await module.InvokeVoidAsync("setColoredTrack", (object)jsPoints);
            _frameBuilder.PrevLat = points[^1].Latitude;
            _frameBuilder.PrevLon = points[^1].Longitude;
        }

        // Load available charts and routes from SignalK server. Any of these
        // endpoints can 404 or time out (SignalK unreachable, plugin not
        // installed, webapp running standalone for dev). Degrade gracefully
        // - the map itself is still usable without these.
        // Parallelise the seven REST seed calls. Sequential they add
        // ~700 ms on a 100 ms-RTT link (cold connection) before the map
        // is interactive; Task.WhenAll issues them concurrently so the
        // longest single call dominates. SafeLoad swallows per-call
        // failures so one bad endpoint can't take the rest down.
        var chartsTask   = SafeLoad(() => ChartApi.GetAllAsync(),   "charts");
        var routesTask   = SafeLoad(() => RouteApi.GetAllAsync(),   "routes");
        var waypointsTask= SafeLoad(() => WaypointApi.GetAllAsync(),"waypoints");
        var notesTask    = SafeLoad(() => NoteApi.GetAllAsync(),    "notes");
        var regionsTask  = SafeLoad(() => RegionApi.GetAllAsync(),  "regions");
        var radarsTask   = SafeLoad(() => RadarApi.GetAllAsync(),   "radars");
        var buddiesTask  = BuddyListApi.GetAllAsync();
        await Task.WhenAll(chartsTask, routesTask, waypointsTask,
            notesTask, regionsTask, radarsTask, buddiesTask);

        availableCharts   = chartsTask.Result   ?? [];
        ApplyChartOrder();
        availableRoutes   = routesTask.Result   ?? [];
        loadedWaypoints   = waypointsTask.Result ?? [];
        loadedNotes       = notesTask.Result     ?? [];
        loadedRegions     = regionsTask.Result   ?? [];
        // Radar device discovery. Empty list when no radar-provider
        // plugin is installed, which is the common case; the Layers
        // panel hides the section entirely in that state.
        availableRadars   = (radarsTask.Result ?? []).ToList();
        await EnsureRadarCapabilitiesAsync();

        // Optional: buddy-list plugin. Silently no-ops if not installed.
        // The returned list seeds AisStore so vessels tracked later get
        // IsBuddy set on creation; live updates still come via the `buddy`
        // delta path.
        var buddies = buddiesTask.Result;
        if (buddies is not null)
        {
            loadedBuddies = buddies;
            AisStore.UpdateBuddies(buddies.Select(b => $"vessels.{b.Urn}"));
        }
        PrecomputeRouteBounds();
        RebuildFilteredLayers();
        StateHasChanged();

        // Draw waypoint markers on the map.
        foreach (var wp in loadedWaypoints)
        {
            if (wp.Latitude is not null && wp.Longitude is not null)
                await module.InvokeVoidAsync("addWaypointMarker", wp.Id, wp.Latitude, wp.Longitude, wp.Name);
        }

        // Draw note markers. Notes use a bare position (not a GeoJSON
        // Feature); GetAllAsync has already filtered out entries without
        // a position, so the nullability check is just defensive.
        foreach (var n in loadedNotes)
        {
            if (n.Position is not null)
                await module.InvokeVoidAsync("addNoteMarker",
                    n.Id, n.Position.Latitude, n.Position.Longitude, n.Title, n.Description);
        }

        // Draw region polygons. OuterRings is in Leaflet [lat, lon]
        // order already, one ring per polygon (MultiPolygon produces
        // multiple).
        foreach (var r in loadedRegions)
        {
            await module.InvokeVoidAsync("addRegion",
                r.Id, r.OuterRings, r.Name, r.Description);
        }

        // Restore persisted settings (including enabled charts/routes) before
        // applying defaults so user choices survive a reload.
        await Settings.InitializeAsync();

        // Wake lock is managed globally from MainLayout now (used to be
        // per-Map-page, but that let the screen sleep when the helm
        // switched to Wind / History mid-watch). No-op here.

        // Re-enable charts the user had turned on before navigating
        // away / reloading. Snapshot the persisted set FIRST -- if we
        // iterate against Settings.EnabledChartIds directly, ToggleChart
        // calls SetEnabledChartsAsync(enabledCharts) on every iteration,
        // which rewrites the persisted set to "only the charts we've
        // restored so far". That wiped every chart after the first on
        // page navigation, showing as "settings reset" in the field.
        var chartsToRestore = Settings.EnabledChartIds.ToList();
        foreach (var chart in availableCharts)
            if (chartsToRestore.Contains(chart.Identifier))
                await ToggleChart(chart, true);

        // First-run seeding: auto-enable OpenSeaMap-named charts so
        // the map isn't blank on first visit. ChartsSeeded is persisted
        // so this fires EXACTLY ONCE in a device's history -- earlier
        // revisions re-seeded whenever EnabledChartIds was empty,
        // which "reset" the user's deliberate choice to disable every
        // chart (common when plotter is paired with offline tiles).
        if (!Settings.ChartsSeeded)
        {
            foreach (var chart in availableCharts)
            {
                if (chart.Name.Contains("seamap", StringComparison.OrdinalIgnoreCase)
                    || chart.Name.Contains("sea map", StringComparison.OrdinalIgnoreCase))
                {
                    await ToggleChart(chart, true);
                }
            }
            await Settings.MarkChartsSeededAsync();
        }

        // Same snapshot-first pattern as charts above: ToggleRoute
        // writes SetEnabledRoutesAsync(enabledRoutes) on every
        // iteration, which would mid-loop wipe the persisted set.
        var routesToRestore = Settings.EnabledRouteIds.ToList();
        foreach (var route in availableRoutes)
            if (routesToRestore.Contains(route.Id))
                await ToggleRoute(route, true);

        // Quick-bar membership. Seed the local mirror from persisted
        // settings; AppSettingsService has already migrated first-run
        // users by copying EnabledChartIds into QuickBarChartIds.
        quickBarCharts.Clear();
        foreach (var id in Settings.QuickBarChartIds) quickBarCharts.Add(id);

        follow = Settings.FollowBoat;
        nightMode = Settings.NightMode;
        laylinesVisible = Settings.LaylinesVisible;
        mapOrientation = Settings.MapOrientation;
        mapOrientationLabel = mapOrientation switch { "course" => "C\u2191", "head" => "H\u2191", _ => "N\u2191" };

        await module.InvokeVoidAsync("setFollow", follow);
        if (nightMode) await module.InvokeVoidAsync("setNightMode", true);
        if (mapOrientation != "north") await module.InvokeVoidAsync("setMapOrientation", mapOrientation);

        await PushGuardZoneAsync();
        Settings.OnSettingsChanged += HandleSettingsChanged;

        SignalkClient.OnDataChanged += HandleDataChanged;
        SignalkClient.OnConnectionChanged += HandleConnectionChanged;
        aisTimer = new System.Threading.Timer(_ => _ = PushAisTargets(), null, AisPushInitialDelayMs, AisPushIntervalMs);
        // AtoNs are static enough not to need a timer -- push on
        // store-change events plus once after init. AtonsVisible
        // setting is honoured by setAtonsVisible JS-side.
        Atons.OnAtonsUpdated += HandleAtonsUpdated;
        await module.InvokeVoidAsync("setAtonsVisible", Settings.AtonsVisible);
        _ = PushAtons();
        // Resource re-sync: waypoints / routes / notes / regions added
        // from another plotter are otherwise invisible until the user
        // toggles the Layers panel. 60 s poll keeps the list in sync
        // without hammering the REST endpoints. Initial delay matches
        // AisPushInitialDelayMs so the first poll doesn't collide with
        // the page-load resource fetch from OnInitializedAsync.
        resourcePollTimer = new System.Threading.Timer(
            _ => _ = RefreshServerResourcesAsync(),
            null, ResourcePollIntervalMs, ResourcePollIntervalMs);

        await module.InvokeVoidAsync("enableKeyboardShortcuts", dotNetRef);

        // Welcome card takes precedence over the touch coachmark on
        // first-ever visit since it covers long-press explicitly.
        var welcomeShown = await MaybeShowWelcomeAsync();
        if (!welcomeShown) await MaybeShowTouchCoachmarkAsync();

        // Resolve any deep-link from /map?focus=<type>:<id> or
        // ?edit=<type>:<id> -- set by the Resources page's View / Edit
        // buttons. Runs after the REST seed + map module are ready so
        // the target layers are already on the map.
        await ApplyMapDeepLinkAsync();
    }

    // Parse ?focus= or ?edit= from the URL and act on it. Silent no-op
    // if absent or unparseable; an unknown id surfaces a toast so the
    // user knows the target vanished (e.g. someone else deleted it on
    // another plotter after they opened the Resources page).
    private async Task ApplyMapDeepLinkAsync()
    {
        // Minimal query-string parse so we don't need the
        // Microsoft.AspNetCore.WebUtilities package for this single
        // call site. Only two keys are meaningful (focus / edit) and
        // the value format is "<kind>:<id>".
        var uri = new Uri(Nav.Uri);
        string? raw = null;
        bool editFlow = false;
        foreach (var seg in uri.Query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            int eq = seg.IndexOf('=');
            if (eq <= 0) continue;
            string key = seg[..eq];
            string val = Uri.UnescapeDataString(seg[(eq + 1)..]);
            if (key == "edit") { raw = val; editFlow = true; break; }
            if (key == "focus") { raw = val; editFlow = false; }
        }
        if (raw is null) return;
        var parts = raw.Split(':', 2);
        if (parts.Length != 2) return;
        string kind = parts[0];
        string id   = parts[1];

        switch (kind)
        {
            case "route":
                var route = availableRoutes.FirstOrDefault(r => r.Id == id);
                if (route is null) { Toasts.Warning("Route not found"); break; }
                if (editFlow) await EditRoute(route);
                else await FocusRoute(route);
                break;
            case "waypoint":
                var wp = loadedWaypoints.FirstOrDefault(w => w.Id == id);
                if (wp is null) { Toasts.Warning("Waypoint not found"); break; }
                if (wp.Latitude is double lat && wp.Longitude is double lon
                    && module is not null)
                {
                    await DisableFollowAsync();
                    try { await module.InvokeVoidAsync("panTo", lat, lon); }
                    catch (JSDisconnectedException) { }
                }
                break;
            case "note":
                var n = loadedNotes.FirstOrDefault(x => x.Id == id);
                if (n is null) { Toasts.Warning("Note not found"); break; }
                await FocusNote(n);
                break;
            case "region":
                var reg = loadedRegions.FirstOrDefault(x => x.Id == id);
                if (reg is null) { Toasts.Warning("Region not found"); break; }
                if (editFlow) await EditRegion(reg);
                else await FocusRegion(reg);
                break;
        }

        // Drop the query string once consumed so a page reload doesn't
        // re-apply the deep-link every time, and the URL shows /map
        // cleanly from the user's perspective. Use a relative path so
        // the SignalK-webapp mount point (e.g. /signalk-onaplotter/)
        // is preserved -- an absolute "/map" jumps off-mount.
        Nav.NavigateTo("map", forceLoad: false, replace: true);
    }

    // MaybeShowWelcomeAsync / DismissWelcome /
    // MaybeShowTouchCoachmarkAsync / DismissTouchCoachmark live in the
    // Map.FirstRun.razor.cs partial.

    private async Task PushGuardZoneAsync()
    {
        if (module is null) return;
        try
        {
            await module.InvokeVoidAsync("setGuardZone",
                Settings.CpaAlarmThreshold,
                Settings.GuardZoneLookaheadMinutes,
                Settings.GuardZoneWarningFactor);
        }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
    }

    // Fire-and-forget on the settings-changed event. PushGuardZoneAsync swallows
    // expected disposal races so nothing escapes as an unobserved task exception.
    private void HandleSettingsChanged()
    {
        _ = PushGuardZoneAsync();
        // Wake-lock toggles are handled by MainLayout's OnSettingsChanged
        // handler; the Map page no longer needs to relay them.

        // Night-mode: if the user toggled it from Settings (not from
        // the Map page's own button) we hold a stale local `nightMode`
        // field and, crucially, the Leaflet tile filter never gets
        // applied. Resync both when Settings differs from our copy.
        if (Settings.NightMode != nightMode)
        {
            nightMode = Settings.NightMode;
            if (module is not null)
                _ = InvokeVoidSafeAsync("setNightMode", (object)nightMode);
            _ = InvokeAsync(StateHasChanged);
        }

        // AtoN visibility toggle. The marker layer state survives the
        // hide/show cycle so flipping back doesn't have to re-fetch.
        if (module is not null)
            _ = InvokeVoidSafeAsync("setAtonsVisible", (object)Settings.AtonsVisible);
    }

    // Minimal swallower for fire-and-forget module calls from sync
    // event handlers. Matches the JSDisconnected / ObjectDisposed
    // defence we apply at every other interop site; also catches
    // JSException so a buggy JS call can't take down the render pass.
    private async Task InvokeVoidSafeAsync(string identifier, params object?[] args)
    {
        if (module is null) return;
        try { await module.InvokeVoidAsync(identifier, args); }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
        catch (JSException ex)
        {
            Console.Error.WriteLine($"[interop] {identifier}: {ex.Message}");
        }
    }

    [JSInvokable]
    public async Task OnKeyShortcut(string key)
    {
        switch (key)
        {
            case "m": await ToggleMob(); break;
            case "n": await ToggleNightMode(); break;
            case "f": await ToggleFollow(); break;
            case "a": await ToggleAnchor(); break;
            case "t": await ZoomToTrack(); break;
            case "l": await ToggleLaylines(); break;
            case "o": await CycleMapOrientation(); break;
            case "r": ToggleRaceTimer(); break;
            case "d": await ToggleMeasure(); break;
            case "?":
                // "?" only opens the shortcuts card when keyboard hints
                // are enabled in Settings. Default off so touch-only
                // users don't land on an unexpected modal if they
                // connect a keyboard and brush the key.
                if (Settings.ShowKeyboardHints) shortcutsVisible = !shortcutsVisible;
                break;
            case "escape":
                if (measureActive) { await ToggleMeasure(); }
                // Esc also cancels in-progress route / polygon edits so
                // the user can bail without reaching for the mouse.
                if (routeEditMode) { await CancelRouteEdit(); }
                if (polygonEditMode) { await CancelPolygonEdit(); }
                if (fabMenuOpen) { fabMenuOpen = false; }
                if (legendOpen) { legendOpen = false; }
                if (darkOps) { darkOps = false; }
                shortcutsVisible = false;
                break;
        }
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnMapBoundsChanged(double west, double south, double east, double north,
        double centerLat, double centerLon, double zoom)
    {
        viewWest = west;
        viewSouth = south;
        viewEast = east;
        viewNorth = north;
        RebuildFilteredLayers();
        // Only re-render if the layer panel is actually open.
        if (chartPanelOpen)
            _ = InvokeAsync(StateHasChanged);

        // Persist the new view. Fire-and-forget: a failed localStorage
        // write is the same as "storage disabled", which the settings
        // layer already tolerates silently. Guard on the zoom integer
        // round since Leaflet uses a non-integer zoom while pinching
        // and we only care about the settled zoom.
        int zoomInt = (int)Math.Round(zoom);
        _ = Settings.SetMapViewAsync(centerLat, centerLon, zoomInt);
    }

    // Charts without bounds are always shown. Otherwise AABB intersection test.
    private bool ChartIntersectsViewport(SignalkChart chart)
    {
        if (chart.Bounds is null || chart.Bounds.Length < 4) return true;
        // Pre-bounds-fix default: before the first OnMapBoundsChanged
        // delta arrives the view* fields are null. Mirror
        // RouteIntersectsViewport's explicit guard so a future change
        // to the comparison can't silently invert the default.
        if (viewWest is null) return true;

        double cWest = chart.Bounds[0], cSouth = chart.Bounds[1];
        double cEast = chart.Bounds[2], cNorth = chart.Bounds[3];

        return !(cEast < viewWest || cWest > viewEast || cNorth < viewSouth || cSouth > viewNorth);
    }

    // Uses pre-computed bounding box (computed once when routes are loaded).
    private bool RouteIntersectsViewport(SignalkRoute route)
    {
        if (viewWest is null) return true;
        if (!routeBounds.TryGetValue(route.Id, out var bbox) || bbox is null) return true;

        return !(bbox.Value.MaxLon < viewWest || bbox.Value.MinLon > viewEast
              || bbox.Value.MaxLat < viewSouth || bbox.Value.MinLat > viewNorth);
    }

    // Pre-compute bounding boxes for all routes (called once after loading).
    private void PrecomputeRouteBounds()
    {
        routeBounds.Clear();
        foreach (var route in availableRoutes)
        {
            if (route.Feature?.Geometry is null) { routeBounds[route.Id] = null; continue; }
            try
            {
                double minLat = double.MaxValue, maxLat = double.MinValue;
                double minLon = double.MaxValue, maxLon = double.MinValue;
                foreach (var point in route.Feature.Geometry.Coordinates.EnumerateArray())
                {
                    var arr = new double[2];
                    int i = 0;
                    foreach (var val in point.EnumerateArray())
                    {
                        if (i < 2) arr[i++] = val.GetDouble();
                    }
                    double lon = arr[0], lat = arr[1];
                    if (lat < minLat) minLat = lat;
                    if (lat > maxLat) maxLat = lat;
                    if (lon < minLon) minLon = lon;
                    if (lon > maxLon) maxLon = lon;
                }
                routeBounds[route.Id] = (minLat, maxLat, minLon, maxLon);
            }
            catch
            {
                routeBounds[route.Id] = null;
            }
        }
    }

    // Cached HUD values for change detection. Only re-render when these actually change.
    private string lastHudKey = "";

    private string BuildHudKey() =>
        $"{Data.SpeedOverGround:F2}|{Data.CourseOverGround:F3}|{Data.Heading:F3}|{Data.Depth:F1}|{Data.WindAngleApparent:F3}|{Data.WindSpeedApparent:F2}|{Data.WindAngleTrue:F3}|{Data.WindSpeedTrue:F2}|{Data.WindDirectionTrue:F3}" +
        $"|{Data.CourseNextPointDistance:F0}|{Data.CourseNextPointBearing:F2}|{Data.CourseNextPointVmg:F2}|{Data.CourseNextPointTimeToGo:F0}" +
        $"|{Data.AnchorCurrentRadius:F1}|{Data.AnchorMaxRadius:F1}|{Data.AnchorLatitude:F6}" +
        $"|{Data.CrossTrackError:F1}|{Data.ActiveRouteHref}" +
        // Route-level fields: progress chip + route-total row on the
        // active-route card. Without them in the key, a waypoint
        // advance would show new leg numbers but the "WP 3 of 7" chip
        // would lag until another field changed.
        $"|{Data.ActiveRoutePointIndex}|{Data.ActiveRoutePointTotal}" +
        $"|{Data.ActiveRouteDistanceRemaining:F0}|{Data.ActiveRouteTimeToGo:F0}";

    // One-time flag so we only push the own MMSI to JS once per
    // session. Self context resolves asynchronously via the hello
    // message; HandleDataChanged is the reliable cadence where
    // OwnMmsi becomes non-null.
    private bool _ownMmsiPushed;

    private async void HandleDataChanged()
    {
        if (!mapInitialized || module is null) return;

        // Keep the sticky last-heading field current for the HUD compass needle.
        if (Data.Heading is not null) lastHeading = Data.Heading;

        // Push own MMSI to JS once the SignalK hello resolves it so
        // buildSelfPopupHtml can fetch the country flag from the
        // signalk-flags plugin (same endpoint as AIS markers).
        if (!_ownMmsiPushed && SignalkClient.OwnMmsi is string mmsi)
        {
            _ownMmsiPushed = true;
            try { await module.InvokeVoidAsync("setOwnMmsi", mmsi); }
            catch (JSDisconnectedException) { _ownMmsiPushed = false; }
        }

        // Auto-flip Night mode near / past civil twilight if enabled.
        // Throttled to once per 30 s because sun altitude changes slowly.
        // Must sit after the mapInitialized guard so we don't try to
        // push setNightMode at a not-yet-imported module.
        await CheckAutoNightAsync();

        try
        {
            // Build the per-tick frame via the extracted builder. One
            // Blazor->JS bridge crossing per tick for up to six
            // overlays (position / track segment / course line / clear-
            // course / current arrow / laylines). Blazor's default
            // JSRuntime JsonOptions is CamelCase so the record-struct
            // fields arrive in JS as `pos.lat`, `pos.headingRad`, etc,
            // which is exactly what applyFrame expects.
            _frameBuilder.LaylinesVisible = laylinesVisible;
            var frame = _frameBuilder.Build(Data);
            await module.InvokeVoidAsync("applyFrame", frame);

            // Sync server-side anchor alarm to map visualization. Kept
            // out of applyFrame because it has its own diff-before-push
            // logic (href / radii) that doesn't map to a plain per-tick
            // snapshot.
            await SyncServerAnchorAsync();

            // Sync active route visualization (href-diff -> fetch + draw).
            await SyncActiveRouteAsync();

            // Only re-render Blazor component if HUD values actually changed.
            var hudKey = BuildHudKey();
            if (hudKey != lastHudKey)
            {
                lastHudKey = hudKey;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
        catch (JSException ex)
        {
            // A JS-side regression in any of updatePosition / setCourseLine
            // / setLaylines etc. used to bubble into Blazor's error UI and
            // freeze the render pass -- that's what hid the own-boat marker
            // in the chartLayers crash. Swallow + log so the UI stays live
            // and the browser console still surfaces the regression for
            // the dev. We fire at 1 Hz; a toast per tick would be spam.
            Console.Error.WriteLine($"[interop] HandleDataChanged: {ex.Message}");
        }
    }

    private async Task PushAisTargets()
    {
        if (!mapInitialized || module is null) return;
        try
        {
            var vessels = AisStore.GetVessels();
            // AisStore filters on position when building the snapshot, but
            // defend against someone clearing a position between snapshots
            // anyway - force-unwrap is never worth the risk in a hot path.
            // Pre-compute COLREGS per vessel (requires own lat/lon/cog/sog) so
            // the JS popup can render the category + give-way role without
            // re-implementing the math on the JS side.
            double? ownLat = Data.Latitude;
            double? ownLon = Data.Longitude;
            double? ownCog = Data.CourseOverGround;
            double? ownSog = Data.SpeedOverGround;

            var jsVessels = vessels
                .Where(v => v.Latitude is not null && v.Longitude is not null)
                .Select(v =>
                {
                    // Pre-compute COLREGS + CPA in C# so (a) Utilities/Cpa.cs
                    // + CpaTests is the single source of truth and (b) the
                    // BuildVesselList / PushAisTargets paths can't drift.
                    double? cpaNm = null;
                    double? tcpaMin = null;
                    string? colregsLabel = null;
                    string? colregsRole = null;
                    if (ownLat is not null && ownLon is not null
                        && ownCog is not null && ownSog is not null
                        && v.CourseOverGround is not null && v.SpeedOverGround is not null)
                    {
                        var cpa = Cpa.Compute(
                            ownLat.Value, ownLon.Value, ownCog, ownSog,
                            v.Latitude!.Value, v.Longitude!.Value,
                            v.CourseOverGround, v.SpeedOverGround);
                        if (cpa is { } c)
                        {
                            cpaNm = c.CpaNm;
                            tcpaMin = c.TcpaMin;
                        }

                        var r = Colregs.Classify(
                            ownLat.Value, ownLon.Value, ownCog.Value, ownSog.Value,
                            v.Latitude!.Value, v.Longitude!.Value,
                            v.CourseOverGround.Value, v.SpeedOverGround.Value);
                        if (r.Category != Colregs.Category.Indeterminate)
                        {
                            colregsLabel = Colregs.ShortLabel(r.Category);
                            colregsRole = Colregs.RoleLabel(r.Role);
                        }
                    }
                    // Pre-resolved visual fields so the JS layer is a
                    // dumb renderer: one source of truth for the AIS
                    // palette + SART classification in C#, tested in
                    // AisPaletteTests / AisSartAlarmRuleTests.
                    string? sartCat = OnaPlotter.Utilities.AisSart.CategoryFromAny(v.Mmsi, v.Context);
                    string? glyphCategory = OnaPlotter.Utilities.AisPalette.ShipTypeCategory(v.ShipType);

                    // CPA threat band (none / warning / danger) is computed
                    // here against the helm's guard-zone settings. JS used
                    // to redo this thresholding inline; lifting it up means
                    // CpaTests.ClassifyThreat is the single source of truth
                    // and the alarm pipeline + map overlay can't disagree.
                    var threat = Cpa.ClassifyThreat(
                        cpaNm, tcpaMin,
                        Settings.CpaAlarmThreshold,
                        Settings.GuardZoneLookaheadMinutes,
                        Settings.GuardZoneWarningFactor,
                        v.IsBuddy);
                    string cpaThreat = threat switch
                    {
                        Cpa.Threat.Danger => "danger",
                        Cpa.Threat.Warning => "warning",
                        _ => "none"
                    };

                    // Display name resolution -- name -> mmsi -> null,
                    // with buddy star prefix. Lifted out of JS so the
                    // chart label and any future label-rendering surface
                    // share the same fallback chain.
                    string? baseName = !string.IsNullOrEmpty(v.Name) ? v.Name
                        : !string.IsNullOrEmpty(v.Mmsi) ? v.Mmsi
                        : null;
                    string? displayName = baseName is null
                        ? null
                        : (v.IsBuddy ? "★ " + baseName : baseName);

                    return new
                    {
                        context = v.Context, name = v.Name, mmsi = v.Mmsi, callsign = v.Callsign,
                        displayName,                   // pre-resolved label or null
                        lat = v.Latitude!.Value, lon = v.Longitude!.Value,
                        headingRad = v.Heading, cogRad = v.CourseOverGround,
                        sogMs = v.SpeedOverGround, shipType = v.ShipType,
                        buddy = v.IsBuddy,
                        // Tell JS whether to render with an AIS or radar-ARPA
                        // icon. Radar targets lose buddy/danger overlays too;
                        // JS looks at this flag.
                        source = v.Source == OnaPlotter.Models.TargetSource.Radar ? "radar" : "ais",
                        sartCategory = sartCat,       // "SART"/"MOB"/"EPIRB" or null
                        glyphCategory,                 // "sail"/"fish"/"commercial"/"service"/null
                        shipColor = OnaPlotter.Utilities.AisPalette.ShipTypeColor(v.ShipType),
                        cpaNm,                         // nautical miles or null
                        tcpaMin,                       // minutes or null
                        cpaThreat,                     // "none"/"warning"/"danger"
                        colregsLabel,
                        colregsRole,
                        // Seconds since we last heard from this target. JS
                        // uses it to fade stale markers (>30 s) so the
                        // chart visually distinguishes a live target from
                        // a ghost that hasn't updated in minutes.
                        ageSec = (int)(DateTime.UtcNow - v.LastSeen).TotalSeconds
                    };
                }).ToArray();
            await module.InvokeVoidAsync("updateAisTargets", (object)jsVessels);
        }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
        catch (JSException ex)
        {
            // Hot path (every AIS tick). See HandleDataChanged for the
            // rationale: silent-but-logged stops a JS regression from
            // taking down the whole map UI.
            Console.Error.WriteLine($"[interop] PushAisTargets: {ex.Message}");
        }
    }

    private void HandleAtonsUpdated()
    {
        // AtonStore.OnAtonsUpdated fires from the websocket thread on
        // every delta-affecting change. WASM is single-threaded so
        // there's no thread-marshal needed; we just kick off the JS
        // push and let it await on its own. Idempotent re-pushes are
        // cheap (the JS side diffs by id), so we don't bother
        // debouncing -- the C# AtonStore.GetAtons cache already
        // means a re-push on no-data-change is just a snapshot read.
        _ = PushAtons();
    }

    private async Task PushAtons()
    {
        if (!mapInitialized || module is null) return;
        try
        {
            // Resolve the symbol kind + cardinal/lateral side here in C#
            // via AtonTypeCatalog.Lookup so JS stays a dumb renderer
            // (per the project's "decisions in C# with tests" rule).
            // Virtual flag: prefer the AtoN's own published value;
            // otherwise fall back to the catalog's "20-25 are virtual"
            // hint so an older plugin that omits the flag still
            // renders dashed.
            var atons = Atons.GetAtons();
            var jsAtons = atons
                .Where(a => a.Latitude is not null && a.Longitude is not null)
                .Select(a =>
                {
                    var info = AtonTypeCatalog.Lookup(a.TypeId);
                    bool isVirtual = a.Virtual ?? info.VirtualHint;
                    return new
                    {
                        context = a.Context,
                        name = a.Name,
                        mmsi = a.Mmsi,
                        lat = a.Latitude!.Value,
                        lon = a.Longitude!.Value,
                        typeId = a.TypeId,
                        typeName = a.TypeName,
                        symbol = info.Symbol.ToString(),
                        side = info.Side.ToString(),
                        @virtual = isVirtual,
                    };
                })
                .ToArray();
            await module.InvokeVoidAsync("setAtons", (object)jsAtons);
        }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
        catch (JSException ex)
        {
            Console.Error.WriteLine($"[interop] PushAtons: {ex.Message}");
        }
    }

