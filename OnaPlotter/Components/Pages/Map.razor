    // Coalesce region Changed events. Hoists RegionStore.SetRegions
    // out of the per-id loop body and calls it ONCE at the end of the
    // drain - the alarm rule only needs the final state, not N
    // intermediate snapshots, and the per-id call was the most
    // expensive part of the storm (full-list copy + alarm-rule
    // re-evaluation per region).
    private readonly HashSet<string> _pendingRegionChanges = new(StringComparer.Ordinal);
    private bool _regionFlushScheduled;

    private void HandleRegionChangedFromStore(string id)
    {
        _pendingRegionChanges.Add(id);
        if (_regionFlushScheduled) return;
        _regionFlushScheduled = true;
        _ = DrainPendingRegionChangesAsync();
    }

    private async Task DrainPendingRegionChangesAsync()
    {
        try
        {
            await Task.Yield();
            bool anyApplied = false;
            while (_pendingRegionChanges.Count > 0)
            {
                var batch = _pendingRegionChanges.ToArray();
                _pendingRegionChanges.Clear();
                foreach (var id in batch)
                {
                    try
                    {
                        if (await ApplyRegionChangedFromStoreAsync(id))
                            anyApplied = true;
                    }
                    catch (Exception ex)
                    {
                        Toasts.LogException(ex, $"Apply region change {id}");
                    }
                }
            }
            // Single SetRegions push at the end of the drain so
            // HazardousRegionAlarmRule re-evaluates against the final
            // state once, not once per id.
            if (anyApplied)
            {
                RegionStore.SetRegions(loadedRegions);
            }
        }
        finally
        {
            _regionFlushScheduled = false;
        }
    }

    private async Task<bool> ApplyRegionChangedFromStoreAsync(string id)
    {
        if (!mapInitialized || _resources is null) return false;
        var region = ResourceStore.GetRegion(id);
        if (region is null) return false;
        var idx = loadedRegions.FindIndex(r => r.Id == id);
        if (idx >= 0) loadedRegions[idx] = region;
        else loadedRegions.Add(region);
        await _resources.RedrawRegionAsync(region);
        await InvokeAsync(StateHasChanged);
        return true;
    }

    private void HandleRegionRemovedFromStore(string id) => _ = ApplyRegionRemovedFromStoreAsync(id);

    private async Task ApplyRegionRemovedFromStoreAsync(string id)
    {
        if (!mapInitialized || _resources is null) return;
        loadedRegions.RemoveAll(r => r.Id == id);
        RegionStore.SetRegions(loadedRegions);
        await _resources.DropRegionAsync(id);
        await InvokeAsync(StateHasChanged);
    }

    // ServerTrackController owns the server-track state + interop;
    // wired in OnAfterRenderAsync.

    /// <summary>Toggle night mode on/off. Helm-feedback: the previous
    /// four-step cycle (dusk -> soft -> amber -> red) was confusing;
    /// one tap on, one tap off is the binary mental model. Helms who
    /// want a non-red-shifted dark intermediate use Theme = "dark"
    /// instead. The Night button in the More menu and the keyboard
    /// "n" shortcut both call this.
    ///
    /// MarkManualNightToggleAsync records the env.sun cluster at
    /// toggle time so CheckAutoNightAsync suppresses until the next
    /// day/night transition - a deliberate toggle counts as a
    /// manual override.</summary>
    private async Task ToggleNightMode()
    {
        await Settings.MarkManualNightToggleAsync(SunClusterFromState(Data.SunState));
        nightMode = !nightMode;
        await Settings.SetNightModeAsync(nightMode);
        if (_controlsJs is not null)
            await _controlsJs.SetNightModeAsync(nightMode);
    }

    // Deadman refresh. Wired to pointerdown + keydown at the map-container
    // level; any pointer or key event resets the inactivity timer. Keeping
    // it sync (no await) so it never slows down input handling; the
    // tracker is a lock-free field write.
    private void TouchDeadman() => DeadmanTracker.Touch();

    // Auto-night plumbing. Dormant unless the user opts in via Settings
    // AND the server publishes environment.sun as one of
    // "day" / "dawn" / "dusk" / "night". The plugin knows about
    // civil-twilight cutoffs so we don't reimplement them. Manual
    // toggles capture the env.sun cluster at toggle time; auto-night
    // suppresses while the current cluster matches that override
    // and clears the override (= resumes auto-night) when env.sun
    // transitions to a different cluster - "until the next day/
    // night change in between", per helm-feedback. Persisted in
    // Settings.LastManualNightOverrideSunCluster so the override
    // survives navigation / reload.
    private DateTime _lastAutoNightCheckUtc = DateTime.MinValue;

    private async Task CheckAutoNightAsync()
    {
        if (!Settings.NightModeAuto) return;

        // Dusk / night => night on. Day / dawn => night off. Any
        // other value (empty, unknown, plugin not installed) skips
        // the flip entirely.
        bool? wantNightNullable = Data.SunState switch
        {
            "night" or "dusk" => true,
            "day" or "dawn" => false,
            _ => null,
        };
        if (wantNightNullable is not bool wantNight) return;

        var now = DateTime.UtcNow;
        // 30 s throttle - sun altitude changes at ~0.004 rad/min so we
        // don't need sub-minute responsiveness.
        if ((now - _lastAutoNightCheckUtc).TotalSeconds < 30) return;
        _lastAutoNightCheckUtc = now;

        // Cluster-suppression: if the helm manually toggled while
        // env.sun was in cluster X and env.sun is STILL in cluster
        // X, leave the override in place. When env.sun transitions
        // to the other cluster, clear the override - helm's choice
        // applied to "this cycle"; the next cycle starts fresh.
        var currentCluster = SunClusterFromState(Data.SunState);
        if (Settings.LastManualNightOverrideSunCluster is string overrideCluster)
        {
            if (overrideCluster == currentCluster) return;
            await Settings.ClearManualNightOverrideAsync();
        }

        if (wantNight == nightMode) return;

        nightMode = wantNight;
        await Settings.SetNightModeAsync(nightMode);
        if (_controlsJs is not null)
            await _controlsJs.SetNightModeAsync(nightMode);
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>Map the Signal K <c>environment.sun</c> string to a
    /// two-state cluster (day / night). Used by both the manual-
    /// toggle override capture and the auto-night transition check
    /// so the two surfaces speak the same vocabulary.</summary>
    private static string? SunClusterFromState(string? sunState) => sunState switch
    {
        "day" or "dawn" => "day",
        "dusk" or "night" => "night",
        _ => null,
    };

    // MOB clear confirmation now lives on MapControls (OnMobClicked)
    // as a two-tap pattern matching Stop-Navigation. The old
    // TaskCompletionSource-backed modal is gone; ToggleMob is called
    // only after the user has already armed + confirmed.

    /// <summary>Re-entry guard for the MOB drop / clear path. A slow
    /// JS interop on the alarm pipeline shouldn't let a second tap
    /// fire RaiseAsync / ClearAllAsync before the first finished -
    /// helm would see two MOB notifications or a clear-then-set race.</summary>
    private bool _mobOpInFlight;

    private async Task ToggleMob()
    {
        if (_mobOpInFlight) return;
        _mobOpInFlight = true;
        try
        {
            if (!mobActive)
            {
                // GPS is best-effort: a missing fix doesn't block the
                // raise (the SK MOB notification value's position
                // block is allowed to be null). Still warn the helm
                // so they reach for the VHF / handheld - the raise
                // is logged on the server but won't show a chart
                // marker until a fix exists.
                double? lat = Data.Latitude;
                double? lon = Data.Longitude;
                if (lat is null || lon is null)
                {
                    Toasts.Warning("MOB raised without a GPS fix - use VHF and handheld");
                }
                // Local-first via MobService: the synthetic enters
                // the alarm pipeline immediately and a paired waypoint
                // (isMob=true, isActive=true) gets posted in the
                // background. The chart marker comes from the waypoint
                // layer's MOB-icon variant - same path as any other
                // user-placed waypoint, just with the pulsing-red
                // styling. The REST POST for the notification reconciles
                // the WS echo into a single canonical entry.
                // mobActive flips automatically via the store-derived
                // computed property the moment the synthetic lands.
                // Default message lives on MobService so a single
                // edit changes it everywhere; pass null to inherit.
                await MobService.RaiseAsync(message: null, lat, lon);
                Toasts.Show("MOB dropped", ToastLevel.Success, durationSec: 8);
            }
            else
            {
                // Confirmed two-tap clear (MapControls pattern).
                // ClearAllAsync routes each active MOB through the
                // service: pending raises (no serverId yet) get
                // their retry loop cancelled + the local synthetic
                // dropped; raises with a serverId fire POST
                // /{id}/clear. mobActive flips false automatically
                // when the last MOB leaves the store.
                await MobService.ClearAllAsync();
            }
        }
        finally
        {
            _mobOpInFlight = false;
        }
    }

    /// <summary>Re-entry guard for the anchor raise / clear path. With
    /// the singleton HttpClient capped at 8 s, a flaky plugin response
    /// is no longer minutes-long, but the helm can still complete the
    /// arm+confirm sequence twice while one RaiseAsync is in flight.
    /// Without the guard, two POSTs land back-to-back; the helm sees
    /// the anchor flag bounce in the HUD as both responses come back.
    /// </summary>
    private bool _anchorRaiseInFlight;

    private async Task ToggleAnchor()
    {
        if (_anchorJs is null) return;
        if (_anchorRaiseInFlight) return;

        // Anchor button is the RAISE gesture once an anchor is
        // active. Two-tap arm-then-confirm pattern lives on the
        // button itself (MapControls.razor); by the time
        // ToggleAnchor runs in this branch the helm has already
        // confirmed. Adjusting the radius is a SEPARATE gesture -
        // tap on the Anchor Watch HUD card - so the Anchor button
        // stays unambiguously the "stop watching" action.
        if (Data.AnchorActive)
        {
            _anchorRaiseInFlight = true;
            // Arm the visual "raising" state + watchdog BEFORE the
            // PUT so the helm sees feedback during the in-flight
            // window. HttpClient.Timeout is 8 s; if we waited until
            // after success the helm would stare at a frozen Anchor
            // button + un-dimmed marker for up to 8 s on a slow
            // server.
            _anchorSync?.MarkRaisePending();
            try { await _anchorJs.SetAnchorRaisingAsync(true); }
            catch (Exception ex) { Toasts.LogException(ex, "Set anchor raising"); }
            ApiResult r;
            try
            {
                try { r = await AnchorAlarmApi.RaiseAsync(); }
                catch (Exception ex) { Toasts.LogException(ex, "Raise anchor"); return; }

                if (!r.Success)
                {
                    _anchorSync?.CancelRaisePending();
                    try { await _anchorJs.SetAnchorRaisingAsync(false); }
                    catch (Exception ex) { Toasts.LogException(ex, "Reset anchor raising"); }
                    Toasts.Error(AnchorFailureMessage("Raise", r));
                    return;
                }
                Toasts.Success("Anchor raised");
            }
            finally
            {
                _anchorRaiseInFlight = false;
            }
            return;
        }

        // No anchor active - open the Drop panel.
        if (Data.Latitude is null || Data.Longitude is null)
        {
            Toasts.Error("No GPS fix - can't drop anchor");
            return;
        }
        OpenAnchorDropPanel();
    }

    // --- Anchor panel state + callbacks --------------------------------
    // Two-state panel matching v2.0.0+ workflow: helm drops the pin
    // first (no radius), backs down, then sets the radius. The panel
    // mounts above the bottom-action bar (same z-strip as
    // RouteEditPanel / PolygonEditPanel). It owns no server state on
    // its own; this section is the single seam between the helm-facing
    // chrome and the plugin's PUT-handler surface.

    private bool anchorEditMode;
    private OnaPlotter.Components.Map.AnchorEditPanel.AnchorPanelMode _anchorPanelMode =
        OnaPlotter.Components.Map.AnchorEditPanel.AnchorPanelMode.Drop;
    private int anchorEditInitialRadius;
    private bool anchorEditBusy;
    /// <summary>True when the panel was opened standalone (helm tapped
    /// "Adjust" on the anchor-watch HUD card) rather than as the
    /// Drop -> SetRadius continuation. Drives whether the panel
    /// renders a Close button in SetRadius mode - standalone opens
    /// need an exit; the post-Drop continuation does not.</summary>
    private bool _anchorPanelStandalone;

    /// <summary>Eyebrow text the panel renders above its title. Mode-
    /// switched: Drop shows a static reminder; SetRadius shows the
    /// live Auto-formula breakdown so the helm sees what the Auto
    /// chip is summing right now ("swing 38 m + tide drop 4 m + 5 m
    /// margin"). Computed each render so the breakdown follows the
    /// boat as AnchorPeakRadius grows and the tide ticks toward low
    /// water; without that liveness the helm could read a stale
    /// number under a live chip face and wonder which one to
    /// trust.</summary>
    private string AnchorEyebrowEffective() => _anchorPanelMode switch
    {
        OnaPlotter.Components.Map.AnchorEditPanel.AnchorPanelMode.Drop
            => "Drop Anchor, let out chain, then set radius.",
        OnaPlotter.Components.Map.AnchorEditPanel.AnchorPanelMode.SetRadius
            => AnchorEyebrowHint(),
        _ => "",
    };

    /// <summary>True while the SetRadius panel has pushed a visual-
    /// only preview to the on-map ring (chip tap or Auto live-
    /// drift) without yet committing via Set. Lets us revert the
    /// ring to the server's MaxRadius if the panel closes without
    /// the PUT going through (e.g., helm raised the anchor mid-
    /// pick, or the panel mode flipped externally). Reset on Set
    /// success and on revert.</summary>
    private bool _anchorPreviewActive;

    /// <summary>Open the panel in Drop state (no anchor yet). The
    /// plugin captures the GPS position at PUT time; the radius is
    /// chosen later via OpenAnchorSetRadiusPanel.</summary>
    private void OpenAnchorDropPanel()
    {
        anchorEditInitialRadius = OnaPlotter.Components.Map.AnchorEditPanel.UnseededInitialRadius;
        anchorEditBusy = false;
        _anchorPanelMode = OnaPlotter.Components.Map.AnchorEditPanel.AnchorPanelMode.Drop;
        // Drop-mode Close is always rendered; the SetRadius-mode
        // Close (which reads ShowCloseButton) is suppressed here so
        // the post-Drop continuation doesn't offer a half-way exit.
        _anchorPanelStandalone = false;
        anchorEditMode = true;
    }

    /// <summary>Auto chip preview value: the radius the next tap on
    /// Auto will commit. The helm-readable model:
    ///
    /// <para><b>Auto = swing + tide drop + 5 m margin</b>, rounded up
    /// to the nearest 5 m, floored at 20 m.</para>
    ///
    /// <list type="bullet">
    ///   <item><b>swing</b>: the largest distance the boat has reached
    ///     from the anchor pin since drop. Sourced from
    ///     <see cref="OnaPlotter.Models.NavigationData.AnchorPeakRadius"/>
    ///     when the plugin has been publishing currentRadius;
    ///     falls back to AnchorCurrentRadius (current snapshot) and
    ///     then to the haversine distance boat-to-pin if neither
    ///     stream is available (e.g. manual anchor with no plugin
    ///     publishing currentRadius). The peak captures the
    ///     worst-case drift during the set phase: helm lets out
    ///     chain, the boat backs down, the chain becomes taut, and
    ///     the chart-recorded peak is the alarm-relevant number.</item>
    ///   <item><b>tide drop</b>: amount the tide is expected to fall
    ///     between now and the next predicted low water
    ///     (<c>environment.tide.heightNow</c> minus
    ///     <c>environment.tide.heightLow</c>). As tide drops the boat
    ///     descends with it and more chain becomes effective scope,
    ///     so the swing radius grows. Adding the drop directly is
    ///     conservative; the catenary maths actually deliver
    ///     somewhat less extra horizontal swing at typical 5:1
    ///     scope, but the safety direction is the right one. Zero
    ///     when tide data is missing or tide is already at / below
    ///     the predicted low.</item>
    ///   <item><b>5 m margin</b>: blanket safety pad on top of the
    ///     above so the alarm doesn't trip on a single-step boat
    ///     swing right at the calculated edge. Constant; the
    ///     helm has the numeric chips for finer control if they
    ///     want a different cushion.</item>
    /// </list>
    ///
    /// <para>Returns null when no anchor pin is set or no GPS fix
    /// has landed yet; the panel's Auto chip then renders as plain
    /// "Auto" without the previewed number, and the OnPickAuto
    /// handler refuses to commit a placeholder. The 20 m floor
    /// stops a stale GPS sitting right on top of the pin from
    /// shipping a 5 m alarm radius (smaller than helm-typical
    /// anchor swing on any cruising boat).</para>
    ///
    /// <para><see cref="AutoRadiusBreakdown"/> renders the same
    /// inputs as a helm-readable string for the chip tooltip and
    /// the panel's eyebrow hint, so the two read consistently.</para>
    /// </summary>
    private int? AutoRadiusPreview()
    {
        var p = AutoRadiusParts();
        if (p is null) return null;
        double total = p.Value.SwingMeters + p.Value.TideDropMeters + Settings.AnchorAutoRadiusSafetyMargin;
        int rounded = (int)Math.Ceiling(total / 5.0) * 5;
        return Math.Max(rounded, AutoRadiusFloorMeters);
    }

    /// <summary>Helm-readable breakdown of the live Auto radius: the
    /// summed components in <see cref="AutoRadiusPreview"/> rendered
    /// as e.g. "swing 38 m + tide drop 4 m + 5 m margin". Powers the
    /// Auto chip's tooltip and the panel's eyebrow hint; null
    /// (rendered as plain "Auto") when no preview is available.
    /// Tide span is omitted when the tide drop is zero (rising tide
    /// or no tide data) so the line doesn't read as "+ 0 m" noise.</summary>
    private string? AutoRadiusBreakdown()
    {
        var p = AutoRadiusParts();
        if (p is null) return null;
        int swing = (int)Math.Round(p.Value.SwingMeters);
        int tide = (int)Math.Round(p.Value.TideDropMeters);
        string swingLabel = p.Value.SwingFromPeak ? "swing" : "current";
        double margin = Settings.AnchorAutoRadiusSafetyMargin;
        return tide > 0
            ? $"{swingLabel} {swing} m + tide drop {tide} m + {margin:F0} m margin"
            : $"{swingLabel} {swing} m + {margin:F0} m margin";
    }

    /// <summary>Compute the unrounded components that feed
    /// <see cref="AutoRadiusPreview"/> and <see cref="AutoRadiusBreakdown"/>.
    /// Returns null when no usable signal is available (no anchor
    /// pin AND no GPS fix). Both consumers run off the same source
    /// so the chip's number always matches its tooltip's breakdown.</summary>
    private AutoRadiusComponents? AutoRadiusParts()
    {
        // Pick the swing component from the most reliable source
        // available. Peak first (monotonic worst-case during the
        // anchor session); current radius next (live snapshot from
        // the plugin); finally a haversine fallback against the
        // anchor pin when the plugin isn't publishing currentRadius.
        double? swing = null;
        bool fromPeak = false;
        if (Data.AnchorPeakRadius is double pk && double.IsFinite(pk) && pk >= 0)
        {
            swing = pk;
            fromPeak = true;
        }
        else if (Data.AnchorCurrentRadius is double cur && double.IsFinite(cur) && cur >= 0)
        {
            swing = cur;
        }
        else if (Data.AnchorLatitude is double aLat
                 && Data.AnchorLongitude is double aLon
                 && Data.Latitude is double lat
                 && Data.Longitude is double lon)
        {
            double distM = OnaPlotter.Utilities.RouteProgress.HaversineMeters(aLat, aLon, lat, lon);
            if (double.IsFinite(distM) && distM >= 0) swing = distM;
        }
        if (swing is null) return null;

        // Tide-drop component. Both fields are populated by
        // signalk-tides-api / similar plugins as
        // environment.tide.heightNow / .heightLow. heightLow is the
        // *next* predicted low; heightNow is the current level. A
        // positive delta means the tide is still falling toward the
        // predicted low. Negative or absent -> zero drop.
        double tideDrop = 0;
        if (Data.TideHeightNow is double hn
            && Data.TideHeightLow is double hl
            && double.IsFinite(hn) && double.IsFinite(hl)
            && hn > hl)
        {
            tideDrop = hn - hl;
        }
        return new AutoRadiusComponents(swing.Value, tideDrop, fromPeak);
    }

    /// <summary>Per-component values feeding the Auto radius. Record
    /// struct so the two helpers can return the same shape without
    /// allocating per call (the chip preview ticks every render).</summary>
    private readonly record struct AutoRadiusComponents(
        double SwingMeters,
        double TideDropMeters,
        bool SwingFromPeak);

    /// <summary>Smallest radius the Auto picker will ever ship.
    /// Stops a stale GPS that puts the boat right on top of the pin
    /// from shipping a 5 m alarm radius (smaller than helm-typical
    /// anchor swing on any cruising boat).</summary>
    private const int AutoRadiusFloorMeters = 20;

    /// <summary>Open the panel in Set Radius state. When the anchor
    /// is already armed (Data.AnchorMaxRadius published), pre-select
    /// the current armed radius so the helm sees "you're at 50 m,
    /// want to change?" instead of an Auto chip that would silently
    /// commit a different value. When NOT armed (just dropped, or
    /// helm closed without arming), default to Auto via the
    /// UnseededInitialRadius sentinel - helm-driven preference for
    /// the plugin-computed value on first arming.</summary>
    private void OpenAnchorSetRadiusPanel()
    {
        anchorEditInitialRadius = Data.AnchorMaxRadius is double r && r > 0
            ? (int)Math.Round(r)
            : OnaPlotter.Components.Map.AnchorEditPanel.UnseededInitialRadius;
        anchorEditBusy = false;
        _anchorPanelMode = OnaPlotter.Components.Map.AnchorEditPanel.AnchorPanelMode.SetRadius;
        // Standalone open: helm tapped Adjust on the anchor-watch
        // HUD card. Show the Close button so they can back out
        // without committing a new radius.
        _anchorPanelStandalone = true;
        anchorEditMode = true;
    }

    /// <summary>Eyebrow text shown above the radius chips in SetRadius
    /// mode. Prefers the live Auto-formula breakdown
    /// ("swing 38 m + tide drop 4 m + 5 m margin") so the panel's
    /// helm-visible hint matches the calculation behind the Auto
    /// chip. Falls back to the depth-based 5:1 scope description
    /// from <see cref="OnaPlotter.Utilities.AnchorRadiusHeuristic"/>
    /// when no Auto breakdown is available yet (no anchor pin /
    /// no GPS / no tide data combined with no published peak),
    /// because a depth-only suggestion is still better than no
    /// hint at all.</summary>
    private string AnchorEyebrowHint() =>
        AutoRadiusBreakdown()
        ?? OnaPlotter.Utilities.AnchorRadiusHeuristic.DescribeSuggestion(Data.Depth);

    /// <summary>Render a helm-readable failure toast for an anchor PUT
    /// based on the response status code. 401 / 403 = auth problem
    /// (often a read-only helm role); 404 / 405 = endpoint missing
    /// (plugin not installed or v1.x). Without this disambiguation
    /// every failure read as "v2.0.0+ required" - a permission
    /// problem sent the helm down the wrong rabbit hole.</summary>
    private static string AnchorFailureMessage(string verb, ApiResult r) => r.StatusCode switch
    {
        401 or 403 => $"{verb} failed: permission denied - check your SignalK login role",
        404 or 405 => $"{verb} failed: anchor plugin v2.0.0+ required (open SignalK admin -> App Store -> Anchor Alarm)",
        _ => $"{verb} failed: {r.Error ?? "see browser console"}",
    };

    /// <summary>Step 1: POST <c>/plugins/anchoralarm/dropAnchor</c>
    /// with empty body. Plugin captures current GPS as the anchor
    /// position; <c>maxRadius</c> stays null (unarmed) until the
    /// helm picks a chip in step 2. Panel auto-flips to SetRadius
    /// mode on success so the helm doesn't tap Anchor twice.
    /// <para>Plugin v2.0.0+ is required (see Paths page). Failure
    /// surfaces a helm-readable toast via
    /// <see cref="AnchorFailureMessage"/>; no client-side fallback.</para></summary>
    private async Task OnAnchorPanelDrop()
    {
        // Parent-side busy guard. The child panel's Busy parameter is
        // the primary defence but Blazor's render queue can let a fast
        // double-tap fire OnDropClicked twice before StateHasChanged
        // propagates Busy=true back to the child - two concurrent
        // POSTs would land.
        if (anchorEditBusy) return;
        if (Data.Latitude is null || Data.Longitude is null)
        {
            Toasts.Error("No GPS fix - can't drop anchor");
            return;
        }
        anchorEditBusy = true;
        ApiResult r;
        try { r = await AnchorAlarmApi.DropAsync(); }
        catch (Exception ex) { r = ApiResult.Fail(ex.Message); }

        if (r.Success)
        {
            // Course clear AFTER a successful drop - previously this
            // ran first, which left the helm with a cleared course
            // AND no anchor whenever the drop failed.
            if (Data.HasActiveCourse)
            {
                try { await CourseApi.ClearAsync(); }
                catch (Exception ex) { Toasts.LogException(ex, "Stop course"); }
            }
            Toasts.Success("Anchor dropped - back down, then tap Auto or pick a radius");
            // Flip the panel directly to SetRadius mode so the helm
            // doesn't have to tap Anchor twice. Auto chip is the
            // default selection (UnseededInitialRadius sentinel).
            anchorEditInitialRadius = OnaPlotter.Components.Map.AnchorEditPanel.UnseededInitialRadius;
            _anchorPanelMode = OnaPlotter.Components.Map.AnchorEditPanel.AnchorPanelMode.SetRadius;
            anchorEditBusy = false;
            return;
        }

        Toasts.Error(AnchorFailureMessage("Drop", r));
        anchorEditBusy = false;
    }

    /// <summary>Visual-only preview: helm tapped a chip (or Auto's
    /// recomputed value changed mid-drift). Push the new radius to
    /// the on-map alarm ring directly via JS interop - NO PUT.
    /// Stored in <see cref="_anchorPreviewActive"/> so we know to
    /// revert the ring back to the server's MaxRadius if the helm
    /// closes the panel without tapping Set. The helm-visible
    /// effect: as they hover chips, the ring resizes; tapping Set
    /// commits, and tapping Auto on a drifting boat grows the ring
    /// in 5 m steps without spamming PUTs.</summary>
    private async Task OnAnchorPanelPreviewRadius(int radiusMeters)
    {
        if (_anchorJs is null) return;
        _anchorPreviewActive = true;
        try { await _anchorJs.UpdateAnchorRadiusAsync(radiusMeters); }
        catch (Exception ex) { Toasts.LogException(ex, "Preview anchor radius"); }
    }

    /// <summary>Step 2: PUT <c>navigation.anchor.maxRadius</c> with
    /// the helm-chosen value. Plugin arms the alarm circle + starts
    /// publishing currentRadius for drift monitoring. The radius
    /// arg is the panel's effective pick (numeric chip face if
    /// numeric is picked, AutoPreviewRadius if Auto is picked -
    /// both routes land here so the wire path is uniform).
    /// On success the panel auto-closes (helm picked, helm set,
    /// done); on failure it stays open so the helm can retry or
    /// pick a different chip.</summary>
    private async Task OnAnchorPanelSet(int radiusMeters)
    {
        if (anchorEditBusy) return;     // double-tap guard, see OnAnchorPanelDrop
        anchorEditBusy = true;
        ApiResult r;
        try { r = await AnchorAlarmApi.SetMaxRadiusAsync(radiusMeters); }
        catch (Exception ex) { r = ApiResult.Fail(ex.Message); }

        if (r.Success)
        {
            // Persist the choice so the heuristic-default on a future
            // depth-less drop still has a sensible value to suggest.
            await Settings.SetManualAnchorRadiusMetersAsync(radiusMeters);
            // Preview reconciles with reality on the next server delta;
            // ServerAnchorSync diffs MaxRadius against _lastPushedRadius
            // and pushes the authoritative value. Clear the preview
            // flag so a subsequent panel-close doesn't try to revert.
            _anchorPreviewActive = false;
            anchorEditMode = false;
            anchorEditBusy = false;
            return;
        }
        Toasts.Error(AnchorFailureMessage("Set radius", r));
        anchorEditBusy = false;
    }

    /// <summary>Drop-mode Close: dismiss the panel without dropping.
    /// SetRadius mode no longer has a Close button (helm exits by
    /// raising via the Anchor button); but if the parent closes the
    /// panel for some other reason (mode flip, page navigation),
    /// any pending visual preview is reverted here so the on-map
    /// ring matches the server's authoritative MaxRadius.</summary>
    private async Task OnAnchorPanelCancel()
    {
        anchorEditMode = false;
        anchorEditBusy = false;
        await RevertAnchorPreviewIfActiveAsync();
    }

    /// <summary>Restore the on-map alarm ring to the server's
    /// authoritative MaxRadius after a preview that didn't get
    /// committed. Called from any path that closes the SetRadius
    /// panel without going through Set. No-op when no preview was
    /// active or the JS module is gone.</summary>
    private async Task RevertAnchorPreviewIfActiveAsync()
    {
        if (!_anchorPreviewActive || _anchorJs is null) return;
        _anchorPreviewActive = false;
        double serverRadius = Data.AnchorMaxRadius ?? 30;
        try { await _anchorJs.UpdateAnchorRadiusAsync(serverRadius); }
        catch (Exception ex) { Toasts.LogException(ex, "Revert anchor preview"); }
    }

    private async Task ZoomToTrack()
    {
        if (_controlsJs is not null)
            await _controlsJs.ZoomToTrackAsync();
    }

    // Zoom the map to the bounding box of the given route. Called from
    // the Resources-page "View" deep-link; the route may not be
    // currently enabled, so we flip it on first so the polyline is
    // actually visible after the fit.
    private async Task FocusRoute(SignalkRoute route)
    {
        if (_controlsJs is null) return;
        chartPanelOpen = false;
        if (!enabledRoutes.Contains(route.Id))
        {
            await ToggleRoute(route, true);
        }
        if (!routeBounds.TryGetValue(route.Id, out var bbox) || bbox is null)
        {
            Toasts.Warning("Route has no mappable geometry");
            return;
        }
        await DisableFollowAsync();
        await _controlsJs.FitBoundsAsync(
            bbox.Value.MinLat, bbox.Value.MinLon,
            bbox.Value.MaxLat, bbox.Value.MaxLon);
    }

    // Zoom +/- handlers used to live here for an in-map overlay
    // button pair. They're now in MainLayout.razor's topbar (the JS
    // exports zoomIn/zoomOut on leafletInterop are still the
    // contract); kept the JS exports, dropped the C# wrappers since
    // no other call site needed them.

    /// <summary>
    /// One-shot pan to own-boat at the current zoom level. Distinct from
    /// Follow, which continuously re-centres on every position update.
    /// A helmsman panning the chart to look ahead wants a single "take
    /// me back to me" tap without engaging the lock.
    /// </summary>
    private async Task CentreOnBoat()
    {
        if (_controlsJs is null) return;
        if (Data.Latitude is not double lat || Data.Longitude is not double lon)
        {
            // Silent no-op would look like a dead button at the helm;
            // tell the user WHY the tap did nothing.
            Toasts.Show("No GPS fix");
            return;
        }
        await _controlsJs.PanToAsync(lat, lon);
    }

    // unsaved-changes guard (editNavGuard / InstallEditNavGuard /
    // RemoveEditNavGuard) lives in Map.Editing.razor.cs with the
    // edit flows it protects.

    public async ValueTask DisposeAsync()
    {
        // Flip mapInitialized FIRST so any HandleDataChanged / Sync*Async
        // that's currently parked between awaits bails at its next check
        // instead of hitting a half-torn-down JS module. The unsubscribe
        // below stops NEW invocations, but an in-flight one that's
        // already past its entry guard (fetching route coords, waiting
        // on an HTTP round-trip, etc.) would otherwise resume into a
        // disposed module and throw "addLayer on null" in the browser
        // console.
        mapInitialized = false;
        SignalkClient.OnDataChanged -= HandleDataChanged;
        SignalkClient.OnConnectionChanged -= HandleConnectionChanged;
        ResourceStore.OnRouteChanged -= HandleRouteChangedFromStore;
        ResourceStore.OnRouteRemoved -= HandleRouteRemovedFromStore;
        ResourceStore.OnWaypointChanged -= HandleWaypointChangedFromStore;
        ResourceStore.OnWaypointRemoved -= HandleWaypointRemovedFromStore;
        ResourceStore.OnNoteChanged -= HandleNoteChangedFromStore;
        ResourceStore.OnNoteRemoved -= HandleNoteRemovedFromStore;
        ResourceStore.OnRegionChanged -= HandleRegionChangedFromStore;
        ResourceStore.OnRegionRemoved -= HandleRegionRemovedFromStore;
        Atons.OnAtonsUpdated -= HandleAtonsUpdated;
        Settings.OnSettingsChanged -= HandleSettingsChanged;
        RemoveEditNavGuard();
        // Mark JS wrappers as disposed so any in-flight Sync* calls that
        // are parked between awaits become silent no-ops instead of
        // hitting the about-to-be-disposed module reference. The wrappers
        // themselves don't own the IJSObjectReference; the page disposes
        // it once below.
        _anchorJs?.MarkDisposed();
        _routeJs?.MarkDisposed();
        _aisJs?.MarkDisposed();
        _marinePoiJs?.MarkDisposed();
        _overlaysJs?.MarkDisposed();
        _resourceJs?.MarkDisposed();
        _controlsJs?.MarkDisposed();
        _editJs?.MarkDisposed();
        if (aisTimer is not null) await aisTimer.DisposeAsync();
        // Cancel any in-flight Overpass debounce / fetch so a
        // straggler doesn't try to push markers into a torn-down
        // JS module.
        if (_marinePoi is not null) await _marinePoi.DisposeAsync();
        if (raceTimer is not null) await raceTimer.DisposeAsync();
        if (routeStatsTimer is not null) await routeStatsTimer.DisposeAsync();
        if (polygonStatsTimer is not null) await polygonStatsTimer.DisposeAsync();
        if (touchCoachmarkTimer is not null) await touchCoachmarkTimer.DisposeAsync();
        if (module is not null)
        {
            // Bare interop: MarkDisposed above already gates the typed
            // wrappers, so calling them here would be silent no-ops.
            // The teardown sequence has to drive the module reference
            // directly, then dispose it.
            try
            {
                await module.InvokeVoidAsync("clearActiveRoute");
                await module.InvokeVoidAsync("clearCourseLine");
                await module.InvokeVoidAsync("clearLaylines");
                await module.InvokeVoidAsync("clearCurrentArrow");
                await module.InvokeVoidAsync("clearWeatherOverlay");
                await module.InvokeVoidAsync("disableKeyboardShortcuts");
                // Wake lock is owned by MainLayout now; do NOT release
                // it here, otherwise switching Chart -> Wind would
                // briefly drop the lock.
                await module.InvokeVoidAsync("dispose");
                await module.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
        }
        dotNetRef?.Dispose();
    }
}
