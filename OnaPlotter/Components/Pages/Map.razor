    /// <summary>Called from the AIS popup's Buddy link. Adds or removes the
    /// target via the plugin's REST API, then refreshes the buddy list and
    /// retags the tracked AIS vessels.</summary>
    [JSInvokable]
    public async Task OnToggleBuddy(string context, string? mmsi, string? name, bool currentlyBuddy)
    {
        // Plugin's API takes URNs like "urn:mrn:imo:mmsi:NNN", not the
        // leading "vessels." prefix that SignalK contexts carry.
        string urn = context.StartsWith("vessels.", StringComparison.Ordinal)
            ? context["vessels.".Length..] : context;
        string friendly = string.IsNullOrWhiteSpace(name)
            ? (mmsi is { } m ? $"MMSI {m}" : urn) : name!;

        var r = currentlyBuddy
            ? await BuddyListApi.RemoveAsync(urn)
            : await BuddyListApi.AddAsync(urn, friendly);

        if (r.Success)
        {
            Toasts.Success(currentlyBuddy ? $"Removed {friendly} from buddies" : $"Added {friendly} to buddies");
            await RefreshBuddiesAsync();
            // Force an immediate AIS re-push so the open popup (and all
            // vessel markers) rebind with the new buddy flag - otherwise
            // the captain waits up to AisPushIntervalMs to see the change.
            await PushAisTargets();
        }
        else
        {
            // Default reason matters: r.Error is null when the API returned
            // a non-success status with no body, which is almost always
            // "the buddy-list plugin isn't installed or the request wasn't
            // authorised" rather than a transient error. Tell the helm what
            // to check instead of leaving them with developer shorthand.
            // Buddy list lives in an optional SK plugin; if the helm
            // hasn't installed it the server just returns "not found".
            // De-jargon the fallback: helm isn't expected to know
            // what "authorised" means in the SK admin sense.
            Toasts.Error($"Buddy update failed: {r.Error ?? "buddy-list plugin missing or you're not signed in."}");
        }
    }

    /// <summary>
    /// Called from the AIS popup's "Snooze alarm" link. Looks up any
    /// active alarm on this vessel (CPA is the common one) and silences
    /// it via AlarmManager.SnoozeAsync. If no alarm is currently active
    /// on the target, nothing happens - we don't "pre-silence" a
    /// future alarm because the AlarmManager tracks snoozes per-target
    /// which already covers the common "this boat is a false positive,
    /// mute it for 10 min" workflow once the first alarm fires.
    /// </summary>
    [JSInvokable]
    public async Task OnSnoozeVessel(string context, string? name)
    {
        // AlarmManager snooze is per-target-key; AIS contexts are the
        // canonical target key. Find the active CPA alarm on that
        // context and snooze it.
        var active = Alarms.ActiveAlarms.FirstOrDefault(a => a.TargetKey == context);
        if (active is null)
        {
            // The popup only shows Snooze when CPA is in the warn/danger
            // band, but the push payload we read from can lag the
            // AlarmManager by a tick. Toast a friendly no-op rather than
            // silently do nothing.
            Toasts.Show($"No active alarm on {name ?? "vessel"}");
            return;
        }
        await Alarms.SnoozeAsync(active);
        Toasts.Success($"Snoozed {name ?? "vessel"} for {Alarms.SnoozeDurationMinutes} min");
    }

    /// <summary>Re-fetches the buddy list from the plugin and retags all
    /// tracked AIS vessels. Called after a user-initiated add/remove and
    /// from the Refresh button on the Buddies panel.</summary>
    private async Task RefreshBuddiesAsync()
    {
        var refreshed = await BuddyListApi.GetAllAsync();
        if (refreshed is null) return;
        loadedBuddies = refreshed;
        AisStore.UpdateBuddies(refreshed.Select(b => $"vessels.{b.Urn}"));
        await InvokeAsync(StateHasChanged);
    }

