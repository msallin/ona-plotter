    private async Task StopNavigation()
    {
        contextMenuVisible = false;

        // Capture destination BEFORE the API call so the Undo toast
        // can restore it after a successful stop. position via the
        // SignalK course API covers both waypoint- and route-based
        // destinations.
        var savedLat = Data.CourseNextPointLatitude;
        var savedLon = Data.CourseNextPointLongitude;

        // Pure-helper path: the in-flight guard + ClearAsync call live
        // in StopNavigationFlow so the contract is unit-testable
        // without bUnit / JS interop. Map.razor still owns the visual
        // side-effects (route-stopping CSS, undo toast); ActiveRouteSync
        // owns the pending-stop timestamp.
        DateTime? pendingSince = (_activeRouteSync?.CourseStopPending ?? false)
            ? DateTime.UtcNow
            : null;
        var result = await OnaPlotter.Utilities.StopNavigationFlow.RequestStopAsync(
            CourseApi, pendingSince);
        if (result.Outcome == OnaPlotter.Utilities.StopNavigationOutcome.AlreadyPending) return;
        if (result.Outcome == OnaPlotter.Utilities.StopNavigationOutcome.Failed)
        {
            Toasts.Error($"Stop navigation failed: {result.ErrorMessage ?? "unknown"}");
            return;
        }

        // Visual "stopping in progress" feedback until the SK delta
        // confirms (Data.ActiveRouteHref clears). Same pattern as the
        // anchor-raise feedback in NavigateRouteInternal / ToggleAnchor:
        // don't optimistically mutate Data here - that would mask a
        // server-side failure (PUT 200 but the plugin didn't actually
        // clear) AND race the next delta tick that would re-establish
        // the cleared course from the server's still-stale state. Let
        // ActiveRouteSync drive the truth; dim the on-map elements
        // so the helm sees their tap landed.
        _activeRouteSync?.MarkCourseStopPending();
        if (_routeJs is not null)
            await _routeJs.SetActiveRouteStoppingAsync(true);
        await InvokeAsync(StateHasChanged);

        if (savedLat is not null && savedLon is not null)
        {
            double lat = savedLat.Value, lon = savedLon.Value;
            Toasts.ShowAction(
                "Navigation stopped",
                "Undo",
                async () =>
                {
                    try
                    {
                        await CourseApi.SetDestinationPositionAsync(lat, lon);
                        Toasts.Success("Navigation restored");
                    }
                    catch (Exception ex) { Toasts.LogException(ex, "Undo"); }
                },
                durationSec: 6);
        }
    }

    private async Task NavigateToWaypoint(SignalkWaypoint wp)
