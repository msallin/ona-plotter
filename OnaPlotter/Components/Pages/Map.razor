    // --- GPX Import/Export ---

    private async Task HandleGpxImport(InputFileChangeEventArgs e)
    {
        try
        {
            using var reader = new System.IO.StreamReader(e.File.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024));
            string xml = await reader.ReadToEndAsync();
            var data = GpxService.Parse(xml);

            foreach (var route in data.Routes)
                await ChartService.SaveRouteAsync(route.Name, route.Coords);

            foreach (var wp in data.Waypoints)
                await ChartService.CreateWaypointAsync(wp.Name, wp.Lat, wp.Lon);

            // Refresh lists.
            availableRoutes = await ChartService.GetRoutesAsync();
            loadedWaypoints = await ChartService.GetWaypointsAsync();
            PrecomputeRouteBounds();
            RebuildFilteredLayers();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            System.Console.Error.WriteLine($"GPX import failed: {ex.Message}");
        }
    }

