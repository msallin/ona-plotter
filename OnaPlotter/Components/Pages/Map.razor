    private async Task ToggleRoute(SignalkRoute route, bool enabled)
    {
        if (_routeJs is null || route.Feature?.Geometry is null) return;

        if (enabled)
        {
            // Suppress the regular polyline if this route is the active
            // course - the active overlay handles the visual and a
            // duplicate polyline underneath reads as a stuck progress
            // bar. Same logic as ActiveRouteSync.
            if (_activeRouteSync?.ActiveRouteRegularSuppressed != route.Id)
            {
                await AddRouteToMap(route);
            }
            enabledRoutes.Add(route.Id);
        }
        else
        {
            await _routeJs.RemoveRouteAsync(route.Id);
            enabledRoutes.Remove(route.Id);
        }
        await Settings.SetEnabledRoutesAsync(enabledRoutes);
    }

    /// <summary>Push a SignalK route to Leaflet as a visible layer. Shared
    /// between the Layers-panel toggle and the post-save auto-enable path
    /// (which otherwise only updated state but forgot to draw).</summary>
    private async Task AddRouteToMap(SignalkRoute route)
    {
        if (_routeJs is null || route.Feature?.Geometry is null) return;

        // Re-use the parsed coords from PrecomputeRouteBounds when
        // possible. ad-hoc routes that arrive after the seed (e.g.
        // a fresh save before the next list refresh) parse on the
        // spot; cache them for the next call.
        if (!routeCoordsCache.TryGetValue(route.Id, out var coordsArr))
        {
            coordsArr = ParseRouteCoords(route);
            routeCoordsCache[route.Id] = coordsArr;
        }
        if (coordsArr.Length == 0) return;

        // Compute the route's total distance C#-side via the shared
        // haversine sum so the JS render path doesn't re-derive it.
        // RouteProgress.TotalDistanceMeters is the canonical source;
        // dividing by metres-per-NM keeps one conversion site.
        double totalNm = OnaPlotter.Utilities.RouteProgress.TotalDistanceMeters(coordsArr) / 1852.0;
        await _routeJs.AddRouteAsync(route.Id, route.Name, coordsArr, totalNm);
    }

    /// <summary>
    /// ResourceStore -> Map.razor adapter for delta-driven route updates.
    /// Fires when the SK server publishes a <c>resources.routes.&lt;id&gt;</c>
    /// delta (PUT / POST from any plotter on the network), AND once per
    /// route during a reconnect-edge reconcile (the cache fires Changed
    /// for every upserted entry regardless of whether it actually
    /// differs). On a 90-route boat that's 90 fire-and-forget
    /// ApplyRouteChangedFromStoreAsync tasks racing through the same
    /// JS-interop path simultaneously, which on a Pi WASM host blew the
    /// 5 MB stack ("RuntimeError: memory access out of bounds" in the
    /// renderer trace) every time the WS dropped + reconnected.
    /// <para>Coalesce: queue the id and schedule ONE drain pass via
    /// Task.Yield. Subsequent events within the same dispatcher tick
    /// fold into the existing pending set; the drain serialises the
    /// per-id work so only one redraw is in flight at a time. Single
    /// drain also keeps the JS interop count proportional to the number
    /// of distinct routes touched, not to the event count.</para>
    /// </summary>
    private readonly HashSet<string> _pendingRouteChanges = new(StringComparer.Ordinal);
    private bool _routeFlushScheduled;

    private void HandleRouteChangedFromStore(string id)
    {
        _pendingRouteChanges.Add(id);
        if (_routeFlushScheduled) return;
        _routeFlushScheduled = true;
        _ = DrainPendingRouteChangesAsync();
    }

    private async Task DrainPendingRouteChangesAsync()
    {
        try
        {
            // Yield once so any synchronous events queued in the same
            // dispatcher tick (the reconnect-edge replay fires all 90+
            // ids back-to-back) batch into a single drain instead of
            // each one launching its own fire-and-forget.
            await Task.Yield();
            while (_pendingRouteChanges.Count > 0)
            {
                // Snapshot + clear before iterating so an event that
                // arrives during the per-id awaits queues onto the
                // next drain pass instead of mutating mid-iteration.
                var batch = _pendingRouteChanges.ToArray();
                _pendingRouteChanges.Clear();
                foreach (var id in batch)
                {
                    try { await ApplyRouteChangedFromStoreAsync(id); }
                    catch (Exception ex)
                    {
                        Toasts.LogException(ex, $"Apply route change {id}");
                    }
                }
            }
        }
        finally
        {
            _routeFlushScheduled = false;
        }
    }

    private async Task ApplyRouteChangedFromStoreAsync(string id)
    {
        if (!mapInitialized || _routeJs is null) return;
        var route = ResourceStore.GetRoute(id);
        if (route is null) return;

        // Mirror the change into the page-local list so any UI binding
        // that iterates availableRoutes (Layers panel, Resources page
        // when re-opened) sees the new geometry / name.
        var existingIndex = availableRoutes.FindIndex(r => r.Id == id);
        bool isNew = existingIndex < 0;
        if (existingIndex >= 0)
        {
            availableRoutes[existingIndex] = route;
        }
        else
        {
            availableRoutes.Add(route);
        }
        // Adds change availableRoutes.Count, which is one of the keys
        // RebuildFilteredLayers caches against - flush + rebuild so
        // the Layers panel section reflects the new entry immediately.
        // Topbar search index gets invalidated for the same reason.
        if (isNew)
        {
            lastFilterKey = default;
            RebuildFilteredLayers();
            OwnPlacesIndex.Invalidate();
        }

        // Invalidate the parsed-coords cache so the new geometry is
        // re-parsed on next push.
        routeCoordsCache.Remove(id);

        // If the route is currently shown on the chart (in enabledRoutes),
        // push the geometry update via UpdateRouteAsync (in-place
        // setLatLngs + popup refresh + dot rebuild - no flicker).
        // updateRoute upserts: if leaflet doesn't have this id yet
        // it'll add fresh. Helm-toggleable visibility (enabledRoutes)
        // still gates: a route that's not enabled stays off the chart.
        if (enabledRoutes.Contains(id))
        {
            // Same coord-parse + total-nm-compute as AddRouteToMap.
            var coords = ParseRouteCoords(route);
            routeCoordsCache[id] = coords;
            if (coords.Length > 0)
            {
                double totalNm = OnaPlotter.Utilities.RouteProgress.TotalDistanceMeters(coords) / 1852.0;
                await _routeJs.UpdateRouteAsync(id, route.Name, coords, totalNm);
            }
        }

        // If the changed route is the helm's active course, force the
        // ActiveRouteSync to refetch + redraw. Without this the dashed-
        // leg overlay stays on the pre-edit cached coords (the diff-
        // skip logic short-circuits when href hasn't changed).
        if (_activeRouteSync is not null
            && Data.ActiveRouteHref is { } href
            && OnaPlotter.Services.Api.SignalKUrls.ExtractRouteId(href) == id)
        {
            try { await _activeRouteSync.SyncAsync(Data, enabledRoutes, availableRoutes, force: true); }
            catch { /* swallow: best-effort, next data tick re-syncs */ }
        }

        await InvokeAsync(StateHasChanged);
    }

    private void HandleRouteRemovedFromStore(string id)
    {
        _ = ApplyRouteRemovedFromStoreAsync(id);
    }

    private async Task ApplyRouteRemovedFromStoreAsync(string id)
    {
        if (!mapInitialized || _routeJs is null) return;

        int removed = availableRoutes.RemoveAll(r => r.Id == id);
        routeCoordsCache.Remove(id);
        enabledRoutes.Remove(id);
        await _routeJs.RemoveRouteAsync(id);
        if (removed > 0)
        {
            // availableRoutes.Count went down - flush the filter cache
            // and topbar-search index so the Layers panel + search
            // dropdown stop showing the deleted route.
            lastFilterKey = default;
            RebuildFilteredLayers();
            OwnPlacesIndex.Invalidate();
        }

        // If the deleted route was active, deactivate. ActiveRouteSync's
        // next pass would also catch this when nextPoint goes null, but
        // doing it explicitly prevents a window where the overlay
        // points at a no-longer-existent destination.
        if (_activeRouteSync is not null
            && Data.ActiveRouteHref is { } href
            && OnaPlotter.Services.Api.SignalKUrls.ExtractRouteId(href) == id)
        {
            try { await _activeRouteSync.SyncAsync(Data, enabledRoutes, availableRoutes, force: true); }
            catch { /* deactivate-on-delete is best-effort */ }
        }

        await InvokeAsync(StateHasChanged);
    }

    // --- Waypoint / Note / Region store-event handlers ----------------
    //
    // Same shape as the route handlers above: ResourceStore fires the
    // typed event when SK delta or REST reconcile lands an update for
    // <type>/<id>; the handler updates the page-local list (so any
    // UI binding that reads it stays in sync) and pushes the new
    // marker to the leaflet layer via MapResourceController's per-
    // resource Redraw / Drop methods.

    // Coalesce waypoint Changed events the same way the route handler
    // does (DrainPendingRouteChangesAsync above). On a reconnect-edge
    // reconcile ResourceTypeCache fires Changed for every cached entry
    // it carries forward; without this drain a 200-waypoint boat
    // launches 200 fire-and-forget redraw tasks racing through the
    // same JS-interop bridge that crashed the renderer with "memory
    // access out of bounds" on the route-storm path. ResourceContent-
    // Equality.WaypointEquals further suppresses Changed at source for
    // unchanged entries, so this drain handles only the genuine diffs.
    private readonly HashSet<string> _pendingWaypointChanges = new(StringComparer.Ordinal);
    private bool _waypointFlushScheduled;

    private void HandleWaypointChangedFromStore(string id)
    {
        _pendingWaypointChanges.Add(id);
        if (_waypointFlushScheduled) return;
        _waypointFlushScheduled = true;
        _ = DrainPendingWaypointChangesAsync();
    }

    private async Task DrainPendingWaypointChangesAsync()
    {
        try
        {
            await Task.Yield();
            while (_pendingWaypointChanges.Count > 0)
            {
                var batch = _pendingWaypointChanges.ToArray();
                _pendingWaypointChanges.Clear();
                foreach (var id in batch)
                {
                    try { await ApplyWaypointChangedFromStoreAsync(id); }
                    catch (Exception ex)
                    {
                        Toasts.LogException(ex, $"Apply waypoint change {id}");
                    }
                }
            }
        }
        finally
        {
            _waypointFlushScheduled = false;
        }
    }

    private async Task ApplyWaypointChangedFromStoreAsync(string id)
    {
        if (!mapInitialized || _resources is null) return;
        var wp = ResourceStore.GetWaypoint(id);
        if (wp is null) return;
        var idx = loadedWaypoints.FindIndex(w => w.Id == id);
        bool isNew = idx < 0;
        if (idx >= 0) loadedWaypoints[idx] = wp;
        else loadedWaypoints.Add(wp);
        await _resources.RedrawWaypointAsync(wp);
        if (isNew)
        {
            // loadedWaypoints.Count grew - flush the filter cache and
            // topbar-search index so the panel + dropdown pick it up.
            lastFilterKey = default;
            RebuildFilteredLayers();
            OwnPlacesIndex.Invalidate();
        }
        await InvokeAsync(StateHasChanged);
    }

    private void HandleWaypointRemovedFromStore(string id) => _ = ApplyWaypointRemovedFromStoreAsync(id);

    private async Task ApplyWaypointRemovedFromStoreAsync(string id)
    {
        if (!mapInitialized || _resources is null) return;
        int removed = loadedWaypoints.RemoveAll(w => w.Id == id);
        await _resources.DropWaypointAsync(id);
        if (removed > 0)
        {
            lastFilterKey = default;
            RebuildFilteredLayers();
            OwnPlacesIndex.Invalidate();
        }
        await InvokeAsync(StateHasChanged);
    }

