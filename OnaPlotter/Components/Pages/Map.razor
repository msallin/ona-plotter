    private async Task StopNavigation()
    {
        contextMenuVisible = false;

        // In-flight guard: a previous Stop tap is still awaiting the
        // SK delta. A second tap during that window would fire another
        // ClearAsync (idempotent on the server, but produces a
        // misleading "stopping..." re-toast and a duplicate audit log
        // entry on the SK side). The route HUD card is dimmed via
        // route-stopping CSS during this window so the helm gets
        // clear feedback that their first tap is in progress.
        if (_courseStopPendingUtc is not null) return;

        // Capture where we were heading before clearing so the Undo toast
        // can restore it. `position` via the SignalK course API works for
        // both waypoint- and route-based destinations.
        var savedLat = Data.CourseNextPointLatitude;
        var savedLon = Data.CourseNextPointLongitude;

        try { await CourseApi.ClearAsync(); }
        catch (Exception ex) { Toasts.Error($"Stop navigation failed: {ex.Message}"); return; }

        // Visual "stopping in progress" feedback until the SK delta
        // confirms (Data.ActiveRouteHref clears). Same pattern as the
        // anchor-raise feedback in NavigateRouteInternal / ToggleAnchor:
        // we don't optimistically mutate Data here -- that would mask
        // a server-side failure (PUT 200 but the plugin didn't actually
        // clear) AND race the next delta tick which would re-establish
        // the cleared course from the server's still-stale state. Let
        // SyncActiveRouteAsync drive the truth; dim the on-map elements
        // so the helm sees their tap landed.
        _courseStopPendingUtc = DateTime.UtcNow;
        if (module is not null)
        {
            try { await module.InvokeVoidAsync("setActiveRouteStopping", true); }
            catch (JSDisconnectedException) { }
        }
        await InvokeAsync(StateHasChanged);

        if (savedLat is not null && savedLon is not null)
        {
            double lat = savedLat.Value, lon = savedLon.Value;
            Toasts.ShowAction(
                "Navigation stopped",
                "Undo",
                async () =>
                {
                    try
                    {
                        await CourseApi.SetDestinationPositionAsync(lat, lon);
                        Toasts.Success("Navigation restored");
                    }
                    catch (Exception ex) { Toasts.Error($"Undo failed: {ex.Message}"); }
                },
                durationSec: 6);
        }
    }

