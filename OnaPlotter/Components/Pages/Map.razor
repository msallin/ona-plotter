@* Chartplotter: live map with HUD instruments, AIS targets, MOB, anchor watch. *@

@page "/map"
@using OnaPlotter.Services
@using OnaPlotter.Services.Api
@using OnaPlotter.Models
@using OnaPlotter.Components.Map
@using Microsoft.JSInterop
@using System.Text.Json
@implements IAsyncDisposable
@inject SignalkClient SignalkClient
@inject TrackBuffer TrackBuffer
@inject AisStore AisStore
@inject AtonStore Atons
@inject IChartApi ChartApi
@inject IRouteApi RouteApi
@inject IWaypointApi WaypointApi
@inject INoteApi NoteApi
@inject IRegionApi RegionApi
@inject IRegionStore RegionStore
@inject OnaPlotter.Services.Places.OwnPlacesIndex OwnPlacesIndex
@inject ICourseApi CourseApi
@inject IAutopilotApi AutopilotApi
@inject IAnchorAlarmApi AnchorAlarmApi
@inject ITrackApi TrackApi
@inject IRadarApi RadarApi
@inject ISignalKBaseUrl SkBaseUrl
@inject IBuddyListApi BuddyListApi
@inject IPolarService Polar
@inject IAppSettings Settings
@inject IClientCapabilities ClientCaps
@inject IToastService Toasts
@inject IConfirmationService Confirmations
@inject IKeyValueStore Kv
@inject IRouteDraftStore RouteDraftStore
@inject OnaPlotter.Services.Mob.IMobService MobService
@inject OnaPlotter.Services.ShareService ShareService
@inject OnaPlotter.Services.INavigationAverages Avg
@inject OnaPlotter.Services.ServerNotifications.ServerNotificationStore NotificationStore
@inject IAlarmManager Alarms
@inject DeadmanTracker DeadmanTracker
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject OnaPlotter.Services.Radar.RadarOverlayManager RadarOverlay
@inject OnaPlotter.Services.Radar.JsRadarOverlayHost RadarOverlayHost
@inject OnaPlotter.Services.Resources.ResourceStore ResourceStore
@inject OnaPlotter.Services.Pois.IMarinePoiService MarinePois
@inject OnaPlotter.Services.Pois.MarinePoiCache MarinePoiCache
@inject ILogger<OnaPlotter.Services.Map.MarinePoiController> MarinePoiLogger

<PageTitle>Map</PageTitle>

<div class="map-container @(Settings.BigType ? "big-type" : "") @((routeEditMode || polygonEditMode) ? "editing" : "") mode-@Settings.SailingMode"
     @onpointerdown="TouchDeadman"
     @onkeydown="TouchDeadman">
    <div id="mapDiv"></div>

    @* Zoom buttons moved into the app-level topbar (MainLayout.razor)
       alongside Night + Fullscreen so the whole "viewport controls"
       cluster lives in one place. They're rendered there only when
       IsMapRoute is true. ZoomIn / ZoomOut methods kept below in
       case keyboard / pinch alternatives want to reuse them. *@

    <MapHud Data="Data" Autopilot="AutopilotApi"
            LastHeadingRad="lastHeading" AnchorDragging="AnchorDragging"
            DepthAlarmThreshold="Settings.DepthAlarmThreshold"
            DepthTrendMetersPerMinute="depthTrendMpm"
            SailingMode="@Settings.SailingMode"
            ShowDefaultHud="Settings.ShowDefaultHud"
            ShowAutopilotHud="Settings.ShowAutopilotHud"
            ShowRadarHud="Settings.ShowRadarHud"
            Radars="RadarOverlay.Radars"
            RadarCapabilities="RadarOverlay.Capabilities"
            OnSetRadarPower="(t) => SetRadarPowerAsync(t.radarId, t.power)"
            OnSetRadarRange="(t) => SetRadarRangeAsync(t.radarId, t.rangeMeters)"
            ExpandAllHud="Settings.ExpandAllHud"
            BigType="Settings.BigType"
            TideVisible="Settings.TideVisible"
            CogReadoutSource="@Settings.CogReadoutSource"
            Polar="Polar"
            WaypointArrivalRadiusMeters="@(Data.CourseArrivalCircleMeters ?? 0.0)"
            CourseStopping="@(_activeRouteSync?.CourseStopPending ?? false)"
            ActiveRouteDistanceTotal="@(_activeRouteSync?.ActiveRouteDistanceTotal)"
            OnPrevWaypoint="PrevWaypoint"
            OnNextWaypoint="NextWaypoint"
            OnAdjustAnchor="OpenAnchorSetRadiusPanel" />

    <MapControls Follow="follow"
                 OrientationLabel="@mapOrientationLabel"
                 NightMode="nightMode"
                 AnchorActive="AnchorButtonActive"
                 RouteNavigating="SignalkClient.Data.HasActiveCourse"
                 OnStopNavigation="StopNavigation"
                 MobActive="mobActive"
                 HarborMode="@Settings.HarborMode"
                 MeasureActive="measureActive"
                 RouteEditMode="routeEditMode"
                 RaceTimerActive="raceTimerActive"
                 RaceTimerLabel="@FormatRaceTimer()"
                 LayersPanelOpen="chartPanelOpen"
                 LegendOpen="legendOpen"
                 ShowKeyboardHints="@Settings.ShowKeyboardHints"
                 OnToggleFollow="ToggleFollow"
                 OnCycleOrientation="CycleMapOrientation"
                 OnToggleNight="ToggleNightMode"
                 OnToggleAnchor="ToggleAnchor"
                 OnToggleMob="ToggleMob"
                 OnZoomToTrack="ZoomToTrack"
                 OnCentreOnBoat="CentreOnBoat"
                 OnToggleHarborMode="ToggleHarborMode"
                 OnToggleMeasure="ToggleMeasure"
                 OnStartRouteEdit="StartRouteEdit"
                 OnToggleRaceTimer="ToggleRaceTimer"
                 SailingMode="@Settings.SailingMode"
                 OnToggleLayers="ToggleLayersPanel"
                 OnToggleLegend="() => legendOpen = !legendOpen"
                 OnShowShortcuts="() => shortcutsVisible = true"
                 FabMenuOpen="fabMenuOpen"
                 OnToggleFab="ToggleFabMenu"
                 MoreMenuOpen="moreMenuOpen"
                 OnToggleMore="ToggleMoreMenu"
                 OnFabCreateWaypoint="FabCreateWaypoint"
                 OnFabCreateNote="FabCreateNote"
                 OnFabCreateRegion="FabCreateRegion" />

    @if (shortcutsVisible)
    {
        <MapShortcutsOverlay OnDismiss="() => shortcutsVisible = false" />
    }

    @if (legendOpen)
    {
        <LegendOverlay OnDismiss="() => legendOpen = false" />
    }

    @* COLREGS quick-reference modal. Opened from the AIS popup's
       "?" link via OnShowColregsHelp (delegated handler in
       leafletInterop.js routes data-ona-colregs clicks to the
       JSInvokable). Same dismissal contract as LegendOverlay. *@
    @if (colregsHelpOpen)
    {
        <OnaPlotter.Components.Map.ColregsHelpOverlay OnDismiss="() => colregsHelpOpen = false" />
    }

    @* First-run long-press hint. CSS gates on `@@media (pointer: coarse)`
       so desktop users never see it. Dismisses on tap or after 6s; the
       dismissal flag is stored in KV so it only shows once per device. *@
    @if (touchCoachmarkVisible)
    {
        <div class="touch-coachmark" @onclick="DismissTouchCoachmark">
            <span>Tip: long-press the map for options</span>
        </div>
    }

    @* First-visit welcome card: three concrete things the user should
       do to get the app working. Shown once ever per device (KV flag);
       dismissible via the Got it button. Shows instead of the touch
       coachmark on first-ever visit since it covers the same ground
       and more. *@
    @if (welcomeVisible)
    {
        <div class="welcome-backdrop" @onclick="DismissWelcome"></div>
        <div class="welcome-card" @onclick:stopPropagation role="dialog"
             aria-labelledby="welcome-title">
            <h3 id="welcome-title">Welcome aboard</h3>
            <p class="welcome-sub">Four things to get you sailing:</p>
            <ol class="welcome-steps">
                <li>
                    <strong>Turn on a chart.</strong> Tap
                    <span class="welcome-kbd">Layers</span> (bottom bar) to
                    enable the charts your SignalK server provides.
                </li>
                <li>
                    <strong>Set your depth alarm.</strong> Open
                    <span class="welcome-kbd">Settings</span> and pick a
                    threshold for your boat's draft.
                </li>
                <li>
                    <strong>Long-press the map</strong> (or right-click) for
                    options: Create Waypoint, Add Note, Add Region,
                    Navigate Here.
                </li>
                <li>
                    <strong>Check the <span class="welcome-kbd">More</span>
                    button</strong> (leftmost on the bottom bar) for the
                    symbol <em>Legend</em>, Night mode, and Harbor mode.
                    A dot on the button means something in there is
                    currently on.
                </li>
            </ol>
            <button class="welcome-dismiss map-btn active" @onclick="DismissWelcome">
                Got it
            </button>
        </div>
    }

    @* MOB clear confirm was a dedicated modal; replaced by the two-tap
       confirm on the MOB button in MapControls (parallel to Stop-
       Navigation). See OnMobClicked there. *@

    @if (anchorEditMode)
    {
        @* Two-state anchor panel. Mode switches off the current anchor
           data state (set by ToggleAnchor):
             - Drop:       no anchor active. Tap Drop -> POST
                           /plugins/anchoralarm/dropAnchor (plugin
                           reads current GPS).
             - SetRadius:  pin set server-side, helm picking radius.
                           Chip taps preview the ring on the chart
                           via OnAnchorPanelPreviewRadius (no PUT);
                           Set commits via OnAnchorPanelSet (PUT
                           navigation.anchor.maxRadius).
           v1.x plugin compatibility: PUTs return 405; OnAnchorPanel*
           handlers surface a fail-loud "Anchor plugin v2.0.0+
           required" toast and leave the panel open so the helm can
           install / upgrade and try again. *@
        <AnchorEditPanel Mode="@_anchorPanelMode"
                         InitialRadiusMeters="@anchorEditInitialRadius"
                         SuggestionLabel="@AnchorEyebrowEffective()"
                         Busy="@anchorEditBusy"
                         AutoPreviewRadius="@AutoRadiusPreview()"
                         AutoBreakdown="@AutoRadiusBreakdown()"
                         ShowCloseButton="@_anchorPanelStandalone"
                         OnDrop="OnAnchorPanelDrop"
                         OnPreviewRadius="OnAnchorPanelPreviewRadius"
                         OnSetRadius="OnAnchorPanelSet"
                         OnCancel="OnAnchorPanelCancel" />
    }

    @if (routeEditMode)
    {
        @* IsEditingActiveRoute: true when the route currently being
           edited is the same one driving the helm's active course.
           Hides the redundant "Save & Go" button (saving the active
           route IS keeping it active; the two operations are the
           same). _activeRouteRegularSuppressed already tracks the
           active route id elsewhere on the page so we reuse it. *@
        <RouteEditPanel Name="@routeEditName"
                        NameChanged="v => routeEditName = v"
                        Stats="@routeEditStats"
                        Coords="routeEditCoords"
                        Saving="@_saveInFlight"
                        IsEditingExisting="@(routeEditId is not null)"
                        IsEditingActiveRoute="@(routeEditId is not null && routeEditId == _activeRouteSync?.ActiveRouteRegularSuppressed)"
                        OnReverse="ReverseEditRoute"
                        OnSave="SaveRoute"
                        OnSaveAsCopy="SaveRouteAsCopy"
                        OnSaveAndGo="SaveRouteAndGo"
                        OnCancel="CancelRouteEdit"
                        OnRemoveWaypoint="RemoveRouteWaypoint" />
    }

    @if (polygonEditMode)
    {
        <PolygonEditPanel Name="@polygonEditName"
                          NameChanged="v => polygonEditName = v"
                          Stats="@polygonEditStats"
                          Coords="polygonEditCoords"
                          IsHazard="@polygonEditIsHazard"
                          IsHazardChanged="v => polygonEditIsHazard = v"
                          OnUndo="UndoLastPolygonVertex"
                          OnSave="SavePolygonRegion"
                          OnCancel="CancelPolygonEdit"
                          OnRemoveVertex="RemovePolygonVertex" />
    }

    @* Add-menu: the menu itself is rendered inside MapControls so it
       anchors above the Add button (position: absolute). Only the
       full-screen backdrop for outside-click dismissal lives here. *@
    @if (fabMenuOpen)
    {
        <div class="map-fab-backdrop" @onclick="() => fabMenuOpen = false"></div>
    }

    @* === Context Menu (right-click) === *@
    @if (contextMenuVisible)
    {
        <div class="map-context-menu" style="left:@(contextMenuX)px; top:@(contextMenuY)px;">
            <button class="ctx-menu-item" @onclick="CreateWaypointHere">Create Waypoint</button>
            <button class="ctx-menu-item" @onclick="CreateNoteHere">Add Note</button>
            <button class="ctx-menu-item" @onclick="CreateRegionHere">Add Region</button>
            @* "Add Route" enters route-edit mode so the helm can plot from
               anywhere on the chart without first hunting for the button
               on the HUD. Seeding the first waypoint at the right-click
               point would be friendly, but the JS side assumes fresh
               state on startRouteEdit; leaving it to the next tap
               keeps the flow debuggable. *@
            <button class="ctx-menu-item" @onclick="StartRouteFromContextMenu">Add Route</button>
            <button class="ctx-menu-item" @onclick="NavigateHere">Navigate Here</button>
            <button class="ctx-menu-item" @onclick="MeasureHere">Measure Here</button>
            @if (Data.HasActiveCourse)
            {
                <button class="ctx-menu-item ctx-menu-danger" @onclick="StopNavigation">Stop Navigation</button>
            }
        </div>
    }

    @* === Waypoint Name + Description Dialog ===
       Mirror of the Add Note layout so the two feel like one flow
       (name required, description optional). Description persists to
       SignalK's properties.description per the resource schema.
       Doubles as the Edit dialog (popup-side Edit button calls
       OpenWaypointEditDialog which sets waypointEditId + pre-fills the
       inputs); the only visible difference is the header label. *@
    @if (waypointDialogVisible)
    {
        <div class="waypoint-dialog note-dialog">
            <div class="hud-label" style="margin-bottom:8px;">
                @(waypointEditId is null ? "Create Waypoint" : "Edit Waypoint")
            </div>
            <input type="text" class="route-name-input" aria-label="Waypoint name"
                   placeholder="Name" @bind="newWaypointName" @bind:event="oninput" />
            <textarea class="route-name-input note-dialog-body" aria-label="Waypoint description"
                      placeholder="Description (optional)" rows="3"
                      @bind="newWaypointDescription" @bind:event="oninput"></textarea>
            <div style="display:flex; gap:6px; margin-top:8px;">
                <button class="map-btn active" @onclick="SaveWaypoint">Save</button>
                <button class="map-btn" @onclick="CancelWaypointDialog">Cancel</button>
            </div>
        </div>
    }

    @* === Note Dialog ===
       Same dialog backs both Add Note and the popup-side Edit (Edit
       calls OpenNoteEditDialog which sets noteEditId + pre-fills the
       inputs). Header label flips between "Add Note" and "Edit
       Note"; everything else is identical. *@
    @if (noteDialogVisible)
    {
        <div class="waypoint-dialog note-dialog">
            <div class="hud-label" style="margin-bottom:8px;">
                @(noteEditId is null ? "Add Note" : "Edit Note")
            </div>
            <input type="text" class="route-name-input" aria-label="Note title"
                   placeholder="Title" @bind="newNoteTitle" @bind:event="oninput" />
            <textarea class="route-name-input note-dialog-body" aria-label="Note description"
                      placeholder="Description (optional)" rows="4"
                      @bind="newNoteDescription" @bind:event="oninput"></textarea>
            <div style="display:flex; gap:6px; margin-top:8px;">
                <button class="map-btn active" @onclick="SaveNote">Save</button>
                <button class="map-btn" @onclick="CancelNoteDialog">Cancel</button>
            </div>
        </div>
    }

    @* === Region Dialog ===
       Mode toggle at the top picks Circle or Polygon. Circle keeps the
       fast path (radius preset + Save = done). Polygon hands off to the
       on-map drawing flow - the dialog closes, polygon-edit mode starts,
       and the user collects name / description there so we don't ask
       for them twice. *@
    @if (regionDialogVisible)
    {
        <div class="waypoint-dialog note-dialog">
            <div class="hud-label" style="margin-bottom:8px;">Add Region</div>
            <div class="region-mode-toggle" role="tablist" aria-label="Region shape">
                <button class="map-btn @(newRegionMode == "circle" ? "active" : "")"
                        role="tab" aria-selected="@(newRegionMode == "circle")"
                        @onclick='() => SetRegionMode("circle")' type="button">Circle</button>
                <button class="map-btn @(newRegionMode == "polygon" ? "active" : "")"
                        role="tab" aria-selected="@(newRegionMode == "polygon")"
                        @onclick='() => SetRegionMode("polygon")' type="button">Polygon</button>
            </div>
            @if (newRegionMode == "circle")
            {
                <input type="text" class="route-name-input" aria-label="Region title"
                       placeholder="Title" @bind="newRegionTitle" @bind:event="oninput" />
                <textarea class="route-name-input note-dialog-body" aria-label="Region description"
                          placeholder="Description (optional)" rows="3"
                          @bind="newRegionDescription" @bind:event="oninput"></textarea>
                <div class="hud-label" style="margin-top:10px;">Radius</div>
                <div class="region-radius-chips">
                    @foreach (var (m, label) in RegionRadiusPresets)
                    {
                        <button class="map-btn @(newRegionRadiusMeters == m ? "active" : "")"
                                @onclick="() => PickRegionRadius(m)" type="button">@label</button>
                    }
                </div>
                @* Hazard toggle. Was previously polygon-only (lived
                   inside PolygonEditPanel which only appears AFTER
                   the dialog closes). Lifted into the dialog so the
                   circle path can set it too - focus-group field
                   report: "Cant add hazard flag for circle". *@
                <label class="route-edit-hazard" style="margin-top:10px;"
                       title="Raise an alarm whenever own-ship is inside this region">
                    <input type="checkbox" @bind="newRegionIsHazard" />
                    <span>Hazard</span>
                </label>
                <div style="display:flex; gap:6px; margin-top:10px;">
                    <button class="map-btn active" @onclick="SaveRegion">Save</button>
                    <button class="map-btn" @onclick="CancelRegionDialog">Cancel</button>
                </div>
            }
            else
            {
                @* Polygon path gets the same Title + Description +
                   Hazard inputs as Circle. Title pre-fills the edit
                   panel's name field so the user doesn't retype it,
                   Description is piped into SaveRegion on save, and
                   Hazard pre-seeds polygonEditIsHazard so the toggle
                   in the post-save edit panel reflects the dialog's
                   choice. Both branches ask the same questions up
                   front so the helm doesn't discover halfway through
                   that the flag is missing or hidden. *@
                <input type="text" class="route-name-input" aria-label="Region title"
                       placeholder="Title" @bind="newRegionTitle" @bind:event="oninput" />
                <textarea class="route-name-input note-dialog-body" aria-label="Region description"
                          placeholder="Description (optional)" rows="3"
                          @bind="newRegionDescription" @bind:event="oninput"></textarea>
                <label class="route-edit-hazard" style="margin-top:10px;"
                       title="Raise an alarm whenever own-ship is inside this region">
                    <input type="checkbox" @bind="newRegionIsHazard" />
                    <span>Hazard</span>
                </label>
                <div style="display:flex; gap:6px; margin-top:10px;">
                    <button class="map-btn active" @onclick="StartPolygonFromDialog">Start drawing</button>
                    <button class="map-btn" @onclick="CancelRegionDialog">Cancel</button>
                </div>
            }
        </div>
    }

    @* === Quick Chart Switcher (visible when layers panel is closed) ===
       Two-layer model: the user picks their set in Layers -> Charts
       (quickBarCharts), and that set shows here as tap-to-render chips.
       Sort alphabetically so the chip positions are stable when the
       user toggles one (the draw-stack order would shuffle visually
       on each tap because ApplyChartOrder reshuffles availableCharts). *@
    @* Quick chart-switcher bar. Previously hidden whenever the
       Layers panel was open; that felt like losing context every
       time you wanted to check which chart was on. Now it stays
       visible so the user can toggle rendering in the bar while
       the Layers panel handles membership / reorder. Active chips
       carry a strong filled-accent style so "which chart is on
       the map" reads at a glance - the old semi-transparent
       accent was ambiguous against a bright ocean tile. *@
    @if (_charts is not null && _charts.QuickBarCharts.Count > 0)
    {
        <div class="chart-quick-bar">
            @foreach (var chart in availableCharts
                         .Where(c => _charts.QuickBarCharts.Contains(c.Identifier))
                         .OrderBy(c => c.Name, StringComparer.OrdinalIgnoreCase))
            {
                bool active = _charts.EnabledCharts.Contains(chart.Identifier);
                @* Full chart name is rendered here on every viewport;
                   the phone breakpoint clips the visible label with
                   max-width + text-overflow: ellipsis (see
                   .chart-quick-chip rules in app.css) so desktop /
                   iPad still read the full name in the chip while
                   a 390-wide phone gets a tidy "Bahamas No…" form.
                   Earlier helm round shortened in C# unconditionally,
                   which clipped on desktop too -- that hid the
                   disambiguating tail on a wide screen where there
                   was plenty of room for the full name. *@
                <button @key="chart.Identifier"
                        class="chart-quick-chip @(active ? "active" : "")"
                        @onclick="() => _charts.ToggleAsync(chart, !active)"
                        aria-pressed="@(active ? "true" : "false")"
                        title="@(active ? $"{chart.Name} - showing, tap to hide" : $"{chart.Name} - hidden, tap to show")">
                    @chart.Name
                </button>
            }
        </div>
    }

    @if (chartPanelOpen)
    {
        @* Click-outside-to-close: invisible backdrop covers the map beneath
           the panel. The panel sits at z-index:var(--z-controls), backdrop
           one layer under. LayersPanel itself stops click propagation via
           its own stopPropagation, so taps inside keep the panel open. *@
        <div class="panel-backdrop" @onclick="() => chartPanelOpen = false"></div>
        <LayersPanel AvailableCharts="availableCharts"
                     AvailableRoutes="availableRoutes"
                     Offline="@(!SignalkClient.IsConnected)"
                     FilteredCharts="FilteredCharts"
                     FilteredRoutes="FilteredRoutes"
                     FilteredWaypoints="FilteredWaypoints"
                     FilteredNotes="FilteredNotes"
                     OnFocusWaypoint="FocusWaypoint"
                     OnFocusNote="FocusNote"
                     OnNavigateToNote="NavigateToNote"
                     OnEditNote="OpenNoteEditDialog"
                     OnDeleteNote="DeleteNoteFromLayers"
                     LoadedRegions="loadedRegions"
                     RegionsVisible="@(_resources?.RegionsVisible ?? true)"
                     OnFocusRegion="FocusRegion"
                     OnEditRegion="EditRegion"
                     OnDeleteRegion="(r) => DeleteRegion(r.Id)"
                     OnToggleRegionsVisible="ToggleRegionsVisible"
                     Vessels="@BuildVesselList()"
                     Buddies="loadedBuddies"
                     EnabledCharts="@(_charts?.EnabledCharts ?? new HashSet<string>())"
                     EnabledRoutes="enabledRoutes"
                     QuickBarCharts="@(_charts?.QuickBarCharts ?? new HashSet<string>())"
                     AvailableRadars="RadarOverlay.Radars"
                     EnabledRadars="RadarOverlay.EnabledRadarIds"
                     RadarCapabilities="RadarOverlay.Capabilities"
                     ShipLinesVisible="Settings.ShipLinesVisible"
                     OnToggleShipLines="OnToggleShipLines"
                     LaylinesVisible="Settings.LaylinesVisible"
                     OnToggleLaylines="OnToggleLaylinesPersist"
                     LocalTrackVisible="Settings.LocalTrackVisible"
                     OnToggleLocalTrack="OnToggleLocalTrack"
                     ServerTrackVisible="@(_serverTrack?.Visible ?? false)"
                     ServerTrackDuration="@(_serverTrack?.Duration ?? "1d")"
                     ServerTrackResolution="@(_serverTrack?.Resolution ?? "1m")"
                     ServerTrackWithinBounds="@(_serverTrack?.WithinBounds ?? false)"
                     WeatherOverlayVisible="@(_weather?.Visible ?? false)"
                     WeatherOverlayOpacityPercent="@((int)Math.Round(Settings.WeatherOverlayOpacity * 100))"
                     AtonsVisible="Settings.AtonsVisible"
                     AisLabelsVisible="Settings.AisLabelsVisible"
                     GuardZoneVisible="Settings.GuardZoneVisible"
                     ShowDefaultHud="Settings.ShowDefaultHud"
                     ShowAutopilotHud="Settings.ShowAutopilotHud"
                     ShowRadarHud="Settings.ShowRadarHud"
                     BigType="Settings.BigType"
                     ExpandAllHud="Settings.ExpandAllHud"
                     LayerFilter="@layerFilter"
                     LayerFilterChanged="OnLayerFilterChanged"
                     OnToggleChartQuickBar="OnToggleChartQuickBarCallback"
                     OnReorderChart="OnReorderChartCallback"
                     OnToggleRadar="OnToggleRadarCallback"
                     OnSetRadarPower="(t) => SetRadarPowerAsync(t.radar.Id, t.power)"
                     OnSetRadarRange="(t) => SetRadarRangeAsync(t.radar.Id, t.rangeMeters)"
                     OnToggleRoute="OnToggleRouteCallback"
                     OnEditRoute="EditRoute"
                     OnNavigateRoute="NavigateRoute"
                     OnDeleteRoute="DeleteRouteFromLayers"
                     OnNavigateToWaypoint="NavigateToWaypoint"
                     OnEditWaypoint="OpenWaypointEditDialog"
                     OnDeleteWaypoint="DeleteWaypointFromLayers"
                     OnFocusVessel="FocusVessel"
                     OnToggleServerTrack="OnToggleServerTrack"
                     OnServerTrackDurationChanged="OnServerTrackDurationChanged"
                     OnServerTrackResolutionChanged="OnServerTrackResolutionChanged"
                     OnServerTrackWithinBoundsChanged="OnServerTrackWithinBoundsChanged"
                     OnToggleWeatherOverlay="@(v => _weather?.ToggleAsync(v) ?? Task.CompletedTask)"
                     OnWeatherOpacityPreview="@(p => _weather?.PreviewOpacityAsync(p) ?? Task.CompletedTask)"
                     OnWeatherOpacityCommit="@(p => _weather?.CommitOpacityAsync(p) ?? Task.CompletedTask)"
                     OnToggleAtonsVisible="ToggleAtonsVisible"
                     OnToggleAisLabelsVisible="ToggleAisLabelsVisible"
                     MarinePoiOverlayVisible="Settings.MarinePoiOverlayVisible"
                     OnToggleMarinePoiOverlay="@(v => Settings.SetMarinePoiOverlayVisibleAsync(v))"
                     MarinePoiFuelEnabled="Settings.MarinePoiFuelEnabled"
                     MarinePoiMarinaEnabled="Settings.MarinePoiMarinaEnabled"
                     MarinePoiHarbourEnabled="Settings.MarinePoiHarbourEnabled"
                     MarinePoiMooringEnabled="Settings.MarinePoiMooringEnabled"
                     MarinePoiSlipwayEnabled="Settings.MarinePoiSlipwayEnabled"
                     MarinePoiPierEnabled="Settings.MarinePoiPierEnabled"
                     MarinePoiChandleryEnabled="Settings.MarinePoiChandleryEnabled"
                     MarinePoiDrinkingWaterEnabled="Settings.MarinePoiDrinkingWaterEnabled"
                     MarinePoiPumpOutEnabled="Settings.MarinePoiPumpOutEnabled"
                     OnToggleMarinePoiFuel="@(v => Settings.SetMarinePoiFuelEnabledAsync(v))"
                     OnToggleMarinePoiMarina="@(v => Settings.SetMarinePoiMarinaEnabledAsync(v))"
                     OnToggleMarinePoiHarbour="@(v => Settings.SetMarinePoiHarbourEnabledAsync(v))"
                     OnToggleMarinePoiMooring="@(v => Settings.SetMarinePoiMooringEnabledAsync(v))"
                     OnToggleMarinePoiSlipway="@(v => Settings.SetMarinePoiSlipwayEnabledAsync(v))"
                     OnToggleMarinePoiPier="@(v => Settings.SetMarinePoiPierEnabledAsync(v))"
                     OnToggleMarinePoiChandlery="@(v => Settings.SetMarinePoiChandleryEnabledAsync(v))"
                     OnToggleMarinePoiDrinkingWater="@(v => Settings.SetMarinePoiDrinkingWaterEnabledAsync(v))"
                     OnToggleMarinePoiPumpOut="@(v => Settings.SetMarinePoiPumpOutEnabledAsync(v))"
                     OnToggleGuardZoneVisible="ToggleGuardZoneVisible"
