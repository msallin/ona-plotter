    /// <summary>Advance the active route by one waypoint via the
    /// SignalK course API. The server owns the pointIndex; our local
    /// model picks up the change on the next delta tick. Bound to
    /// the &gt; button in the route HUD card.</summary>
    private async Task NextWaypoint()
    {
        if (Data.ActiveRoutePointIndex is int idx
            && Data.ActiveRoutePointTotal is int total
            && idx + 1 >= total)
        {
            return; // already at last leg; button is disabled but guard anyway
        }
        try
        {
            var r = await CourseApi.AdvanceActiveRouteAsync();
            if (!r.Success)
            {
                Toasts.Error($"Next waypoint failed: {r.Error ?? "server rejected"}");
            }
        }
        catch (Exception ex) { Toasts.Error($"Next waypoint failed: {ex.Message}"); }
    }

    /// <summary>Step back one waypoint via SetPointIndexAsync. Used
    /// when the helm overshoots a tack and wants to redo the
    /// previous leg, or when an auto-advance fired prematurely
    /// (large arrival radius + favourable current). Bound to the
    /// &lt; button in the route HUD card.</summary>
    private async Task PrevWaypoint()
    {
        if (Data.ActiveRoutePointIndex is not int idx || idx <= 0) return;
        try
        {
            var r = await CourseApi.SetPointIndexAsync(idx - 1);
            if (!r.Success)
            {
                Toasts.Error($"Previous waypoint failed: {r.Error ?? "server rejected"}");
            }
        }
        catch (Exception ex) { Toasts.Error($"Previous waypoint failed: {ex.Message}"); }
    }

