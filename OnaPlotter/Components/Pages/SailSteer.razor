@* SailSteer: circular compass display combining wind, heading, COG, laylines, and waypoint bearing.
   Inspired by B&G SailSteer. Compass rotates opposite to heading so the boat always points up.
   Empty state when no wind data, Polar-driven target TWA hints (second arrow at optimal upwind/
   downwind angle), VMG-vs-target perf bar on the right. Back-to-chart chip was removed -- the
   sidebar + topbar already route back to the map. *@

@page "/sailsteer"
@using OnaPlotter.Services
@using OnaPlotter.Models
@implements IDisposable
@inject SignalkClient SignalkClient
@inject IPolarService Polar

<PageTitle>SailSteer</PageTitle>

<div class="sailsteer-container">
    @if (!HasAnyInstrument)
    {
        @* State-aware empty state: mirrors WindRose's NoFeed / Stale /
           Cold dispatch so the helm sees the right next step. Without
           the dispatch the page used to suggest "connect a wind sensor"
           even when SignalK was simply offline -- wrong layer to
           troubleshoot. *@
        var emptyState = ResolveEmptyState();
        <div class="instrument-empty-state" role="status">
            <strong>@emptyState.Title</strong>
            @emptyState.Detail
        </div>
    }
    <svg viewBox="0 0 500 500" style="max-width:500px; width:100%; height:auto;" xmlns="http://www.w3.org/2000/svg">

        @* === Data readouts (fixed, do not rotate) ===
           Layout (helm-feedback, post-KIP comparison):
             Top-left  : TWA over TWS (true wind, side-by-side cluster)
             Top-center: HDG (large, primary heading reference)
             Top-right : AWA over AWS (apparent wind, side-by-side cluster)
             Bottom-left : SOG (boat speed over ground)
             Bottom-right: COG (track over ground)
           VMG-perf-bar lives mid-right, beside the compass ring.
           HDG was previously bottom-left next to COG; helm wanted it
           prominent at the top because heading is the primary
           steering reference and the eye-shift from compass to HDG
           is shorter at the top than at the bottom-corner. *@

        @* Top-left: TWA + TWS cluster *@
        @Txt(70, 22, "TWA", "sailsteer-label")
        @Txt(70, 44, $"{Format.Degrees(Data.WindAngleTrue)}\u00b0", Vcls(Data.WindAngleTrue))
        @Txt(70, 70, Format.Speed(Data.WindSpeedTrue), Vcls(Data.WindSpeedTrue))
        @Txt(70, 84, "TWS knots", "sailsteer-unit")

        @* Top-right: AWA + AWS cluster *@
        @Txt(430, 22, "AWA", "sailsteer-label")
        @Txt(430, 44, $"{Format.Degrees(Data.WindAngleApparent)}\u00b0", Vcls(Data.WindAngleApparent))
        @Txt(430, 70, Format.Speed(Data.WindSpeedApparent), Vcls(Data.WindSpeedApparent))
        @Txt(430, 84, "AWS knots", "sailsteer-unit")

        @* Top-center: HDG primary heading readout. Pill background
           pulled from the same token family as the connection chip
           so it reads as a system value, not a label. Larger font
           (sailsteer-value-lg) for at-a-glance prominence. *@
        <rect x="207" y="14" width="86" height="34" rx="6"
              class="sailsteer-hdg-pill" />
        @Txt(250, 28, "HDG", "sailsteer-label")
        @Txt(250, 44, $"{Format.Degrees(Data.Heading)}\u00b0", Data.Heading is null ? "sailsteer-value-lg sailsteer-value-muted" : "sailsteer-value-lg")

        @* Bottom-left: SOG *@
        @Txt(70, 440, "SOG", "sailsteer-label")
        @Txt(70, 462, Format.Speed(Data.SpeedOverGround), Vcls(Data.SpeedOverGround))

        @* Bottom-right: COG *@
        @Txt(430, 440, "COG", "sailsteer-label")
        @Txt(430, 462, $"{Format.Degrees(Data.CourseOverGround)}\u00b0", Vcls(Data.CourseOverGround))

        @* Help button (top-right corner of viewport, OUTSIDE the
           compass). Toggles helpMode which adds explanatory labels
           next to every symbol in the dial. SVG <title> elements
           cover desktop hover; helpMode covers touch where hover
           doesn't fire. *@
        <g class="sailsteer-help-toggle" @onclick="ToggleHelpMode" role="button"
           tabindex="0" aria-label="Toggle help labels">
            <title>Show / hide explanatory labels for the dial symbols</title>
            <circle cx="478" cy="22" r="14"
                    class="@(helpMode ? "sailsteer-help-btn-active" : "sailsteer-help-btn")" />
            <text x="478" y="22" text-anchor="middle" dominant-baseline="central"
                  font-size="16" font-weight="700"
                  class="@(helpMode ? "sailsteer-help-btn-text-active" : "sailsteer-help-btn-text")">?</text>
        </g>

        @* === VMG-to-target performance bar ===
           Mid-right, sitting between the AWA/AWS cluster and the
           bottom COG readout. Shows current VMG vs polar-target as
           a horizontal fill: green when on-polar (within 5%), amber
           otherwise. Inline HTML via foreignObject so the shared
           .perf-meter CSS applies; keeps the SVG pure for the dial. *@
        @if (VmgMeter is (double actual, double target, bool onPolar))
        {
            <foreignObject x="410" y="232" width="80" height="36">
                <div xmlns="http://www.w3.org/1999/xhtml" class="sailsteer-vmg-bar"
                     title="VMG vs polar target">
                    <div class="sailsteer-vmg-bar-label">
                        <span>VMG @actual.ToString("F1")</span>
                        <span>@target.ToString("F1") tgt</span>
                    </div>
                    <div class="perf-meter">
                        <div class="perf-meter-fill @(onPolar ? "" : "off-polar")"
                             style="width: @(Math.Clamp(actual / Math.Max(target, 0.1) * 100, 0, 100).ToString("F0"))%;"></div>
                    </div>
                </div>
            </foreignObject>
        }

        @* === Lubber line (fixed, always points up = ship's heading reference). === *@
        <line x1="250" y1="250" x2="250" y2="52"
              style="stroke: var(--sev-danger);" stroke-width="2.5" opacity="0.8" />

        @* === Rotating compass group === *@
        <g class="sailsteer-compass" transform="rotate(@CompassRotation, 250, 250)">

            <circle cx="250" cy="250" r="@R" fill="none"
                    class="sailsteer-ring-outer" stroke-width="2" />
            <circle cx="250" cy="250" r="@((int)(R - 20))" fill="none"
                    class="sailsteer-ring-inner" stroke-width="1" />

            @* Tick marks every 10 degrees, labels every 30. Tick + label
               colours route through CSS classes (.sailsteer-tick* /
               .sailsteer-cardinal*) so they flip per theme; hard-coded
               rgba(255,255,255) values used to vanish on the light-theme
               white background. *@
            @for (int deg = 0; deg < 360; deg += 10)
            {
                double rad = deg * Math.PI / 180.0;
                bool major = deg % 30 == 0;
                double innerR = major ? R - 14 : R - 8;
                double lx1 = Cx + Math.Sin(rad) * innerR;
                double ly1 = Cy - Math.Cos(rad) * innerR;
                double lx2 = Cx + Math.Sin(rad) * R;
                double ly2 = Cy - Math.Cos(rad) * R;
                <line x1="@F(lx1)" y1="@F(ly1)" x2="@F(lx2)" y2="@F(ly2)"
                      class="@(major ? "sailsteer-tick" : "sailsteer-tick-minor")"
                      stroke-width="@(major ? "1.5" : "1")" />
                @if (major)
                {
                    double tx = Cx + Math.Sin(rad) * (R + 16);
                    double ty = Cy - Math.Cos(rad) * (R + 16);
                    string label = deg switch { 0 => "N", 90 => "E", 180 => "S", 270 => "W", _ => deg.ToString() };
                    // North stays red (lubber-line companion / heading
                    // reference); cardinals + diagonals route through
                    // theme tokens. fill="" lets the class take over.
                    string cls = deg == 0
                        ? "sailsteer-cardinal-north"
                        : (deg % 90 == 0 ? "sailsteer-cardinal" : "sailsteer-cardinal-minor");
                    int fs = deg % 90 == 0 ? 13 : 10;
                    string fw = deg % 90 == 0 ? "700" : "400";
                    @SvgTxtCls(tx, ty, label, cls, fs, fw)
                }
            }

            @* === No-go zone (close-hauled exclusion) ===
               Two band sectors on the rim either side of the wind
               direction (TWD): the helm cannot sail closer to the
               wind than the polar's optimal upwind angle. Stbd half
               (TWD..TWD+target) is green = "you can be on stbd
               tack here close-hauled"; port half (TWD-target..TWD)
               is red = port tack territory. Falls back to a
               conservative 35° fixed half-width when the polar
               isn't loaded so the visual still anchors the wind
               direction. Drawn BEFORE the laylines so the layline
               ticks sit on top and remain readable. *@
            @if (Data.WindDirectionTrue is not null)
            {
                double twdDeg = Data.WindDirectionTrue.Value * Format.RadToDeg;
                double noGoHalf = NoGoHalfWidthDeg();
                @SvgArcBand(Cx, Cy, R, R - 14, twdDeg, twdDeg + noGoHalf, "var(--sev-ok)", 0.55)
                @SvgArcBand(Cx, Cy, R, R - 14, twdDeg - noGoHalf, twdDeg, "var(--sev-danger)", 0.55)
            }

            @* === True Wind Direction indicator === *@
            @if (Data.WindDirectionTrue is not null)
            {
                double twdDeg = Data.WindDirectionTrue.Value * Format.RadToDeg;
                <g transform="rotate(@F(twdDeg), 250, 250)">
                    <title>True wind direction (where the wind is coming from)</title>
                    <polygon points="250,@F(Cy - R + 5) 244,@F(Cy - R - 12) 256,@F(Cy - R - 12)"
                             style="fill: var(--sk-accent);" opacity="0.9" />
                    @SvgTxt(250, Cy - R - 18, "TWD", "var(--sk-accent)", 10, "600")
                </g>
            }

            @* === Actual laylines (observed TWA, both tacks) === *@
            @if (Data.WindDirectionTrue is not null && Data.WindAngleTrue is not null)
            {
                double twdD = Data.WindDirectionTrue.Value * Format.RadToDeg;
                double twaD = Math.Abs(Data.WindAngleTrue.Value) * Format.RadToDeg;
                double stbdDeg = twdD + 180 - twaD;
                double portDeg = twdD + 180 + twaD;
                double lr = R - 6;
                <g transform="rotate(@F(stbdDeg), 250, 250)">
                    <title>Starboard layline (current TWA, actual)</title>
                    <line x1="250" y1="@F(Cy - lr + 10)" x2="250" y2="@F(Cy - lr - 10)"
                          style="stroke: var(--sev-ok);" stroke-width="3" stroke-linecap="round" />
                    @SvgTxt(250, Cy - lr - 16, "S", "var(--sev-ok)", 9, "600")
                </g>
                <g transform="rotate(@F(portDeg), 250, 250)">
                    <title>Port layline (current TWA, actual)</title>
                    <line x1="250" y1="@F(Cy - lr + 10)" x2="250" y2="@F(Cy - lr - 10)"
                          style="stroke: var(--sev-danger);" stroke-width="3" stroke-linecap="round" />
                    @SvgTxt(250, Cy - lr - 16, "P", "var(--sev-danger)", 9, "600")
                </g>
            }

            @* === TARGET laylines (polar-optimal TWA, both tacks) ===
               B2: thin dashed inner tick at the optimal upwind or
               downwind angle for the current TWS. Lets the helm
               compare the actual layline position (solid, outer) to
               the polar-optimum position (dashed, inner) at a glance
               -- if the two coincide you're sailing on polar. Only
               rendered when the polar is loaded AND we have TWS. *@
            @if (TargetLayline is (double targetStbd, double targetPort))
            {
                double lr = R - 24;
                <g transform="rotate(@F(targetStbd), 250, 250)">
                    <title>Starboard polar-target layline (optimal upwind / downwind angle for current TWS)</title>
                    <line x1="250" y1="@F(Cy - lr + 8)" x2="250" y2="@F(Cy - lr - 8)"
                          style="stroke: var(--sev-ok);" stroke-width="2"
                          stroke-dasharray="3,3" opacity="0.75" />
                    @SvgTxt(250, Cy - lr - 14, "tgt", "var(--sev-ok)", 8, "600")
                </g>
                <g transform="rotate(@F(targetPort), 250, 250)">
                    <title>Port polar-target layline (optimal upwind / downwind angle for current TWS)</title>
                    <line x1="250" y1="@F(Cy - lr + 8)" x2="250" y2="@F(Cy - lr - 8)"
                          style="stroke: var(--sev-danger);" stroke-width="2"
                          stroke-dasharray="3,3" opacity="0.75" />
                    @SvgTxt(250, Cy - lr - 14, "tgt", "var(--sev-danger)", 8, "600")
                </g>
            }

            @* === COG line (dashed amber). === *@
            @if (Data.CourseOverGround is not null)
            {
                double cogLen = 150;
                bool cogHasSpeed = Data.SpeedOverGround is not null;
                if (cogHasSpeed)
                    cogLen = Math.Min(Math.Max(Data.SpeedOverGround!.Value * Format.MsToKnots * 15, 40), 160);
                double cogX = Cx + Math.Sin(Data.CourseOverGround.Value) * cogLen;
                double cogY = Cy - Math.Cos(Data.CourseOverGround.Value) * cogLen;
                string cogStroke = cogHasSpeed ? "var(--sev-warn)" : "var(--sk-text-muted)";
                <g>
                    <title>Course over ground (your actual track, length scaled by speed)</title>
                    <line x1="250" y1="250" x2="@F(cogX)" y2="@F(cogY)"
                          style="stroke: @cogStroke;" stroke-width="2" stroke-dasharray="6,4" opacity="0.8" />
                </g>
            }

            @* === Waypoint bearing line === *@
            @if (Data.HasActiveCourse && Data.CourseNextPointBearing is not null)
            {
                double wpX = Cx + Math.Sin(Data.CourseNextPointBearing.Value) * (R - 20);
                double wpY = Cy - Math.Cos(Data.CourseNextPointBearing.Value) * (R - 20);
                <g>
                    <title>Bearing to the active waypoint</title>
                    <line x1="250" y1="250" x2="@F(wpX)" y2="@F(wpY)"
                          style="stroke: var(--sk-cyan);" stroke-width="2.5" opacity="0.9" />
                </g>
                <g transform="rotate(@F(Data.CourseNextPointBearing.Value * Format.RadToDeg), 250, 250)">
                    <title>Active waypoint marker</title>
                    <polygon points="250,@F(Cy - R + 24) 245,@F(Cy - R + 36) 255,@F(Cy - R + 36)"
                             style="fill: var(--sk-cyan);" opacity="0.9" />
                </g>
            }

        </g>

        @* === Apparent Wind Direction indicator ===
           Drawn OUTSIDE the rotating compass because AWA is already
           boat-relative -- the boat is always at screen-up, so AWA
           degrees from screen-up puts the arrow exactly where the
           wind feels like it's coming from. Distinct from the TWD
           triangle: thinner, hollow, sits on the inner ring so it
           reads as "less primary" than the absolute TWD. Helm
           tunes by the absolute (TWD) at strategic level + the
           relative (AWD) at tactical level (sheet trim). *@
        @if (Data.WindAngleApparent is not null)
        {
            double awaDeg = Data.WindAngleApparent.Value * Format.RadToDeg;
            <g transform="rotate(@F(awaDeg), 250, 250)">
                <title>Apparent wind direction (where the wind feels like it's coming from -- combines true wind + boat speed)</title>
                <polygon points="250,@F(Cy - R + 22) 246,@F(Cy - R + 6) 254,@F(Cy - R + 6)"
                         class="sailsteer-awa-arrow" />
                @SvgTxt(250, Cy - R + 30, "AWD", "var(--sev-warn)", 9, "600")
            </g>
        }

        @* === Boat icon at center (fixed, always points up) ===
           Wider + taller than the previous narrow chevron after
           helm field-feedback ("the boat is too thin to read at
           a glance"). Fill / stroke routed through CSS classes so
           the icon flips with theme. The hardcoded white fill used
           to render as an invisible boat on the white-card light
           theme; the class-based palette honours the theme tokens. *@
        <g transform="translate(250, 250)">
            <title>Your vessel (always points up; the compass rotates underneath)</title>
            <polygon points="0,-26 11,18 6,14 0,18 -6,14 -11,18"
                     class="sailsteer-boat-fill sailsteer-boat-stroke"
                     stroke-width="1.2" />
        </g>

        @* === Help-mode labels ===
           Toggled by the ? button. Visible-text annotations next to
           every interactive symbol so a tablet helm (no hover) can
           still learn what each glyph means. Rendered LAST so they
           sit on top of all dial elements. Each label is screen-
           positioned (not compass-rotating) so they stay legible
           regardless of heading. *@
        @if (helpMode)
        {
            @SvgTxt(250, 250 - R + 50, "Wind sectors: red = port no-go, green = stbd no-go", "var(--sk-text)", 10, "600")
            @SvgTxt(80, 250, "Lubber line", "var(--sev-danger)", 10, "600")
            @SvgTxt(420, 250, "Boat = always up", "var(--sk-text)", 10, "600")
            @SvgTxt(250, 250 + R + 30, "Compass rotates with heading", "var(--sk-text-muted)", 10, "400")
        }

    </svg>
</div>

@code {
    private const double Cx = 250;
    private const double Cy = 250;
    private const double R = 195;

    /// <summary>Conservative fallback half-width (degrees) for the
    /// no-go zone when the polar isn't loaded yet. ~35° matches a
    /// typical cruiser-racer's close-hauled angle; the helm can
    /// override visually by sailing closer (the laylines move with
    /// real TWA so the no-go visual stays one cue among several).
    /// Pinned as a const so a future polar-rich re-think can pull
    /// the fallback up or down without spelunking the markup.</summary>
    private const double NoGoHalfWidthFallbackDeg = 35.0;

    /// <summary>Toggled by the topbar `?` button. When true, every
    /// dial symbol gets a visible-text annotation rendered on top
    /// of the SVG. SVG `&lt;title&gt;` already provides desktop hover
    /// tooltips; this mode is the touch-device path where hover
    /// doesn't fire.</summary>
    private bool helpMode;

    private NavigationData Data => SignalkClient.Data;

    private void ToggleHelpMode() => helpMode = !helpMode;

    /// <summary>
    /// No-go-zone half-width in degrees. Uses the polar's optimal
    /// upwind TWA when available (so the band tightens for high-
    /// performance boats and loosens for cruisers); falls back to
    /// <see cref="NoGoHalfWidthFallbackDeg"/> when the polar isn't
    /// loaded or TWS is missing. The wind-side rim band runs from
    /// (TWD - half) to (TWD + half) on the compass.
    /// </summary>
    private double NoGoHalfWidthDeg()
    {
        if (!Polar.HasPolar) return NoGoHalfWidthFallbackDeg;
        if (Data.WindSpeedTrue is not double twsMs) return NoGoHalfWidthFallbackDeg;
        double twsKn = twsMs * Format.MsToKnots;
        var t = Polar.GetOptimalUpwind(twsKn);
        return t is OptimalPoint p ? p.TwaDeg : NoGoHalfWidthFallbackDeg;
    }

    /// <summary>
    /// SVG path-data band between two angles on the compass.
    /// Builds an annulus segment: outer arc from
    /// <paramref name="rOuter"/> at <paramref name="startDeg"/> to
    /// <paramref name="endDeg"/>, then inner arc back at
    /// <paramref name="rInner"/>. Used for the no-go zone rim
    /// band so the helm sees a thick arc (not just a tick) framing
    /// the wind direction.
    /// </summary>
    private MarkupString SvgArcBand(double cx, double cy,
        double rOuter, double rInner, double startDeg, double endDeg,
        string fill, double opacity)
    {
        double startRad = startDeg * Math.PI / 180.0;
        double endRad = endDeg * Math.PI / 180.0;
        double x1 = cx + Math.Sin(startRad) * rOuter;
        double y1 = cy - Math.Cos(startRad) * rOuter;
        double x2 = cx + Math.Sin(endRad) * rOuter;
        double y2 = cy - Math.Cos(endRad) * rOuter;
        double x3 = cx + Math.Sin(endRad) * rInner;
        double y3 = cy - Math.Cos(endRad) * rInner;
        double x4 = cx + Math.Sin(startRad) * rInner;
        double y4 = cy - Math.Cos(startRad) * rInner;
        // Sweep flag: 1 for clockwise (since Y is screen-flipped).
        // large-arc flag: 0 because the band half-width is always
        // small (a few tens of degrees); a wider span would need
        // recalc but isn't a meaningful no-go zone anyway.
        string d = $"M {x1:F1} {y1:F1} A {rOuter:F1} {rOuter:F1} 0 0 1 {x2:F1} {y2:F1} " +
                   $"L {x3:F1} {y3:F1} A {rInner:F1} {rInner:F1} 0 0 0 {x4:F1} {y4:F1} Z";
        return new MarkupString(
            $"<path d=\"{d}\" style=\"fill: {fill}; opacity: {opacity.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)};\" />");
    }

    // True when at least ONE of the fields we rely on is non-null. Drives
    // the empty-state banner. If nothing is live, the SVG still renders
    // (so chrome + compass labels remain), but the overlay tells the user
    // the server isn't feeding sensor data yet.
    private bool HasAnyInstrument =>
        Data.Heading is not null
        || Data.WindAngleTrue is not null
        || Data.WindAngleApparent is not null
        || Data.WindSpeedTrue is not null;

    /// <summary>
    /// Picks a state-aware empty-state message for the SailSteer overlay.
    /// Three diagnoses parallel to WindRose:
    ///   * NoFeed: SignalK websocket is not connected -- check server.
    ///   * Stale: connected but no message in &gt; 5 s.
    ///   * Cold: connected and live but no wind / heading sample yet.
    /// Without this dispatch the page used to suggest "connect a wind
    /// sensor" even when SignalK was offline, sending the helm to fix
    /// the wrong layer.
    /// </summary>
    private (string Title, string Detail) ResolveEmptyState()
    {
        if (!SignalkClient.IsConnected)
            return ("No SignalK feed",
                    "Check the server URL or wait while the client reconnects.");
        if (SignalkClient.IsDataStale)
            return ("SignalK feed stale",
                    "Connected, but no message has arrived for several seconds.");
        return ("Awaiting wind / heading",
                "Connected. SailSteer needs environment.wind.* and navigation.headingTrue from the server.");
    }

    /// <summary>
    /// Polar-optimum layline angles (absolute degrees, compass-clockwise
    /// from north) for the current TWD + TWS. Returns stbd + port pair,
    /// or null when the polar isn't loaded, TWS isn't published, or the
    /// sailor is neither clearly upwind nor clearly downwind (the polar
    /// optimum is meaningful only off-the-wind).
    /// </summary>
    private (double Stbd, double Port)? TargetLayline
    {
        get
        {
            if (!Polar.HasPolar) return null;
            if (Data.WindDirectionTrue is not double twdRad) return null;
            if (Data.WindSpeedTrue is not double twsMs) return null;
            if (Data.WindAngleTrue is not double twaRad) return null;
            double twsKn = twsMs * Format.MsToKnots;
            double absTwa = Math.Abs(twaRad * Format.RadToDeg);
            // Pick the branch of the polar curve that matches where the
            // helmsman is actually sailing. Upwind targets are only useful
            // when the boat is roughly upwind; dittos for downwind.
            OptimalPoint? target = absTwa < 90
                ? Polar.GetOptimalUpwind(twsKn)
                : Polar.GetOptimalDownwind(twsKn);
            if (target is not OptimalPoint t) return null;
            double twdDeg = twdRad * Format.RadToDeg;
            // Same mirror as the actual-layline calculation above.
            double stbd = twdDeg + 180 - t.TwaDeg;
            double port = twdDeg + 180 + t.TwaDeg;
            return (stbd, port);
        }
    }

    /// <summary>
    /// VMG-vs-target meter. actual = current boat VMG magnitude (SOG *
    /// |cos(TWA)|), target = polar VMG at current TWS from the relevant
    /// optimum. onPolar=true when actual is within 5% of target.
    /// Returns null when any input is missing.
    /// </summary>
    private (double Actual, double Target, bool OnPolar)? VmgMeter
    {
        get
        {
            if (!Polar.HasPolar) return null;
            if (Data.SpeedOverGround is not double sogMs) return null;
            if (Data.WindSpeedTrue is not double twsMs) return null;
            if (Data.WindAngleTrue is not double twaRad) return null;
            double sogKn = sogMs * Format.MsToKnots;
            double twsKn = twsMs * Format.MsToKnots;
            double absTwa = Math.Abs(twaRad * Format.RadToDeg);
            OptimalPoint? target = absTwa < 90
                ? Polar.GetOptimalUpwind(twsKn)
                : Polar.GetOptimalDownwind(twsKn);
            if (target is not OptimalPoint t) return null;
            double actualVmg = sogKn * Math.Abs(Math.Cos(twaRad));
            bool onPolar = Math.Abs(actualVmg - t.VmgKn) / Math.Max(t.VmgKn, 0.1) < 0.05;
            return (actualVmg, t.VmgKn, onPolar);
        }
    }

    private string CompassRotation
    {
        get
        {
            double deg = Data.Heading is not null ? -Data.Heading.Value * Format.RadToDeg : 0;
            return deg.ToString("F1");
        }
    }

    private static string F(double v) => v.ToString("F1");

    private static string Vcls(double? v) =>
        v is null ? "sailsteer-value sailsteer-value-muted" : "sailsteer-value";

    private static MarkupString Txt(double x, double y, string content, string cls) =>
        new($"<text x=\"{x:F1}\" y=\"{y:F1}\" class=\"{cls}\" text-anchor=\"middle\">{Esc(content)}</text>");

    private static MarkupString SvgTxt(double x, double y, string content, string fill, int fontSize, string fontWeight) =>
        new($"<text x=\"{x:F1}\" y=\"{y:F1}\" style=\"fill: {fill};\" font-size=\"{fontSize}\" font-weight=\"{fontWeight}\" " +
            $"text-anchor=\"middle\" dominant-baseline=\"central\">{Esc(content)}</text>");

    // Class-based variant used by the rotating compass cardinals so
    // the fill colour follows the theme (--sk-text / --sk-text-muted /
    // --sev-danger for North) instead of being baked into the markup.
    private static MarkupString SvgTxtCls(double x, double y, string content, string cls, int fontSize, string fontWeight) =>
        new($"<text x=\"{x:F1}\" y=\"{y:F1}\" class=\"{cls}\" font-size=\"{fontSize}\" font-weight=\"{fontWeight}\" " +
            $"text-anchor=\"middle\" dominant-baseline=\"central\">{Esc(content)}</text>");

    private static string Esc(string s) => System.Net.WebUtility.HtmlEncode(s);

    protected override async Task OnInitializedAsync()
    {
        SignalkClient.OnDataChanged += HandleDataChanged;
        // Polar is lazily loaded; InitializeAsync is idempotent.
        await Polar.InitializeAsync();
        Polar.OnPolarChanged += HandlePolarChanged;
    }

    private async void HandleDataChanged()
    {
        try { await InvokeAsync(StateHasChanged); }
        catch (ObjectDisposedException) { }
    }

    private async void HandlePolarChanged()
    {
        try { await InvokeAsync(StateHasChanged); }
        catch (ObjectDisposedException) { }
    }

    public void Dispose()
    {
        SignalkClient.OnDataChanged -= HandleDataChanged;
        Polar.OnPolarChanged -= HandlePolarChanged;
    }
}
