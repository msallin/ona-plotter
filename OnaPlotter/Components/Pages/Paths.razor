@* SignalK paths used by OnaPlotter. Shown so a new user (charter
   skipper, migrating install) can tell at a glance which paths are
   plumbed in vs. missing, what value they carry right now, and which
   plugin publishes them. Value column live-updates on OnDataChanged. *@

@page "/paths"
@using OnaPlotter.Services
@using OnaPlotter.Services.Api
@using OnaPlotter.Models
@using OnaPlotter.Utilities
@inject SignalkClient SignalkClient
@inject IPathApi PathApi
@inject AisStore AisStore
@implements IDisposable

<PageTitle>Paths</PageTitle>

<h2>SignalK data paths</h2>
<p class="text-muted" style="max-width:820px;">
    What OnaPlotter reads from SignalK, the latest value for each path,
    and the plugin that typically publishes it. A green check + value
    means the path is live; a dash means not seen this session.
</p>

<div class="mb-3" style="max-width:820px;">
    <input type="search" class="form-control" placeholder="Filter by path / feature / plugin..."
           aria-label="Filter SignalK paths"
           value="@filter"
           @oninput="OnFilterInput" />
</div>

@foreach (var group in VisibleGroups)
{
    <h5 class="page-section-header mt-4">
        @group.Title
    </h5>
    <div class="paths-table" role="table" aria-label="@group.Title paths">
        <div class="paths-row paths-row-header" role="row">
            <span role="columnheader">Live</span>
            <span role="columnheader">Path</span>
            <span role="columnheader">Value</span>
            <span role="columnheader">Used for</span>
            <span role="columnheader">Typical publisher</span>
        </div>
        @foreach (var p in group.Paths)
        {
            string? value = p.GetValue?.Invoke(Data);
            bool live = value is not null || (p.IsLive?.Invoke(liveState) ?? false);
            <div class="paths-row @(live ? "paths-row-live" : "paths-row-missing")" role="row">
                <span class="paths-live" role="cell" title="@(live ? "Published" : "Not seen this session")">
                    @(live ? "\u2713" : "\u2013")
                </span>
                <code class="paths-path" role="cell">@p.Path</code>
                <span class="paths-value" role="cell">
                    @(value ?? (live ? "(present)" : "\u2013"))
                </span>
                <span class="paths-use" role="cell">@p.UsedFor</span>
                <span class="paths-plugin" role="cell">@((MarkupString)p.Plugin)</span>
            </div>
        }
    </div>
}

@code {
    private string filter = "";
    private HashSet<string> liveState = new(StringComparer.Ordinal);

    private record PathInfo(
        string Path,
        string UsedFor,
        string Plugin,
        // Returns a human-readable current value (already formatted
        // with units) or null when the path has no value yet. The
        // "Live" column derives from (value != null) for most paths;
        // bulk-context / REST-only paths (AIS, charts, flags) fall
        // back to IsLive against the seen-set.
        Func<NavigationData, string?>? GetValue = null,
        Func<HashSet<string>, bool>? IsLive = null);

    private record PathGroup(string Title, List<PathInfo> Paths);

    // --- Value formatters --------------------------------------------
    // Kept inline so the table row declaration stays one-liner-shaped.
    // Each returns null when the underlying value is null so the column
    // can render "-" rather than stale/zero data.
    private static string? DegFromRad(double? rad) =>
        rad is double v ? $"{v * Format.RadToDeg:F1}°" : null;
    private static string? KnFromMs(double? ms) =>
        ms is double v ? $"{v * Format.MsToKnots:F2} kn" : null;
    private static string? Metres(double? m, string fmt = "F2") =>
        m is double v ? v.ToString(fmt, System.Globalization.CultureInfo.InvariantCulture) + " m" : null;
    private static string? Minutes(double? mins) =>
        mins is double v ? $"{v:F0} min" : null;
    private static string? Utc(DateTime? t) =>
        t is DateTime d ? d.ToUniversalTime().ToString("HH:mm'Z'") : null;
    private static string? LatLon(double? lat, double? lon) =>
        lat is double la && lon is double lo ? $"{la:F5}, {lo:F5}" : null;

    private List<PathGroup> groups = [];

    protected override void OnInitialized()
    {
        SignalkClient.OnDataChanged += HandleDataChanged;

        groups =
        [
            new PathGroup("Navigation (own vessel)",
            [
                new("navigation.position", "Own-boat marker, track, chart centring",
                    "GPS via <code>signalk-serial</code> / <code>signalk-n2k</code>",
                    GetValue: d => LatLon(d.Latitude, d.Longitude)),
                new("navigation.speedOverGround", "SOG HUD, auto night, CPA projection",
                    "GPS (SOG NMEA RMC / PGN 129026)",
                    GetValue: d => KnFromMs(d.SpeedOverGround)),
                new("navigation.courseOverGroundTrue", "COG HUD when Settings prefers True",
                    "GPS (RMC / PGN 129026)",
                    GetValue: d => DegFromRad(d.CourseOverGroundTrue)),
                new("navigation.courseOverGroundMagnetic", "COG HUD when Settings prefers Magnetic",
                    "GPS with magnetic-variation fix (RMC)",
                    GetValue: d => DegFromRad(d.CourseOverGroundMagnetic)),
                new("navigation.headingTrue", "Compass HUD when Settings prefers True",
                    "GPS / gyro with variation correction",
                    GetValue: d => DegFromRad(d.HeadingTrue)),
                new("navigation.headingMagnetic", "Compass HUD when Settings prefers Magnetic",
                    "Fluxgate / rate compass via <code>signalk-n2k</code>",
                    GetValue: d => DegFromRad(d.HeadingMagnetic)),
                new("navigation.anchor.maxRadius", "Anchor-watch circle size",
                    "<code>signalk-anchoralarm-plugin</code>",
                    GetValue: d => Metres(d.AnchorMaxRadius, "F1")),
                new("navigation.anchor.currentRadius", "Distance-from-anchor HUD",
                    "<code>signalk-anchoralarm-plugin</code>",
                    GetValue: d => Metres(d.AnchorCurrentRadius, "F1")),
            ]),
            new PathGroup("Environment (sensors)",
            [
                new("environment.depth.belowTransducer", "Depth HUD, shallow alarm",
                    "Depth sounder via NMEA 0183 DPT / PGN 128267",
                    GetValue: d => Metres(d.Depth, "F1")),
                new("environment.wind.angleApparent", "AWA HUD, WindRose, SailSteer",
                    "Wind transducer via NMEA 0183 MWV / PGN 130306",
                    GetValue: d => DegFromRad(d.WindAngleApparent)),
                new("environment.wind.speedApparent", "AWS HUD, WindRose",
                    "Wind transducer (MWV / PGN 130306)",
                    GetValue: d => KnFromMs(d.WindSpeedApparent)),
                new("environment.wind.directionTrue", "Laylines, wind-shift alarm",
                    "NMEA 0183 MWD / derived from AWA + COG via <code>signalk-derived-data</code>",
                    GetValue: d => DegFromRad(d.WindDirectionTrue)),
                new("environment.wind.speedTrue", "TWS HUD, polar performance, race HUD",
                    "Derived by <code>signalk-derived-data</code> from AWS + SOG",
                    GetValue: d => KnFromMs(d.WindSpeedTrue)),
                new("environment.wind.angleTrueWater", "Race TWA, polar target speed",
                    "<code>signalk-derived-data</code>",
                    GetValue: d => DegFromRad(d.WindAngleTrue)),
                new("environment.sun", "Auto Night mode (day / dawn / dusk / night)",
                    "<code>signalk-sun</code> / <code>signalk-solar-position</code>",
                    GetValue: d => string.IsNullOrEmpty(d.SunState) ? null : d.SunState),
            ]),
            new PathGroup("Tide (for anchor-tide alarm)",
            [
                new("environment.tide.heightNow", "Tide HUD, anchor-tide prediction",
                    "<code>signalk-tides-api</code>, <code>mxtide</code>, or similar",
                    GetValue: d => Metres(d.TideHeightNow, "F2")),
                new("environment.tide.heightHigh", "Next HW display",
                    "<code>signalk-tides-api</code>",
                    GetValue: d => Metres(d.TideHeightHigh, "F2")),
                new("environment.tide.heightLow", "Anchor-tide alarm LW forecast",
                    "<code>signalk-tides-api</code>",
                    GetValue: d => Metres(d.TideHeightLow, "F2")),
                new("environment.tide.timeHigh", "Next-HW countdown",
                    "<code>signalk-tides-api</code>",
                    GetValue: d => Utc(d.TideTimeHigh)),
                new("environment.tide.timeLow", "Anchor-tide alarm timing, next-LW countdown",
                    "<code>signalk-tides-api</code>",
                    GetValue: d => Utc(d.TideTimeLow)),
                new("environment.tide.stationName", "Tide HUD source label",
                    "<code>signalk-tides-api</code>",
                    GetValue: d => string.IsNullOrEmpty(d.TideStationName) ? null : d.TideStationName),
            ]),
            new PathGroup("Design (vessel spec)",
            [
                new("design.draft.current / .maximum",
                    "Anchor-tide alarm, auto-fill Settings draft",
                    "Hard-coded in server <code>vessel.json</code> OR <code>signalk-load-data</code>",
                    GetValue: d => Metres(d.DraftFromSignalK, "F2")),
            ]),
            new PathGroup("Active course / routing",
            [
                new("navigation.course.activeRoute.href", "Active route banner, route highlight",
                    "SK v2 server core (<code>signalk-server</code> &gt;= 2.x)",
                    GetValue: d => string.IsNullOrEmpty(d.ActiveRouteHref) ? null
                        : ShortRouteHref(d.ActiveRouteHref)),
                new("navigation.course.calcValues.distance", "Next-waypoint HUD, APPROACH alarm",
                    "<code>course-provider-plugin</code>",
                    GetValue: d => Metres(d.CourseNextPointDistance, "F0")),
                new("navigation.course.calcValues.bearingTrue", "Next-waypoint HUD, SailSteer waypoint line",
                    "<code>course-provider-plugin</code>",
                    GetValue: d => DegFromRad(d.CourseNextPointBearing)),
                new("navigation.course.calcValues.timeToGo", "TTG HUD",
                    "<code>course-provider-plugin</code>",
                    GetValue: d => d.CourseNextPointTimeToGo is double s ? $"{s / 60:F0} min" : null),
                new("navigation.course.calcValues.velocityMadeGood(ToCourse)", "VMG HUD",
                    "<code>course-provider-plugin</code>; VMGToCourse used when VMG is null",
                    GetValue: d => KnFromMs(d.CourseNextPointVmg)),
                new("navigation.course.calcValues.crossTrackError", "XTE HUD, course-deviation alarm",
                    "<code>course-provider-plugin</code>",
                    GetValue: d => Metres(d.CrossTrackError, "F0")),
                new("navigation.course.calcValues.route.distance", "Route-total distance-to-go",
                    "<code>course-provider-plugin</code>",
                    GetValue: d => Metres(d.ActiveRouteDistanceRemaining, "F0")),
            ]),
            new PathGroup("Autopilot",
            [
                new("steering.autopilot.state", "AP state HUD (auto / wind / route / standby)",
                    "<code>signalk-autopilot</code> or N2K PGN 65360",
                    GetValue: d => string.IsNullOrEmpty(d.AutopilotState) ? null : d.AutopilotState),
                new("steering.autopilot.target.headingTrue", "AP target-heading HUD",
                    "<code>signalk-autopilot</code>",
                    GetValue: d => DegFromRad(d.AutopilotTargetHeading)),
                new("steering.autopilot.target.windAngleApparent", "AP target-TWA HUD (wind mode)",
                    "<code>signalk-autopilot</code> (wind-steering pilots)",
                    GetValue: d => DegFromRad(d.AutopilotTargetWindAngle)),
                new("steering.rudderAngle", "Rudder indicator in extended HDG HUD",
                    "Rudder sensor via NMEA 0183 RSA / PGN 127245, or AP plugin",
                    GetValue: d => DegFromRad(d.RudderAngle)),
            ]),
            new PathGroup("AIS + resources (bulk / REST, no per-path value)",
            [
                // Bulk AIS context: one row for all live vessels rather
                // than one row per MMSI. The value shows the current
                // count so operators can see at a glance whether the
                // AIS receiver is actually producing traffic.
                new("vessels.urn:mrn:imo:mmsi:* (bulk context)", "AIS overlay, CPA alarm, buddy list",
                    "AIS receiver (NMEA 0183 VDM / PGN 129038-9) or <code>aisreporter</code>",
                    GetValue: _ =>
                    {
                        int n = AisStore.Count;
                        return n > 0 ? $"{n} vessel{(n == 1 ? "" : "s")} live" : null;
                    },
                    IsLive: s => s.Contains("vessels.*")),
                // Resources served over REST, not the delta stream.
                // One row per resource kind -- the old split into charts
                // / flags / etc. just padded the table with three rows
                // that all said the same thing ("REST-only, present").
                new("/signalk/v1|v2/api/resources/* (REST)",
                    "Routes, waypoints, notes, regions, charts, flags",
                    "<code>signalk-server</code> core + <code>signalk-charts-plugin</code>, "
                    + "<code>signalk-flags</code>",
                    IsLive: _ => true),
            ]),
        ];

        _ = RefreshLiveStateAsync();
    }

    // Active-route href looks like "/resources/routes/abc-123-long-uuid".
    // Trim to the last segment so the Value column doesn't overflow.
    private static string ShortRouteHref(string href)
    {
        int slash = href.LastIndexOf('/');
        return slash >= 0 && slash + 1 < href.Length ? href[(slash + 1)..] : href;
    }

    private NavigationData Data => SignalkClient.Data;

    private async Task RefreshLiveStateAsync()
    {
        // Poke the paths endpoint once so the bulk-path rows (AIS, charts)
        // know whether anything is actually published. For the rest we
        // rely on NavigationData's null-vs-not-null state.
        liveState.Clear();
        try
        {
            var paths = await PathApi.GetAvailablePathsAsync();
            foreach (var p in paths) liveState.Add(p);
        }
        catch { /* server unreachable; leave set empty so everything shows as missing */ }

        // Best-effort plugin detection: these are derived flags, not
        // path names, but using the set as a tag bag avoids a second
        // state dictionary.
        if (liveState.Any(p => p.StartsWith("vessels.", StringComparison.Ordinal)))
            liveState.Add("vessels.*");

        // Flags / charts plugin heuristic: probe the endpoint.
        liveState.Add("flags.plugin"); // too expensive to HEAD; assume unknown and let the popup fail gracefully
        liveState.Add("charts.plugin"); // same reasoning

        await InvokeAsync(StateHasChanged);
    }

    private async void HandleDataChanged()
    {
        try { await InvokeAsync(StateHasChanged); }
        catch (ObjectDisposedException) { }
    }

    private IEnumerable<PathGroup> VisibleGroups =>
        string.IsNullOrWhiteSpace(filter)
            ? groups
            : groups.Select(g => new PathGroup(g.Title,
                g.Paths.Where(p =>
                    p.Path.Contains(filter, StringComparison.OrdinalIgnoreCase)
                    || p.UsedFor.Contains(filter, StringComparison.OrdinalIgnoreCase)
                    || p.Plugin.Contains(filter, StringComparison.OrdinalIgnoreCase)
                    || g.Title.Contains(filter, StringComparison.OrdinalIgnoreCase)
                ).ToList()))
              .Where(g => g.Paths.Count > 0);

    private void OnFilterInput(ChangeEventArgs e)
    {
        filter = e.Value?.ToString() ?? "";
    }

    public void Dispose()
    {
        SignalkClient.OnDataChanged -= HandleDataChanged;
    }
}
