    /// <summary>Regions always export as GeoJSON (GPX 1.1 has no
    /// native polygon shape) - skip the dialog entirely. Confirming
    /// "GeoJSON or Cancel?" would be cargo-cult: there's no choice
    /// to make.</summary>
    private Task ExportRegion(SignalkRegion r) =>
        DownloadAsync(ResourceExporter.RegionGeoJson(r), NameOrId(r.Name, r.Id), FormatGeoJson);

    /// <summary>Two-button chooser: "Export as: [GPX] [GeoJSON]
    /// [Cancel]". Esc cancels. Returns the picked label or null on
    /// cancel/escape; caller switches on the label.</summary>
    private Task<string?> AskFormat(string message) =>
        Confirmations.ChooseAsync(message, FormatOptions);

    /// <summary>Wraps the JS interop + filename + toast machinery so
    /// each per-type export method stays a one-liner. Null content
    /// = exporter rejected the resource (missing geometry); surface
    /// a toast rather than silently doing nothing so the helm knows
    /// to look at the row.</summary>
    private async Task DownloadAsync(string? content, string baseName, string format)
    {
        if (content is null)
        {
            Toasts.Error("Nothing to export - this resource is missing geometry.");
            return;
        }

        await _exportLock.WaitAsync();
        try
        {
            _fileTransfer ??= await JS.InvokeAsync<Microsoft.JSInterop.IJSObjectReference>(
                "import", "./js/platform/fileTransfer.js");
            string ext = format == FormatGeoJson ? "geojson" : "gpx";
            string filename = $"{SanitiseForFilename(baseName)}.{ext}";
            await _fileTransfer.InvokeVoidAsync("triggerFileDownload", filename, content);
            Toasts.Success($"Exported '{baseName}' as {format}");
        }
        catch (Microsoft.JSInterop.JSDisconnectedException) { /* page teardown */ }
        catch (Exception ex)
        {
            Toasts.LogException(ex, "Export");
        }
        finally
        {
            _exportLock.Release();
        }
    }

    /// <summary>Strip filesystem-hostile characters from a resource
    /// name so the download lands as a readable filename. Falls back
    /// to a non-empty placeholder when stripping leaves nothing
    /// (e.g. a name made entirely of slashes - rare but possible
    /// when an old plugin generated an id-style title).</summary>
    private static string SanitiseForFilename(string name)
    {
        var clean = new string(name
            .Where(c => !Path.GetInvalidFileNameChars().Contains(c))
            .ToArray()).Trim();
        return string.IsNullOrEmpty(clean) ? "resource" : clean;
    }

    public async ValueTask DisposeAsync()
    {
        ResourceStore.OnReloaded -= HandleStoreReloaded;
        ResourceStore.OnRouteChanged -= HandleStoreRouteChanged;
        ResourceStore.OnRouteRemoved -= HandleStoreRouteRemoved;
        ResourceStore.OnWaypointChanged -= HandleStoreWaypointChanged;
        ResourceStore.OnWaypointRemoved -= HandleStoreWaypointRemoved;
        ResourceStore.OnNoteChanged -= HandleStoreNoteChanged;
        ResourceStore.OnNoteRemoved -= HandleStoreNoteRemoved;
        ResourceStore.OnRegionChanged -= HandleStoreRegionChanged;
        ResourceStore.OnRegionRemoved -= HandleStoreRegionRemoved;
        SignalkClient.OnDataChanged -= HandleNavigationDataChanged;

        if (_fileTransfer is not null)
        {
            try { await _fileTransfer.DisposeAsync(); }
            catch (Microsoft.JSInterop.JSDisconnectedException) { /* page teardown */ }
        }
    }

    // Navigate to the Map page and deep-link to the given resource.
    // The Map page reads the query string in OnAfterRenderAsync (after
    // the REST seed + module init complete) and either focuses the
    // target (pan + zoom) or opens it in the appropriate edit flow.
    // Waypoint edit is handled inline on this page via EditWaypointName
    // rather than on the map - it's a rename-only operation with no
    // map affordance.
    private void OpenOnMap(string type, string id, bool edit)
    {
        string key = edit ? "edit" : "focus";
        string target = Uri.EscapeDataString($"{type}:{id}");
        // Relative path so the SignalK-webapp mount point
        // ("/signalk-onaplotter/") is preserved. NavigateTo with an
        // absolute "/map" would jump off-mount when the app is
        // hosted under a subpath; "map?..." resolves against the
        // current location, which is always correct.
        Nav.NavigateTo($"map?{key}={target}");
    }

    private async Task EditWaypointName(SignalkWaypoint wp)
    {
        // MOB waypoints are immutable - editing through the simpler
        // UpdateAsync overload would strip isMob/isActive/mobAlarmId
        // and break cross-plotter correlation. Same guard as
        // Map.razor.cs::WaypointEdit.
        if (wp.IsMob)
        {
            Toasts.Warning($"MOB waypoint '{NameOrId(wp.Name, wp.Id)}' cannot be renamed (correlation preserved)");
            return;
        }
        // Themed in-app prompt via ConfirmationService. Replaced the
        // earlier window.prompt(): the native dialog is blocked in
        // some MDM profiles and in PWA standalone display mode on
        // iPad, and it ignored night-mode anyway. The service
        // returns null on Cancel / Escape and a trimmed non-empty
        // string on OK.
        var current = wp.Name ?? "";
        var updated = await Confirmations.PromptAsync(
            "New waypoint name:", current,
            confirmLabel: "Rename");
        if (updated is null) return;               // cancelled
        if (updated == current) return;            // no-op
        ApiResult r;
        try { r = await WaypointApi.UpdateAsync(wp, updated); }
        catch (Exception ex) { Toasts.LogException(ex, "Rename"); return; }
        if (!r.Success) { Toasts.Error($"Rename failed: {r.Error ?? "server rejected"}"); return; }
        Toasts.Success($"Renamed to '{updated}'");
        // Reflect locally; no need to refetch the whole list.
        wp.Name = updated;
        StateHasChanged();
    }

    // Confirm via the shared service so a future styled-modal
    // swap lands in ConfirmationService.cs once, not at every
    // delete button across the app.
    [Inject] private IConfirmationService Confirmations { get; set; } = default!;
    private Task<bool> Confirm(string message) =>
        Confirmations.ConfirmAsync(message);

    private static string NameOrId(string? name, string id) =>
        string.IsNullOrWhiteSpace(name) ? id : name!;

    private static string FormatLatLon(double? lat, double? lon) =>
        lat is double la && lon is double lo ? $"{la:F5}, {lo:F5}" : "-";

    private static int CountRouteWaypoints(SignalkRoute r)
    {
        var coords = r.Feature?.Geometry?.Coordinates;
        if (coords is null || coords.Value.ValueKind != System.Text.Json.JsonValueKind.Array) return 0;
        return coords.Value.GetArrayLength();
    }

    private static int CountRegionVertices(SignalkRegion r) =>
        r.OuterRings.Sum(ring => ring.Length);
}
