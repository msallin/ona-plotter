    // ---------------- Import -------------------------------------

    /// <summary>Handle a page-level file pick: read text, sniff
    /// format (GPX vs GeoJSON), parse, and POST each feature into
    /// its matching API. Refreshes every loaded list after, so the
    /// imported routes / waypoints / notes / regions appear in
    /// their tabs without a manual reload. Toasts the count
    /// breakdown so the helm can verify against what they expected.</summary>
    private async Task HandleImport(InputFileChangeEventArgs e)
    {
        if (importing) return;
        importing = true;
        _importProgressDone = 0;
        _importProgressTotal = 0;
        _importCts = new CancellationTokenSource();
        var ct = _importCts.Token;
        StateHasChanged();
        try
        {
            string content;
            using (var reader = new System.IO.StreamReader(
                e.File.OpenReadStream(maxAllowedSize: MaxImportBytes)))
            {
                content = await reader.ReadToEndAsync(ct);
            }

            ImportResult parsed;
            try { parsed = ResourceImporter.Parse(content); }
            catch (FormatException fx) { Toasts.Error($"Import failed: {fx.Message}"); return; }
            catch (System.Xml.XmlException xx) { Toasts.Error($"Import failed: malformed GPX - {xx.Message}"); return; }
            catch (System.Text.Json.JsonException jx) { Toasts.Error($"Import failed: malformed GeoJSON - {jx.Message}"); return; }

            if (parsed.TotalCount == 0)
            {
                Toasts.Info("No routes / waypoints / notes / regions found in the file.");
                return;
            }

            // Per-feature creates. Fire sequentially to keep server
            // load gentle (typical pi-class SK server) and so a
            // mid-flight failure surfaces with an accurate count.
            // The token check between items lets the helm cancel a
            // slow import (sat link / 4G blip) without losing the
            // already-saved entries on the server.
            _importProgressTotal = parsed.TotalCount;
            int rOk = 0, wOk = 0, nOk = 0, gOk = 0, failed = 0;
            bool cancelled = false;
            foreach (var route in parsed.Routes)
            {
                if (ct.IsCancellationRequested) { cancelled = true; break; }
                try
                {
                    var r = await RouteApi.SaveAsync(route.Name, route.CoordsLatLon, ct);
                    if (r.Success) rOk++; else failed++;
                }
                catch (OperationCanceledException) { cancelled = true; break; }
                catch { failed++; }
                _importProgressDone++;
                StateHasChanged();
            }
            foreach (var wp in parsed.Waypoints)
            {
                if (cancelled || ct.IsCancellationRequested) { cancelled = true; break; }
                try
                {
                    var r = await WaypointApi.CreateAsync(wp.Name, wp.Lat, wp.Lon, wp.Description, ct);
                    if (r.Success) wOk++; else failed++;
                }
                catch (OperationCanceledException) { cancelled = true; break; }
                catch { failed++; }
                _importProgressDone++;
                StateHasChanged();
            }
            foreach (var note in parsed.Notes)
            {
                if (cancelled || ct.IsCancellationRequested) { cancelled = true; break; }
                try
                {
                    var r = await NoteApi.CreateAsync(
                        note.Title, note.Description ?? "", note.Lat, note.Lon, ct);
                    if (r.Success) nOk++; else failed++;
                }
                catch (OperationCanceledException) { cancelled = true; break; }
                catch { failed++; }
                _importProgressDone++;
                StateHasChanged();
            }
            foreach (var region in parsed.Regions)
            {
                if (cancelled || ct.IsCancellationRequested) { cancelled = true; break; }
                try
                {
                    var r = await RegionApi.CreatePolygonAsync(
                        region.Name, region.Description ?? "", region.RingLatLon, ct: ct);
                    if (r.Success) gOk++; else failed++;
                }
                catch (OperationCanceledException) { cancelled = true; break; }
                catch { failed++; }
                _importProgressDone++;
                StateHasChanged();
            }

            // Refresh lists so the new entries appear in their tabs.
            await LoadAllAsync();

            string summary = $"Imported {rOk} route{Plural(rOk)}, "
                + $"{wOk} waypoint{Plural(wOk)}, "
                + $"{nOk} note{Plural(nOk)}, "
                + $"{gOk} region{Plural(gOk)}";
            if (cancelled)
            {
                Toasts.Warning($"{summary} (cancelled at {_importProgressDone} of {_importProgressTotal}).");
            }
            else if (failed > 0)
            {
                Toasts.Error($"{summary}. {failed} failed (see browser console).");
            }
            else
            {
                Toasts.Success(summary);
            }
        }
        catch (OperationCanceledException)
        {
            Toasts.Warning("Import cancelled.");
        }
        catch (Exception ex)
        {
            Toasts.LogException(ex, "Import");
        }
        finally
        {
            importing = false;
            _importProgressDone = 0;
            _importProgressTotal = 0;
            _importCts?.Dispose();
            _importCts = null;
            StateHasChanged();
        }

        static string Plural(int n) => n == 1 ? "" : "s";
    }

