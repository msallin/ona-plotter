@* Bulk-management page for SignalK resources (routes, waypoints,
   notes, regions). The Map page already exposes per-item edit / delete
   via popups and the Layers panel; this page answers the complementary
   question "what do I have on this server?", which you can't easily
   get from the map when the list runs into the hundreds. Tracks are
   intentionally omitted: the server track is a read-only history, not
   a CRUD resource. *@

@page "/resources"
@using OnaPlotter.Services
@using OnaPlotter.Services.Api
@using OnaPlotter.Models
@using OnaPlotter.Utilities
@using OnaPlotter.Components.Resources
@inject IRouteApi RouteApi
@inject IWaypointApi WaypointApi
@inject INoteApi NoteApi
@inject IRegionApi RegionApi
@inject ICourseApi CourseApi
@inject IToastService Toasts
@inject NavigationManager Nav
@inject SignalkClient SignalkClient
@inject OnaPlotter.Services.Resources.ResourceStore ResourceStore
@inject Microsoft.JSInterop.IJSRuntime JS
@using OnaPlotter.Services.Json
@using Microsoft.AspNetCore.Components.Forms
@implements IAsyncDisposable

<PageTitle>Resources</PageTitle>

@*
    Page chrome (header, subtitle, max-width gutter) uses the shared
    .app-page-* classes so this page renders with the same heading
    scale and spacing as Wind / Settings / etc. Action buttons are
    grouped with .resource-actions so the View / Edit / Delete cluster
    reads as a single affordance per row instead of three loose chips.
    Truncated descriptions carry a title attribute so the helm can
    hover to see the full text without an extra click.
*@
<div class="app-page resources-page">
    <header class="app-page-header d-flex align-items-start justify-content-between gap-2 flex-wrap">
        <div>
            <h1>Resources</h1>
            <p class="app-page-subtitle">
                Everything stored on this SignalK server that OnaPlotter can render:
                routes, waypoints, notes, regions. Useful for house-keeping when the
                Layers panel is full or when a past plotter left orphans behind.
            </p>
        </div>
        @* Action cluster: Import + (Cancel during import) + Refresh
           wrapped in a single flex group so they read as one
           "data-management toolbar" instead of the title floating
           between them. Helm-flagged: the previous layout used
           justify-content: space-between on three siblings, which
           pushed Import to the centre and Refresh to the far right
           with a wide gap between them. *@
        <div class="d-flex align-items-start gap-2 flex-wrap">
            @* Page-level Import. Auto-detects GPX (XML) or GeoJSON (JSON)
               on the way in and routes each feature to its matching API:
               LineString -> route, Point + title -> note, Point + name ->
               waypoint, Polygon / MultiPolygon -> region, GPX rte ->
               route, GPX wpt -> waypoint. Per-row Export already lives
               on every row above; the matching Import rounds the data-
               management flow into one place. Replaces the Settings
               Backup section (focus-group field report 2026-04). *@
            <label class="btn btn-outline-primary @(importing ? "disabled" : "")"
                   style="white-space:nowrap;"
                   title="Drop in a GPX or GeoJSON file - format auto-detected">
                @if (importing)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                    <span>@(_importProgressTotal > 0 ? $"Importing {_importProgressDone}/{_importProgressTotal}..." : "Importing...")</span>
                }
                else
                {
                    <span>Import...</span>
                }
                <InputFile OnChange="HandleImport" Accept=".gpx,.geojson,.json,.xml"
                           style="display:none;" disabled="@importing" />
            </label>
            @if (importing)
            {
                <button type="button" class="btn btn-sm btn-outline-secondary"
                        @onclick="CancelImport"
                        title="Stop the import after the current item; already-saved items are kept on the server">
                    Cancel
                </button>
            }
            @* Manual refresh: drop the cache + REST-fetch every resource
               type. Live deltas usually keep the page current automatically,
               but the helm sometimes wants a hard "is this REALLY what's
               on the server" check (e.g. after a server-side restore from
               backup, after toggling the SK plugin, or just for peace of
               mind). RefreshAllAsync wipes the in-memory cache and replaces
               it with the REST snapshot, firing per-type Removed events
               for any id that disappeared. *@
            <button type="button" class="btn btn-outline-secondary"
                    @onclick="HandleManualRefresh"
                    disabled="@loading"
                    title="Drop the local cache and re-fetch every resource type from the server."
                    style="white-space:nowrap;">
                @if (loading)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                    <span>Refreshing...</span>
                }
                else
                {
                    <span>Refresh</span>
                }
            </button>
        </div>
    </header>

    @* Active-route pin. Sits ABOVE the tabs so it's visible regardless
       of which tab is open - a route the helm activated yesterday on
       another plotter still shows here, with one-tap "View on map" /
       "Stop" so the helm doesn't have to dig through the Routes tab
       to find which one is currently in use. Re-renders on
       SignalkClient.OnDataChanged via the subscription wired in
       OnInitializedAsync. *@
    @if (SignalkClient.Data.HasActiveCourse)
    {
        var data = SignalkClient.Data;
        var name = string.IsNullOrWhiteSpace(data.ActiveRouteName)
            ? "Active route"
            : data.ActiveRouteName;
        var idx = data.ActiveRoutePointIndex;
        var total = data.ActiveRoutePointTotal;
        <div class="active-route-pin" role="status" aria-label="Active route">
            <div class="active-route-pin-body">
                <span class="active-route-pin-icon" aria-hidden="true">&#9873;</span>
                <span class="active-route-pin-name">@name</span>
                @if (idx is int ii && total is int tt && tt > 0)
                {
                    <span class="active-route-pin-progress">WP @(ii + 1) of @tt</span>
                }
                @if (data.CourseNextPointDistance is double m)
                {
                    <span class="active-route-pin-meta">@($"{m / OnaPlotter.Utilities.Format.MetersPerNm:F2} nm to next")</span>
                }
            </div>
            <div class="active-route-pin-actions">
                @if (data.ActiveRouteHref is string href
                     && OnaPlotter.Services.Api.SignalKUrls.ExtractRouteId(href) is string activeId
                     && !string.IsNullOrEmpty(activeId))
                {
                    <button class="btn btn-sm btn-outline-secondary"
                            @onclick="() => OpenOnMap(TypeRoute, activeId, edit: false)">
                        View on map
                    </button>
                }
                <button class="btn btn-sm btn-outline-danger"
                        @onclick="StopActiveRoute"
                        disabled="@_stoppingActiveRoute"
                        title="Clear the active route on the SignalK server">
                    @(_stoppingActiveRoute ? "Stopping..." : "Stop")
                </button>
            </div>
        </div>
    }

    <ul class="nav nav-tabs resources-tabs" role="tablist">
        @foreach (var t in _tabs)
        {
            <li class="nav-item" role="presentation">
                <button type="button"
                        class="nav-link @(activeTab == t.Key ? "active" : "")"
                        role="tab"
                        aria-selected="@(activeTab == t.Key)"
                        @onclick="() => SetTab(t.Key)">
                    @t.Label <span class="resources-tab-count">@t.Count()</span>
                </button>
            </li>
        }
    </ul>

    @* Filter input. Surfaces above the table only when the active tab
       has more than 6 rows - below that, scanning the list is faster
       than typing. Same threshold as the Layers panel filter on the
       Map page. Filter matches the name (case-insensitive substring)
       so "260" finds every "260322" / "260407" / "260409" route in
       one keystroke. *@
    @if (!loading && ShouldShowFilter())
    {
        <input type="text" class="resources-filter"
               placeholder="@($"Filter {activeTab}...")"
               aria-label="Filter resources"
               value="@filter" @oninput="OnFilterInput" />
    }


    <div class="resources-body">
        @if (loading)
        {
            <LoadingState Label="Loading resources..." />
        }
        else if (activeTab == "routes")
        {
            <ResourceTable Columns="RouteColumns"
                           IsEmpty="FilteredRoutes().Count == 0"
                           EmptyMessage="@EmptyMessageFor("routes", routesLoadFailed)">
                @foreach (var r in FilteredRoutes())
                {
                    <tr>
                        <td>@NameOrId(r.Name, r.Id)</td>
                        <td>@CountRouteWaypoints(r)</td>
                        <td>@(r.Distance is double d ? $"{d / Format.MetersPerNm:F2} nm" : "-")</td>
                        <td class="text-end">
                            <div class="resource-actions" role="group" aria-label="Route actions">
                                <button class="btn btn-sm btn-outline-secondary"
                                        @onclick="() => OpenOnMap(TypeRoute, r.Id, edit: false)">View</button>
                                <button class="btn btn-sm btn-outline-secondary"
                                        @onclick="() => OpenOnMap(TypeRoute, r.Id, edit: true)">Edit</button>
                                <button class="btn btn-sm btn-outline-secondary"
                                        @onclick="() => ExportRoute(r)"
                                        title="Export (asks GPX or GeoJSON)">Export</button>
                                <button class="btn btn-sm btn-outline-danger"
                                        @onclick="() => DeleteRoute(r.Id, r.Name)">Delete</button>
                            </div>
                        </td>
                    </tr>
                }
            </ResourceTable>
        }
        else if (activeTab == "waypoints")
        {
            <ResourceTable Columns="WaypointColumns"
                           IsEmpty="FilteredWaypoints().Count == 0"
                           EmptyMessage="@EmptyMessageFor("waypoints", waypointsLoadFailed)">
                @foreach (var w in FilteredWaypoints())
                {
                    <tr>
                        <td>@NameOrId(w.Name, w.Id)</td>
                        <td>@FormatLatLon(w.Latitude, w.Longitude)</td>
                        <td class="text-end">
                            <div class="resource-actions" role="group" aria-label="Waypoint actions">
                                <button class="btn btn-sm btn-outline-secondary"
                                        @onclick="() => OpenOnMap(TypeWaypoint, w.Id, edit: false)">View</button>
                                @* Edit hidden on MOB waypoints: editing through the
                                   simpler UpdateAsync overload would strip
                                   isMob/isActive/mobAlarmId and break cross-plotter
                                   correlation. The C# JSInvokable + EditWaypointName
                                   refuse for the same reason as defense-in-depth. *@
                                @if (!w.IsMob)
                                {
                                    <button class="btn btn-sm btn-outline-secondary"
                                            @onclick="() => EditWaypointName(w)">Edit</button>
                                }
                                <button class="btn btn-sm btn-outline-secondary"
                                        @onclick="() => ExportWaypoint(w)"
                                        title="Export (asks GPX or GeoJSON)">Export</button>
                                <button class="btn btn-sm btn-outline-secondary"
                                        @onclick="() => ShareWaypoint(w)"
                                        title="Share via system share or copy GeoJSON to clipboard">Share</button>
                                <button class="btn btn-sm btn-outline-danger"
                                        @onclick="() => DeleteWaypoint(w.Id, w.Name)">Delete</button>
                            </div>
                        </td>
                    </tr>
                }
            </ResourceTable>
        }
        else if (activeTab == "notes")
        {
            <ResourceTable Columns="NoteColumns"
                           IsEmpty="FilteredNotes().Count == 0"
                           EmptyMessage="@EmptyMessageFor("notes", notesLoadFailed)">
                @foreach (var n in FilteredNotes())
                {
                    <tr>
                        <td>@NameOrId(n.Title, n.Id)</td>
                        <td>@FormatLatLon(n.Position?.Latitude, n.Position?.Longitude)</td>
                        <td class="text-muted resource-text-cell" title="@(n.Description ?? "")">
                            @(n.Description ?? "")
                        </td>
                        <td class="text-end">
                            <div class="resource-actions" role="group" aria-label="Note actions">
                                <button class="btn btn-sm btn-outline-secondary"
                                        @onclick="() => OpenOnMap(TypeNote, n.Id, edit: false)">View</button>
                                <button class="btn btn-sm btn-outline-secondary"
                                        @onclick="() => EditNoteTitle(n)">Edit</button>
                                <button class="btn btn-sm btn-outline-secondary"
                                        @onclick="() => ExportNote(n)"
                                        title="Export (asks GPX or GeoJSON)">Export</button>
                                <button class="btn btn-sm btn-outline-secondary"
                                        @onclick="() => ShareNote(n)"
                                        title="Share via system share or copy GeoJSON to clipboard">Share</button>
                                <button class="btn btn-sm btn-outline-danger"
                                        @onclick="() => DeleteNote(n.Id, n.Title)">Delete</button>
                            </div>
                        </td>
                    </tr>
                }
            </ResourceTable>
        }
        else if (activeTab == "regions")
        {
            <ResourceTable Columns="RegionColumns"
                           IsEmpty="FilteredRegions().Count == 0"
                           EmptyMessage="@EmptyMessageFor("regions", regionsLoadFailed)">
                @foreach (var r in FilteredRegions())
                {
                    <tr>
                        <td>@NameOrId(r.Name, r.Id)</td>
                        <td>@CountRegionVertices(r)</td>
                        <td class="text-muted resource-text-cell" title="@(r.Description ?? "")">
                            @(r.Description ?? "")
                        </td>
                        <td class="text-end">
                            <div class="resource-actions" role="group" aria-label="Region actions">
                                <button class="btn btn-sm btn-outline-secondary"
                                        @onclick="() => OpenOnMap(TypeRegion, r.Id, edit: false)">View</button>
                                <button class="btn btn-sm btn-outline-secondary"
                                        @onclick="() => OpenOnMap(TypeRegion, r.Id, edit: true)">Edit</button>
                                <button class="btn btn-sm btn-outline-secondary"
                                        @onclick="() => ExportRegion(r)"
                                        title="Export as GeoJSON">Export</button>
                                <button class="btn btn-sm btn-outline-danger"
                                        @onclick="() => DeleteRegion(r.Id, r.Name)">Delete</button>
                            </div>
                        </td>
                    </tr>
                }
            </ResourceTable>
        }
    </div>
</div>

@code {
    // Tab labels live in a small list so the header + active-class
    // wiring stays declarative. Count lambdas read the already-loaded
    // collections; they're recomputed on every render but these are
    // tens-to-hundreds of entries and the math is trivial.
    private record TabDef(string Key, string Label, Func<int> Count);
    private List<TabDef> _tabs = [];

    // Resource-kind tokens used when deep-linking into the Map page via
    // /map?focus=<type>:<id> or ?edit=<type>:<id>. Defined as constants
    // because the View/Edit buttons bind them in attribute values where
    // escaping inline string literals inside `@onclick` lambdas is
    // painful.
    private const string TypeRoute = "route";
    private const string TypeWaypoint = "waypoint";
    private const string TypeNote = "note";
    private const string TypeRegion = "region";

    private string activeTab = "routes";
    private bool loading = true;

    /// <summary>True while a Stop-active-route REST call is in flight.
    /// Disables the Stop button so a double-tap on the pinned banner
    /// can't fire two PUTs against navigation/course.</summary>
    private bool _stoppingActiveRoute;

    /// <summary>True while a page-level Import is in flight. Drives
    /// the Import button's spinner + disabled state so a slow
    /// SignalK server (per-feature POST round-trips) doesn't tempt
    /// the helm into picking the file twice.</summary>
    private bool importing;

    /// <summary>Per-feature progress for the import spinner ("Importing
    /// 5/42..."). Reset to 0/0 between imports. Updated synchronously
    /// inside <see cref="HandleImport"/> after each per-feature await
    /// so the helm sees forward motion on a long import without
    /// guessing whether the network is hung.</summary>
    private int _importProgressDone;
    private int _importProgressTotal;

    /// <summary>Driver for the Cancel button on the import spinner row.
    /// Null when no import is in flight; created on entry to
    /// <see cref="HandleImport"/> and disposed in the finally. The
    /// helm tap fires <see cref="CancelImport"/> which signals; the
    /// per-feature loop checks the token between items so already-
    /// saved features stay on the server.</summary>
    private CancellationTokenSource? _importCts;

    private void CancelImport()
    {
        try { _importCts?.Cancel(); }
        catch (ObjectDisposedException) { /* already finishing */ }
    }
    /// <summary>Filesystem cap on the import payload. 8 MB matches
    /// what GpxService used to allow; a typical season's GPX or
    /// GeoJSON dump is under 1 MB.</summary>
    private const long MaxImportBytes = 8 * 1024 * 1024;

    // Lazy-loaded JS helper for blob-download. Disposed in
    // DisposeAsync so the IJSObjectReference doesn't outlive the
    // page; same pattern as Settings.razor's GPX export. _exportLock
    // serialises concurrent Export clicks across rapid clicks (the
    // helm sometimes machine-guns the button on a slow tablet) so
    // the same JS module isn't imported twice.
    private Microsoft.JSInterop.IJSObjectReference? _fileTransfer;
    private readonly System.Threading.SemaphoreSlim _exportLock = new(1, 1);

    // Format option labels. Constants because they're matched by
    // string in the dialog return + extension picking; a typo in
    // either site would silently misdownload a .gpx as a .geojson.
    private const string FormatGpx = "GPX";
    private const string FormatGeoJson = "GeoJSON";
    private static readonly IReadOnlyList<string> FormatOptions = [FormatGpx, FormatGeoJson];

    // Filter input shown above the table once the active tab has more
    // rows than scan-by-eye works for. Case-insensitive substring match
    // on the user-visible name; matches against r.Name (or n.Title for
    // notes), not r.Id, since the helm names routes in human terms.
    private string filter = "";
    private const int FilterShowThreshold = 6;
    private bool ShouldShowFilter() => activeTab switch
    {
        "routes"    => routes.Count    > FilterShowThreshold,
        "waypoints" => waypoints.Count > FilterShowThreshold,
        "notes"     => notes.Count     > FilterShowThreshold,
        "regions"   => regions.Count   > FilterShowThreshold,
        _           => false,
    };
    private void OnFilterInput(ChangeEventArgs e) => filter = e.Value?.ToString() ?? "";
    private bool MatchesFilter(string? hay)
    {
        if (string.IsNullOrEmpty(filter)) return true;
        return (hay ?? "").Contains(filter, StringComparison.OrdinalIgnoreCase);
    }
    private List<SignalkRoute>    FilteredRoutes()    => routes   .Where(r => MatchesFilter(r.Name)).ToList();
    private List<SignalkWaypoint> FilteredWaypoints() => waypoints.Where(w => MatchesFilter(w.Name)).ToList();
    private List<SignalkNote>     FilteredNotes()     => notes    .Where(n => MatchesFilter(n.Title)).ToList();
    private List<SignalkRegion>   FilteredRegions()   => regions  .Where(r => MatchesFilter(r.Name)).ToList();

    // Column header lists declared once in code so the Razor attribute
    // binding doesn't have to inline a string[] literal (attribute
    // double-quotes collide with the strings inside the array).
    private static readonly string[] RouteColumns    = ["Name", "Waypoints", "Distance"];
    private static readonly string[] WaypointColumns = ["Name", "Position"];
    private static readonly string[] NoteColumns     = ["Title", "Position", "Description"];
    private static readonly string[] RegionColumns   = ["Name", "Vertices", "Description"];

    private List<SignalkRoute> routes = [];
    private List<SignalkWaypoint> waypoints = [];
    private List<SignalkNote> notes = [];
    private List<SignalkRegion> regions = [];

    // Per-resource load-failed flags so the empty-state copy can
    // distinguish "server returned an empty list" from "we couldn't
    // reach the server". Shown as "Couldn't reach the server - check
    // the SignalK connection." instead of the misleading "No routes on
    // the server." when the fetch threw.
    private bool routesLoadFailed;
    private bool waypointsLoadFailed;
    private bool notesLoadFailed;
    private bool regionsLoadFailed;

    protected override async Task OnInitializedAsync()
    {
        _tabs =
        [
            new("routes",    "Routes",    () => routes.Count),
            new("waypoints", "Waypoints", () => waypoints.Count),
            new("notes",     "Notes",     () => notes.Count),
            new("regions",   "Regions",   () => regions.Count),
        ];

        // Subscribe to ResourceStore so live deltas (route created /
        // edited / deleted on another plotter; same plotter's Map page
        // creating a waypoint, etc.) re-render this page immediately
        // without the helm having to manually refresh. Cheap re-pull of
        // the cached snapshots on every event - the store already has
        // the current state, so this is just a list copy.
        ResourceStore.OnReloaded += HandleStoreReloaded;
        ResourceStore.OnRouteChanged += HandleStoreRouteChanged;
        ResourceStore.OnRouteRemoved += HandleStoreRouteRemoved;
        ResourceStore.OnWaypointChanged += HandleStoreWaypointChanged;
        ResourceStore.OnWaypointRemoved += HandleStoreWaypointRemoved;
        ResourceStore.OnNoteChanged += HandleStoreNoteChanged;
        ResourceStore.OnNoteRemoved += HandleStoreNoteRemoved;
        ResourceStore.OnRegionChanged += HandleStoreRegionChanged;
        ResourceStore.OnRegionRemoved += HandleStoreRegionRemoved;

        // Active-route pin re-renders when the helm progresses through
        // the route (next-WP delta, distance ticks) or activates / stops
        // a route from another plotter. Cheap re-render - the page is
        // mostly tabs and tables; a single banner re-paint at SK delta
        // cadence is invisible on the helm.
        SignalkClient.OnDataChanged += HandleNavigationDataChanged;

        await LoadAllAsync();
    }

    private void HandleNavigationDataChanged() =>
        _ = InvokeAsync(StateHasChanged);

    /// <summary>Stop the currently-active route via the v2 course API.
    /// PUT navigation.course.activeRoute = null clears the active
    /// course; the WS delta then flips
    /// <see cref="OnaPlotter.Models.NavigationData.HasActiveCourse"/>
    /// to false and the pin un-renders. Mirrors the Map page's Stop
    /// Navigation button so the helm has a one-tap exit from this
    /// page too.</summary>
    private async Task StopActiveRoute()
    {
        if (_stoppingActiveRoute) return;
        _stoppingActiveRoute = true;
        try
        {
            var r = await CourseApi.ClearAsync();
            if (!r.Success)
            {
                Toasts.Error($"Stop failed: {r.Error ?? "server rejected"}");
            }
        }
        catch (Exception ex)
        {
            Toasts.LogException(ex, "Stop active route");
        }
        finally
        {
            _stoppingActiveRoute = false;
        }
    }

    /// <summary>Manual refresh button handler. Force the store to
    /// re-fetch every resource type via REST, replacing the cached
    /// snapshot. Per-type events fire as the new state lands so the
    /// page re-renders. Helm uses this for "is this REALLY what's on
    /// the server" sanity checks; live deltas normally keep the page
    /// current without manual intervention.</summary>
    private async Task HandleManualRefresh()
    {
        if (loading) return;
        loading = true;
        try
        {
            await ResourceStore.RefreshAllAsync(cause: "manual");
            // RefreshAllAsync fires per-type Changed/Removed events as
            // the cache mutates, so HandleStore* hooks above already
            // copied the new state into our local lists. The explicit
            // CopyFromStore here is a belt-and-braces sync in case the
            // event order observation skipped a type (e.g. all four
            // tasks failed and no events fired - IsLoaded still flips
            // true, the user expects the failure flags to clear).
            CopyFromStore();
            Toasts.Info("Resources refreshed.");
        }
        catch (Exception ex)
        {
            // ResourceStore.RefreshAllAsync swallows per-type failures
            // internally, so reaching the catch here is a genuine
            // unexpected throw (logger threw, etc.). Surface it.
            Toasts.LogException(ex, "Refresh resources");
        }
        finally
        {
            loading = false;
        }
    }

    private async Task LoadAllAsync()
    {
        loading = true;
        // Reset failure flags on each (re)load so a previous offline
        // state doesn't leak into a successful retry.
        routesLoadFailed = waypointsLoadFailed = notesLoadFailed = regionsLoadFailed = false;
        try
        {
            // Source of truth is the ResourceStore singleton - it owns
            // the REST initial-load + delta-driven cache + reconcile-on-
            // reconnect, so this page reads from it instead of issuing
            // its own REST round-trips. If the store hasn't loaded yet
            // (page mounted before the singleton's startup refresh
            // completed) we kick a refresh and await it.
            if (!ResourceStore.IsLoaded)
            {
                await ResourceStore.RefreshAllAsync(cause: "page-mount");
            }
            CopyFromStore();
        }
        finally
        {
            loading = false;
        }
    }

    private void CopyFromStore()
    {
        // List<>(IEnumerable) copies each entry into a fresh list so
        // the page can mutate (sort, group) without aliasing the store.
        routes    = new List<SignalkRoute>(ResourceStore.Routes);
        waypoints = new List<SignalkWaypoint>(ResourceStore.Waypoints);
        notes     = new List<SignalkNote>(ResourceStore.Notes);
        regions   = new List<SignalkRegion>(ResourceStore.Regions);
        // Failure flags drive empty-state messaging. With the store as
        // the source of truth we can't tell per-type from here whether
        // a particular fetch failed - the worst case is the empty
        // tab shows the generic "no items" copy instead of a network-
        // failure hint, which is acceptable. The store logs failures.
        routesLoadFailed = waypointsLoadFailed = notesLoadFailed = regionsLoadFailed = false;
    }

    private void HandleStoreReloaded()       => InvokeAsync(() => { CopyFromStore(); StateHasChanged(); });
    private void HandleStoreRouteChanged(string _)    => InvokeAsync(() => { CopyFromStore(); StateHasChanged(); });
    private void HandleStoreRouteRemoved(string _)    => InvokeAsync(() => { CopyFromStore(); StateHasChanged(); });
    private void HandleStoreWaypointChanged(string _) => InvokeAsync(() => { CopyFromStore(); StateHasChanged(); });
    private void HandleStoreWaypointRemoved(string _) => InvokeAsync(() => { CopyFromStore(); StateHasChanged(); });
    private void HandleStoreNoteChanged(string _)     => InvokeAsync(() => { CopyFromStore(); StateHasChanged(); });
    private void HandleStoreNoteRemoved(string _)     => InvokeAsync(() => { CopyFromStore(); StateHasChanged(); });
    private void HandleStoreRegionChanged(string _)   => InvokeAsync(() => { CopyFromStore(); StateHasChanged(); });
    private void HandleStoreRegionRemoved(string _)   => InvokeAsync(() => { CopyFromStore(); StateHasChanged(); });

    // Any one endpoint being down shouldn't take the whole page with it -
    // the Settings / Paths pages follow the same pattern so a partial
    // outage still shows the healthy tabs with their real data. While
    // SignalK is offline we suppress per-kind toasts and let the
    // connection chip + empty-state copy speak; otherwise the helm sees
    // four "Load failed: TypeError: Failed to fetch" toasts on a fresh
    // visit, which reads as broken-app rather than offline.
    private async Task<List<T>?> SafeCall<T>(string kind, Func<Task<List<T>>> call)
    {
        try { return await call(); }
        catch (Exception ex)
        {
            if (SignalkClient.IsConnected)
                Toasts.LogException(ex, $"Load {kind}");
            return null;
        }
    }

    // Empty-state copy switches based on whether the load actually failed:
    // a successful empty list says "No routes on the server"; a fetch
    // failure says "Couldn't reach the server" so the helm doesn't see
    // a misleading "your data is gone" message during a connection blip.
    private static string EmptyMessageFor(string kind, bool loadFailed) =>
        loadFailed
            ? $"Couldn't reach the server - {kind} couldn't be loaded. Check the SignalK connection."
            : $"No {kind} on the server.";

    private void SetTab(string key)
    {
        activeTab = key;
        // Filter is per-tab semantically: switching tabs should not
        // carry "joy" over to a regions tab where the helm doesn't
        // remember why all rows are filtered out.
        filter = "";
    }

    private async Task DeleteRoute(string id, string? name)
    {
        if (!await Confirm($"Delete route '{NameOrId(name, id)}'?")) return;
        ApiResult r;
        try { r = await RouteApi.DeleteAsync(id); }
        catch (Exception ex) { Toasts.LogException(ex, "Delete route"); return; }
        if (!r.Success) { Toasts.Error($"Delete route failed: {r.Error ?? "server rejected"}"); return; }
        Toasts.Info("Route deleted");
        routes = routes.Where(rt => rt.Id != id).ToList();
    }

