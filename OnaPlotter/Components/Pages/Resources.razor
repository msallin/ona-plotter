    /// <summary>Resources-page rename for notes. Mirrors
    /// <see cref="EditWaypointName"/>: themed prompt via the shared
    /// confirmation service, optimistic local mutation so the row
    /// reflects the new title without a list refresh. Description is
    /// untouched - single-field rename matches the layers-panel
    /// edit affordance, multi-field edit deferred to a dedicated
    /// dialog.</summary>
    private async Task EditNoteTitle(SignalkNote n)
    {
        var current = n.Title ?? "";
        var updated = await Confirmations.PromptAsync(
            "New note title:", current,
            confirmLabel: "Rename");
        if (updated is null) return;            // cancelled
        var trimmed = updated.Trim();
        if (string.IsNullOrEmpty(trimmed)) return;
        if (trimmed == current) return;          // no-op
        ApiResult r;
        try { r = await NoteApi.UpdateAsync(n, trimmed, n.Description); }
        catch (Exception ex) { Toasts.LogException(ex, "Rename"); return; }
        if (!r.Success) { Toasts.Error($"Rename failed: {r.Error ?? "server rejected"}"); return; }
        Toasts.Success($"Renamed to '{trimmed}'");
        n.Title = trimmed;
        StateHasChanged();
    }

