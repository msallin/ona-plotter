    private async Task ExportRoute(SignalkRoute r)
    {
        var format = await AskFormat($"Export route '{NameOrId(r.Name, r.Id)}' as:");
        if (format is null) return;
        var content = format == FormatGeoJson
            ? ResourceExporter.RouteGeoJson(r)
            : ResourceExporter.RouteGpx(r);
        await DownloadAsync(content, NameOrId(r.Name, r.Id), format);
    }

