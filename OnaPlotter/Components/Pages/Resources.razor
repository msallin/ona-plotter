    {
        var format = await AskFormat($"Export note '{NameOrId(n.Title, n.Id)}' as:");
        if (format is null) return;
        var content = format == FormatGeoJson
            ? ResourceExporter.NoteGeoJson(n)
            : ResourceExporter.NoteGpx(n);
