<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Ships only the invariant culture instead of the 2.6 MB of ICU
         tables that Blazor otherwise bundles (icudt_CJK/no_CJK/EFIGS).
         We don't localise the chartplotter, and every format call uses
         CultureInfo.InvariantCulture explicitly, so the rest of ICU is
         dead weight. Saves ~500 KB brotli / 2 MB raw on first load,
         a meaningful chunk of cold-start on marine 4G. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <BlazorWebAssemblyLoadAllGlobalizationData>false</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- AOT compiles .NET IL to WebAssembly at publish time. Turn this
         off only if build time is a hard constraint. Roughly triples
         publish duration but gives a 2-5x speedup on the hot data-apply
         and alarm-eval path at runtime, measurable on a Raspberry Pi
         kiosk where the interpreter bottlenecks the main thread.
         WASM exception-handling note: .NET 10's runtime emits the
         older `try` instruction; Firefox console flags it as
         "deprecated, recompile to use try_table". The instruction
         choice is dotnet/runtime's; no SDK property surfaces a knob
         today. The warning is harmless until Firefox actually drops
         the older form; track the runtime ticket rather than working
         around it here. -->
    <RunAOTCompilation>true</RunAOTCompilation>
    <!-- TrimMode investigation gate. Default Blazor WASM trim mode
         is 'partial'; full mode would shave another 100-200 KB
         brotli but requires every reflection-resolved path to be
         annotated. Application code IS source-gen-clean
         (every JsonSerializer call routes through OnaJsonContext or
         OnaGeoJsonContext). The blocker is the XML stack used by
         ResourceImporter / ResourceExporter (GPX): trim-full removes
         what the trimmer can't see being statically used there, and
         rooting the assemblies whole with <TrimmerRootAssembly>
         costs more than full trimming saves. The path forward is a
         <TrimmerRootDescriptor> pinning only the types those two
         classes touch, plus a manual smoke test on the helm; see
         docs/research-trimmode.md for the audit and descriptor
         design. 'partial' until then. -->
    <TrimMode>partial</TrimMode>
    <!-- Strip the source IL from the published bundle after AOT. The
         WASM runtime can execute the native code alone; the IL would
         just sit in the download. Cuts roughly 15 to 20 percent off
         the payload size (fewer bytes to transfer to the kiosk on
         first load). -->
    <WasmStripILAfterAOT>true</WasmStripILAfterAOT>
    <!-- Tell the AOT compiler to optimise for speed over size. Kiosk
         workflow is "start once, run for a week"; a few hundred KB
         extra in the published bundle is a good trade for tighter
         hot-loop code. -->
    <OptimizationPreference>Speed</OptimizationPreference>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.*-*" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OnaPlotter.Tests" />
  </ItemGroup>

  <!-- Don't ship the JS test files to clients. They run locally
       under Node's built-in test runner against the wwwroot/js
       interop layer; their production siblings (aisLayer.js,
       geoMath.js, etc.) are what the browser actually loads. The
       default content glob would otherwise pull *.test.js + the
       __tests__ directory into the published bundle, adding weight
       and handing a small attack surface to anyone curious about
       internals. -->
  <ItemGroup>
    <Content Remove="wwwroot\js\**\*.test.js" />
    <Content Remove="wwwroot\js\**\*.test.mjs" />
    <Content Remove="wwwroot\js\__tests__\**" />
  </ItemGroup>

  <!-- Lazy-loading System.Private.Xml* is off: with AOT + partial
       trim, AOT-compiled methods carrying static refs into the lazy
       assemblies fail to resolve during mono_wasm_load_runtime and
       crash the helm at boot (assertion at appdomain.c:188).
       Enabling it needs either trim-full + a TrimmerRootDescriptor
       audit OR a smaller scope of types to lazy-load (e.g. only the
       GPX serialiser path that's actually opt-in). See
       docs/research-trimmode.md. -->

  <!-- Build stamp. Emits obj/BuildInfo.g.cs with the short git hash
       and a UTC build timestamp so the Settings page can render
       "build abc1234 (2026-04-24 12:34 UTC)" and the helm can
       visually verify which bundle is loaded (service worker / HTTP
       caching otherwise make it ambiguous). Runs before CoreCompile,
       so the generated file participates in the same build pass. On
       build environments without git (CI containers, tarball builds)
       the Exec's ContinueOnError gracefully yields an empty hash;
       the timestamp alone is still useful. -->
  <Target Name="StampBuildInfo" BeforeTargets="CoreCompile">
    <Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true"
          ContinueOnError="true" StandardOutputImportance="low"
          IgnoreExitCode="true">
      <Output PropertyName="OnaGitHash" TaskParameter="ConsoleOutput" />
    </Exec>
    <PropertyGroup>
      <OnaGitHash Condition="'$(OnaGitHash)' == ''">unknown</OnaGitHash>
      <OnaBuildUtc>$([System.DateTime]::UtcNow.ToString(`yyyy-MM-dd HH:mm`))</OnaBuildUtc>
      <OnaBuildInfoFile>$(IntermediateOutputPath)BuildInfo.g.cs</OnaBuildInfoFile>
    </PropertyGroup>
    <ItemGroup>
      <OnaBuildInfoLines Include="// &lt;auto-generated /&gt; written by StampBuildInfo target." />
      <OnaBuildInfoLines Include="namespace OnaPlotter%3B" />
      <OnaBuildInfoLines Include="internal static class BuildInfo" />
      <OnaBuildInfoLines Include="{" />
      <OnaBuildInfoLines Include="    public const string CommitHash = &quot;$(OnaGitHash)&quot;%3B" />
      <OnaBuildInfoLines Include="    public const string BuildUtc   = &quot;$(OnaBuildUtc)&quot;%3B" />
      <OnaBuildInfoLines Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(OnaBuildInfoFile)"
                      Lines="@(OnaBuildInfoLines)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(OnaBuildInfoFile)" />
      <FileWrites Include="$(OnaBuildInfoFile)" />
    </ItemGroup>

    <!-- Same hash + timestamp written as a tiny JS module. The boot
         loading screen (rendered before the Blazor runtime takes
         over) reads window.OnaPlotterBuild to show a small build
         stamp under the spinner: handy for verifying the helm is
         on the freshly-deployed bundle without waiting for Blazor
         to render the Settings page. Lives directly in wwwroot/js
         so it ships as a regular static asset; gitignored to keep
         build artefacts out of source. -->
    <PropertyGroup>
      <OnaVersionJsFile>$(MSBuildProjectDirectory)\wwwroot\js\version.g.js</OnaVersionJsFile>
    </PropertyGroup>
    <ItemGroup>
      <OnaVersionLines Include="// &lt;auto-generated /&gt; written by StampBuildInfo target." />
      <OnaVersionLines Include="window.OnaPlotterBuild = { hash: &quot;$(OnaGitHash)&quot;, utc: &quot;$(OnaBuildUtc)&quot; }%3B" />
    </ItemGroup>
    <WriteLinesToFile File="$(OnaVersionJsFile)"
                      Lines="@(OnaVersionLines)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
  </Target>

  <!-- Minify the hand-written JS interop layer on Release publish.
       Blazor's _framework JS is already minified by Microsoft; this
       covers wwwroot/js where the Leaflet glue, AIS layer, error
       relay etc. live (~25 files, mostly hand-formatted for
       readability). esbuild produces identical-but-compact output
       in one invocation: no source-map by default, no path changes
       (the interop graph is bundled separately below) - the same files Blazor expects to import live
       at the same paths, just smaller. ~30 to 40 percent size cut,
       brotli stacks on top.

       Requires `node_modules/esbuild` to exist - run `npm ci`
       (or `npm install`) from the repo root once before the first
       Release publish. CI's publish workflow does this in its npm
       step; locally the deploy.ps1 wrapper / `dotnet publish` user
       has to remember it. The CheckEsbuildPresent guard below
       surfaces a clear error instead of a cryptic npx failure. -->
  <Target Name="CheckEsbuildPresent" BeforeTargets="MinifyPublishedJs;BundleInteropModules;MinifyPublishedCss"
          Condition="'$(Configuration)' == 'Release'">
    <Error Text="esbuild not found in node_modules. Run 'npm ci' from the repo root before publishing in Release."
           Condition="!Exists('$(MSBuildThisFileDirectory)..\node_modules\esbuild\package.json')" />
  </Target>

  <Target Name="MinifyPublishedJs"
          AfterTargets="Publish"
          Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <_JsToMinify Include="$(PublishDir)wwwroot\js\**\*.js" />
    </ItemGroup>
    <Message Text="esbuild: minifying wwwroot/js in $(PublishDir)" Importance="high" />
    <Exec Command="npx --no-install esbuild --minify --allow-overwrite --outdir=&quot;$(PublishDir)wwwroot\js&quot; --outbase=&quot;$(PublishDir)wwwroot\js&quot; @(_JsToMinify->'&quot;%(FullPath)&quot;', ' ')"
          WorkingDirectory="$(MSBuildThisFileDirectory)..\"
          Condition="'@(_JsToMinify)' != ''" />
  </Target>

  <!-- Bundle leafletInterop.js and its static imports into one hashed
       module (js/leafletInterop.<HASH>.js) and turn the published
       leafletInterop.js into a one-line re-export of it, so a cold boot
       loads two scripts instead of ~30 through the service worker's
       network-first race. The bundle's name changes with its content,
       so the service worker serves it cache-first as immutable. Built
       from the source tree; C# keeps importing ./js/leafletInterop.js
       in both configurations (Debug serves the unbundled modules). -->
  <Target Name="BundleInteropModules"
          AfterTargets="MinifyPublishedJs"
          Condition="'$(Configuration)' == 'Release'">
    <Exec Command="node &quot;$(MSBuildThisFileDirectory)..\scripts\bundle-interop.mjs&quot; &quot;$(MSBuildProjectDirectory)\wwwroot\js&quot; &quot;$(PublishDir)wwwroot\js&quot;"
          WorkingDirectory="$(MSBuildThisFileDirectory)..\" />
  </Target>

  <!-- Same esbuild pass for the stylesheets: app.css is hand-formatted
       and heavily commented (~370 KB raw, ~135 KB minified). Paths stay
       put, so index.html and the service worker need no change. -->
  <Target Name="MinifyPublishedCss"
          AfterTargets="MinifyPublishedJs"
          Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <_CssToMinify Include="$(PublishDir)wwwroot\css\**\*.css" />
    </ItemGroup>
    <Message Text="esbuild: minifying wwwroot/css in $(PublishDir)" Importance="high" />
    <Exec Command="npx --no-install esbuild --minify --allow-overwrite --outdir=&quot;$(PublishDir)wwwroot\css&quot; --outbase=&quot;$(PublishDir)wwwroot\css&quot; @(_CssToMinify->'&quot;%(FullPath)&quot;', ' ')"
          WorkingDirectory="$(MSBuildThisFileDirectory)..\"
          Condition="'@(_CssToMinify)' != ''" />
  </Target>

  <!-- Stamp the published service-worker.js CACHE_NAME with the git
       hash so a new build invalidates the browser's installed SW
       cache. Source carries a hand-bumped placeholder
       (const CACHE_NAME = 'ona-plotter-vNNN'); this target rewrites
       it in the publish output only, leaving the source clean. Runs
       after MinifyPublishedJs so the stamped name lives in the
       version the helm actually downloads.

       OnaGitHash is computed by the StampBuildInfo target earlier
       in the build; on git-less environments it falls back to
       "unknown", in which case every cacheless deploy lands on the
       same key. That's a deliberate trade-off vs failing the build
       in environments that have no .git directory (tarball builds,
       certain CI containers). -->
  <Target Name="StampPublishedServiceWorker"
          AfterTargets="MinifyPublishedJs"
          Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <_SwPath>$(PublishDir)wwwroot\service-worker.js</_SwPath>
    </PropertyGroup>
    <Exec Command="node &quot;$(MSBuildThisFileDirectory)..\scripts\stamp-cache-name.mjs&quot; &quot;$(_SwPath)&quot; &quot;$(OnaGitHash)&quot;"
          Condition="Exists('$(_SwPath)')" />
  </Target>

  <!-- The SDK writes .br / .gz siblings for every static asset BEFORE the
       three targets above rewrite js/, css/ and service-worker.js, so
       those siblings hold the unminified, unstamped bytes. Delete them:
       a server that negotiates encodings would otherwise hand returning
       helms the old CACHE_NAME and never invalidate their cache. -->
  <Target Name="DropStalePrecompressedSiblings"
          AfterTargets="StampPublishedServiceWorker"
          Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <_StaleCompressed Include="$(PublishDir)wwwroot\js\**\*.js.br;$(PublishDir)wwwroot\js\**\*.js.gz" />
      <_StaleCompressed Include="$(PublishDir)wwwroot\css\**\*.css.br;$(PublishDir)wwwroot\css\**\*.css.gz" />
      <_StaleCompressed Include="$(PublishDir)wwwroot\service-worker.js.br;$(PublishDir)wwwroot\service-worker.js.gz" />
    </ItemGroup>
    <Delete Files="@(_StaleCompressed)" />
  </Target>

  <!-- Regenerate .br / .gz siblings for js/, css/ and lib/ from the final
       (minified, bundled) bytes. deploy/index.js serves them to clients
       that accept the encoding; _framework/ keeps the SDK's siblings. -->
  <Target Name="PrecompressPublishedAssets"
          AfterTargets="DropStalePrecompressedSiblings"
          Condition="'$(Configuration)' == 'Release'">
    <Exec Command="node &quot;$(MSBuildThisFileDirectory)..\scripts\precompress.mjs&quot; &quot;$(PublishDir)wwwroot\js&quot; &quot;$(PublishDir)wwwroot\css&quot; &quot;$(PublishDir)wwwroot\lib&quot;" />
  </Target>

</Project>
