<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Ships only the invariant culture instead of the 2.6 MB of ICU
         tables that Blazor otherwise bundles (icudt_CJK/no_CJK/EFIGS).
         We don't localise the chartplotter, and every format call uses
         CultureInfo.InvariantCulture explicitly, so the rest of ICU is
         dead weight. Saves ~500 KB brotli / 2 MB raw on first load,
         a meaningful chunk of cold-start on marine 4G. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <BlazorWebAssemblyLoadAllGlobalizationData>false</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- AOT compiles .NET IL to WebAssembly at publish time. Turn this
         off only if build time is a hard constraint. Roughly triples
         publish duration but gives a 2-5x speedup on the hot data-apply
         and alarm-eval path at runtime, measurable on a Raspberry Pi
         kiosk where the old interpreted path bottlenecked the main
         thread. -->
    <RunAOTCompilation>true</RunAOTCompilation>
    <!-- Strip the source IL from the published bundle after AOT. The
         WASM runtime can execute the native code alone; the IL would
         just sit in the download. Cuts roughly 15 to 20 percent off
         the payload size (fewer bytes to transfer to the kiosk on
         first load). -->
    <WasmStripILAfterAOT>true</WasmStripILAfterAOT>
    <!-- Tell the AOT compiler to optimise for speed over size. Kiosk
         workflow is "start once, run for a week"; a few hundred KB
         extra in the published bundle is a good trade for tighter
         hot-loop code. -->
    <OptimizationPreference>Speed</OptimizationPreference>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.*-*" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OnaPlotter.Tests" />
  </ItemGroup>

</Project>
