<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Ships only the invariant culture instead of the 2.6 MB of ICU
         tables that Blazor otherwise bundles (icudt_CJK/no_CJK/EFIGS).
         We don't localise the chartplotter, and every format call uses
         CultureInfo.InvariantCulture explicitly, so the rest of ICU is
         dead weight. Saves ~500 KB brotli / 2 MB raw on first load,
         a meaningful chunk of cold-start on marine 4G. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <BlazorWebAssemblyLoadAllGlobalizationData>false</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- AOT compiles .NET IL to WebAssembly at publish time. Turn this
         off only if build time is a hard constraint. Roughly triples
         publish duration but gives a 2-5x speedup on the hot data-apply
         and alarm-eval path at runtime, measurable on a Raspberry Pi
         kiosk where the old interpreted path bottlenecked the main
         thread. -->
    <RunAOTCompilation>true</RunAOTCompilation>
    <!-- TrimMode investigation gate. Default Blazor WASM trim mode
         is 'partial'; full mode would shave another 100-200 KB
         brotli but requires every reflection-resolved path to be
         annotated. Application code IS source-gen-clean as of F2
         (every JsonSerializer call routes through OnaJsonContext or
         OnaGeoJsonContext). The remaining blocker is the
         lazy-loaded XML stack: trim-full removes assemblies the
         trimmer can't see being statically used, and our
         <BlazorWebAssemblyLazyLoad> entries fall in that gap. The
         <TrimmerRootAssembly> workaround compiles but inflates the
         lazy XML download (~97 -> ~541 KB brotli) by preserving
         the rooted assemblies whole. The fix is a
         <TrimmerRootDescriptor> XML pinning only the specific
         types ResourceImporter / ResourceExporter touch; estimated
         3-4 hours plus a manual smoke test on the helm. See
         docs/research-trimmode.md for the audit + the descriptor-
         design notes. Until that lands, leaving 'partial'. -->
    <TrimMode>partial</TrimMode>
    <!-- Strip the source IL from the published bundle after AOT. The
         WASM runtime can execute the native code alone; the IL would
         just sit in the download. Cuts roughly 15 to 20 percent off
         the payload size (fewer bytes to transfer to the kiosk on
         first load). -->
    <WasmStripILAfterAOT>true</WasmStripILAfterAOT>
    <!-- Tell the AOT compiler to optimise for speed over size. Kiosk
         workflow is "start once, run for a week"; a few hundred KB
         extra in the published bundle is a good trade for tighter
         hot-loop code. -->
    <OptimizationPreference>Speed</OptimizationPreference>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.*-*" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OnaPlotter.Tests" />
  </ItemGroup>

  <!-- (Removed: <BlazorWebAssemblyLazyLoad> for System.Private.Xml*.)
       The lazy-XML setup landed in F2/2 to shave ~97 KB brotli off
       the boot bundle for sessions that never open Resources /
       History GPX flows. It interacted badly with AOT + partial
       trim at runtime: AOT-compiled methods carrying static refs
       into the lazy assemblies failed to resolve during
       mono_wasm_load_runtime, crashing the helm at boot
       (assertion at appdomain.c:188). Reverted 2026-05-02.
       Re-enabling needs either trim-full + a TrimmerRootDescriptor
       audit OR a smaller scope of types to lazy-load (e.g. only
       the GPX serialiser path that's actually opt-in). See
       docs/research-trimmode.md. -->

  <!-- Build stamp. Emits obj/BuildInfo.g.cs with the short git hash
       and a UTC build timestamp so the Settings page can render
       "build abc1234 (2026-04-24 12:34 UTC)" and the helm can
       visually verify which bundle is loaded (service worker / HTTP
       caching otherwise make it ambiguous). Runs before CoreCompile,
       so the generated file participates in the same build pass. On
       build environments without git (CI containers, tarball builds)
       the Exec's ContinueOnError gracefully yields an empty hash;
       the timestamp alone is still useful. -->
  <Target Name="StampBuildInfo" BeforeTargets="CoreCompile">
    <Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true"
          ContinueOnError="true" StandardOutputImportance="low"
          IgnoreExitCode="true">
      <Output PropertyName="OnaGitHash" TaskParameter="ConsoleOutput" />
    </Exec>
    <PropertyGroup>
      <OnaGitHash Condition="'$(OnaGitHash)' == ''">unknown</OnaGitHash>
      <OnaBuildUtc>$([System.DateTime]::UtcNow.ToString(`yyyy-MM-dd HH:mm`))</OnaBuildUtc>
      <OnaBuildInfoFile>$(IntermediateOutputPath)BuildInfo.g.cs</OnaBuildInfoFile>
    </PropertyGroup>
    <ItemGroup>
      <OnaBuildInfoLines Include="// &lt;auto-generated /&gt; written by StampBuildInfo target." />
      <OnaBuildInfoLines Include="namespace OnaPlotter%3B" />
      <OnaBuildInfoLines Include="internal static class BuildInfo" />
      <OnaBuildInfoLines Include="{" />
      <OnaBuildInfoLines Include="    public const string CommitHash = &quot;$(OnaGitHash)&quot;%3B" />
      <OnaBuildInfoLines Include="    public const string BuildUtc   = &quot;$(OnaBuildUtc)&quot;%3B" />
      <OnaBuildInfoLines Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(OnaBuildInfoFile)"
                      Lines="@(OnaBuildInfoLines)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(OnaBuildInfoFile)" />
      <FileWrites Include="$(OnaBuildInfoFile)" />
    </ItemGroup>

    <!-- Same hash + timestamp written as a tiny JS module. The boot
         loading screen (rendered before the Blazor runtime takes
         over) reads window.OnaPlotterBuild to show a small build
         stamp under the spinner: handy for verifying the helm is
         on the freshly-deployed bundle without waiting for Blazor
         to render the Settings page. Lives directly in wwwroot/js
         so it ships as a regular static asset; gitignored to keep
         build artefacts out of source. -->
    <PropertyGroup>
      <OnaVersionJsFile>$(MSBuildProjectDirectory)\wwwroot\js\version.g.js</OnaVersionJsFile>
    </PropertyGroup>
    <ItemGroup>
      <OnaVersionLines Include="// &lt;auto-generated /&gt; written by StampBuildInfo target." />
      <OnaVersionLines Include="window.OnaPlotterBuild = { hash: &quot;$(OnaGitHash)&quot;, utc: &quot;$(OnaBuildUtc)&quot; }%3B" />
    </ItemGroup>
    <WriteLinesToFile File="$(OnaVersionJsFile)"
                      Lines="@(OnaVersionLines)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
  </Target>

</Project>
